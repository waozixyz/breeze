{
  "manifest_version": 3,
  "name": "Inner Breeze",
  "short_name": "Inbe",
  "version": "2.0.8",
  "description": "Breathing, meditation, habit tracking, and encrypted sync.",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.waozi.xyz/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https: wss: http: ws:; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inner Breeze",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "inbe@waozi.xyz",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "healthInfo"
        ]
      }
    },
    "gecko_android": {}
  }
}
