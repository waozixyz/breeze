#import "session"
#import "geometry"
#import "tree"
#import "tree_input"
#import "widget_kind"
#import, file "../src/app/app_types.zi";
#import, file "../src/app/app_modal_state.zi";

using WidgetKind;

Click :: (session: Session) {
    TreePointerUpdate(session, PointerFrame.{20, 20, true, true, false})
    TreePointerUpdate(session, PointerFrame.{20, 20, false, false, true})
}

#program_export
Check :: () -> s32 {
    app: InnerBreeze
    app.breathing.frame = 7
    app.ui.session = SessionOpen()
    if !SessionValid(app.ui.session) { return 1 }
    TreeStart(app.ui.session, 1, Rectangle.{0, 0, 200, 100})
    button := TreeSubmit(app.ui.session, 2, 0, WidgetKindButton, Rectangle.{10, 10, 80, 44})
    TreeSetInteractive(app.ui.session, button, false, false, 2)
    if !TreeFinish(app.ui.session) { return 2 }
    Click(app.ui.session)
    if !TreeTakeActivationAt(app.ui.session, button) { return 3 }
    Click(app.ui.session)
    app_block_current_click(*app)
    if app.blocked_input_frame != 7 { return 4 }
    if TreeTakeActivationAt(app.ui.session, button) { return 5 }
    // A canceled press cannot activate another screen on its later release.
    TreePointerUpdate(app.ui.session, PointerFrame.{20, 20, true, true, false})
    app_block_current_click(*app)
    TreePointerUpdate(app.ui.session, PointerFrame.{20, 20, false, false, true})
    if TreeTakeActivationAt(app.ui.session, button) { return 6 }
    // A fresh click remains usable after the transition.
    app.breathing.frame = 8
    Click(app.ui.session)
    if !TreeTakeActivationAt(app.ui.session, button) { return 7 }
    if !SessionClose(app.ui.session) { return 8 }
    return 0
}
