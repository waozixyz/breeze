#import,file "../src/screens/settings/settings_status.zi";

TransientStatus :: () {
    bytes: [3]u8 = .[111, 107, 33]
    detail: [4]u8 = .[112, 97, 116, 104]
    settings_screen_set_status_success(TextView(bytes[:]), TextView(detail[:]))
    bytes[0] = 88
    detail[0] = 88
}

#program_export
main :: () -> s32 {
    TransientStatus()
    status := settings_screen_status()
    if status.kind != 1 || status.message != "ok!" || status.detail != "path" { return 1 }
    original := status
    settings_screen_set_status_success(status.detail, status.message)
    status = settings_screen_status()
    if status.message != "path" || status.detail != "ok!" { return 2 }
    settings_screen_set_status_error("失敗")
    status = settings_screen_status()
    if status.kind != 2 || status.message != "失敗" || status.detail != "" { return 3 }
    if original.message != "ok!" || original.detail != "path" { return 6 }
    long_text: [4100]u8
    index: s32 = 0
    while index < 4094 { long_text[index] = 65; index += 1 }
    long_text[4094] = 226
    long_text[4095] = 130
    long_text[4096] = 172
    settings_screen_set_status_success("done", TextView(long_text[:]))
    status = settings_screen_status()
    if status.detail.count != 4094 || status.detail[4093] != 65 { return 4 }
    settings_screen_clear_status()
    status = settings_screen_status()
    if status.kind != 0 || status.message.count != 0 || status.detail.count != 0 { return 5 }
    if original.message != "ok!" || original.detail != "path" { return 7 }
    return 0
}
