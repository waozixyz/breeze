#import, file "../src/app/navigation_routes.zi";
#import, file "../src/app/route_types.zi";
#import, file "../src/core/types.zi";

#program_export
Answer :: () -> s32 {
    left: AppRoute
    right: AppRoute
    left.screen = ScreenStart
    right.screen = ScreenStart
    if !RoutesEqual(left, right) { return 1 }

    right.screen = ScreenSettings
    if RoutesEqual(left, right) { return 2 }
    if RoutesNeedTransition(left, right) { return 21 }
    right.screen = ScreenStart
    right.exercise_type = 1
    if RoutesEqual(left, right) { return 3 }
    left.exercise_type = 1
    right.practice_config_tab = 2
    if !RoutesEqual(left, right) { return 4 }
    left.practice_tab = PRACTICE_TAB_CONFIG
    if RoutesNeedTransition(left, right) { return 22 }
    right.practice_tab = PRACTICE_TAB_CONFIG
    if RoutesEqual(left, right) { return 5 }
    if RoutesNeedTransition(left, right) { return 23 }
    left.practice_config_tab = 2
    if !RoutesEqual(left, right) { return 6 }

    left.screen = ScreenSettings
    right.screen = ScreenSettings
    right.settings_tab = 2
    if RoutesEqual(left, right) { return 7 }
    if RoutesNeedTransition(left, right) { return 24 }
    left.settings_tab = 2
    right.settings_overview = 1
    if RoutesEqual(left, right) { return 8 }
    if !RoutesNeedTransition(left, right) { return 25 }
    left.settings_overview = 1
    if !RoutesEqual(left, right) { return 9 }

    left.screen = ScreenProfile
    right.screen = ScreenProfile
    right.profile_view = 1
    if RoutesEqual(left, right) { return 10 }
    left.profile_view = 1
    right.profile_tab = 3
    if RoutesEqual(left, right) { return 11 }
    if RoutesNeedTransition(left, right) { return 26 }
    left.profile_tab = 3
    if !RoutesEqual(left, right) { return 12 }

    left.screen = ScreenHabits
    right.screen = ScreenHabits
    right.habits_screen_mode = 1
    if RoutesEqual(left, right) { return 13 }
    if !RoutesNeedTransition(left, right) { return 27 }
    left.habits_screen_mode = 1
    right.habits_tab = 2
    if RoutesEqual(left, right) { return 14 }
    if RoutesNeedTransition(left, right) { return 28 }
    left.habits_tab = 2
    if !RoutesEqual(left, right) { return 15 }

    left.screen = ScreenHabitEdit
    right.screen = ScreenHabitEdit
    if !RoutesEqual(left, right) { return 16 }
    right.habits_tab = 3
    if RoutesEqual(left, right) { return 17 }
    left.screen = ScreenHabitSessionEdit
    right.screen = ScreenHabitSessionEdit
    if RoutesEqual(left, right) { return 18 }
    left.habits_tab = 3
    if !RoutesEqual(left, right) { return 19 }

    left.screen = ScreenSession
    right.screen = ScreenSession
    right.exercise_type = 99
    if !RoutesEqual(left, right) { return 20 }
    return 42
}
