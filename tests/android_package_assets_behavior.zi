#import, file "../src/app/assets.zi";

#program_export
PackageSize :: () -> s64 {
    view := AssetRead("inbe.zx")
    if !view.found {
        return 0
    }
    if view.mime != "application/octet-stream" || view.data.count < 8 ||
    view.data[0] != 90 || view.data[1] != 88 || view.data[2] != 0 || view.data[3] != 0 {
        return -1
    }
    return view.data.count
}

#program_export
AppsPackageSize :: () -> s64 {
    view := AssetRead("apps.zx")
    if !view.found {
        return 0
    }
    if view.mime != "application/octet-stream" || view.data.count != 9 ||
    view.data[0] != 90 || view.data[1] != 88 || view.data[2] != 0 || view.data[3] != 0 ||
    view.data[8] != 65 {
        return -1
    }
    return view.data.count
}

#program_export
MissingPackageAsset :: () -> bool {
    return !AssetRead("missing.zx").found
}
