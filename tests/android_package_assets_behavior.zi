#import, file "../src/app/assets.zi";

#program_export
PackageSize :: () -> s64 {
    view := AssetRead("inbe.zib")
    if !view.found {
        return 0
    }
    if view.mime != "application/octet-stream" || view.data.count < 8 ||
    view.data[0] != 90 || view.data[1] != 73 || view.data[2] != 66 {
        return -1
    }
    return view.data.count
}

#program_export
MissingPackageAsset :: () -> bool {
    return !AssetRead("missing.zib").found
}
