#import, file "../apps/practice/astral_projection_rules.zi";
#import, file "../apps/practice/astral_scene.zi";
#import, file "../apps/practice/workout_moves.zi";
#import, file "../src/practices/tai_chi/tai_chi_math.zi";
#import, file "../src/practices/tai_chi/tai_chi_solve.zi";
#import "math"

#program_export
Answer :: () -> s32 {
    rig := WorkoutRig()
    for tick: cast(s64)0..120 {
        scene := AstralSceneAt(tick * 5000)
        solved := WorkoutSolve(*scene.pose, *rig)
        if !Finite64(solved.head_center.y) || scene.pose.pelvis.y < 0.4 ||
        scene.pose.pelvis.y > 0.7 || scene.camera.tilt < 0.3 || scene.camera.tilt > 0.5 {
            return 11
        }
        for side: cast(s32)0..1 {
            length := TaiChiDistance3(solved.shoulders[side], solved.elbows[side])
            if !Finite64(length) || TaiChiAbs(length - rig.upper_arm) > 0.001 {
                return 12
            }
        }
    }
    first := AstralSceneAt(0)
    later := AstralSceneAt(15000)
    if first.camera.yaw == later.camera.yaw || first.pose.pelvis.y == later.pose.pelvis.y {
        return 13
    }
    course: AstralCourse
    data := "{\"schema\":1,\"duration\":900,\"cues\":[{\"second\":0,\"key\":\"astral_text_1\"},{\"second\":90,\"key\":\"astral_text_2\"}]}"
    if !AstralCourseParse(data, *course) || course.duration != 900 {
        return 1
    }
    if AstralCueAt(*course, 0) != 0 || AstralCueAt(*course, 89) != 0 ||
    AstralCueAt(*course, 90) != 1 || AstralCueAt(*course, 900) != 1 {
        return 2
    }
    clock := AstralAdvance(AstralClock.{}, 89999, false)
    if clock.elapsed_seconds != 89 || clock.remainder_ms != 999 {
        return 3
    }
    paused := AstralAdvance(clock, 100000, true)
    if paused.elapsed_seconds != clock.elapsed_seconds || paused.remainder_ms != clock.remainder_ms {
        return 4
    }
    clock = AstralAdvance(paused, 1, false)
    if clock.elapsed_seconds != 90 || clock.remainder_ms != 0 ||
    AstralCueAt(*course, clock.elapsed_seconds) != 1 {
        return 5
    }
    clock = AstralAdvance(clock, 2400000, false)
    if clock.elapsed_seconds != 2490 || clock.remainder_ms != 0 ||
    AstralCueAt(*course, clock.elapsed_seconds) != 1 {
        return 6
    }
    clock = AstralAdvance(clock, 86400000, false)
    if clock.elapsed_seconds != 88890 || clock.remainder_ms != 0 {
        return 9
    }
    clock = AstralAdvance(AstralClock.{2147483646, 999}, 2147483647, false)
    if clock.elapsed_seconds != 2147483647 || clock.remainder_ms != 0 {
        return 10
    }
    broken: [6]string = .[
    "{\"schema\":2,\"duration\":900,\"cues\":[]}",
    "{\"schema\":1,\"duration\":0,\"cues\":[]}",
    "{\"schema\":1,\"duration\":900,\"cues\":[{\"second\":1,\"key\":\"astral_text_1\"},{\"second\":90,\"key\":\"astral_text_2\"}]}",
    "{\"schema\":1,\"duration\":900,\"cues\":[{\"second\":0,\"key\":\"astral_text_1\"},{\"second\":900,\"key\":\"astral_text_2\"}]}",
    "{\"schema\":1,\"duration\":900,\"cues\":[{\"second\":0,\"key\":\"astral_text_1\"},{\"second\":90,\"key\":\"astral_text_1\"}]}",
    "{\"schema\":1,\"duration\":900,\"cues\":[{\"second\":0,\"key\":\"astral_text_1\"},{\"second\":90,\"key\":\"../wrong\"}]}"
    ]
    for value: broken {
        if AstralCourseParse(value, *course) || course.count != 0 {
            return 7
        }
    }
    if AstralCourseParse("{\"schema\":1,\"duration\":900,\"cues\":[]}x", *course) {
        return 8
    }
    return 42
}
