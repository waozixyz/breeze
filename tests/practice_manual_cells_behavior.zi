// Practices draws its manuals: the bundled package lays out each page from
// the frame the host gives it and gives back the page it turned to, a speed
// changed on the Wim Hof breathing page, and whether the manual closes or
// the practice starts.
#import "session"
#import "geometry"
#import "tree"
#import "tree_draw"
#import "paint_queue"
#import "bundle_host"
#import "byte_text_linux"
#import "hosted_values"
#import "widget_host"
#import "drawing_props"
#import, file "../src/cells/module_host.zi";
#import, file "../src/cells/practice_types.zi";
#import, file "../src/cells/practice_ui_types.zi";
#import, file "../src/cells/app_codec.zi";
#import, file "../src/app/exercise_types.zi";

using ExerciseType;
using HostValueKind;

manual_test_frame: PracticeManualFrame;
manual_test_codec: WidgetPracticeManualFrameCodec;
manual_test_writes: s32;

ManualTestAssets :: (path: string) -> bool {
    return path.count == 0 || (path.count > 17 && path[:17] == "assets/practices/")
}

ManualTestCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "manual_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPracticeManualHost" && count == 0 {
        result.* = WidgetEncodePracticeManualFrame(manual_test_frame, *manual_test_codec)
        return 1
    }
    if name == "WritePracticeManualHost" && count == 1 && WidgetValidPracticeManualFrame(arguments[0]) {
        manual_test_writes += 1
        manual_test_frame = WidgetDecodePracticeManualFrame(arguments[0], *manual_test_codec)
        return 1
    }
    if name == "ManualLocaleHost" && count == 1 {
        text := "Step %d of %d"
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

ManualTestDraw :: (frame: PracticeManualFrame, frame_id: u64) -> s32 {
    session := SessionOpen()
    BeginFrame(session, frame_id, Rectangle.{0.0, 0.0, 411.0, 900.0})
    frame.session = session
    manual_test_frame = frame
    manual_test_writes = 0
    WidgetHostBegin(session, ManualTestAssets)
    CellsUiBegin(ManualTestCall, null)
    drawn := PracticeRun(PracticeMessage.{.action = PRACTICE_MANUAL_VIEW})
    CellsUiEnd()
    WidgetHostEnd()
    painted := PendingPaintCount(session)
    unused EndFrame(session)
    unused SessionClose(session)
    if !drawn.succeeded { return 1 }
    if manual_test_writes != 1 { return 2 }
    if painted == 0 { return 3 }
    return 0
}

// Draws every page of each manual the package draws, turns pages with the
// keys, and starts the practice from the last page; returns 0 when each
// went through the host.
CheckPracticeManual :: () -> s32 {
    frame := PracticeManualFrame.{.scale = 1.0, .view_width = 411, .view_height = 900,
        .font = 16, .small_font = 14, .title_height = 48,
        .guide_background = Color.{.r = 240, .g = 244, .b = 242, .a = 255},
        .guide_foreground = Color.{.r = 60, .g = 140, .b = 110, .a = 255},
        .guide_border = Color.{.r = 200, .g = 210, .b = 205, .a = 255},
        .speed = 3, .speed_min = 1, .speed_max = 8, .breath_radius = 60, .hold_progress = 20,
        .preset = 1, .inhale = 4, .hold_in = 4, .exhale = 4, .hold_out = 4}
    practices: [4]s32 = .[EXERCISE_WIM_HOF, EXERCISE_MEDITATION, EXERCISE_PATTERNS,
        EXERCISE_ASTRAL_PROJECTION]
    pages: [4]s32 = .[4, 2, 3, 2]
    id: u64 = 1
    for index: 0..3 {
        frame.practice = practices[index]
        for page: cast(s32)0..pages[index] - 1 {
            frame.page = page
            drawn := ManualTestDraw(frame, id)
            id += cast(u64)1
            if drawn != 0 { return drawn }
            if manual_test_frame.action != PRACTICE_MANUAL_NONE || manual_test_frame.page != page {
                return 4
            }
        }
    }
    // The arrow keys turn the page; the next key on the last page starts.
    frame.practice = EXERCISE_PATTERNS
    frame.page = 0
    frame.next = true
    if ManualTestDraw(frame, id) != 0 || manual_test_frame.page != 1 ||
    manual_test_frame.action != PRACTICE_MANUAL_NONE { return 5 }
    frame.page = 2
    if ManualTestDraw(frame, id + cast(u64)1) != 0 ||
    manual_test_frame.action != PRACTICE_MANUAL_START { return 6 }
    frame.next = false
    frame.previous = true
    if ManualTestDraw(frame, id + cast(u64)2) != 0 || manual_test_frame.page != 1 { return 7 }
    frame.previous = false
    frame.close = true
    if ManualTestDraw(frame, id + cast(u64)3) != 0 ||
    manual_test_frame.action != PRACTICE_MANUAL_CLOSE { return 8 }
    return 0
}
