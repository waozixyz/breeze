c_cache :: #system_library "c";
ModuleTestUseCache :: (enabled: bool) #foreign c_cache;
ModuleTestCachedReads :: (index: s32) -> s32 #foreign c_cache;
ModuleTestBundleOpens :: () -> s32 #foreign c_cache;
ModuleTestInstanceOpens :: () -> s32 #foreign c_cache;
ModuleTestCorruptCachedLists :: (enabled: bool) #foreign c_cache;
ModuleTestFailInstantiate :: () #foreign c_cache;
ModuleTestFailRun :: () #foreign c_cache;
ModuleTestSetRevision :: (index: s32, revision: s32) #foreign c_cache;
ModuleTestYield :: () #foreign c_cache;
ModuleTestBlockParser :: (enabled: bool) #foreign c_cache;
ModuleTestParserStarted :: () -> bool #foreign c_cache;
ModuleTestNow :: () -> float64 #foreign c_cache;

ModuleTestPrepare :: (index: s32, bytes: string) -> s32 {
    result: s32 = 0
    for attempt: 0..20000 {
        result = AppsPreparePackage(index, bytes)
        if result != 0 {
            return result
        }
        ModuleTestYield()
    }
    return result
}

// Download validation owns its parser until cancellation finishes. Polling a
// held parser must leave the visible app usable and return within a frame.
CheckNodePackagePreparation :: (bytes: string) {
    slot := cast(s32)(NodeAppSlots - 1)
    index := NodeAppIndex(slot)
    saved_index := Packages.package_index
    saved_release := Packages.package_release
    saved_name := PackageText(NodeAppName(slot), "")
    defer {
        Packages.package_index = saved_index
        Packages.package_release = saved_release
        NodeAppAssign(slot, saved_name)
        PackageFree(saved_name)
    }
    NodeAppAssign(slot, "parserprobe")
    Packages.package_index = index
    Packages.package_release.valid = true
    unused DiaryTestHash(DiaryTestBytes(bytes), Packages.package_release.hash[:])
    ModuleTestBlockParser(true)
    Expect(AppsPreparePackage(index, bytes) == 0, 400)
    for attempt: 0..5000 {
        if ModuleTestParserStarted() { break }
        ModuleTestYield()
    }
    Expect(ModuleTestParserStarted(), 401)
    started := ModuleTestNow()
    for frame: 0..99 {
        Expect(AppsPreparePackage(index, bytes) == 0, 402)
    }
    AppsDiscardPreparation()
    Expect(!AppsPreparationIdle() && ModuleTestNow() - started < 0.05, 403)
    Expect(ListsRun(ListsMessage.{.action = LISTS_ROUTE, .screen = ScreenEList}).succeeded, 404)
    ModuleTestBlockParser(false)
    for attempt: 0..5000 {
        if AppsPreparationIdle() { break }
        ModuleTestYield()
    }
    Expect(AppsPreparationIdle(), 405)
    // A Lists app is a valid ZX but cannot impersonate this node app.
    Expect(ModuleTestPrepare(index, bytes) < 0 && AppsPreparationIdle(), 406)
}

