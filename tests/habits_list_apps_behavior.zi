// The habit list and a habit's page are Habits' own: the bundled package
// draws them from the frame the host gives it and reads each habit and day
// through the host, within the calls the host allows Habits. The host never
// composes the list.
#import "session"
#import "geometry"
#import "tree"
#import "tree_draw"
#import "paint_queue"
#import "bundle_host"
#import "byte_text_linux"
#import "hosted_values"
#import "widget_host"
#import "drawing_props"
#import, file "../src/apps/module_host.zi";
#import, file "../src/apps/habits_types.zi";
#import, file "../src/apps/habits_ui_types.zi";
#import, file "../src/apps/app_codec.zi";
#import, file "../src/habits/habit_types.zi";

using HostValueKind;

list_test_frame: HabitsListFrame;
list_test_codec: WidgetHabitsListFrameCodec;
list_test_row_codec: WidgetHabitsListRowCodec;
list_test_day_codec: WidgetHabitsListDayCodec;
list_test_reads: s32;
list_test_written: bool;
list_test_rows_seen: u32;
list_test_days: s32;
list_test_bad_day: bool;

ListTestAssets :: (path: string) -> bool {
    return path.count == 0
}

ListTestCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "habit_list_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadHabitsListHost" && count == 0 {
        list_test_reads += 1
        result.* = WidgetEncodeHabitsListFrame(list_test_frame, *list_test_codec)
        return 1
    }
    if name == "WriteHabitsListHost" && count == 1 && WidgetValidHabitsListFrame(arguments[0]) {
        list_test_written = true
        list_test_frame = WidgetDecodeHabitsListFrame(arguments[0], *list_test_codec)
        return 1
    }
    if name == "ReadHabitsListRowHost" && count == 1 {
        index := cast(s32)arguments[0].integer
        if index < 0 || index >= list_test_frame.habit_count { return 0 }
        list_test_rows_seen |= cast(u32)1 << cast(u32)index
        row := HabitsListRow.{.name = ifx index == 0 then "Meditation" else "Push ups",
            .color = Color.{.r = 120, .g = 190, .b = 230, .a = 255}, .icon = ifx index == 0 then 1 else 0,
            .deactivated = index == 2, .counting = index == 1, .target = 3,
            .streak = 4, .week_done = 2, .week_planned = 5}
        result.* = WidgetEncodeHabitsListRow(row, *list_test_row_codec)
        return 1
    }
    if name == "ReadHabitsListDayHost" && count == 2 {
        index := cast(s32)arguments[0].integer
        day := cast(s32)arguments[1].integer
        if index < 0 || index >= list_test_frame.habit_count { return 0 }
        // Days are dates up to today.
        if day > list_test_frame.today || day < 20260101 {
            list_test_bad_day = true
        }
        list_test_days += 1
        state := HabitsListDay.{.day = day, .planned = true, .complete = day % 2 == 0,
            .count = ifx index == 1 then 2 else 0}
        result.* = WidgetEncodeHabitsListDay(state, *list_test_day_codec)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 {
        text := "%d / %d habits"
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

ListTestDraw :: (frame: HabitsListFrame, frame_id: u64) -> s32 {
    session := SessionOpen()
    bounds := Rectangle.{0.0, 0.0, 400.0, 760.0}
    BeginFrame(session, frame_id, bounds)
    frame.session = session
    list_test_frame = frame
    list_test_reads = 0
    list_test_written = false
    list_test_rows_seen = 0
    list_test_days = 0
    WidgetHostBegin(session, ListTestAssets)
    AppsUiBegin(ListTestCall, null)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_LIST_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    painted := PendingPaintCount(session)
    unused EndFrame(session)
    unused SessionClose(session)
    if !drawn.succeeded { return 1 }
    if list_test_reads != 1 || !list_test_written { return 2 }
    if painted == 0 { return 3 }
    return 0
}

// Draws the list with an open habit and the inactive habits shown, then the
// habit's calendar; returns 0 when the package drew both through the host.
CheckHabitList :: () -> s32 {
    frame := HabitsListFrame.{.scale = 1.0,
        .bounds = Rectangle.{16.0, 20.0, 368.0, 700.0}, .font = 16, .small_font = 14,
        .text_color = Color.{.r = 230, .g = 230, .b = 240, .a = 255},
        .surface_color = Color.{.r = 30, .g = 30, .b = 40, .a = 255},
        .accent_color = Color.{.r = 150, .g = 120, .b = 230, .a = 255},
        .today = 20261024, .habit_count = 3, .habit_limit = HABIT_MAX, .halves = 3,
        .screen_mode = HABITS_SCREEN_OVERVIEW, .view_mode = HABIT_VIEW_WEEKLY,
        .selected = 0, .show_deactivated = true, .reveal_selected = true,
        .weekly_days = HABIT_WEEKLY_INITIAL_DAYS}
    overview := ListTestDraw(frame, cast(u64)1)
    if overview != 0 { return overview }
    // Every habit was read, and the two active ones' days, within the week.
    if list_test_rows_seen != cast(u32)7 || list_test_days < 2 * 4 || list_test_bad_day { return 4 }
    if list_test_frame.action != HABITS_LIST_NONE || list_test_frame.reveal_selected { return 5 }
    // The open habit's history, statistics and editor are guide anchors.
    if list_test_frame.anchor_history.width <= 0.0 || list_test_frame.first_day.width <= 0.0 { return 6 }
    frame.screen_mode = HABITS_SCREEN_HISTORY
    frame.view_mode = HABIT_VIEW_CALENDAR
    frame.selected = 1
    page := ListTestDraw(frame, cast(u64)2)
    if page != 0 { return 6 + page }
    // A counting habit's calendar asks each day of the month up to today.
    if list_test_days < 24 || list_test_bad_day { return 10 }
    return 0
}
