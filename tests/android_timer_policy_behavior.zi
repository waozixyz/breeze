#import "android_timer";

#program_export
TimerPolicyCheck :: () -> s32 {
    if TimerElapsedMillis(0, 100000000) != 100 {
        return -1
    }
    if TimerElapsedMillis(100000000, 150000000) != 50 {
        return -2
    }
    if TimerElapsedMillis(100000000, 100000000) != 100 {
        return -3
    }
    if TimerElapsedMillis(100000000, 100100000) != 100 {
        return -4
    }
    if TimerElapsedMillis(100000000, 600200000000) != 300000 {
        return -5
    }
    return 42
}
