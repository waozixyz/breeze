#import, file "../src/app/font_assets.zi";

#program_export
Answer :: () -> s32 {
    if FontAssetForLocale("zh") != FONT_SC { return 1 }
    if FontAssetForLocale("ja") != FONT_JP { return 2 }
    if FontAssetForLocale("ko") != FONT_KR { return 3 }
    if FontAssetForLocale("zh-TW") != FONT_TC { return 4 }
    if FontAssetForLocale("zh_Hant") != FONT_TC { return 5 }
    if FontAssetForLocale("en") != FONT_LATIN { return 6 }
    if FontAssetForLocale("") != FONT_LATIN { return 7 }
    latin: [8]string = .["cs", "de", "es", "fr", "id", "it", "pt", "ru"]
    index: s32 = 0
    while index < 8 {
        if FontAssetForLocale(latin[index]) != FONT_LATIN { return 10 + index }
        index += 1
    }
    return 42
}
