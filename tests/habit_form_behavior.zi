#import, file "../src/subapps/shared_state.zi";
#import, file "../src/subapps/module_host.zi";

using HabitSyncMode;

app_state: InnerBreeze;
syncs: s32;
bundle_data: *void;
libc :: #system_library "c";
TestBundleFileOpen :: (path: *u8, mode: *u8) -> *void #foreign libc "fopen";
TestBundleFileClose :: (file: *void) -> s32 #foreign libc "fclose";
TestBundleFileSeek :: (file: *void, offset: s64, origin: s32) -> s32 #foreign libc "fseek";
TestBundleFileTell :: (file: *void) -> s64 #foreign libc "ftell";
TestBundleFileRead :: (data: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fread";
TestBundleAllocate :: (size: usize) -> *void #foreign libc "malloc";
TestBundleRelease :: (memory: *void) #foreign libc "free";

// Route decisions and habit commits run through the same bundles as the app.
open_test_bundle :: (app: *InnerBreeze) -> bool {
    file := TestBundleFileOpen(pointer_of("build/inbe.zib\0"), cstr("rb"))
    if file == null {
        return false
    }
    if TestBundleFileSeek(file, 0, 2) != 0 {
        TestBundleFileClose(file)
        return false
    }
    size := TestBundleFileTell(file)
    if size <= 0 || TestBundleFileSeek(file, 0, 0) != 0 {
        TestBundleFileClose(file)
        return false
    }
    bundle_data = TestBundleAllocate(cast(usize)size)
    if bundle_data == null {
        TestBundleFileClose(file)
        return false
    }
    read := TestBundleFileRead(bundle_data, 1, cast(usize)size, file)
    TestBundleFileClose(file)
    if read != cast(usize)size {
        return false
    }
    // This fixture exposes only the locale asset; bind the real persistence
    // effects, then load the compiled root bundle explicitly.
    unused SubappsStart(app)
    return SubappsOpenPackage(TextFromBytes(BytesFromPointer(
        cast(*u8)bundle_data, cast(u64)size)))
}

// Application hooks the form calls when it saves.
#program_export "app_auto_sync"
host_auto_sync :: (app: *InnerBreeze) -> s32 {
    unused app
    syncs += 1
    return 0
}

#program_export "save_settings"
host_save_settings :: (app: *InnerBreeze) {
    unused app
}

set_text :: (target: []u8, text: string) {
    unused AppCopyText(text, target)
}

#program_export
Check :: () -> s32 {
    guard := support_begin("/tmp/inbe-habit-form-zi-test/")
    if guard != 0 { return guard }
    root := make_root("habit-form")
    check_true("init db", storage_init(root) != 0)
    app_state = InnerBreeze.{}
    app := *app_state
    if !open_test_bundle(app) {
        storage_close()
        TestBundleRelease(bundle_data)
        return 101
    }

    habit_edit_begin_new(app)
    check_int("new habit opens the form", app.breathing.screen, ScreenHabitEdit)
    check_true("the name starts empty", app.habit_edit.text[0] == cast(u8)0)
    check_int("no reminder by default", app.habit_edit.reminder_hour, -1)
    check_int("no schedule by default", app.habit_edit.weekdays, HABIT_SCHEDULE_OFF)
    check_true("first section open", app.habit_edit.sections[0] != 0)
    check_true("only the routine sections are open by default",
        app.habit_edit.sections[1] == 0 && app.habit_edit.sections[2] != 0)

    habit_edit_commit(app)
    check_true("an empty name keeps the form open", app.habit_edit.active != 0 && app.habit_edit.name_error == 1)
    check_int("nothing was added", app.habits.count, 0)
    check_int("nothing was stored", storage_habit_count(), 0)

    set_text(app.habit_edit.text[:], "   \t ")
    habit_edit_commit(app)
    check_true("a blank name keeps the form open", app.habit_edit.active != 0 && app.habits.count == 0)

    set_text(app.habit_edit.text[:], "Test counter")
    set_text(app.habit_edit.description[:], "Only for testing")
    app.habit_edit.counter_enabled = 1
    app.habit_edit.sync_activity = 3
    app.habit_edit.weekdays = 31
    app.habit_edit.reminder_hour = 9
    habit_edit_commit(app)
    check_true("a valid habit is added and the form closes", app.habits.count == 1 && app.habit_edit.active == 0)
    check_int("the habit is stored", storage_habit_count(), 1)
    check_int("sync ran once", syncs, 1)
    check_int("counter enabled", app.habits.items[0].counter_enabled, 1)
    check_int("linked activities", app.habits.items[0].sync_activity, 3)
    check_int("linking is independent of the counter", app.habits.items[0].sync_mode, 1)
    check_int("weekdays", app.habits.items[0].weekdays, 31)
    check_int("reminder", app.habits.items[0].reminder_hour, 9)
    check_true("description", TextFromCString(*app.habits.items[0].description[0]) == "Only for testing")

    habit_edit_begin_new(app)
    set_text(app.habit_edit.text[:], "Test counter")
    habit_edit_commit(app)
    check_true("a duplicate name is refused", app.habit_edit.active != 0 && app.habit_edit.name_error == 2 && app.habits.count == 1)
    habit_edit_cancel(app)
    check_int("cancelling stores nothing", storage_habit_count(), 1)
    check_int("cancelling returns to the overview", app.habits.screen_mode, HABITS_SCREEN_OVERVIEW)

    habit_edit_begin(app, 0)
    check_true("editing opens the form for the habit", app.breathing.screen == ScreenHabitEdit && app.habit_edit.is_new == 0)
    check_true("the form shows the habit's settings", app.habit_edit.counter_enabled != 0 && app.habit_edit.sync_activity == 3)
    set_text(app.habit_edit.text[:], "Unsaved edit")
    habit_edit_cancel(app)
    check_true("cancelling an edit keeps the habit", TextFromCString(*app.habits.items[0].name[0]) == "Test counter")

    habit_edit_begin(app, 0)
    app.habit_edit.counter_enabled = 0
    app.habit_edit.weekdays = 0
    app.habit_edit.reminder_hour = -1
    habit_edit_commit(app)
    check_true("turning the counter off leaves the linking alone",
        app.habits.items[0].counter_enabled == 0 && app.habits.items[0].sync_activity == 3)
    check_true("the schedule and reminder are cleared",
        app.habits.items[0].weekdays == 0 && app.habits.items[0].reminder_hour == -1)
    check_int("sync ran for the edit", syncs, 2)
    habits_free(*app.habits)
    SubappsClose()
    TestBundleRelease(bundle_data)
    storage_close()
    return failures
}
