c :: #system_library "c";
TestFail :: (code: s32) #foreign c "exit";

test_app: InnerBreeze;
test_mode: s32;
test_saves: s32;
saved_hour: s32;
saved_enabled: s32;
saved_practice: s32;

Require :: (condition: bool, code: s32) {
    if !condition {
        TestFail(code)
    }
}

// Keep the real settings widgets and event routing. Observe persistence at
// its effect boundary so this test never opens a database or a display.
#program_export "__wrap_save_settings"
TestSaveSettings :: (app: *InnerBreeze) {
    test_saves += 1
    saved_hour = app.reminders[0].hour
    saved_enabled = app.reminders[0].enabled
    saved_practice = app.reminders[0].practice
}

