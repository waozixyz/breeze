#import, file "../src/app/frame_activity.zi";

#program_export
Answer :: () -> s32 {
    null_state: FrameActivityState
    null_step: FrameActivityResult = FrameActivityStep(null_state, 10, 20,
        false, false, 12)
    if null_step.active || !null_step.state.mouse_ready { return -9 }
    state: FrameActivityState
    step: FrameActivityResult = FrameActivityStep(state, 10, 20,
        false, true, 12)
    if !step.active || step.state.grace_frames != 12 { return -1 }
    state = step.state
    count: s32 = 0
    while count < 12 {
        step = FrameActivityStep(state, 10, 20, false, true, 12)
        if !step.active { return -2 }
        state = step.state
        count += 1
    }
    step = FrameActivityStep(state, 10, 20, false, true, 12)
    if step.active { return -3 }
    state = step.state
    step = FrameActivityStep(state, 11, 20, false, true, 12)
    if !step.active || step.state.grace_frames != 12 { return -4 }
    state = step.state
    step = FrameActivityStep(state, 11, 20, true, true, 12)
    if !step.active || step.state.grace_frames != 12 { return -5 }
    state = step.state
    step = FrameActivityStep(state, 11, 20, false, true, 0)
    if !step.active || step.state.grace_frames != 11 { return -6 }
    state = step.state
    step = FrameActivityStep(state, 11, 20, true, true, 0)
    if !step.active || step.state.grace_frames != 0 { return -7 }
    state = step.state
    step = FrameActivityStep(state, 11, 20, false, true, 0)
    if step.active { return -8 }
    return 42
}
