#import, file "../src/app/social_action_queue.zi";

#program_export
Answer :: () -> s32 {
    SocialQueueClear()
    action: [16]u8
    value: [96]u8
    if SocialQueuePeek(action[:], value[:]) ||
       action[0] != 0 || value[0] != 0 { return 1 }
    if SocialQueuePush("", "friend") ||
       SocialQueuePush("send", "") { return 2 }
    if !SocialQueuePush("send", "one") ||
       !SocialQueuePush("accept", "two") ||
       SocialQueueCount() != 2 { return 3 }
    if !SocialQueuePeek(action[:], value[:]) ||
       action[0] != 115 || action[1] != 101 ||
       value[0] != 111 { return 4 }
    if !SocialQueuePop(action[:], value[:]) ||
       action[0] != 115 || value[0] != 111 ||
       SocialQueueCount() != 1 { return 5 }
    if !SocialQueuePeek(action[:], value[:]) ||
       action[0] != 97 || value[0] != 116 { return 6 }
    for index: 0..5 {
        if !SocialQueuePush("remove", "next") { return 7 }
    }
    if SocialQueueCount() != 7 { return 8 }
    if !SocialQueuePush("decline", "last") ||
       SocialQueuePush("send", "overflow") { return 9 }
    if !SocialQueuePop(action[:], value[:]) ||
       action[0] != 97 || SocialQueueCount() != 7 { return 10 }
    if !SocialQueuePush("send", "wrapped") { return 11 }
    for index: 0..5 {
        if !SocialQueuePop(action[:], value[:]) ||
           action[0] != 114 { return 12 }
    }
    if !SocialQueuePop(action[:], value[:]) ||
       action[0] != 100 { return 13 }
    if !SocialQueuePop(action[:], value[:]) ||
       action[0] != 115 || value[0] != 119 ||
       SocialQueueCount() != 0 { return 14 }

    if !SocialQueuePush("abcdefghijklmnop", "value") ||
       !SocialQueuePeek(action[:], value[:]) ||
       action[14] != 111 || action[15] != 0 { return 15 }
    short: [2]u8
    if !SocialQueuePeek(short[:], value[:]) ||
       short[0] != 97 || short[1] != 0 { return 16 }
    SocialQueueClear()
    if SocialQueueCount() != 0 || SocialQueuePop(action[:], value[:]) {
        return 17
    }
    return 42
}
