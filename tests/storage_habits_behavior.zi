// External meditation logs count towards the profile streak and average; a
// log for a session that exists is not counted twice.
test_meditation_logs_feed_profile_stats :: () {
    root := make_root("meditation-log-stats")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('med-session-1',(SELECT id FROM users LIMIT 1),strftime('%s','2026-07-15T00:00:00Z'),20260715,0,1,'sync','1','101',0,strftime('%s','2026-07-15T00:00:00Z'));INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('med-session-1',0,600);INSERT INTO meditation_logs(id,user_id,session_id,duration_seconds,completed_at,updated_at) VALUES('med-log-external',(SELECT id FROM users LIMIT 1),'external-log-session',1200,strftime('%s','2026-07-14T00:00:00Z'),1),('med-log-duplicate',(SELECT id FROM users LIMIT 1),'med-session-1',3000,strftime('%s','2026-07-15T00:00:00Z'),1);")
    check_true("reopen db", storage_init(root) != 0)
    streak: s32 = -1
    average: s64 = -1
    check_true("stats call", storage_profile_activity_stats(1, 20260715, *streak, *average) != 0)
    check_int("streak counts the external log day", streak, 2)
    check_int("average counts each session once", cast(s32)average, 900)
    check_true("stale day stats call", storage_profile_activity_stats(1, 20260716, *streak, *average) != 0)
    check_int("streak resets on a stale day", streak, 0)
    storage_close()
}

// Habit ids that are full UUIDs load intact, with their days.
test_uuid_habit_ids_load_days :: () {
    root := make_root("uuid-habit-load")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('940dd8b7-0d60-48ce-9c8f-433b9170b6b1',(SELECT id FROM users LIMIT 1),'Meditation',1,2,3,0,0,1,0,0,1782200000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('940dd8b7-0d60-48ce-9c8f-433b9170b6b1',20260629,1,1,0,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("habit count", habits_b.count, 1)
    check_true("uuid id is not truncated",
        TextFromCString(*habits_b.items[0].id[0]) == "940dd8b7-0d60-48ce-9c8f-433b9170b6b1")
    check_int("habit day loaded", habits_b.items[0].day_count, 1)
    if habits_b.items[0].day_count > 0 {
        check_int("habit day date", habits_b.items[0].days[0].day_index, 20260629)
    }
    habits_free(*habits_b)
    storage_close()
}

// Questions and their goals travel with the habit; an entry keeps its
// answers with the question's words, so they read the same after the
// question goes.
test_habit_questions_and_entries :: () {
    root := make_root("habit-questions")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('meal',(SELECT id FROM users LIMIT 1),'First meal',1,2,3,0,0,0,0,0,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit := *habits_b.items[0]
    check_int("no questions at first", habit.question_count, 0)
    check_true("add a time question",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    unused AppCopyText("When did I start \"eating\"?", habit.questions[0].text[:])
    habit.questions[0].answer_type = HABIT_ANSWER_TIME
    habit.questions[0].goal = HabitGoal.{.kind = HABIT_GOAL_AT_MOST, .high = 480}
    check_true("add a number question",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    unused AppCopyText("Plates", habit.questions[1].text[:])
    habit.questions[1].answer_type = HABIT_ANSWER_NUMBER
    check_true("add a question without words",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    HabitQuestionsKeepWorded(habit.questions[:], *habit.question_count)
    check_int("a question without words is dropped", habit.question_count, 2)
    check_true("each question has its own id",
        habit.questions[0].id != habit.questions[1].id)
    habit.span = 1
    habit.span_goal = HabitGoal.{.kind = HABIT_GOAL_BETWEEN, .low = 900, .high = 1080}
    time_id := habit.questions[0].id
    storage_habits_save(cast(*void)*habits_b)
    check_int("the habit is queued to sync",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit' AND entity_id='meal'"), 1)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit = *habits_b.items[0]
    check_int("questions kept", habit.question_count, 2)
    check_true("words kept, quotes too",
        HabitQuestionText(*habit.questions[0]) == "When did I start \"eating\"?")
    check_true("answer type and goal kept",
        habit.questions[0].answer_type == HABIT_ANSWER_TIME &&
        habit.questions[0].goal.kind == HABIT_GOAL_AT_MOST &&
        habit.questions[0].goal.high == 480)
    check_true("a question without a goal has none",
        habit.questions[1].goal.kind == HABIT_GOAL_NONE)
    check_true("span and its goal kept", habit.span == 1 &&
        habit.span_goal.kind == HABIT_GOAL_BETWEEN &&
        habit.span_goal.low == 900 && habit.span_goal.high == 1080)
    check_true("id kept", habit.questions[0].id == time_id)

    none: [1]HabitAnswer
    answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    count := HabitAnswersFor(habit, none[:], 0, answers[:])
    check_int("an entry asks every question", count, 2)
    unused AppCopyText("07:30", answers[0].value[:])
    unused AppCopyText("2", answers[1].value[:])
    first: [HABIT_ID_SIZE]u8
    check_true("save an entry", storage_habit_entry_save("", "meal", 20260701,
        1782900000, 1782900000, answers[:], count, first[:]) != 0)
    first_id := AppTextFromCString(*first[0], HABIT_ID_SIZE)
    check_true("a new entry gets an id", first_id.count > 0)
    check_int("the entry is queued to sync", read_db_count(
        "SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit_entry'"), 1)
    second: [HABIT_ID_SIZE]u8
    check_true("a day takes a second entry", storage_habit_entry_save("", "meal",
        20260701, 1782910000, 0, none[:], 0, second[:]) != 0)
    summaries: [HABIT_DAY_ENTRY_MAX]HabitEntrySummary
    check_int("both entries listed", storage_habit_day_entries("meal", 20260701,
        summaries[:]), 2)
    check_true("listed in the order they started",
        AppTextFromCString(*summaries[0].id[0], HABIT_ID_SIZE) == first_id &&
        summaries[1].ended_at == 0)
    check_true("a running span is found", true)
    storage_habit_running_span(habit)
    check_true("the habit's running span is the second entry",
        AppTextFromCString(*habit.running_entry[0], HABIT_ID_SIZE) ==
        AppTextFromCString(*second[0], HABIT_ID_SIZE) &&
        habit.running_day == 20260701 && habit.running_since == 1782910000)
    check_true("a span's day counts only ended spans",
        storage_habit_day_has_entries("meal", 20260701, true) &&
        !storage_habit_day_has_entries("meal", 20260702, false))

    loaded: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    loaded_count: s32 = 0
    started: s64 = 0
    ended: s64 = 0
    check_true("load the entry", storage_habit_entry_load(first_id, *started,
        *ended, loaded[:], *loaded_count) && started == 1782900000 &&
        ended == 1782900000)
    check_int("answers loaded", loaded_count, 2)
    check_true("time answer loaded", HabitAnswerValue(*loaded[0]) == "07:30" &&
        loaded[0].id == time_id && loaded[0].answer_type == HABIT_ANSWER_TIME)
    check_true("question words kept with the answer",
        HabitAnswerQuestion(*loaded[0]) == "When did I start \"eating\"?")

    HabitQuestionRemove(habit.questions[:], *habit.question_count, 0)
    shown := HabitAnswersFor(habit, loaded[:], loaded_count, answers[:])
    check_int("a removed question's answer still shows", shown, 2)
    check_true("current questions come first",
        HabitAnswerQuestion(*answers[0]) == "Plates" &&
        HabitAnswerValue(*answers[0]) == "2")
    check_true("the removed question keeps its words",
        HabitAnswerValue(*answers[1]) == "07:30" && answers[1].id == time_id)

    check_true("delete the entry", storage_habit_entry_delete(first_id) != 0)
    check_true("a deleted entry is gone", !storage_habit_entry_load(first_id,
        *started, *ended, loaded[:], *loaded_count) &&
        storage_habit_day_entries("meal", 20260701, summaries[:]) == 1)
    check_int("the deletion is kept to sync", read_db_count(
        "SELECT COUNT(*) FROM habit_entries WHERE deleted_at>0"), 1)
    habits_free(*habits_b)
    storage_close()
}

test_entry_statistics :: () {
    root := make_root("habit-entry-stats")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at,questions,span,span_goal,span_low) VALUES('sleep',(SELECT id FROM users LIMIT 1),'Sleep',1,2,3,0,0,0,0,0,1782200000,'[{\"id\":1,\"type\":\"time\",\"text\":\"Bedtime\",\"goal\":\"at_most\",\"low\":0,\"high\":30},{\"id\":2,\"type\":\"number\",\"text\":\"Pages\",\"goal\":\"between\",\"low\":2,\"high\":5},{\"id\":3,\"type\":\"yes_no\",\"text\":\"Tea\",\"goal\":\"yes\"},{\"id\":4,\"type\":\"text\",\"text\":\"Dream\"}]',1,1,480);INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES('a',(SELECT id FROM users LIMIT 1),'sleep',20260701,1782950000,1782950000+30600,'[{\"id\":1,\"type\":\"time\",\"question\":\"Bedtime\",\"value\":\"23:30\"},{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"2\"},{\"id\":3,\"type\":\"yes_no\",\"question\":\"Tea\",\"value\":\"yes\"},{\"id\":4,\"type\":\"text\",\"question\":\"Dream\",\"value\":\"Flying\"}]',0,1782200000),('b',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783036000,1783036000+25200,'[{\"id\":1,\"type\":\"time\",\"question\":\"Bedtime\",\"value\":\"00:30\"},{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"3\"},{\"id\":3,\"type\":\"yes_no\",\"question\":\"Tea\",\"value\":\"no\"},{\"id\":4,\"type\":\"text\",\"question\":\"Dream\",\"value\":\"Sea\"}]',0,1782200000),('c',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783050000,1783050000+600,'[{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"9\"}]',0,1782200000),('gone',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783060000,1783061000,'[{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"100\"}]',1,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit := *habits_b.items[0]
    check_int("questions read from JSON", habit.question_count, 4)
    check_true("goals read from JSON",
        habit.questions[0].goal.kind == HABIT_GOAL_AT_MOST &&
        habit.questions[1].goal.kind == HABIT_GOAL_BETWEEN &&
        habit.questions[2].goal.kind == HABIT_GOAL_YES)
    days: [HABIT_ANSWER_STATS_DAYS]s32
    slot: s32 = 0
    while slot < HABIT_ANSWER_STATS_DAYS {
        days[slot] = 20260701 + slot
        slot += 1
    }
    stats: HabitAnswerStats
    text: [16]u8
    unused storage_habit_answer_stats("sleep", *habit.questions[0], days[:], *stats)
    check_int("bedtimes answered", stats.answered, 2)
    check_true("bedtimes around midnight average to midnight",
        HabitAnswerTimeText(cast(s32)((HabitAnswerStatsAverage100(*stats) + 50) / 100),
        text[:]) == "00:00")
    check_true("earliest and latest bedtime",
        HabitAnswerTimeText(stats.lowest, text[:]) == "23:30" &&
        HabitAnswerTimeText(stats.highest, text[:]) == "00:30")
    check_true("a bedtime by 00:30 is good, 23:30 is not",
        stats.judged == 2 && stats.good == 1)
    unused storage_habit_answer_stats("sleep", *habit.questions[1], days[:], *stats)
    check_true("pages of every entry count, not a deleted one",
        stats.answered == 3 && stats.sum == 14 && stats.days == 2)
    check_true("pages within 2 to 5 are good", stats.judged == 3 && stats.good == 2)
    check_true("pages average 4.7",
        HabitAnswerDecimalText(HabitAnswerStatsAverage100(*stats), text[:]) == "4.7")
    unused storage_habit_answer_stats("sleep", *habit.questions[2], days[:], *stats)
    check_true("one yes, one no, the yes is good", stats.yes == 1 &&
        stats.no == 1 && stats.good == 1 && stats.judged == 2)
    unused storage_habit_answer_stats("sleep", *habit.questions[3], days[:], *stats)
    check_true("newest text answer first", stats.recent_count == 2 &&
        AppTextFromCString(*stats.recent[0][0], HABIT_ANSWER_SIZE) == "Sea" &&
        stats.recent_days[0] == 20260702)
    lengths: HabitAnswerStats
    starts: HabitAnswerStats
    ends: HabitAnswerStats
    unused storage_habit_span_stats(habit, days[:], *lengths, *starts, *ends)
    check_true("span lengths in minutes", lengths.point_count == 3 &&
        lengths.highest == 510 && lengths.lowest == 10)
    check_true("spans of at least 8 hours are good",
        lengths.judged == 3 && lengths.good == 1)
    check_int("the starts are counted too", starts.point_count, 3)
    check_true("Unix time and local day agree",
        storage_local_date_of(storage_unix_at(20260701, 450)) == 20260701 &&
        storage_local_minutes_of(storage_unix_at(20260701, 450)) == 450)
    check_true("minutes past the day fall on the next",
        storage_local_date_of(storage_unix_at(20260701, 1440 + 60)) == 20260702)
    habits_free(*habits_b)
    storage_close()

    check_true("a goal between later and earlier times spans midnight",
        HabitGoalMet(HabitGoal.{.kind = HABIT_GOAL_BETWEEN, .low = 1320, .high = 60}, 30) == 1 &&
        HabitGoalMet(HabitGoal.{.kind = HABIT_GOAL_BETWEEN, .low = 1320, .high = 60}, 600) == 0)
    typed: [8]u8
    check_true("typed 7 and 5 read 07:05",
        HabitTimeFromTyped("7", "5", typed[:]) &&
        AppTextFromCString(*typed[0], 8) == "07:05")
    check_true("no hours, no time",
        HabitTimeFromTyped("", "30", typed[:]) &&
        AppTextFromCString(*typed[0], 8) == "")
    check_true("24 hours is not a time", !HabitTimeFromTyped("24", "00", typed[:]))
    hours: s32 = 0
    minutes: s32 = 0
    check_true("9:05 reads", HabitTimeParts("9:05", *hours, *minutes) &&
        hours == 9 && minutes == 5)
    check_true("9:5 does not", !HabitTimeParts("9:5", *hours, *minutes))
    check_true("a length reads in hours and minutes",
        HabitSpanText(965, text[:]) == "16h 05m" && HabitSpanText(45, text[:]) == "45m")
}

#program_export
Check :: () -> s32 {
    guard := support_begin("/tmp/inbe-storage-habits-zi-test/")
    if guard != 0 { return guard }
    test_habit_name_merge_import()
    test_import_conflict_prefers_data()
    test_delete_all_resets()
    test_empty_initialized_seeds_meditation()
    test_defaults_wait_for_language()
    test_default_meditation_not_repaired()
    test_import_modes()
    test_session_metadata()
    test_profile_week_stats()
    test_linked_counts_materialize()
    test_existing_sessions_materialize()
    test_meditation_logs_feed_profile_stats()
    test_uuid_habit_ids_load_days()
    test_habit_questions_and_entries()
    test_entry_statistics()
    return failures
}
