    root := make_root("deferred-defaults")
    check_true("init db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_init_with_defaults(*habits_a, 0)
    check_int("deferred startup keeps habits empty", habits_a.count, 0)
