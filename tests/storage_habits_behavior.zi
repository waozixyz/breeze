        storage_save_session_for_activity(*rounds[0], 2, 2, 3, null, 0) != 0)
    metadata_topic = -1
    metadata_activity = -1
    callback: StorageSessionRecordCallback = record_metadata
    storage_list_session_records(callback, null)
    check_int("metadata topic", metadata_topic, 2)
    check_int("metadata activity", metadata_activity, 3)
    storage_close()
}

test_profile_week_stats :: () {
    root := make_root("profile-week")
    rounds: [1]s32 = .[45]
    check_true("init profile week db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_save(*habits_a)
    check_true("session today", storage_save_session_at_for_activity(20260715, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    check_true("session earlier", storage_save_session_at_for_activity(20260713, 9, 0, 0, *rounds[0], 1, 0, 1, null, 0) != 0)
    check_true("session outside week", storage_save_session_at_for_activity(20260708, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    habit_id := TextFromCString(*habits_a.items[0].id[0])
    check_true("habit distinct day", storage_habit_day_save(habit_id, 20260714, 1, 1) != 0)
    check_true("habit overlapping day", storage_habit_day_save(habit_id, 20260713, 1, 1) != 0)
    active_days: s32 = -1
    practice_sessions: s32 = -1
    check_true("week stats call", storage_profile_week_stats(20260715, *active_days, *practice_sessions) != 0)
    check_int("week active days", active_days, 3)
    check_int("week practice sessions", practice_sessions, 2)
    habits_free(*habits_a)
    storage_close()
}

test_linked_counts_materialize :: () {
    root := make_root("linked-counts")
    first: [1]s32 = .[30]
    second: [1]s32 = .[45]
    first_id: [44]u8
    second_id: [44]u8
    today := habits_today_index()
    check_true("init linked counter db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    check_true("save session one", storage_save_session_for_activity(*first[0], 1, 0, 1, *first_id[0], 44) != 0)
    check_true("save session two", storage_save_session_for_activity(*second[0], 1, 0, 1, *second_id[0], 44) != 0)
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load linked habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("linked sessions materialize count", day_count_of(*habits_b.items[0], today), 2)
    habit_set_day_count(*habits_b, 0, today, 0)
    habits_save(*habits_b)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after manual clear", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("manual clear overrides linked sessions", day_count_of(*habits_b.items[0], today), 0)
    habit_set_day_count(*habits_b, 0, today, 2)
    habits_save(*habits_b)
    check_true("delete linked session one", storage_delete_session(TextFromCString(*first_id[0])) != 0)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after delete", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("delete lowers derived count", day_count_of(*habits_b.items[0], today), 1)
    habit_set_day_count(*habits_b, 0, today, 4)
    habits_save(*habits_b)
    check_true("delete linked session two", storage_delete_session(TextFromCString(*second_id[0])) != 0)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after manual override", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("delete preserves manual count", day_count_of(*habits_b.items[0], today), 4)
    habits_free(*habits_b)
    storage_close()
}

