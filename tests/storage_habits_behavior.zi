    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load deferred seeded defaults", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("deferred persisted count", habits_b.count, 2)
    habits_free(*habits_b)
    storage_close()
}

test_default_meditation_not_repaired :: () {
    root := make_root("default-meditation")
    check_true("init db", storage_init(root) != 0)
    habits_a = Habits.{}
    check_int("add unlinked meditation", habits_add_custom(*habits_a, "Meditation", Blue(), 0, 0), 0)
    habits_free(*habits_a)
    habits_a = Habits.{}
    habits_init(*habits_a)
    check_int("no repair count", habits_a.count, 1)
    meditation := find_habit(*habits_a, "Meditation")
    check_true("no repair exists", meditation != null)
    if meditation != null {
        check_int("no repair sync mode", meditation.sync_mode, 0)
        check_int("no repair sync activity", meditation.sync_activity, 0)
    }
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load unchanged meditation", storage_habits_load(cast(*void)*habits_b) != 0)
    persisted := find_habit(*habits_b, "Meditation")
    if persisted != null {
        check_int("persisted unchanged sync mode", persisted.sync_mode, 0)
        check_int("persisted unchanged sync activity", persisted.sync_activity, 0)
    } else {
        check_true("persisted meditation exists", false)
    }
    habits_free(*habits_b)
    storage_close()
}

write_multi_habit_source :: (root: string, archive: string) {
    rounds: [1]s32 = .[77]
    check_true("init multi habit source", storage_init(root) != 0)
    check_true("save source session", storage_save_session_for_activity(*rounds[0], 1, 0, 1, null, 0) != 0)
    habits_a = Habits.{}
    check_int("add meditation", habits_add_custom(*habits_a, "Meditation", Orange(), 1, 1 | 2), 0)
    check_int("add push ups", habits_add_custom(*habits_a, "Push ups", Purple(), 0, 0), 1)
    check_int("add cold shower", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0), 2)
    habit_set_day(*habits_a, 0, 20260617, 1)
    habits_save(*habits_a)
    habit_set_day(*habits_a, 1, 20260617, 1)
    habits_save(*habits_a)
    habit_set_day(*habits_a, 2, 20260617, 1)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_set_setting_int("speed", 7)
    storage_set_setting_int("sun_salutation_character", 3)
    storage_set_setting_int("sun_salutation_repetitions", 6)
    storage_set_setting_int("sun_salutation_start_seconds", 9)
    storage_set_setting_int("sun_salutation_end_seconds", 4)
    storage_set_setting_int("audio_custom_music_count", 1)
    storage_set_setting_text("audio_custom_music_0_title", "Test track")
    storage_set_setting_text("audio_custom_music_0_path", "/tmp/test-track.ogg")
    storage_set_setting_text("audio_custom_music_0_file", "ignore-me")
    storage_set_setting_text("language", "en")
    storage_set_setting_text("future_unknown_key", "ignore-me")
    check_true("export multi habit source", storage_export_zip(archive) != 0)
    storage_close()
}

assert_multi_habits_imported :: (root: string, want_speed: s32, expect_settings: bool) {
    check_true("init multi habit import db", storage_init(root) != 0)
    check_int("imported sessions", storage_session_count(), 1)
    habits_b = Habits.{}
    check_true("multi habit load", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("multi habit count", habits_b.count, 3)
    meditation := find_habit(*habits_b, "Meditation")
    check_true("multi meditation exists", meditation != null)
    if meditation != null {
        check_int("multi meditation sync mode", meditation.sync_mode, 1)
        check_int("multi meditation sync activity", meditation.sync_activity, 1 | 2)
    }
    check_true("multi meditation day", has_day(meditation, 20260617))
    check_true("multi push ups day", has_day(find_habit(*habits_b, "Push ups"), 20260617))
    check_true("multi cold shower day", has_day(find_habit(*habits_b, "Cold Shower"), 20260617))
    habits_free(*habits_b)
    check_int("import speed setting", storage_get_setting_int("speed", -1), want_speed)
    if expect_settings {
        check_int("sun character", storage_get_setting_int("sun_salutation_character", -1), 3)
        check_int("sun reps", storage_get_setting_int("sun_salutation_repetitions", -1), 6)
        check_int("sun start", storage_get_setting_int("sun_salutation_start_seconds", -1), 9)
        check_int("sun end", storage_get_setting_int("sun_salutation_end_seconds", -1), 4)
        check_int("audio count", storage_get_setting_int("audio_custom_music_count", -1), 1)
        check_true("audio title", storage_get_setting_text("audio_custom_music_0_title") == "Test track")
        check_true("audio path", storage_get_setting_text("audio_custom_music_0_path") == "/tmp/test-track.ogg")
    } else {
        check_int("data-only skips sun character", storage_get_setting_int("sun_salutation_character", -1), -1)
        check_int("data-only skips sun reps", storage_get_setting_int("sun_salutation_repetitions", -1), -1)
        check_int("data-only skips audio count", storage_get_setting_int("audio_custom_music_count", -1), -1)
    }
    check_true("malformed audio setting ignored",
        storage_get_setting_text("audio_custom_music_0_file").count == 0)
    check_true("unknown setting ignored", storage_get_setting_text("future_unknown_key").count == 0)
    storage_close()
}

test_import_modes :: () {
    source := make_root("multi-source")
    dest_data := make_root("multi-dest-data")
    dest_settings := make_root("multi-dest-settings")
    archive: TextBuffer
    append(*archive, source)
    append(*archive, "/multi-export.zip")
    archive_path := TextFromCString(*archive.bytes[0])
    write_multi_habit_source(source, archive_path)

    check_true("init inspect dest", storage_init(dest_data) != 0)
    info: StorageImportInfo
    check_true("inspect multi export", storage_inspect_import(archive_path, *info) != 0)
    check_true("inspect valid", info.valid != 0)
    check_true("inspect sessions", info.has_sessions != 0)
    check_true("inspect habits", info.has_habits != 0)
    check_true("inspect settings", info.has_settings != 0)
    check_int("inspect habit count", info.habit_count, 3)
    storage_set_setting_int("speed", 1)
    check_true("data only import",
        storage_import_zip_ex(archive_path, cast(StorageImportMode)0) != 0)
    storage_close()
    assert_multi_habits_imported(dest_data, 1, false)

    check_true("init settings import dest", storage_init(dest_settings) != 0)
    storage_set_setting_int("speed", 1)
    check_true("data and settings import",
        storage_import_zip_ex(archive_path, cast(StorageImportMode)1) != 0)
    storage_close()
    assert_multi_habits_imported(dest_settings, 7, true)
}

metadata_topic: s32;
metadata_activity: s32;

record_metadata :: (path: string, year: s32, month: s32, day: s32, hour: s32,
    minute: s32, second: s32, topic: s32, activity: s32, round_times: []s32,
    round_count: s32, user: s64) {
    unused path
    unused year
    unused month
    unused day
    unused hour
    unused minute
    unused second
    unused round_times
    unused round_count
    unused user
    metadata_topic = topic
    metadata_activity = activity
}

test_session_metadata :: () {
    root := make_root("metadata")
    rounds: [2]s32 = .[30, 45]
    check_true("init metadata db", storage_init(root) != 0)
    check_true("save metadata session",
        storage_save_session_for_activity(*rounds[0], 2, 2, 3, null, 0) != 0)
    metadata_topic = -1
    metadata_activity = -1
    callback: StorageSessionRecordCallback = record_metadata
    storage_list_session_records(callback, null)
    check_int("metadata topic", metadata_topic, 2)
    check_int("metadata activity", metadata_activity, 3)
    storage_close()
}

test_profile_week_stats :: () {
    root := make_root("profile-week")
    rounds: [1]s32 = .[45]
    check_true("init profile week db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_save(*habits_a)
    check_true("session today", storage_save_session_at_for_activity(20260715, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    check_true("session earlier", storage_save_session_at_for_activity(20260713, 9, 0, 0, *rounds[0], 1, 0, 1, null, 0) != 0)
    check_true("session outside week", storage_save_session_at_for_activity(20260708, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    habit_id := TextFromCString(*habits_a.items[0].id[0])
    check_true("habit distinct day", storage_habit_day_save(habit_id, 20260714, 1, 1) != 0)
    check_true("habit overlapping day", storage_habit_day_save(habit_id, 20260713, 1, 1) != 0)
    active_days: s32 = -1
    practice_sessions: s32 = -1
    check_true("week stats call", storage_profile_week_stats(20260715, *active_days, *practice_sessions) != 0)
    check_int("week active days", active_days, 3)
    check_int("week practice sessions", practice_sessions, 2)
    // The week crosses a month boundary; 20260627 is seven days back.
    check_true("session start of month", storage_save_session_at_for_activity(20260701, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    check_true("session end of month", storage_save_session_at_for_activity(20260628, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    check_true("session before week", storage_save_session_at_for_activity(20260627, 9, 0, 0, *rounds[0], 1, 0, 0, null, 0) != 0)
    check_true("month week stats call", storage_profile_week_stats(20260704, *active_days, *practice_sessions) != 0)
    check_int("month week active days", active_days, 2)
    check_int("month week practice sessions", practice_sessions, 2)
    habits_free(*habits_a)
    storage_close()
}

test_linked_counts_materialize :: () {
    root := make_root("linked-counts")
    first: [1]s32 = .[30]
    second: [1]s32 = .[45]
    first_id: [44]u8
    second_id: [44]u8
    today := habits_today_index()
    check_true("init linked counter db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    check_true("save session one", storage_save_session_for_activity(*first[0], 1, 0, 1, *first_id[0], 44) != 0)
    check_true("save session two", storage_save_session_for_activity(*second[0], 1, 0, 1, *second_id[0], 44) != 0)
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load linked habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("linked sessions materialize count", day_count_of(*habits_b.items[0], today), 2)
    habit_set_day_count(*habits_b, 0, today, 0)
    habits_save(*habits_b)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after manual clear", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("manual clear overrides linked sessions", day_count_of(*habits_b.items[0], today), 0)
    habit_set_day_count(*habits_b, 0, today, 2)
    habits_save(*habits_b)
    check_true("delete linked session one", storage_delete_session(TextFromCString(*first_id[0])) != 0)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after delete", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("delete lowers derived count", day_count_of(*habits_b.items[0], today), 1)
    habit_set_day_count(*habits_b, 0, today, 4)
    habits_save(*habits_b)
    check_true("delete linked session two", storage_delete_session(TextFromCString(*second_id[0])) != 0)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload after manual override", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("delete preserves manual count", day_count_of(*habits_b.items[0], today), 4)
    habits_free(*habits_b)
    storage_close()
}

test_existing_sessions_materialize :: () {
    root := make_root("existing-linked")
    rounds: [1]s32 = .[30]
    today := habits_today_index()
    check_true("init db", storage_init(root) != 0)
    check_true("save existing session", storage_save_session_for_activity(*rounds[0], 1, 0, 1, null, 0) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("existing session materializes after habit save", day_count_of(*habits_b.items[0], today), 1)
    habits_free(*habits_b)
    storage_close()
}

// External meditation logs count towards the profile streak and average; a
// log for a session that exists is not counted twice.
test_meditation_logs_feed_profile_stats :: () {
    root := make_root("meditation-log-stats")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('med-session-1',(SELECT id FROM users LIMIT 1),strftime('%s','2026-07-15T00:00:00Z'),20260715,0,1,'sync','1','101',0,strftime('%s','2026-07-15T00:00:00Z'));INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('med-session-1',0,600);INSERT INTO meditation_logs(id,user_id,session_id,duration_seconds,completed_at,updated_at) VALUES('med-log-external',(SELECT id FROM users LIMIT 1),'external-log-session',1200,strftime('%s','2026-07-14T00:00:00Z'),1),('med-log-duplicate',(SELECT id FROM users LIMIT 1),'med-session-1',3000,strftime('%s','2026-07-15T00:00:00Z'),1);")
    check_true("reopen db", storage_init(root) != 0)
    streak: s32 = -1
    average: s64 = -1
    check_true("stats call", storage_profile_activity_stats(1, 20260715, *streak, *average) != 0)
    check_int("streak counts the external log day", streak, 2)
    check_int("average counts each session once", cast(s32)average, 900)
    check_true("stale day stats call", storage_profile_activity_stats(1, 20260716, *streak, *average) != 0)
    check_int("streak resets on a stale day", streak, 0)
    storage_close()
}

// Habit ids that are full UUIDs load intact, with their days.
test_uuid_habit_ids_load_days :: () {
    root := make_root("uuid-habit-load")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('940dd8b7-0d60-48ce-9c8f-433b9170b6b1',(SELECT id FROM users LIMIT 1),'Meditation',1,2,3,0,0,1,0,0,1782200000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('940dd8b7-0d60-48ce-9c8f-433b9170b6b1',20260629,1,1,0,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("habit count", habits_b.count, 1)
    check_true("uuid id is not truncated",
        TextFromCString(*habits_b.items[0].id[0]) == "940dd8b7-0d60-48ce-9c8f-433b9170b6b1")
    check_int("habit day loaded", habits_b.items[0].day_count, 1)
    if habits_b.items[0].day_count > 0 {
        check_int("habit day date", habits_b.items[0].days[0].day_index, 20260629)
    }
    habits_free(*habits_b)
    storage_close()
}

// Questions and their goals travel with the habit; an entry keeps its
// answers with the question's words, so they read the same after the
// question goes.
test_habit_questions_and_entries :: () {
    root := make_root("habit-questions")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('meal',(SELECT id FROM users LIMIT 1),'First meal',1,2,3,0,0,0,0,0,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit := *habits_b.items[0]
    check_int("no questions at first", habit.question_count, 0)
    check_true("add a time question",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    unused AppCopyText("When did I start \"eating\"?", habit.questions[0].text[:])
    habit.questions[0].answer_type = HABIT_ANSWER_TIME
    habit.questions[0].goal = HabitGoal.{.kind = HABIT_GOAL_AT_MOST, .high = 480}
    check_true("add a number question",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    unused AppCopyText("Plates", habit.questions[1].text[:])
    habit.questions[1].answer_type = HABIT_ANSWER_NUMBER
    check_true("add a question without words",
        HabitQuestionAdd(habit.questions[:], *habit.question_count, 1782200000))
    HabitQuestionsKeepWorded(habit.questions[:], *habit.question_count)
    check_int("a question without words is dropped", habit.question_count, 2)
    check_true("each question has its own id",
        habit.questions[0].id != habit.questions[1].id)
    habit.span = 1
    time_id := habit.questions[0].id
    storage_habits_save(cast(*void)*habits_b)
    check_int("the habit is queued to sync",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit' AND entity_id='meal'"), 1)
    habits_free(*habits_b)
    habits_b = Habits.{}
    check_true("reload habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit = *habits_b.items[0]
    check_int("questions kept", habit.question_count, 2)
    check_true("words kept, quotes too",
        HabitQuestionText(*habit.questions[0]) == "When did I start \"eating\"?")
    check_true("answer type and goal kept",
        habit.questions[0].answer_type == HABIT_ANSWER_TIME &&
        habit.questions[0].goal.kind == HABIT_GOAL_AT_MOST &&
        habit.questions[0].goal.high == 480)
    check_true("a question without a goal has none",
        habit.questions[1].goal.kind == HABIT_GOAL_NONE)
    check_int("span kept", habit.span, 1)
    check_true("id kept", habit.questions[0].id == time_id)

    none: [1]HabitAnswer
    answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    count := HabitAnswersFor(habit, none[:], 0, answers[:])
    check_int("an entry asks every question", count, 2)
    unused AppCopyText("07:30", answers[0].value[:])
    unused AppCopyText("2", answers[1].value[:])
    first: [HABIT_ID_SIZE]u8
    check_true("save an entry", storage_habit_entry_save("", "meal", 20260701,
        1782900000, 1782900000, answers[:], count, first[:]) != 0)
    first_id := AppTextFromCString(*first[0], HABIT_ID_SIZE)
    check_true("a new entry gets an id", first_id.count > 0)
    check_int("the entry is queued to sync", read_db_count(
        "SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit_entry'"), 1)
    second: [HABIT_ID_SIZE]u8
    check_true("a day takes a second entry", storage_habit_entry_save("", "meal",
        20260701, 1782910000, 0, none[:], 0, second[:]) != 0)
    summaries: [HABIT_DAY_ENTRY_MAX]HabitEntrySummary
    check_int("both entries listed", storage_habit_day_entries("meal", 20260701,
        summaries[:]), 2)
    check_true("listed in the order they started",
        AppTextFromCString(*summaries[0].id[0], HABIT_ID_SIZE) == first_id &&
        summaries[1].ended_at == 0)
    check_true("a running span is found", true)
    storage_habit_running_span(habit)
    check_true("the habit's running span is the second entry",
        AppTextFromCString(*habit.running_entry[0], HABIT_ID_SIZE) ==
        AppTextFromCString(*second[0], HABIT_ID_SIZE) &&
        habit.running_day == 20260701 && habit.running_since == 1782910000)
    check_true("a span's day counts only ended spans",
        storage_habit_day_has_entries("meal", 20260701, true) &&
        !storage_habit_day_has_entries("meal", 20260702, false))

    loaded: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    loaded_count: s32 = 0
    started: s64 = 0
    ended: s64 = 0
    check_true("load the entry", storage_habit_entry_load(first_id, *started,
        *ended, loaded[:], *loaded_count) && started == 1782900000 &&
        ended == 1782900000)
    check_int("answers loaded", loaded_count, 2)
    check_true("time answer loaded", HabitAnswerValue(*loaded[0]) == "07:30" &&
        loaded[0].id == time_id && loaded[0].answer_type == HABIT_ANSWER_TIME)
    check_true("question words kept with the answer",
        HabitAnswerQuestion(*loaded[0]) == "When did I start \"eating\"?")

    HabitQuestionRemove(habit.questions[:], *habit.question_count, 0)
    shown := HabitAnswersFor(habit, loaded[:], loaded_count, answers[:])
    check_int("a removed question's answer still shows", shown, 2)
    check_true("current questions come first",
        HabitAnswerQuestion(*answers[0]) == "Plates" &&
        HabitAnswerValue(*answers[0]) == "2")
    check_true("the removed question keeps its words",
        HabitAnswerValue(*answers[1]) == "07:30" && answers[1].id == time_id)

    check_true("delete the entry", storage_habit_entry_delete(first_id) != 0)
    check_true("a deleted entry is gone", !storage_habit_entry_load(first_id,
        *started, *ended, loaded[:], *loaded_count) &&
        storage_habit_day_entries("meal", 20260701, summaries[:]) == 1)
    check_int("the deletion is kept to sync", read_db_count(
        "SELECT COUNT(*) FROM habit_entries WHERE deleted_at>0"), 1)
    habits_free(*habits_b)
    storage_close()
}

test_entry_statistics :: () {
    root := make_root("habit-entry-stats")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at,questions,span) VALUES('sleep',(SELECT id FROM users LIMIT 1),'Sleep',1,2,3,0,0,0,0,0,1782200000,'[{\"id\":1,\"type\":\"time\",\"text\":\"Bedtime\",\"goal\":\"at_most\",\"low\":0,\"high\":30},{\"id\":2,\"type\":\"number\",\"text\":\"Pages\",\"goal\":\"between\",\"low\":2,\"high\":5},{\"id\":3,\"type\":\"yes_no\",\"text\":\"Tea\",\"goal\":\"yes\"},{\"id\":4,\"type\":\"text\",\"text\":\"Dream\"}]',1);INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES('a',(SELECT id FROM users LIMIT 1),'sleep',20260701,1782950000,1782950000+30600,'[{\"id\":1,\"type\":\"time\",\"question\":\"Bedtime\",\"value\":\"23:30\"},{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"2\"},{\"id\":3,\"type\":\"yes_no\",\"question\":\"Tea\",\"value\":\"yes\"},{\"id\":4,\"type\":\"text\",\"question\":\"Dream\",\"value\":\"Flying\"}]',0,1782200000),('b',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783036000,1783036000+25200,'[{\"id\":1,\"type\":\"time\",\"question\":\"Bedtime\",\"value\":\"00:30\"},{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"3\"},{\"id\":3,\"type\":\"yes_no\",\"question\":\"Tea\",\"value\":\"no\"},{\"id\":4,\"type\":\"text\",\"question\":\"Dream\",\"value\":\"Sea\"}]',0,1782200000),('c',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783050000,1783050000+600,'[{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"9\"}]',0,1782200000),('gone',(SELECT id FROM users LIMIT 1),'sleep',20260702,1783060000,1783061000,'[{\"id\":2,\"type\":\"number\",\"question\":\"Pages\",\"value\":\"100\"}]',1,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit := *habits_b.items[0]
    check_int("questions read from JSON", habit.question_count, 4)
    check_true("goals read from JSON",
        habit.questions[0].goal.kind == HABIT_GOAL_AT_MOST &&
        habit.questions[1].goal.kind == HABIT_GOAL_BETWEEN &&
        habit.questions[2].goal.kind == HABIT_GOAL_YES)
    days: [HABIT_ANSWER_STATS_DAYS]s32
    slot: s32 = 0
    while slot < HABIT_ANSWER_STATS_DAYS {
        days[slot] = 20260701 + slot
        slot += 1
    }
    stats: HabitAnswerStats
    text: [16]u8
    unused storage_habit_answer_stats("sleep", *habit.questions[0], days[:], *stats)
    check_int("bedtimes answered", stats.answered, 2)
    check_true("bedtimes around midnight average to midnight",
        HabitAnswerTimeText(cast(s32)((HabitAnswerStatsAverage100(*stats) + 50) / 100),
        text[:]) == "00:00")
    check_true("earliest and latest bedtime",
        HabitAnswerTimeText(stats.lowest, text[:]) == "23:30" &&
        HabitAnswerTimeText(stats.highest, text[:]) == "00:30")
    check_true("a bedtime by 00:30 is good, 23:30 is not",
        stats.judged == 2 && stats.good == 1)
    unused storage_habit_answer_stats("sleep", *habit.questions[1], days[:], *stats)
    check_true("pages of every entry count, not a deleted one",
        stats.answered == 3 && stats.sum == 14 && stats.days == 2)
    check_true("pages within 2 to 5 are good", stats.judged == 3 && stats.good == 2)
    check_true("pages average 4.7",
        HabitAnswerDecimalText(HabitAnswerStatsAverage100(*stats), text[:]) == "4.7")
    unused storage_habit_answer_stats("sleep", *habit.questions[2], days[:], *stats)
    check_true("one yes, one no, the yes is good", stats.yes == 1 &&
        stats.no == 1 && stats.good == 1 && stats.judged == 2)
    unused storage_habit_answer_stats("sleep", *habit.questions[3], days[:], *stats)
    check_true("newest text answer first", stats.recent_count == 2 &&
        AppTextFromCString(*stats.recent[0][0], HABIT_ANSWER_SIZE) == "Sea" &&
        stats.recent_days[0] == 20260702)
    lengths: HabitAnswerStats
    starts: HabitAnswerStats
    ends: HabitAnswerStats
    unused storage_habit_span_stats(habit, days[:], *lengths, *starts, *ends)
    check_true("span lengths in minutes", lengths.point_count == 3 &&
        lengths.highest == 510 && lengths.lowest == 10)
    check_int("spans without a goal are measured, not judged", lengths.judged, 0)
    check_int("the starts are counted too", starts.point_count, 3)
    check_true("Unix time and local day agree",
        storage_local_date_of(storage_unix_at(20260701, 450)) == 20260701 &&
        storage_local_minutes_of(storage_unix_at(20260701, 450)) == 450)
    check_true("minutes past the day fall on the next",
        storage_local_date_of(storage_unix_at(20260701, 1440 + 60)) == 20260702)
    habits_free(*habits_b)
    storage_close()

    check_true("a goal between later and earlier times spans midnight",
        HabitGoalMet(HabitGoal.{.kind = HABIT_GOAL_BETWEEN, .low = 1320, .high = 60}, 30) == 1 &&
        HabitGoalMet(HabitGoal.{.kind = HABIT_GOAL_BETWEEN, .low = 1320, .high = 60}, 600) == 0)
    typed: [8]u8
    check_true("typed 7 and 5 read 07:05",
        HabitTimeFromTyped("7", "5", typed[:]) &&
        AppTextFromCString(*typed[0], 8) == "07:05")
    check_true("no hours, no time",
        HabitTimeFromTyped("", "30", typed[:]) &&
        AppTextFromCString(*typed[0], 8) == "")
    check_true("24 hours is not a time", !HabitTimeFromTyped("24", "00", typed[:]))
    hours: s32 = 0
    minutes: s32 = 0
    check_true("9:05 reads", HabitTimeParts("9:05", *hours, *minutes) &&
        hours == 9 && minutes == 5)
    check_true("9:5 does not", !HabitTimeParts("9:5", *hours, *minutes))
    check_true("a length reads in hours and minutes",
        HabitSpanText(965, text[:]) == "16h 05m" && HabitSpanText(45, text[:]) == "45m")
}

// Average goals judge each value against the average of the values before
// it, from before the days counted too; a changed goal judges values by
// the goal they had; saving a habit records what changed.
test_average_goals_and_changes :: () {
    root := make_root("habit-average-goals")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at,questions,span,span_goal) VALUES('jump',(SELECT id FROM users LIMIT 1),'Jumping',1,2,3,0,0,0,0,0,1782200000,'[{\"id\":1,\"type\":\"number\",\"text\":\"How many?\",\"goal\":\"above_average\"},{\"id\":2,\"type\":\"number\",\"text\":\"Minutes\",\"goal\":\"at_most\",\"low\":0,\"high\":20}]',1,7);")
    raw_exec(root, "INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES('e1',(SELECT id FROM users LIMIT 1),'jump',20260620,1782000000,1782000000+3600,'[{\"id\":1,\"value\":\"10\"}]',0,1782200000),('e2',(SELECT id FROM users LIMIT 1),'jump',20260621,1782086400,1782086400+3600,'[{\"id\":1,\"value\":\"20\"}]',0,1782200000),('a',(SELECT id FROM users LIMIT 1),'jump',20260701,1782950000,1782950000+1800,'[{\"id\":1,\"value\":\"15\"},{\"id\":2,\"value\":\"30\"}]',0,1782200000),('b',(SELECT id FROM users LIMIT 1),'jump',20260702,1783036000,1783036000+5400,'[{\"id\":1,\"value\":\"12\"},{\"id\":2,\"value\":\"10\"}]',0,1782200000),('c',(SELECT id FROM users LIMIT 1),'jump',20260703,1783122400,1783122400+600,'[{\"id\":1,\"value\":\"30\"},{\"id\":2,\"value\":\"25\"}]',0,1782200000);")
    raw_exec(root, "INSERT INTO habit_changes(id,user_id,habit_id,changed_at,kind,question,question_text,old_value,new_value,deleted_at,updated_at) VALUES('g1',(SELECT id FROM users LIMIT 1),'jump',1783000000,16,2,'Minutes','1:25:0:2','2:0:20:2',0,1783000000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_b = Habits.{}
    check_true("load habit", storage_habits_load(cast(*void)*habits_b) != 0)
    habit := *habits_b.items[0]
    check_true("average goals and the span goal read",
        habit.questions[0].goal.kind == HABIT_GOAL_ABOVE_AVERAGE &&
        habit.span_goal.kind == HABIT_GOAL_BELOW_AVERAGE)
    days: [HABIT_ANSWER_STATS_DAYS]s32
    slot: s32 = 0
    while slot < HABIT_ANSWER_STATS_DAYS {
        days[slot] = 20260701 + slot
        slot += 1
    }
    stats: HabitAnswerStats
    unused storage_habit_answer_stats("jump", *habit.questions[0], days[:], *stats)
    check_int("values before the days start the average", stats.earlier_count, 2)
    check_true("15 against 10 and 20 is as good as the average",
        stats.points[0].benchmark == 1500 && stats.points[0].good == 1)
    check_true("12 against 15 is below the average",
        stats.points[1].benchmark == 1500 && stats.points[1].good == 0)
    check_true("30 against 14.25 is above it",
        stats.points[2].benchmark == 1425 && stats.points[2].good == 1)
    check_true("two of three on target", stats.judged == 3 && stats.good == 2)
    check_int("the next value is judged against all five", cast(s32)stats.benchmark, 1740)
    unused storage_habit_answer_stats("jump", *habit.questions[1], days[:], *stats)
    check_true("a value before the goal changed keeps the old goal",
        stats.points[0].goal.kind == HABIT_GOAL_AT_LEAST && stats.points[0].good == 1)
    check_true("later values have the new goal",
        stats.points[1].goal.kind == HABIT_GOAL_AT_MOST && stats.points[1].good == 1 &&
        stats.points[2].good == 0)
    lengths: HabitAnswerStats
    starts: HabitAnswerStats
    ends: HabitAnswerStats
    unused storage_habit_span_stats(habit, days[:], *lengths, *starts, *ends)
    check_true("spans shorter than their average are good",
        lengths.points[0].benchmark == 6000 && lengths.points[0].good == 1 &&
        lengths.points[1].good == 0 && lengths.points[2].good == 1)
    habit.span_goal = HabitGoal.{.kind = HABIT_GOAL_AT_MOST, .high = 60}
    unused storage_habit_span_stats(habit, days[:], *lengths, *starts, *ends)
    check_true("spans of at most an hour are good, whenever they start",
        lengths.points[0].good == 1 && lengths.points[1].good == 0 &&
        lengths.points[2].good == 1)
    // Saving records what changed, once.
    unused AppCopyText("Jumping jacks", habit.name[:])
    habit.questions[1].goal = HabitGoal.{.kind = HABIT_GOAL_BELOW_AVERAGE}
    habits_save(*habits_b)
    habits_save(*habits_b)
    records: [8]HabitChangeRecord
    count := storage_habit_changes_load("jump", records[:])
    check_int("a save records its changes, an equal save none", count, 4)
    check_true("the goal change is newest first with its question and answer type",
        records[0].change.kind == HABIT_CHANGE_QUESTION_GOAL &&
        records[0].change.question == 2 &&
        AppTextFromCString(*records[0].change.after[0], HABIT_CHANGE_VALUE_SIZE) == "7:0:0:2" &&
        HabitChangeAnswerType(*records[0].change) == HABIT_ANSWER_NUMBER)
    check_true("the span goal change keeps its length in minutes",
        records[1].change.kind == HABIT_CHANGE_SPAN_GOAL &&
        AppTextFromCString(*records[1].change.after[0], HABIT_CHANGE_VALUE_SIZE) == "2:0:60")
    check_true("the rename keeps both names",
        records[2].change.kind == HABIT_CHANGE_NAME &&
        AppTextFromCString(*records[2].change.before[0], HABIT_CHANGE_VALUE_SIZE) == "Jumping" &&
        AppTextFromCString(*records[2].change.after[0], HABIT_CHANGE_VALUE_SIZE) == "Jumping jacks")
    check_true("each change waits to sync",
        db_select_int64_text("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit_change'", 0) == 3)
    habits_free(*habits_b)
    storage_close()
}

// A device keeps its habit list in memory while sync stores newer settings
// and days underneath. Saving that older copy writes only what the person
// changed since it was loaded, so the synced values survive here and on
// the account's other devices, and a habit deleted elsewhere stays deleted.
test_stale_copy_keeps_synced_values :: () {
    root := make_root("habit-stale-copy")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('sit',(SELECT id FROM users LIMIT 1),'Sit ups',1,2,3,0,0,0,0,0,1782200000),('cold',(SELECT id FROM users LIMIT 1),'Cold shower',4,5,6,0,0,0,1,0,1782200000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('sit',20261012,0,0,0,1782200000),('sit',20261013,0,0,0,1782200000);")
    check_true("reopen db", storage_init(root) != 0)
    habits_a = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_a) != 0)
    check_int("both habits load", habits_a.count, 2)
    // Sync stores newer settings, a done day and a deletion.
    exec_db_sql("UPDATE habits SET icon=5,color_r=90,questions='[{\"id\":1,\"type\":\"number\",\"text\":\"How many?\"}]',span=1,span_goal=2,span_high=480,updated_at=1782300000 WHERE id='sit';UPDATE habit_days SET completed=1,count=1,updated_at=1782300000 WHERE habit_id='sit' AND local_date=20261013;UPDATE habits SET deleted_at=1782300000,updated_at=1782300000 WHERE id='cold';DELETE FROM sync_outbox;")
    sit := find_habit(*habits_a, "Sit ups")
    check_true("sit ups in memory", sit != null)
    if sit == null { return }
    // The person renames it and marks another day.
    unused AppCopyText("Sit-ups", sit.name[:])
    day := habit_find_day(sit, 20261012)
    check_true("the other day is in memory", day >= 0)
    if day >= 0 { sit.days[day].completed = 1; sit.days[day].count = 1 }
    habits_save(*habits_a)
    check_int("the rename is saved",
        read_db_count("SELECT COUNT(*) FROM habits WHERE id='sit' AND name='Sit-ups'"), 1)
    check_int("synced settings stay",
        read_db_count("SELECT COUNT(*) FROM habits WHERE id='sit' AND icon=5 AND color_r=90 AND span=1 AND span_goal=2 AND span_high=480 AND json_array_length(questions)=1"), 1)
    check_true("memory takes the synced settings",
        sit.icon == 5 && sit.color.r == 90 && sit.span == 1 && sit.question_count == 1)
    check_int("the synced day stays done",
        read_db_count("SELECT COUNT(*) FROM habit_days WHERE habit_id='sit' AND local_date=20261013 AND completed=1 AND count=1 AND updated_at=1782300000"), 1)
    check_int("the day the person marked is saved",
        read_db_count("SELECT COUNT(*) FROM habit_days WHERE habit_id='sit' AND local_date=20261012 AND completed=1"), 1)
    check_int("only the marked day waits to sync",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='habit_day'"), 1)
    check_int("a habit deleted elsewhere stays deleted",
        read_db_count("SELECT COUNT(*) FROM habits WHERE id='cold' AND deleted_at=1782300000"), 1)
    // A colour change is logged and syncs like every other setting.
    exec_db_sql("DELETE FROM sync_outbox;")
    sit.color = Color.{.r = 200, .g = 10, .b = 20, .a = 255}
    habits_save(*habits_a)
    records: [8]HabitChangeRecord
    count := storage_habit_changes_load("sit", records[:])
    check_true("the colour change is in the habit's log",
        count >= 1 && records[0].change.kind == HABIT_CHANGE_COLOR)
    check_int("the colour and its log entry wait to sync",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type IN ('habit','habit_change')"), 2)
    habits_free(*habits_a)
    storage_close()
}

// A record as it syncs: the payload of one outbox entry, wrapped as the
// changes another device receives.
synced_changes :: (entity_type: string, entity_id: string, array: string,
    output: []u8) -> string {
    json: StorageJsonBuilder
    json.ok = 1
    storage_json_builder_append_text(*json, "{\"changes\":{\"")
    storage_json_builder_append_text(*json, array)
    storage_json_builder_append_text(*json, "\":[")
    storage_append_sync_op_payload(*json, entity_type, entity_id, 0)
    storage_json_builder_append_text(*json, "]}}")
    copied := json.ok != 0 && json.data != null &&
        AppCopyText(AppTextFromCString(json.data, cast(s32)(json.len + 1)), output)
    storage_json_builder_free(*json)
    if !copied { return "" }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// Done days earn coins by their habit's difficulty from its coins_from day
// on, counted in half coins; a difficulty change pays from the day it was
// made, so earlier days keep what they earned. Rewards spend coins, a
// deleted habit's coins stay, and rewards, purchases and the habits' coin
// fields travel to the other devices.
test_habit_wallet :: () {
    root := make_root("habit-wallet")
    check_true("init db", storage_init(root) != 0)
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,sort_order,deleted_at,updated_at,difficulty,coins_from) VALUES('walk',(SELECT id FROM users LIMIT 1),'Walk',1,2,3,0,0,0,1,0,0,1782200000,0,20261001),('push',(SELECT id FROM users LIMIT 1),'Push ups',4,5,6,0,0,1,20,1,0,1782200000,2,20261003);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('walk',20260930,1,1,0,1),('walk',20261001,1,1,0,1),('walk',20261002,0,0,0,1),('walk',20261003,1,1,0,1),('push',20261002,1,20,0,1),('push',20261003,1,20,0,1),('push',20261004,1,5,0,1),('push',20261005,0,0,20,1);")
    check_true("reopen db", storage_init(root) != 0)
    // Walk earns 1 on two days; push, very hard, 3 on its counted day and
    // its day of linked sessions, not before its coins_from day nor short
    // of its target.
    check_int("done days earn by difficulty", cast(s32)storage_habit_wallet_halves(), 16)
    // Walk became hard on 2026-10-03: that day pays 2, the day before 1.
    exec_db_sql("UPDATE habits SET difficulty=1 WHERE id='walk';INSERT INTO habit_changes(id,user_id,habit_id,changed_at,kind,question,question_text,old_value,new_value,deleted_at,updated_at) VALUES('d1',(SELECT id FROM users LIMIT 1),'walk',CAST(strftime('%s','2026-10-03 12:00:00','utc') AS INTEGER),19,0,'','0','1',0,1);")
    check_int("a difficulty change pays from its day", cast(s32)storage_habit_wallet_halves(), 18)
    habits_a = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_a) != 0)
    walk := find_habit(*habits_a, "Walk")
    check_true("coin fields load", walk != null && walk.difficulty == HABIT_DIFFICULTY_HARD &&
        walk.coins_from == 20261001)
    if walk == null { return }
    walk.difficulty = HABIT_DIFFICULTY_VERY_HARD
    habits_save(*habits_a)
    check_int("the editor's change is logged",
        read_db_count("SELECT COUNT(*) FROM habit_changes WHERE habit_id='walk' AND kind=19 AND old_value='1' AND new_value='2'"), 1)
    check_int("days before today keep their coins", cast(s32)storage_habit_wallet_halves(), 18)
    // The shop.
    exec_db_sql("DELETE FROM sync_outbox;")
    movie: [HABIT_REWARD_ID_SIZE]u8
    film := HabitIconNumber("film")
    check_true("add a reward", storage_habit_reward_save("", "Movie night", 5, film, movie[:]) != 0)
    other: [HABIT_REWARD_ID_SIZE]u8
    check_true("add another", storage_habit_reward_save("", "Sauna", 12000, 0, other[:]) != 0)
    rewards: [4]HabitReward
    count := storage_habit_rewards_load(rewards[:])
    check_true("rewards load cheapest first with a price at most 9999",
        count == 2 && rewards[0].price == 5 && rewards[1].price == HABIT_REWARD_PRICE_MAX &&
        AppTextFromCString(*rewards[0].name[0], HABIT_REWARD_NAME_SIZE) == "Movie night")
    check_true("a reward keeps its symbol, and one without shows the gift",
        film > HABIT_ICON_GIFT && rewards[0].icon == film && rewards[1].icon == HABIT_ICON_GIFT)
    check_true("buy the movie night", storage_habit_reward_buy(*rewards[0]) != 0)
    check_int("the price is spent", cast(s32)storage_habit_wallet_halves(), 8)
    renamed: [HABIT_REWARD_ID_SIZE]u8
    check_true("rename a reward", storage_habit_reward_save(TextUntilNul(other[:]),
        "Long sauna", 20, HabitIconNumber("drop"), renamed[:]) != 0 &&
        TextUntilNul(renamed[:]) == TextUntilNul(other[:]))
    check_int("a changed reward takes its new symbol", read_db_count(
        "SELECT icon FROM habit_rewards WHERE name='Long sauna'"), HabitIconNumber("drop"))
    check_true("delete it", storage_habit_reward_delete(TextUntilNul(other[:])) != 0)
    check_int("one reward is left", storage_habit_rewards_load(rewards[:]), 1)
    check_int("rewards and the purchase wait to sync",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type IN ('habit_reward','habit_coin')"), 3)
    // Deleting a habit keeps what its days earned.
    push := find_habit(*habits_a, "Push ups")
    check_true("push ups in memory", push != null)
    position: s32 = 0
    while position < habits_a.count && *habits_a.items[position] != push {
        position += 1
    }
    habits_delete(*habits_a, position)
    habits_save(*habits_a)
    check_int("its coins are kept", read_db_count("SELECT COUNT(*) FROM habit_coins WHERE id='kept:push' AND kind=2 AND coins=6 AND name='Push ups'"), 1)
    check_int("the balance stays", cast(s32)storage_habit_wallet_halves(), 8)
    // The records another device receives.
    buffer: [8192]u8
    bought := read_db_text("SELECT id FROM habit_coins WHERE kind=1")
    coin_id: [64]u8
    unused AppCopyText(bought, coin_id[:])
    reward_json := synced_changes("habit_reward", TextUntilNul(movie[:]), "habit_rewards", buffer[:])
    check_true("a reward's record has its name, price and symbol",
        contains(reward_json, "\"name\":\"Movie night\"") && contains(reward_json, "\"price\":5") &&
        contains(reward_json, "\"icon\":39"))
    exec_db_sql("DELETE FROM habit_rewards;")
    check_true("apply the reward", storage_apply_sync_habit_rewards_json(reward_json) != 0)
    check_int("the reward arrives", storage_habit_rewards_load(rewards[:]), 1)
    check_int("with its symbol", rewards[0].icon, film)
    // A copy from a version without symbols keeps the symbol here.
    older: [512]u8
    unused AppCopyText("{\"changes\":{\"habit_rewards\":[{\"id\":\"", older[:])
    unused AppAppendText(TextUntilNul(movie[:]), older[:])
    unused AppAppendText("\",\"name\":\"Movie night\",\"price\":7,\"deleted_at\":0,\"updated_at\":\"2030-01-01T00:00:00Z\"}]}}", older[:])
    check_true("apply an older copy", storage_apply_sync_habit_rewards_json(TextUntilNul(older[:])) != 0)
    check_true("its price changes and its symbol stays",
        storage_habit_rewards_load(rewards[:]) == 1 && rewards[0].price == 7 && rewards[0].icon == film)
    coin_json := synced_changes("habit_coin", TextUntilNul(coin_id[:]), "habit_coins", buffer[:])
    exec_db_sql("DELETE FROM habit_coins WHERE kind=1;")
    check_int("without the purchase", cast(s32)storage_habit_wallet_halves(), 18)
    check_true("apply the purchase", storage_apply_sync_habit_coins_json(coin_json) != 0)
    check_int("the purchase arrives", cast(s32)storage_habit_wallet_halves(), 8)
    habit_json := synced_changes("habit", "walk", "habits", buffer[:])
    check_true("a habit's record has its coin fields",
        contains(habit_json, "\"difficulty\":2") && contains(habit_json, "\"coins_from\":20261001"))
    exec_db_sql("UPDATE habits SET coins_from=20261010,difficulty=0 WHERE id='walk';")
    check_true("apply the habit", storage_apply_sync_habits_json(habit_json) != 0)
    check_int("the earliest first coin day and the difficulty arrive",
        read_db_count("SELECT COUNT(*) FROM habits WHERE id='walk' AND coins_from=20261001 AND difficulty=2"), 1)
    // An easy habit earns half a coin on each done day.
    exec_db_sql("INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,sort_order,deleted_at,updated_at,difficulty,coins_from) VALUES('read',(SELECT id FROM users LIMIT 1),'Read',7,8,9,0,0,0,1,2,0,1782200000,3,20261001);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('read',20261001,1,1,0,1),('read',20261002,1,1,0,1),('read',20261003,1,1,0,1);")
    check_int("easy days earn half coins", cast(s32)storage_habit_wallet_halves(), 11)
    check_true("each level's half coins",
        HabitDifficultyHalfCoins(HABIT_DIFFICULTY_EASY) == 1 &&
        HabitDifficultyHalfCoins(HABIT_DIFFICULTY_MEDIUM) == 2 &&
        HabitDifficultyHalfCoins(HABIT_DIFFICULTY_HARD) == 4 &&
        HabitDifficultyHalfCoins(HABIT_DIFFICULTY_VERY_HARD) == 6)
    check_true("the editor offers easy first",
        HabitDifficultyAt(0) == HABIT_DIFFICULTY_EASY &&
        HabitDifficultyIndex(HABIT_DIFFICULTY_MEDIUM) == 1 &&
        HabitDifficultyAt(HabitDifficultyIndex(HABIT_DIFFICULTY_VERY_HARD)) ==
        HABIT_DIFFICULTY_VERY_HARD)
    habits_free(*habits_a)
    storage_close()
}

#program_export
Check :: () -> s32 {
    guard := support_begin("/tmp/inbe-storage-habits-zi-test/")
    if guard != 0 { return guard }
    test_habit_name_merge_import()
    test_import_conflict_prefers_data()
    test_delete_all_resets()
    test_empty_initialized_seeds_meditation()
    test_defaults_wait_for_language()
    test_default_meditation_not_repaired()
    test_import_modes()
    test_session_metadata()
    test_profile_week_stats()
    test_linked_counts_materialize()
    test_existing_sessions_materialize()
    test_meditation_logs_feed_profile_stats()
    test_uuid_habit_ids_load_days()
    test_habit_questions_and_entries()
    test_entry_statistics()
    test_average_goals_and_changes()
    test_stale_copy_keeps_synced_values()
    test_habit_wallet()
    return failures
}
