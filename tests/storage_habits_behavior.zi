using StorageImportMode;

// Habit sets are large, so the tests keep theirs in globals.
habits_a: Habits;
habits_b: Habits;

ascii_lower :: (byte: u8) -> u8 {
    if byte >= cast(u8)65 && byte <= cast(u8)90 { return byte + cast(u8)32 }
    return byte
}

equal_ignoring_case :: (left: string, right: string) -> bool {
    if left.count != right.count { return false }
    index: s64 = 0
    while index < left.count {
        if ascii_lower(left[index]) != ascii_lower(right[index]) { return false }
        index += 1
    }
    return true
}

find_habit :: (habits: *Habits, name: string) -> *Habit {
    index: s32 = 0
    while index < habits.count {
        if equal_ignoring_case(TextFromCString(*habits.items[index].name[0]), name) {
            return *habits.items[index]
        }
        index += 1
    }
    return null
}

has_day :: (habit: *Habit, day: s32) -> bool {
    return habit != null && habit_completed_day(habit, day) != 0
}

// A habit's count on a day, or -1.
day_count_of :: (habit: *Habit, day: s32) -> s32 {
    index := habit_find_day(habit, day)
    if index < 0 { return -1 }
    return habit.days[index].count
}

Blue :: () -> Color {
    return Color.{126, 183, 230, 255}
}

Orange :: () -> Color {
    return Color.{224, 124, 104, 255}
}

Green :: () -> Color {
    return Color.{99, 196, 165, 255}
}

Purple :: () -> Color {
    return Color.{180, 132, 220, 255}
}

save_source_session :: (root: string) -> bool {
    rounds: [3]s32 = .[45, 60, 75]
    if storage_init(root) == 0 { return false }
    ok: bool = storage_save_session(*rounds[0], 3, null, 0) != 0
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day(*habits_a, 0, 20260613, 1)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_close()
    return ok
}

test_habit_name_merge_import :: () {
    source := make_root("habit-name-source")
    dest := make_root("habit-name-dest")
    archive: TextBuffer
    append(*archive, source)
    append(*archive, "/export.zip")

    check_true("init habit merge source", storage_init(source) != 0)
    habits_a = Habits.{}
    check_int("add imported meditation", habits_add_custom(*habits_a, "meditation", Orange(), 0, 0), 0)
    habit_set_day(*habits_a, 0, 20260613, 1)
    habits_save(*habits_a)
    check_int("add imported push ups", habits_add_custom(*habits_a, "Push ups", Purple(), 0, 0), 1)
    habit_set_day(*habits_a, 1, 20260614, 1)
    habits_save(*habits_a)
    check_int("add imported cold shower", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0), 2)
    habit_set_day(*habits_a, 2, 20260615, 1)
    habits_save(*habits_a)
    check_true("habit merge export", storage_export_zip(TextFromCString(*archive.bytes[0])) != 0)
    habits_free(*habits_a)
    storage_close()

    check_true("init habit merge dest", storage_init(dest) != 0)
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day(*habits_a, 0, 20260612, 1)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("habit merge import", storage_import_zip(TextFromCString(*archive.bytes[0])) != 0)
    habits_b = Habits.{}
    check_true("habit merge load", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("habit merge count", habits_b.count, 4)
    meditation := find_habit(*habits_b, "Meditation")
    check_true("habit merge meditation exists", meditation != null)
    if meditation != null {
        check_true("habit merge preserves local case",
            TextFromCString(*meditation.name[0]) == "Meditation")
    }
    check_true("habit merge keeps local day", has_day(meditation, 20260612))
    check_true("habit merge imports day", has_day(meditation, 20260613))
    check_true("habit merge push ups day", has_day(find_habit(*habits_b, "Push ups"), 20260614))
    check_true("habit merge cold shower day", has_day(find_habit(*habits_b, "Cold Shower"), 20260615))
    habits_free(*habits_b)
    storage_close()
}

test_import_conflict_prefers_data :: () {
    source := make_root("conflict-source")
    dest := make_root("conflict-dest")
    archive: TextBuffer
    append(*archive, source)
    append(*archive, "/conflict-export.zip")

    check_true("init conflict source", storage_init(source) != 0)
    habits_a = Habits.{}
    check_int("add conflict source habit", habits_add_custom(*habits_a, "Meditation", Orange(), 0, 0), 0)
    storage_set_setting_text("language", "")
    habits_free(*habits_a)
    storage_close()
    raw_exec(source, "INSERT OR REPLACE INTO habit_days(habit_id,local_date,completed,updated_at) VALUES('habit-1',20260618,0,0)")
    check_true("reopen conflict source", storage_init(source) != 0)
    check_true("conflict source export", storage_export_zip(TextFromCString(*archive.bytes[0])) != 0)
    storage_close()

    check_true("init conflict dest", storage_init(dest) != 0)
    habits_a = Habits.{}
    check_int("add conflict dest habit", habits_add_custom(*habits_a, "Meditation", Blue(), 0, 0), 0)
    habit_set_day(*habits_a, 0, 20260618, 1)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_set_setting_text("language", "en")
    check_true("conflict import", storage_import_zip_ex(TextFromCString(*archive.bytes[0]),
        cast(StorageImportMode)1) != 0)
    habits_b = Habits.{}
    check_true("conflict habits load", storage_habits_load(cast(*void)*habits_b) != 0)
    check_true("conflict keeps completed day", has_day(find_habit(*habits_b, "Meditation"), 20260618))
    check_true("conflict keeps non-empty setting", storage_get_setting_text("language") == "en")
    habits_free(*habits_b)
    storage_close()
}

test_delete_all_resets :: () {
    root := make_root("delete-all")
    check_true("init delete all db", storage_init(root) != 0)
    habits_a = Habits.{}
    check_int("add delete all habit", habits_add_custom(*habits_a, "Work out", Green(), 0, 0), 0)
    habit_set_day(*habits_a, 0, 20260618, 1)
    habits_save(*habits_a)
    check_int("habit count before", storage_habit_count(), 1)
    check_true("sees habit-only data", storage_has_any() != 0)
    deleted := storage_delete_all_sessions()
    check_true("delete removed habit data", deleted >= cast(s64)2)
    check_int("habit count after", storage_habit_count(), 0)
    check_true("hides active data", storage_has_any() == 0)
    habits_add_default_set(*habits_a)
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load default habit after delete all", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("default habit count after delete all", habits_b.count, 2)
    check_true("default meditation", find_habit(*habits_b, "Meditation") != null)
    check_true("default yoga", find_habit(*habits_b, "Yoga") != null)
    check_true("old workout day removed", !has_day(find_habit(*habits_b, "Meditation"), 20260618))
    habits_free(*habits_b)
    storage_close()
}

test_empty_initialized_seeds_meditation :: () {
    root := make_root("empty-initialized")
    check_true("init db", storage_init(root) != 0)
    storage_mark_habits_initialized()
    storage_close()
    raw_exec(root, "DELETE FROM habit_days; DELETE FROM habits;")
    check_true("reopen db", storage_init(root) != 0)
    habits_a = Habits.{}
    habits_init(*habits_a)
    check_int("startup seeds default habits", habits_a.count, 2)
    meditation := find_habit(*habits_a, "Meditation")
    yoga := find_habit(*habits_a, "Yoga")
    check_true("seeds meditation", meditation != null)
    check_true("seeds yoga", yoga != null)
    if meditation != null {
        check_int("meditation linked mode", meditation.sync_mode, 1)
        check_int("meditation linked activities", meditation.sync_activity, 1 | 2 | 8)
    }
    if yoga != null {
        check_int("yoga linked mode", yoga.sync_mode, 1)
        check_int("yoga linked activities", yoga.sync_activity, 4)
    }
    habits_free(*habits_a)
    habits_b = Habits.{}
    check_true("load seeded defaults", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("seeded defaults persisted", habits_b.count, 2)
    persisted := find_habit(*habits_b, "Meditation")
    check_true("persisted meditation", persisted != null)
    if persisted != null {
        check_int("persisted meditation linked activities", persisted.sync_activity, 1 | 2 | 8)
    }
    habits_free(*habits_b)
    storage_close()
}

