#import, file "../src/cells/package_release.zi";
c :: #system_library "c";
PackageFixture :: (name: string) -> string #foreign c;

#program_export
CheckPackageReleases :: () -> s32 {
    public := PackageFixture("public")
    names: [6]string = .["inbe", "lists", "habits", "practices", "diary", "lumi"]
    for index: cast(s32)0..cast(s32)5 {
        value := PackageParseRelease(PackageFixture(names[index]), index, public)
        if !value.valid {
            return index + 1
        }
    }
    rejected: [9]string = .["wrong-app", "wrong-api", "bad-signature", "fraction",
    "negative", "runtime", "bad-version", "extra-dependency", "old-api"]
    for index: cast(s32)0..cast(s32)8 {
        if PackageParseRelease(PackageFixture(rejected[index]), 2, public).valid {
            return index + 10
        }
    }
    habits := PackageParseRelease(PackageFixture("habits"), 2, public)
    if !PackageVerifyBytes(PackageFixture("habits-bytes"), habits) {
        return 20
    }
    if PackageVerifyBytes(PackageFixture("corrupt-bytes"), habits) {
        return 21
    }
    root := PackageParseRelease(PackageFixture("inbe"), 0, public)
    if !PackageVerifyBytes(PackageFixture("root-bytes"), root) {
        return 22
    }
    wrong := PackageParseRelease(PackageFixture("wrong-nested"), 0, public)
    if !wrong.valid || PackageVerifyBytes(PackageFixture("root-bytes"), wrong) {
        return 23
    }
    return 0
}
