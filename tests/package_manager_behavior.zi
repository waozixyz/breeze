#import, file "../src/apps/package_manager.zi";
#import, file "../src/apps/versions.zi";
#import, file "../src/apps/package_files.zi";
#import "std/file_linux"
c :: #system_library "c";
RunPackageManagerFixture :: () -> s32 #foreign c;
#program_export
CheckPackageManager :: () -> s32 {
    return RunPackageManagerFixture()
}

#program_export
FixtureHabitsSequence :: () -> s32 {
    return PackageBundledSequence(2)
}

#program_export
FixtureRemovePayload :: (digest: string) -> bool {
    path := PackagePayloadPath(4, digest)
    defer {
        PackageFree(path)
    }
    return RemoveFile(path)
}
