#import "byte_text_linux"
#import "c_string"

c :: #system_library "c";
TestGetEnvironment :: (name: *u8) -> *u8 #foreign c "getenv";

#program_export "data_data_root"
TestDataRoot :: () -> string {
    name: [14]u8
    if !CopyCString("APP_DATA_ROOT", name[:]) {
        return ""
    }
    return TextFromCString(TestGetEnvironment(*name[0]))
}
