#import, file "../src/cells/lumi_chart.zi";
#import, file "../src/cells/lumi_types.zi";
#import, file "../src/habits/habit_date.zi";

#scope_export
Answer :: () -> s32 {
    chart := LumiChartRead("{\"metric\":2,\"points\":[{\"date\":20260228,\"value\":0},{\"date\":20260301,\"value\":125}]}")
    if !chart.valid || chart.count != 2 || chart.metric != LUMI_PROGRESS_RETENTION ||
    chart.maximum != 125 || chart.total != 125 || chart.values[0] != 0 {
        return 1
    }
    invalid: [8]string = .["{}", "{\"metric\":0,\"points\":[]}",
    "{\"metric\":4,\"points\":[{\"date\":20261007,\"value\":1}]}",
    "{\"metric\":0,\"points\":[{\"date\":20260230,\"value\":1}]}",
    "{\"metric\":0,\"points\":[{\"date\":20261007,\"value\":-1}]}",
    "{\"metric\":0,\"points\":[{\"date\":20261007,\"value\":1.5}]}",
    "{\"metric\":0,\"points\":[{\"date\":20261007,\"value\":1},{\"date\":20261007,\"value\":2}]}",
    "{\"metric\":0,\"points\":[{\"date\":20261007,\"value\":1}]}garbage"]
    for document: invalid {
        if LumiChartRead(document).valid {
            return 2
        }
    }
    if HabitDayIndexAgo(2026, 3, 1, 1) != 20260228 ||
    HabitDayIndexAgo(2024, 3, 1, 1) != 20240229 || HabitDayIndexAgo(2026, 1, 1, 1) != 20251231 {
        return 3
    }
    return 42
}
