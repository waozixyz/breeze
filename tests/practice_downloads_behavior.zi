#import, file "../src/practices/practice_downloads.zi";
#import, file "../src/app/assets.zi";
#import, file "../src/app/locale.zi";
#import, file "../src/storage/temporary_data.zi";
#import, file "../src/app/text_buffers.zi";
c :: #system_library "c";
FixtureCatalog :: () -> string #foreign c;
FixtureAsset :: (path: string) -> AssetView #foreign c;
FixtureMode :: (mode: s32) #foreign c;
FixtureCatalogMode :: (mode: s32) #foreign c;
FixtureShipped :: (value: s32) #foreign c;
FixtureGrantedStarts :: () -> s32 #foreign c;
FixtureStarts :: () -> s32 #foreign c;
FixtureTaiChiSaved :: () -> bool #foreign c;

FixtureProvider :: (path: string) -> AssetView {
    return FixtureAsset(path)
}

// 1 grants Tai Chi's packs, 0 keeps the grant pending, -1 refuses it.
fixture_grant_mode: s32 = 1;

FixtureGrant :: (product: string, output: []u8) -> s32 {
    if product != "inbe.practice.taichi" || fixture_grant_mode < 0 {
        return -1
    }
    if fixture_grant_mode == 0 {
        return 0
    }
    return ifx AppCopyText("fixture-grant", output) then 1 else -1
}

fixture_owned: bool = true;

FixtureOwned :: (product: string) -> bool {
    return product == "inbe.practice.taichi" && fixture_owned
}

#program_export
CheckPracticeDownloads :: () -> s32 {
    if PracticeCatalogValid("{\"schema\":1,\"packs\":[]}") ||
    PracticeCatalogValid("{\"schema\":2,\"packs\":[]}") {
        return 15
    }
    AssetBindProvider(FixtureProvider)
    practice_grant = FixtureGrant
    practice_owned = FixtureOwned
    PracticeDownloadsPump(0, false, true)
    if practice_pack_count != 7 || PracticeContentReady(0) {
        return 1
    }
    PracticeContentRequest(0, false)
    PracticeDownloadsPump(0, false, true)
    // Repeated requests while transferring must not enqueue the pack twice.
    PracticeContentRequest(0, false)
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) || PracticeContentStatus(0) != 2 {
        return 2
    }
    PracticeDownloadsPump(0, false, true)
    if FixtureStarts() != 1 {
        return 16
    }
    if !PracticeDownloadsAsset("assets/practices/whm/1.png").found {
        return 3
    }
    if PracticeDownloadsAsset("locales/en.txt").found ||
    PracticeDownloadsAsset("assets/practices/whm/../taichi/pack.json").found {
        return 4
    }

    // An invalid replacement cannot discard working, verified content.
    FixtureCatalogMode(1)
    AssetNotifyChanged()
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) || !PracticeDownloadsAsset("assets/practices/whm/1.png").found {
        return 18
    }
    FixtureCatalogMode(0)
    AssetNotifyChanged()
    PracticeDownloadsPump(0, false, true)

    // Moving away unmounts memory but going back uses the verified disk cache.
    before := FixtureStarts()
    PracticeDownloadsPump(4, false, true)
    PracticeContentRequest(0, false)
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before {
        return 5
    }

    // A corrupt download never becomes ready; a manual retry repairs it.
    PracticeDownloadsPump(4, false, true)
    FixtureMode(1)
    PracticeContentRequest(4, false)
    PracticeDownloadsPump(4, false, true)
    PracticeDownloadsPump(4, false, true)
    if PracticeContentReady(4) || PracticeContentStatus(4) != 3 {
        return 6
    }
    FixtureMode(0)
    PracticeContentRequest(4, false)
    PracticeDownloadsPump(4, false, true)
    PracticeDownloadsPump(4, false, true)
    if !PracticeContentReady(4) {
        return 7
    }

    base_bundle := practice_packs[PracticePackFind(4, "")].bundle
    PracticeDownloadsPump(4, true, true)
    PracticeDownloadsPump(4, true, true)
    if PracticeVoiceStatus(4) != 2 ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 8
    }
    before = FixtureStarts()
    active_locale_index = 1
    // A running practice retains its borrowed course and audio bytes.
    PracticeDownloadsPump(4, true, false)
    if FixtureStarts() != before {
        return 9
    }
    PracticeDownloadsPump(4, true, true)
    PracticeDownloadsPump(4, true, true)
    if FixtureStarts() != before + 1 || !PracticeContentReady(4) || PracticeVoiceStatus(4) != 2 {
        return 10
    }
    if PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/es/test.ogg").found {
        return 11
    }
    before = FixtureStarts()
    active_locale_index = 0
    PracticeDownloadsPump(4, true, true)
    if FixtureStarts() != before || PracticeVoiceStatus(4) != 2 {
        return 12
    }
    if practice_packs[PracticePackFind(4, "")].bundle != base_bundle {
        return 17
    }
    PracticeContentRemove(4)
    if PracticeContentReady(4) || PracticeVoiceStatus(4) != 0 {
        return 13
    }
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) {
        return 14
    }
    // The manager can queue other practices without mounting them or changing
    // the practice currently shown. Their verified files work offline later.
    before = FixtureStarts()
    PracticeContentRequest(1, false)
    PracticeContentRequest(4, false)
    for turn: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(0, false, true)
    }
    if FixtureStarts() != before + 2 || PracticeContentStatus(1) != 2 ||
    PracticeContentStatus(4) != 2 || PracticeContentReady(1) || PracticeContentReady(4) {
        return 21
    }
    PracticeDownloadsPump(1, false, true)
    if !PracticeContentReady(1) || FixtureStarts() != before + 2 {
        return 22
    }
    PracticeDownloadsPump(0, false, true)
    PracticeContentRemove(4)
    PracticeDownloadsClose()
    PracticeDownloadsPump(0, false, true)
    for turn: cast(s32)0..cast(s32)6 {
        PracticeContentReviewNext()
    }
    if PracticeContentStatus(1) != 2 || PracticeContentReady(1) ||
    !PracticePackReviewed(1, "") || !PracticeContentReady(0) {
        return 23
    }
    // Mini sessions reuse public caches, but missing packs stay transient.
    DataSetTemporary(true)
    PracticeDownloadsPump(4, false, true)
    PracticeContentRequest(4, false)
    PracticeDownloadsPump(4, false, true)
    PracticeDownloadsPump(4, false, true)
    if !PracticeContentReady(4) || FixtureTaiChiSaved() {
        return 19
    }
    PracticeDownloadsPump(0, false, true)
    before = FixtureStarts()
    PracticeContentRemove(0)
    DataSetTemporary(false)
    PracticeDownloadsPump(4, false, true)
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before || FixtureTaiChiSaved() {
        return 20
    }
    // Wim Hof ships with the app: installed without a download, removed for
    // good, and back again without a download. Others need a download.
    PracticeContentRemove(0)
    FixtureShipped(1)
    PracticeDownloadsClose()
    before = FixtureStarts()
    if !PracticeInstalled(0) || PracticeInstalled(2) {
        return 24
    }
    PracticeDownloadsPump(0, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before {
        return 25
    }
    PracticeContentRemove(0)
    PracticeDownloadsClose()
    PracticeDownloadsPump(0, false, true)
    if PracticeInstalled(0) || PracticeContentReady(0) {
        return 26
    }
    PracticeContentRequest(0, false)
    PracticeDownloadsPump(0, false, true)
    if !PracticeInstalled(0) || !PracticeContentReady(0) || FixtureStarts() != before {
        return 27
    }
    PracticeDownloadsClose()
    if !PracticeInstalled(0) {
        return 28
    }
    // Paid packs download only with the host's grant in their path; they
    // wait while it is requested and fail when it is refused. Google Play,
    // without Dew, hides them.
    if PracticeProduct(4) != "inbe.practice.taichi" || PracticeProduct(0).count != 0 ||
    FixtureGrantedStarts() < 1 {
        return 29
    }
    PracticeContentRemove(4)
    fixture_grant_mode = 0
    before = FixtureStarts()
    PracticeContentRequest(4, false)
    PracticeDownloadsPump(4, false, true)
    if FixtureStarts() != before || PracticeContentStatus(4) != 1 {
        return 30
    }
    fixture_grant_mode = 1
    PracticeDownloadsPump(4, false, true)
    PracticeDownloadsPump(4, false, true)
    if FixtureStarts() != before + 1 || !PracticeContentReady(4) {
        return 31
    }
    // A paid pack on this device counts as installed only for an account
    // that owns it, such as a pack another account left behind.
    fixture_owned = false
    if PracticeInstalled(4) || !PracticeInstalled(0) {
        return 34
    }
    fixture_owned = true
    if !PracticeInstalled(4) {
        return 35
    }
    PracticeContentRemove(4)
    fixture_grant_mode = -1
    PracticeContentRequest(4, false)
    PracticeDownloadsPump(4, false, true)
    if FixtureStarts() != before + 1 || PracticeContentStatus(4) != 3 {
        return 32
    }
    practice_paid_allowed = false
    if !PracticeHidden(4) || PracticeInstalled(4) || PracticeHidden(0) || !PracticeInstalled(0) {
        return 33
    }
    practice_paid_allowed = true
    PracticeDownloadsClose()
    return 0
}
