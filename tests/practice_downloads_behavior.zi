#import, file "../src/practices/practice_downloads.zi";
#import, file "../src/app/assets.zi";
#import, file "../src/app/locale.zi";
#import, file "../src/storage/temporary_data.zi";
#import, file "../src/app/text_buffers.zi";
c :: #system_library "c";
FixtureCatalog :: () -> string #foreign c;
FixtureAsset :: (path: string) -> AssetView #foreign c;
FixtureMode :: (mode: s32) #foreign c;
FixtureCatalogMode :: (mode: s32) #foreign c;
FixtureShipped :: (value: s32) #foreign c;
FixtureGrantedStarts :: () -> s32 #foreign c;
FixtureStarts :: () -> s32 #foreign c;
FixtureTaiChiSaved :: () -> bool #foreign c;

FixtureProvider :: (path: string) -> AssetView {
    return FixtureAsset(path)
}

// 1 grants Tai Chi's packs, 0 keeps the grant pending, -1 refuses it.
fixture_grant_mode: s32 = 1;

FixtureGrant :: (product: string, output: []u8) -> s32 {
    if product != "inbe.practice.taichi" || fixture_grant_mode < 0 {
        return -1
    }
    if fixture_grant_mode == 0 {
        return 0
    }
    return ifx AppCopyText("fixture-grant", output) then 1 else -1
}

fixture_owned: bool = true;

FixtureOwned :: (product: string) -> bool {
    return product == "inbe.practice.taichi" && fixture_owned
}

#program_export
CheckPracticeDownloads :: () -> s32 {
    if PracticeCatalogValid("{\"schema\":1,\"packs\":[]}") ||
    PracticeCatalogValid("{\"schema\":2,\"packs\":[]}") {
        return 15
    }
    AssetBindProvider(FixtureProvider)
    practice_grant = FixtureGrant
    practice_owned = FixtureOwned
    PracticeDownloadsPump(0, false, false, true)
    if practice_pack_count != 9 || PracticeContentReady(0) {
        return 1
    }
    PracticeContentRequest(0)
    PracticeDownloadsPump(0, false, false, true)
    // Repeated requests while transferring must not enqueue the pack twice.
    PracticeContentRequest(0)
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) || PracticeContentStatus(0) != 2 {
        return 2
    }
    PracticeDownloadsPump(0, false, false, true)
    if FixtureStarts() != 1 {
        return 16
    }
    if !PracticeDownloadsAsset("assets/practices/whm/1.png").found {
        return 3
    }
    if PracticeDownloadsAsset("locales/en.txt").found ||
    PracticeDownloadsAsset("assets/practices/whm/../taichi/pack.json").found {
        return 4
    }

    // An invalid replacement cannot discard working, verified content.
    FixtureCatalogMode(1)
    AssetNotifyChanged()
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) || !PracticeDownloadsAsset("assets/practices/whm/1.png").found {
        return 18
    }
    FixtureCatalogMode(0)
    AssetNotifyChanged()
    PracticeDownloadsPump(0, false, false, true)

    // Moving away unmounts memory but going back uses the verified disk cache.
    before := FixtureStarts()
    PracticeDownloadsPump(4, false, false, true)
    PracticeContentRequest(0)
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before {
        return 5
    }

    // A corrupt download never becomes ready. It is tried again by itself,
    // with a fresh grant, and reported as failed only after the last try.
    PracticeDownloadsPump(4, false, false, true)
    FixtureMode(1)
    corrupt_before := FixtureStarts()
    PracticeContentRequest(4)
    for step: cast(s32)0..cast(s32)11 {
        PracticeDownloadsPump(4, false, false, true)
    }
    if PracticeContentReady(4) || PracticeContentStatus(4) != 3 ||
    FixtureStarts() != corrupt_before + 1 + PracticeDownloadRetries {
        return 6
    }
    // One bad transfer recovers on its own when the next try succeeds.
    PracticeContentRequest(4)
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(4, false, false, true)
    FixtureMode(0)
    for step: cast(s32)0..cast(s32)5 {
        PracticeDownloadsPump(4, false, false, true)
    }
    if !PracticeContentReady(4) || PracticeContentStatus(4) != 2 {
        return 38
    }
    PracticeContentRemove(4)
    FixtureMode(0)
    PracticeContentRequest(4)
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(4, false, false, true)
    if !PracticeContentReady(4) {
        return 7
    }

    base_bundle := practice_packs[PracticePackFind(4, "")].bundle
    english := PracticeNarrationPack(4, "en", "")
    spanish := PracticeNarrationPack(4, "es", "")
    guide := PracticeNarrationPack(PracticeGuide, "en", "")
    // With narration off, nothing downloads it.
    before = FixtureStarts()
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(4, false, false, true)
    if FixtureStarts() != before || english < 0 || spanish < 0 || guide < 0 ||
    PracticeNarrationState(english) != 0 || PracticeNarrationState(guide) != 0 {
        return 8
    }
    // Back cancels only the old language's pending audio, leaving other
    // languages and completed practice content intact.
    PracticeNarrationDownload(english)
    PracticeNarrationDownload(spanish)
    PracticeNarrationCancelLanguage("en")
    if PracticeNarrationState(english) != 0 || PracticeNarrationState(spanish) != 1 ||
    practice_packs[english].requested || !practice_packs[spanish].requested ||
    practice_packs[PracticePackFind(4, "")].bundle != base_bundle {
        return 100
    }
    PracticeNarrationCancelLanguage("es")
    PracticeNarrationDownload(english)
    PracticeDownloadsPump(4, false, false, true)
    if practice_transfer_index != english {
        return 101
    }
    PracticeNarrationCancelLanguage("es")
    if practice_transfer_index != english {
        return 102
    }
    PracticeNarrationCancelLanguage("en")
    PracticeDownloadsPump(4, false, false, true)
    if practice_transfer_index != -1 || PracticeNarrationState(english) != 0 ||
    PracticeNarrationState(spanish) != 0 {
        return 103
    }
    before = FixtureStarts()
    // Practice voice alone does not request or mount guide voice.
    for step: cast(s32)0..cast(s32)4 {
        PracticeDownloadsPump(4, true, false, true)
    }
    if FixtureStarts() != before + 1 || PracticeNarrationState(english) != 2 ||
    PracticeNarrationState(guide) != 0 {
        return 91
    }
    // Guide voice is independent: it can download and play with practice voice off.
    for step: cast(s32)0..cast(s32)4 {
        PracticeDownloadsPump(4, false, true, true)
    }
    if FixtureStarts() != before + 2 || PracticeNarrationState(guide) != 2 ||
    !PracticeDownloadsAsset("assets/practices/guide/voice/en/test.ogg").found ||
    PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 92
    }
    // Both choices mount only their selected-language narration.
    for step: cast(s32)0..cast(s32)7 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before + 2 || PracticeNarrationState(english) != 2 ||
    PracticeNarrationState(spanish) != 0 || PracticeNarrationState(guide) != 2 ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found ||
    !PracticeDownloadsAsset("assets/practices/guide/voice/en/test.ogg").found {
        return 42
    }
    PracticeNarrationCancelLanguage("en")
    if PracticeNarrationState(english) != 2 || PracticeNarrationState(guide) != 2 ||
    !PracticeDownloadsAsset("assets/practices/guide/voice/en/test.ogg").found {
        return 104
    }
    before = FixtureStarts()
    active_locale_index = 1
    // A running practice retains its borrowed course and audio bytes.
    PracticeDownloadsPump(4, true, true, false)
    if FixtureStarts() != before {
        return 9
    }
    // In another app language the practice downloads and speaks that one;
    // Lumi's guide stays silent when its selected language is unavailable.
    for step: cast(s32)0..cast(s32)5 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before + 1 || PracticeNarrationState(spanish) != 2 ||
    PracticeNarrationLanguage(4, "") != "es" || PracticeNarrationLanguage(PracticeGuide, "").count != 0 ||
    PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/es/test.ogg").found {
        return 10
    }
    // Back in English, the copy on this device speaks without a download.
    before = FixtureStarts()
    active_locale_index = 0
    PracticeDownloadsPump(4, true, true, true)
    PracticeDownloadsPump(4, true, true, true)
    if FixtureStarts() != before || PracticeNarrationLanguage(4, "") != "en" ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 11
    }
    // A language chosen in Customize speaks instead of the app's.
    PracticeNarrationPrefer(4, "es")
    PracticeDownloadsPump(4, true, true, true)
    PracticeDownloadsPump(4, true, true, true)
    if FixtureStarts() != before || PracticeNarrationLanguage(4, "") != "es" ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/es/test.ogg").found {
        return 12
    }
    PracticeNarrationPrefer(4, "")
    // Removing a language frees only that one and keeps it from coming back
    // by itself; another downloaded language speaks.
    PracticeNarrationDecline(english)
    for step: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before || PracticeNarrationState(english) != 0 ||
    PracticeNarrationState(spanish) != 2 || PracticeNarrationLanguage(4, "") != "es" ||
    PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 43
    }
    if practice_packs[PracticePackFind(4, "")].bundle != base_bundle {
        return 17
    }
    // It stays removed when the catalog loads again, until it is downloaded.
    PracticeDownloadsClose()
    for step: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before || PracticeNarrationState(english) != 0 {
        return 49
    }
    PracticeNarrationDownload(english)
    for step: cast(s32)0..cast(s32)5 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before + 1 || PracticeNarrationState(english) != 2 ||
    PracticeNarrationLanguage(4, "") != "en" {
        return 50
    }
    // The male voice has its own packs, which follow the app's language too,
    // while the default voice's languages stay on this device.
    male := PracticeNarrationPack(4, "en", "male")
    before = FixtureStarts()
    PracticeVoiceSelect(4, "male")
    for step: cast(s32)0..cast(s32)5 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if FixtureStarts() != before + 1 || PracticeNarrationState(male) != 2 ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice-male/en/test.ogg").found ||
    PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 44
    }
    before = FixtureStarts()
    PracticeVoiceSelect(4, "")
    PracticeDownloadsPump(4, true, true, true)
    PracticeDownloadsPump(4, true, true, true)
    if FixtureStarts() != before || PracticeNarrationState(spanish) != 2 ||
    !PracticeDownloadsAsset("assets/practices/taichi/voice/en/test.ogg").found {
        return 37
    }
    // A download in progress can be stopped, and does not start again by itself.
    PracticeNarrationDecline(english)
    PracticeNarrationDownload(english)
    PracticeDownloadsPump(4, true, true, true)
    PracticeNarrationDecline(english)
    for step: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if PracticeNarrationState(english) != 0 || FixtureStarts() != before + 1 {
        return 45
    }
    // Lumi's guide narration is mounted only while narration is on, and once
    // removed it stays off this device.
    if !PracticeDownloadsAsset("assets/practices/guide/voice/en/test.ogg").found {
        return 46
    }
    PracticeDownloadsPump(4, false, false, true)
    if PracticeDownloadsAsset("assets/practices/guide/voice/en/test.ogg").found {
        return 47
    }
    PracticeNarrationDecline(guide)
    for step: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(4, true, true, true)
    }
    if PracticeNarrationState(guide) != 0 || PracticeNarrationLanguage(PracticeGuide, "").count != 0 ||
    FixtureStarts() != before + 1 {
        return 48
    }
    PracticeContentRemove(4)
    if PracticeContentReady(4) || PracticeNarrationState(spanish) != 0 || PracticeNarrationState(male) != 0 {
        return 13
    }
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) {
        return 14
    }
    // The manager can queue other practices without mounting them or changing
    // the practice currently shown. Their verified files work offline later.
    before = FixtureStarts()
    PracticeContentRequest(1)
    PracticeContentRequest(4)
    for turn: cast(s32)0..cast(s32)3 {
        PracticeDownloadsPump(0, false, false, true)
    }
    if FixtureStarts() != before + 2 || PracticeContentStatus(1) != 2 ||
    PracticeContentStatus(4) != 2 || PracticeContentReady(1) || PracticeContentReady(4) {
        return 21
    }
    PracticeDownloadsPump(1, false, false, true)
    if !PracticeContentReady(1) || FixtureStarts() != before + 2 {
        return 22
    }
    PracticeDownloadsPump(0, false, false, true)
    PracticeContentRemove(4)
    PracticeDownloadsClose()
    PracticeDownloadsPump(0, false, false, true)
    for turn: cast(s32)0..cast(s32)6 {
        PracticeContentReviewNext()
    }
    if PracticeContentStatus(1) != 2 || PracticeContentReady(1) ||
    !PracticePackReviewed(1, "") || !PracticeContentReady(0) {
        return 23
    }
    // Remove takes a downloaded practice off Practice and keeps its copy, so
    // it comes back without a download; Delete frees the copy.
    before = FixtureStarts()
    PracticeContentHide(1)
    if PracticeInstalled(1) || PracticeContentStatus(1) != 2 ||
    !PracticePackStored(PracticePackFind(1, "")) {
        return 60
    }
    PracticeDownloadsClose()
    PracticeCatalogLoad()
    for turn: cast(s32)0..cast(s32)8 {
        PracticeContentReviewNext()
    }
    if PracticeInstalled(1) || PracticeContentStatus(1) != 2 {
        return 61
    }
    PracticeContentRequest(1)
    PracticeDownloadsPump(1, false, false, true)
    if !PracticeInstalled(1) || !PracticeContentReady(1) || FixtureStarts() != before ||
    PracticeMarked(1, ".removed") {
        return 62
    }
    PracticeDownloadsPump(0, false, false, true)
    PracticeContentHide(1)
    PracticeContentRemove(1)
    if PracticeInstalled(1) || PracticeContentStatus(1) != 0 ||
    PracticePackStored(PracticePackFind(1, "")) || PracticeMarked(1, ".removed") {
        return 63
    }
    // Mini sessions reuse public caches, but missing packs stay transient.
    DataSetTemporary(true)
    PracticeDownloadsPump(4, false, false, true)
    PracticeContentRequest(4)
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(4, false, false, true)
    if !PracticeContentReady(4) || FixtureTaiChiSaved() {
        return 19
    }
    PracticeDownloadsPump(0, false, false, true)
    before = FixtureStarts()
    PracticeContentRemove(0)
    DataSetTemporary(false)
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before || FixtureTaiChiSaved() {
        return 20
    }
    // Wim Hof ships with the app: installed without a download, removed for
    // good, and back again without a download. Others need a download.
    PracticeContentRemove(0)
    FixtureShipped(1)
    PracticeDownloadsClose()
    before = FixtureStarts()
    if !PracticeInstalled(0) || PracticeInstalled(2) {
        return 24
    }
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeContentReady(0) || FixtureStarts() != before {
        return 25
    }
    PracticeContentRemove(0)
    PracticeDownloadsClose()
    PracticeDownloadsPump(0, false, false, true)
    if PracticeInstalled(0) || PracticeContentReady(0) {
        return 26
    }
    PracticeContentRequest(0)
    PracticeDownloadsPump(0, false, false, true)
    if !PracticeInstalled(0) || !PracticeContentReady(0) || FixtureStarts() != before {
        return 27
    }
    PracticeDownloadsClose()
    if !PracticeInstalled(0) {
        return 28
    }
    // Breathing Patterns ships with the app without being installed: adding
    // it uses the app's copy, with no copy of its own and no download, and
    // it stays added until it is removed.
    if PracticeInstalled(3) || !PracticeShipped(3) {
        return 39
    }
    PracticeContentRequest(3)
    PracticeDownloadsPump(3, false, false, true)
    PracticeDownloadsPump(3, false, false, true)
    if !PracticeInstalled(3) || !PracticeContentReady(3) || FixtureStarts() != before ||
    PracticePackStored(PracticePackFind(3, "")) {
        return 40
    }
    PracticeDownloadsClose()
    if !PracticeInstalled(3) {
        return 64
    }
    PracticeContentHide(3)
    PracticeDownloadsClose()
    if PracticeInstalled(3) || PracticeMarked(3, ".added") {
        return 41
    }
    PracticeContentRequest(3)
    PracticeContentRemove(3)
    PracticeDownloadsClose()
    if PracticeInstalled(3) || PracticeMarked(3, ".added") || PracticeMarked(3, ".removed") {
        return 65
    }
    // Paid packs download only with the host's grant in their path; they
    // wait while it is requested and fail when it is refused. Google Play,
    // without Dew, hides them.
    if PracticeProduct(4) != "inbe.practice.taichi" || PracticeProduct(0).count != 0 ||
    FixtureGrantedStarts() < 1 {
        return 29
    }
    PracticeContentRemove(4)
    fixture_grant_mode = 0
    before = FixtureStarts()
    PracticeContentRequest(4)
    PracticeDownloadsPump(4, false, false, true)
    if FixtureStarts() != before || PracticeContentStatus(4) != 1 {
        return 30
    }
    fixture_grant_mode = 1
    PracticeDownloadsPump(4, false, false, true)
    PracticeDownloadsPump(4, false, false, true)
    if FixtureStarts() != before + 1 || !PracticeContentReady(4) {
        return 31
    }
    // A paid pack on this device counts as installed only for an account
    // that owns it, such as a pack another account left behind.
    fixture_owned = false
    if PracticeInstalled(4) || !PracticeInstalled(0) {
        return 34
    }
    fixture_owned = true
    if !PracticeInstalled(4) {
        return 35
    }
    PracticeContentRemove(4)
    fixture_grant_mode = -1
    PracticeContentRequest(4)
    // A refused grant is asked for again, then reported; nothing downloads.
    for step: cast(s32)0..cast(s32)5 {
        PracticeDownloadsPump(4, false, false, true)
    }
    if FixtureStarts() != before + 1 || PracticeContentStatus(4) != 3 {
        return 32
    }
    practice_paid_allowed = false
    if !PracticeHidden(4) || PracticeInstalled(4) || PracticeHidden(0) || !PracticeInstalled(0) {
        return 33
    }
    practice_paid_allowed = true
    PracticeDownloadsClose()
    return 0
}
