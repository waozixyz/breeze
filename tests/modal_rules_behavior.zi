#import, file "../src/app/modal_rules.zi";
#import, file "../src/core/types.zi";

using ModalType;

#program_export
Answer :: () -> s32 {
    // Current modal order must stay consistent across generated targets.
    if cast(s32)ModalNone != 0 || cast(s32)ModalConfirmExitSession != 1 ||
    cast(s32)ModalBottomNavConfig != 19 || cast(s32)ModalAppIconPicker != 23 {
        return 1
    }
    if !ModalValidOnScreen(cast(ModalType)ModalConfirmExitSession,
        ScreenSession, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalConfirmExitSession,
        ScreenMeditation, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalConfirmExitSession,
        ScreenSunSalutation, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalConfirmExitSession,
        ScreenPatterns, false) ||
    ModalValidOnScreen(cast(ModalType)ModalConfirmExitSession,
        ScreenStart, false) { return 2 }
    if !ModalValidOnScreen(cast(ModalType)ModalMeditationSetup,
        ScreenStart, false) ||
    ModalValidOnScreen(cast(ModalType)ModalMeditationSetup,
        ScreenHabits, false) { return 3 }
    if !ModalValidOnScreen(cast(ModalType)ModalConfirmDeleteHabit,
        ScreenHabitEdit, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalConfirmDeleteHabit,
        ScreenHabits, true) ||
    ModalValidOnScreen(cast(ModalType)ModalConfirmDeleteHabit,
        ScreenHabits, false) { return 4 }
    if !ModalValidOnScreen(cast(ModalType)ModalHabitPracticePicker,
        ScreenHabitEdit, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalHabitPracticePicker,
        ScreenHabits, true) ||
    ModalValidOnScreen(cast(ModalType)ModalHabitPracticePicker,
        ScreenStart, true) { return 5 }
    if !ModalValidOnScreen(cast(ModalType)ModalBottomNavConfig,
        ScreenCustomizeNav, false) ||
    ModalValidOnScreen(cast(ModalType)ModalBottomNavConfig,
        ScreenStart, false) { return 6 }
    if !ModalValidOnScreen(cast(ModalType)ModalAboutDonation,
        ScreenStart, false) ||
    !ModalValidOnScreen(cast(ModalType)ModalAboutDonation,
        ScreenSession, false) { return 7 }
    return 42
}
