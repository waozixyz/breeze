#import, file "../apps/lumi/lumi_view.zi";
#import, file "../apps/lumi/message_text.zi";
#import "byte_text_linux"

Answer :: () -> s64 {
    first := RowText(1, "Try **breathing slowly**.", true)
    if TextFromBytes(first.text.bytes[:first.text.count]) != "Try breathing slowly." ||
    first.text.strong_count != 1 {
        return 1
    }
    again := RowText(1, "Try **breathing slowly**.", true)
    if again != first || again.text.strong[0].start != 4 {
        return 2
    }
    changed := RowText(1, "**水を飲む**", true)
    if TextFromBytes(changed.text.bytes[:changed.text.count]) != "水を飲む" ||
    changed.text.strong_count != 1 || changed.text.strong[0].start != 0 {
        return 3
    }
    replacement := RowText(9, "A plain reply.", true)
    if TextFromBytes(replacement.text.bytes[:replacement.text.count]) != "A plain reply." ||
    replacement.text.strong_count != 0 {
        return 4
    }
    restored := RowText(1, "Try **breathing slowly**.", true)
    if TextFromBytes(restored.text.bytes[:restored.text.count]) != "Try breathing slowly." ||
    restored.text.strong_count != 1 {
        return 5
    }
    empty := RowText(1, "", true)
    if empty.text.count != 0 || empty.text.strong_count != 0 {
        return 6
    }
    raw := RowText(1, "Try **breathing slowly**.", false)
    if TextFromBytes(raw.text.bytes[:raw.text.count]) != "Try **breathing slowly**." || raw.text.strong_count != 0 {
        return 7
    }
    formatted := RowText(1, "Try **breathing slowly**.", true)
    if TextFromBytes(formatted.text.bytes[:formatted.text.count]) != "Try breathing slowly." ||
    formatted.text.strong_count != 1 {
        return 8
    }
    return 42
}
