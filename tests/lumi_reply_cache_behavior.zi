#import, file "../apps/lumi/lumi_view.zi";
#import "byte_text_linux"

Answer :: () -> s64 {
    first := ReplyText(1, "Try **breathing slowly**.")
    if TextFromBytes(first.bytes[:first.count]) != "Try breathing slowly." ||
    first.strong_count != 1 {
        return 1
    }
    again := ReplyText(1, "Try **breathing slowly**.")
    if again != first || again.strong[0].start != 4 {
        return 2
    }
    changed := ReplyText(1, "**水を飲む**")
    if TextFromBytes(changed.bytes[:changed.count]) != "水を飲む" ||
    changed.strong_count != 1 || changed.strong[0].start != 0 {
        return 3
    }
    replacement := ReplyText(9, "A plain reply.")
    if TextFromBytes(replacement.bytes[:replacement.count]) != "A plain reply." ||
    replacement.strong_count != 0 {
        return 4
    }
    restored := ReplyText(1, "Try **breathing slowly**.")
    if TextFromBytes(restored.bytes[:restored.count]) != "Try breathing slowly." ||
    restored.strong_count != 1 {
        return 5
    }
    empty := ReplyText(1, "")
    if empty.count != 0 || empty.strong_count != 0 {
        return 6
    }
    return 42
}
