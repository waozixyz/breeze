#import "std/byte_text_linux"
#import "std/file_linux"
#import "std/format"
#import "std/image"
#import "std/timer_linux"
#import "std/vec"
#import "kryon/bitmap_image"
#import "kryon/daylight"
#import "kryon/session"
#import "kryon/scene"
#import "kryon/scene_gpu"
#import, file "../src/screens/practice_banner_motion.zi";
#import, file "../src/screens/practice_banner_regions.zi";
#import, file "../src/screens/practice_banner_shader.zi";

mask: [PRACTICE_BANNER_MASK_WIDTH * PRACTICE_BANNER_MASK_HEIGHT * 4]u8;
clouds: [PRACTICE_CLOUD_BYTES]u8;

WriteOverlay :: (path: string, pixels: []u8) -> bool {
    file := OpenWrite(path)
    if !file.valid {
        return false
    }
    defer { unused CloseFile(file) }
    return WriteAt(file, pixels, 0) == pixels.count
}

main :: (argc: s32, argv: **u8) -> s32 {
    if argc < 2 || argc > 3 {
        print("expected banner asset key and optional RGBA output path\n")
        return 1
    }
    regions := PracticeBannerRegionsFor(TextFromCString(argv[1]))
    if regions.sky[0].radius_x == 0.0 {
        return 2
    }
    photo := OpenRead("assets/app/practice-clouds.rg")
    if !photo.valid {
        print("could not load cloud observations\n")
        return 3
    }
    count := ReadAt(photo, clouds[:], 0)
    unused CloseFile(photo)
    banner: PracticeBannerShader
    if count != PRACTICE_CLOUD_BYTES || !PracticeBannerShaderInit(*banner) {
        return 3
    }
    defer SceneFree(*banner.scene)
    defer VecFree(banner.sky.noise)
    if regions.steam_opacity > 0.0 {
        // A fresh app opens Wim Hof before any card loads the cloud texture.
        original := PracticeBannerRegionsFor(TextFromCString(argv[1]), true)
        original.full_sky = true
        PracticeBannerMask(original, mask[:])
        if !PracticeBannerShaderLook(*banner, original, mask[:], clouds[:]) || banner.sky.noise.count != 0 {
            return 28
        }
        PracticeBannerShaderPass(*banner, original, true)
        PracticeBannerShaderPhase(*banner, 49)
        cold_gpu: SceneGpuContext
        defer SceneGpuRelease(*cold_gpu)
        cold_steam := NewImage(176, 72)
        defer VecFree(cold_steam.pixels)
        cold_frame := SceneGpuRender(*cold_gpu, *banner.scene, PracticeBannerSteamCamera(banner.camera), *cold_steam)
        if !cold_frame.ok || !cold_frame.accelerated {
            print("cold artwork steam render failed: %\n", cold_frame.diagnostic)
            return 29
        }
    }
    PracticeBannerMask(regions, mask[:])
    if !PracticeBannerShaderLook(*banner, regions, mask[:], clouds[:]) {
        return 3
    }
    unused SetVisible(*banner.scene, banner.sky_node, true)
    unused SetVisible(*banner.scene, banner.steam_node, false)
    gpu: SceneGpuContext
    caps := SceneGpuProbe(*gpu)
    defer SceneGpuRelease(*gpu)
    if !caps.available {
        print("GPU unavailable: %\n", caps.diagnostic)
        return 4
    }
    print("renderer %\n", TextFromCString(*caps.renderer[0]))
    first := NewImage(PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT)
    current := NewImage(PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT)
    defer VecFree(first.pixels)
    defer VecFree(current.pixels)
    PracticeBannerShaderPhase(*banner, 49)
    frame := SceneGpuRender(*gpu, *banner.scene, banner.camera, *first)
    if !frame.ok || !frame.accelerated {
        print("banner render failed: %\n", frame.diagnostic)
        return 5
    }
    session := SessionOpen()
    defer { unused SessionClose(session) }
    retained := BitmapImageCreate(session, first.width, first.height, first.pixels[:])
    if retained.id == 0 {
        return 6
    }
    defer BitmapImageRelease(session, retained)
    PracticeBannerShaderPhase(*banner, 97)
    frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
    if !frame.ok || !frame.accelerated {
        return 7
    }
    sky_changed: s64
    water_changed: s64
    protected: s64
    for row: 0..first.height - 1 {
        for column: 0..first.width - 1 {
            at := (row * first.width + column) * 4
            region := ((row * PRACTICE_BANNER_MASK_HEIGHT / first.height) * PRACTICE_BANNER_MASK_WIDTH +
                column * PRACTICE_BANNER_MASK_WIDTH / first.width) * 4
            if mask[region] == 0 && mask[region + 1] == 0 {
                if first.pixels[at + 3] != 0 || current.pixels[at + 3] != 0 {
                    print("overlay leaked into protected pixel (%, %)\n", column, row)
                    return 8
                }
                protected += 1
            }
            if first.pixels[at + 3] > 64 && first.pixels[at + 3] == current.pixels[at + 3] &&
            (first.pixels[at] != current.pixels[at] || first.pixels[at + 1] != current.pixels[at + 1] ||
                first.pixels[at + 2] != current.pixels[at + 2]) {
                if mask[region] > mask[region + 1] {
                    sky_changed += 1
                } else {
                    water_changed += 1
                }
            }
        }
    }
    print("changed sky % water % protected % pixels\n", sky_changed, water_changed, protected)
    if sky_changed < 40 || (regions.water[0].radius_x > 0.0 && water_changed < 10) || protected < 25000 {
        return 9
    }
    if regions.water[0].radius_x > 0.0 {
        // Hold the cloud field still to exercise the reflected ray separately.
        wave := banner.uniforms[BANNER_WAVE]
        PracticeBannerShaderPhase(*banner, 49)
        banner.uniforms[BANNER_WAVE] = wave
        frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
        if !frame.ok || !frame.accelerated {
            return 13
        }
        ripple_changed: s64
        for row: 0..first.height - 1 {
            for column: 0..first.width - 1 {
                at := (row * first.width + column) * 4
                if current.pixels[at] != first.pixels[at] || current.pixels[at + 1] != first.pixels[at + 1] ||
                current.pixels[at + 2] != first.pixels[at + 2] {
                    region := ((row * PRACTICE_BANNER_MASK_HEIGHT / first.height) * PRACTICE_BANNER_MASK_WIDTH +
                        column * PRACTICE_BANNER_MASK_WIDTH / first.width) * 4
                    if mask[region + 1] == 0 {
                        return 14
                    }
                    ripple_changed += 1
                }
            }
        }
        if ripple_changed < 100 {
            return 15
        }
        print("water changes independently in % pixels\n", ripple_changed)
    }
    PracticeBannerShaderPhase(*banner, 49)
    stars := banner.uniforms[DAYLIGHT_STARS].x
    banner.uniforms[DAYLIGHT_STARS].x = 0.0
    frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
    if !frame.ok || !frame.accelerated {
        return 16
    }
    star_pixels: s64
    for pixel: 0..first.width * first.height - 1 {
        at := pixel * 4
        if first.pixels[at] != current.pixels[at] || first.pixels[at + 1] != current.pixels[at + 1] ||
            first.pixels[at + 2] != current.pixels[at + 2] {
            star_pixels += 1
        }
    }
    night := regions.look.hour >= 18.5
    print("catalogued stars affect % pixels\n", star_pixels)
    if (night && star_pixels < 30) || (!night && star_pixels != 0) {
        return 17
    }
    banner.uniforms[DAYLIGHT_STARS].x = stars
    unused SetVisible(*banner.scene, banner.steam_node, regions.steam_opacity > 0.0)
    frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
    if !frame.ok || !frame.accelerated {
        return 18
    }
    if argc == 3 && !WriteOverlay(TextFromCString(argv[2]), current.pixels[:]) {
        return 12
    }
    if regions.steam_opacity > 0.0 {
        steam_pixels: s64
        for pixel: 0..first.width * first.height - 1 {
            if cast(s32)current.pixels[pixel * 4 + 3] > cast(s32)first.pixels[pixel * 4 + 3] + 10 {
                steam_pixels += 1
            }
        }
        // Hold the sky and water still and advance just the plume phase.
        phase := banner.steam_uniforms[BANNER_STEAM_PHASE].x - 0.8
        banner.steam_uniforms[BANNER_STEAM_PHASE] = .{phase, phase, phase, phase}
        frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *first)
        if !frame.ok || !frame.accelerated {
            return 19
        }
        steam_changed: s64
        for pixel: 0..first.width * first.height - 1 {
            if current.pixels[pixel * 4 + 3] != first.pixels[pixel * 4 + 3] {
                steam_changed += 1
            }
        }
        print("steam visible in % pixels, moving in % pixels\n", steam_pixels, steam_changed)
        if steam_pixels < 120 || steam_changed < 120 {
            return 20
        }
    }
    warmed := SceneGpuMemoryUsage(*gpu)
    transfer_ms: float64
    copy_ms: float64
    total_ms: float64
    bitmap_ms: float64
    for tick: cast(s64)97..191 {
        PracticeBannerShaderPhase(*banner, tick)
        started := MonotonicNanoseconds()
        frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
        copying := MonotonicNanoseconds()
        if !frame.ok || !frame.accelerated || !BitmapImageUpdate(session, retained, current.pixels[:]) {
            return 10
        }
        bitmap_ms += cast(float64)(MonotonicNanoseconds() - copying) / 1000000.0
        transfer_ms += frame.readback_ms
        copy_ms += frame.conversion_ms
        total_ms += cast(float64)(copying - started) / 1000000.0
    }
    final := SceneGpuMemoryUsage(*gpu)
    print("95 frames at %x%; mean render % ms, readback % ms, conversion % ms, bitmap update % ms\n",
        current.width, current.height, total_ms / 95.0, transfer_ms / 95.0, copy_ms / 95.0, bitmap_ms / 95.0)
    print("input texture uploads % -> %; geometry uploads % -> %\n",
        warmed.texture_uploads, final.texture_uploads, warmed.geometry_uploads, final.geometry_uploads)
    if warmed.texture_uploads != banner.samplers.count || final.texture_uploads != warmed.texture_uploads ||
    final.geometry_uploads != warmed.geometry_uploads {
        return 11
    }
    if regions.steam_opacity > 0.0 {
        regions.full_sky = true
        PracticeBannerMask(regions, mask[:])
        if !PracticeBannerShaderLook(*banner, regions, mask[:], clouds[:]) {
            return 21
        }
        PracticeBannerShaderPass(*banner, regions, false)
        frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *first)
        if !frame.ok || !frame.accelerated || first.pixels[3] < 250 {
            return 21
        }
        regions = PracticeBannerRegionsFor(TextFromCString(argv[1]), true)
        PracticeBannerMask(regions, mask[:])
        if !PracticeBannerShaderLook(*banner, regions, mask[:], clouds[:]) {
            return 26
        }
        PracticeBannerShaderPass(*banner, regions, true)
        frame = SceneGpuRender(*gpu, *banner.scene, banner.camera, *current)
        if !frame.ok || !frame.accelerated || current.pixels[3] != 0 {
            return 22
        }
        steam_pixels: s64
        for pixel: 0..current.width * current.height - 1 {
            if current.pixels[pixel * 4 + 3] > 10 {
                steam_pixels += 1
            }
        }
        print("foreground steam visible in % pixels\n", steam_pixels)
        if steam_pixels < 120 {
            return 23
        }
        cropped := NewImage(176, 72)
        defer VecFree(cropped.pixels)
        frame = SceneGpuRender(*gpu, *banner.scene, PracticeBannerSteamCamera(banner.camera), *cropped)
        if !frame.ok || !frame.accelerated { return 24 }
        visible_samples: s64
        alpha_error: s64
        for row: 0..cropped.height - 1 {
            for column: 0..cropped.width - 1 {
                x := BANNER_STEAM_LEFT + BANNER_STEAM_WIDTH * (cast(float64)column + 0.5) / cast(float64)cropped.width
                y := 1.0 - BANNER_STEAM_BOTTOM - BANNER_STEAM_HEIGHT +
                    BANNER_STEAM_HEIGHT * (cast(float64)row + 0.5) / cast(float64)cropped.height
                full_row := cast(s32)(y * cast(float64)current.height)
                full_column := cast(s32)(x * cast(float64)current.width)
                full_pixel := (full_row * current.width + full_column) * 4
                crop_pixel := (row * cropped.width + column) * 4
                full_alpha := cast(s64)current.pixels[full_pixel + 3]
                crop_alpha := cast(s64)cropped.pixels[crop_pixel + 3]
                if full_alpha > 10 || crop_alpha > 10 {
                    visible_samples += 1
                    alpha_error += ifx full_alpha > crop_alpha then full_alpha - crop_alpha else crop_alpha - full_alpha
                }
            }
        }
        if visible_samples < 150 || alpha_error > visible_samples * 7 {
            print("cropped steam alignment failed: % visible pixels, total alpha error %\n", visible_samples, alpha_error)
            return 25
        }
    }
    return 0
}
