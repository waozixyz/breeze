#import, file "../src/screens/habits/card_layout.zi";

Answer :: () -> s32 {
    // Expanding the second column leaves both neighboring columns in place.
    if HabitCardOffset(3, 1, 3, 140, 400, 12) != 152 {
        return 1
    }
    if HabitCardOffset(4, 1, 3, 140, 400, 12) != 412 {
        return 2
    }
    if HabitCardOffset(5, 1, 3, 140, 400, 12) != 152 {
        return 3
    }
    if HabitCardOffset(7, 1, 3, 140, 400, 12) != 564 {
        return 4
    }
    // Expanding a later row does not move cards above it.
    if HabitCardOffset(1, 4, 3, 140, 400, 12) != 0 {
        return 5
    }
    if HabitCardOffset(7, 4, 3, 140, 400, 12) != 564 {
        return 6
    }
    // Collapse, narrow screens, and a partial final row retain their spacing.
    if HabitCardOffset(4, -1, 3, 140, 400, 12) != 152 {
        return 7
    }
    if HabitCardOffset(2, 1, 1, 140, 400, 12) != 564 {
        return 8
    }
    if HabitCardOffset(2, 1, 0, 140, 400, 12) != 564 {
        return 9
    }
    if HabitCardOffset(4, 2, 3, 140, 400, 12) != 152 {
        return 10
    }
    return 42
}
