// No graphics or desktop are used by the Android input transport test.
#import "drawing_props"
#import "geometry"

labels: s32;

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    return (cast(s32)value.count) * font / 2
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    return font
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {}

#program_export
RasterLine :: (bounds: Rectangle, color: Color) {}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    labels += 1
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    labels += 1
}

#program_export
RasterImage :: (path: string, texture_id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {}

#program_export
RasterImageMesh :: (path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle,
    tint: Color) {}

#program_export
ContextMenuLabelCount :: () -> s32 { return labels }

#program_export
SystemClipboardOpenHost :: () -> s32 {
    return -1
}
#program_export
SystemClipboardByteHost :: (index: s32) -> s32 {
    unused index
    return -1
}
#program_export
SystemClipboardWriteHost :: (text: string) -> bool {
    unused text
    return false
}
