// A habit's statistics are Habits' own: the bundled package draws them from
// the figures the host counted, reads each chart, hold and change through
// the host, and draws its answer charts with plot's band chart, which the
// host answers.
#import "session"
#import "geometry"
#import "tree"
#import "tree_draw"
#import "paint_queue"
#import "bundle_host"
#import "byte_text_linux"
#import "hosted_values"
#import "widget_host"
#import "drawing_props"
#import "plot/band_chart_host"
#import, file "../src/apps/module_host.zi";
#import, file "../src/apps/habits_types.zi";
#import, file "../src/apps/habits_ui_types.zi";
#import, file "../src/apps/app_codec.zi";
#import, file "../src/habits/habit_types.zi";

using HostValueKind;

stats_test_frame: HabitsStatsFrame;
stats_test_codec: WidgetHabitsStatsFrameCodec;
stats_test_chart_codec: WidgetHabitsStatsChartCodec;
stats_test_point_codec: WidgetHabitsStatsPointCodec;
stats_test_recent_codec: WidgetHabitsStatsRecentCodec;
stats_test_hold_codec: WidgetHabitsStatsHoldCodec;
stats_test_change_codec: WidgetHabitsStatsChangeCodec;
stats_test_reads: s32;
stats_test_written: s32;
stats_test_charts: s32;
stats_test_points: s32;
stats_test_holds: s32;
stats_test_changes: s32;
stats_test_band_charts: s32;
stats_test_refused: bool;

StatsTestAssets :: (path: string) -> bool {
    return path.count == 0
}

StatsTestCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if BandChartHostSupports(TextFromCString(module), TextFromCString(function)) {
        answered := BandChartHostCall(stats_test_frame.session, module, function, arguments,
            count, result)
        if answered == 1 {
            stats_test_band_charts += 1
        } else {
            stats_test_refused = true
        }
        return answered
    }
    if TextFromCString(module) != "habit_stats_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadHabitsStatsHost" && count == 0 {
        stats_test_reads += 1
        result.* = WidgetEncodeHabitsStatsFrame(stats_test_frame, *stats_test_codec)
        return 1
    }
    if name == "WriteHabitsStatsHost" && count == 1 && WidgetValidHabitsStatsFrame(arguments[0]) {
        stats_test_written += 1
        observed := WidgetDecodeHabitsStatsFrame(arguments[0], *stats_test_codec)
        stats_test_frame.scroll = observed.scroll
        stats_test_frame.hold_days = observed.hold_days
        stats_test_frame.action = observed.action
        return 1
    }
    if name == "ReadHabitsStatsChartHost" && count == 1 {
        chart := cast(s32)arguments[0].integer
        if chart < 0 || chart > stats_test_frame.question_count { return 0 }
        stats_test_charts += 1
        value := HabitsStatsChart.{.title = "Plates", .answer_type = HABIT_ANSWER_NUMBER,
            .shown = true, .point_count = 3, .lowest = 1, .highest = 3, .sum = 6,
            .average = 200, .days = 3, .answered = 3, .judged = 3, .good = 2}
        result.* = WidgetEncodeHabitsStatsChart(value, *stats_test_chart_codec)
        return 1
    }
    if name == "ReadHabitsStatsPointHost" && count == 2 {
        index := cast(s32)arguments[1].integer
        if index < 0 || index >= 3 { return 0 }
        stats_test_points += 1
        point := HabitsStatsPoint.{.slot = 20 + index * 3, .value = index + 1,
            .good = ifx index == 0 then 0 else 1, .label = "2026-10-20 · 2"}
        result.* = WidgetEncodeHabitsStatsPoint(point, *stats_test_point_codec)
        return 1
    }
    if name == "ReadHabitsStatsRecentHost" && count == 2 {
        result.* = WidgetEncodeHabitsStatsRecent(HabitsStatsRecent.{}, *stats_test_recent_codec)
        return 1
    }
    if name == "ReadHabitsStatsHoldHost" && count == 1 {
        index := cast(s32)arguments[0].integer
        if index < 0 || index >= stats_test_frame.hold_count { return 0 }
        stats_test_holds += 1
        hold := HabitsStatsHold.{.days_ago = index, .time = 8 * 3600, .round = 0,
            .seconds = 60 + index * 5}
        result.* = WidgetEncodeHabitsStatsHold(hold, *stats_test_hold_codec)
        return 1
    }
    if name == "ReadHabitsStatsChangeHost" && count == 1 {
        index := cast(s32)arguments[0].integer
        if index < 0 || index >= stats_test_frame.change_count { return 0 }
        stats_test_changes += 1
        change := HabitsStatsChange.{.when = "2026-10-17 12:00", .line = "Created"}
        result.* = WidgetEncodeHabitsStatsChange(change, *stats_test_change_codec)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 {
        text := "%d"
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// Draws a habit's statistics, tall enough to show every section; returns 0
// when the package drew them through the host.
CheckHabitStats :: () -> s32 {
    session := SessionOpen()
    bounds := Rectangle.{0.0, 0.0, 400.0, 2400.0}
    BeginFrame(session, cast(u64)1, bounds)
    stats_test_frame = HabitsStatsFrame.{.session = session, .scale = 1.0,
        .view_width = 400, .view_height = 2400, .font = 16, .small_font = 14,
        .text_color = Color.{.r = 230, .g = 230, .b = 240, .a = 255},
        .canvas_color = Color.{.r = 20, .g = 20, .b = 30, .a = 255},
        .card_fill = Color.{.r = 30, .g = 30, .b = 40, .a = 255},
        .name = "Meditation", .color = Color.{.r = 120, .g = 190, .b = 230, .a = 255},
        .current_streak = 4, .best_streak = 9, .last_30_done = 20, .sunday = 3,
        .monday = 5, .linked = true, .best_time = "20m", .total_time = "4h",
        .mood_total = 7, .mood_average = 3.85, .mood_3 = 2, .mood_4 = 3, .mood_5 = 2,
        .hold_count = 4, .hold_days = 7, .span_start_average = -1,
        .span_end_average = -1, .question_count = 1, .change_count = 2}
    WidgetHostBegin(session, StatsTestAssets)
    AppsUiBegin(StatsTestCall, null)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_STATS_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    painted := PendingPaintCount(session)
    unused EndFrame(session)
    unused SessionClose(session)
    if !drawn.succeeded { return 1 }
    if stats_test_reads != 1 || stats_test_written != 1 { return 2 }
    if painted == 0 { return 3 }
    if stats_test_frame.action != HABITS_STATS_NONE || stats_test_frame.hold_days != 7 { return 4 }
    // The question's chart and its points, each hold and each change.
    if stats_test_charts == 0 || stats_test_points < 3 { return 5 }
    if stats_test_holds < 4 || stats_test_changes < 2 { return 6 }
    // The answer chart came from plot, through the host.
    if stats_test_band_charts != 1 || stats_test_refused { return 7 }
    return 0
}
