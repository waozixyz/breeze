#import, file "../src/platform/web_window.zi";
#import "browser_viewport"

#program_export
main :: () -> s32 {
    portrait := BrowserOrientationSize(BrowserViewport.{1200, 800}, 1)
    landscape := BrowserOrientationSize(BrowserViewport.{600, 1000}, 2)
    if portrait.width != 450 || portrait.height != 800 ||
        landscape.width != 600 || landscape.height != 337 {
        return 1
    }
    SetBrowserOrientation(1)
    if BrowserViewportSize(1200, 800).width != 450 {
        return 4
    }
    SetBrowserOrientation(99)
    if BrowserViewportSize(1200, 800).width != 1200 {
        return 5
    }
    return 0
}
