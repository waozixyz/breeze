#import, file "../src/platform/web_window.zi";

#program_export
main :: () -> s32 {
    portrait := BrowserOrientationSize(BrowserSize.{1200, 800}, 1)
    landscape := BrowserOrientationSize(BrowserSize.{600, 1000}, 2)
    if portrait.width != 450 || portrait.height != 800 ||
        landscape.width != 600 || landscape.height != 337 {
        return 1
    }
    current := BrowserSize.{640, 480}
    changed := BrowserSize.{800, 600}
    if BrowserResizeReady(current, changed, true, false) ||
        BrowserResizeReady(current, changed, false, false) ||
        BrowserResizeReady(current, changed, false, true) ||
        !BrowserResizeReady(current, changed, false, false) {
        return 2
    }
    if BrowserResizeReady(current, current, false, false) ||
        BrowserResizeReady(current, BrowserSize.{641, 479}, false, false) ||
        BrowserResizeReady(current, changed, false, false) ||
        !BrowserResizeReady(current, changed, false, false) {
        return 3
    }
    SetBrowserOrientation(1)
    if BrowserViewportSize(1200, 800).width != 450 {
        return 4
    }
    SetBrowserOrientation(99)
    if BrowserViewportSize(1200, 800).width != 1200 {
        return 5
    }
    return 0
}
