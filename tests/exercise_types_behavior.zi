#import, file "../src/app/exercise_types.zi";

using ExerciseType;

#program_export
Answer :: () -> s32 {
    if EXERCISE_WIM_HOF != 0 || EXERCISE_MEDITATION != 1 ||
       EXERCISE_SUN_SALUTATION != 2 || EXERCISE_PATTERNS != 3 {
        return 1
    }
    if practice_count() != EXERCISE_COUNT { return 2 }
    if practice_ordered_id(-1) != EXERCISE_WIM_HOF ||
       practice_ordered_id(0) != EXERCISE_WIM_HOF ||
       practice_ordered_id(1) != EXERCISE_PATTERNS ||
       practice_ordered_id(2) != EXERCISE_MEDITATION ||
       practice_ordered_id(3) != EXERCISE_SUN_SALUTATION ||
       practice_ordered_id(4) != EXERCISE_SUN_SALUTATION {
        return 3
    }
    if practice_clamp_id(-1) != EXERCISE_WIM_HOF ||
       practice_clamp_id(0) != EXERCISE_WIM_HOF ||
       practice_clamp_id(1) != EXERCISE_MEDITATION ||
       practice_clamp_id(2) != EXERCISE_SUN_SALUTATION ||
       practice_clamp_id(3) != EXERCISE_PATTERNS ||
       practice_clamp_id(4) != EXERCISE_WIM_HOF {
        return 4
    }
    return 42
}
