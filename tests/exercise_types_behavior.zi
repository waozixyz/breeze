#import, file "../src/app/exercise_types.zi";

using ExerciseType;

#program_export
Answer :: () -> s32 {
    if EXERCISE_WIM_HOF != 0 || EXERCISE_MEDITATION != 1 ||
    EXERCISE_SUN_SALUTATION != 2 || EXERCISE_PATTERNS != 3 ||
    EXERCISE_TAI_CHI != 4 || EXERCISE_ASTRAL_PROJECTION != 5 ||
    EXERCISE_WORKOUT != 6 || EXERCISE_COUNT != 7 {
        return 1
    }
    if practice_count() != EXERCISE_COUNT { return 2 }
    if practice_ordered_id(-1) != EXERCISE_WIM_HOF ||
    practice_ordered_id(0) != EXERCISE_WIM_HOF ||
    practice_ordered_id(1) != EXERCISE_PATTERNS ||
    practice_ordered_id(2) != EXERCISE_MEDITATION ||
    practice_ordered_id(3) != EXERCISE_SUN_SALUTATION ||
    practice_ordered_id(4) != EXERCISE_TAI_CHI ||
    practice_ordered_id(5) != EXERCISE_ASTRAL_PROJECTION ||
    practice_ordered_id(6) != EXERCISE_WORKOUT ||
    practice_ordered_id(7) != EXERCISE_WORKOUT {
        return 3
    }
    if practice_clamp_id(-1) != EXERCISE_WIM_HOF ||
    practice_clamp_id(0) != EXERCISE_WIM_HOF ||
    practice_clamp_id(1) != EXERCISE_MEDITATION ||
    practice_clamp_id(2) != EXERCISE_SUN_SALUTATION ||
    practice_clamp_id(3) != EXERCISE_PATTERNS ||
    practice_clamp_id(4) != EXERCISE_TAI_CHI ||
    practice_clamp_id(5) != EXERCISE_ASTRAL_PROJECTION ||
    practice_clamp_id(6) != EXERCISE_WORKOUT ||
    practice_clamp_id(7) != EXERCISE_WIM_HOF {
        return 4
    }
    // An upgrade appends new practices without undoing a saved drag order,
    // from five practices and from six.
    practice_order_load(142013)
    if practice_order_code() != 14201356 {
        return 5
    }
    practice_order_load(1503124)
    if practice_order_code() != 15031246 {
        return 8
    }
    practice_order_move(5, 0)
    saved := practice_order_code()
    practice_order_load(saved)
    if practice_order_code() != saved {
        return 6
    }
    practice_order_load(1420133)
    if practice_order_code() != 10312456 {
        return 7
    }
    return 42
}
