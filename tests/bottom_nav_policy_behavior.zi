#import, file "../src/app/bottom_nav_policy.zi";
#import, file "../src/app/route_types.zi";

using AppNavRoute;

#program_export
Answer :: () -> s32 {
    routes: [7]s32
    count := BottomNavDefaults(routes[:])
    if count != 5 || routes[0] != APP_NAV_ROUTE_LUMI ||
    routes[1] != APP_NAV_ROUTE_ELIST ||
    routes[2] != APP_NAV_ROUTE_HABITS ||
    routes[3] != APP_NAV_ROUTE_PRACTICE ||
    routes[4] != APP_NAV_ROUTE_SETTINGS { return 2 }
    routes[0] = APP_NAV_ROUTE_HABITS
    routes[1] = APP_NAV_ROUTE_PROFILE
    routes[2] = APP_NAV_ROUTE_SETTINGS
    count = BottomNavSanitize(routes[:], 3, false)
    if count != 2 || routes[0] != APP_NAV_ROUTE_HABITS ||
    routes[1] != APP_NAV_ROUTE_SETTINGS { return 6 }
    routes[0] = APP_NAV_ROUTE_PROFILE
    routes[1] = APP_NAV_ROUTE_HABITS
    count = BottomNavSanitize(routes[:], 2, true)
    if count != 3 || routes[0] != APP_NAV_ROUTE_PROFILE ||
    routes[1] != APP_NAV_ROUTE_HABITS ||
    routes[2] != APP_NAV_ROUTE_SETTINGS { return 7 }

    routes[0] = APP_NAV_ROUTE_SETTINGS
    routes[1] = APP_NAV_ROUTE_ELIST
    routes[2] = APP_NAV_ROUTE_HABITS
    count = BottomNavSanitize(routes[:], 3, false)
    if count != 3 || routes[0] != APP_NAV_ROUTE_ELIST ||
    routes[1] != APP_NAV_ROUTE_HABITS ||
    routes[2] != APP_NAV_ROUTE_SETTINGS { return 8 }
    routes[0] = APP_NAV_ROUTE_LUMI
    routes[1] = APP_NAV_ROUTE_HABITS
    routes[2] = APP_NAV_ROUTE_PRACTICE
    routes[3] = APP_NAV_ROUTE_ELIST
    routes[4] = APP_NAV_ROUTE_DIARY
    count = BottomNavSanitize(routes[:], 5, false)
    if count != 6 || routes[4] != APP_NAV_ROUTE_DIARY ||
    routes[5] != APP_NAV_ROUTE_SETTINGS { return 11 }
    routes = .{APP_NAV_ROUTE_PROFILE, APP_NAV_ROUTE_LUMI,
        APP_NAV_ROUTE_HABITS, APP_NAV_ROUTE_PRACTICE,
        APP_NAV_ROUTE_ELIST, APP_NAV_ROUTE_DIARY, APP_NAV_ROUTE_SETTINGS}
    count = BottomNavSanitize(routes[:], 7, true)
    if count != 7 || routes[0] != APP_NAV_ROUTE_PROFILE ||
    routes[3] != APP_NAV_ROUTE_PRACTICE || routes[5] != APP_NAV_ROUTE_DIARY ||
    routes[6] != APP_NAV_ROUTE_SETTINGS { return 13 }
    limited: [5]s32 = .{APP_NAV_ROUTE_LUMI, APP_NAV_ROUTE_HABITS,
        APP_NAV_ROUTE_PRACTICE, APP_NAV_ROUTE_ELIST, APP_NAV_ROUTE_DIARY}
    count = BottomNavSanitize(limited[:], 5, false)
    if count != 5 || limited[4] != APP_NAV_ROUTE_SETTINGS { return 12 }
    count = BottomNavSanitize(routes[:], 9, true)
    if count != 5 || routes[0] != APP_NAV_ROUTE_LUMI ||
    routes[4] != APP_NAV_ROUTE_SETTINGS { return 9 }

    short: [2]s32
    if BottomNavDefaults(short[:]) != 0 ||
    BottomNavSanitize(short[:], 9, false) != 0 { return 10 }
    return 42
}
