#import, file "../src/platform/web_storage.zi";
#import, file "../src/platform/environment.zi";
#import, file "../src/platform/web_bridge.zi";
#import, file "../src/platform/file_picker.zi";

#program_export
Answer :: () -> s32 {
    sync_web_storage()
    return sync_web_storage_critical()
}

#program_export
PlatformFlags :: () -> s32 {
    return DesktopPlatform() + WebPlatform() * 2 +
        AndroidPlatform() * 4 + WindowsPlatform() * 8 +
        WebExtensionHost() * 16
}
#import, file "../src/app/host_services.zi";

#program_export
main :: () -> s32 {
    if app_desktop_platform() != DesktopPlatform() ||
        app_web_extension_available() != WebExtensionHost() ||
        app_web_storage_flush_critical(2000, 1) != 1 {
        return 3
    }
    if Answer() != 1 {
        return 1
    }
    expected: s32 = 1
    #if #defined(ANDROID_BUILD) {
        expected = 4
    }
    #if #defined(PLATFORM_WEB) {
        expected = 2
        title: [2]u8 = .[65, 0]
        filter: [4]u8 = .[42, 46, 42, 0]
        output: [256]u8
        if app_pick_file(*title[0], *filter[0], null, true,
            *output[0], 256) != 1 {
            return 4
        }
        path := app_text_from_cstring(*output[0], 256)
        if path.count < 15 || path[0:15] != "/tmp/inbe-file-" {
            return 5
        }
    }
    return ifx PlatformFlags() == expected then 0 else 2
}
