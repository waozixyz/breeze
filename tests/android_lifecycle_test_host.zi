// The lifecycle test isolates routing and pause ownership. Draft persistence
// and elapsed break completion are exercised by their behavior suites.
draft_pause_calls: s32;

#program_export
PracticeDraftPause :: () {
    draft_pause_calls += 1
}

#program_export
app_breaks_note_lifecycle :: (app: *void, paused: bool) {
    unused app
    unused paused
}
