#import, file "../src/platform/trace_log.zi";

#program_export
main :: () -> s32 {
    TraceLog(4, "trace text")
    TraceLogInit(4, "width=%d height=%d embedded=%d", 320, 560, 1)
    TraceLogScale(4, "scale=%.2f layout=%dx%d", 1.5f, 320, 560)
    TraceLogGeometry(4,
        "viewport=%dx%d layout=%dx%d content_x=%d content=%dx%d render_scale=%.2f",
        320, 560, 300, 540, 10, 280, 540, 1.5f)
    TraceLogResult(4, "result=%d", 7)
    TraceLogTwoInts(4, "track=%d practice=%d", 2, 3)
    return 0
}
