#import, file "../src/app/metrics.zi";

#program_export
Answer :: () -> s32 {
    AppMetricsConfigure(1.5)
    if AppScale(10) != 15 || AppFontSize() != 24 {
        return 1
    }
    if AppSmallFontSize() != 21 || AppTitleBarHeight() != 72 {
        return 2
    }
    if AppTextWidth("abcd", 10) != 20 {
        return 3
    }
    if AppTitleFontSize("long title", 40) != 21 {
        return 4
    }
    if AppFitFontSize("abcd", 15, 10, 5) != 7 {
        return 5
    }
    if AppParagraphHeight("one two", 20, 10, 2) != 22 {
        return 6
    }
    if AppParagraphHeight("one\ntwo", 100, 10, 2) != 22 {
        return 7
    }
    if AppParagraphHeight("", 100, 10, 2) != 10 {
        return 8
    }
    AppMetricsConfigure(0.0)
    if AppScale(10) != 10 {
        return 9
    }
    return 42
}
