// The names apps the node offers may use: their own, their records' keys,
// their collections and shared ids, kept apart from the bundled apps' and
// from Lists' own shared lists.
#import, file "../src/storage/app_records.zi";

#program_export
Check :: () -> s32 {
    if !NodeAppNameValid("chess") || !NodeAppNameValid("photos2") { return 1 }
    if NodeAppNameValid("lumi") || NodeAppNameValid("diary") || NodeAppNameValid("feedback") { return 2 }
    if NodeAppNameValid("Chess") || NodeAppNameValid("2048") || NodeAppNameValid("a") ||
    NodeAppNameValid("chess-game") || NodeAppNameValid("abcdefghijklmnopqrstuvwxy") { return 3 }
    if NodeAppInstallName("app_used_chess") != "chess" || NodeAppInstallKeyValid("app_used_lists") ||
    NodeAppInstallKeyValid("app_used_") || NodeAppInstallKeyValid("app_order") { return 4 }
    if NodeAppRecordOwner("cell.chess.computer") != "chess" ||
    NodeAppRecordOwner("cell.chess.game.2-b") != "chess" { return 5 }
    // Lumi's and Diary's records stay theirs; malformed names are refused.
    if NodeAppRecordKeyValid("cell.lumi.history") || NodeAppRecordKeyValid("cell.diary.x") ||
    NodeAppRecordKeyValid("cell.chess.") || NodeAppRecordKeyValid("cell.chess.Big") ||
    NodeAppRecordKeyValid("cell.chess") || NodeAppRecordKeyValid("chess.computer") { return 6 }
    if !NodeAppRecordsCollectionValid("private.inbe.v1.app.chess") ||
    NodeAppRecordsCollectionValid("private.inbe.v1.app.lumi") ||
    NodeAppRecordsCollectionValid("private.inbe.v1.app-installs") { return 7 }
    if !NodeAppSharedIdValid("chess", "chess-0123456789abcdef0123456789abcd") ||
    NodeAppSharedIdValid("chess", "photos-0123") || NodeAppSharedIdValid("chess", "chess-") ||
    NodeAppSharedIdValid("chess", "chess-ABC") ||
    NodeAppSharedIdValid("chess", "chess-0123456789abcdef0123456789abcde") { return 8 }
    // Lists' UUIDs and an app named like eight hex digits never mix.
    if !SharedIdLooksLikeList("3f1c2b7a-9d4e-4c1b-8a2f-0e9d7c6b5a41") ||
    SharedIdLooksLikeList("chess-0123456789abcdef0123456789abcd") { return 9 }
    if NodeAppSharedIdValid("abcdef01", "abcdef01-9d4e-4c1b-8a2f-0e9d7c6b5a41") { return 10 }
    return 0
}
