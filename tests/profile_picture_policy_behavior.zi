#import, file "../src/app/profile_picture_policy.zi";

#program_export
Answer :: () -> s32 {
    if ProfilePictureCount != 25 { return 1 }
    if ProfilePictureDefault() != 41 { return 2 }
    if ProfilePictureAt(20) != 61 || ProfilePictureAt(21) != 124 ||
       ProfilePictureAt(22) != 125 || ProfilePictureAt(23) != 126 ||
       ProfilePictureAt(24) != 65 { return 3 }
    if ProfilePictureAt(-1) != 0 || ProfilePictureAt(25) != 0 { return 4 }
    if ProfilePictureValid(62) || ProfilePictureValid(91) ||
       !ProfilePictureValid(55) || !ProfilePictureValid(126) { return 5 }
    if ProfilePictureSelected(126) != 126 ||
       ProfilePictureSelected(999) != 41 { return 6 }
    return 42
}
