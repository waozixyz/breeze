// Embedded assets for the desktop host's picture and font loaders: the
// catalog's bytes for its own paths, nothing for any other path, which the
// raster then reads from disk.
#import "asset_files"
#import "assets"
#import "c_string"

entry: EmbeddedAssetEntry;
path_bytes: [32]u8;
mime_bytes: [32]u8;
embedded_bytes: [4]u8;

#program_export
asset_entry_total :: () -> usize {
    return 1
}

#program_export
asset_entry_at :: (index: usize) -> *EmbeddedAssetEntry {
    if index == 0 {
        return *entry
    }
    return null
}

#program_export
main :: () -> s32 {
    CopyCString("icons/ui.webp", path_bytes[:])
    CopyCString("application/octet-stream", mime_bytes[:])
    embedded_bytes[0] = 10
    embedded_bytes[1] = 0
    embedded_bytes[2] = 20
    embedded_bytes[3] = 255
    entry.path = *path_bytes[0]
    entry.mime = *mime_bytes[0]
    entry.data = *embedded_bytes[0]
    entry.size = 4
    InstallAssetFiles()
    loaded := ReadEmbeddedAsset("icons/ui.webp")
    if loaded.count != 4 || loaded[0] != 10 || loaded[1] != 0 ||
        loaded[2] != 20 || loaded[3] != 255 {
        return 1
    }
    if ReadEmbeddedAsset("disk.bin").count != 0 {
        return 2
    }
    if ReadEmbeddedAsset("").count != 0 {
        return 3
    }
    return 0
}
