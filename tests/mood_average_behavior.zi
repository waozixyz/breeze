#import, file "../src/storage/mood_average.zi";

#program_export
Answer :: () -> s32 {
    // Sessions rated after practice but never before: no lift to average.
    if SessionMoodAverage(0, 0) != 0.0 { return 0 }
    if SessionMoodAverage(12, 0) != 0.0 { return 0 }
    // 4 + 5 + 5 over three sessions keeps its fraction.
    average := SessionMoodAverage(14, 3)
    if average < 4.66 || average > 4.67 { return 0 }
    // Mood lift can be negative.
    if SessionMoodAverage(-3, 2) != -1.5 { return 0 }
    return 42
}
