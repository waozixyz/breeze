#import, file "../src/app/app_frame_transition.zi";
#import, file "../src/app/app_types.zi";
#import "drawing_props"
#import "frame_transition"

released: s32;
wrong_texture: bool;
// The complete app state includes large storage buffers; keep the fixture
// outside the test thread's stack, as the native application does.
app: InnerBreeze;

#program_export
DisposeFrameTexture :: (texture: Texture2D) {
    released += 1
    if texture.id != 42 {
        wrong_texture = true
    }
}

Frame :: () -> FrameSurface {
    surface: FrameSurface
    surface.texture = Texture2D.{42, 20, 20, 1, 7}
    return surface
}

Upright :: () -> FrameSurface {
    surface := Frame()
    surface.upright = true
    return surface
}

Prepared :: (app: *InnerBreeze, owned: bool) {
    app.ui.route_transition_surface = Frame()
    app.ui.route_transition_surface_owned = owned
    app.ui.route_transition_active = true
    app.ui.route_transition_pending = true
}

Cleared :: (app: *InnerBreeze) -> bool {
    return app.ui.route_transition_surface.texture.id == 0 &&
    !app.ui.route_transition_surface_owned &&
    !app.ui.route_transition_active && !app.ui.route_transition_pending
}

#program_export
main :: () -> s32 {
    // The renderer owns borrowed retained frames. Never delete them twice.
    Prepared(*app, false)
    app_route_transition_cancel(*app)
    if released != 0 || !Cleared(*app) { return 1 }

    // An independently captured frame is released while its context is valid.
    Prepared(*app, true)
    app_route_transition_cancel(*app)
    if released != 1 || wrong_texture || !Cleared(*app) { return 2 }

    // Old context names may now identify unrelated textures. Discard only.
    Prepared(*app, true)
    app_route_transition_cancel(*app, true)
    if released != 1 || !Cleared(*app) { return 3 }
    app_route_transition_cancel(*app)
    app_route_transition_cancel(null)
    if released != 1 { return 4 }

    // A second route must replace an in-flight animation, including its
    // owned texture, instead of ignoring the new navigation.
    Prepared(*app, true)
    app_route_transition_request(*app)
    if released != 2 || wrong_texture || app.ui.route_transition_active ||
    !app.ui.route_transition_pending || app.ui.route_transition_surface.texture.id != 0 {
        return 5
    }
    app_route_transition_capture(*app, Frame(), 1.0, false)
    if !app.ui.route_transition_active || app.ui.route_transition_pending {
        return 6
    }
    if app.ui.route_transition_surface.upright { return 8 }
    app_route_transition_request(*app)
    if released != 2 || app.ui.route_transition_active ||
    !app.ui.route_transition_pending {
        return 7
    }

    // The desktop host's snapshot of the previous screen is upright, and the
    // fade must draw it that way. Opening Habits' shop drew it flipped, which
    // the desktop raster rejects: the frame failed and the app quit.
    app_route_transition_capture(*app, Upright(), 2.0, true)
    if !app.ui.route_transition_active || !app.ui.route_transition_surface.upright {
        return 9
    }
    app_route_transition_advance(*app, 2.0 + cast(float64)APP_ROUTE_TRANSITION_SECONDS)
    if released != 3 || wrong_texture || !Cleared(*app) { return 11 }
    return 0
}
