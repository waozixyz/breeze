#import, file "../src/app/screenshot_arguments.zi";

#program_export
ScreenshotArgumentCount :: (argc: s32, argv: **u8) -> s32 {
    arguments: [128]string
    count := ScreenshotArguments(argc, argv, arguments[:])
    if count != 3 || arguments[2] != "frame.png" {
        return -1
    }
    return count
}
