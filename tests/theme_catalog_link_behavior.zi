#import, file "../src/app/theme_catalog.zi";

#program_export
Answer :: () -> s32 {
    if ThemeCount != 13 || ThemeDefaultId != 9 ||
    ThemeScopeFor(8, false) != "ink_light" ||
    ThemeScopeFor(9, true) != "default_dark" { return 1 }
    light := ThemeCatalogLoad(0, false)
    if !light.complete || light.background != cast(u32)0xE2EEFCFF ||
    light.circle != cast(u32)0x7EB7E6FF { return 2 }
    dark := ThemeCatalogLoad(0, true)
    if !dark.complete || dark.background != cast(u32)0x182838FF ||
    dark.link != cast(u32)0x60A0D0FF { return 3 }
    fallback := ThemeCatalogLoad(99, false)
    if !fallback.complete || fallback.background != cast(u32)0xC0C0C0FF {
        return 4
    }
    for id: 0..12 {
        if !ThemeCatalogLoad(cast(s32)id, false).complete ||
        !ThemeCatalogLoad(cast(s32)id, true).complete { return 6 }
    }
    if ThemeCatalogParse("", 0, false).complete { return 5 }
    clean_dark := ThemeCatalogLoad(ThemeDefaultId, true)
    clean_light := ThemeCatalogLoad(ThemeDefaultId, false)
    if clean_dark.background != cast(u32)0x14202bff ||
    clean_dark.button != cast(u32)0x99deb8ff ||
    clean_light.background != cast(u32)0xf5f8f6ff ||
    clean_light.button_ink != cast(u32)0x18352aff { return 7 }
    return 42
}
