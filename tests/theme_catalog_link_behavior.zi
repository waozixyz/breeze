#import, file "../src/app/theme_catalog.zi";
#import, file "../src/app/parent_theme.zi";

#program_export
Answer :: () -> s32 {
    if ThemeCount != 13 || ThemeDefaultId != 9 ||
    ThemeScopeFor(8, false) != "ink_light" ||
    ThemeScopeFor(9, true) != "default_dark" { return 1 }
    light := ThemeCatalogLoad(0, false)
    if !light.complete || light.background != cast(u32)0xE2EEFCFF ||
    light.circle != cast(u32)0x7EB7E6FF { return 2 }
    dark := ThemeCatalogLoad(0, true)
    if !dark.complete || dark.background != cast(u32)0x182838FF ||
    dark.link != cast(u32)0x60A0D0FF { return 3 }
    fallback := ThemeCatalogLoad(99, false)
    if !fallback.complete || fallback.background != cast(u32)0xC0C0C0FF {
        return 4
    }
    for id: 0..12 {
        if !ThemeCatalogLoad(cast(s32)id, false).complete ||
        !ThemeCatalogLoad(cast(s32)id, true).complete { return 6 }
    }
    if ThemeCatalogParse("", 0, false).complete { return 5 }
    clean_dark := ThemeCatalogLoad(ThemeDefaultId, true)
    clean_light := ThemeCatalogLoad(ThemeDefaultId, false)
    if clean_dark.background != cast(u32)0x14202bff ||
    clean_dark.button != cast(u32)0x99deb8ff ||
    clean_light.background != cast(u32)0xf5f8f6ff ||
    clean_light.button_ink != cast(u32)0x18352aff { return 7 }
    // Started on its own, Inbe has no host theme and keeps its own.
    if ParentThemeCurrent().active || ParentThemeRevision() != 0 { return 8 }
    if ThemeCatalogLoad(0, false).background != light.background { return 9 }
    // Embedded, a host's light or dark theme replaces the chosen one.
    host_dark: ParentTheme
    host_dark.active = true
    host_dark.dark = true
    host_dark.background = 0x101418ff
    host_dark.surface = 0x1a2026ff
    host_dark.text = 0xe8ecf0ff
    host_dark.accent = 0x6ab0f0ff
    host_dark.accent_hover = ParentThemeMix(0x6ab0f0ff, 0xe8ecf0ff, 0.12)
    embedded := ThemeCatalogFromParent(host_dark)
    if !embedded.complete || embedded.background != host_dark.background ||
    embedded.surface != host_dark.surface || embedded.text != host_dark.text ||
    embedded.button != host_dark.accent || embedded.circle != host_dark.accent ||
    embedded.link != host_dark.accent || embedded.icon != host_dark.text { return 10 }
    if embedded.button_hover != cast(u32)0x79b7f0ff { return 11 }
    host_light: ParentTheme
    host_light.active = true
    host_light.background = 0xfbf1e2ff
    host_light.surface = 0xe8dccaff
    host_light.text = 0x302820ff
    host_light.accent = 0x704020ff
    light_embedded := ThemeCatalogFromParent(host_light)
    if light_embedded.background != host_light.background ||
    light_embedded.text != host_light.text { return 12 }
    if ParentThemeSame(host_dark, host_light) || !ParentThemeSame(host_light, host_light) { return 13 }
    return 42
}
