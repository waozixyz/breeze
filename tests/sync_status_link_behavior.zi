#import, file "../src/storage/sync_status.zi";

#program_export
Answer :: () -> s32 {
    status: SyncStatus
    if !SyncStatusRead(*status) { return 1 }
    if status.has_account != 1 || status.enabled != 1 ||
       status.review_pending != 1 ||
       status.full_upload_done != 0 ||
       status.server_clock != 4294967297 ||
       status.queued_changes != 4294967298 { return 2 }
    return 42
}

#program_export
FailureClearsStatus :: () -> bool {
    status: SyncStatus
    status.queued_changes = 99
    if SyncStatusRead(*status) { return false }
    return status.queued_changes == 0 && status.has_account == 0
}
