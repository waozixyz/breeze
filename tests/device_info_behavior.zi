// Lumi reports name the device, system and version; never identifiers.
#import "c_string"
#import "byte_text_linux"
#import, file "../src/core/device_info.zi";
#import, file "../src/core/version.zi";

Fail :: (message: string) -> s32 { print("FAIL %\n", message); return 1 }

Check :: () -> s32 {
    if DeviceReleaseName("NAME=Debian\nPRETTY_NAME=\"Debian GNU/Linux 13 (trixie)\"\nID=debian\n") != "Debian GNU/Linux 13 (trixie)" { return Fail("os-release name") }
    if DeviceReleaseName("ID=arch\n") != "" { return Fail("missing os-release name") }
    if !DeviceStartsWithFold("Google Pixel 3a", "google") || DeviceStartsWithFold("Pixel", "Google") { return Fail("maker prefix") }
    details: DeviceDetails
    DeviceDescribe(*details)
    if DevicePlatform() != "linux" || DeviceSystem(*details).count == 0 { return Fail("desktop system") }
    for byte: DeviceModel(*details) { if byte < cast(u8)32 { return Fail("control byte in device") } }
    clipped: [8]u8
    size: s32 = 0
    DeviceAppend(clipped[:], *size, "a\nbcdefghijk")
    if TextFromBytes(clipped[:size]) != "abcdefg" { return Fail("bounded printable append") }
    print("device: % · % · %\n", DeviceModel(*details), DeviceSystem(*details), VersionString)
    return 0
}

Main :: () -> s32 { return Check() }
