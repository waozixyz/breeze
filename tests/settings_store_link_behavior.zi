#import, file "../src/app/settings_store.zi";
#import, file "../src/storage/temporary_data.zi";

#program_export
Answer :: () -> s32 {
    if !SettingsStoreInt("speed", 7) { return 1 }
    language: [3]u8 = .{122, 104, 0}
    if !SettingsStoreText("language", language[:]) { return 2 }
    if SettingsReadInt("sync_retry_attempt", 3) != 8 { return 3 }
    if SettingsReadInt("a_key_that_is_longer_than_forty_seven_bytes_and_invalid", 17) != 17 {
        return 4
    }
    return 42
}

// Temporary data (mini mode) accepts settings without writing them.
#program_export
TemporaryAnswer :: () -> s32 {
    DataSetTemporary(true)
    if !SettingsStoreInt("speed", 9) { return 1 }
    language: [3]u8 = .{100, 101, 0}
    if !SettingsStoreText("language", language[:]) { return 2 }
    DataSetTemporary(false)
    return 42
}
