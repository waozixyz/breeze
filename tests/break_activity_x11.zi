#import "idle_time"
#import, file "../src/breaks/break_types.zi";
#import, file "../src/breaks/break_activity.zi";
#import, file "../src/breaks/break_rules.zi";

engine: BreakEngine;
initialized: bool;
active: s32;

#program_export
Sample :: () -> s64 {
    if !initialized {
        initialized = true
        engine = BreakInit()
    }
    input: BreakActivityInput
    input.idle_ms = IdleMilliseconds()
    // This host has no focused app window and receives no local input events.
    sample := BreakSampleActivity(input, -10000)
    active = sample.active
    for tick: 0..BreakTicksPerSecond - 1 {
        engine = BreakTick(engine, active)
    }
    return input.idle_ms
}

#program_export
Activity :: () -> s32 { return active }
#program_export
MicroIdle :: () -> s32 { return engine.timers[BREAK_MICRO].idle_s }
#program_export
RestIdle :: () -> s32 { return engine.timers[BREAK_REST].idle_s }
