// Host functions the storage modules call that a test does not provide. It is
// built as a separate root so that no generated header declares them twice.

// The storage code logs through raylib's variadic TraceLog; the test drops
// the message and ignores the arguments.
#program_export "TraceLog"
host_trace_log :: (level: s32, format: *u8, arguments: *void) {
    unused level
    unused format
    unused arguments
}

#program_export "LoadFileData"
host_load_file_data :: (path: *u8, size: *s32) -> *u8 {
    unused path
    if size != null { size.* = 0 }
    return null
}

#program_export "UnloadFileData"
host_unload_file_data :: (data: *u8) {
    unused data
}

// Directory listing for legacy text sessions: there are none in a test root.
EmptyPaths :: struct {
    count: u32
    paths: **u8
}

#program_export "LoadDirectoryFilesEx"
host_load_directory_files :: (root: *u8, filter: *u8, recursive: bool) -> EmptyPaths {
    unused root
    unused filter
    unused recursive
    return EmptyPaths.{0, null}
}

#program_export "UnloadDirectoryFiles"
host_unload_directory_files :: (paths: EmptyPaths) {
    unused paths
}

#program_export "IsPathFile"
host_is_path_file :: (path: *u8) -> bool {
    unused path
    return false
}
