#import, file "../src/app/app_types.zi";
#import, file "../src/app/exercise_types.zi";
#import, file "../src/practices/session_results.zi";

using ExerciseType;

#program_export
Answer :: () -> s32 {
    app: InnerBreeze
    app.results_scroll = 81
    detail: [4]u8 = .{97, 98, 99, 0}
    path: [5]u8 = .{115, 97, 118, 101, 0}
    rounds: [14]s32
    index: s32 = 0
    while index < 14 {
        rounds[index] = index + 1
        index += 1
    }
    app_prepare_session_results(*app, EXERCISE_PATTERNS, 72, 3,
        *detail[0], *rounds[0], 14, *path[0])
    if app.session_result.active != 1 ||
        app.session_result.activity != EXERCISE_PATTERNS ||
        app.session_result.primary_value != 72 ||
        app.session_result.secondary_value != 3 ||
        app.session_result.round_count != 12 ||
        app.session_result.round_values[11] != 12 ||
        app.session_result.detail[2] != 99 ||
        app.session_result.saved != 1 ||
        app.session_result.path[3] != 101 ||
        app.results_scroll != 0 {
        return 1
    }
    app.session_result.write_failed = 1
    app_prepare_session_results(*app, 99, 0, 0, null, null, 0, null)
    if app.session_result.activity != EXERCISE_WIM_HOF ||
        app.session_result.saved != 0 ||
        app.session_result.write_failed != 0 ||
        app.session_result.round_count != 0 ||
        app.session_result.detail[0] != 0 ||
        app.session_result.path[0] != 0 {
        return 2
    }
    return 42
}
