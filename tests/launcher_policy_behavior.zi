#import, file "../src/app/launcher_policy.zi";
#import, file "../src/app/route_types.zi";
#import, file "../src/cells/catalog.zi";

using AppNavRoute;

#program_export
Answer :: () -> s32 {
    favorites: [LAUNCHER_APP_COUNT]s32
    // A new profile pins Lumi, Habits and Practice, in that order, on every
    // device; the other apps wait in More apps.
    if LauncherDefaults(favorites[:]) != 3 ||
    favorites[0] != APP_NAV_ROUTE_LUMI || favorites[1] != APP_NAV_ROUTE_HABITS ||
    favorites[2] != APP_NAV_ROUTE_PRACTICE {
        return 18
    }
    short: [2]s32
    if LauncherDefaults(short[:]) != 0 { return 19 }
    order: [LAUNCHER_ORDER_TEXT_MAX + 1]u8
    length := LauncherOrderText(favorites[:], 3, order[:])
    if length != 21 || TextView(order[:length]) != "lumi,habits,practices" || order[length] != cast(u8)0 {
        return 20
    }
    // Every app round-trips by name; unknown and repeated names drop out.
    read: [LAUNCHER_APP_COUNT]s32
    if LauncherOrderRoutes("diary,chess,lumi,,diary,leaderboard,lists", read[:]) != 4 ||
    read[0] != APP_NAV_ROUTE_DIARY || read[1] != APP_NAV_ROUTE_LUMI ||
    read[2] != APP_NAV_ROUTE_LEADERBOARD || read[3] != APP_NAV_ROUTE_ELIST {
        return 22
    }
    if LauncherOrderRoutes("", read[:]) != 0 || LauncherOrderText(read[:], 0, order[:]) != 0 ||
    order[0] != cast(u8)0 {
        return 23
    }
    // An app the node offers goes by its own name once a slot holds it;
    // empty slots have no name and stay out of the order.
    PackageSetNodeApp(0, "chess")
    every := LauncherRoutes()
    length = LauncherOrderText(every[:], cast(s32)every.count, order[:])
    if TextView(order[:length]) != "diary,habits,lists,lumi,practices,leaderboard,profile,chess" ||
    LauncherOrderRoutes(TextView(order[:length]), read[:]) != 8 {
        return 24
    }
    for index: cast(s32)0..7 {
        if read[index] != every[index] { return 25 }
    }
    PackageSetNodeApp(0, "")
    if LauncherOrderRoutes("settings,profile,lumi", read[:]) != 2 ||
    read[0] != APP_NAV_ROUTE_PROFILE || read[1] != APP_NAV_ROUTE_LUMI { return 28 }
    if LauncherOrderRoutes("chess,lumi", read[:]) != 1 || read[0] != APP_NAV_ROUTE_LUMI { return 27 }
    // A full buffer keeps whole names only.
    tiny: [12]u8
    length = LauncherOrderText(favorites[:], 3, tiny[:])
    if length != 11 || TextView(tiny[:length]) != "lumi,habits" { return 26 }
    favorites[0] = APP_NAV_ROUTE_HABITS
    favorites[1] = APP_NAV_ROUTE_PRACTICE
    count := LauncherToggleFavorite(favorites[:], 2, APP_NAV_ROUTE_DIARY)
    if count != 3 || favorites[0] != APP_NAV_ROUTE_HABITS ||
    favorites[2] != APP_NAV_ROUTE_DIARY { return 1 }
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_ELIST)
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_LUMI)
    if count != 5 || LauncherSanitizeFavorites(favorites[:], count) != count {
        return 2
    }
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_HABITS)
    if count != 4 || favorites[0] != APP_NAV_ROUTE_PRACTICE ||
    favorites[3] != APP_NAV_ROUTE_LUMI { return 3 }
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_SETTINGS)
    if count != 4 { return 4 }
    favorites[0] = APP_NAV_ROUTE_LUMI
    favorites[1] = APP_NAV_ROUTE_LUMI
    if LauncherSanitizeFavorites(favorites[:], 2) != 1 { return 5 }
    favorites[0] = 999
    favorites[1] = APP_NAV_ROUTE_PROFILE
    if LauncherSanitizeFavorites(favorites[:], 2) != 1 || favorites[0] != APP_NAV_ROUTE_PROFILE { return 6 }
    if !LauncherMatches("Practice", "ACT") || LauncherMatches("Practice", "Diary") { return 7 }
    if !LauncherMatches("ÚKOLY", "úkol") || !LauncherMatches("ПРИВЫЧКИ", "прив") { return 8 }
    if !LauncherMatches("日記", "記") || !LauncherMatches("습관", "관") { return 9 }
    if !LauncherMatches("", "") || LauncherMatches("", "apps") { return 10 }
    favorites[0] = APP_NAV_ROUTE_DIARY
    favorites[1] = APP_NAV_ROUTE_LUMI
    count = LauncherToggleFavorite(favorites[:], 2, APP_NAV_ROUTE_LUMI)
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_DIARY)
    if count != 0 || LauncherSanitizeFavorites(favorites[:], 0) != 0 { return 11 }
    routes := LauncherRoutes()
    for index: cast(s32)0..cast(s32)routes.count - 1 {
        count = LauncherToggleFavorite(favorites[:], count, routes[index])
    }
    if count != cast(s32)routes.count ||
    LauncherSanitizeFavorites(favorites[:], 999) != count { return 12 }
    count = LauncherPlaceFavorite(favorites[:], count, APP_NAV_ROUTE_PRACTICE, 0)
    if count != LAUNCHER_APP_COUNT || favorites[0] != APP_NAV_ROUTE_PRACTICE ||
    favorites[1] != APP_NAV_ROUTE_DIARY { return 13 }
    count = LauncherPlaceFavorite(favorites[:], count, APP_NAV_ROUTE_PRACTICE, count)
    if count != LAUNCHER_APP_COUNT || favorites[count - 1] != APP_NAV_ROUTE_PRACTICE ||
    favorites[0] != APP_NAV_ROUTE_DIARY { return 14 }
    // Leaderboard is listed after the apps that existed before it, and the
    // slots of the apps the node offers after the bundled apps.
    if LauncherRoutes()[5] != APP_NAV_ROUTE_LEADERBOARD || LauncherRoutes()[6] != APP_NAV_ROUTE_PROFILE || LauncherRoutes()[7] != AppNavNodeRoute(0) ||
    LauncherRoutes()[LAUNCHER_APP_COUNT - 1] != AppNavNodeRoute(7) { return 21 }
    count = LauncherToggleFavorite(favorites[:], count, APP_NAV_ROUTE_HABITS)
    count = LauncherPlaceFavorite(favorites[:], count, APP_NAV_ROUTE_HABITS, 1)
    if count != LAUNCHER_APP_COUNT || favorites[1] != APP_NAV_ROUTE_HABITS ||
    favorites[2] != APP_NAV_ROUTE_ELIST { return 15 }
    count = LauncherPlaceFavorite(favorites[:], count, APP_NAV_ROUTE_SETTINGS, 0)
    count = LauncherPlaceFavorite(favorites[:], count, APP_NAV_ROUTE_HABITS, -1)
    if count != LAUNCHER_APP_COUNT || favorites[0] == APP_NAV_ROUTE_SETTINGS { return 16 }
    count = LauncherPlaceFavorite(favorites[:], 0, APP_NAV_ROUTE_LUMI, 0)
    if count != 1 || favorites[0] != APP_NAV_ROUTE_LUMI { return 17 }
    return 42
}
