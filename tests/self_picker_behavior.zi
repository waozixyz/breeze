// A rejected account request must not leave its document for the next owner.
#import, file "../src/app/self_management.zi";
Provider :: #import "self/native_management";
#import "self/management"
#import, file "../src/platform/android/android_import.zi";
#import "android_picker"
#import "std/file"
#import "std/c_string"

#program_export
Check :: () -> s32 {
    path := "/tmp/inbe-self-picker-test/stale.key"
    if !CreatePrivateDirectory("/tmp/inbe-self-picker-test") || !WriteEntireFile(path, "fixture: stale account key") { return 1 }
    self_management_picker = true
    self_management.queue.pending = false
    PickerStore(cast(s32)AndroidImportKind.ANDROID_IMPORT_KIND_SYNC_KEY, 0, null)
    InbeManagementDiscardPicker()
    if !self_management_picker || !self_management_picker_abandoned { return 2 }
    // A new request cannot turn the abandoned document into its own result.
    self_management.queue.pending = true
    bytes: [128]u8
    if !CopyCString(path, bytes[:]) { return 3 }
    PickerStore(cast(s32)AndroidImportKind.ANDROID_IMPORT_KIND_SYNC_KEY, 1, *bytes[0])
    InbeManagementDiscardPicker()
    if self_management_picker || self_management_picker_abandoned || PathExists(path) { return 4 }
    selected: [128]u8
    if AndroidPickerPoll(cast(s32)AndroidImportKind.ANDROID_IMPORT_KIND_SYNC_KEY, selected[:]) != .AndroidPickerNone { return 5 }
    self_management_picker = true
    self_management.queue.pending = false
    PickerStore(cast(s32)AndroidImportKind.ANDROID_IMPORT_KIND_SYNC_KEY, 2, null)
    InbeManagementDiscardPicker()
    if self_management_picker || self_management_picker_abandoned { return 6 }
    return 0
}
