#import, file "../src/practices/sun_salutation/sun_salutation_rules.zi";

#program_export
Answer :: () -> s32 {
    state: SunSalutationPracticeState
    state.repetitions = 99
    state.start_seconds = 1
    state.end_seconds = 99
    state = SalutationInit(state)
    if state.repetitions != 3 || state.start_seconds != 6 ||
    state.end_seconds != 4 {
        return 1
    }

    state.repetitions = 1
    state.start_seconds = 2
    state.end_seconds = 13
    state = SalutationNormalizeSettings(state)
    if state.repetitions != 2 || state.start_seconds != 3 ||
    state.end_seconds != 3 {
        return 2
    }

    state.repetitions = 3
    state.start_seconds = 8
    state.end_seconds = 5
    state.step = 5
    state.repetition = 2
    state.step_ticks = 15
    state = SalutationStart(state)
    if state.step != 0 || state.repetition != 0 ||
    state.step_ticks != 0 ||
    SalutationStepSeconds(state) != 8 {
        return 3
    }
    state.repetition = 1
    if SalutationStepSeconds(state) != 7 {
        return 4
    }
    state.repetition = 2
    if SalutationStepSeconds(state) != 5 {
        return 5
    }

    // A round ends in Mountain pose, so the next one starts with the
    // upward salute rather than standing there again.
    state.step = SUN_SALUTATION_STEP_COUNT - 1
    state.repetition = 0
    next: SalutationStepResult = SalutationForward(state)
    if next.completed != 0 || next.state.step != SUN_SALUTATION_REPEAT_STEP ||
    next.state.repetition != 1 || next.state.step_ticks != 0 {
        return 6
    }
    state = SalutationBack(next.state)
    if state.step != SUN_SALUTATION_STEP_COUNT - 1 ||
    state.repetition != 0 {
        return 7
    }
    state.repetition = 2
    next = SalutationForward(state)
    if next.completed != 1 {
        return 8
    }

    state = SalutationReset(state)
    if state.step != 0 || state.repetition != 0 ||
    state.step_ticks != 0 || state.start_seconds != 8 {
        return 9
    }
    tick: s32 = 0
    while tick < 480 {
        next = SalutationAdvance(state, 1.0 / 60.0)
        state = next.state
        tick += 1
    }
    if state.step != 1 || state.step_ticks != 0 ||
    next.completed != 0 {
        return 10
    }

    // Equal wall time must produce the same pose at slow and fast frame rates.
    rates: [5]s32 = .[15, 30, 60, 90, 120]
    for rate: rates {
        state = SalutationStart(state)
        for frame: 0..rate * 3 - 1 {
            unused frame
            state = SalutationAdvance(state, 1.0 / cast(float64)rate).state
        }
        if state.step_ticks != 180 {
            return 15
        }
    }
    // A slow render can cross step boundaries without discarding time.
    state = SalutationStart(state)
    next = SalutationAdvance(state, 17.25)
    if next.completed != 0 || next.state.step != 2 || next.state.step_ticks != 75 {
        return 16
    }
    state = SalutationBack(next.state)
    state.tick_fraction = 0.5
    state = SalutationForward(state).state
    if state.tick_fraction != 0.0 || SalutationReset(state).tick_fraction != 0.0 ||
    SalutationStart(state).tick_fraction != 0.0 {
        return 17
    }
    next = SalutationAdvance(state, 2000.0)
    if next.completed != 1 {
        return 18
    }

    // A breath of 8 s with 24 move frames and 4 hold frames at 8 fps: the
    // move takes at most 4 s, from the previous pose (-1) to the last move
    // frame, then the hold frames follow and the last one stays.
    if SalutationFrameAt(0, 480, 28, 24, 8) != -1 ||
    SalutationFrameAt(60, 480, 28, 24, 8) != 5 ||
    SalutationFrameAt(120, 480, 28, 24, 8) != 11 ||
    SalutationFrameAt(239, 480, 28, 24, 8) != 22 ||
    SalutationFrameAt(240, 480, 28, 24, 8) != 23 ||
    SalutationFrameAt(255, 480, 28, 24, 8) != 25 ||
    SalutationFrameAt(1000, 480, 28, 24, 8) != 27 {
        return 11
    }
    // A 4 s breath moves through its first three quarters; the first pose
    // is one frame.
    if SalutationFrameAt(90, 240, 28, 24, 8) != 11 ||
    SalutationFrameAt(180, 240, 28, 24, 8) != 23 ||
    SalutationFrameAt(30, 480, 1, 24, 8) != 0 {
        return 13
    }
    // At 30 fps the full move has 90 distinct frames, followed by 15
    // settling frames. Short breaths still keep a quarter for settling.
    if SalutationFrameAt(0, 480, 105, 90, 30) != -1 ||
    SalutationFrameAt(3, 480, 105, 90, 30) != 0 ||
    SalutationFrameAt(120, 480, 105, 90, 30) != 44 ||
    SalutationFrameAt(240, 480, 105, 90, 30) != 89 ||
    SalutationFrameAt(242, 480, 105, 90, 30) != 90 ||
    SalutationFrameAt(1000, 480, 105, 90, 30) != 104 ||
    SalutationFrameAt(45, 180, 105, 90, 30) != 29 {
        return 14
    }

    state.step = 99
    state.repetition = 99
    state = SalutationNormalizeDraw(state)
    if state.step != SUN_SALUTATION_STEP_COUNT - 1 ||
    state.repetition != state.repetitions - 1 {
        return 12
    }
    // Changing session position or restarting must retain the selected person.
    for character: 0..SUN_SALUTATION_CHARACTER_COUNT - 1 {
        state.character = cast(s32)character
        state = SalutationStart(state)
        state = SalutationAdvance(state, 17.25).state
        state = SalutationForward(state).state
        state = SalutationBack(state)
        state = SalutationReset(state)
        if state.character != cast(s32)character {
            return 19
        }
    }
    // Old settings default to the first woman; invalid imported choices
    // cannot index outside the two shipped characters.
    initial: SunSalutationPracticeState
    if SalutationInit(initial).character != 0 {
        return 20
    }
    state.character = -1
    if SalutationNormalizeSettings(state).character != 0 {
        return 21
    }
    state.character = 99
    if SalutationInit(state).character != SUN_SALUTATION_CHARACTER_COUNT - 1 ||
    SalutationStart(state).character != SUN_SALUTATION_CHARACTER_COUNT - 1 ||
    SalutationNormalizeDraw(state).character != SUN_SALUTATION_CHARACTER_COUNT - 1 {
        return 22
    }
    // Bound hairstyles settle at the end of the 90-frame move.
    if SalutationFrameAt(240, 480, 90, 90, 30) != 89 ||
    SalutationFrameAt(1000, 480, 90, 90, 30) != 89 {
        return 23
    }

    // Plank takes two breaths: out to step back into it, in to hold it.
    breathing: SunSalutationPracticeState
    breathing.repetitions = 3
    breathing.start_seconds = 6
    breathing.end_seconds = 4
    breathing = SalutationStart(breathing)
    breathing.step = SUN_SALUTATION_PLANK_STEP
    if SalutationStepSeconds(breathing) != 12 || SalutationBreathSeconds(breathing) != 6 {
        return 24
    }
    breathing.step_ticks = 90
    breath := SalutationBreathAt(breathing)
    if breath.direction != SUN_SALUTATION_BREATH_OUT || breath.progress != 250 {
        return 25
    }
    breathing.step_ticks = 540
    breath = SalutationBreathAt(breathing)
    if breath.direction != SUN_SALUTATION_BREATH_IN || breath.progress != 500 {
        return 26
    }
    // The move into plank happens on its first breath.
    if SalutationFrameAt(240, 360, 105, 90, 30) != 89 {
        return 27
    }

    // Through a whole session the breath turns from out to in and back on
    // every breath, starting with a breath out in Mountain pose, and only
    // the first round stands in Mountain pose before it rises.
    breathing = SalutationStart(breathing)
    expected: s32 = SUN_SALUTATION_BREATH_OUT
    breaths: s32 = 0
    mountains: s32 = 0
    finished := false
    while !finished && breaths < 100 {
        seconds := SalutationBreathSeconds(breathing)
        for breath_index: 0..SalutationStepBreaths(breathing.step) - 1 {
            breathing.step_ticks = cast(s32)breath_index * seconds * 60 + seconds * 30
            if SalutationBreathAt(breathing).direction != expected {
                return 28
            }
            expected = 1 - expected
            breaths += 1
        }
        if breathing.step == 0 {
            mountains += 1
        }
        next = SalutationForward(breathing)
        breathing = next.state
        finished = next.completed != 0
    }
    // 13 breaths in the first round, 12 in each of the other two.
    if !finished || breaths != 37 || mountains != 1 {
        return 29
    }
    // Going back from the first step of a later round returns to the
    // previous round's Mountain pose; drawing never shows a skipped step.
    breathing = SalutationStart(breathing)
    breathing.repetition = 1
    breathing.step = SUN_SALUTATION_REPEAT_STEP
    breathing = SalutationBack(breathing)
    if breathing.repetition != 0 || breathing.step != SUN_SALUTATION_STEP_COUNT - 1 {
        return 30
    }
    breathing.repetition = 1
    breathing.step = 0
    if SalutationNormalizeDraw(breathing).step != SUN_SALUTATION_REPEAT_STEP {
        return 31
    }
    // Narration follows the character until a voice is chosen.
    if SalutationMaleVoice(-1, 0) || !SalutationMaleVoice(-1, 1) ||
    SalutationMaleVoice(0, 1) || !SalutationMaleVoice(1, 0) {
        return 32
    }
    // The classic sequence switches legs each round.
    breathing.repetition = 0
    if SalutationOtherSide(breathing) {
        return 33
    }
    breathing.repetition = 1
    if !SalutationOtherSide(breathing) {
        return 34
    }
    breathing.repetition = 2
    if SalutationOtherSide(breathing) {
        return 35
    }
    return 42
}
