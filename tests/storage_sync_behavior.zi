// A device whose records arrived in an older app version, which kept only
// the fields it knew, downloads every record again once after updating.
test_older_records_download_again_once :: () {
    root := make_root("sync-record-fields")
    check_true("init db", storage_init(root) != 0)
    set_account()
    storage_close()
    raw_exec(root, "INSERT OR REPLACE INTO meta(key,value) VALUES('sync_last_server_version','530');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_full_upload_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_backfill_v2_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_habit_name_repair_v1_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_zero_habit_day_repair_v1_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_record_fields','1');")
    check_true("reopen db", storage_init(root) != 0)
    check_true("payload builds", build_payload())
    check_true("older records are downloaded again", contains(payload(), "\"since_server_version\":0"))
    check_true("apply the full download", storage_apply_sync_response_json(empty_response(530)) != 0)
    check_true("payload builds again", build_payload())
    check_true("the full download runs once", contains(payload(), "\"since_server_version\":530"))
    storage_close()
}

// An updated device downloads every record before it sends its changes, so
// a record it got without some fields never goes out without them.
test_updated_device_downloads_before_sending :: () {
    root := make_root("sync-download-first")
    check_true("init db", storage_init(root) != 0)
    set_account()
    local: Habits
    check_true("add habit", habits_add_custom(*local, "Read", Green(), 0, 0) == 0)
    habits_save(*local)
    habits_free(*local)
    storage_close()
    raw_exec(root, "INSERT OR REPLACE INTO meta(key,value) VALUES('sync_last_server_version','530');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_full_upload_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_backfill_v2_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_habit_name_repair_v1_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_zero_habit_day_repair_v1_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_record_fields','1');")
    check_true("reopen db", storage_init(root) != 0)
    check_true("payload builds", build_payload())
    check_true("the download comes first", contains(payload(), "\"since_server_version\":0"))
    check_int("nothing is sent before the download", record_count(), 0)
    check_true("apply the download", storage_apply_sync_response_json(empty_response(530)) != 0)
    check_true("payload builds again", build_payload())
    check_true("the change goes out after it", record_count() > 0)
    storage_close()
}

// A habit an older version received without some settings gets them from
// the account's record during the download, even where it looks newer.
test_updated_device_fills_missing_settings :: () {
    first := make_root("sync-fill-a")
    second := make_root("sync-fill-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    source: Habits
    check_true("add habit", habits_add_custom(*source, "Cold Shower", Green(), 0, 0) == 0)
    source.items[0].icon = 17
    weekly: HabitSchedule
    weekly.repeat = HABIT_REPEAT_WEEKLY
    weekly.weekdays = 1 + 4 + 8
    check_true("weekly schedule", HabitScheduleSet(*source.items[0], weekly, 20260620, false))
    habits_save(*source)
    habits_free(*source)
    check_true("device a payload", build_payload())
    records := records_array()
    storage_close()

    check_true("init device b", storage_init(second) != 0)
    set_account()
    check_true("device b applies", storage_apply_sync_response_json(response_with(5, records)) != 0)
    storage_close()
    // As an older version kept it: without the icon or schedule, and edited
    // later, so the account's record looks older.
    raw_exec(second, "UPDATE habits SET icon=0,schedule='',updated_at=4102444800 WHERE name='Cold Shower';INSERT OR REPLACE INTO meta(key,value) VALUES('sync_record_fields','1');")
    check_true("reopen device b", storage_init(second) != 0)
    check_true("device b downloads again", storage_apply_sync_response_json(response_with(6, records)) != 0)
    filled: Habits
    check_true("device b loads", storage_habits_load(cast(*void)*filled) != 0)
    habit := find_habit(*filled, "Cold Shower")
    check_true("device b has the habit", habit != null)
    check_int("the icon is filled", habit.icon, 17)
    check_true("the schedule is filled", habit.schedule_count > 0)
    if habit.schedule_count > 0 {
        check_int("the weekly days are back", habit.schedules[habit.schedule_count - 1].weekdays, 13)
    }
    habits_free(*filled)
    storage_close()
}

// A record's fields this version doesn't read, such as ones a newer version
// added, go back out with it under this version's own changes, so an older
// version never removes them for the account's other devices.
test_unknown_record_fields_go_back_out :: () {
    first := make_root("sync-fields-a")
    second := make_root("sync-fields-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0) == 0)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("device a payload", build_payload())
    records := records_array()
    storage_close()

    check_true("init device b", storage_init(second) != 0)
    set_account()
    check_true("device b applies", storage_apply_sync_response_json(response_with(5, records)) != 0)
    storage_close()
    check_int("device b keeps the record as it arrived",
        raw_count(second, "SELECT COUNT(*) FROM sync_record_copies WHERE collection='private.inbe.v1.habits'"), 1)
    // A field from a newer version that this one doesn't read.
    raw_exec(second, "UPDATE sync_record_copies SET json=json_set(json,'$.future_field','kept') WHERE collection='private.inbe.v1.habits'")
    check_true("reopen device b", storage_init(second) != 0)
    habits_b = Habits.{}
    check_true("device b loads", storage_habits_load(cast(*void)*habits_b) != 0)
    habits_b.items[0].icon = 23
    habits_save(*habits_b)
    habits_free(*habits_b)
    check_true("device b payload", build_payload())
    storage_close()
    check_int("the change goes out with the field it doesn't know",
        raw_count(second, "SELECT COUNT(*) FROM sync_record_copies WHERE collection='private.inbe.v1.habits' AND json_extract(json,'$.future_field')='kept' AND json_extract(json,'$.icon')=23"), 1)
}

// Device A's records applied on device B come out as the same habits.
test_records_round_trip_between_devices :: () {
    first := make_root("sync-device-a")
    second := make_root("sync-device-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0) == 0)
    habit_set_day_count(*habits_a, 0, 20260618, 3)
    habits_a.items[0].icon = 17
    // A schedule changed after the recorded day, then a formula.
    weekly: HabitSchedule
    weekly.repeat = HABIT_REPEAT_WEEKLY
    weekly.weekdays = 1 + 4 + 8
    check_true("weekly schedule", HabitScheduleSet(*habits_a.items[0], weekly, 20260620, false))
    formula: HabitSchedule
    formula.repeat = HABIT_REPEAT_FORMULA
    check_true("formula fits", HabitScheduleSetFormula(*formula, "days % 3 = 0 and weekday < 6"))
    check_true("formula schedule", HabitScheduleSet(*habits_a.items[0], formula, 20260625, false))
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("device a payload", build_payload())
    check_true("device a has records", record_count() > 0)
    records := records_array()
    storage_close()

    check_true("init device b", storage_init(second) != 0)
    set_account()
    check_true("device b applies", storage_apply_sync_response_json(response_with(5, records)) != 0)
    habits_b = Habits.{}
    check_true("device b loads", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("device b habit count", habits_b.count, 1)
    habit := find_habit(*habits_b, "Cold Shower")
    check_true("device b has the habit", habit != null)
    check_int("device b day count", day_count_of(habit, 20260618), 3)
    check_int("device b has the habit's icon", habit.icon, 17)
    check_int("device b has every schedule", habit.schedule_count, 3)
    check_int("the weekly schedule starts on its day", habit.schedules[1].from, 20260620)
    check_int("the weekly schedule's days", habit.schedules[1].weekdays, 13)
    check_true("the formula arrives whole",
        HabitScheduleFormulaText(*habit.schedules[2]) == "days % 3 = 0 and weekday < 6")
    check_int("the recorded day keeps its schedule", habit_scheduled_day(habit, 20260618), 1)
    check_int("an off day under the weekly schedule", habit_scheduled_day(habit, 20260623), 0)
    habits_free(*habits_b)
    storage_close()
}

// Sends device A's queued changes to device B and clears A's queue.
ship_to :: (from_root: string, to_root: string, version: s32) -> bool {
    if storage_init(from_root) == 0 { return false }
    if !build_payload() {
        storage_close()
        return false
    }
    records := records_array()
    copy: TextBuffer
    append(*copy, records)
    check_true("clear queue after upload", storage_apply_sync_response_json(empty_response(version)) != 0)
    storage_close()
    if storage_init(to_root) == 0 { return false }
    ok: bool = storage_apply_sync_response_json(response_with(version, TextFromCString(*copy.bytes[0]))) != 0
    storage_close()
    return ok
}

test_deletion_round_trip :: () {
    first := make_root("sync-delete-a")
    second := make_root("sync-delete-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0) == 0)
    habit_set_day_count(*habits_a, 0, 20260618, 3)
    habits_save(*habits_a)
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship habit", ship_to(first, second, 1))
    check_true("reopen device b", storage_init(second) != 0)
    check_int("device b has the habit", storage_habit_count(), 1)
    storage_close()

    check_true("reopen device a", storage_init(first) != 0)
    habits_a = Habits.{}
    check_true("load device a", storage_habits_load(cast(*void)*habits_a) != 0)
    habits_delete(*habits_a, 0)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("deletion payload builds", build_payload())
    check_true("deletion is marked", contains(payload(), "\"deleted_at\":"))
    storage_close()
    check_true("ship deletion", ship_to(first, second, 2))
    check_true("reopen device b after deletion", storage_init(second) != 0)
    check_int("device b lost the habit", storage_habit_count(), 0)
    storage_close()
}

// A newer remote count replaces the local one, in both directions, and a
// queued local edit at the same time is not overwritten.
test_counter_counts_apply :: () {
    first := make_root("sync-counter-a")
    second := make_root("sync-counter-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Counter", Green(), 0, 0) == 0)
    habit_set_day_count(*habits_a, 0, 20260619, 4)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship habit", ship_to(first, second, 1))
    // Both devices now agree on 4. Pin the times so ordering is explicit.
    raw_exec(first, "UPDATE habit_days SET count=1,updated_at=1781902900;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781902900 FROM habit_days;")
    raw_exec(second, "UPDATE habit_days SET updated_at=1781902800;DELETE FROM sync_outbox;")
    check_true("ship lower newer count", ship_to(first, second, 2))
    check_int("newer lower count applied", raw_count(second, "SELECT count FROM habit_days WHERE local_date=20260619"), 1)

    raw_exec(first, "UPDATE habit_days SET count=5,updated_at=1781903000;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781903000 FROM habit_days;")
    check_true("ship higher newer count", ship_to(first, second, 3))
    check_int("newer higher count applied", raw_count(second, "SELECT count FROM habit_days WHERE local_date=20260619"), 5)

    // An older remote value must lose to a newer local one.
    raw_exec(first, "UPDATE habit_days SET count=2,updated_at=1781902000;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781902000 FROM habit_days;")
    check_true("ship older count", ship_to(first, second, 4))
    check_int("older remote count ignored", raw_count(second, "SELECT count FROM habit_days WHERE local_date=20260619"), 5)
}

// A queued local edit wins over an equal-time remote copy of the same day.
test_queued_edit_beats_equal_time_remote :: () {
    first := make_root("sync-equal-a")
    second := make_root("sync-equal-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Counter", Green(), 0, 0) == 0)
    habit_set_day_count(*habits_a, 0, 20260619, 4)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship habit", ship_to(first, second, 1))
    raw_exec(first, "UPDATE habit_days SET count=1,updated_at=1781902800;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781902800 FROM habit_days;")
    raw_exec(second, "UPDATE habit_days SET count=9,updated_at=1781902800;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781902800 FROM habit_days;")
    check_true("ship equal-time count", ship_to(first, second, 2))
    check_int("queued local edit kept", raw_count(second, "SELECT count FROM habit_days WHERE local_date=20260619"), 9)
}

// Two devices that already share `habit` (a habit named "Counter" with one
// day), each in its own root. Returns to the caller with neither open.
share_counter_habit :: (first: string, second: string) {
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Counter", Green(), 0, 0) == 0)
    habit_set_day_count(*habits_a, 0, 20260619, 4)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship habit", ship_to(first, second, 1))
}

test_counter_enabled_follows_remote :: () {
    first := make_root("sync-toggle-a")
    second := make_root("sync-toggle-b")
    share_counter_habit(first, second)
    raw_exec(first, "UPDATE habits SET counter_enabled=1,updated_at=1781903000;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1781903000 FROM habits;")
    raw_exec(second, "UPDATE habits SET counter_enabled=0,updated_at=1781902800;DELETE FROM sync_outbox;")
    check_true("ship enable", ship_to(first, second, 2))
    check_int("remote enables the counter", raw_count(second, "SELECT counter_enabled FROM habits"), 1)
    raw_exec(first, "UPDATE habits SET counter_enabled=0,updated_at=1781903100;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1781903100 FROM habits;")
    check_true("ship disable", ship_to(first, second, 3))
    check_int("remote disables the counter", raw_count(second, "SELECT counter_enabled FROM habits"), 0)
}

test_queued_counter_enabled_survives_equal_remote :: () {
    first := make_root("sync-queued-toggle-a")
    second := make_root("sync-queued-toggle-b")
    share_counter_habit(first, second)
    raw_exec(first, "UPDATE habits SET counter_enabled=0,updated_at=1781902800;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1781902800 FROM habits;")
    raw_exec(second, "UPDATE habits SET counter_enabled=1,updated_at=1781902800;DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1781902800 FROM habits;")
    check_true("ship equal-time habit", ship_to(first, second, 2))
    check_int("queued local counter setting kept", raw_count(second, "SELECT counter_enabled FROM habits"), 1)
    check_true("reopen device b", storage_init(second) != 0)
    check_true("still queued for upload", build_payload() && record_count() > 0)
    storage_close()
}

test_stale_habit_save_keeps_remote_habits :: () {
    first := make_root("sync-stale-a")
    second := make_root("sync-stale-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    check_true("add push ups", habits_add_custom(*habits_a, "Push ups", Green(), 0, 0) == 0)
    check_true("add cold shower", habits_add_custom(*habits_a, "Cold Shower", Green(), 0, 0) == 1)
    habit_set_day(*habits_a, 0, 20260619, 1)
    habit_set_day(*habits_a, 1, 20260619, 1)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("device a payload", build_payload())
    records := records_array()
    kept: TextBuffer
    append(*kept, records)
    storage_close()

    check_true("init device b", storage_init(second) != 0)
    set_account()
    // Device b's screen holds only the default habits.
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    check_true("apply remote habits behind the stale screen",
        storage_apply_sync_response_json(response_with(1, TextFromCString(*kept.bytes[0]))) != 0)
    habits_save(*habits_a)
    habits_b = Habits.{}
    check_true("load habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("stale save keeps the remote habits", habits_b.count, 5)
    check_true("push ups survived", find_habit(*habits_b, "Push ups") != null)
    check_true("cold shower survived", find_habit(*habits_b, "Cold Shower") != null)
    check_true("default yoga survived", find_habit(*habits_b, "Yoga") != null)
    check_true("default exercise survived", find_habit(*habits_b, "Exercise") != null)
    habits_free(*habits_a)
    habits_free(*habits_b)
    storage_close()
}

test_duplicate_named_habits_merge :: () {
    first := make_root("sync-merge-a")
    second := make_root("sync-merge-b")
    check_true("init device a", storage_init(first) != 0)
    set_account()
    storage_close()
    raw_exec(first, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('habit-1',(SELECT id FROM users LIMIT 1),'New Habit',99,196,165,0,0,0,0,0,1781902800),('habit-2',(SELECT id FROM users LIMIT 1),'New Habit',99,196,165,0,0,0,1,0,1781902860),('meditation',(SELECT id FROM users LIMIT 1),'Meditation',126,183,230,1,3,0,2,0,1781902920);INSERT INTO habit_days(habit_id,local_date,completed,count,updated_at) VALUES('habit-1',20260617,1,1,1781902800),('habit-2',20260618,1,1,1781902860),('meditation',20260619,1,1,1781902920);DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1781902800 FROM habits;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1781902800 FROM habit_days;")
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship duplicates", ship_to(first, second, 1))
    check_true("reopen device b", storage_init(second) != 0)
    habits_b = Habits.{}
    check_true("load merged habits", storage_habits_load(cast(*void)*habits_b) != 0)
    check_int("duplicate habit names collapse to one", habits_b.count, 2)
    merged := find_habit(*habits_b, "New Habit")
    check_true("merged habit visible", merged != null)
    check_true("first duplicate day kept", merged != null && habit_completed_day(merged, 20260617) != 0)
    check_true("second duplicate day moved", merged != null && habit_completed_day(merged, 20260618) != 0)
    check_true("meditation remains", find_habit(*habits_b, "Meditation") != null)
    habits_free(*habits_b)
    storage_close()
}

test_session_last_write_wins :: () {
    first := make_root("sync-session-a")
    second := make_root("sync-session-b")
    session_sql: string = "INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('session-equal-time',(SELECT id FROM users LIMIT 1),1781902800,20260619,0,1,'local',1781902800,'111',0,1781902800);"
    check_true("init device a", storage_init(first) != 0)
    set_account()
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    raw_exec(first, session_sql)
    raw_exec(first, "INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('session-equal-time',0,45);DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('session','session-equal-time',0,1781902800);")
    raw_exec(second, session_sql)
    raw_exec(second, "INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('session-equal-time',0,60);DELETE FROM sync_outbox;")
    check_true("ship equal-time session", ship_to(first, second, 1))
    check_int("equal-time remote update replaces rounds",
        raw_count(second, "SELECT seconds FROM session_rounds WHERE session_id='session-equal-time' AND round_index=0"), 45)
    // The same again with a queued local edit: it keeps its own rounds.
    raw_exec(second, "UPDATE sessions SET rounds_hash='111',updated_at=1781902800;DELETE FROM session_rounds WHERE session_id='session-equal-time';INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('session-equal-time',0,60);INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('session','session-equal-time',0,1781902800);")
    raw_exec(first, "DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('session','session-equal-time',0,1781902800);")
    check_true("ship equal-time session again", ship_to(first, second, 2))
    check_int("queued local rounds are kept",
        raw_count(second, "SELECT seconds FROM session_rounds WHERE session_id='session-equal-time' AND round_index=0"), 60)
}

test_linked_session_delete_syncs :: () {
    first := make_root("sync-linked-a")
    second := make_root("sync-linked-b")
    rounds: [1]s32 = .[60]
    id: [44]u8
    today := habits_today_index()
    check_true("init device a", storage_init(first) != 0)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_save(*habits_a)
    check_true("save linked session", storage_save_session_for_activity(*rounds[0], 1, 0, 1, *id[0], 44) != 0)
    habits_free(*habits_a)
    storage_close()
    check_true("init device b", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("ship linked session and habit day", ship_to(first, second, 1))
    check_int("device b has the session", raw_count(second, "SELECT COUNT(*) FROM sessions WHERE deleted_at=0"), 1)
    check_int("device b has the linked day", raw_count(second, "SELECT COUNT(*) FROM habit_days WHERE count>0"), 1)

    check_true("reopen device a", storage_init(first) != 0)
    check_true("delete the linked session", storage_delete_session(TextFromCString(*id[0])) != 0)
    check_true("deletion payload builds", build_payload())
    check_true("session tombstone uploaded", contains(payload(), "private.inbe.v1.sessions") && contains(payload(), "\"deleted_at\":"))
    check_true("linked habit day is cleared remotely too", contains(payload(), "private.inbe.v1.habit-days"))
    storage_close()
    check_true("ship deletion", ship_to(first, second, 2))
    check_int("device b lost the session", raw_count(second, "SELECT COUNT(*) FROM sessions WHERE deleted_at=0"), 0)
    check_int("device b cleared the linked day", raw_count(second, "SELECT COUNT(*) FROM habit_days WHERE count>0"), 0)
    unused today
}

test_fresh_account_bootstraps_without_tombstones :: () {
    root := make_root("sync-fresh-account")
    check_true("init db", storage_init(root) != 0)
    habits_a = Habits.{}
    check_true("add habit", habits_add_custom(*habits_a, "Work out", Green(), 0, 0) == 0)
    habit_set_day(*habits_a, 0, 20260618, 1)
    habits_save(*habits_a)
    deleted := storage_delete_all_sessions()
    check_true("local reset deleted rows", deleted >= cast(s64)2)
    check_int("no active habits", storage_habit_count(), 0)
    habits_free(*habits_a)
    set_account()
    storage_reset_sync_state()
    check_true("payload builds", build_payload())
    check_true("fresh account sends a bootstrap", contains(payload(), "\"since_server_version\":0") &&
        contains(payload(), "\"bootstrap\":true"))
    check_int("no stale tombstones or clears", record_count(), 0)
    storage_close()
}

// ---- Full snapshots and the review flow ----------------------------------

remote_records_text: TextBuffer;

// The records a remote device would send: its own database seeded with `sql`
// and every row queued for upload.
remote_records :: (name: string, sql: string) {
    root := make_root(name)
    check_true("init remote device", storage_init(root) != 0)
    set_account()
    storage_close()
    raw_exec(root, sql)
    raw_exec(root, "DELETE FROM sync_outbox;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit',id,0,1782300000 FROM habits;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day',habit_id,local_date,1782300000 FROM habit_days;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'session',id,0,1782300000 FROM sessions;INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_entry',id,0,1782300000 FROM habit_entries;")
    check_true("reopen remote device", storage_init(root) != 0)
    check_true("remote payload builds", build_payload())
    remote_records_text = TextBuffer.{}
    append(*remote_records_text, records_array())
    storage_close()
}

snapshot_buffer: TextBuffer;

// A server response asking the client to take a full snapshot.
snapshot_response :: (version: s32, hash: string) -> string {
    part: [24]u8
    snapshot_buffer = TextBuffer.{}
    append(*snapshot_buffer, "{\"protocol_version\":6,\"status\":\"ok\",\"server_version\":")
    append(*snapshot_buffer, FormatInteger(cast(s64)version, part[:]))
    append(*snapshot_buffer, ",\"server_state_hash\":\"")
    append(*snapshot_buffer, hash)
    append(*snapshot_buffer, "\",\"full_snapshot_required\":true,\"changes_complete\":false,\"changes\":{\"encrypted_records\":")
    append(*snapshot_buffer, TextFromCString(*remote_records_text.bytes[0]))
    append(*snapshot_buffer, "}}")
    return TextFromCString(*snapshot_buffer.bytes[0])
}

REMOTE_SQL :: "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('remote-habit',(SELECT id FROM users LIMIT 1),'Remote Breath',90,80,70,0,0,1,1,0,1782290000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('remote-habit',20260624,1,7,0,1782290000);INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('remote-session',(SELECT id FROM users LIMIT 1),1782290000,20260624,2,2,'sync-test',1782290000,'202',0,1782290000);INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('remote-session',0,55);"

LOCAL_SQL :: "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('local-habit',(SELECT id FROM users LIMIT 1),'Local Breath',10,20,30,0,0,1,1,0,1782300000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('local-habit',20260624,1,4,0,1782300000);INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('local-session',(SELECT id FROM users LIMIT 1),1782300000,20260624,1,1,'test',1782300000,'101',0,1782300000);INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('local-session',0,40);"

LOCAL_PENDING_SQL :: "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('habit','local-habit',0,1782300000);INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('habit_day','local-habit',20260624,1782300000);INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('session','local-session',0,1782300000);"

// A local device with its own data and (optionally) everything queued.
local_device :: (name: string, seed: string, pending: string) -> string {
    root := make_root(name)
    check_true("init local device", storage_init(root) != 0)
    set_account()
    storage_close()
    raw_exec(root, seed)
    if pending.count > 0 { raw_exec(root, pending) }
    check_true("reopen local device", storage_init(root) != 0)
    return root
}

// Starts an upload, so the pending changes are "in flight" when the server
// answers.
mark_pending_payload_in_flight :: () {
    check_true("pending payload builds", build_payload())
}

count_of :: (root: string, sql: string) -> s32 {
    return read_db_count(sql)
}

test_snapshot_with_pending_local_edits_merges :: () {
    remote_records("review-remote-1", REMOTE_SQL)
    root := local_device("review-pending", LOCAL_SQL, LOCAL_PENDING_SQL)
    mark_pending_payload_in_flight()
    check_true("apply the snapshot", storage_apply_sync_response_json(snapshot_response(12, "remote-hash-001")) != 0)
    check_true("review is not pending for local edits", storage_sync_review_pending() == 0)
    check_int("local session kept", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='local-session'"), 1)
    check_int("remote session merged", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='remote-session'"), 1)
    check_int("local habit kept", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_int("remote habit merged", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 1)
    check_int("pending edits cleared after the accepted sync", count_of(root, "SELECT COUNT(*) FROM sync_outbox"), 0)
    storage_close()
}

