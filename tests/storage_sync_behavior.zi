test_node_cursors :: () {
    root := make_root("sync-nodes")
    check_true("init db", storage_init(root) != 0)
    set_account()
    storage_set_setting_text("sync_server_url", "https://one.example")
    check_true("save another node", SyncNodeAdd("https://two.example"))
    check_true("migrate the original node", SyncNodeCount() == 2)
    check_true("normalize duplicate node", SyncNodeAdd("https://two.example/"))
    check_true("do not duplicate a node", SyncNodeCount() == 2)
    storage_set_meta_int64("sync_last_server_version", 41)
    storage_set_meta_int64("sync_server_clock", 12)
    Core.set_meta_buf("sync_last_server_state_hash", "node-one-hash")
    storage_set_setting_text("sync_auth_token", "old-node-token")
    check_true("queue local diary", BundledAppRecordWrite("cell.diary.file.2026-10-08.json", "pending-entry"))
    check_true("switch node", SyncNodeActivate("https://two.example"))
    check_true("new node starts with its own cursor", storage_meta_int64("sync_last_server_version", 0) == 0)
    check_true("discard the old node session", storage_get_setting_text("sync_auth_token").count == 0)
    check_true("keep queued diary data", storage_has_pending_sync_outbox() != 0)
    storage_set_meta_int64("sync_last_server_version", 9)
    check_true("return to original node", SyncNodeActivate("https://one.example"))
    check_true("restore original node version", storage_meta_int64("sync_last_server_version", 0) == 41)
    check_true("restore original node clock", storage_meta_int64("sync_server_clock", 0) == 12)
    check_true("restore original node hash", storage_meta_text("sync_last_server_state_hash") == "node-one-hash")
    check_true("choose a preferred node", SyncNodePrefer("https://one.example"))
    check_true("fail over to another node", SyncNodeFailover())
    check_true("failover restores the other node cursor", storage_meta_int64("sync_last_server_version", 0) == 9)
    check_true("failover keeps the preferred node", storage_get_setting_text("sync_preferred_node") == "https://one.example")
    check_true("prefer the other node", SyncNodePrefer("https://two.example"))
    check_true("remove the active node", SyncNodeRemove(1))
    check_true("keep the remaining node", SyncNodeCount() == 1)
    check_true("replace a removed preference", storage_get_setting_text("sync_preferred_node") == "https://one.example")
    check_true("keep one usable node", !SyncNodeRemove(0))
    storage_set_setting_text("sync_public_id", "another-account")
    storage_reset_sync_state()
    check_true("add another account's node", SyncNodeAdd("https://two.example"))
    check_true("switch another account's node", SyncNodeActivate("https://two.example"))
    check_true("do not reuse another account's cursor", storage_meta_int64("sync_last_server_version", 0) == 0)
    check_true("return with another account", SyncNodeActivate("https://one.example"))
    check_true("keep account cursors separate", storage_meta_int64("sync_last_server_version", 0) == 0)
    storage_close()
}

test_record_page_storage :: () {
    root := make_root("sync-record-pages")
    check_true("init paged device", storage_init(root) != 0)
    set_account()
    storage_set_setting_text("sync_server_url", "https://one.example")
    check_true("queue local work before the download", BundledAppRecordWrite("cell.diary.file.2026-10-08.json", "local-entry"))
    download := BuildStoredSyncPayload("test-public-id", "test-public-key", 0)
    check_true("build download-only body", download != null)
    if download != null {
        check_int("download does not republish records", storage_json_array_count_path(TextFromCString(download), "$.encrypted_records"), 0)
        storage_free_sync_payload_json(download)
    }
    check_true("download keeps local work queued", storage_has_pending_sync_outbox() != 0 && storage_state_handle().pending_sync_outbox_seq == 0)
    page: SyncPageState
    page.enabled = true
    page.pending = true
    unused AppCopyText("{\"version\":7,\"collection\":\"private.inbe.v1.habits\",\"id\":\"habit-1\"}", page.cursor[:])
    check_true("persist page recovery", SaveStoredSyncPage("https://one.example", *page))
    loaded: SyncPageState
    check_true("load saved progress", LoadStoredSyncPage("https://one.example", *loaded))
    check_true("resume the last committed cursor", loaded.enabled && loaded.pending &&
        TextUntilNul(loaded.cursor[:]) == TextUntilNul(page.cursor[:]))
    check_true("another node has its own state", LoadStoredSyncPage("https://two.example", *loaded) && !loaded.enabled)
    storage_set_setting_text("sync_public_id", "other-account")
    check_true("another account has its own state", LoadStoredSyncPage("https://one.example", *loaded) && !loaded.enabled)
    set_account()
    check_true("restore the original account progress", LoadStoredSyncPage("https://one.example", *loaded) && loaded.pending)
    response := "{\"protocol_version\":6,\"server_version\":50,\"server_clock\":50,\"changes\":{\"encrypted_records\":[]}}"
    check_true("apply a partial page", ApplyStoredSyncResponse(response, *page) != 0)
    check_true("keep watermark until the terminal page", storage_meta_int64("sync_last_server_version", 0) == 0)
    check_true("keep repairs pending during download", storage_meta_int64("sync_full_upload_done", 0) == 0)
    page.pending = false
    page.cursor[0] = cast(u8)0
    // A failing cursor write must reject the page and leave previous progress.
    check_true("install cursor failure fixture", SqliteExecText(storage_db_handle(),
        "CREATE TEMP TRIGGER reject_cursor BEFORE UPDATE ON settings WHEN NEW.key GLOB 'sync_node_*.record_cursor' BEGIN SELECT RAISE(ABORT,'test cursor failure'); END") == SQLITE_OK)
    check_true("failed cursor save rejects the page", ApplyStoredSyncResponse(response, *page) == 0)
    check_true("remove cursor failure fixture", SqliteExecText(storage_db_handle(), "DROP TRIGGER reject_cursor") == SQLITE_OK)
    check_true("failed page does not advance watermark", storage_meta_int64("sync_last_server_version", 0) == 0)
    check_true("failed page keeps the committed cursor", LoadStoredSyncPage("https://one.example", *loaded) && loaded.pending && loaded.cursor[0] != cast(u8)0)
    check_true("accept terminal page", ApplyStoredSyncResponse(response, *page) != 0)
    check_true("terminal page advances the watermark", storage_meta_int64("sync_last_server_version", 0) == 50)
    check_true("terminal page clears recovery cursor", LoadStoredSyncPage("https://one.example", *loaded) && !loaded.pending && loaded.cursor[0] == cast(u8)0)
    storage_close()
}

// Bytes a node stores for one Diary file in the payload, counted like
// Daochi's account storage: every stored field of each encrypted record.
payload_file_bytes :: (name: string, hash: string, chunks_only: bool) -> s64 {
    records := records_array()
    total: s64 = 0
    count := ArrayCount(records, 0)
    fields: [7]string = .["collection", "id", "key_id", "nonce", "ciphertext", "content_hash", "parent_id"]
    chunk_prefix := join("cell.diary.chunk.", hash)
    chunk_prefix = PackageText(chunk_prefix, "")
    defer {
        PackageFree(chunk_prefix)
    }
    entry := PackageText("cell.diary.file.", name)
    defer {
        PackageFree(entry)
    }
    for index: cast(s32)0..count - 1 {
        record := ElementAt(records, 0, index)
        id: [256]u8
        id_length := ReadStringText(records, FieldAt(records, record, "id"), id[:])
        if id_length <= 0 {
            continue
        }
        identifier := TextFromBytes(id[:id_length])
        chunk := identifier.count > chunk_prefix.count && identifier[:chunk_prefix.count] == chunk_prefix
        if !chunk && (chunks_only || identifier != entry) {
            continue
        }
        for field: fields {
            value: [8192]u8
            length := ReadStringText(records, FieldAt(records, record, field), value[:])
            if length > 0 {
                total += cast(s64)length
            }
        }
    }
    return total
}

queued_diary_chunks :: () -> s32 {
    return read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='cell_record' AND entity_id GLOB 'cell.diary.chunk.*'")
}

// A photo saved before sealed copies: hex chunks and an entry that counts
// them, as older versions still send.
save_legacy_photo :: (name: string, data: string) -> bool {
    descriptor := cast(*TextDescriptor)(*data)
    hash_bytes: [65]u8
    storage_sha256_hex(descriptor.data, data.count, *hash_bytes[0])
    hash := TextFromCString(*hash_bytes[0])
    count := cast(s32)((data.count + DIARY_CHUNK_BYTES - 1) / DIARY_CHUNK_BYTES)
    for index: cast(s32)0..count - 1 {
        start := cast(s64)index * DIARY_CHUNK_BYTES
        size := data.count - start
        if size > DIARY_CHUNK_BYTES {
            size = DIARY_CHUNK_BYTES
        }
        encoded: [DIARY_CHUNK_BYTES * 2 + 1]u8
        if BytesToHex(*descriptor.data[start], size, *encoded[0], encoded.count) == 0 {
            return false
        }
        chunk := DiaryChunkKey(hash, index)
        written := BundledAppRecordWrite(chunk, TextFromCString(*encoded[0]))
        PackageFree(chunk)
        if !written {
            return false
        }
    }
    out: Vec(u8)
    BuilderPrint(*out, "{\"hash\":\"%\",\"count\":%,\"size\":%}", hash, count, data.count)
    entry := BuilderFinish(out)
    key := DiaryRecordKey(name)
    written := BundledAppRecordWrite(key, entry)
    PackageFree(key)
    PackageFree(entry)
    return written
}

format_bytes :: (bytes: s64) -> string {
    output: [32]u8
    if !SyncStorageFormatBytes(bytes, output[:]) {
        return ""
    }
    return PackageText(TextFromCString(*output[0]), "")
}

// A photo syncs only its entry; its sealed copy travels separately
// (apps/diary_blobs.zi). A node set not to store photos still never
// receives the chunks of a photo from before copies. Reports and limits.
test_node_storage_and_media :: () {
    root := make_root("sync-node-media")
    check_true("init media device", storage_init(root) != 0)
    set_account()
    storage_set_sync_enabled(1)
    node := "https://api.waozi.xyz"
    storage_set_setting_text("sync_server_url", node)
    check_true("save diary day", DiaryRecordSave("2026-10-10.json", "{\"text\":\"Entry with a photo\"}"))
    photo: [3000]u8
    for index: cast(s32)0..cast(s32)2999 {
        photo[index] = cast(u8)(index % 251)
    }
    check_true("save diary photo", DiaryRecordSave("photo-1-1.bin", TextFromBytes(photo[:])))
    check_int("a photo queues no chunks", queued_diary_chunks(), 1)
    check_true("photos upload by default", SyncNodeMediaUpload(node))
    check_true("payload with a photo builds", build_payload())
    check_int("file entries and the day chunk upload", record_count(), 3)
    check_true("a photo's copy is its size plus 16 bytes", SyncMediaLocalBytes() == 3016)
    older: [2500]u8
    for index: cast(s32)0..cast(s32)2499 {
        older[index] = cast(u8)((index * 3) % 251)
    }
    check_true("keep a photo from before copies", save_legacy_photo("photo-0-1.bin", TextFromBytes(older[:])))
    check_int("its chunks queue", queued_diary_chunks(), 4)
    check_true("payload with the old photo builds", build_payload())
    check_int("entries and every chunk upload", record_count(), 7)
    photo_hash := PackageText(read_db_text("SELECT json_extract(value,'$.hash') FROM settings WHERE key='cell.diary.file.photo-0-1.bin'"), "")
    check_int("old photo entry names its content", cast(s32)photo_hash.count, 64)
    check_true("local photo bytes count the copy and the old chunks",
        SyncMediaLocalBytes() == 3016 + payload_file_bytes("photo-0-1.bin", photo_hash, true))
    PackageFree(photo_hash)

    check_true("turn photos off for the node", SyncNodeSetMediaUpload(node, false))
    check_true("photo setting is stored", !SyncNodeMediaUpload("https://api.waozi.xyz/"))
    check_true("other nodes keep photos on", SyncNodeMediaUpload("https://other.example"))
    check_int("photo chunks leave the queue", queued_diary_chunks(), 1)
    check_true("payload without photos builds", build_payload())
    check_int("only entries and the day chunk upload", record_count(), 4)
    check_true("photo entries still sync", contains(payload(), "cell.diary.file.photo-1-1.bin") &&
        contains(payload(), "cell.diary.file.photo-0-1.bin"))
    storage_enqueue_all_sync_state()
    check_true("backfill payload builds", build_payload())
    check_int("a backfill does not send photos", record_count(), 4)
    check_true("turn photos back on", SyncNodeSetMediaUpload(node, true))
    check_int("photos queue again", queued_diary_chunks(), 4)

    check_true("unknown usage before a sync", !SyncNodeStorageRead(node).known)
    SyncNodeStorageRecordResponse(node, "{\"status\":\"ok\",\"account_storage\":{\"used_bytes\":9437184,\"limit_bytes\":10485760}}")
    storage := SyncNodeStorageRead("https://api.waozi.xyz/")
    check_true("usage is known", storage.known && !storage.full)
    check_true("usage is read", storage.used_bytes == 9437184 && storage.limit_bytes == 10485760)
    check_int("usage percent", SyncNodeStoragePercent(storage), 90)
    check_true("ninety percent is nearly full", SyncNodeStorageNearlyFull(storage))
    check_true("other 413 replies are not storage full",
        !SyncNodeStorageRecordFull(node, "{\"error\":\"encrypted payload quota exceeded\"}"))
    check_true("storage full is recorded",
        SyncNodeStorageRecordFull(node, "{\"error\":\"account storage limit reached\",\"code\":\"storage_full\",\"account_storage\":{\"used_bytes\":10485000,\"limit_bytes\":10485760}}"))
    storage = SyncNodeStorageRead(node)
    check_true("full node keeps its usage", storage.full && storage.used_bytes == 10485000)
    SyncNodeStorageRecordResponse(node, "{\"status\":\"ok\"}")
    check_true("a reply without usage keeps the report", SyncNodeStorageRead(node).full)
    SyncNodeStorageRecordResponse(node, "{\"status\":\"ok\",\"account_storage\":{\"used_bytes\":2048}}")
    storage = SyncNodeStorageRead(node)
    check_true("a sync clears full", !storage.full && storage.used_bytes == 2048)
    check_true("an unlimited node has no limit", storage.limit_bytes == 0 && !SyncNodeStorageNearlyFull(storage))
    storage_set_setting_text("sync_public_id", "another-account")
    check_true("reports belong to one account", !SyncNodeStorageRead(node).known)
    check_true("photo settings belong to one account", SyncNodeMediaUpload(node))
    storage_close()

    sizes: [6]s64 = .[0, 1023, 1536, 5557452, 10485760, 157286400]
    expected: [6]string = .["0 B", "1023 B", "2 KB", "5.3 MB", "10 MB", "150 MB"]
    for index: cast(s32)0..cast(s32)5 {
        formatted := format_bytes(sizes[index])
        check_true("storage size reads naturally", formatted == expected[index])
        PackageFree(formatted)
    }
    check_true("node names drop the scheme", SyncNodeDisplayName("https://api.waozi.xyz/") == "api.waozi.xyz")
}

c :: #system_library "c";
sqlite_free :: (memory: *void) #foreign c "free";
ReviewFieldFailure :: (enabled: s32) #foreign c;
TestAllocate :: (size: usize) -> *void #foreign c "malloc";

habits_a: Habits;
habits_b: Habits;

// The account key material: an ML-DSA-sized key of repeating "42" hex.
set_account :: () {
    key: [5121]u8
    index: s32 = 0
    while index < 5120 {
        if index % 2 == 0 { key[index] = cast(u8)52 } else { key[index] = cast(u8)50 }
        index += 1
    }
    key[5120] = cast(u8)0
    storage_set_setting_text("sync_public_id", "test-public-id")
    storage_set_setting_text("sync_public_key", "test-public-key")
    storage_set_setting_text("sync_private_key", TextFromCString(*key[0]))
}

payload_text: string;

// Builds the sync payload into `payload_text`; false when none is produced.
build_payload :: () -> bool {
    payload := storage_build_sync_payload_json("test-public-id", "test-public-key")
    if payload == null { return false }
    PackageFree(payload_text)
    payload_text = PackageText(TextFromCString(payload), "")
    storage_free_sync_payload_json(payload)
    return true
}

payload :: () -> string {
    return payload_text
}

record_count :: () -> s32 {
    return storage_json_array_count_path(payload(), "$.encrypted_records")
}

// The "encrypted_records" array of the last payload, as text.
records_array :: () -> string {
    text := payload()
    key: string = "\"encrypted_records\":"
    start: s64 = 0
    found: bool = false
    while start + key.count <= text.count && !found {
        matches: bool = true
        index: s64 = 0
        while index < key.count {
            if text[start + index] != key[index] {
                matches = false
                break
            }
            index += 1
        }
        if matches { found = true } else { start += 1 }
    }
    if !found { return "[]" }
    begin: s64 = start + key.count
    depth: s32 = 0
    end: s64 = begin
    while end < text.count {
        if text[end] == cast(u8)91 { depth += 1 }
        if text[end] == cast(u8)93 {
            depth -= 1
            if depth == 0 {
                end += 1
                break
            }
        }
        end += 1
    }
    return text[begin:end]
}

response_buffer: StorageJsonBuilder;

// A v6 server response carrying `records` for a device to apply.
response_with :: (version: s32, records: string) -> string {
    part: [24]u8
    storage_json_builder_free(*response_buffer)
    response_buffer = StorageJsonBuilder.{}
    response_buffer.ok = 1
    storage_json_builder_append_text(*response_buffer, "{\"protocol_version\":6,\"status\":\"ok\",\"server_version\":")
    storage_json_builder_append_text(*response_buffer, FormatInteger(cast(s64)version, part[:]))
    storage_json_builder_append_text(*response_buffer, ",\"server_clock\":")
    storage_json_builder_append_text(*response_buffer, FormatInteger(cast(s64)version, part[:]))
    storage_json_builder_append_text(*response_buffer, ",\"changes\":{\"encrypted_records\":")
    storage_json_builder_append_text(*response_buffer, records)
    storage_json_builder_append_text(*response_buffer, "}}")
    return AppTextFromCString(response_buffer.data, cast(s32)(response_buffer.len + 1))
}

empty_response :: (version: s32) -> string {
    return response_with(version, "[]")
}

ascii_lower :: (byte: u8) -> u8 {
    if byte >= cast(u8)65 && byte <= cast(u8)90 { return byte + cast(u8)32 }
    return byte
}

find_habit :: (habits: *Habits, name: string) -> *Habit {
    index: s32 = 0
    while index < habits.count {
        text := TextFromCString(*habits.items[index].name[0])
        if text.count == name.count {
            same: bool = true
            position: s64 = 0
            while position < text.count {
                if ascii_lower(text[position]) != ascii_lower(name[position]) { same = false }
                position += 1
            }
            if same { return *habits.items[index] }
        }
        index += 1
    }
    return null
}

day_count_of :: (habit: *Habit, day: s32) -> s32 {
    index := habit_find_day(habit, day)
    if index < 0 { return -1 }
    return habit.days[index].count
}

Green :: () -> Color {
    return Color.{99, 196, 165, 255}
}

test_payload_after_upload_marker :: () {
    root := make_root("sync-uploaded")
    check_true("init db", storage_init(root) != 0)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day_count(*habits_a, 0, 20260612, 12)
    habits_save(*habits_a)
    habits_free(*habits_a)
    storage_close()
    raw_exec(root, "INSERT OR REPLACE INTO meta(key,value) VALUES('sync_full_upload_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_backfill_v2_done','1');INSERT OR REPLACE INTO meta(key,value) VALUES('sync_habit_name_repair_done','1');DELETE FROM sync_outbox;")
    check_true("reopen db", storage_init(root) != 0)
    check_true("payload builds", build_payload())
    check_int("uploaded state is not sent again", record_count(), 0)
    storage_close()
}

test_backfill_includes_existing_habits :: () {
    root := make_root("sync-backfill")
    check_true("init db", storage_init(root) != 0)
    check_true("no payload without a private record key",
        storage_build_sync_payload_json("test-hash", "test-public-key") == null)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_free(*habits_a)
    storage_close()
    raw_exec(root, "INSERT OR REPLACE INTO meta(key,value) VALUES('sync_full_upload_done','1');DELETE FROM sync_outbox;")
    check_true("reopen db", storage_init(root) != 0)
    check_true("payload builds", build_payload())
    check_true("existing habit is in the encrypted backfill",
        contains(payload(), "private.inbe.v1.habits") && !contains(payload(), "\"ops\":"))
    storage_close()
}

test_payload_excludes_local_settings :: () {
    root := make_root("sync-settings")
    check_true("init db", storage_init(root) != 0)
    set_account()
    storage_set_setting_text("theme", "dark")
    storage_set_setting_text("main_tab", "0")
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habits_free(*habits_a)
    check_true("payload builds", build_payload())
    check_true("settings are not in the payload",
        !contains(payload(), "\"preferences\"") && !contains(payload(), "\"theme\"") &&
        !contains(payload(), "\"main_tab\""))
    storage_close()
}

test_payload_includes_queued_edits :: () {
    root := make_root("sync-queued")
    check_true("init db", storage_init(root) != 0)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day_count(*habits_a, 0, 20260617, 7)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("payload builds", build_payload())
    check_true("queued habit day is sent", contains(payload(), ":20260617\""))
    check_true("its content is encrypted", !contains(payload(), "\"count\":7"))
    storage_close()
}

// The rewards set in the habit shop, and what bought them, are private:
// they leave the device only sealed, in the account's private collections.
test_shop_rewards_stay_private :: () {
    root := make_root("sync-shop-private")
    check_true("init db", storage_init(root) != 0)
    set_account()
    saved: [HABIT_REWARD_ID_SIZE]u8
    check_true("reward saves", storage_habit_reward_save("", "Joint with Sam", 5, 48,
        saved[:]) != 0)
    reward: HabitReward
    unused AppCopyText(AppTextFromCString(*saved[0], HABIT_REWARD_ID_SIZE), reward.id[:])
    unused AppCopyText("Joint with Sam", reward.name[:])
    reward.price = 5
    check_true("reward is bought", storage_habit_reward_buy(*reward) != 0)
    check_true("payload builds", build_payload())
    check_true("the reward is sent in its private collection",
        contains(payload(), "\"private.inbe.v1.habit-rewards\""))
    check_true("the purchase is sent in its private collection",
        contains(payload(), "\"private.inbe.v1.habit-coins\""))
    check_true("the reward's name is never sent readable",
        !contains(payload(), "Joint with Sam") && !contains(payload(), "Joint"))
    storage_close()
}

test_rejects_unknown_outbox_record :: () {
    root := make_root("sync-unknown")
    status: StorageSyncStatus
    check_true("init db", storage_init(root) != 0)
    set_account()
    exec_db_sql("INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('unknown','record-1',0,1)")
    check_true("unknown queued record rejects the payload", !build_payload())
    check_true("status stays available", storage_sync_status(*status) != 0)
    check_true("the record stays pending", status.queued_changes > 0)
    storage_close()
}

// Android gives the app no writable temporary directory: a merge whose
// statement journal spilled to a file failed with "disk I/O error" and rolled
// back the whole review. The storage connection keeps temporary data in memory.
test_temporary_data_in_memory :: () {
    root := make_root("temp-store")
    check_true("init db", storage_init(root) != 0)
    statement: *void = null
    store: s32 = -1
    if SqlitePrepareText(storage_db_handle(), "PRAGMA temp_store", -1, *statement, null) == SQLITE_OK &&
    SqliteStep(statement) == SQLITE_ROW {
        store = SqliteColumnInt(statement, 0)
    }
    SqliteFinalize(statement)
    check_true("temporary data stays in memory", store == 2)
    storage_close()
}

test_v6_encrypted_records :: () {
    root := make_root("sync-v6")
    collection: [80]u8
    record_id: [180]u8
    ciphertext: [4096]u8
    check_true("init db", storage_init(root) != 0)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day_count(*habits_a, 0, 20260829, 3)
    habits_save(*habits_a)
    habits_free(*habits_a)
    check_true("payload builds", build_payload())
    text := payload()
    check_true("v6 protocol", contains(text, "\"protocol_version\":6"))
    check_true("app id", contains(text, "\"app_id\":\"inbe\""))
    check_true("no legacy data opt-in", !contains(text, "include_legacy_data"))
    check_true("capabilities", contains(text, "\"client_capabilities\"") &&
        contains(text, "v6-device-transactions") && contains(text, "encrypted-primary") &&
        !contains(text, "legacy-dual-write"))
    check_true("encrypted records present", record_count() > 0)
    check_true("first collection", storage_json_array_object_text(text, "$.encrypted_records", 0,
        "collection", *collection[0], 80) != 0 && collection[0] != cast(u8)0)
    check_true("first record id", storage_json_array_object_text(text, "$.encrypted_records", 0,
        "id", *record_id[0], 180) != 0 && record_id[0] != cast(u8)0)
    check_true("first ciphertext", storage_json_array_object_text(text, "$.encrypted_records", 0,
        "ciphertext", *ciphertext[0], 4096) != 0 && ciphertext[0] != cast(u8)0 &&
        !contains(TextFromCString(*ciphertext[0]), "Yoga"))
    check_true("pre-v6 response rejected", storage_apply_sync_response_json(
        "{\"protocol_version\":4,\"status\":\"ok\",\"server_version\":10,\"changes\":{\"encrypted_records\":[]}}") == 0)
    check_true("payload builds again", build_payload())
    check_true("records survive the rejected response", record_count() > 0)
    storage_close()
}

test_plaintext_private_response_ignored :: () {
    root := make_root("sync-plaintext")
    check_true("init db", storage_init(root) != 0)
    check_true("v6 response with a plaintext private row applies", storage_apply_sync_response_json(
        "{\"protocol_version\":6,\"status\":\"ok\",\"server_version\":12,\"server_clock\":12,\"changes\":{\"habits\":[{\"id\":\"plaintext-habit\",\"name\":\"Unexpected\",\"color_r\":1,\"color_g\":2,\"color_b\":3,\"sync_mode\":0,\"sync_activity\":0,\"counter_enabled\":0,\"sort_order\":0,\"deleted_at\":0,\"updated_at\":\"2026-08-29T12:30:00Z\"}],\"habit_days\":[],\"sessions\":[],\"encrypted_records\":[]}}") != 0)
    check_int("plaintext private row ignored", storage_habit_count(), 0)
    check_int("no changed private data signalled", storage_last_sync_changed(), 0)
    storage_close()
}

test_large_outbox_batches :: () {
    root := make_root("sync-batch")
    check_true("init db", storage_init(root) != 0)
    set_account()
    storage_close()
    raw_exec(root, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('batch-habit',(SELECT id FROM users LIMIT 1),'Batch',255,255,255,0,0,1,0,0,1781902800);")
    raw_exec(root, "WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<404) INSERT INTO habit_days(habit_id,local_date,completed,count,updated_at) SELECT 'batch-habit',20260101+i,1,1,1781902800 FROM n;")
    raw_exec(root, "WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<404) INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) SELECT 'habit_day','batch-habit',20260101+i,1781902800 FROM n;")
    raw_exec(root, "INSERT OR REPLACE INTO meta(key,value) VALUES('sync_backfill_v2_done','1');")
    check_true("reopen db", storage_init(root) != 0)
    // A full batch is far larger than the shared text buffer, so count it in place.
    large := storage_build_sync_payload_json("test-public-id", "test-public-key")
    check_true("payload builds", large != null)
    if large != null {
        check_int("large outbox payload is batched",
            storage_json_array_count_path(TextFromCString(large), "$.encrypted_records"), 400)
        storage_free_sync_payload_json(large)
    }
    check_true("apply response", storage_apply_sync_response_json(empty_response(1)) != 0)
    storage_close()
    check_int("later rows stay queued", raw_count(root, "SELECT COUNT(*) FROM sync_outbox"), 5)
}

test_outbox_keeps_edits_after_snapshot :: () {
    root := make_root("sync-snapshot")
    check_true("init db", storage_init(root) != 0)
    set_account()
    habits_a = Habits.{}
    habits_add_default_set(*habits_a)
    habit_set_day_count(*habits_a, 0, 20260618, 1)
