test_apply_inside_an_outer_transaction :: () {
    remote_records("review-remote-clean", "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('clean-habit',(SELECT id FROM users LIMIT 1),'Clean Breath',12,34,56,0,0,1,3,0,1782290000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('clean-habit',20260624,1,5,0,1782290000);INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('clean-session',(SELECT id FROM users LIMIT 1),1782290000,20260624,2,2,'sync-test',1782290000,'505',0,1782290000);INSERT INTO session_rounds(session_id,round_index,seconds) VALUES('clean-session',0,44);")
    clean := TextBuffer.{}
    append(*clean, TextFromCString(*remote_records_text.bytes[0]))
    root := make_root("review-nested")
    check_true("init db", storage_init(root) != 0)
    set_account()
    check_true("begin outer transaction", exec_sql("BEGIN IMMEDIATE") != 0)
    check_true("apply inside it", storage_apply_sync_response_json(response_with(21, TextFromCString(*clean.bytes[0]))) != 0)
    check_true("commit outer transaction", exec_sql("COMMIT") != 0)
    check_int("habit applied", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='clean-habit'"), 1)
    check_int("day applied", count_of(root, "SELECT COUNT(*) FROM habit_days WHERE habit_id='clean-habit' AND count=5"), 1)
    check_int("session applied", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='clean-session'"), 1)
    check_int("rounds applied", count_of(root, "SELECT COUNT(*) FROM session_rounds WHERE session_id='clean-session' AND seconds=44"), 1)
    storage_close()

    // A local habit with the same name but another id is replaced by the
    // remote one, keeping its days.
    second := make_root("review-id-repair")
    check_true("init repair db", storage_init(second) != 0)
    set_account()
    storage_close()
    raw_exec(second, "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('local-clean-id',(SELECT id FROM users LIMIT 1),'Clean Breath',9,9,9,0,0,1,3,0,1782200000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('local-clean-id',20260623,1,2,0,1782200000);DELETE FROM sync_outbox;")
    check_true("reopen repair db", storage_init(second) != 0)
    check_true("apply the remote habit", storage_apply_sync_response_json(response_with(22, TextFromCString(*clean.bytes[0]))) != 0)
    check_int("local duplicate id removed", count_of(second, "SELECT COUNT(*) FROM habits WHERE id='local-clean-id'"), 0)
    check_int("canonical remote id present", count_of(second, "SELECT COUNT(*) FROM habits WHERE id='clean-habit'"), 1)
    check_int("local day moved to the canonical id", count_of(second, "SELECT COUNT(*) FROM habit_days WHERE habit_id='clean-habit' AND local_date=20260623 AND count=2"), 1)
    check_int("remote day still applied", count_of(second, "SELECT COUNT(*) FROM habit_days WHERE habit_id='clean-habit' AND local_date=20260624 AND count=5"), 1)
    storage_close()
}

YOGA_SQL :: "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('yoga',(SELECT id FROM users LIMIT 1),'Yoga',239,178,102,1,4,0,1,0,1782300000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('yoga',20260624,1,2,0,1782300000);"

test_snapshot_removes_absent_local_yoga :: () {
    remote_records("review-remote-none", "DELETE FROM habits;")
    root := local_device("review-removes-yoga", YOGA_SQL, "DELETE FROM sync_outbox;")
    check_true("apply the snapshot", storage_apply_sync_response_json(snapshot_response(13, "remote-hash-deleted")) != 0)
    check_true("review not pending", storage_sync_review_pending() == 0)
    check_int("yoga habit removed", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='yoga'"), 0)
    check_int("yoga day removed", count_of(root, "SELECT COUNT(*) FROM habit_days WHERE habit_id='yoga'"), 0)
    storage_close()
}

test_snapshot_keeps_pending_yoga :: () {
    remote_records("review-remote-none-2", "DELETE FROM habits;")
    root := local_device("review-keeps-yoga", YOGA_SQL, "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('habit','yoga',0,1782300000);")
    mark_pending_payload_in_flight()
    check_true("apply the snapshot", storage_apply_sync_response_json(snapshot_response(13, "remote-hash-deleted")) != 0)
    check_true("review not pending", storage_sync_review_pending() == 0)
    check_int("pending yoga still local after the merge", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='yoga'"), 1)
    storage_close()
}

test_normal_response_records_server_hash :: () {
    root := make_root("review-normal")
    status: StorageSyncStatus
    check_true("init db", storage_init(root) != 0)
    check_true("apply a normal response", storage_apply_sync_response_json(
        "{\"protocol_version\":6,\"server_version\":5,\"server_clock\":77,\"server_state_hash\":\"normal-hash-001\",\"account_alias\":\"waozi\",\"changes\":{\"encrypted_records\":[]}}") != 0)
    check_true("no review", storage_sync_review_pending() == 0)
    check_true("alias saved", storage_get_setting_text("sync_account_alias") == "waozi")
    check_true("status loads", storage_sync_status(*status) != 0)
    check_int("server version recorded", cast(s32)status.server_version, 5)
    check_int("server clock recorded", cast(s32)status.server_clock, 77)
    set_account()
    check_true("payload builds", build_payload())
    check_true("hash in the next payload", contains(payload(), "\"last_server_state_hash\":\"normal-hash-001\""))
    check_true("clock in the next payload", contains(payload(), "\"client_clock\":77"))
    check_true("no full replace requested", !contains(payload(), "full_sync_requested"))
    storage_close()
}

test_social_cache_is_server_authored :: () {
    root := make_root("review-social")
    cached: [512]u8
    check_true("init db", storage_init(root) != 0)
    check_true("store a local social cache", storage_set_social_cache_json("friends.list",
        "{\"friends\":[{\"user_id_hash\":\"local-edit\"}]}") != 0)
    check_true("a social cache alone is not local syncable data", storage_has_local_syncable_data() == 0)
    set_account()
    check_true("payload builds", build_payload())
    check_true("social cache is not uploaded", !contains(payload(), "social_cache") && !contains(payload(), "friends.list"))
    check_true("apply the server's social cache", storage_apply_sync_response_json(
        "{\"protocol_version\":6,\"server_version\":9,\"server_clock\":9,\"server_state_hash\":\"social-hash-001\",\"changes\":{\"encrypted_records\":[],\"social_cache\":[{\"kind\":\"friends.list\",\"json\":{\"friends\":[{\"user_id_hash\":\"server-friend\"}]},\"updated_at\":\"2026-06-28T00:00:00Z\"}]}}") != 0)
    check_true("load the cache", storage_get_social_cache_json("friends.list", *cached[0], 512) != 0)
    text := TextFromCString(*cached[0])
    check_true("the server's cache replaces the local edit", contains(text, "server-friend") && !contains(text, "local-edit"))
    storage_close()
}

// The preview rehearses encrypted v6 application, then returns with the
// snapshot, local records, metadata and pending uploads still intact.
test_review_preview_and_choices :: () {
    remote_seed: TextBuffer
    append(*remote_seed, REMOTE_SQL)
    append(*remote_seed, "INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('remote-habit',20260905,0,0,0,1782290000);INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('remote-habit',20260906,0,3,0,1782290000);")
    append(*remote_seed, "INSERT INTO elist_lists VALUES('remote-review-list',(SELECT id FROM users LIMIT 1),'Remote list',0,0,1782290000);INSERT INTO elist_items VALUES('remote-review-item',(SELECT id FROM users LIMIT 1),'remote-review-list','Remote item','',0,0,0,1782290000);")
    remote_records("review-preview-source", TextFromCString(*remote_seed.bytes[0]))
    seed: TextBuffer
    append(*seed, LOCAL_SQL)
    append(*seed, "INSERT INTO elist_lists VALUES('local-review-list',(SELECT id FROM users LIMIT 1),'Local list',0,0,1782300000);INSERT INTO elist_items VALUES('local-review-item',(SELECT id FROM users LIMIT 1),'local-review-list','Local item','',0,0,0,1782300000);INSERT INTO sessions(id,user_id,started_at,local_date,topic,activity,source,imported_at,rounds_hash,deleted_at,updated_at) VALUES('remote-session',(SELECT id FROM users LIMIT 1),1782290000,20260624,2,2,'sync-test',1782290000,'202',0,1782200000);INSERT INTO session_rounds VALUES('remote-session',0,25);")
    root := local_device("review-preview-local", TextFromCString(*seed.bytes[0]), LOCAL_PENDING_SQL)
    raw_exec(root, "INSERT INTO meditation_logs VALUES('local-review-meditation',(SELECT id FROM users LIMIT 1),'local-session',77,1782300000,1782300000);")
    snapshot := snapshot_response(24, "review-preview-hash")
    check_true("save review snapshot", storage_sync_review_write_json(snapshot) != 0)
    storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
    before_outbox := read_db_count("SELECT COUNT(*) FROM sync_outbox")
    before_meta := read_db_count("SELECT COUNT(*) FROM meta")
    state := storage_state_handle().*
    plan: *u8 = null
    check_true("merge preview", storage_sync_review_plan_for_json(snapshot, 2, *plan) != 0)
    text := TextFromCString(plan)
    check_true("encrypted habit appears in grouped preview", contains(text, "Remote Breath"))
    check_true("changed session shows before and after", contains(text, "25 → 55"))
    check_true("encrypted list and item appear in grouped preview", contains(text, "Remote list") && contains(text, "Remote item"))
    check_true("merge leaves local-only habit out of changes", !contains(text, "Local Breath"))
    check_true("empty incomplete days are not additions", !contains(text, "2026-09-05"))
    check_true("incomplete days with real progress remain visible", contains(text, "2026-09-06"))
    check_true("habit dates are readable", !contains(text, "20260624"))
    sqlite_free(cast(*void)plan)
    plan = null
    check_true("replace preview", storage_sync_review_plan_for_json(snapshot, 1, *plan) != 0)
    check_true("replacement explicitly includes cascading local removals", contains(TextFromCString(plan), "Local Breath") &&
        contains(TextFromCString(plan), "Local list") && contains(TextFromCString(plan), "Local item"))
    check_true("replacement includes stored meditation duration", contains(TextFromCString(plan), "77 s"))
    sqlite_free(cast(*void)plan)
    check_int("preview kept local habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_int("preview kept stored meditation", read_db_count("SELECT COUNT(*) FROM meditation_logs WHERE id='local-review-meditation'"), 1)
    check_int("preview did not add remote habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 0)
    check_int("preview kept outbox", read_db_count("SELECT COUNT(*) FROM sync_outbox"), before_outbox)
    check_int("preview kept metadata", read_db_count("SELECT COUNT(*) FROM meta"), before_meta)
    check_true("preview kept storage state", storage_state_handle().pending_sync_outbox_seq == state.pending_sync_outbox_seq &&
        storage_state_handle().last_sync_changed == state.last_sync_changed)
    check_true("preview kept pending review", storage_sync_review_pending() != 0)
    plan = null
    check_true("invalid encrypted preview is rejected", storage_sync_review_plan_for_json(
        "{\"protocol_version\":6,\"changes\":{\"encrypted_records\":[{\"collection\":\"private.inbe.v1.sessions\",\"id\":\"bad\",\"key_id\":\"bad\",\"nonce\":\"bad\",\"ciphertext\":\"bad\"}]}}", 2, *plan) == 0)
    check_true("failed preview returned no partial text", plan == null)
    check_int("failed preview kept local habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    // The failure is injected where a statement is prepared, so none kept
    // from the previews above may stand in for it.
    SqliteReleaseKept(storage_db_handle())
    ReviewFieldFailure(1)
    check_true("failed field preview is rejected", storage_sync_review_plan_for_json(snapshot, 2, *plan) == 0)
    check_true("failed field preview returned no partial text", plan == null)
    ReviewFieldFailure(0)
    sqlite_free(cast(*void)plan)
    plan = null
    check_int("failed field preview kept local habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_true("merge applies", storage_apply_pending_sync_review(2) != 0)
    check_int("merge retains local session", read_db_count("SELECT COUNT(*) FROM sessions WHERE id='local-session'"), 1)
    check_int("merge retains stored meditation", read_db_count("SELECT COUNT(*) FROM meditation_logs WHERE id='local-review-meditation'"), 1)
    check_int("merge adds remote session", read_db_count("SELECT COUNT(*) FROM sessions WHERE id='remote-session'"), 1)
    check_int("merge retains local habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_int("merge adds remote habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 1)
    check_int("merge retains local pending records", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id IN ('local-habit','local-session')"), 3)
    check_int("merge retains local list and item", read_db_count("SELECT COUNT(*) FROM elist_items WHERE id='local-review-item' AND list_id='local-review-list'"), 1)
    check_true("merge clears pending review", storage_sync_review_pending() == 0)
    check_true("keep test saves review", storage_sync_review_write_json(snapshot) != 0)
    storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
    before_outbox = read_db_count("SELECT COUNT(*) FROM sync_outbox")
    check_true("keep applies", storage_apply_pending_sync_review(0) != 0)
    check_int("keep retains pending uploads", read_db_count("SELECT COUNT(*) FROM sync_outbox"), before_outbox)
    check_int("keep retains local records", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_true("replace test saves review", storage_sync_review_write_json(snapshot) != 0)
    check_true("replace applies", storage_apply_pending_sync_review(1) != 0)
    check_int("replacement removes local habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 0)
    check_int("replacement removes stored meditation", read_db_count("SELECT COUNT(*) FROM meditation_logs WHERE id='local-review-meditation'"), 0)
    check_int("replacement retains remote habit", read_db_count("SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 1)
    check_int("replacement removes absent local list", read_db_count("SELECT COUNT(*) FROM elist_lists WHERE id='local-review-list'"), 0)
    check_int("replacement removes absent local item", read_db_count("SELECT COUNT(*) FROM elist_items WHERE id='local-review-item'"), 0)
    check_int("replacement restores remote list and item", read_db_count("SELECT COUNT(*) FROM elist_items WHERE id='remote-review-item' AND list_id='remote-review-list'"), 1)
    storage_close()
}

test_review_social_differences :: () {
    root := make_root("review-social-differences")
    check_true("init social review db", storage_init(root) != 0)
    set_account()
    check_true("seed friend list", storage_set_social_cache_json("friends.list",
        "{\"friends\":[{\"user_id_hash\":\"friend-a\",\"alias\":\"Alice\",\"updated_at\":1},{\"user_id_hash\":\"friend-b\",\"alias\":\"Bob\"}]}") != 0)
    check_true("seed empty requests", storage_set_social_cache_json("friends.requests",
        "{ \"outgoing\": [], \"incoming\": [] }") != 0)
    equivalent := "{\"protocol_version\":6,\"changes\":{\"encrypted_records\":[],\"social_cache\":[{\"kind\":\"friends.list\",\"json\":{\"friends\":[{\"alias\":\"Bob\",\"user_id_hash\":\"friend-b\"},{\"updated_at\":2,\"alias\":\"Alice\",\"user_id_hash\":\"friend-a\"}]}},{\"kind\":\"friends.requests\",\"json\":{\"incoming\":[],\"outgoing\":[]}}]}}"
    plan: *u8 = null
    check_true("equivalent social preview", storage_sync_review_plan_for_json(equivalent, 2, *plan) != 0)
    check_true("formatting, ordering and cache metadata are not changes",
        TextFromCString(plan) == LocaleText("review_unchanged"))
    check_true("equivalent social data does not trigger review", storage_sync_review_json_has_visible_diff(equivalent) == 0)
    sqlite_free(cast(*void)plan)
    plan = null
    changed := "{\"protocol_version\":6,\"changes\":{\"encrypted_records\":[],\"social_cache\":[{\"kind\":\"friends.list\",\"json\":{\"friends\":[{\"user_id_hash\":\"friend-a\",\"alias\":\"Alicia\"},{\"user_id_hash\":\"friend-c\",\"alias\":\"Cara\"}]}},{\"kind\":\"friends.requests\",\"json\":{\"incoming\":[{\"id\":\"request-d\",\"requester_user_id_hash\":\"friend-d\",\"requester_alias\":\"Dani\"}],\"outgoing\":[{\"id\":\"request-e\",\"target_user_id_hash\":\"friend-e\",\"target_alias\":\"Eli\"}]}}]}}"
    check_true("changed social preview", storage_sync_review_plan_for_json(changed, 2, *plan) != 0)
    check_true("real social changes remain reviewable", storage_sync_review_json_has_visible_diff(changed) != 0)
    text := TextFromCString(plan)
    check_true("friend name change shows the exact values", contains(text, "Alice → Alicia"))
    check_true("friend additions and removals name the person", contains(text, "Cara") && contains(text, "Bob"))
    check_true("requests name their sender or recipient", contains(text, "Dani") && contains(text, "Eli"))
    check_true("social review has no raw JSON or internal cache names",
        !contains(text, "user_id_hash") && !contains(text, "friends.list") &&
        !contains(text, "friends.requests") && !contains(text, "{\""))
    sqlite_free(cast(*void)plan)
    cached: [512]u8
    check_true("preview leaves friend data intact", storage_get_social_cache_json("friends.list", *cached[0], 512) != 0 &&
        contains(TextFromCString(*cached[0]), "Alice") && !contains(TextFromCString(*cached[0]), "Cara"))
    storage_close()
}

test_review_no_changes_resolves_automatically :: () {
    remote_seed: TextBuffer
    append(*remote_seed, LOCAL_SQL)
    append(*remote_seed, "UPDATE sessions SET activity=3;INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('local-habit',20260905,0,0,0,1782290000);")
    remote_records("review-no-changes-source", TextFromCString(*remote_seed.bytes[0]))
    seed: TextBuffer
    append(*seed, LOCAL_SQL)
    append(*seed, "UPDATE sessions SET activity=3;INSERT INTO elist_lists VALUES('local-only-list',(SELECT id FROM users LIMIT 1),'Keep this list',0,0,1782300000);")
    unused local_device("review-no-changes-local", TextFromCString(*seed.bytes[0]), "DELETE FROM sync_outbox;")
    snapshot := snapshot_response(55, "no-changes-receipt")
    plan: *u8 = null
    check_true("no-op preview succeeds", storage_sync_review_plan_for_json(snapshot, 2, *plan) != 0)
    check_true("no-op preview and trigger agree", TextFromCString(plan) == LocaleText("review_unchanged") &&
        storage_sync_review_json_has_visible_diff(snapshot) == 0)
    sqlite_free(cast(*void)plan)
    check_true("incoming no-op snapshot applies", storage_apply_sync_response_json(snapshot) != 0)
    check_true("incoming no-op snapshot needs no review", storage_sync_review_pending() == 0)
    check_int("no-op merge keeps local-only records", read_db_count("SELECT COUNT(*) FROM elist_lists WHERE id='local-only-list'"), 1)
    check_int("no-op sync records its receipt", cast(s32)storage_meta_int64("sync_last_server_version", 0), 55)
    check_true("no-op sync records its hash", storage_meta_text("sync_last_server_state_hash") == "no-changes-receipt")
    storage_enqueue_all_sync_state()
    mark_pending_payload_in_flight()
    queued := read_db_count("SELECT COUNT(*) FROM sync_outbox")
    check_true("fixture has pending local uploads", queued > 0)
    pending_snapshot := snapshot_response(56, "resolved-no-changes-receipt")
    padding: s64 = 70000
    large := cast(*u8)TestAllocate(cast(usize)(padding + pending_snapshot.count + 1))
    check_true("allocate a large review snapshot", large != null)
    if large == null {
        storage_close()
        return
    }
    index: s64 = 0
    while index < padding {
        large[index] = cast(u8)32
        index += 1
    }
    index = 0
    while index < pending_snapshot.count {
        large[padding + index] = pending_snapshot[index]
        index += 1
    }
    large[padding + pending_snapshot.count] = cast(u8)0
    check_true("save an older pending review larger than 64 KiB", storage_sync_review_write_json(TextFromCString(large)) != 0)
    sqlite_free(cast(*void)large)
    storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
    check_true("large review is compared in full", storage_sync_review_has_visible_diff() == 0)
    check_true("pending no-op review resolves", storage_sync_review_clear_if_no_visible_diff() != 0)
    check_true("pending no-op review is cleared", storage_sync_review_pending() == 0)
    check_int("pending no-op review preserves uploads", read_db_count("SELECT COUNT(*) FROM sync_outbox"), queued)
    check_int("pending no-op review advances receipt", cast(s32)storage_meta_int64("sync_last_server_version", 0), 56)
    check_int("pending no-op review keeps local-only data", read_db_count("SELECT COUNT(*) FROM elist_lists WHERE id='local-only-list'"), 1)
    invalid := "{\"protocol_version\":6,\"changes\":{\"encrypted_records\":[{\"collection\":\"private.inbe.v1.sessions\",\"id\":\"bad\",\"key_id\":\"bad\",\"nonce\":\"bad\",\"ciphertext\":\"bad\"}]}}"
    check_true("unverified data is not treated as a no-op", storage_sync_review_json_has_visible_diff(invalid) != 0)
    check_true("save unverified review", storage_sync_review_write_json(invalid) != 0)
    storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
    check_true("unverified review is not silently cleared", storage_sync_review_clear_if_no_visible_diff() == 0 &&
        storage_sync_review_pending() != 0)
    storage_close()
}

// A snapshot that waits for review merges by itself: local records stay,
// remote records arrive, and its receipt advances. A device with Patterns
// sessions and other changes on the server waits for one.
test_waiting_review_merges :: () {
    remote_records("review-waiting-remote", REMOTE_SQL)
    seed: TextBuffer
    append(*seed, LOCAL_SQL)
    append(*seed, "UPDATE sessions SET activity=3;")
    root := local_device("review-waiting-local", TextFromCString(*seed.bytes[0]), "DELETE FROM sync_outbox;")
    check_true("apply the snapshot", storage_apply_sync_response_json(snapshot_response(58, "waiting-receipt")) != 0)
    check_true("snapshot waits for review", storage_sync_review_pending() != 0)
    check_true("waiting review merges", storage_sync_review_merge_pending() != 0)
    check_true("merged review is cleared", storage_sync_review_pending() == 0)
    check_int("local session kept", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='local-session'"), 1)
    check_int("remote session merged", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='remote-session'"), 1)
    check_int("local habit kept", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='local-habit'"), 1)
    check_int("remote habit merged", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 1)
    check_int("merge records its receipt", cast(s32)storage_meta_int64("sync_last_server_version", 0), 58)
    check_true("nothing waiting merges nothing", storage_sync_review_merge_pending() == 0)
    invalid := "{\"protocol_version\":6,\"changes\":{\"encrypted_records\":[{\"collection\":\"private.inbe.v1.sessions\",\"id\":\"bad\",\"key_id\":\"bad\",\"nonce\":\"bad\",\"ciphertext\":\"bad\"}]}}"
    check_true("save unreadable review", storage_sync_review_write_json(invalid) != 0)
    storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
    check_true("unreadable review is not merged", storage_sync_review_merge_pending() == 0 &&
        storage_sync_review_pending() != 0)
    storage_close()
}

// A habit's questions and its entries reach another device. A habit
// record from an app before questions keeps them; an older entry does not
// replace a newer one, and a deletion reaches the other device.
test_questions_and_entries_sync :: () {
    remote_records("questions-remote", "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at,questions,span) VALUES('meal',(SELECT id FROM users LIMIT 1),'First meal',1,2,3,0,0,0,1,0,1782290000,'[{\"id\":7,\"type\":\"time\",\"text\":\"Started eating\",\"goal\":\"at_most\",\"low\":0,\"high\":480}]',1);INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES('entry-1',(SELECT id FROM users LIMIT 1),'meal',20260624,1782290000,1782300000,'[{\"id\":7,\"type\":\"time\",\"question\":\"Started eating\",\"value\":\"07:30\"}]',0,1782290000);")
    root := make_root("questions-local")
    check_true("init local device", storage_init(root) != 0)
    set_account()
    check_true("apply the remote records",
        storage_apply_sync_response_json(snapshot_response(20, "questions-hash")) != 0)
    check_int("questions and goals arrive with the habit", count_of(root,
        "SELECT COUNT(*) FROM habits WHERE id='meal' AND json_extract(questions,'$[0].text')='Started eating' AND json_extract(questions,'$[0].goal')='at_most' AND span=1"), 1)
    check_int("the entry arrives with its answers", count_of(root,
        "SELECT COUNT(*) FROM habit_entries WHERE id='entry-1' AND habit_id='meal' AND local_date=20260624 AND started_at=1782290000 AND ended_at=1782300000 AND json_extract(answers,'$[0].value')='07:30' AND deleted_at=0"), 1)
    older: string = "{\"protocol_version\":6,\"changes\":{\"habits\":[{\"id\":\"meal\",\"name\":\"First meal\",\"color_r\":1,\"color_g\":2,\"color_b\":3,\"sync_mode\":0,\"sync_activity\":0,\"counter_enabled\":false,\"counter_target\":1,\"sort_order\":1,\"deleted_at\":0,\"updated_at\":\"2026-06-30T00:00:00Z\"}]}}"
    // Decrypted records go through the same apply.
    check_true("apply an older app's habit", storage_apply_sync_habits_json(older) != 0)
    check_int("an older app's habit keeps the questions and span", count_of(root,
        "SELECT COUNT(*) FROM habits WHERE id='meal' AND json_extract(questions,'$[0].text')='Started eating' AND span=1 AND updated_at>1782290000"), 1)
    stale: string = "{\"changes\":{\"habit_entries\":[{\"id\":\"entry-1\",\"habit_id\":\"meal\",\"local_date\":20260624,\"started_at\":1,\"ended_at\":2,\"answers\":\"\",\"deleted_at\":0,\"updated_at\":\"2026-06-01T00:00:00Z\"}]}}"
    check_true("apply an older entry", storage_apply_sync_habit_entries_json(stale) != 0)
    check_int("an older entry does not replace a newer one", count_of(root,
        "SELECT COUNT(*) FROM habit_entries WHERE id='entry-1' AND started_at=1782290000"), 1)
    removed: string = "{\"changes\":{\"habit_entries\":[{\"id\":\"entry-1\",\"habit_id\":\"meal\",\"local_date\":20260624,\"started_at\":1782290000,\"ended_at\":1782300000,\"answers\":\"\",\"deleted_at\":1783000000,\"updated_at\":\"2026-07-04T00:00:00Z\"}]}}"
    check_true("apply a deletion", storage_apply_sync_habit_entries_json(removed) != 0)
    check_int("the deletion reaches this device", count_of(root,
        "SELECT COUNT(*) FROM habit_entries WHERE id='entry-1' AND deleted_at>0"), 1)
    storage_close()
}

// Whether the last payload uploads the record with id as a deletion: 1 it
// does, 0 it keeps it, -1 it has no such record.
record_deleted :: (record_id: string) -> s32 {
    count := record_count()
    index: s32 = 0
    while index < count {
        path: TextBuffer
        append(*path, "$.encrypted_records[")
        number: [16]u8
        append(*path, FormatInteger(cast(s64)index, number[:]))
        append(*path, "].")
        id_path: TextBuffer
        append(*id_path, TextFromCString(*path.bytes[0]))
        append(*id_path, "id")
        found: [96]u8
        if storage_json_extract_text(payload(), TextFromCString(*id_path.bytes[0]),
            *found[0], 96) != 0 && TextFromCString(*found[0]) == record_id {
            deleted_path: TextBuffer
            append(*deleted_path, TextFromCString(*path.bytes[0]))
            append(*deleted_path, "deleted_at")
            return ifx storage_json_extract_int64(payload(),
                TextFromCString(*deleted_path.bytes[0]), 0) > 0 then 1 else 0
        }
        index += 1
    }
    return -1
}

// A list, an item and an entry that are kept upload as kept; only a
// deleted entry uploads as a deletion.
test_kept_records_upload_kept :: () {
    unused local_device("kept-upload", "INSERT INTO elist_lists(id,user_id,title,sort_order,deleted_at,updated_at) VALUES('list-kept',(SELECT id FROM users LIMIT 1),'Kept',0,0,1782300000);INSERT INTO elist_items(id,user_id,list_id,title,comment,done,sort_order,deleted_at,updated_at) VALUES('item-kept',(SELECT id FROM users LIMIT 1),'list-kept','Milk','',0,0,0,1782300000);INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('meal',(SELECT id FROM users LIMIT 1),'First meal',1,2,3,0,0,0,1,0,1782300000);INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES('entry-kept',(SELECT id FROM users LIMIT 1),'meal',20260624,1782300000,1782300000,'',0,1782300000),('entry-gone',(SELECT id FROM users LIMIT 1),'meal',20260624,1782300100,1782300100,'',1782300500,1782300500);",
        "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('elist_list','list-kept',0,1782300000),('elist_item','item-kept',0,1782300000),('habit_entry','entry-kept',0,1782300000),('habit_entry','entry-gone',0,1782300500);")
    check_true("payload builds", build_payload())
    check_int("a kept list uploads as kept", record_deleted("list-kept"), 0)
    check_int("a kept item uploads as kept", record_deleted("item-kept"), 0)
    check_int("a kept entry uploads as kept", record_deleted("entry-kept"), 0)
    check_int("a deleted entry uploads as deleted", record_deleted("entry-gone"), 1)
    storage_close()
}

test_review_completion_changes :: () {
    remote_seed: TextBuffer
    append(*remote_seed, REMOTE_SQL)
    append(*remote_seed, "DELETE FROM sessions;UPDATE habit_days SET completed=0,count=0,session_count=0;INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('remote-habit',20260905,0,0,0,1782290000);")
    remote_records("review-completion-source", TextFromCString(*remote_seed.bytes[0]))
    seed: TextBuffer
    append(*seed, REMOTE_SQL)
    append(*seed, "DELETE FROM sessions;INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES('remote-habit',20260904,0,0,0,1782290000);")
    unused local_device("review-completion-local", TextFromCString(*seed.bytes[0]), "")
    snapshot := snapshot_response(24, "review-completion-hash")
    plan: *u8 = null
    check_true("completion replacement preview", storage_sync_review_plan_for_json(snapshot, 1, *plan) != 0)
    text := TextFromCString(plan)
    check_true("completion change is explicit", contains(text, "Completed → Not completed"))
    check_true("new empty days are not additions", !contains(text, "2026-09-05"))
    check_true("missing empty days are not removals", !contains(text, "2026-09-04"))
    check_true("completion is not displayed as a toggle", !contains(text, "OFF") && !contains(text, "ON"))
    sqlite_free(cast(*void)plan)
    check_int("preview preserved completed day", read_db_count("SELECT completed FROM habit_days WHERE habit_id='remote-habit' AND local_date=20260624"), 1)
    storage_close()
}

// Real encrypted fixtures for the historical owner collection and isolated
// Lumi collection. They use the same account seed on two synthetic devices.
bundled_app_record_id_fixture :: (collection: string, key_id: string, record_id: string, app_key: string) -> string {
    key: [32]u8
    fixture: StorageJsonBuilder
    fixture.ok = 1
    if storage_private_collection_key(collection, key_id, *key[0]) == 0 {
        return ""
    }
    storage_json_builder_append_text(*fixture, "[")
    ok := storage_append_encrypted_record_json(*fixture, *key[0], collection,
        key_id, record_id, "cell_record", app_key, 0, now_seconds(), 0)
    SecureWipe(*key[0], 32)
    storage_json_builder_append_text(*fixture, "]")
    result: string = ""
    if ok != 0 && fixture.ok != 0 {
        result = PackageText(AppTextFromCString(fixture.data, cast(s32)(fixture.len + 1)), "")
    }
    storage_json_builder_free(*fixture)
    return result
}

bundled_app_record_fixture :: (collection: string, key_id: string, app_key: string) -> string {
    return bundled_app_record_id_fixture(collection, key_id, app_key, app_key)
}

test_bundled_app_record_identity :: () {
    source := make_root("sync-cell-identity-source")
    target := make_root("sync-cell-identity-target")
    outer := "cell.lumi.message.outer"
    inner := "cell.lumi.message.inner"
    check_true("init record identity source", storage_init(source) != 0)
    set_account()
    check_true("seed encrypted app identity fixture", BundledAppRecordWrite(inner, "Bound history"))
    wrong_lumi := bundled_app_record_id_fixture(LumiPrivateCollection, LumiPrivateKeyID, outer, inner)
    wrong_legacy := bundled_app_record_id_fixture(LegacyPrivateAppsCollection, STORAGE_SYNC_RECORD_KEY_ID, outer, inner)
    correct_lumi := bundled_app_record_fixture(LumiPrivateCollection, LumiPrivateKeyID, inner)
    defer {
        PackageFree(wrong_lumi)
        PackageFree(wrong_legacy)
        PackageFree(correct_lumi)
    }
    storage_close()
    check_true("init record identity target", storage_init(target) != 0)
    set_account()
    check_true("authenticated Lumi outer ID cannot write different embedded key",
        storage_apply_sync_response_json(response_with(1, wrong_lumi)) == 0)
    check_true("authenticated legacy outer ID cannot write different embedded key",
        storage_apply_sync_response_json(response_with(1, wrong_legacy)) == 0)
    check_int("identity mismatch changes no cell", read_db_count("SELECT COUNT(*) FROM settings WHERE key GLOB 'cell.*'"), 0)
    check_int("identity mismatch queues no record", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 0)
    check_int("identity mismatch preserves cursor", cast(s32)storage_meta_int64("sync_last_server_version", 0), 0)
    check_true("matching authenticated ID still restores",
        storage_apply_sync_response_json(response_with(1, correct_lumi)) != 0)
    check_true("matching record data survives", storage_get_setting_text(inner) == "Bound history")
    storage_close()
}

test_bundled_app_plaintext_single_record :: () {
    root := make_root("sync-cell-single-record")
    check_true("init single app record fixture", storage_init(root) != 0)
    set_account()
    record_id := "cell.lumi.message.bound"
    cases: [11]string = .[
    "{\"key\":\"cell.lumi.message.other\",\"value\":\"wrong key\",\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"one\",\"updated_at\":\"2026-10-07T00:00:00Z\"},{\"key\":\"cell.lumi.message.other\",\"value\":\"two\",\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"key\":\"cell.lumi.message.other\",\"value\":\"duplicate key\",\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"\\u006bey\":\"cell.lumi.message.other\",\"value\":\"escaped duplicate key\",\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"one\",\"value\":\"two\",\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"timestamp ambiguity\",\"updated_at\":\"2026-10-07T00:00:00Z\",\"updated_at\":\"2026-10-08T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":{\"nested\":\"not a string\"},\"updated_at\":\"2026-10-07T00:00:00Z\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"missing timestamp\"}",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"unknown field\",\"updated_at\":\"2026-10-07T00:00:00Z\",\"extra\":1}",
    "[{\"key\":\"cell.lumi.message.bound\",\"value\":\"nested record\",\"updated_at\":\"2026-10-07T00:00:00Z\"}]",
    "{\"key\":\"cell.lumi.message.bound\",\"value\":\"trailing object\",\"updated_at\":\"2026-10-07T00:00:00Z\"}{}"
    ]
    for plaintext: cases {
        check_true("malformed single-app plaintext rejected before storage",
            storage_apply_decrypted_record(LumiPrivateCollection, record_id, plaintext) == 0)
    }
    check_true("app record requires authenticated outer ID",
        storage_apply_decrypted_record(LumiPrivateCollection, "", "{\"key\":\"cell.lumi.message.bound\",\"value\":\"unbound\",\"updated_at\":\"2026-10-07T00:00:00Z\"}") == 0)
    check_true("matching outer ID cannot admit Diary to Lumi",
        storage_apply_decrypted_record(LumiPrivateCollection, "cell.diary.file.bound", "{\"key\":\"cell.diary.file.bound\",\"value\":\"wrong scope\",\"updated_at\":\"2026-10-07T00:00:00Z\"}") == 0)
    check_int("malformed plaintext changes no cell", read_db_count("SELECT COUNT(*) FROM settings WHERE key GLOB 'cell.*'"), 0)
    check_int("malformed plaintext queues no record", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 0)
    check_true("one matching app record remains valid",
        storage_apply_decrypted_record(LumiPrivateCollection, record_id, "{\"key\":\"cell.lumi.message.bound\",\"value\":\"one valid record\",\"updated_at\":\"2026-10-07T00:00:00Z\"}") != 0)
    check_true("valid single record data applied", storage_get_setting_text(record_id) == "one valid record")
    storage_close()
}

test_lumi_collection_keys :: () {
    root := make_root("sync-lumi-keys")
    check_true("init isolated key device", storage_init(root) != 0)
    legacy: [32]u8
    lumi: [32]u8
    legacy_hex: [65]u8
    lumi_hex: [65]u8
    check_true("Lumi key needs owner material",
        storage_private_collection_key(LumiPrivateCollection, LumiPrivateKeyID, *lumi[0]) == 0)
    set_account()
    check_true("legacy app key remains available to owner",
        storage_private_collection_key(LegacyPrivateAppsCollection, STORAGE_SYNC_RECORD_KEY_ID, *legacy[0]) != 0)
    check_true("separate Lumi key is available to owner",
        storage_private_collection_key(LumiPrivateCollection, LumiPrivateKeyID, *lumi[0]) != 0)
    unused BytesToHex(*legacy[0], 32, *legacy_hex[0], 65)
    unused BytesToHex(*lumi[0], 32, *lumi_hex[0], 65)
    check_true("Lumi key differs from global legacy key",
        TextFromCString(*legacy_hex[0]) != TextFromCString(*lumi_hex[0]))
    check_true("legacy generation is rejected for Lumi",
        storage_private_collection_key(LumiPrivateCollection, STORAGE_SYNC_RECORD_KEY_ID, *lumi[0]) == 0)
    check_true("Lumi generation is rejected for old apps",
        storage_private_collection_key(LegacyPrivateAppsCollection, LumiPrivateKeyID, *legacy[0]) == 0)
    check_true("Lumi generation is rejected for session history",
        storage_private_collection_key("private.inbe.v1.sessions", LumiPrivateKeyID, *legacy[0]) == 0)
    check_true("unapproved generation is rejected",
        storage_private_collection_key(LumiPrivateCollection, "inbe-lumi-2", *lumi[0]) == 0)
    check_true("legacy session key remains available",
        storage_private_collection_key("private.inbe.v1.sessions", STORAGE_SYNC_RECORD_KEY_ID, *legacy[0]) != 0)
    SecureWipe(*legacy[0], 32)
    SecureWipe(*lumi[0], 32)
    SecureWipe(*legacy_hex[0], 65)
    SecureWipe(*lumi_hex[0], 65)
    storage_close()
}

test_lumi_collection_migration :: () {
    root := make_root("sync-lumi-older-layout")
    check_true("init old collection fixture", storage_init(root) != 0)
    set_account()
    check_true("seed old Lumi history", BundledAppRecordWrite("cell.lumi.message.old", "{\"text\":\"Earlier chat\",\"time\":1,\"user\":1}"))
    check_true("seed old Diary history", BundledAppRecordWrite("cell.diary.file.old", "Earlier diary"))
    check_true("seed old feedback history", BundledAppRecordWrite("cell.feedback.message.old", "Earlier feedback"))
    storage_set_setting_text("lumi_pending_action", "preserved pending command")
    storage_close()
    // This fixture has the pre-upgrade sync layout: the v1 upload/backfill
    // markers are complete and Lumi has no v2 marker or queued copy.
    raw_exec(root, "DELETE FROM sync_outbox;DELETE FROM meta WHERE key='sync_lumi_collection_v2_done';INSERT OR REPLACE INTO meta(key,value) VALUES('sync_full_upload_done','1'),('sync_backfill_v2_done','1');INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('cell_record','cell.diary.file.old',0,123);INSERT INTO settings(user_id,key,value,updated_at) SELECT id,'cell.lumi.INVALID','ignored malformed old key',1 FROM users LIMIT 1;")
    check_true("upgrade old collection fixture", storage_init(root) != 0)
    check_int("Lumi migration marker saved", cast(s32)storage_meta_int64(LumiCollectionMigrationKey, 0), 1)
    check_int("only valid old Lumi history queued", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id GLOB 'cell.lumi.*'"), 1)
    check_int("existing Diary pending upload preserved", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.diary.file.old' AND queued_at=123"), 1)
    check_true("old Lumi plaintext remains intact", storage_get_setting_text("cell.lumi.message.old") == "{\"text\":\"Earlier chat\",\"time\":1,\"user\":1}")
    LumiStoreReset()
    check_int("old conversation remains loadable after migration", LumiStoreCount(), 1)
    check_true("old conversation text remains loadable", LumiStoreRow(0).text == "Earlier chat")
    check_true("old Diary remains intact", storage_get_setting_text("cell.diary.file.old") == "Earlier diary")
    check_true("old feedback remains intact", storage_get_setting_text("cell.feedback.message.old") == "Earlier feedback")
    check_true("pending command remains intact", storage_get_setting_text("lumi_pending_action") == "preserved pending command")
    queued_seq := read_db_count("SELECT MAX(seq) FROM sync_outbox")
    check_true("new-key copies can be uploaded", build_payload())
    check_true("migration payload uses Lumi v2", contains(payload(), "private.inbe.v2.lumi") && contains(payload(), "inbe-lumi-1"))
    check_true("migration keeps Diary in owner collection", contains(payload(), "private.inbe.v1.cells") && contains(payload(), "breathing-main-1"))
    storage_close()
    check_true("restart migrated device", storage_init(root) != 0)
    LumiStoreReset()
    check_int("old conversation remains loadable after restart", LumiStoreCount(), 1)
    check_int("restart does not change queued copies", read_db_count("SELECT MAX(seq) FROM sync_outbox"), queued_seq)
    check_int("restart does not duplicate migration", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 2)
    exec_db_sql("DELETE FROM sync_outbox;")
    storage_close()
    check_true("restart after migration acknowledgement", storage_init(root) != 0)
    check_int("acknowledged migration stays complete", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 0)
    storage_close()
}

test_lumi_collection_migration_rollback :: () {
    root := make_root("sync-lumi-migration-rollback")
    check_true("init interrupted migration fixture", storage_init(root) != 0)
    set_account()
    check_true("seed interrupted old Lumi", BundledAppRecordWrite("cell.lumi.message.interrupted", "Older history"))
    exec_db_sql("DELETE FROM sync_outbox;CREATE TRIGGER block_lumi_marker BEFORE INSERT ON meta WHEN NEW.key='sync_lumi_collection_v2_done' BEGIN SELECT RAISE(ABORT,'synthetic marker failure');END;")
    check_true("migration reports marker failure", storage_migrate_lumi_collection() == 0)
    check_int("failed migration rolls back queued copies", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 0)
    check_int("failed migration does not save marker", cast(s32)storage_meta_int64(LumiCollectionMigrationKey, 0), 0)
    check_true("failed migration retains old history", storage_get_setting_text("cell.lumi.message.interrupted") == "Older history")
    exec_db_sql("DROP TRIGGER block_lumi_marker;")
    storage_close()
    check_true("restart retries interrupted migration", storage_init(root) != 0)
    check_int("retried migration queues one copy", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 1)
    check_int("retried migration saves marker", cast(s32)storage_meta_int64(LumiCollectionMigrationKey, 0), 1)
    storage_close()
}

test_legacy_cells_and_lumi_scope :: () {
    first := make_root("sync-lumi-legacy-source")
    second := make_root("sync-lumi-legacy-restore")
    check_true("init old encrypted record source", storage_init(first) != 0)
    set_account()
    check_true("seed historical combined Lumi", BundledAppRecordWrite("cell.lumi.message.historical", "Historical chat"))
    check_true("seed historical combined Diary", BundledAppRecordWrite("cell.diary.file.historical", "Historical diary"))
    check_true("seed historical combined feedback", BundledAppRecordWrite("cell.feedback.message.historical", "Historical feedback"))
    legacy_lumi := bundled_app_record_fixture(LegacyPrivateAppsCollection, STORAGE_SYNC_RECORD_KEY_ID, "cell.lumi.message.historical")
    legacy_diary := bundled_app_record_fixture(LegacyPrivateAppsCollection, STORAGE_SYNC_RECORD_KEY_ID, "cell.diary.file.historical")
    legacy_feedback := bundled_app_record_fixture(LegacyPrivateAppsCollection, STORAGE_SYNC_RECORD_KEY_ID, "cell.feedback.message.historical")
    forbidden_diary := bundled_app_record_fixture(LumiPrivateCollection, LumiPrivateKeyID, "cell.diary.file.historical")
    forbidden_feedback := bundled_app_record_fixture(LumiPrivateCollection, LumiPrivateKeyID, "cell.feedback.message.historical")
    defer {
        PackageFree(legacy_lumi)
        PackageFree(legacy_diary)
        PackageFree(legacy_feedback)
        PackageFree(forbidden_diary)
        PackageFree(forbidden_feedback)
    }
    storage_close()
    check_true("init historical restore device", storage_init(second) != 0)
    set_account()
    check_true("legacy global-key Lumi remains decryptable", storage_apply_sync_response_json(response_with(1, legacy_lumi)) != 0)
    check_true("legacy global-key Diary remains decryptable", storage_apply_sync_response_json(response_with(2, legacy_diary)) != 0)
    check_true("legacy global-key feedback remains decryptable", storage_apply_sync_response_json(response_with(3, legacy_feedback)) != 0)
    check_true("legacy Lumi restored intact", storage_get_setting_text("cell.lumi.message.historical") == "Historical chat")
    check_true("legacy Diary restored intact", storage_get_setting_text("cell.diary.file.historical") == "Historical diary")
    check_true("legacy feedback restored intact", storage_get_setting_text("cell.feedback.message.historical") == "Historical feedback")
    check_int("late legacy Lumi queues a new-key copy", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.lumi.message.historical'"), 1)
    check_true("migration payload after legacy restore builds", build_payload())
    check_true("legacy Lumi reuploads only to its isolated collection", contains(payload(), "private.inbe.v2.lumi") && !contains(payload(), "private.inbe.v1.cells"))
    check_true("legacy replay acknowledges the migrated copy", storage_apply_sync_response_json(response_with(4, legacy_lumi)) != 0)
    check_int("unchanged legacy replay does not requeue Lumi", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.lumi.message.historical'"), 0)
    check_true("repeated legacy snapshot stays decryptable", storage_apply_sync_response_json(response_with(5, legacy_lumi)) != 0)
    check_int("repeated legacy snapshot leaves upload queue empty", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.lumi.message.historical'"), 0)
    check_true("legacy replay preserves chat history", storage_get_setting_text("cell.lumi.message.historical") == "Historical chat")
    exec_db_sql("UPDATE settings SET value='Older local history',updated_at=1 WHERE key='cell.lumi.message.historical'")
    check_true("changed legacy history still merges", storage_apply_sync_response_json(response_with(6, legacy_lumi)) != 0)
    check_true("changed legacy history restored intact", storage_get_setting_text("cell.lumi.message.historical") == "Historical chat")
    check_int("changed legacy history still queues its isolated copy", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.lumi.message.historical'"), 1)
    check_true("updated migration payload builds", build_payload())
    check_true("updated legacy copy is acknowledged", storage_apply_sync_response_json(response_with(7, legacy_lumi)) != 0)
    check_int("acknowledged updated legacy copy is not requeued", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id='cell.lumi.message.historical'"), 0)
    check_true("cryptographically valid Diary is rejected in Lumi collection", storage_apply_sync_response_json(response_with(8, forbidden_diary)) == 0)
    check_true("cryptographically valid feedback is rejected in Lumi collection", storage_apply_sync_response_json(response_with(8, forbidden_feedback)) == 0)
    check_int("rejected foreign records do not advance sync cursor", cast(s32)storage_meta_int64("sync_last_server_version", 0), 7)
    storage_close()
}

test_bundled_app_records_round_trip :: () {
    first := make_root("sync-cells-a")
    second := make_root("sync-cells-b")
    check_true("init app device a", storage_init(first) != 0)
    set_account()
    LumiStoreReset()
    LumiStoreAppend("Private conversation 水", true)
    LumiStoreAppend("Private reply", false)
    check_true("save private diary", DiaryRecordSave("2026-10-07.json", "{\"text\":\"Private diary 水\"}"))
    photo: [4097]u8
    for index: cast(s32)0..cast(s32)4096 {
        photo[index] = cast(u8)(index % 256)
    }
    // Photos from older versions still arrive as binary chunks.
    check_true("save binary diary photo", save_legacy_photo("photo-test.png", TextFromBytes(photo[:])))
    check_true("save a photo entry", DiaryRecordSave("photo-new.png", TextFromBytes(photo[:4000])))
    check_true("app payload builds", build_payload())
    check_true("Lumi uses separate encrypted collection", contains(payload(), "private.inbe.v2.lumi"))
    check_true("Diary retains legacy owner collection", contains(payload(), "private.inbe.v1.cells"))
    check_true("private chat is absent on wire", !contains(payload(), "Private conversation"))
    check_true("private diary is absent on wire", !contains(payload(), "Private diary"))
    records := records_array()
    check_true("photo fixture exceeds the old bounded payload buffer", payload().count > 16384)
    check_true("full app payload is valid JSON", storage_json_valid(payload()) != 0)
    check_true("app record array is valid JSON", storage_json_valid(records) != 0)
    storage_close()

    check_true("init app device b", storage_init(second) != 0)
    set_account()
    response := response_with(5, records)
    check_true("full app response is valid JSON", storage_json_valid(response) != 0)
    check_true("encrypted app restore", storage_apply_sync_response_json(response) != 0)
    LumiStoreReset()
    check_int("conversation restored", LumiStoreCount(), 2)
    check_true("chat text survives", LumiStoreRow(0).text == "Private conversation 水")
    diary := DiaryRecordRead("2026-10-07.json")
    check_true("diary text survives", diary == "{\"text\":\"Private diary 水\"}")
    PackageFree(diary)
    restored := DiaryRecordRead("photo-test.png")
    check_true("binary photo survives", restored == TextFromBytes(photo[:]))
    PackageFree(restored)
    entry := DiaryMediaRead("photo-new.png")
    check_true("a photo entry arrives without its bytes", entry.valid && entry.size == 4000 &&
        !DiaryMediaUploaded(entry) && DiaryRecordRead("photo-new.png").count == 0)
    check_int("restore does not requeue cells", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='cell_record'"), 0)
    check_true("app collection cannot overwrite signing key",
        storage_apply_decrypted_record("private.inbe.v1.cells", "sync_private_key", "{\"key\":\"sync_private_key\",\"value\":\"forged\",\"updated_at\":\"2026-10-07T00:00:00Z\"}") == 0)
    storage_close()
}

// The app choices a new profile starts with, stored as defaults.
store_default_apps :: () {
    storage_set_setting_default_text("app_used_lists", "0")
    storage_set_setting_default_text("app_used_habits", "1")
    storage_set_setting_default_text("app_used_practices", "1")
    storage_set_setting_default_text("app_used_diary", "0")
    storage_set_setting_default_text("app_used_lumi", "1")
    storage_set_setting_default_text("app_used_leaderboard", "0")
}

// A new device's default apps are never sent, so they cannot remove the
// account's apps. The owner's choices reach the account's other devices,
// each app on its own, and an older record never undoes a newer choice.
test_app_choices_sync_between_devices :: () {
    first := make_root("sync-apps-a")
    second := make_root("sync-apps-b")
    check_true("init apps device a", storage_init(first) != 0)
    set_account()
    store_default_apps()
    storage_set_setting_default_text("app_used_diary", "1")
    check_true("a default never replaces a stored value", storage_get_setting_text("app_used_diary") == "0")
    check_int("defaults are stored at the oldest time",
        read_db_count("SELECT COUNT(*) FROM settings WHERE key LIKE 'app_used_%' AND updated_at=1"), 6)
    check_int("defaults are not queued", read_db_count("SELECT COUNT(*) FROM sync_outbox"), 0)
    // The owner installs Diary and removes Habits on device A.
    storage_set_setting_int("app_used_diary", 1)
    storage_set_setting_int("app_used_habits", 0)
    check_true("device a payload", build_payload())
    check_int("only the owner's two choices go out",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_preference'"), 2)
    check_true("choices go in the app preferences collection",
        contains(payload(), "private.inbe.v1.app-preferences"))
    copy: TextBuffer
    append(*copy, records_array())
    storage_close()

    check_true("init apps device b", storage_init(second) != 0)
    set_account()
    store_default_apps()
    check_true("device b payload", build_payload())
    check_true("a new device's defaults never go out",
        !contains(payload(), "private.inbe.v1.app-preferences"))
    check_true("device b applies a's choices",
        storage_apply_sync_response_json(response_with(3, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("Diary installed on a is installed on b", storage_get_setting_text("app_used_diary") == "1")
    check_true("Habits removed on a is removed on b", storage_get_setting_text("app_used_habits") == "0")
    check_true("b keeps its other apps",
        storage_get_setting_text("app_used_practices") == "1" && storage_get_setting_text("app_used_lists") == "0")
    check_int("b does not send a's choices back",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_preference'"), 0)
    // An older device's record of an earlier choice does not undo Diary.
    check_true("an older choice applies without error",
        storage_apply_decrypted_record("private.inbe.v1.app-preferences", "app_used_diary",
        "{\"key\":\"app_used_diary\",\"value\":\"0\",\"updated_at\":\"2023-11-14T22:13:20Z\"}") != 0)
    check_true("an older choice keeps the newer one", storage_get_setting_text("app_used_diary") == "1")
    check_true("a later removal applies",
        storage_apply_decrypted_record("private.inbe.v1.app-preferences", "app_used_diary",
        "{\"key\":\"app_used_diary\",\"value\":\"0\",\"updated_at\":\"2030-03-17T17:46:40Z\"}") != 0)
    check_true("the later removal wins", storage_get_setting_text("app_used_diary") == "0")
    storage_close()
}

app_order_received :: () -> s32 {
    return storage_get_setting_int(AppOrderReceivedKey, 0)
}

// The pinned apps' order goes to the account's other devices in its own
// collection, which older versions skip. The newest order wins, a pending
// local order wins a tie, and a record this version can't read changes
// nothing without stopping the sync.
test_nested_app_records_sync_between_devices :: () {
    first := make_root("sync-nested-a")
    second := make_root("sync-nested-b")
    key := "nested.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.position"
    check_true("init nested app device a", storage_init(first) != 0)
    set_account()
    storage_set_setting_text(key, "saved nested game")
    check_int("nested record queues once",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_record'"), 1)
    check_true("nested app payload builds", build_payload())
    check_true("nested record uses its own encrypted collection", contains(payload(), NestedAppRecordsCollection))
    check_true("nested game remains encrypted", !contains(payload(), "saved nested game"))
    copy: TextBuffer
    append(*copy, records_array())
    exec_db_sql("DELETE FROM sync_outbox")
    storage_enqueue_all_sync_state()
    check_int("backfill retains nested app records",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_record'"), 1)
    storage_close()

    check_true("init nested app device b", storage_init(second) != 0)
    set_account()
    check_true("device b restores nested app record",
        storage_apply_sync_response_json(response_with(4, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("nested game survives another device", storage_get_setting_text(key) == "saved nested game")
    check_int("restored nested record is not sent back",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_record'"), 0)
    check_true("nested record in legacy collection is ignored without stopping sync",
        storage_apply_decrypted_record("private.inbe.v1.app.chess", key,
        "{\"key\":\"nested.0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.position\",\"value\":\"wrong collection\",\"updated_at\":\"2030-03-17T17:46:40Z\"}") != 0)
    check_true("wrong collection cannot replace nested game", storage_get_setting_text(key) == "saved nested game")
    storage_close()
}

test_app_order_syncs_between_devices :: () {
    first := make_root("sync-order-a")
    second := make_root("sync-order-b")
    check_true("init order device a", storage_init(first) != 0)
    set_account()
    storage_set_setting_text(AppOrderKey, "lumi,diary,habits")
    check_true("order payload", build_payload())
    check_true("the order has its own collection", contains(payload(), "private.inbe.v1.app-order"))
    check_true("the order is encrypted", !contains(payload(), "lumi,diary,habits"))
    copy: TextBuffer
    append(*copy, records_array())
    storage_close()

    check_true("init order device b", storage_init(second) != 0)
    set_account()
    check_true("device b applies the order",
        storage_apply_sync_response_json(response_with(4, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("b has a's order", storage_get_setting_text(AppOrderKey) == "lumi,diary,habits")
    check_int("b's pins take the order", app_order_received(), 1)
    check_int("b does not send a's order back",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_order'"), 0)
    storage_set_setting_int(AppOrderReceivedKey, 0)
    check_true("an older order applies without error",
        storage_apply_decrypted_record(AppOrderCollection, AppOrderKey,
        "{\"key\":\"app_order\",\"value\":\"practices\",\"updated_at\":\"2023-11-14T22:13:20Z\"}") != 0)
    check_true("an older order keeps the newer one", storage_get_setting_text(AppOrderKey) == "lumi,diary,habits")
    check_int("an older order is not taken", app_order_received(), 0)
    unreadable: [4]string = .[
    "{\"key\":\"app_order_tablet\",\"value\":\"lumi\",\"updated_at\":\"2030-03-17T17:46:40Z\"}",
    "{\"key\":\"app_order\",\"value\":{\"apps\":\"lumi\"},\"updated_at\":\"2030-03-17T17:46:40Z\"}",
    "{\"key\":\"app_order\",\"value\":\"lumi\"}",
    "{\"key\":\"app_order\",\"value\":\"lumi\",\"updated_at\":\"2030-03-17T17:46:40Z\"},{\"key\":\"app_order\",\"value\":\"diary\",\"updated_at\":\"2030-03-17T17:46:40Z\"}"
    ]
    for plaintext: unreadable {
        check_true("an unreadable order doesn't stop the sync",
            storage_apply_decrypted_record(AppOrderCollection, AppOrderKey, plaintext) != 0)
    }
    check_true("an unreadable order changes nothing", storage_get_setting_text(AppOrderKey) == "lumi,diary,habits")
    check_int("an unreadable order is not taken", app_order_received(), 0)
    // The owner changes the pins on b while a's same-time order is on its way.
    storage_set_setting_text(AppOrderKey, "habits")
    exec_db_sql("UPDATE settings SET updated_at=1800000000 WHERE key='app_order'")
    check_int("b's own order is queued",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_order'"), 1)
    check_true("a same-time order applies without error",
        storage_apply_decrypted_record(AppOrderCollection, AppOrderKey,
        "{\"key\":\"app_order\",\"value\":\"diary\",\"updated_at\":\"2027-01-15T08:00:00Z\"}") != 0)
    check_true("a pending local order wins a tie", storage_get_setting_text(AppOrderKey) == "habits")
    check_true("a later order applies",
        storage_apply_decrypted_record(AppOrderCollection, AppOrderKey,
        "{\"key\":\"app_order\",\"value\":\"diary\",\"updated_at\":\"2030-03-17T17:46:40Z\"}") != 0)
    check_true("the later order wins", storage_get_setting_text(AppOrderKey) == "diary")
    check_int("the later order is taken", app_order_received(), 1)
    // Nothing pinned is an order too.
    check_true("an empty order applies",
        storage_apply_decrypted_record(AppOrderCollection, AppOrderKey,
        "{\"key\":\"app_order\",\"value\":\"\",\"updated_at\":\"2030-03-17T17:46:41Z\"}") != 0)
    check_true("an empty order unpins everything", storage_get_setting_text(AppOrderKey) == "")
    storage_close()
}

MediaTestHash :: () -> string {
    return "1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988"
}

// The media library syncs in its own collection, private.inbe.v1.media,
// which released versions skip as an unknown collection. A record of a kind
// or shape this version cannot read changes nothing and never stops a sync.
test_media_records_sync_between_devices :: () {
    first := make_root("sync-media-a")
    second := make_root("sync-media-b")
    check_true("init media device a", storage_init(first) != 0)
    set_account()
    item_key := PackageText(MEDIA_RECORD_PREFIX, MediaTestHash())
    preview_key := PackageText(MEDIA_PREVIEW_PREFIX, MediaTestHash())
    item := "{\"hash\":\"1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\",\"size\":6000,\"type\":\"jpg\",\"name\":\"IMG_2041.jpg\",\"day\":\"2026-10-17\",\"taken\":\"2026-10-17T08:15:00\",\"added\":1792224000,\"trashed\":0}"
    preview := "{\"hash\":\"aa2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\",\"size\":900,\"type\":\"jpg\"}"
    storage_set_setting_text(item_key, item)
    storage_set_setting_text(preview_key, preview)
    check_int("both library records queue",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='media_record'"), 2)
    check_int("no library record queues as an app's",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type IN ('app_record','cell_record')"), 0)
    check_true("library payload builds", build_payload())
    check_true("the library has its own collection", contains(payload(), MediaCollection))
    check_true("no library record goes to an older collection",
        !contains(payload(), "private.inbe.v1.app.media") && !contains(payload(), "private.inbe.v1.cells"))
    check_true("library records are encrypted", !contains(payload(), "IMG_2041"))
    copy: TextBuffer
    append(*copy, records_array())
    storage_enqueue_all_sync_state()
    check_int("a backfill queues the library again",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='media_record'"), 2)
    storage_close()

    check_true("init media device b", storage_init(second) != 0)
    set_account()
    check_true("device b applies the library",
        storage_apply_sync_response_json(response_with(4, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("b has a's photo", storage_get_setting_text(item_key) == item)
    check_true("b has a's preview", storage_get_setting_text(preview_key) == preview)
    check_int("b does not send a's library back",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='media_record'"), 0)
    // A later version's kind of record is kept and syncs on.
    check_true("a later kind applies",
        storage_apply_decrypted_record(MediaCollection, "cell.media.album.summer",
        "{\"key\":\"cell.media.album.summer\",\"value\":\"{\\\"title\\\":\\\"Summer\\\"}\",\"updated_at\":\"2030-03-17T17:46:40Z\"}") != 0)
    check_true("a later kind is kept", storage_get_setting_text("cell.media.album.summer").count > 0)
    unreadable: [5]string = .[
    "{\"key\":\"cell.mediax.1\",\"value\":\"{}\",\"updated_at\":\"2030-03-17T17:46:40Z\"}",
    "{\"key\":\"cell.media.album.other\",\"value\":\"{}\",\"updated_at\":\"2030-03-17T17:46:40Z\"}",
    "{\"key\":\"cell.media.album.summer\",\"value\":\"not json\",\"updated_at\":\"2030-03-17T17:46:41Z\"}",
    "{\"key\":\"cell.media.album.summer\",\"value\":\"{}\"}",
    "{\"key\":\"cell.media.album.summer\",\"value\":\"{}\",\"updated_at\":\"2030-03-17T17:46:42Z\"},{\"key\":\"cell.media.album.summer\",\"value\":\"{}\",\"updated_at\":\"2030-03-17T17:46:42Z\"}"
    ]
    for plaintext: unreadable {
        check_true("an unreadable library record doesn't stop the sync",
            storage_apply_decrypted_record(MediaCollection, "cell.media.album.summer", plaintext) != 0)
    }
    check_true("an unreadable record changes nothing",
        storage_get_setting_text("cell.media.album.summer") == "{\"title\":\"Summer\"}")
    check_int("a mismatched key stores nothing",
        read_db_count("SELECT COUNT(*) FROM settings WHERE key IN ('cell.mediax.1','cell.media.album.other')"), 0)
    // A collection this version does not know, as the library is to
    // released versions, is skipped without stopping the sync.
    check_true("an unknown collection is skipped", storage_decrypted_array_name("private.inbe.v1.media2").count == 0)
    // Trash on b wins over a's older record.
    trashed := "{\"hash\":\"1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\",\"size\":6000,\"type\":\"jpg\",\"name\":\"IMG_2041.jpg\",\"day\":\"2026-10-17\",\"taken\":\"2026-10-17T08:15:00\",\"added\":1792224000,\"trashed\":1}"
    storage_set_setting_text(item_key, trashed)
    exec_db_sql("UPDATE settings SET updated_at=1900000000 WHERE key GLOB 'cell.media.1f2e*'")
    check_true("an older library record applies",
        storage_apply_sync_response_json(response_with(5, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("the newer trash stays", storage_get_setting_text(item_key) == trashed)
    PackageFree(item_key)
    PackageFree(preview_key)
    storage_close()
}

// The record of tests/entity_record_vector.py, sealed with libsodium as
// other apps of the account seal theirs.
ENTITY_VECTOR_ACCOUNT :: "7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d"
ENTITY_VECTOR_KEY :: "c47a6fab7d9d756295c797df5b56e10bed452cf4c1c646d262080f5d99ee9869"
ENTITY_VECTOR_PLAIN :: "{\"added_at\":1792224960,\"caption\":\"Written by another app\",\"hash\":\"1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\",\"height\":3024,\"name\":\"IMG_2041.jpg\",\"size\":6000,\"taken_at\":1792224900,\"type\":\"image/jpeg\",\"width\":4032}"
ENTITY_VECTOR_NONCE :: "AAECAwQFBgcICQoLDA0ODxAREhMUFRYX"
ENTITY_VECTOR_CIPHERTEXT :: ""

// One encrypted record of a sync reply.
entity_reply_record :: (collection: string, id: string, nonce: string, ciphertext: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "[{\"collection\":\"%\",\"id\":\"%\",\"key_id\":\"entity-v1\",", collection, id)
    BuilderPrint(*out, "\"nonce\":\"%\",\"ciphertext\":\"%\",\"updated_at\":\"2030-03-17T17:46:40Z\"}]", nonce, ciphertext)
    return BuilderFinish(out)
}

// Photos of the account's entity data sync as private.entity.v1.photos in
// Daochi's record profile, so every app of the account reads them: libsodium
// seals the same bytes as this version, both ways. A record of another kind,
// or one that does not open, changes nothing and never stops a sync.
test_entity_records_sync_between_devices :: () {
    first := make_root("sync-entity-a")
    second := make_root("sync-entity-b")
    check_true("init entity device a", storage_init(first) != 0)
    set_account()
    storage_set_setting_text("sync_public_id", ENTITY_VECTOR_ACCOUNT)
    key: [32]u8
    check_true("the account has its photos' record key",
        storage_private_collection_key(EntityPhotosCollection, DaochiEntity.ENTITY_RECORD_KEY_ID, *key[0]) != 0)
    key_hex: [65]u8
    unused BytesToHex(*key[0], 32, *key_hex[0], 65)
    check_true("it is the key every app derives", TextFromCString(*key_hex[0]) == ENTITY_VECTOR_KEY)
    check_true("no other key opens photos",
        storage_private_collection_key(EntityPhotosCollection, STORAGE_SYNC_RECORD_KEY_ID, *key[0]) == 0)
    metadata := EntityRecordMetadata.{.account_id = ENTITY_VECTOR_ACCOUNT, .collection = EntityPhotosCollection,
        .id = MediaTestHash(), .schema = ENTITY_PHOTO_SCHEMA}
    plain := ENTITY_VECTOR_PLAIN
    plain_bytes := cast(*TextDescriptor)(*plain)
    nonce_bytes: [24]u8
    for index: cast(s32)0..23 {
        nonce_bytes[index] = cast(u8)index
    }
    ciphertext: Vec(u8)
    nonce: Vec(u8)
    unused storage_private_collection_key(EntityPhotosCollection, DaochiEntity.ENTITY_RECORD_KEY_ID, *key[0])
    check_true("seal the vector's record", EntitySealRecordWith(*key[0], metadata,
        BytesFromPointer(plain_bytes.data, cast(u64)plain.count), nonce_bytes[:], *ciphertext, *nonce))
    check_true("the envelope is libsodium's, byte for byte",
        TextFromBytes(VecSlice(ciphertext, 0, ciphertext.count)) == ENTITY_VECTOR_CIPHERTEXT &&
        TextFromBytes(VecSlice(nonce, 0, nonce.count)) == ENTITY_VECTOR_NONCE)
    VecFree(ciphertext)
    VecFree(nonce)
    SecureWipe(*key[0], 32)
    opened: *u8 = null
    check_true("libsodium's record opens", storage_open_entity_record(EntityPhotosCollection, MediaTestHash(),
        DaochiEntity.ENTITY_RECORD_KEY_ID, ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT, *opened) != 0 &&
        TextFromCString(opened) == ENTITY_VECTOR_PLAIN)
    sqlite_free(cast(*void)opened)
    check_true("a record of another photo does not open", storage_open_entity_record(EntityPhotosCollection,
        "2f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988", DaochiEntity.ENTITY_RECORD_KEY_ID,
        ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT, *opened) == 0)
    check_true("a record of another kind does not open", storage_open_entity_record("private.entity.v1.levels",
        MediaTestHash(), DaochiEntity.ENTITY_RECORD_KEY_ID, ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT, *opened) == 0)
    storage_set_setting_text("sync_public_id", "8e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d7e1d")
    check_true("another account's record does not open", storage_open_entity_record(EntityPhotosCollection,
        MediaTestHash(), DaochiEntity.ENTITY_RECORD_KEY_ID, ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT, *opened) == 0)
    storage_set_setting_text("sync_public_id", ENTITY_VECTOR_ACCOUNT)

    // This device's photo goes out sealed, named by its hash alone.
    item_key := PackageText(ENTITY_PHOTO_PREFIX, MediaTestHash())
    item := "{\"hash\":\"1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\",\"size\":6000,\"type\":\"image/jpeg\",\"taken_at\":1792224900,\"added_at\":1792224960,\"name\":\"IMG_2041.jpg\",\"trashed\":false,\"day\":\"2026-10-17\",\"taken\":\"2026-10-17T08:15:00\",\"capture\":true}"
    storage_set_setting_text(item_key, item)
    check_int("the photo queues once",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='entity_record'"), 1)
    check_true("entity payload builds", build_payload())
    check_true("it goes to the entity data", contains(payload(), "\"collection\":\"private.entity.v1.photos\"") &&
        contains(payload(), "\"key_id\":\"entity-v1\""))
    check_true("its record ID is its hash", contains(payload(), "\"id\":\"1f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988\""))
    check_true("its name never leaves the device", !contains(payload(), "IMG_2041") && !contains(payload(), "entity.photos."))
    check_true("nothing goes to an app's collection", !contains(payload(), "private.inbe.v1.media") &&
        !contains(payload(), "private.inbe.v1.cells"))
    copy: TextBuffer
    append(*copy, records_array())
    storage_enqueue_all_sync_state()
    check_int("a backfill queues the photo again",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='entity_record'"), 1)
    storage_close()

    check_true("init entity device b", storage_init(second) != 0)
    set_account()
    storage_set_setting_text("sync_public_id", ENTITY_VECTOR_ACCOUNT)
    check_true("device b applies a's photo",
        storage_apply_sync_response_json(response_with(4, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("b has a's photo", storage_get_setting_text(item_key) == item)
    check_int("b does not send a's photo back",
        read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='entity_record'"), 0)
    // Another app's record of the same photo: its new field joins, and the
    // fields only this device knows stay.
    other_app := entity_reply_record(EntityPhotosCollection, MediaTestHash(), ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT)
    check_true("another app's record applies", storage_apply_sync_response_json(response_with(5, other_app)) != 0)
    check_true("its field joins", read_db_text(PackageText(PackageText("SELECT json_extract(value,'$.caption') FROM settings WHERE key='",
        item_key), "'")) == "Written by another app")
    check_true("this device's fields stay", read_db_text(PackageText(PackageText("SELECT json_extract(value,'$.day') FROM settings WHERE key='",
        item_key), "'")) == "2026-10-17")
    // Records this version cannot use leave everything as it was.
    before := PackageText(storage_get_setting_text(item_key), "")
    unreadable: [4]string = .[
    entity_reply_record(EntityPhotosCollection, "2f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a79881f2e3d4c5b6a7988",
        ENTITY_VECTOR_NONCE, ENTITY_VECTOR_CIPHERTEXT),
    entity_reply_record("private.entity.v1.levels", "0123456789abcdef0123456789abcdef", ENTITY_VECTOR_NONCE,
        ENTITY_VECTOR_CIPHERTEXT),
    entity_reply_record(EntityPhotosCollection, MediaTestHash(), "AAECAwQFBgcICQoLDA0ODxAREhMUFRYY",
        ENTITY_VECTOR_CIPHERTEXT),
    entity_reply_record(EntityPhotosCollection, MediaTestHash(), ENTITY_VECTOR_NONCE, "e30")
    ]
    for reply: unreadable {
        check_true("an entity record this version cannot use doesn't stop the sync",
            storage_apply_sync_response_json(response_with(6, reply)) != 0)
    }
    check_true("they change nothing", storage_get_setting_text(item_key) == before)
    check_int("they store nothing", read_db_count("SELECT COUNT(*) FROM settings WHERE key GLOB 'entity.*'"), 1)
    // A change b has not sent yet stays when an earlier record arrives, and
    // goes out over it with every field.
    trashed := PackageText(read_db_text(PackageText(PackageText("SELECT json_set(value,'$.trashed',json('true')) FROM settings WHERE key='",
        item_key), "'")), "")
    storage_set_setting_text(item_key, trashed)
    check_int("b's change queues", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='entity_record'"), 1)
    check_true("an earlier record applies", storage_apply_sync_response_json(response_with(7, TextFromCString(*copy.bytes[0]))) != 0)
    check_true("b's Trash stays", read_db_count(PackageText(PackageText("SELECT json_extract(value,'$.trashed') FROM settings WHERE key='",
        item_key), "'")) == 1)
    check_true("b's change goes out", build_payload() && contains(payload(), MediaTestHash()))
    PackageFree(before)
    PackageFree(trashed)
    PackageFree(item_key)
    storage_close()
}

// A hosted game uses the same account collection and canonical ID as the
// standalone Entity provider. New installations pull before uploading an
// old/default campaign, and both devices retain every earned completion.
test_shared_game_progress :: () {
    first := make_root("game-progress-a")
    second := make_root("game-progress-b")
    check_true("open shared progress a", storage_init(first) != 0)
    set_account()
    storage_set_setting_text("sync_public_id", ENTITY_VECTOR_ACCOUNT)
    saved := EntityServiceAnswer("{\"operation\":\"put\",\"kind\":\"game-progress\",\"schema\":\"entity.game-progress.v1\",\"document\":{\"game\":\"shovey.classic\",\"unlocked\":40,\"completed\":\"110\",\"state\":\"advanced\"}}")
    check_true("canonical account record saved", contains(saved, "fd65a3d7ac3d5ceb2d4d96cc5224a740"))
    // A document cached by an older release must not upload its board.
    storage_set_setting_text("entity.game-progress.fd65a3d7ac3d5ceb2d4d96cc5224a740", "{\"game\":\"shovey.classic\",\"unlocked\":40,\"completed\":\"110\",\"state\":\"advanced\"}")
    unused exec_sql("CREATE TRIGGER reject_game_progress BEFORE UPDATE ON settings WHEN NEW.key LIKE 'entity.game-progress.%' BEGIN SELECT RAISE(ABORT,'test write failure'); END")
    failed := EntityServiceAnswer("{\"operation\":\"put\",\"kind\":\"game-progress\",\"schema\":\"entity.game-progress.v1\",\"document\":{\"game\":\"shovey.classic\",\"unlocked\":41,\"completed\":\"111\",\"state\":\"unsaved\"}}")
    check_true("a refused write is never acknowledged", contains(failed, "failed"))
    unused exec_sql("DROP TRIGGER reject_game_progress")
    check_true("first sync downloads before sending game progress", build_payload() &&
        !contains(payload(), EntityGameProgressCollection))
    check_true("initial account pull completes", storage_apply_sync_response_json(response_with(1, "[]")) != 0)
    check_true("shared campaign goes out encrypted", build_payload() && contains(payload(), EntityGameProgressCollection) &&
        !contains(payload(), "advanced") && !contains(payload(), "shovey.classic"))
    copy := PackageText(records_array(), "")
    storage_close()

    check_true("open fresh progress b", storage_init(second) != 0)
    set_account()
    storage_set_setting_text("sync_public_id", ENTITY_VECTOR_ACCOUNT)
    unused EntityServiceAnswer("{\"operation\":\"put\",\"kind\":\"game-progress\",\"schema\":\"entity.game-progress.v1\",\"document\":{\"game\":\"shovey.classic\",\"unlocked\":5,\"completed\":\"001\",\"state\":\"fresh\"}}")
    check_true("fresh copy waits for account download", build_payload() && !contains(payload(), EntityGameProgressCollection))
    check_true("fresh copy accepts account progress", storage_apply_sync_response_json(response_with(2, copy)) != 0)
    reply := EntityServiceAnswer("{\"operation\":\"get\",\"kind\":\"game-progress\",\"game\":\"shovey.classic\"}")
    check_true("shared unlocks never go backwards", contains(reply, "\"unlocked\":40") && contains(reply, "\"completed\":\"111\"") && !contains(reply, "\"state\""))
    local_key := "local.cell.arcade.local.campaign"
    storage_set_setting_text(local_key, "unfinished-device-board")
    check_int("movement is not queued for account sync", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='app_record' AND entity_id LIKE 'local.%'"), 0)
    check_true("unfinished board stays locally readable", storage_get_setting_text(local_key) == "unfinished-device-board")
    check_int("one authoritative campaign row", read_db_count("SELECT COUNT(*) FROM settings WHERE key LIKE 'entity.game-progress.%'"), 1)
    check_int("no wrapper campaign created", read_db_count("SELECT COUNT(*) FROM settings WHERE key LIKE 'cell.shovey.%' OR key LIKE 'nested.%'"), 0)
    storage_enqueue_all_sync_state()
    check_int("backfill never queues unfinished boards", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_id LIKE 'local.%'"), 0)
    check_int("backfill queues one canonical record", read_db_count("SELECT COUNT(*) FROM sync_outbox WHERE entity_type='entity_record'"), 1)
    check_true("union is sent under the shared ID", build_payload() && contains(payload(), "fd65a3d7ac3d5ceb2d4d96cc5224a740"))
    PackageFree(copy)
    storage_close()
}

// Each node has its own media session on this device, apart from the
// sync's; removing a node forgets it and which copies the node holds.
test_node_media_sessions :: () {
    root := make_root("sync-media-sessions")
    check_true("init sessions device", storage_init(root) != 0)
    set_account()
    check_true("add the first node", SyncNodeAdd("https://one.example"))
    check_true("add the second node", SyncNodeAdd("https://two.example"))
    session: Session
    unused AppCopyText("token-two", session.token[:])
    session.expires_at_local = 4000000000
    session.server_time = 1800000000
    session.login_local_time = 1800000000
    MediaSessionSave("https://two.example", *session)
    loaded: Session
    MediaSessionLoad("https://two.example", *loaded, 1800000100)
    check_true("the node's media session is kept", TextUntilNul(loaded.token[:]) == "token-two")
    MediaSessionLoad("https://one.example", *loaded, 1800000100)
    check_true("another node has its own", loaded.token[0] == cast(u8)0)
    sync: Session
    LoadSavedSession(*sync, 1800000100)
    check_true("the sync's session is apart", sync.token[0] == cast(u8)0)
    MediaSessionLoad("https://two.example", *loaded, 4000000001)
    check_true("an old session is not used", loaded.token[0] == cast(u8)0)
    exec_db_sql("INSERT INTO diary_blobs(node,blob) VALUES('https://two.example','b1'),('https://one.example','b1')")
    check_true("remove the second node", SyncNodeRemove(1))
    MediaSessionLoad("https://two.example", *loaded, 1800000100)
    check_true("a removed node's session is forgotten", loaded.token[0] == cast(u8)0)
    check_int("a removed node's copies are forgotten",
        read_db_count("SELECT COUNT(*) FROM diary_blobs WHERE node='https://two.example'"), 0)
    check_int("other nodes' copies stay",
        read_db_count("SELECT COUNT(*) FROM diary_blobs WHERE node='https://one.example'"), 1)
    storage_close()
}

test_practice_session_details :: () {
    first := make_root("practice-details-a")
    second := make_root("practice-details-b")
    repetitions: s32 = 3
    id: [96]u8
    details := SessionDetails.{.version = SessionDetailsVersion,
        .duration_seconds = 226, .repetitions = 3, .start_seconds = 8,
        .end_seconds = 6}
    check_true("initialize practice details", storage_init(first) != 0)
    set_account()
    check_true("practice and metadata save together",
        storage_save_session_with_details(*repetitions, 1, 0, 2, *details, *id[0], 96) != 0)
    loaded: SessionDetails
    check_true("practice metadata loads", storage_load_session_details(TextFromCString(*id[0]), *loaded) != 0)
    check_int("actual practice duration retained", loaded.duration_seconds, 226)
    check_int("practice repetitions retained", loaded.repetitions, 3)
    check_int("practice first tempo retained", loaded.start_seconds, 8)
    check_int("practice last tempo retained", loaded.end_seconds, 6)
    before := read_db_count("SELECT COUNT(*) FROM sessions")
    before_queue := read_db_count("SELECT COUNT(*) FROM sync_outbox")
    unused exec_sql("CREATE TEMP TRIGGER reject_session_details BEFORE UPDATE OF details ON sessions BEGIN SELECT RAISE(ABORT,'fixture details write failure'); END")
    repetitions = 4
    failed_id: [96]u8
    check_int("failed metadata rejects the whole session",
        storage_save_session_with_details(*repetitions, 1, 0, 2, *details, *failed_id[0], 96), 0)
    check_int("failed metadata leaves no partial session", read_db_count("SELECT COUNT(*) FROM sessions"), before)
    check_int("failed metadata leaves no queued partial write", read_db_count("SELECT COUNT(*) FROM sync_outbox"), before_queue)
    unused exec_sql("DROP TRIGGER reject_session_details")
    storage_close()
    check_true("initialize metadata receiver", storage_init(second) != 0)
    set_account()
    storage_close()
    check_true("encrypted practice metadata syncs", ship_to(first, second, 1))
    check_true("reopen metadata receiver", storage_init(second) != 0)
    set_account()
    check_true("received metadata loads", storage_load_session_details(TextFromCString(*id[0]), *loaded) != 0)
    check_int("received duration is not repetition count", loaded.duration_seconds, 226)
    check_int("received repetitions retained", loaded.repetitions, 3)
    json: StorageJsonBuilder
    json.ok = 1
    storage_json_builder_append_text(*json, "{\"changes\":{\"sessions\":[{")
    storage_json_builder_key_value_text(*json, "id", TextFromCString(*id[0]))
    storage_json_builder_append_text(*json, ",\"updated_at\":\"2099-01-01T00:00:00Z\",\"mood_after\":4}]}}")
    statement: *void
    check_int("prepare an older client's session edit",
        SqlitePrepareText(storage_db_handle(), SyncSessionsSQL, -1, *statement, null), SQLITE_OK)
    bind_text(statement, 1, AppTextFromCString(json.data, cast(s32)json.len + 1))
    bind_text(statement, 2, AppTextFromCString(storage_user_id_buffer(), 64))
    check_int("apply an older client's session edit", SqliteStep(statement), SQLITE_DONE)
    unused SqliteFinalize(statement)
    storage_json_builder_free(*json)
    check_true("older edit keeps practice metadata", storage_load_session_details(TextFromCString(*id[0]), *loaded) != 0)
    check_int("older edit keeps repetitions", loaded.repetitions, 3)
    check_int("older edit keeps duration", loaded.duration_seconds, 226)
    storage_close()
}

