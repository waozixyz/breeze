    check_int("outbox cleared", count_of(root, "SELECT COUNT(*) FROM sync_outbox"), 0)
    storage_close()
}

test_local_habit_without_activity_does_not_force_review :: () {
    remote_records("review-remote-2", REMOTE_SQL)
    root := local_device("review-empty-habit", "INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('empty-local-habit',(SELECT id FROM users LIMIT 1),'Empty Habit',10,20,30,0,0,1,1,0,1782300000);", "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES('habit','empty-local-habit',0,1782300000);")
    mark_pending_payload_in_flight()
    check_true("apply the snapshot", storage_apply_sync_response_json(snapshot_response(12, "remote-hash-001")) != 0)
    check_true("review is not pending", storage_sync_review_pending() == 0)
    check_int("remote session applied", count_of(root, "SELECT COUNT(*) FROM sessions WHERE id='remote-session'"), 1)
    check_int("remote habit applied", count_of(root, "SELECT COUNT(*) FROM habits WHERE id='remote-habit'"), 1)
    check_int("outbox cleared", count_of(root, "SELECT COUNT(*) FROM sync_outbox"), 0)
    storage_close()
}

// The review works on the visible differences of a snapshot; rows the
// server marks deleted are not among them.
test_review_ignores_deleted_remote_rows :: () {
    root := make_root("review-deleted")
    check_true("init db", storage_init(root) != 0)
    deleted: string = "{\"protocol_version\":6,\"server_version\":13,\"server_state_hash\":\"remote-hash-deleted\",\"full_snapshot_required\":true,\"changes_complete\":false,\"changes\":{\"habits\":[],\"habit_days\":[],\"sessions\":[{\"id\":\"deleted-session\",\"started_at\":\"2026-06-24T10:00:00Z\",\"local_date\":20260624,\"topic\":2,\"activity\":3,\"source\":\"sync-test\",\"rounds_hash\":202,\"deleted_at\":1782300000,\"updated_at\":\"2026-06-24T10:00:00Z\",\"rounds\":[{\"round_index\":0,\"hold_seconds\":55}]}],\"meditation_logs\":[]}}"
    check_true("no visible diff", storage_sync_review_json_has_visible_diff(deleted) == 0)
    check_true("review not pending", storage_sync_review_pending() == 0)
    storage_close()
}

