// Application-level hooks the route and modal code calls; tests that reach
// them do not need their effects. Built as a separate root so no generated
// header declares them twice.

#program_export "app_leave_practice_config"
host_leave_practice_config :: (app: *void) {
    unused app
}

#program_export "settings_audio_stop_preview"
host_stop_audio_preview :: (app: *void) {
    unused app
}

#program_export "profile_social_load_friends_cache"
host_load_friends_cache :: (app: *void) {
    unused app
}

#program_export "node_app_screen_enter"
host_enter_node_app :: (app: *void) {
    unused app
}

// No app from the node is installed in these tests.
#program_export "node_app_screen_opens"
host_node_app_opens :: (slot: s32) -> bool {
    unused slot
    return false
}

#program_export "app_request_social_refresh"
host_request_social_refresh :: (app: *void) {
    unused app
}

#program_export "app_diary_save"
host_diary_save :: () -> bool {
    return true
}

#program_export "app_lumi_session_result"
host_lumi_session_result :: (app: *void) {
    unused app
}

#program_export "app_web_storage_flush"
host_web_storage_flush :: (log_success: s32) {
    unused log_success
}
