#import, file "../src/app/app_style.zi";
#import, file "../src/app/app_types.zi";
#import, file "../src/app/metrics.zi";
#import, file "../src/app/theme_catalog.zi";
#import "drawing_props"
#import "style_sheet"
#import "style"

#program_export
StartupStyleCheck :: () -> s32 {
    for theme: 0..ThemeCount - 1 {
        for style: 1..3 {
            if !StyleInstall(cast(s32)theme, false, cast(s32)style) {
                return 100 + cast(s32)theme * 10 + cast(s32)style * 2
            }
            if !StyleInstall(cast(s32)theme, true, cast(s32)style) {
                return 101 + cast(s32)theme * 10 + cast(s32)style * 2
            }
        }
    }
    return 42
}

#program_export
Answer :: () -> s32 {
    app: InnerBreeze
    app.style_index = 1
    app.theme_id = 0
    if !app_apply_style(*app) { return 1 }
    // Body text takes the theme's Text size.
    if AppFontSize() != 18 || AppSmallFontSize() != 16 { return 13 }
    rules := ActiveStyleRules()
    if rules.count < 20 { return 2 }
    base: StyleData
    facts: StyleFacts = StyleDefaultFacts(StyleKindApp())
    face: StyleData = ResolveStyleRules(rules, base, facts, 1)
    if face.background != cast(u32)0xE2EEFCFF { return 3 }
    canvas := StyleTokenColor("canvas")
    if canvas.r != 0xE2 || canvas.g != 0xEE ||
    canvas.b != 0xFC || canvas.a != 0xFF { return 8 }
    image_face := ResolveStyleRules(rules, base,
        StyleDefaultFacts(StyleKindImage()), 1)
    if image_face.background != cast(u32)0 { return 7 }

    app.style_index = 2
    app.dark_mode = 1
    if !app_apply_style(*app) { return 4 }
    rules = ActiveStyleRules()
    face = ResolveStyleRules(rules, base, facts, 1)
    if face.background != cast(u32)0x182838FF { return 5 }
    canvas = StyleTokenColor("canvas")
    if canvas.r != 0x18 || canvas.g != 0x28 ||
    canvas.b != 0x38 || canvas.a != 0xFF { return 9 }

    app.style_index = 3
    app.dark_mode = 0
    if !app_apply_style(*app) || style_pack_has_glow(3) != 1 ||
    style_pack_id(3) != "lightfield" { return 6 }

    // Unchanged inputs keep the installed style; changed ones replace it.
    app.style_index = 1
    if !app_apply_style(*app) || !app_apply_style(*app) { return 10 }
    canvas = StyleTokenColor("canvas")
    if canvas.r != 0xE2 || canvas.g != 0xEE ||
    canvas.b != 0xFC || canvas.a != 0xFF { return 11 }
    if ActiveStyleRules().count < 20 { return 12 }
    return 42
}
