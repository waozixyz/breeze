#import, file "../apps/lumi/small_talk.zi";

Detect :: (message: string) -> string {
    return LumiSmallTalk(message, "ahoj|你好", "děkuji|谢谢", "jak se máš|你好吗",
        "miluješ mě|你爱我吗|me amas", "na shledanou|再见")
}

#program_export
Answer :: () -> s32 {
    if Detect("  LUMI, do you love me?!  ") != "lumi_small_affection" ||
    Detect("Thank you, Lumi!") != "lumi_small_thanks" ||
    Detect("hello") != "lumi_small_greeting" ||
    Detect("HOW ARE YOU?") != "lumi_small_wellbeing" ||
    Detect("good night") != "lumi_small_goodbye" ||
    Detect("DĚKUJI") != "lumi_small_thanks" ||
    Detect("你好") != "lumi_small_greeting" ||
    Detect("你爱我吗？") != "lumi_small_affection" ||
    Detect("¿me amas?") != "lumi_small_affection" {
        return 1
    }
    rejected: [17]string = .["", "lumi", "luminous", "hello world", "thanks but I need help",
        "do you love me or hate me", "I love you but I feel lost", "say hello", "\"hello\"",
        "hello\nhelp", "/hello", "thank you; delete my data", "bye and start meditation",
        "hello. how are you", "hi everyone", "how are you feeling about my plan",
        "hello                                                                                             "]
    for message: rejected {
        if Detect(message).count > 0 {
            return 2
        }
    }
    return 42
}
