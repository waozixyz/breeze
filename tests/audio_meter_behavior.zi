#import, file "../src/app/audio_meter_host.zi";

#program_export
main :: () -> s32 {
    app_audio_meter_clear()
    app_audio_meter_raise(20)
    app_audio_meter_raise(10)
    app_audio_meter_raise(35)
    if app_audio_meter_take() != 35 {
        return 1
    }
    if app_audio_meter_take() != 0 {
        return 2
    }
    app_audio_meter_raise(-1)
    if app_audio_meter_take() != 0 {
        return 3
    }
    app_audio_meter_raise(50)
    app_audio_meter_clear()
    if app_audio_meter_take() != 0 {
        return 4
    }
    return 0
}
