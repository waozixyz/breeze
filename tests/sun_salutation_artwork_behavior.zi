// Both Sun Salutation figures paint every pose of both rounds soundly.
#import "math"
#import, file "../apps/practice/sun_salutation_artwork.zi";
#import, file "../apps/practice/workout_moves.zi";
#import, file "../src/practices/sun_salutation/sun_salutation_pose.zi";
#import, file "../src/practices/sun_salutation/sun_salutation_rules.zi";
#import, file "../src/practices/tai_chi/tai_chi_flat.zi";
#import, file "../src/practices/tai_chi/tai_chi_math.zi";

artwork_frame: TaiChiFlatFrame;

#program_export
Answer :: () -> s32 {
    // The Sun Salutation woman is the Jade woman of Tai Chi and the workout:
    // the same clothes and hair, cut slimmer.
    original := TaiChiFlatLookNamed("jadeWoman")
    chosen := SunSalutationWomanLook()
    if chosen.top != original.top || chosen.pants != original.pants || chosen.cuff != original.cuff ||
    chosen.hair_style != original.hair_style || chosen.head_scale != original.head_scale {
        return 501
    }
    if !(chosen.limbs < original.limbs && chosen.jacket[7][2] < original.jacket[7][2] && chosen.has_seat) {
        return 502
    }
    rig := WorkoutRig()
    state := SalutationStart(SunSalutationPracticeState.{})
    for character: cast(s32)0..1 {
        state.character = character
        for round: cast(s32)0..1 {
            state.repetition = round
            for step: cast(s32)0..11 {
                state.step = step
                for sample: cast(s32)0..12 {
                    state.step_ticks = sample * 30
                    pose := SunSalutationPoseAt(state, *rig)
                    SunSalutationPaintPose(*artwork_frame, state.character, pose, SunSalutationViewAt(state), 1536.0, 1024.0)
                    if artwork_frame.op_count < 30 || artwork_frame.op_count >= TAI_CHI_FLAT_OP_CAPACITY ||
                    artwork_frame.point_count >= TAI_CHI_FLAT_POINT_CAPACITY {
                        return 503
                    }
                    for index: cast(s32)0..artwork_frame.point_count - 1 {
                        point := artwork_frame.points[index]
                        if !Finite64(point.x) || !Finite64(point.y) {
                            return 507
                        }
                    }
                }
            }
        }
    }
    return 42
}
