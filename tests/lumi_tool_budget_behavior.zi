#import, file "../src/cells/lumi_tool_budget.zi";

#program_export
Answer :: () -> s32 {
    // A style change can need five sequential results before its final reply:
    // read, inspect, preview, inspect the preview, save.
    used: s32
    for round: cast(s32)0..cast(s32)4 {
        if !LumiToolRoundAllowed(round, 1, used) {
            return 1
        }
        used += 1
    }
    if LumiToolRoundAllowed(6, 1, used) ||
    LumiToolRoundAllowed(0, 5, 0) ||
    LumiToolRoundAllowed(0, 1, 12) ||
    LumiToolRoundAllowed(0, 4, 9) {
        return 2
    }
    if !LumiToolRoundAllowed(5, 4, 8) {
        return 3
    }
    return 42
}
