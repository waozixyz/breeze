c :: #system_library "c";
GetEnvironment :: (name: *u8) -> *u8 #foreign c "getenv";

#program_export "app_getenv_bytes"
DelegateFixtureEnvironment :: (name: *u8) -> *u8 {
    if name == null {
        return null
    }
    return GetEnvironment(name)
}

#program_export "app_web_platform"
DelegateFixtureWebPlatform :: () -> s32 {
    return 0
}

// Account crypto/ownership fixtures do not embed UI assets.
#import, file "../src/app/assets.zi";
#program_export "asset_entry_at"
DelegateFixtureAsset :: (index: usize) -> *EmbeddedAssetEntry {
    unused index
    return null
}
#program_export "asset_entry_total"
DelegateFixtureAssetCount :: () -> usize {
    return 0
}
