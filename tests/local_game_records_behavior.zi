#import, file "../src/storage/app_records.zi";
#program_export
main :: () -> s32 {
    if !NodeAppRecordIsLocal("local.campaign") || NodeAppRecordIsLocal("campaign") { return 1 }
    if !NodeAppLocalRecordKeyValid("local.cell.arcade.local.campaign") ||
    NodeAppRecordKeyValid("local.cell.arcade.local.campaign") ||
    NodeAppRecordKeyValid("local.cell.shovey.local.campaign") { return 2 }
    if NodeAppRecordMaySync(true, true) || !NodeAppRecordMaySync(false, true) { return 3 }
    if NodeAppLocalRecordKeyValid("local.cell.arcade.INVALID") { return 4 }
    return 0
}
