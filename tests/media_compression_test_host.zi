// Actual CPU codecs, without creating a graphics context or a window.
Pixels :: #import "kryon/raylib_image_decode";

#program_export "ImagePreviewDecode"
CompressionTestDecode :: (data: string, file_type: string, width: *s32,
    height: *s32, channels: *s32, upright: *bool) -> *u8 {
    width.* = 0; height.* = 0; channels.* = 0; upright.* = false
    image := Pixels.RaylibDecodePixels(data, file_type)
    count: s32 = 0
    if image.format == 1 { count = 1 }
    else if image.format == 2 { count = 2 }
    else if image.format == 4 { count = 3 }
    else if image.format == 7 { count = 4 }
    if image.data == null || image.width <= 0 || image.height <= 0 || count == 0 {
        if image.data != null { Pixels.RaylibImageRelease(image) }
        return null
    }
    width.* = image.width; height.* = image.height; channels.* = count
    return cast(*u8)image.data
}

#program_export "ImagePreviewRelease"
CompressionTestRelease :: (pixels: *u8) {
    if pixels != null {
        Pixels.RaylibImageRelease(Pixels.RaylibGlyphImage.{.data = cast(*void)pixels})
    }
}
