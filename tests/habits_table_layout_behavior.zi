#import, file "../src/screens/habits/table_layout.zi";

Answer :: () -> s32 {
    // A phone keeps the days at their smallest; the name column gets the rest.
    if HabitTableDayWidth(355, 120, 34, 72) != 34 {
        return 1
    }
    if HabitTableDayWidth(400, 120, 34, 72) != 40 {
        return 2
    }
    // A wide window does not stretch the days past their largest.
    if HabitTableDayWidth(900, 120, 34, 72) != 72 {
        return 3
    }
    // Rows above and at the open row stay; rows below move by its details.
    if HabitRowOffset(0, 1, 60, 150) != 0 {
        return 4
    }
    if HabitRowOffset(1, 1, 60, 150) != 60 {
        return 5
    }
    if HabitRowOffset(2, 1, 60, 150) != 270 {
        return 6
    }
    if HabitRowOffset(2, -1, 60, 150) != 120 {
        return 7
    }
    // A phone shows names and seven days.
    phone := HabitTableLayoutFor(355, 150, 120, 36, 30, 72)
    if !phone.names || phone.days != 7 || phone.day_width != 30 ||
    phone.name_width != 145 {
        return 8
    }
    // Narrower, the names give way to icons; the seven days share the rest.
    narrow := HabitTableLayoutFor(300, 150, 120, 36, 30, 72)
    if narrow.names || narrow.days != 7 || narrow.day_width != 37 ||
    narrow.name_width != 41 {
        return 9
    }
    // Narrower still, fewer past days are shown.
    small := HabitTableLayoutFor(200, 150, 120, 36, 30, 72)
    if small.names || small.days != 5 || small.day_width != 32 {
        return 10
    }
    // Nothing is wider than the table, even when it is tiny.
    tiny := HabitTableLayoutFor(50, 150, 120, 36, 30, 72)
    if tiny.days != 1 || tiny.name_width + tiny.day_width * tiny.days > 50 {
        return 11
    }
    return 42
}
