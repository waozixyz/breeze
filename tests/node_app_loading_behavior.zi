#import, file "../src/screens/node_app_loading.zi";

#program_export
main :: () -> s32 {
    state: NodeScreenLoadingState
    // The first frame is covered even when it hasn't requested images yet.
    if !NodeScreenNeedsCover(*state, 1, true) { return 1 }
    if !NodeScreenNeedsCover(*state, 1, false) { return 2 }
    if !NodeScreenNeedsCover(*state, 1, false) { return 3 }
    if NodeScreenNeedsCover(*state, 1, true) { return 4 }
    // Turning the player requests a new sprite. The visible game stays up
    // while that picture decodes, including across consecutive moves.
    if NodeScreenNeedsCover(*state, 1, false) { return 5 }
    if NodeScreenNeedsCover(*state, 1, false) { return 6 }
    if NodeScreenNeedsCover(*state, 1, true) { return 7 }
    // Opening a different child still waits for its initial pictures.
    if !NodeScreenNeedsCover(*state, 2, false) { return 8 }
    if !NodeScreenNeedsCover(*state, 2, false) { return 9 }
    if NodeScreenNeedsCover(*state, 2, true) { return 10 }
    // Returning to a shown game never puts a loading screen under movement.
    if NodeScreenNeedsCover(*state, 1, false) { return 11 }
    // A different host has its own loading lifecycle.
    other: NodeScreenLoadingState
    if !NodeScreenNeedsCover(*other, 1, true) { return 12 }
    if NodeScreenNeedsCover(*other, 1, true) { return 13 }
    return 0
}
