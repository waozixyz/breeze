#import, file "../src/habits/habit_types.zi";
#import, file "../src/habits/habit_calendar.zi";
#import, file "../src/habits/habit_days.zi";

#program_export
CalendarAnswer :: () -> s32 {
    if habit_weekday_bit(20260105) != 0 { return 1 }
    if habit_weekday_bit(20260925) != 4 { return 2 }
    if habit_weekday_bit(20240229) != 3 { return 3 }
    if habit_weekday_bit(20000229) != 1 { return 4 }
    if habit_weekday_bit(21000229) != -1 { return 5 }
    if habit_weekday_bit(20261301) != -1 { return 6 }
    return 42
}

#program_export
Answer :: () -> s32 {
    if CalendarAnswer() != 42 { return 1 }
    habit: Habit
    if habit_scheduled_day(*habit, 20260925) != 1 { return 7 }
    habit.weekdays = 16
    if habit_scheduled_day(*habit, 20260925) != 1 { return 8 }
    if habit_scheduled_day(*habit, 20260105) != 0 { return 9 }
    habit.weekdays = HABIT_SCHEDULE_OFF
    if habit_scheduled_day(*habit, 20260925) != 0 { return 10 }
    habit.counter_enabled = 1
    habit.counter_target = 3
    if habit_counting_enabled(*habit) != 1 ||
       habit_counter_target(*habit) != 3 { return 11 }
    days: [2]HabitDay
    days[0].day_index = 20260925
    days[0].count = 2
    days[0].completed = 1
    days[1].day_index = 20260926
    days[1].count = 3
    habit.days = *days[0]
    habit.day_count = 2
    habit.day_capacity = 2
    if HabitCompletedFor(*habit, 20260925) ||
       !HabitCompletedOnDay(days[:], 20260926, true, 3) ||
       !HabitCompletedOnDay(days[:], 20260925, false, 3) ||
       HabitCompletedOnDay(days[:], 20260924, false, 1) {
        return 12
    }
    habit.day_count = 3
    if HabitCompletedFor(*habit, 20260926) == false { return 13 }
    return 42
}
