#import, file "../src/practices/patterns/patterns_rules.zi";

#program_export
Answer :: () -> s32 {
    expected := "44444780505040600000"
    if patterns_preset_count() != 5 { return 1 }
    preset: s32 = 0
    while preset < 5 {
        part: s32 = 0
        while part < 4 {
            if patterns_preset_ratio(preset, part) !=
                cast(s32)expected[preset * 4 + part] - 48 {
                return 2
            }
            part += 1
        }
        preset += 1
    }
    if patterns_preset_ratio(-1, 0) != 4 ||
        patterns_preset_ratio(5, 0) != 4 ||
        patterns_preset_ratio(0, -1) != 0 ||
        patterns_preset_ratio(0, 4) != 0 {
        return 3
    }
    if patterns_preset_label_key(0) != "patterns_preset_box" ||
        patterns_preset_label_key(4) != "patterns_preset_custom" {
        return 4
    }
    return 42
}
