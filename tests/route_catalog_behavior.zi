#import, file "../src/app/route_catalog.zi";
#import, file "../src/core/types.zi";

#program_export
Answer :: () -> s32 {
    if ScreenForPath("start") != ScreenStart { return -1 }
    if ScreenForPath("session") != ScreenSession { return -2 }
    if ScreenForPath("meditation") != ScreenMeditation { return -3 }
    if ScreenForPath("sun_salutation") != ScreenSunSalutation { return -4 }
    if ScreenForPath("patterns") != ScreenPatterns { return -5 }
    if ScreenForPath("results") != ScreenResults { return -6 }
    if ScreenForPath("settings") != ScreenSettings { return -7 }
    if ScreenForPath("language") != ScreenLanguage { return -8 }
    if ScreenForPath("manual") != ScreenManual { return -9 }
    if ScreenForPath("profile") != ScreenProfile { return -10 }
    if ScreenForPath("habits") != ScreenHabits { return -11 }
    if ScreenForPath("elist") != ScreenEList { return -12 }
    if ScreenForPath("customize_nav") != ScreenCustomizeNav { return -13 }
    if ScreenForPath("habit_edit") != ScreenHabitEdit { return -14 }
    if ScreenForPath("habit_session_edit") != ScreenHabitSessionEdit {
        return -15
    }
    if ScreenForPath("#/settings?tab=audio") != ScreenSettings { return -16 }
    if ScreenForPath("") != -1 || ScreenForPath("missing") != -1 {
        return -17
    }
    return 42
}
