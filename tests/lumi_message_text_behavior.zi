#import, file "../apps/lumi/message_text.zi";
#import "byte_text_linux"

#program_export
Answer :: () -> s32 {
    value := LumiFormatMessage("Try **breathing slowly** and __rest__.", true)
    if TextFromBytes(value.bytes[:value.count]) != "Try breathing slowly and rest." ||
    value.strong_count != 2 || value.strong[0].start != 4 || value.strong[0].end != 20 ||
    value.strong[1].start != 25 || value.strong[1].end != 29 {
        return 1
    }
    value = LumiFormatMessage("**水を飲む**\n**té**", true)
    if TextFromBytes(value.bytes[:value.count]) != "水を飲む\nté" || value.strong_count != 2 ||
    value.strong[0].end != 12 || value.strong[1].start != 13 || value.strong[1].end != 16 {
        return 2
    }
    value = LumiFormatMessage("unclosed **bold, ***literal***, ** spaces **", true)
    if TextFromBytes(value.bytes[:value.count]) != "unclosed **bold, ***literal***, ** spaces **" || value.strong_count != 0 {
        return 3
    }
    value = LumiFormatMessage("`**code**` and \\**literal**", true)
    if TextFromBytes(value.bytes[:value.count]) != "`**code**` and **literal**" || value.strong_count != 0 {
        return 4
    }
    value = LumiFormatMessage("**user input**", false)
    if TextFromBytes(value.bytes[:value.count]) != "**user input**" || value.strong_count != 0 {
        return 5
    }
    return 42
}
