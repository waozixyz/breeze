// The real node-app host imports native widgets as well as hosted ones.
// Photos' UI is observed by ScreenCall in photos_app_behavior, so none of
// these native backend effects may run. Supply their current Kryon ABI for
// linking, and fail if a widget bypasses the test's hosted observations.
#import "drawing_props"
#import "geometry"

c :: #system_library "c";
UnexpectedNativeUi :: (code: s32) #foreign c "exit";

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused value
    unused font
    unused typeface
    UnexpectedNativeUi(70)
    return 0
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused font
    unused typeface
    UnexpectedNativeUi(70)
    return 0
}

#program_export
ImageWidth :: (path: string) -> s32 {
    unused path
    UnexpectedNativeUi(70)
    return 0
}

#program_export
ImageHeight :: (path: string) -> s32 {
    unused path
    UnexpectedNativeUi(70)
    return 0
}

