#import, file "../src/apps/download_recovery.zi";
#import, file "../src/apps/asset_paths.zi";
#import, file "../src/apps/module_types.zi";

#program_export
main :: () -> s32 {
    recovery: DownloadRecovery
    if !DownloadRecoverySchedule(*recovery, 100) || recovery.attempts != 1 ||
        recovery.retry_at != 102 || DownloadRecoveryReady(recovery, 101) ||
        !DownloadRecoveryReady(recovery, 102) { return 1 }
    if !DownloadRecoverySchedule(*recovery, 102) || recovery.retry_at != 110 { return 2 }
    if !DownloadRecoverySchedule(*recovery, 110) || recovery.retry_at != 140 { return 3 }
    if DownloadRecoverySchedule(*recovery, 140) || recovery.attempts != 3 { return 4 }
    recovery = DownloadRecovery.{}
    if DownloadRecoverySchedule(*recovery, -1) ||
        DownloadRecoverySchedule(*recovery, 9223372036854775807) { return 5 }
    if !DownloadRetryable(0) || !DownloadRetryable(408) || !DownloadRetryable(429) ||
        !DownloadRetryable(503) || DownloadRetryable(403) || DownloadRetryable(404) ||
        DownloadRetryable(200) || DownloadRetryable(600) { return 6 }
    if !PackageResourceValid("assets/practices/workout/banner.webp", MODULE_PRACTICE) { return 7 }
    invalid: [8]string = .["assets/practices/../publishers.json",
        "assets/practices//banner.webp", "assets/practices/./banner.webp",
        "/assets/practices/banner.webp", "assets/practices/",
        "assets/practices-foreign/banner.webp", "assets/publishers.json",
        "assets/practices/../../userdata.db"]
    for path: invalid {
        if PackageResourceValid(path, MODULE_PRACTICE) { return 8 }
    }
    if PackageResourceValid("assets/practices/workout/banner.webp", MODULE_HABITS) { return 9 }
    return 0
}
