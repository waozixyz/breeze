#import, file "../src/habits/habit_date.zi";

#program_export
Answer :: () -> s32 {
    if HabitDayIndexAgo(2024, 3, 1, 1) != 20240229 { return 1 }
    if HabitDayIndexAgo(2025, 1, 1, 1) != 20241231 { return 2 }
    if HabitDayIndexAgo(2026, 9, 26, 0) != 20260926 { return 3 }
    if HabitDayIndexAgo(2026, 2, 30, 1) != 0 { return 4 }
    if HabitDayIndexAgo(1970, 1, 1, 1) != 0 { return 5 }
    return 42
}
