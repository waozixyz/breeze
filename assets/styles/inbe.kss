tokens {
  color {
    panel: #202631;
    panel-hover: #2a3140;
    panel-pressed: #181d26;
  }
}

Text.practice-heading {
    foreground: text;
}
Text.muted {
    foreground: muted;
}
Text.selected-navigation {
    foreground: text;
}
Text.circle-ink {
    foreground: #171022;
}

// Style packs pair their own accent-soft with accent text. Inbe replaces
// accent with the theme button color, which can be as dark as accent-soft,
// so selected soft buttons use the theme accent and its computed ink.
Button[tone=Accent][emphasis=Soft] {
    background: accent;
    background-end: accent;
    foreground: accent-ink;
    border: accent;
}

Button.practice-pager {
    font-size: 42;
}

TitleBar[role=Bar] {
    background: canvas;
    border: border-soft;
    border-width: 0;
}

TitleBar[role=Title] {
    font-size: 20;
}

TitleBar[role=Action] {
    background: panel;
    border: transparent;
    border-width: 0;
    icon-size: 24;
}

TitleBar[role=Action]:hover {
    background: panel-hover;
}

TitleBar[role=Action]:pressed {
    background: panel-pressed;
}

Image {
    foreground: #ffffff;
    background: #00000000;
    border: #00000000;
    radius: 0;
    border-width: 0;
    material: flat;
    opacity: 1;
}

Card {
    foreground: text;
    background: surface;
    border: border;
    radius: 16;
    border-width: 1;
}

Image.pose-muted {
    opacity: 0.62;
}
