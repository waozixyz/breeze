Text.practice-heading {
    foreground: #f6f8fc;
}
Text.selected-navigation {
    foreground: text;
}
Text.circle-ink {
    foreground: #171022;
}

// Style packs pair their own accent-soft with accent text. Inbe replaces
// accent with the theme button color, which can be as dark as accent-soft,
// so selected soft buttons use the theme accent and its computed ink.
Button[tone=Accent][emphasis=Soft] {
    background: accent;
    background-end: accent;
    foreground: accent-ink;
    border: accent;
}

Button.practice-pager {
    font-size: 42;
}

Image.pose-muted {
    opacity: 0.62;
}

Text.practice-subtitle {
    foreground: #cad5e5;
}

Image.practice-banner {
    radius: 24;
}

Text.practice-metadata {
    foreground: #f6f8fc;
}

Text.practice-counter {
    foreground: muted;
}

Button.practice-start {
    font-size: 20;
    radius: 14;
}

Button.profile-header {
    background: surface;
    background-end: surface;
    border: border-soft;
    border-width: 1;
    radius: 16;
}

Button.profile-header:hover {
    background: panel-hover;
    background-end: panel-hover;
    border: border-hover;
}

Button.profile-header:pressed {
    background: panel-pressed;
    background-end: panel-pressed;
}

Button.profile-header:selected {
    border: focus;
    border-width: 2;
}

Button.profile-header:focus {
    border: focus;
    border-width: 2;
}

Text.profile-name {
    foreground: text;
}

Text.profile-username {
    foreground: muted;
}
