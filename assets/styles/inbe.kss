Text.practice-heading {
    foreground: #f6f8fc;
}
Text.selected-navigation {
    foreground: text;
}
Text.circle-ink {
    foreground: #171022;
}

// Style packs pair their own accent-soft with accent text. Inbe replaces
// accent with the theme button color, which can be as dark as accent-soft,
// so selected soft buttons use the theme accent and its computed ink.
Button[tone=Accent][emphasis=Soft] {
    background: accent;
    background-end: accent;
    foreground: accent-ink;
    border: accent;
}

Button.practice-pager {
    font-size: 42;
}

Image.pose-muted {
    opacity: 0.62;
}

Text.practice-subtitle {
    foreground: #cad5e5;
}

Image.practice-banner {
    radius: 24;
}

Text.practice-metadata {
    foreground: #f6f8fc;
}

Text.practice-counter {
    foreground: muted;
}

Button.practice-start {
    font-size: 20;
    radius: 14;
}
