// These profile action colors are used with every style pack. Some packs do
// not declare them; the app's theme overrides supply their final colors.
tokens {
    color {
        panel-hover: #2a3140;
        panel-pressed: #181d26;
        border-hover: #4a5363;
        focus: #c9a8ff;
        review-added: #17663a;
        review-removed: #b3261e;
        review-changed: #805000;
        launcher-canvas: #14202b;
        launcher-panel: #1d2c39;
        launcher-hover: #293d4c;
        launcher-text: #e6eff3;
        launcher-muted: #adc1cd;
        launcher-selection: #99deb8;
        launcher-ink: #18352a;
        launcher-selected-hover: #8fd0ad;
        launcher-selected-pressed: #84c2a2;
        launcher-border: #344957;
    }
}

Text.review-added {
    foreground: review-added;
}
Text.review-removed {
    foreground: review-removed;
}
Text.review-changed {
    foreground: review-changed;
}
Text.review-detail {
    foreground: muted;
}
Text.review-heading {
    foreground: text;
}

Text.practice-heading {
    foreground: text;
}
Text.selected-navigation {
    foreground: text;
}
Text.circle-ink {
    foreground: #171022;
}

// Style packs pair their own accent-soft with accent text. Inbe replaces
// accent with the theme button color, which can be as dark as accent-soft,
// so selected soft buttons use the theme accent and its computed ink.
Button[tone=Accent][emphasis=Soft] {
    background: accent;
    background-end: accent;
    foreground: accent-ink;
    border: accent;
}

Button.practice-pager {
    font-size: 42;
}

Image.pose-muted {
    opacity: 0.62;
}

Button.profile-header {
    background: surface;
    background-end: surface;
    border: border-soft;
    border-width: 1;
    radius: 16;
}

Button.profile-header:hover {
    background: panel-hover;
    background-end: panel-hover;
    border: border-hover;
}

Button.profile-header:pressed {
    background: panel-pressed;
    background-end: panel-pressed;
}

Button.profile-header:selected {
    border: focus;
    border-width: 2;
}

Button.profile-header:focus {
    border: focus;
    border-width: 2;
}

Text.profile-name {
    foreground: text;
}

Text.profile-username {
    foreground: muted;
}

// The app library and its compact dock share the active app palette.
Text.launcher-title { foreground: launcher-text; font-size: 28; }
Text.launcher-heading { foreground: launcher-text; font-size: 16; }
Text.launcher-muted { foreground: launcher-muted; }
Button.launcher-tile {
    background: launcher-panel;
    background-end: launcher-panel;
    foreground: launcher-text;
    border: launcher-border;
    border-width: 1;
    radius: 14;
    font-size: 14;
    icon-size: 24;
    gap: 8;
}
Button.launcher-tile:hover {
    background: launcher-hover;
    background-end: launcher-hover;
}
Button.launcher-tile:pressed {
    background: launcher-hover;
    background-end: launcher-hover;
    border: launcher-selection;
}
Button.launcher-tile[tone=Accent][emphasis=Filled] {
    background: launcher-selection;
    background-end: launcher-selection;
    foreground: launcher-ink;
    border: launcher-text;
    border-width: 2;
}
Button.launcher-tile[tone=Accent][emphasis=Filled]:hover {
    background: launcher-selected-hover;
    background-end: launcher-selected-hover;
}
Button.launcher-tile[tone=Accent][emphasis=Filled]:pressed {
    background: launcher-selected-pressed;
    background-end: launcher-selected-pressed;
}
// The install or remove symbol inside an app card uses its card's ink.
Button.launcher-action {
    background: #00000000;
    background-end: #00000000;
    foreground: launcher-text;
    border: #00000000;
    radius: 10;
}
Button.launcher-action:hover {
    background: launcher-hover;
    background-end: launcher-hover;
}
Button.launcher-action[tone=Accent] {
    foreground: launcher-ink;
}
Button.launcher-action[tone=Accent]:hover {
    background: launcher-selected-pressed;
    background-end: launcher-selected-pressed;
}
NavigationBar.launcher-dock { background: launcher-canvas; }
NavigationBarItem.launcher-dock {
    background: #00000000;
    background-end: #00000000;
    foreground: launcher-text;
    border: #00000000;
    border-width: 0;
    radius: 14;
    font-size: 12;
    icon-size: 24;
    gap: 2;
    padding-x: 3;
    padding-y: 6;
    offset-x: 0;
    offset-y: 0;
}
NavigationBarItem.launcher-dock:hover { background: launcher-hover; background-end: launcher-hover; padding-x: 3; padding-y: 6; }
NavigationBarItem.launcher-dock:pressed { background: launcher-panel; background-end: launcher-panel; }
// Filled accent identifies the active route even during hover and press.
NavigationBarItem.launcher-dock[tone=Accent][emphasis=Filled] {
    background: launcher-selection;
    background-end: launcher-selection;
    foreground: launcher-ink;
    border: launcher-text;
    border-width: 2;
    padding-x: 3;
    padding-y: 6;
}
NavigationBarItem.launcher-dock[tone=Accent][emphasis=Filled]:hover {
    background: launcher-selected-hover;
    background-end: launcher-selected-hover;
}
NavigationBarItem.launcher-dock[tone=Accent][emphasis=Filled]:pressed {
    background: launcher-selected-pressed;
    background-end: launcher-selected-pressed;
}
Button.launcher-pin {
    background: #00000000;
    background-end: #00000000;
    foreground: launcher-muted;
    border: #00000000;
    border-width: 0;
    icon-size: 18;
    radius: 12;
}
Button.launcher-pin:hover { background: launcher-hover; background-end: launcher-hover; foreground: launcher-text; }
Button.launcher-pin:selected { foreground: launcher-selection; }
Button.launcher-edit {
    foreground: launcher-muted;
    font-size: 12;
    border: #00000000;
    border-width: 0;
    background: #00000000;
    background-end: #00000000;
}
Button.launcher-edit:hover { foreground: launcher-text; background: launcher-hover; background-end: launcher-hover; }
TextField.launcher-search {
    background: launcher-panel;
    foreground: launcher-text;
    border: launcher-border;
    border-width: 1;
    radius: 14;
}
