    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_setting",
    "description": "Change one app preference. Scale is in tenths (5 to 25), navigation is automatic/left/bottom/right/top (0 to 4), compact sidebar is 0 or 1, style is material/classic/lightfield (1 to 3).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "scale",
            "navigation",
            "sidebar_compact",
            "style"
