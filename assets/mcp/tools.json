            "dawn",
            "sage",
            "sepia",
            "mono",
            "mint",
            "cobalt",
            "sweet"
          ]
        }
      },
      "required": [
        "theme"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_theme_mode",
    "description": "Change and save light, dark or device-following mode.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_setting",
    "description": "Change one app preference. Scale is in tenths (5 to 25), navigation is automatic/left/bottom/right/top (0 to 4), compact sidebar is 0 or 1, style is material/classic/lightfield (1 to 3).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "scale",
            "navigation",
            "sidebar_compact",
            "style"
          ]
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "open_view",
