    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "complete_habit",
    "description": "Complete a habit for today using its exact ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "write_diary",
    "description": "Append the requested text to today's diary with the current time. Preserve the user's wording.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_diary",
    "description": "Read the diary entry for a date when the user asks for it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "required": [
        "date"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  {
    "name": "report_feedback",
    "description": "Save an app bug report or suggestion and queue it for the developer. Preserve the original report; exclude unrelated personal data. This reports feedback; it does not fix code.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "title",
        "message"
      ],
      "additionalProperties": false
    }
  }
