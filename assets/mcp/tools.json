    "inputSchema": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "lumi",
            "habits",
            "lists",
            "practices",
            "diary",
            "settings",
            "appearance"
          ]
        }
      },
      "required": [
        "view"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "practice",
