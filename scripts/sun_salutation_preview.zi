// Offscreen entry for the same renderer and artwork used by the player.
#import, file "../apps/practice/sun_salutation_artwork.zi";
#import, file "../apps/practice/workout_moves.zi";
#import, file "../src/practices/sun_salutation/sun_salutation_pose.zi";
#import, file "../src/practices/sun_salutation/sun_salutation_rules.zi";
#import, file "../src/practices/tai_chi/tai_chi_flat.zi";
#import, file "../src/practices/tai_chi/tai_chi_rules.zi";

preview_frame: TaiChiFlatFrame;
preview_framing: TaiChiFraming;

PreviewState :: () -> SunSalutationPracticeState {
    state: SunSalutationPracticeState
    state.repetitions = 2
    state.start_seconds = 6
    state.end_seconds = 6
    return SalutationStart(state)
}

#program_export
PreviewDuration :: () -> float64 {
    return cast(float64)SalutationDurationSeconds(PreviewState())
}

#program_export
PreviewFrame :: (second: float64, width: s32, height: s32) -> *TaiChiFlatFrame {
    state := SalutationAdvance(PreviewState(), second).state
    rig := WorkoutRig()
    pose := SunSalutationPoseAt(state, *rig)
    preview_framing = SunSalutationPaintPose(*preview_frame, state.character, pose, SunSalutationViewAt(state),
        cast(float64)width, cast(float64)height)
    return *preview_frame
}

#program_export
PreviewHeight :: () -> float64 {
    return preview_framing.view_height
}

#program_export
PreviewCenter :: () -> float64 {
    return preview_framing.view_center
}
