// Radio is an installable node app. Selection, saved preferences and UI
// live in this bundle; the host owns the stream after the screen is left.
#import "session"
#import "geometry"
#import "std/text"
#import "vec"
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Image :: #import "kryon/image";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
#import "text_align"
#import "drawing_props"
#import "input_protocol"
#import "pointer_input"
#import "control_props"
#import "kryon/tree"
#import "apps/node_types"
#import, file "../../src/apps/module_types.zi";
#import, file "stations.zi";

host_api :: #system_library "host_api";
ReadAppHost :: () -> AppMessage #foreign host_api;
WriteAppHost :: (message: AppMessage) #foreign host_api;
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;
AppLocaleHost :: (key: string) -> string #foreign host_api;
AppRecordHost :: (record: string) -> string #foreign host_api;
SaveAppRecordHost :: (record: string, value: string) -> bool #foreign host_api;
AudioStartHost :: (url: string) -> bool #foreign host_api;
AudioStopHost :: () -> bool #foreign host_api;
AudioStateHost :: () -> s32 #foreign host_api;
AudioVolumeHost :: (percent: s32) -> bool #foreign host_api;

using Text.Wrap;
using Image.ImageFit;
using ButtonTone;
using ButtonEmphasis;

loaded: bool;
loaded_account: string;
selected: s32;
volume: s32 = 60;
failed: bool;
scroll_offset: s32;
drag_control: s32;
drag_origin: float32;
drag_value: s32;
drag_moved: bool;

ReadPercent :: (value: string) -> s32 {
    if value.count == 0 || value.count > 3 { return 60 }
    answer: s32 = 0
    for index: cast(s64)0..value.count - 1 {
        if value[index] < cast(u8)48 || value[index] > cast(u8)57 { return 60 }
        answer = answer * 10 + cast(s32)value[index] - 48
    }
    if answer > 100 { return 60 }
    return answer
}

RadioLoad :: (account: string) {
    if loaded && loaded_account == account { return }
    loaded_account = account
    selected = 0
    failed = false
    drag_control = 0
    saved := AppRecordHost("station")
    for index: cast(s32)0..RADIO_STATION_COUNT - 1 {
        if saved == StationStream(index) { selected = index }
    }
    volume = ReadPercent(AppRecordHost("volume"))
    loaded = true
}

RadioStart :: () {
    failed = !AudioStartHost(StationStream(selected))
    if !failed { unused AudioVolumeHost(volume) }
}

// The cabinet is the control surface. Power is independent; the two knobs
// retain ordinary button focus/activation and pointer drags.
RadioVolume :: (next: s32) {
    if next < 0 { next = 0 }
    if next > 100 { next = 100 }
    if next == volume { return }
    volume = next
    unused AudioVolumeHost(volume)
    saved: Vec(u8)
    BuilderPrint(*saved, "%", volume)
    unused SaveAppRecordHost("volume", BuilderFinish(saved))
}

RadioTune :: (next: s32) {
    if next < 0 { next = 0 }
    if next >= RADIO_STATION_COUNT { next = RADIO_STATION_COUNT - 1 }
    if next == selected { return }
    selected = next
    unused SaveAppRecordHost("station", StationStream(selected))
    if AudioStateHost() > 0 { RadioStart() }
}

RadioRect :: (cabinet: Rectangle, x: float32, y: float32,
    width: float32, height: float32) -> Rectangle {
    unit := cabinet.width / 1254.0
    return Rectangle.{cabinet.x + x * unit, cabinet.y + y * unit,
        width * unit, height * unit}
}

RadioTarget :: (bounds: Rectangle, target: float32) -> Rectangle {
    if bounds.width < target {
        bounds.x -= (target - bounds.width) / 2.0
        bounds.width = target
    }
    if bounds.height < target {
        bounds.y -= (target - bounds.height) / 2.0
        bounds.height = target
    }
    return bounds
}

RadioView :: (message: AppMessage) -> AppMessage {
    RadioLoad(message.account)
    frame := ReadAppUiHost()
    margin := cast(s32)(16.0 * frame.scale)
    width := frame.width - margin * 2
    maximum := cast(s32)(620.0 * frame.scale)
    if width > maximum { width = maximum }
    x := (frame.width - width) / 2
    y := frame.top + margin
    viewport := Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width,
        cast(float32)(frame.height - frame.bottom - y)}
    scroll := Scroll.Draw(frame.session, Scroll.Props.{.key = 26000, .bounds = viewport,
            .content_height = width,
            .scroll_offset = scroll_offset, .scale = frame.scale})
    scroll_offset = scroll.scroll_offset
    if !scroll.opened { message.succeeded = true; return message }
    defer { unused End(frame.session) }
    cabinet := Rectangle.{scroll.content.x, scroll.content.y,
        scroll.content.width, scroll.content.width}
    Image.Draw(frame.session, Image.Props.{.key = 26001, .bounds = cabinet,
            .asset_path = "assets/radio/player.avif", .alt_text = "Radio",
            .fit = cast(Image.ImageFit)ImageFitContain, .smooth = true})
    target := 44.0 * frame.scale
    power := RadioTarget(RadioRect(cabinet, 581.0, 766.0, 100.0, 100.0), target)
    volume_control := RadioTarget(RadioRect(cabinet, 680.0, 735.0, 160.0, 160.0), target)
    tuning := RadioTarget(RadioRect(cabinet, 942.0, 735.0, 160.0, 160.0), target)
    pointer := SamplePointer()
    if pointer.pressed {
        drag_control = 0
        drag_moved = false
        if PointInBounds(pointer.x, pointer.y, volume_control) {
            drag_control = 1
            drag_origin = pointer.y
            drag_value = volume
        } else if PointInBounds(pointer.x, pointer.y, tuning) {
            drag_control = 2
            drag_origin = pointer.x
            drag_value = selected
        }
    }
    if pointer.down && drag_control != 0 {
        delta := ifx drag_control == 1 then drag_origin - pointer.y else pointer.x - drag_origin
        if delta > 4.0 * frame.scale || delta < -4.0 * frame.scale { drag_moved = true }
        if drag_moved && drag_control == 1 {
            RadioVolume(drag_value + cast(s32)(delta * 0.75 / frame.scale))
        } else if drag_moved && drag_control == 2 {
            RadioTune(drag_value + cast(s32)(delta / (28.0 * frame.scale)))
        }
    }
    // The illuminated dial shows the actual tuned station.
    dial := RadioRect(cabinet, 654.0, 433.0, 459.0, 186.0)
    for index: cast(s32)0..RADIO_STATION_COUNT - 1 {
        preset := RadioTarget(RadioRect(cabinet,
            767.0 + cast(float32)index * 80.0, 636.0, 80.0, 62.0), target)
        if Button.Draw(frame.session, Button.Props.{.id = 26010 + index, .bounds = preset,
                .label = StationName(index), .selected = selected == index,
                .icon_only = true, .invisible = true,
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 { RadioTune(index) }
    }
    needle := Rectangle.{dial.x + dial.width * (cast(float32)selected + 0.5) / 3.0 - 1.5,
        dial.y + dial.height * 0.12, 3.0, dial.height * 0.76}
    Box.Draw(frame.session, Box.Props.{.key = 26031, .bounds = needle,
            .fill = Color.{.r = 153, .g = 66, .b = 39, .a = 255}})
    state := AudioStateHost()
    label := AppLocaleHost(ifx state > 0 then "radio_stop" else "play_button")
    volume_text: Vec(u8)
    BuilderPrint(*volume_text, "%: %%%", AppLocaleHost("music_volume_label"), volume)
    volume_label := BuilderFinish(volume_text)
    if Button.Draw(frame.session, Button.Props.{.id = 26002, .bounds = power, .label = label,
            .icon_only = true, .invisible = true,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 && !drag_moved {
        if state > 0 {
            unused AudioStopHost()
            failed = false
        } else { RadioStart() }
    }
    if Button.Draw(frame.session, Button.Props.{.id = 26003, .bounds = volume_control,
            .label = AppLocaleHost("music_volume_label"), .detail = volume_label,
            .icon_only = true, .invisible = true,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 && !drag_moved {
        next_volume := volume + 5
        if next_volume > 100 { next_volume = 0 }
        RadioVolume(next_volume)
    }
    if Button.Draw(frame.session, Button.Props.{.id = 26005, .bounds = tuning,
            .label = AppLocaleHost("radio_tuning"), .detail = StationName(selected),
            .icon_only = true, .invisible = true,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 && !drag_moved {
        RadioTune((selected + 1) % RADIO_STATION_COUNT)
    }
    status := "radio_stopped"
    if failed || state < 0 { status = "radio_error" }
    else if state == 1 { status = "radio_connecting" }
    else if state == 2 { status = "radio_playing" }
    else if state == 3 { status = "radio_reconnecting" }
    display_text: Vec(u8)
    BuilderPrint(*display_text, "% · % · %%%",
        AppLocaleHost(status), StationName(selected), volume)
    display := RadioRect(cabinet, 717.0, 575.0, 335.0, 36.0)
    Box.Draw(frame.session, Box.Props.{.key = 26032, .bounds = display,
            .fill = Color.{.r = 63, .g = 31, .b = 18, .a = 220}})
    Text.Draw(frame.session, Text.Props.{.key = 26020, .bounds = display,
            .text = BuilderFinish(display_text), .size = frame.font - 5,
            .align = TextAlign.TextAlignCenter,
            .vertical_align = TextAlign.TextAlignCenter,
            .wrap = cast(Text.Wrap)TextWrapAuto})
    if pointer.released || !pointer.down {
        drag_control = 0
        drag_moved = false
    }
    message.succeeded = true
    return message
}

#program_export "RadioMain"
Main :: () -> s32 {
    message := ReadAppHost()
    if message.abi != MODULE_ABI { return -1 }
    if message.action == MODULE_IDENTIFY { return MODULE_NODE_APP }
    message.succeeded = message.action == APP_ROUTE
    if message.action == APP_FRAME { message = RadioView(message) }
    WriteAppHost(message)
    return 0
}
