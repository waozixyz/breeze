// These stations publish MP3 links expressly for external players.
// Streams go directly to each listener; Inner Breeze does not relay them.
RADIO_STATION_COUNT :: 3

StationName :: (station: s32) -> string {
    if station == 1 { return "a.m. ambient" }
    if station == 2 { return "Ambient Modern" }
    return "Ambient Sleeping Pill"
}

StationStream :: (station: s32) -> string {
    if station == 1 { return "https://radio.stereoscenic.com/ama-s" }
    if station == 2 { return "https://radio.stereoscenic.com/mod-s" }
    return "https://radio.stereoscenic.com/asp-s"
}
