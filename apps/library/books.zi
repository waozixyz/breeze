// The Library's books, each a list of chapters.
#import, file "tao_te_ching.zi";

BOOK_COUNT :: 1

BookTitle :: (index: s32) -> string {
    unused index
    return TAO_TE_CHING_TITLE
}

BookAuthor :: (index: s32) -> string {
    unused index
    return TAO_TE_CHING_AUTHOR
}

// Where the book's words come from.
BookNote :: (index: s32) -> string {
    unused index
    return TAO_TE_CHING_NOTE
}

// The record that keeps the chapter a book is open at.
BookRecord :: (index: s32) -> string {
    unused index
    return "tao-te-ching.chapter"
}

BookChapters :: (index: s32) -> s32 {
    unused index
    return TAO_TE_CHING_CHAPTERS
}

// Chapter number's words, from 1.
BookChapter :: (index: s32, number: s32) -> string {
    unused index
    return TaoTeChing(number)
}
