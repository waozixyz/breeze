#import "drawing_props"

// Coins mark the important numbers, such as the balance, prices and
// rewards, in the theme's highlight. A host older than the highlight sends
// none, and the coin then takes the theme's text color.
HabitsCoinColor :: (highlight: Color, text: Color) -> Color {
    if highlight.a == cast(u8)0 {
        return text
    }
    return highlight
}
