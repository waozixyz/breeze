    result: [STATS_HOLD_DAYS_MAX]s32
    return result
}

NewDayTotals :: () -> [STATS_HOLD_DAYS_MAX]s32 {
    result: [STATS_HOLD_DAYS_MAX]s32
    return result
}

NewSeen :: () -> [STATS_HOLD_DAYS_MAX]s32 {
