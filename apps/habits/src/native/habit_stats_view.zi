}

NewFirstX :: () -> [STATS_HOLD_DAYS_MAX]s32 {
    result: [STATS_HOLD_DAYS_MAX]s32
    return result
}

NewLastX :: () -> [STATS_HOLD_DAYS_MAX]s32 {
    result: [STATS_HOLD_DAYS_MAX]s32
    return result
}

TrendDetail :: (title: string, label: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "% · %", title, label)
    return BuilderFinish(out)
}

MoodAverageLabel :: (hundredths: s32) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "%.", hundredths / 100)
    Padded(*out, hundredths % 100)
    BuilderPrint(*out, "/5")
    return BuilderFinish(out)
}

PercentLabel :: (percent: s64) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "%", percent)
    BuilderPrint(*out, "%%")
    return BuilderFinish(out)
}

TimeRangeLabel :: (lowest: s32, highest: s32) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "% - %", TimeText(lowest), TimeText(highest))
    return BuilderFinish(out)
}

CurrentStatistics :: () -> *HabitsStatsFrame {
    return *stats
}

SetStatistics :: (value: HabitsStatsFrame) {
    stats = value
}

HoldPoints :: () -> []HoldPoint {
    return hold_points[:]
}

ChartPoints :: () -> []BandChartPoint {
    return chart_points[:]
}

ChartBands :: () -> []BandChartBand {
    return chart_bands[:]
}

SurfaceStyle :: () -> Surface {
    return Surface.{.session = stats.session, .scale = stats.scale,
        .font = stats.font, .small_font = stats.small_font,
        .muted_class = stats.muted_class, .fill = stats.card_fill,
        .border = stats.card_border, .coin = Color.{},
        .radius = Scale(STATS_CARD_RADIUS), .padding = Scale(STATS_CARD_PADDING),
        .modal_active = stats.modal_active, .empty_width_fits = false}
}

Locale :: (key: string) -> string {
    return HabitsLocaleHost(key)
}
