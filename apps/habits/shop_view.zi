// The habit shop: the coins the habits earned and the rewards the person
// sets, each with its symbol and its price in coins, to spend them on. A
// reward is added or changed in the form under the list; a tap on a
// reward's name opens it there, and Buy asks before it spends the coins.
// The host keeps the coins, the rewards and the form's state; the page
// draws them and asks the host to save, delete or buy a reward.
#import "session"
#import "geometry"
#import "vec"
#import "dpi"
#import "layout"
#import "drawing_props"
#import "semantic"
#import "text_props"
#import "text_align"
#import "text_widget"
#import "text_measure"
#import "text_input_props"
#import "text_field_widget"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "box_props"
#import "box_widget"
#import "modal_props"
#import "modal_frame_widget"
#import "scroll_props"
#import "scroll_widget"
#import "svg_icon_props"
#import "svg_icon_widget"
#import "tree"
#import, file "../../src/cells/habits_ui_types.zi";
#import, file "../../src/cells/habits_types.zi";
#import, file "../../src/habits/habit_types.zi";
#import, file "../../src/habits/habit_icons.zi";
#import, file "../../src/habits/habit_coins.zi";
CoinIcon :: #import "mingcute/mingcute_filled_copper_coin";

using ButtonTone;
using ButtonEmphasis;
using SemanticKind;
using TextAlign;
using TextWrap;
host_api :: #system_library "host_api";
ReadHabitsShopHost :: () -> HabitsShopFrame #foreign host_api;
WriteHabitsShopHost :: (frame: HabitsShopFrame) #foreign host_api;
ReadHabitRewardHost :: (index: s32) -> HabitsShopReward #foreign host_api;
SaveHabitRewardHost :: (reward: HabitsShopReward) -> bool #foreign host_api;
DeleteHabitRewardHost :: (id: string) -> bool #foreign host_api;
BuyHabitRewardHost :: (reward: HabitsShopReward) -> bool #foreign host_api;
ReadHabitActivityHost :: (index: s32) -> HabitsShopActivity #foreign host_api;
HabitsLocaleHost :: (key: string) -> string #foreign host_api;
shop: HabitsShopFrame;

SHOP_COLUMN_MAX :: 640
SHOP_DEFAULT_PRICE :: 5
SHOP_BALANCE_HEIGHT :: 92
SHOP_ROW_HEIGHT :: 60
SHOP_ROW_GAP :: 8
SHOP_GAP :: 16
SHOP_CARD_PADDING :: 16
// The form: its title, the name, then the price with Add or Save, and
// Delete and Cancel while it changes a reward.
SHOP_FORM_PADDING :: 14
SHOP_FIELD_HEIGHT :: 44
// The grid of symbols: round buttons as the habit editor's icons are.
SHOP_ICON_SIZE :: 40
SHOP_ICON_STEP_X :: 48
SHOP_ICON_STEP_Y :: 44
SHOP_BACK_SHAPE :: "S1.8rr:M15 5L8 12L15 19"
// The most the shop lends once the balance is spent.
SHOP_BORROW_LIMIT_MAX :: 9999
// Activity: one short line per coin movement.
SHOP_ACTIVITY_ROW :: 40
SHOP_DONE_SHAPE :: "S2rr:M5 12L10 17L19 7"

Scale :: (pixels: s32) -> s32 {
    return ScalePixels(pixels, shop.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

Locale :: (key: string) -> string {
    return HabitsLocaleHost(key)
}

// The width a line of text takes in the host's fonts.
Width :: (text: string, font: s32) -> s32 {
    return TextWidth(shop.session, TextProps.{.text = text, .font = font})
}

// The height Text takes for a paragraph wrapped in width.
ParagraphHeight :: (text: string, width: s32, font: s32) -> s32 {
    return TextHeight(shop.session, TextProps.{.text = text, .font = font,
            .bounds = Bounds(0, 0, width, 0)})
}

// A warm gold that reads on light and dark themes alike.
CoinColor :: () -> Color {
    return Color.{.r = 226, .g = 168, .b = 48, .a = 255}
}

Coin :: (bounds: Rectangle) {
    SvgIcon(shop.session, SvgIconProps.{.bounds = bounds, .shape = CoinIcon.Shape,
            .color = CoinColor()})
}

Number :: (value: s64) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "%", value)
    return BuilderFinish(out)
}

// Half coins as Habits shows them: 12, 12½ or ½.
Coins :: (halves: s64) -> string {
    out: Vec(u8)
    whole := halves / 2
    odd := halves % 2 != 0
    if whole != 0 || !odd {
        BuilderPrint(*out, "%", whole)
    } else if halves < 0 {
        BuilderPrint(*out, "-")
    }
    if odd {
        BuilderPrint(*out, "½")
    }
    return BuilderFinish(out)
}

// The template with its %s replaced by value.
Filled :: (template: string, value: string) -> string {
    out: Vec(u8)
    at: s64 = 0
    while at < template.count {
        if at + 1 < template.count && template[at] == cast(u8)37 &&
        template[at + 1] == cast(u8)115 {
            BuilderPrint(*out, "%", value)
            at += 2
        } else {
            BuilderPrint(*out, "%", template[at:at + 1])
            at += 1
        }
    }
    return BuilderFinish(out)
}

// The value with start to end replaced, or the value unchanged when the
// result would pass limit bytes.
Replaced :: (value: string, start: s32, end: s32, replacement: string,
    limit: s64) -> string {
    if start < 0 || end < start || cast(s64)end > value.count ||
    value.count - cast(s64)(end - start) + replacement.count > limit {
        return value
    }
    out: Vec(u8)
    BuilderPrint(*out, "%", value[:start])
    BuilderPrint(*out, "%", replacement)
    BuilderPrint(*out, "%", value[end:])
    return BuilderFinish(out)
}

Card :: (bounds: Rectangle, key: string) {
    unused Box(shop.session, BoxProps.{
            .key = ifx key.count > 0 then KeyHash(key) else cast(u64)0,
            .bounds = bounds, .fill = shop.card_fill, .border = shop.card_border,
            .radius = cast(float32)shop.card_radius})
}

// The width a coin and its amount take at a font size.
CoinAmountWidth :: (amount: string, font: s32) -> s32 {
    return font + Scale(6) + Width(amount, font)
}

// A coin and its amount, centred on the bounds' height from their left.
CoinAmount :: (amount: string, bounds: Rectangle, font: s32) {
    size := cast(float32)font
    Coin(Rectangle.{bounds.x, bounds.y + (bounds.height - size) * 0.5, size, size})
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)amount.count}
    Text(shop.session, TextProps.{
            .bounds = Rectangle.{bounds.x + size + cast(float32)Scale(6), bounds.y,
                bounds.width - size - cast(float32)Scale(6), bounds.height},
            .text = amount, .font = font, .strong = strong[:],
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone})
}

ShopButton :: (id: s32, label: string, bounds: Rectangle, tone: ButtonTone,
    emphasis: ButtonEmphasis, disabled: bool) -> bool {
    return Button(shop.session, ButtonProps.{
            .id = id, .bounds = bounds, .label = label, .tone = tone,
            .emphasis = emphasis, .fit_content = true,
            .disabled = disabled || shop.modal_active}) != 0
}

// An empty form that adds a reward.
FormReset :: () {
    shop.editing = ""
    shop.name = ""
    shop.name_cursor = 0
    shop.name_anchor = 0
    shop.name_scroll_x = 0
    shop.name_focused = false
    shop.price = SHOP_DEFAULT_PRICE
    shop.price_focused = false
    shop.price_scroll_x = 0
    shop.icon = HABIT_ICON_GIFT
    shop.icon_open = false
    PriceText()
}

// The form opened on a reward, to change or delete it.
FormEdit :: (reward: HabitsShopReward) {
    shop.editing = reward.id
    shop.name = reward.name
    shop.name_cursor = cast(s32)reward.name.count
    shop.name_anchor = shop.name_cursor
    shop.name_scroll_x = 0
    shop.name_focused = false
    shop.price = HabitRewardPriceClamp(reward.price)
    shop.price_focused = false
    shop.icon = HabitRewardIconClamp(reward.icon)
    shop.icon_open = false
    PriceText()
}

PriceText :: () {
    shop.price_text = Number(cast(s64)shop.price)
    shop.price_cursor = cast(s32)shop.price_text.count
    shop.price_anchor = shop.price_cursor
}

// The borrow limit as the field shows it while unfocused.
BorrowText :: () {
    shop.borrow_text = Number(cast(s64)shop.borrow_limit)
    shop.borrow_cursor = cast(s32)shop.borrow_text.count
    shop.borrow_anchor = shop.borrow_cursor
}

Editing :: () -> bool {
    return shop.editing.count > 0
}

// The name typed in, without spaces around it.
TypedName :: () -> string {
    value := shop.name
    start: s64 = 0
    end := value.count
    while start < end && (value[start] == cast(u8)32 || value[start] == cast(u8)9) {
        start += 1
    }
    while end > start && (value[end - 1] == cast(u8)32 || value[end - 1] == cast(u8)9) {
        end -= 1
    }
    return value[start:end]
}

// Adds the reward the form holds, or saves the one it changes.
FormSubmit :: () {
    name := TypedName()
    if name.count == 0 {
        return
    }
    if !SaveHabitRewardHost(HabitsShopReward.{.id = shop.editing, .name = name,
            .price = shop.price, .icon = shop.icon}) {
        return
    }
    FormReset()
}

NameField :: (bounds: Rectangle) -> TextFieldResult {
    result := TextField(shop.session, TextFieldProps.{
            .key = KeyHash("inbe/habits/shop/name"), .bounds = bounds,
            .value = shop.name, .placeholder = Locale("habit_shop_name_placeholder"),
            .cursor = shop.name_cursor, .anchor = shop.name_anchor,
            .scroll_x = shop.name_scroll_x, .focused = shop.name_focused,
            .focus_id = 8411, .max_bytes = HABIT_REWARD_NAME_SIZE - 1,
            .max_codepoints = HABIT_REWARD_NAME_SIZE - 1, .disabled = shop.modal_active,
            .input = ifx shop.name_focused then shop.input else TextFieldInput.{}})
    if result.edit.changed {
        shop.name = Replaced(shop.name, result.edit.start, result.edit.end,
            result.edit.replacement, HABIT_REWARD_NAME_SIZE - 1)
    }
    shop.name_cursor = result.cursor
    shop.name_anchor = result.anchor
    shop.name_scroll_x = result.scroll_x
    shop.name_focused = result.focused
    if result.focused {
        shop.price_focused = false
        shop.borrow_focused = false
    }
    if result.clipboard_write {
        shop.clipboard_write = true
        shop.clipboard_text = result.clipboard_text
    }
    return result
}

// The price as typed; an empty or zero entry keeps the last price until
// the field is left.
PriceField :: (bounds: Rectangle) -> TextFieldResult {
    if !shop.price_focused {
        PriceText()
    }
    result := TextField(shop.session, TextFieldProps.{
            .key = KeyHash("inbe/habits/shop/price"), .bounds = bounds,
            .value = shop.price_text, .cursor = shop.price_cursor,
            .anchor = shop.price_anchor, .scroll_x = shop.price_scroll_x,
            .focused = shop.price_focused, .focus_id = 8412, .numeric = true,
            .max_bytes = 4, .max_codepoints = 4, .disabled = shop.modal_active,
            .input = ifx shop.price_focused then shop.input else TextFieldInput.{}})
    if result.edit.changed {
        shop.price_text = Replaced(shop.price_text, result.edit.start, result.edit.end,
            result.edit.replacement, 4)
        value: s32 = 0
        index: s64 = 0
        while index < shop.price_text.count {
            digit := cast(s32)shop.price_text[index] - 48
            if digit >= 0 && digit <= 9 {
                value = value * 10 + digit
            }
            index += 1
        }
        if value > 0 {
            shop.price = HabitRewardPriceClamp(value)
        }
    }
    shop.price_cursor = result.cursor
    shop.price_anchor = result.anchor
    shop.price_scroll_x = result.scroll_x
    shop.price_focused = result.focused
    if result.focused {
        shop.name_focused = false
        shop.borrow_focused = false
    }
    if result.clipboard_write {
        shop.clipboard_write = true
        shop.clipboard_text = result.clipboard_text
    }
    return result
}

// The limit as typed; an empty field means no borrowing.
BorrowField :: (bounds: Rectangle) -> TextFieldResult {
    if !shop.borrow_focused {
        BorrowText()
    }
    result := TextField(shop.session, TextFieldProps.{
            .key = KeyHash("inbe/habits/shop/borrow"), .bounds = bounds,
            .value = shop.borrow_text, .cursor = shop.borrow_cursor,
            .anchor = shop.borrow_anchor, .scroll_x = shop.borrow_scroll_x,
            .focused = shop.borrow_focused, .focus_id = 8413, .numeric = true,
            .max_bytes = 4, .max_codepoints = 4, .disabled = shop.modal_active,
            .input = ifx shop.borrow_focused then shop.input else TextFieldInput.{}})
    if result.edit.changed {
        shop.borrow_text = Replaced(shop.borrow_text, result.edit.start,
            result.edit.end, result.edit.replacement, 4)
        value: s32 = 0
        index: s64 = 0
        while index < shop.borrow_text.count {
            digit := cast(s32)shop.borrow_text[index] - 48
            if digit >= 0 && digit <= 9 {
                value = value * 10 + digit
            }
            index += 1
        }
        if value > SHOP_BORROW_LIMIT_MAX {
            value = SHOP_BORROW_LIMIT_MAX
        }
        shop.borrow_limit = value
    }
    shop.borrow_cursor = result.cursor
    shop.borrow_anchor = result.anchor
    shop.borrow_scroll_x = result.scroll_x
    shop.borrow_focused = result.focused
    if result.focused {
        shop.name_focused = false
        shop.price_focused = false
    }
    if result.clipboard_write {
        shop.clipboard_write = true
        shop.clipboard_text = result.clipboard_text
    }
    return result
}

// Back, then the page's title, strong, with its subtitle muted below it.
// Returns the y below it, or -1 when Back was pressed.
PageHeader :: (x: s32, y: s32, width: s32, title_text: string, subtitle: string) -> s32 {
    back_label := Locale("back_button")
    back_w := Width(back_label, shop.font) + Scale(48)
    if back_w < Scale(88) {
        back_w = Scale(88)
    }
    if back_w > width / 3 {
        back_w = width / 3
    }
    if Button(shop.session, ButtonProps.{
            .id = 8400, .bounds = Bounds(x, y + Scale(2), back_w, Scale(42)),
            .label = back_label, .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisOutline,
            .icon_shape = SHOP_BACK_SHAPE, .fit_content = true,
            .disabled = shop.modal_active}) != 0 {
        return -1
    }
    title_x := x + back_w + Scale(16)
    title_w := width - back_w - Scale(16)
    // The title as large as it fits, as on Habits' other pages.
    title_font := Scale(Text24)
    if Width(title_text, title_font) > title_w {
        title_font = Scale(Text16)
        if Width(title_text, title_font) > title_w {
            title_font = Scale(Text14)
        }
    }
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)title_text.count}
    Text(shop.session, TextProps.{
            .bounds = Bounds(title_x, y, title_w, Scale(34)), .text = title_text,
            .font = title_font, .strong = strong[:],
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    Text(shop.session, TextProps.{
            .bounds = Bounds(title_x, y + Scale(34), title_w, Scale(22)), .text = subtitle,
            .font = shop.small_font, .class_name = shop.muted_class,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    return y + Scale(68)
}

// The coins to spend, large beside a gold coin, and how habits earn them.
BalanceCard :: (x: s32, y: s32, width: s32) -> s32 {
    height := Scale(SHOP_BALANCE_HEIGHT)
    Card(Bounds(x, y, width, height), "inbe/habits/shop/balance")
    coin := Scale(48)
    pad := Scale(SHOP_CARD_PADDING)
    Coin(Bounds(x + pad, y + (height - coin) / 2, coin, coin))
    text_x := x + pad + coin + Scale(14)
    text_w := width - (text_x - x) - pad
    amount := Coins(shop.halves)
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)amount.count}
    Text(shop.session, TextProps.{
            .bounds = Bounds(text_x, y + Scale(14), text_w, Scale(40)), .text = amount,
            .font = shop.font + Scale(16), .strong = strong[:],
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone})
    Text(shop.session, TextProps.{
            .bounds = Bounds(text_x, y + Scale(54), text_w, Scale(24)),
            .text = Locale("habit_shop_balance_label"), .font = shop.small_font,
            .class_name = shop.muted_class, .wrap = cast(TextWrap)TextWrapEllipsis})
    return height
}

BorrowRowHeight :: () -> s32 {
    return Scale(SHOP_FIELD_HEIGHT) + Scale(20)
}

// How far the balance may go below zero, as whole coins the shop lends.
BorrowRow :: (x: s32, y: s32, width: s32) -> s32 {
    pad := Scale(10)
    height := BorrowRowHeight()
    Card(Bounds(x, y, width, height), "inbe/habits/shop/borrow")
    field_h := Scale(SHOP_FIELD_HEIGHT)
    field_y := y + pad
    inner_x := x + pad
    coin := Scale(22)
    step := Scale(44)
    controls_w := step + Scale(6) + Scale(64) + Scale(6) + step + Scale(8) + coin
    label_w := width - pad * 2 - controls_w
    Text(shop.session, TextProps.{
            .bounds = Bounds(inner_x, field_y, label_w, field_h),
            .text = Locale("habit_shop_borrow_label"),
            .class_name = shop.muted_class,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    control_x := inner_x + label_w
    if ShopButton(8440, "-", Bounds(control_x, field_y, step, field_h),
        cast(ButtonTone)ButtonToneNeutral, cast(ButtonEmphasis)ButtonEmphasisSoft,
        shop.borrow_limit <= 0) {
        shop.borrow_limit -= 1
        BorrowText()
    }
    unused BorrowField(Bounds(control_x + step + Scale(6), field_y, Scale(64), field_h))
    plus_x := control_x + step + Scale(70)
    if ShopButton(8441, "+", Bounds(plus_x, field_y, step, field_h),
        cast(ButtonTone)ButtonToneNeutral, cast(ButtonEmphasis)ButtonEmphasisSoft,
        shop.borrow_limit >= SHOP_BORROW_LIMIT_MAX) {
        shop.borrow_limit += 1
        BorrowText()
    }
    Coin(Bounds(plus_x + step + Scale(8), field_y + (field_h - coin) / 2, coin, coin))
    return height
}

// One movement of coins: the habit's or reward's symbol and name, its day,
// and the coins it earned (+) or spent (-).
ActivityRow :: (index: s32, x: s32, y: s32, width: s32) {
    line := ReadHabitActivityHost(index)
    height := Scale(SHOP_ACTIVITY_ROW)
    symbol := Scale(20)
    shape := ifx line.icon > 0 then HabitIconShape(line.icon) else ""
    SvgIcon(shop.session, SvgIconProps.{
            .bounds = Bounds(x, y + (height - symbol) / 2, symbol, symbol),
            .shape = ifx shape.count > 0 then shape else SHOP_DONE_SHAPE,
            .color = shop.text_color})
    amount := Coins(ifx line.halves < 0 then -line.halves else line.halves)
    signed: Vec(u8)
    BuilderPrint(*signed, "%", ifx line.halves < 0 then "-" else "+")
    BuilderPrint(*signed, "%", amount)
    amount = BuilderFinish(signed)
    amount_w := CoinAmountWidth(amount, shop.font)
    day_w := Width(line.day, shop.small_font) + Scale(12)
    name_x := x + symbol + Scale(12)
    amount_x := x + width - amount_w
    day_x := amount_x - Scale(12) - day_w
    Text(shop.session, TextProps.{
            .bounds = Bounds(name_x, y, day_x - name_x, height), .text = line.name,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    Text(shop.session, TextProps.{
            .bounds = Bounds(day_x, y, day_w, height), .text = line.day,
            .font = shop.small_font, .class_name = shop.muted_class,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone})
    CoinAmount(amount, Bounds(amount_x, y, amount_w, height), shop.font)
}

// A section's title above its cards: strong and a little larger than the
// text, wrapping onto more lines when it must.
SectionTitleHeight :: (title: string, width: s32) -> s32 {
    return ParagraphHeight(title, width, shop.font + Scale(2))
}

SectionTitle :: (title: string, x: s32, y: s32, width: s32) -> s32 {
    height := SectionTitleHeight(title, width)
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)title.count}
    Text(shop.session, TextProps.{
            .bounds = Bounds(x, y, width, height), .text = title,
            .font = shop.font + Scale(2), .strong = strong[:],
            .semantic_kind = cast(SemanticKind)SemanticHeading, .heading_level = 2,
            .wrap = cast(TextWrap)TextWrapAuto})
    return height
}

// One reward: its symbol and name, which open it in the form, and its price
// beside Buy, which needs the coins.
RewardRow :: (index: s32, x: s32, y: s32, width: s32) {
    reward := ReadHabitRewardHost(index)
    height := Scale(SHOP_ROW_HEIGHT)
    Card(Bounds(x, y, width, height), ifx index == 0 then "inbe/habits/shop/first-reward" else "")
    pad := Scale(SHOP_CARD_PADDING)
    buy_label := Locale("habit_shop_buy_button")
    buy_w := Width(buy_label, shop.font) + Scale(36)
    if buy_w < Scale(84) {
        buy_w = Scale(84)
    }
    price := Number(cast(s64)reward.price)
    price_w := CoinAmountWidth(price, shop.font)
    buy_x := x + width - pad - buy_w
    price_x := buy_x - Scale(14) - price_w
    symbol := Scale(26)
    name_x := x + pad + symbol + Scale(12)
    name_w := price_x - name_x - Scale(10)
    if Button(shop.session, ButtonProps.{
            .id = 8500 + index, .bounds = Bounds(x, y, price_x - x, height),
            .invisible = true, .label = reward.name,
            .disabled = shop.modal_active}) != 0 {
        FormEdit(reward)
    }
    SvgIcon(shop.session, SvgIconProps.{
            .bounds = Bounds(x + pad, y + (height - symbol) / 2, symbol, symbol),
            .shape = HabitIconShape(HabitRewardIconClamp(reward.icon)),
            .color = shop.text_color})
    Text(shop.session, TextProps.{
            .bounds = Bounds(name_x, y, name_w, height), .text = reward.name,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    CoinAmount(price, Bounds(price_x, y, price_w, height), shop.font)
    affordable := shop.halves + cast(s64)shop.borrow_limit * 2 >=
        cast(s64)reward.price * 2
    if ShopButton(8600 + index, buy_label,
        Bounds(buy_x, y + (height - Scale(40)) / 2, buy_w, Scale(40)),
        cast(ButtonTone)(ifx affordable then ButtonToneAccent else ButtonToneNeutral),
        cast(ButtonEmphasis)(ifx affordable then ButtonEmphasisFilled else ButtonEmphasisSoft),
        !affordable) {
        shop.buying = reward
        shop.name_focused = false
        shop.price_focused = false
        shop.action = HABITS_SHOP_BUY
    }
}

IconColumns :: (width: s32) -> s32 {
    columns := width / Scale(SHOP_ICON_STEP_X)
    if columns < 1 {
        columns = 1
    }
    return columns
}

// The height of the open grid of symbols, one for each habit icon.
IconGridHeight :: (width: s32) -> s32 {
    columns := IconColumns(width)
    rows := (HABIT_ICON_COUNT + columns - 1) / columns
    return rows * Scale(SHOP_ICON_STEP_Y)
}

// The reward's symbol before its name. A tap opens the grid of symbols
// under the name, or closes it again.
IconButton :: (bounds: Rectangle) {
    if Button(shop.session, ButtonProps.{
            .id = 8425, .bounds = bounds, .label = Locale("habit_icon_label"),
            .icon_shape = HabitIconShape(shop.icon), .icon_only = true,
            .selected = shop.icon_open, .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)(ifx shop.icon_open then
                ButtonEmphasisOutline else ButtonEmphasisSoft),
            .disabled = shop.modal_active}) != 0 {
        shop.icon_open = !shop.icon_open
        shop.name_focused = false
        shop.price_focused = false
    }
}

// Every symbol a reward can have, as the habit editor offers its icons. A
// tap chooses one and closes the grid.
IconGrid :: (x: s32, y: s32, width: s32) {
    columns := IconColumns(width)
    icon: s32 = 1
    while icon <= HABIT_ICON_COUNT {
        index := icon - 1
        selected := shop.icon == icon
        if Button(shop.session, ButtonProps.{
                .id = 8700 + icon,
                .bounds = Bounds(x + (index % columns) * Scale(SHOP_ICON_STEP_X) + Scale(4),
                    y + (index / columns) * Scale(SHOP_ICON_STEP_Y) + Scale(2),
                    Scale(SHOP_ICON_SIZE), Scale(SHOP_ICON_SIZE)),
                .circle = true,
                .icon_shape = HabitIconShape(icon), .icon_only = true, .selected = selected,
                .tone = cast(ButtonTone)(ifx selected then ButtonToneAccent else ButtonToneNeutral),
                .emphasis = cast(ButtonEmphasis)(ifx selected then
                    ButtonEmphasisFilled else ButtonEmphasisSoft),
                .disabled = shop.modal_active}) != 0 {
            shop.icon = icon
            shop.icon_open = false
        }
        icon += 1
    }
}

ActionLabel :: () -> string {
    return Locale(ifx Editing() then "save_button" else "habit_shop_add_button")
}

ActionWidth :: (label: string) -> s32 {
    width := Width(label, shop.font) + Scale(40)
    if width < Scale(96) {
        width = Scale(96)
    }
    return width
}

// Whether the form's Add or Save goes on its own line at this width.
FormWraps :: (width: s32) -> bool {
    inner_w := width - Scale(SHOP_FORM_PADDING) * 2
    label_w := Width(Locale("habit_shop_price_label"), shop.font) + Scale(10)
    controls := label_w + Scale(44) + Scale(76) + Scale(44) + Scale(22) + Scale(16)
    return controls + ActionWidth(ActionLabel()) > inner_w
}

FormHeight :: (width: s32) -> s32 {
    pad := Scale(SHOP_FORM_PADDING)
    height := pad + Scale(30) + Scale(SHOP_FIELD_HEIGHT) + Scale(10) +
    Scale(SHOP_FIELD_HEIGHT) + pad
    if shop.icon_open {
        height += IconGridHeight(width - pad * 2) + Scale(10)
    }
    if FormWraps(width) {
        height += Scale(10) + Scale(SHOP_FIELD_HEIGHT)
    }
    if Editing() {
        height += Scale(10) + Scale(42)
    }
    return height
}

// The form that adds a reward, or changes the one opened from the list.
Form :: (x: s32, y: s32, width: s32) {
    editing := Editing()
    Card(Bounds(x, y, width, FormHeight(width)), "inbe/habits/shop/form")
    pad := Scale(SHOP_FORM_PADDING)
    inner_x := x + pad
    inner_w := width - pad * 2
    row_y := y + pad
    title_text := Locale(ifx editing then "habit_shop_edit_title" else "habit_shop_add_title")
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)title_text.count}
    Text(shop.session, TextProps.{
            .bounds = Bounds(inner_x, row_y, inner_w, Scale(26)), .text = title_text,
            .strong = strong[:], .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    row_y += Scale(30)
    field_h := Scale(SHOP_FIELD_HEIGHT)
    // The symbol, then the name.
    IconButton(Bounds(inner_x, row_y, field_h, field_h))
    name_x := inner_x + field_h + Scale(10)
    named := NameField(Bounds(name_x, row_y, inner_x + inner_w - name_x, field_h))
    submit := named.committed
    row_y += field_h + Scale(10)
    if shop.icon_open {
        IconGrid(inner_x, row_y, inner_w)
        row_y += IconGridHeight(inner_w) + Scale(10)
    }
    // Price − [n] + with a coin, then Add or Save at the row's end.
    label := Locale("habit_shop_price_label")
    label_w := Width(label, shop.font) + Scale(10)
    Text(shop.session, TextProps.{
            .bounds = Bounds(inner_x, row_y, label_w, field_h), .text = label,
            .class_name = shop.muted_class, .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone})
    step := Scale(44)
    control_x := inner_x + label_w
    if ShopButton(8420, "-", Bounds(control_x, row_y, step, field_h),
        cast(ButtonTone)ButtonToneNeutral, cast(ButtonEmphasis)ButtonEmphasisSoft,
        shop.price <= 1) {
        shop.price = HabitRewardPriceClamp(shop.price - 1)
        PriceText()
    }
    priced := PriceField(Bounds(control_x + step + Scale(6), row_y, Scale(64), field_h))
    if priced.committed {
        submit = true
    }
    plus_x := control_x + step + Scale(76)
    if ShopButton(8421, "+", Bounds(plus_x, row_y, step, field_h),
        cast(ButtonTone)ButtonToneNeutral, cast(ButtonEmphasis)ButtonEmphasisSoft,
        shop.price >= HABIT_REWARD_PRICE_MAX) {
        shop.price = HabitRewardPriceClamp(shop.price + 1)
        PriceText()
    }
    coin := Scale(22)
    Coin(Bounds(plus_x + step + Scale(8), row_y + (field_h - coin) / 2, coin, coin))
    action_label := ActionLabel()
    action_w := ActionWidth(action_label)
    action_x := inner_x + inner_w - action_w
    if FormWraps(width) {
        // A narrow screen puts Add or Save on the next line.
        row_y += field_h + Scale(10)
    }
    if ShopButton(8422, action_label, Bounds(action_x, row_y, action_w, field_h),
        cast(ButtonTone)ButtonToneAccent, cast(ButtonEmphasis)ButtonEmphasisFilled,
        TypedName().count == 0) {
        submit = true
    }
    if submit && !shop.modal_active {
        FormSubmit()
        return
    }
    if !editing {
        return
    }
    row_y += field_h + Scale(10)
    half := (inner_w - Scale(10)) / 2
    if ShopButton(8423, Locale("delete_button"), Bounds(inner_x, row_y, half, Scale(42)),
        cast(ButtonTone)ButtonToneDanger, cast(ButtonEmphasis)ButtonEmphasisSoft, false) {
        unused DeleteHabitRewardHost(shop.editing)
        FormReset()
        return
    }
    if ShopButton(8424, Locale("cancel_button"),
        Bounds(inner_x + half + Scale(10), row_y, half, Scale(42)),
        cast(ButtonTone)ButtonToneNeutral, cast(ButtonEmphasis)ButtonEmphasisOutline, false) {
        FormReset()
    }
}

// Draws the shop in the frame's bounds.
ShopPage :: () {
    bounds := shop.bounds
    width := cast(s32)bounds.width
    x := cast(s32)bounds.x
    if width > Scale(SHOP_COLUMN_MAX) {
        x += (width - Scale(SHOP_COLUMN_MAX)) / 2
        width = Scale(SHOP_COLUMN_MAX)
    }
    top := PageHeader(x, cast(s32)bounds.y, width, Locale("habit_shop_title"),
        Locale("habit_shop_subtitle"))
    if top < 0 {
        shop.name_focused = false
        shop.price_focused = false
        shop.action = HABITS_SHOP_BACK
        return
    }
    gap := Scale(SHOP_GAP)
    row_h := Scale(SHOP_ROW_HEIGHT)
    row_gap := Scale(SHOP_ROW_GAP)
    rewards_title := Locale("habit_shop_rewards_title")
    title_h := SectionTitleHeight(rewards_title, width)
    empty_text := Locale("habit_shop_empty")
    list_h := shop.reward_count * (row_h + row_gap)
    if shop.reward_count == 0 {
        list_h = ParagraphHeight(empty_text, width, shop.font) + row_gap
    }
    form_h := FormHeight(width)
    // The latest coins earned and spent, once there are any.
    activity_title := Locale("profile_progress_title")
    activity_h: s32 = 0
    if shop.activity_count > 0 {
        activity_h = SectionTitleHeight(activity_title, width) + Scale(6) +
        shop.activity_count * Scale(SHOP_ACTIVITY_ROW) + gap
    }
    content_h := Scale(SHOP_BALANCE_HEIGHT) + Scale(10) + BorrowRowHeight() + gap +
        title_h +
    Scale(10) + list_h + gap + activity_h + form_h + gap
    scrolled := Scroll(shop.session, ScrollProps.{
            .key = KeyHash("inbe/habits/shop"),
            .bounds = Rectangle.{cast(float32)x, cast(float32)top, cast(float32)width,
                bounds.y + bounds.height - cast(float32)top},
            .content_height = content_h, .scroll_offset = shop.scroll})
    shop.scroll = scrolled.scroll_offset
    if !scrolled.opened {
        return
    }
    y := cast(s32)scrolled.content.y
    y += BalanceCard(x, y, width) + Scale(10)
    y += BorrowRow(x, y, width) + gap
    y += SectionTitle(rewards_title, x, y, width) + Scale(10)
    if shop.reward_count == 0 {
        Text(shop.session, TextProps.{
                .bounds = Bounds(x, y, width, list_h - row_gap), .text = empty_text,
                .class_name = shop.muted_class, .wrap = cast(TextWrap)TextWrapAuto})
    }
    index: s32 = 0
    while index < shop.reward_count {
        RewardRow(index, x, y + index * (row_h + row_gap), width)
        index += 1
    }
    y += list_h + gap
    if shop.activity_count > 0 {
        y += SectionTitle(activity_title, x, y, width) + Scale(6)
        for index: cast(s32)0..shop.activity_count - 1 {
            ActivityRow(index, x, y, width)
            y += Scale(SHOP_ACTIVITY_ROW)
        }
        y += gap
    }
    Form(x, y, width)
    unused End(shop.session)
}

// Asks before a reward's price is spent: the reward, its price and the
// coins left after it.
BuyDialog :: () {
    reward := shop.buying
    width := shop.view_width - Scale(32)
    if width > Scale(380) {
        width = Scale(380)
    }
    frame := ModalFrame(shop.session, ModalFrameProps.{
            .key = KeyHash("inbe/habits/shop/buy"),
            .title = Locale("habit_shop_buy_title"),
            .width = width, .height = Scale(250), .scale = shop.scale})
    if frame.dismissed {
        shop.action = HABITS_SHOP_CLOSE
        return
    }
    if !frame.opened {
        return
    }
    content := frame.layout.content
    x := cast(s32)content.x
    y := cast(s32)content.y
    inner_w := cast(s32)content.width
    symbol := Scale(30)
    SvgIcon(shop.session, SvgIconProps.{.bounds = Bounds(x, y, symbol, symbol),
            .shape = HabitIconShape(HabitRewardIconClamp(reward.icon)),
            .color = shop.text_color})
    strong: [1]TextRange
    strong[0] = TextRange.{.start = 0, .end = cast(s32)reward.name.count}
    Text(shop.session, TextProps.{
            .bounds = Bounds(x + symbol + Scale(10), y, inner_w - symbol - Scale(10), Scale(30)),
            .text = reward.name, .strong = strong[:],
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    y += Scale(34)
    CoinAmount(Number(cast(s64)reward.price), Bounds(x, y, inner_w, Scale(30)),
        shop.font + Scale(4))
    y += Scale(36)
    left := shop.halves - cast(s64)reward.price * 2
    Text(shop.session, TextProps.{
            .bounds = Bounds(x, y, inner_w, Scale(24)),
            .text = Filled(Locale("habit_shop_buy_left"), Coins(left)),
            .font = shop.small_font, .class_name = shop.muted_class,
            .wrap = cast(TextWrap)TextWrapEllipsis})
    button_y := cast(s32)(content.y + content.height) - Scale(44)
    half := (inner_w - Scale(10)) / 2
    cancelled := Button(shop.session, ButtonProps.{
            .id = 8430, .bounds = Bounds(x, button_y, half, Scale(42)),
            .label = Locale("cancel_button"), .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisOutline, .fit_content = true}) != 0
    bought := Button(shop.session, ButtonProps.{
            .id = 8431, .bounds = Bounds(x + half + Scale(10), button_y, half, Scale(42)),
            .label = Locale("habit_shop_buy_button"), .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled, .fit_content = true,
            .disabled = left < -cast(s64)shop.borrow_limit * 2}) != 0
    unused End(shop.session)
    if cancelled {
        shop.action = HABITS_SHOP_CLOSE
        return
    }
    if bought {
        unused BuyHabitRewardHost(reward)
        shop.action = HABITS_SHOP_CLOSE
    }
}

HabitsShopView :: (message: HabitsMessage) -> HabitsMessage {
    shop = ReadHabitsShopHost()
    shop.action = HABITS_SHOP_NONE
    shop.clipboard_write = false
    if message.action == HABITS_SHOP_BUY_DIALOG {
        BuyDialog()
    } else {
        ShopPage()
    }
    WriteHabitsShopHost(shop)
    message.succeeded = true
    return message
}
