// Habit's editor confirmations belong to its package. The native host uses
// the same composition for older installed packages that lack these views.
#import "session"
#import "modal_props"
#import "modal_widget"
#import "control_props"

using ButtonTone;
using ButtonEmphasis;

HabitEditorDialogProps :: struct {
    session: Session
    deleting: bool
    title: string
    message: string
    keep_editing: string
    save: string
    discard: string
    cancel: string
    delete_label: string
}

HabitEditorDialog :: (props: HabitEditorDialogProps) -> ActionModalResult {
    if props.deleting {
        actions: [2]ActionModalAction = .[
        ActionModalAction.{.label = props.cancel,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
        ActionModalAction.{.label = props.delete_label,
            .tone = cast(ButtonTone)ButtonToneDanger,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}]
        return ActionModal(props.session, ActionModalProps.{
                .title = props.title, .message = props.message}, actions[:])
    }
    actions: [3]ActionModalAction = .[
    ActionModalAction.{.label = props.keep_editing,
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ActionModalAction.{.label = props.save,
        .tone = cast(ButtonTone)ButtonToneAccent,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled},
    ActionModalAction.{.label = props.discard,
        .tone = cast(ButtonTone)ButtonToneDanger,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}]
    return ActionModal(props.session, ActionModalProps.{
            .title = props.title, .message = props.message}, actions[:])
}
