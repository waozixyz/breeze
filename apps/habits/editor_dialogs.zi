// Habit's editor confirmations belong to its package. The native host uses
// the same composition for older installed packages that lack these views.
#import "session"
Modal :: #import "kryon/modal";
#import "control_props"

using ButtonTone;
using ButtonEmphasis;

HabitEditorDialogProps :: struct {
    session: Session
    deleting: bool
    title: string
    message: string
    keep_editing: string
    save: string
    discard: string
    cancel: string
    delete_label: string
}

HabitEditorDialog :: (props: HabitEditorDialogProps) -> Modal.ActionModalResult {
    if props.deleting {
        actions: [2]Modal.ActionModalAction = .[
        Modal.ActionModalAction.{.label = props.cancel,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
        Modal.ActionModalAction.{.label = props.delete_label,
            .tone = cast(ButtonTone)ButtonToneDanger,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}]
        return Modal.ActionModal(props.session, Modal.ActionModalProps.{
                .title = props.title, .message = props.message}, actions[:])
    }
    actions: [3]Modal.ActionModalAction = .[
    Modal.ActionModalAction.{.label = props.keep_editing,
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    Modal.ActionModalAction.{.label = props.save,
        .tone = cast(ButtonTone)ButtonToneAccent,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled},
    Modal.ActionModalAction.{.label = props.discard,
        .tone = cast(ButtonTone)ButtonToneDanger,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}]
    return Modal.ActionModal(props.session, Modal.ActionModalProps.{
            .title = props.title, .message = props.message}, actions[:])
}
