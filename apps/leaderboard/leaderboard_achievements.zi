// Called when the native adapter actually serves the account's visible row.
#import "std/text_buffer"
#import "std/vec"
#import, file "../../src/storage/achievements.zi";
#import, file "../../src/apps/package_files.zi";

AchievementLeaderboardViewed :: (practice: string) {
    day := AchievementToday()
    if day == 0 { return }
    out: Vec(u8)
    BuilderPrint(*out, "%.%", practice, day)
    source := BuilderFinish(out)
    defer { PackageFree(source) }
    unused AchievementRecord("leaderboard", source, day, subject = practice)
}
