// Leaderboard ranks you with your friends for each practice. The unified
// host fetches friend results, keeps them for offline use and ranks rows.
#import, file "../../src/cells/leaderboard_types.zi";
#import, file "../../src/cells/module_types.zi";
#import, file "../../src/core/types.zi";
#import, file "leaderboard_view.zi";
host_api :: #system_library "host_api";
ReadLeaderboardHost :: () -> LeaderboardMessage #foreign host_api;
WriteLeaderboardHost :: (message: LeaderboardMessage) #foreign host_api;

LeaderboardApply :: (message: LeaderboardMessage) -> LeaderboardMessage {
    message.succeeded = true
    if message.action == LEADERBOARD_ROUTE {
        message.succeeded = message.screen == ScreenLeaderboard
    } else if message.action == LEADERBOARD_FRAME {
        message = LeaderboardView(message)
    } else {
        message.succeeded = false
    }
    return message
}

#program_export "LeaderboardMain"
Main :: () -> s32 {
    message := ReadLeaderboardHost()
    if message.abi != MODULE_ABI {
        return -1
    }
    if message.action == MODULE_IDENTIFY {
        return MODULE_LEADERBOARD
    }
    WriteLeaderboardHost(LeaderboardApply(message))
    return 0
}
