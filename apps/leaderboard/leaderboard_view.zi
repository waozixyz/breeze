// Leaderboard owns its screen composition; the host supplies ranked rows,
// prepared once when results arrive, and ordinary Kryon widget effects.
#import "session"
#import "geometry"
#import "text"
#import "vec"
#import "drawing_props"
#import "text_props"
#import "text_align"
#import "text_widget"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "scroll_props"
#import "scroll_widget"
#import "box_props"
#import "box_widget"
#import "tree"
#import "dropdown_props"
#import "dropdown_widget"
#import, file "../../src/apps/leaderboard_ui_types.zi";
#import, file "../../src/apps/leaderboard_types.zi";

using ButtonTone;
using ButtonEmphasis;
using TextAlign;
using TextWrap;
host_api :: #system_library "host_api";
ReadLeaderboardUiHost :: () -> LeaderboardUiFrame #foreign host_api;
WriteLeaderboardUiHost :: (frame: LeaderboardUiFrame) #foreign host_api;
ReadLeaderboardRowHost :: (index: s32) -> LeaderboardUiRow #foreign host_api;
ReadLeaderboardAppHost :: (index: s32) -> LeaderboardUiApp #foreign host_api;
ReadLeaderboardBoardHost :: (index: s32) -> LeaderboardUiApp #foreign host_api;
LeaderboardLocaleHost :: (key: string) -> string #foreign host_api;
frame: LeaderboardUiFrame;
state: LeaderboardMessage;

// Hosts that do not list the installed practices offer Wim Hof, breathing
// patterns, meditation and Sun Salutation.
FALLBACK_PRACTICE_COUNT :: 4
FallbackPracticeAt :: (index: s32) -> s32 {
    ids: [FALLBACK_PRACTICE_COUNT]s32 = .[0, 3, 1, 2]
    return ids[index]
}

// A practice this board cannot name has an empty label and is left out.
PracticeLabel :: (practice: s32) -> string {
    if practice == 0 { return LeaderboardLocaleHost("exercise_wim_hof") }
    if practice == 1 { return LeaderboardLocaleHost("exercise_meditation") }
    if practice == 2 { return LeaderboardLocaleHost("exercise_sun_salutation") }
    if practice == 3 { return LeaderboardLocaleHost("exercise_patterns") }
    if practice == 4 { return LeaderboardLocaleHost("exercise_tai_chi") }
    if practice == 5 { return LeaderboardLocaleHost("exercise_astral_projection") }
    if practice == 6 { return LeaderboardLocaleHost("exercise_workout") }
    return ""
}

// The installed practices in Practice's order, as the host lists them.
PracticeChoices :: (ids: []s32) -> s32 {
    listed: s32 = ifx state.practices_listed then state.practice_count else FALLBACK_PRACTICE_COUNT
    if listed > cast(s32)state.practices.count {
        listed = cast(s32)state.practices.count
    }
    count: s32 = 0
    for index: cast(s32)0..listed - 1 {
        practice := ifx state.practices_listed then state.practices[index] else FallbackPracticeAt(index)
        if PracticeLabel(practice).count > 0 && count < ids.count {
            ids[count] = practice
            count += 1
        }
    }
    return count
}

Scale :: (pixels: s32) -> s32 {
    return cast(s32)(cast(float32)pixels * frame.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

Finish :: () -> LeaderboardMessage {
    // Choosing an app only matters once more than one has a board.
    if frame.app_count > 1 && frame.app_count <= 16 {
        apps: [16]LeaderboardUiApp
        options: [16]DropdownOption
        for index: cast(s32)0..frame.app_count - 1 {
            apps[index] = ReadLeaderboardAppHost(index)
            options[index].label = apps[index].title
        }
        menu := Dropdown(frame.session, DropdownProps.{.id = 7150,
                .bounds = Bounds(Scale(16), Scale(12), frame.width - Scale(32), Scale(44)),
                .selected_index = frame.app_index, .scale = frame.scale}, options[0:frame.app_count])
        if menu.changed && menu.selected_index >= 0 && menu.selected_index < frame.app_count {
            state.app = apps[menu.selected_index].name
            state.metric = LEADERBOARD_STREAK
            state.refresh = true
            frame.scroll = 0
        }
    }

    WriteLeaderboardUiHost(frame)
    state.succeeded = true
    return state
}

Cell :: (key: u64, x: s32, y: s32, width: s32, height: s32, text: string) {
    Text(frame.session, TextProps.{.key = key, .bounds = Bounds(x, y, width, height),
            .text = text, .font = frame.font, .wrap = cast(TextWrap)TextWrapNone,
            .vertical_align = cast(TextAlign)TextAlignCenter})
}

LeaderboardView :: (message: LeaderboardMessage) -> LeaderboardMessage {
    frame = ReadLeaderboardUiHost()
    state = message
    x := Scale(16)
    width := frame.width - x * 2
    y := Scale(12)

    if frame.app_count > 1 { y += Scale(56) }

    // Every installed practice, or every game of the chosen app with a
    // board, stays visible in a grid that grows with them: two per row on
    // phones, more when wide, in rows of equal length.
    practices: [16]s32
    games: [16]LeaderboardUiApp
    practice_app := state.app == "" || state.app == "practices"
    practice_count := ifx practice_app then PracticeChoices(practices[:]) else 0
    if !practice_app {
        practice_count = ifx frame.board_count > 16 then 16 else frame.board_count
        for index: cast(s32)0..practice_count - 1 {
            games[index] = ReadLeaderboardBoardHost(index)
        }
    }
    gap := Scale(8)
    widest: s32 = (width + gap) / (Scale(160) + gap)
    if widest < 2 {
        widest = 2
    }
    rows: s32 = (practice_count + widest - 1) / widest
    per_row: s32 = 1
    if rows > 0 {
        per_row = (practice_count + rows - 1) / rows
    }
    choice_width := (width - gap * (per_row - 1)) / per_row
    for index: cast(s32)0..practice_count - 1 {
        chosen := ifx practice_app then practices[index] == state.practice else index == frame.board_index
        choice_x := x + (index % per_row) * (choice_width + gap)
        choice_y := y + (index / per_row) * (Scale(40) + gap)
        if Button(frame.session, ButtonProps.{.id = 7140 + index,
                .bounds = Bounds(choice_x, choice_y, choice_width, Scale(40)),
                .label = ifx practice_app then PracticeLabel(practices[index]) else games[index].title,
                .selected = chosen, .fit_content = true,
                .tone = cast(ButtonTone)(ifx chosen then ButtonToneAccent else ButtonToneNeutral),
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 && !chosen {
            if practice_app {
                state.practice = practices[index]
            } else {
                state.board = games[index].name
            }
            state.metric = LEADERBOARD_STREAK
            state.refresh = true
            frame.scroll = 0
            return Finish()
        }
    }
    if rows > 0 {
        y += rows * (Scale(40) + gap) + Scale(8)
    }

    // Nothing is ranked until a practice is installed or a game reports.
    if frame.app_count == 0 || practice_count == 0 {
        Text(frame.session, TextProps.{.key = cast(u64)7120,
                .bounds = Bounds(x, y, width, Scale(32)),
                .text = LeaderboardLocaleHost("profile_no_leaderboard_data"),
                .font = frame.font, .wrap = cast(TextWrap)TextWrapAuto})
        return Finish()
    }

    // The name column is wider when only the streak is ranked.
    columns: s32 = ifx state.has_average then 3 else 2
    name_width := ifx state.has_average then width / 2 else (width * 2) / 3
    value_width := ifx state.has_average then (width - name_width) / 2 else width - name_width
    average_label := ifx state.practice == 1 then "profile_metric_avg_time" else "profile_metric_avg_hold"
    labels: [3]string = .[LeaderboardLocaleHost("profile_friends_title"),
    LeaderboardLocaleHost("profile_metric_streak"), LeaderboardLocaleHost(average_label)]
    if !practice_app {
        labels[1] = LeaderboardLocaleHost("leaderboard_levels")
    }
    header_x := x
    for column: cast(s32)0..columns - 1 {
        column_width := ifx column == 0 then name_width else ifx column == columns - 1 then x + width - header_x else value_width
        metric := column - 1
        active := column > 0 && state.metric == metric
        if Button(frame.session, ButtonProps.{.id = 7110 + column,
                .bounds = Bounds(header_x, y, column_width, Scale(36)),
                .label = labels[column], .disabled = column == 0, .selected = active,
                .fit_content = true,
                .tone = cast(ButtonTone)(ifx active then ButtonToneAccent else ButtonToneNeutral),
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 &&
        column > 0 && !active {
            state.metric = metric
            return Finish()
        }
        header_x += column_width
    }
    y += Scale(44)

    if state.row_count == 0 {
        key := ifx state.loading then "profile_updating_status" else "profile_no_leaderboard_data"
        Text(frame.session, TextProps.{.key = cast(u64)7120,
                .bounds = Bounds(x, y, width, Scale(32)), .text = LeaderboardLocaleHost(key),
                .font = frame.font, .wrap = cast(TextWrap)TextWrapAuto})
        return Finish()
    }

    row_height := Scale(40)
    scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)7130,
            .bounds = Bounds(x, y, width, frame.height - frame.bottom - y - Scale(8)),
            .content_height = state.row_count * row_height, .scroll_offset = frame.scroll})
    frame.scroll = scroll.scroll_offset
    if !scroll.opened {
        return Finish()
    }
    row_y := cast(s32)scroll.content.y
    left := cast(s32)scroll.content.x
    for index: cast(s32)0..state.row_count - 1 {
        // Rows outside the viewport are not read from the host.
        if row_y + row_height > cast(s32)scroll.viewport.y &&
        row_y < cast(s32)(scroll.viewport.y + scroll.viewport.height) {
            row := ReadLeaderboardRowHost(index)
            key := cast(u64)(7200 + index * 4)
            if row.own || index % 2 == 1 {
                Box(frame.session, BoxProps.{.key = key, .bounds = Bounds(left, row_y, width, row_height),
                        .fill = ifx row.own then Color.{156, 188, 143, 64} else Color.{156, 156, 156, 24},
                        .radius = cast(float32)Scale(8)})
            }
            name: Vec(u8)
            BuilderPrint(*name, "%. %", row.rank, row.name)
            pad := Scale(8)
            Cell(key + 1, left + pad, row_y, name_width - pad * 2, row_height, BuilderFinish(name))
            Cell(key + 2, left + name_width + pad, row_y, value_width - pad, row_height, row.streak)
            if state.has_average {
                Cell(key + 3, left + name_width + value_width + pad, row_y,
                    width - name_width - value_width - pad, row_height, row.average)
            }
        }
        row_y += row_height
    }
    End(frame.session)
    return Finish()
}
