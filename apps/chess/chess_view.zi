host_api :: #system_library "host_api";
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;
AppLocaleHost :: (key: string) -> string #foreign host_api;
AppRecordHost :: (name: string) -> string #foreign host_api;
SaveAppRecordHost :: (name: string, text: string) -> bool #foreign host_api;
AppFriendHost :: (index: s32) -> AppPerson #foreign host_api;
RefreshAppSharedHost :: () -> bool #foreign host_api;
// Keeps frames coming while the computer thinks.
SmoothFramesHost :: (frames: s32) -> bool #foreign host_api;

using ButtonTone;
using ButtonEmphasis;
using TextAlign;
using TextWrap;
using ImageFit;

CHESS_VIEW_COMPUTER :: 0
CHESS_VIEW_FRIENDS :: 1
CHESS_VIEW_FRIEND_GAME :: 2

// Which game the board shows.
CHESS_BOARD_NONE :: 0
CHESS_BOARD_COMPUTER :: 1
CHESS_BOARD_FRIEND :: 2

frame: AppUiFrame;
state: AppMessage;
view: s32 = CHESS_VIEW_COMPUTER;
board_game: s32 = CHESS_BOARD_NONE;
// The engine holds another position than the board's game, after a game
// with a friend was checked; it is loaded again before the next move.
board_stale: bool;
board_revision: s32 = -1;
open_game: string;
setup_open: bool;
setup_level: s32 = CHESS_LEVEL_MEDIUM;
setup_color: s32 = CHESS_WHITE;
selected: s32 = -1;
press_start: s32 = -1;
press_down: bool;
press_moved: bool;
press_x: float32;
press_y: float32;
promotion_from: s32 = -1;
promotion_to: s32 = -1;
notice: string;
notice_until: s64;
friends_scroll: s32;
hidden_loaded: bool;
hidden: string;

// Board colors from the app's palette: mist and a soft jade, with the
// light orange accent for the last move and lake blue for the selection.
LIGHT_SQUARE :: Color.{221, 233, 229, 255}
DARK_SQUARE :: Color.{127, 166, 154, 255}
LAST_MOVE :: Color.{242, 166, 94, 120}
SELECTION :: Color.{63, 111, 143, 130}
CHECK :: Color.{214, 104, 83, 190}
TARGET :: Color.{30, 74, 64, 95}
FRAME_EDGE :: Color.{110, 76, 54, 255}

Scale :: (pixels: s32) -> s32 {
    return cast(s32)(cast(float32)pixels * frame.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

// A translated text with %s replaced by `value`.
FormatLocaleText :: (key: string, value: string) -> string {
    template := AppLocaleHost(key)
    out: Vec(u8)
    at: s64 = 0
    used := false
    while at < template.count {
        if !used && at + 1 < template.count && template[at] == #char "%" && template[at + 1] == #char "s" {
            BuilderPrint(*out, "%", value)
            used = true
            at += 2
            continue
        }
        unused VecPush(out, template[at])
        at += 1
    }
    return BuilderFinish(out)
}

Finish :: () -> AppMessage {
    state.succeeded = true
    return state
}

Notice :: (key: string) {
    notice = key
    notice_until = state.time + 5
}

Line :: (key: u64, x: s32, y: s32, width: s32, height: s32, text: string, center: bool) {
    Text(frame.session, TextProps.{.key = key, .bounds = Bounds(x, y, width, height),
            .text = text, .font = frame.font, .wrap = cast(TextWrap)TextWrapAuto,
            .align = cast(TextAlign)(ifx center then TextAlignCenter else TextAlignStart),
            .vertical_align = cast(TextAlign)TextAlignCenter})
}

// One line that ends in "..." when it does not fit, for names.
Label :: (key: u64, x: s32, y: s32, width: s32, height: s32, text: string) {
    Text(frame.session, TextProps.{.key = key, .bounds = Bounds(x, y, width, height),
            .text = text, .font = frame.font, .wrap = cast(TextWrap)TextWrapEllipsis,
            .vertical_align = cast(TextAlign)TextAlignCenter})
}

// The notice of a failed change, for a few seconds after it failed.
NoticeText :: () -> string {
    if notice.count == 0 || state.time >= notice_until {
        return ""
    }
    return AppLocaleHost(notice)
}

ChoiceButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, chosen: bool) -> bool {
    return Button(frame.session, ButtonProps.{.id = id, .bounds = Bounds(x, y, width, height),
            .label = label, .selected = chosen, .fit_content = true,
            .tone = cast(ButtonTone)(ifx chosen then ButtonToneAccent else ButtonToneNeutral),
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0
}

ActionButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, disabled: bool) -> bool {
    return Button(frame.session, ButtonProps.{.id = id, .bounds = Bounds(x, y, width, height),
            .label = label, .disabled = disabled, .fit_content = true,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0
}

PieceAsset :: (piece: s32) -> string {
    kind := ChessKind(piece)
    white := ChessColor(piece) == CHESS_WHITE
    if kind == CHESS_PAWN {
        return ifx white then "assets/chess/pieces/white-pawn.png" else "assets/chess/pieces/black-pawn.png"
    }
    if kind == CHESS_KNIGHT {
        return ifx white then "assets/chess/pieces/white-knight.png" else "assets/chess/pieces/black-knight.png"
    }
    if kind == CHESS_BISHOP {
        return ifx white then "assets/chess/pieces/white-bishop.png" else "assets/chess/pieces/black-bishop.png"
    }
    if kind == CHESS_ROOK {
        return ifx white then "assets/chess/pieces/white-rook.png" else "assets/chess/pieces/black-rook.png"
    }
    if kind == CHESS_QUEEN {
        return ifx white then "assets/chess/pieces/white-queen.png" else "assets/chess/pieces/black-queen.png"
    }
    return ifx white then "assets/chess/pieces/white-king.png" else "assets/chess/pieces/black-king.png"
}

PieceName :: (piece: s32) -> string {
    kind := ChessKind(piece)
    if kind == CHESS_PAWN { return AppLocaleHost("chess_piece_pawn") }
    if kind == CHESS_KNIGHT { return AppLocaleHost("chess_piece_knight") }
    if kind == CHESS_BISHOP { return AppLocaleHost("chess_piece_bishop") }
    if kind == CHESS_ROOK { return AppLocaleHost("chess_piece_rook") }
    if kind == CHESS_QUEEN { return AppLocaleHost("chess_piece_queen") }
    return AppLocaleHost("chess_piece_king")
}

// Everything sits in one centered column, as wide as the largest board.
ColumnWidth :: () -> s32 {
    width := frame.width - Scale(16) * 2
    limit := Scale(560)
    return ifx width > limit then limit else width
}

ColumnLeft :: () -> s32 {
    return (frame.width - ColumnWidth()) / 2
}

// The board.

// The 0x88 square drawn at column/row from the top left, as `color` sees it.
SquareAt :: (column: s32, row: s32, flipped: bool) -> s32 {
    if flipped {
        return ChessSquare(7 - column, row)
    }
    return ChessSquare(column, 7 - row)
}

SquareColumn :: (square: s32, flipped: bool) -> s32 {
    return ifx flipped then 7 - ChessFile(square) else ChessFile(square)
}

SquareRow :: (square: s32, flipped: bool) -> s32 {
    return ifx flipped then ChessRank(square) else 7 - ChessRank(square)
}

SquareUnder :: (x: float32, y: float32, left: s32, top: s32, cell: s32, flipped: bool) -> s32 {
    column := cast(s32)((x - cast(float32)left) / cast(float32)cell)
    row := cast(s32)((y - cast(float32)top) / cast(float32)cell)
    if x < cast(float32)left || y < cast(float32)top || column < 0 || column > 7 || row < 0 || row > 7 {
        return -1
    }
    return SquareAt(column, row, flipped)
}

// Taps choose a piece and then its square; a piece can also be dragged.
// Returns a move to play, or zero. A promotion first asks for its piece.
BoardInput :: (left: s32, top: s32, cell: s32, flipped: bool, player: s32) -> s32 {
    press := Press(frame.session, PressProps.{.key = cast(u64)8300, .id = 8300,
            .bounds = Bounds(left, top, cell * 8, cell * 8), .label = AppLocaleHost("chess_board"),
            .now = frame.now, .capture = true})
    if press.down && !press_down {
        press_down = true
        press_moved = false
        press_x = press.x
        press_y = press.y
        press_start = SquareUnder(press.x, press.y, left, top, cell, flipped)
        piece := BoardPieceAt(press_start)
        if press_start >= 0 && piece != CHESS_EMPTY && ChessColor(piece) == player &&
        BoardHasMovesFrom(press_start) && !(selected >= 0 && BoardTargets(selected, press_start)) {
            selected = press_start
        }
    }
    if press.down {
        distance_x := press.x - press_x
        distance_y := press.y - press_y
        threshold := cast(float32)cell * 0.2
        if distance_x * distance_x + distance_y * distance_y > threshold * threshold {
            press_moved = true
        }
        press_x = press.x
        press_y = press.y
    }
    if !press.released {
        if !press.down {
            press_down = false
        }
        return 0
    }
    press_down = false
    end := SquareUnder(press.x, press.y, left, top, cell, flipped)
    from := selected
    if from < 0 || end < 0 {
        if !press_moved {
            selected = -1
        }
        return 0
    }
    if end == from {
        // A tap on the chosen piece keeps it chosen; a drag back drops it.
        return 0
    }
    if !BoardTargets(from, end) {
        piece := BoardPieceAt(end)
        if !press_moved && piece != CHESS_EMPTY && ChessColor(piece) == player && BoardHasMovesFrom(end) {
            selected = end
        } else {
            selected = -1
        }
        return 0
    }
    if BoardNeedsPromotion(from, end) {
        promotion_from = from
        promotion_to = end
        return 0
    }
    selected = -1
    return BoardFindMove(from, end, 0)
}

// Draws the board's game. When `player` may move, returns the move chosen.
DrawBoard :: (left: s32, top: s32, size: s32, flipped: bool, player: s32, interactive: bool) -> s32 {
    cell := size / 8
    size = cell * 8
    edge := Scale(3)
    Box(frame.session, BoxProps.{.key = cast(u64)8000,
            .bounds = Bounds(left - edge, top - edge, size + edge * 2, size + edge * 2),
            .fill = FRAME_EDGE, .radius = cast(float32)Scale(6)})
    row: s32 = 0
    while row < 8 {
        column: s32 = 0
        while column < 8 {
            square := SquareAt(column, row, flipped)
            x := left + column * cell
            y := top + row * cell
            index := row * 8 + column
            light := (ChessFile(square) + ChessRank(square)) % 2 == 1
            Box(frame.session, BoxProps.{.key = cast(u64)(8010 + index), .bounds = Bounds(x, y, cell, cell),
                    .fill = ifx light then LIGHT_SQUARE else DARK_SQUARE})
            if square == board_last_from || square == board_last_to {
                Box(frame.session, BoxProps.{.key = cast(u64)(8080 + index), .bounds = Bounds(x, y, cell, cell),
                        .fill = LAST_MOVE})
            }
            if square == selected {
                Box(frame.session, BoxProps.{.key = cast(u64)(8150 + index), .bounds = Bounds(x, y, cell, cell),
                        .fill = SELECTION})
            }
            if square == board_check {
                inset := cell / 10
                Box(frame.session, BoxProps.{.key = cast(u64)(8220 + index),
                        .bounds = Bounds(x + inset, y + inset, cell - inset * 2, cell - inset * 2),
                        .fill = CHECK, .radius = cast(float32)(cell / 2)})
            }
            column += 1
        }
        row += 1
    }
    dragging := press_down && press_moved && selected >= 0
    row = 0
    while row < 8 {
        column: s32 = 0
        while column < 8 {
            square := SquareAt(column, row, flipped)
            piece := BoardPieceAt(square)
            x := left + column * cell
            y := top + row * cell
            index := row * 8 + column
            if piece != CHESS_EMPTY && !(dragging && square == selected) {
                Image(frame.session, ImageProps.{.key = cast(u64)(8400 + index),
                        .asset_path = PieceAsset(piece), .alt_text = PieceName(piece),
                        .bounds = Bounds(x, y, cell, cell), .fit = cast(ImageFit)ImageFitContain,
                        .smooth = true})
            }
            if selected >= 0 && BoardTargets(selected, square) {
                if piece == CHESS_EMPTY {
                    dot := cell / 4
                    Box(frame.session, BoxProps.{.key = cast(u64)(8500 + index),
                            .bounds = Bounds(x + (cell - dot) / 2, y + (cell - dot) / 2, dot, dot),
                            .fill = TARGET, .radius = cast(float32)(dot / 2)})
                } else {
                    Box(frame.session, BoxProps.{.key = cast(u64)(8500 + index),
                            .bounds = Bounds(x, y, cell, cell), .fill = Color.{0, 0, 0, 0},
                            .border = TARGET, .radius = cast(float32)(cell / 2)})
                }
            }
            column += 1
        }
        row += 1
    }
    move: s32 = 0
    if interactive && promotion_from < 0 {
        move = BoardInput(left, top, cell, flipped, player)
    }
    if press_down && press_moved && selected >= 0 {
        piece := BoardPieceAt(selected)
        lifted := cell + cell / 5
        Image(frame.session, ImageProps.{.key = cast(u64)8390, .asset_path = PieceAsset(piece),
                .alt_text = PieceName(piece),
                .bounds = Rectangle.{press_x - cast(float32)(lifted / 2), press_y - cast(float32)(lifted / 2),
                    cast(float32)lifted, cast(float32)lifted},
                .fit = cast(ImageFit)ImageFitContain, .smooth = true})
    }
    if promotion_from >= 0 {
        // The four pieces a pawn may become, over the middle of the board.
        kinds: [4]s32 = .[CHESS_QUEEN, CHESS_ROOK, CHESS_BISHOP, CHESS_KNIGHT]
        pad := Scale(8)
        panel_width := cell * 4 + pad * 5
        panel_height := cell + pad * 2
        panel_x := left + (size - panel_width) / 2
        panel_y := top + (size - panel_height) / 2
        Box(frame.session, BoxProps.{.key = cast(u64)8600,
                .bounds = Bounds(panel_x, panel_y, panel_width, panel_height),
                .fill = Color.{30, 74, 64, 235}, .radius = cast(float32)Scale(10)})
        index: s32 = 0
        while index < 4 {
            piece := player | kinds[index]
            if Button(frame.session, ButtonProps.{.id = 8610 + index,
                    .bounds = Bounds(panel_x + pad + index * (cell + pad), panel_y + pad, cell, cell),
                    .label = PieceName(piece), .icon_only = true,
                    .image = ImageProps.{.asset_path = PieceAsset(piece), .alt_text = PieceName(piece),
                        .fit = cast(ImageFit)ImageFitContain, .smooth = true},
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
                move = BoardFindMove(promotion_from, promotion_to, kinds[index])
                promotion_from = -1
                promotion_to = -1
                selected = -1
            }
            index += 1
        }
    }
    return move
}

// Whose turn it is or how the game ended, from the player's side.
ResultText :: (result: s32, player: s32, opponent: string) -> string {
    if result == CHESS_CHECKMATE {
        won := board_side != player
        return AppLocaleHost(ifx won then "chess_you_won" else "chess_you_lost")
    }
    if result == CHESS_STALEMATE {
        return AppLocaleHost("chess_stalemate")
    }
    if result == CHESS_DRAW_FIFTY {
        return AppLocaleHost("chess_draw_fifty")
    }
    if result == CHESS_DRAW_REPETITION {
        return AppLocaleHost("chess_draw_repetition")
    }
    if result == CHESS_DRAW_MATERIAL {
        return AppLocaleHost("chess_draw_material")
    }
    if result == CHESS_DRAW_LENGTH {
        return AppLocaleHost("chess_draw_length")
    }
    resigned_side := ifx result == CHESS_WHITE_RESIGNED then CHESS_WHITE else CHESS_BLACK
    if resigned_side == player {
        return AppLocaleHost("chess_you_resigned")
    }
    if opponent.count > 0 {
        return FormatLocaleText("chess_they_resigned", opponent)
    }
    return AppLocaleHost("chess_you_won")
}

// The space the board may use under the status line and above `controls`.
BoardSize :: (top: s32, controls: s32) -> s32 {
    width := ColumnWidth()
    height := frame.height - frame.bottom - top - controls
    size := ifx width < height then width else height
    limit := Scale(560)
    if size > limit {
        size = limit
    }
    return (size / 8) * 8
}

// Makes sure the engine holds the board's game before it moves or thinks.
BoardReady :: () {
    if board_stale {
        unused BoardLoad(BoardMovesText(), ifx board_result == CHESS_WHITE_RESIGNED then CHESS_WHITE + 1 else ifx board_result == CHESS_BLACK_RESIGNED then CHESS_BLACK + 1 else 0)
        board_stale = false
    }
}

// Playing the computer.

DrawSetup :: (x: s32, y: s32, width: s32) -> s32 {
    gap := Scale(8)
    height := Scale(40)
    third := (width - gap * 2) / 3
    levels: [3]string = .["chess_level_easy", "chess_level_medium", "chess_level_hard"]
    index: s32 = 0
    while index < 3 {
        if ChoiceButton(8700 + index, x + index * (third + gap), y, third, height,
            AppLocaleHost(levels[index]), setup_level == index) {
            setup_level = index
        }
        index += 1
    }
    y += height + gap
    half := (width - gap) / 2
    if ChoiceButton(8710, x, y, half, height, AppLocaleHost("chess_play_white"), setup_color == CHESS_WHITE) {
        setup_color = CHESS_WHITE
    }
    if ChoiceButton(8711, x + half + gap, y, half, height, AppLocaleHost("chess_play_black"), setup_color == CHESS_BLACK) {
        setup_color = CHESS_BLACK
    }
    y += height + gap
    cancel_width := ifx computer_started then half else 0
    if computer_started && ActionButton(8712, x, y, half, height, AppLocaleHost("chess_cancel"), false) {
        setup_open = false
    }
    start_x := ifx computer_started then x + half + gap else x
    if Button(frame.session, ButtonProps.{.id = 8713, .bounds = Bounds(start_x, y,
            width - cancel_width - (ifx computer_started then gap else 0), height),
            .label = AppLocaleHost("chess_start"), .fit_content = true,
            .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
        ComputerNewGame(setup_level, setup_color, state.time)
        board_game = CHESS_BOARD_COMPUTER
        setup_open = false
        selected = -1
    }
    return y + height
}

ComputerView :: (top: s32) {
    margin := ColumnLeft()
    width := ColumnWidth()
    if board_game != CHESS_BOARD_COMPUTER {
        ComputerShow()
        board_game = CHESS_BOARD_COMPUTER
        board_stale = false
        selected = -1
        promotion_from = -1
        if !computer_started {
            setup_open = true
        }
    }
    if ComputerTurn() && !setup_open {
        BoardReady()
        if ComputerThink(frame.now) {
            unused SmoothFramesHost(2)
        }
    }
    status := AppLocaleHost("chess_your_move")
    if !computer_started {
        status = AppLocaleHost("chess_choose_game")
    } else if ChessFinished(board_result) {
        status = ResultText(board_result, computer_player, "")
    } else if computer_thinking || board_side != computer_player {
        status = AppLocaleHost("chess_thinking")
    } else if board_check >= 0 {
        status = AppLocaleHost("chess_check")
    }
    Line(cast(u64)8800, margin, top, width, Scale(44), status, true)
    top += Scale(52)
    controls := ifx setup_open then Scale(160) else Scale(64)
    size := BoardSize(top, controls)
    left := (frame.width - size) / 2
    interactive := computer_started && !setup_open && !computer_thinking &&
    board_side == computer_player && !ChessFinished(board_result)
    move := DrawBoard(left, top, size, computer_player == CHESS_BLACK, computer_player, interactive)
    if move != 0 {
        BoardReady()
        if ComputerPlay(move) {
            unused SmoothFramesHost(2)
        }
    }
    y := top + size + Scale(16)
    if setup_open {
        unused DrawSetup(margin, y, width)
        return
    }
    gap := Scale(8)
    half := (width - gap) / 2
    playing := computer_started && !ChessFinished(board_result)
    if ActionButton(8820, margin, y, half, Scale(40), AppLocaleHost("chess_resign"), !playing) {
        ComputerResign()
        selected = -1
    }
    if ActionButton(8821, margin + half + gap, y, half, Scale(40), AppLocaleHost("chess_new_game"), false) {
        setup_level = computer_level
        setup_color = computer_player
        setup_open = true
        selected = -1
        promotion_from = -1
    }
}

// Playing friends.

HiddenLoad :: () {
    if !hidden_loaded {
        hidden = AppRecordHost("hidden")
        hidden_loaded = true
    }
}

IsHidden :: (id: string) -> bool {
    HiddenLoad()
    at: s64 = 0
    while at < hidden.count {
        end := at
        while end < hidden.count && hidden[end] != #char " " {
            end += 1
        }
        if hidden[at:end] == id {
            return true
        }
        at = end + 1
    }
    return false
}

// Hides a finished game this player did not create. Only the last few
// dozen ids are kept; the node forgets the game once its owner removes it.
Hide :: (id: string) {
    HiddenLoad()
    out: Vec(u8)
    BuilderPrint(*out, "%", id)
    kept: s32 = 0
    at: s64 = 0
    while at < hidden.count && kept < 40 {
        end := at
        while end < hidden.count && hidden[end] != #char " " {
            end += 1
        }
        if end > at {
            BuilderPrint(*out, " %", hidden[at:end])
            kept += 1
        }
        at = end + 1
    }
    hidden = BuilderFinish(out)
    unused SaveAppRecordHost("hidden", hidden)
}

DisplayName :: (name: string, id: string) -> string {
    if name.count > 0 {
        return name
    }
    if id.count >= 4 {
        out: Vec(u8)
        BuilderPrint(*out, "%...", id[:4])
        return BuilderFinish(out)
    }
    return id
}

GameStatusText :: (game: OnlineGame) -> string {
    if pending != CHESS_PENDING_NONE && pending_game == game.id {
        return AppLocaleHost("chess_sending")
    }
    if !game.checked {
        return AppLocaleHost("chess_loading")
    }
    if !game.valid {
        return AppLocaleHost("chess_game_damaged")
    }
    if ChessFinished(game.result) {
        if game.result == CHESS_CHECKMATE {
            mated := ChessSideAfter(game.move_count)
            return AppLocaleHost(ifx mated == game.my_color then "chess_result_lost" else "chess_result_won")
        }
        if game.result == CHESS_WHITE_RESIGNED || game.result == CHESS_BLACK_RESIGNED {
            resigned := ifx game.result == CHESS_WHITE_RESIGNED then CHESS_WHITE else CHESS_BLACK
            return AppLocaleHost(ifx resigned == game.my_color then "chess_result_lost" else "chess_result_won")
        }
        return AppLocaleHost("chess_result_draw")
    }
    if OnlineMyTurn(game) {
        return AppLocaleHost("chess_your_move")
    }
    return FormatLocaleText("chess_their_move", DisplayName(game.opponent_name, game.opponent))
}

// Whether a game or an invitation with this friend is under way.
FriendBusy :: (id: string) -> bool {
    index: s32 = 0
    while index < online_count {
        if online[index].opponent == id && !(online[index].checked && ChessFinished(online[index].result)) {
            return true
        }
        index += 1
    }
    index = 0
    while index < invite_count {
        if invites[index].other == id && invites[index].status == "pending" {
            return true
        }
        index += 1
    }
    return false
}

FriendsView :: (top: s32) {
    margin := ColumnLeft()
    width := ColumnWidth()
    if !state.signed_in {
        Line(cast(u64)9000, margin, top, width, Scale(64), AppLocaleHost("chess_sign_in"), false)
        return
    }
    row_height := Scale(56)
    gap := Scale(8)
    heading := Scale(36)
    rows: s32 = 0
    index: s32 = 0
    while index < invite_count {
        if invites[index].incoming || invites[index].status != "accepted" {
            rows += 1
        }
        index += 1
    }
    games: s32 = 0
    index = 0
    while index < online_count {
        if !IsHidden(online[index].id) {
            games += 1
        }
        index += 1
    }
    content := heading * 3 + (rows + games) * (row_height + gap) + state.friend_count * (row_height + gap)
    if state.friend_count == 0 {
        content += Scale(64)
    }
    if rows + games == 0 {
        content += Scale(48)
    }
    scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)9010,
            .bounds = Bounds(margin, top, width, frame.height - frame.bottom - top - Scale(8)),
            .content_height = content, .scroll_offset = friends_scroll})
    friends_scroll = scroll.scroll_offset
    if !scroll.opened {
        return
    }
    x := cast(s32)scroll.content.x
    y := cast(s32)scroll.content.y
    width = cast(s32)scroll.content.width
    busy := pending != CHESS_PENDING_NONE
    if NoticeText().count > 0 {
        Line(cast(u64)9019, x, y, width, heading, NoticeText(), false)
        y += heading
    }
    Line(cast(u64)9020, x, y, width, heading, AppLocaleHost("chess_games_title"), false)
    y += heading
    if rows + games == 0 {
        Line(cast(u64)9021, x, y, width, Scale(40), AppLocaleHost("chess_no_games"), false)
        y += Scale(48)
    }
    button_width := Scale(96)
    index = 0
    while index < invite_count {
        invite := invites[index]
        name := DisplayName(invite.other_name, invite.other)
        id := 9100 + index * 4
        if invite.incoming && invite.status == "pending" {
            Line(cast(u64)id, x, y, width - button_width * 2 - gap * 2, row_height,
                FormatLocaleText("chess_invites_you", name), false)
            if ActionButton(id + 1, x + width - button_width * 2 - gap, y + Scale(8), button_width,
                Scale(40), AppLocaleHost("chess_decline"), busy) {
                unused OnlineAnswer(invite, false)
            }
            if Button(frame.session, ButtonProps.{.id = id + 2,
                    .bounds = Bounds(x + width - button_width, y + Scale(8), button_width, Scale(40)),
                    .label = AppLocaleHost("chess_accept"), .disabled = busy, .fit_content = true,
                    .tone = cast(ButtonTone)ButtonToneAccent,
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
                unused OnlineAnswer(invite, true)
            }
            y += row_height + gap
        } else if !invite.incoming && invite.status != "accepted" {
            key := ifx invite.status == "declined" then "chess_declined" else "chess_waiting_for"
            Line(cast(u64)id, x, y, width - button_width - gap, row_height, FormatLocaleText(key, name), false)
            label := ifx invite.status == "declined" then "chess_remove" else "chess_cancel"
            if ActionButton(id + 1, x + width - button_width, y + Scale(8), button_width, Scale(40),
                AppLocaleHost(label), busy) {
                unused OnlineRemove(invite.shared_id)
            }
            y += row_height + gap
        }
        index += 1
    }
    index = 0
    while index < online_count {
        game := online[index]
        if !IsHidden(game.id) {
            if Button(frame.session, ButtonProps.{.id = 9200 + index,
                    .bounds = Bounds(x, y, width, row_height),
                    .label = DisplayName(game.opponent_name, game.opponent),
                    .detail = GameStatusText(game),
                    .selected = OnlineMyTurn(game), .fit_content = true,
                    .tone = cast(ButtonTone)(ifx OnlineMyTurn(game) then ButtonToneAccent else ButtonToneNeutral),
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
                open_game = game.id
                view = CHESS_VIEW_FRIEND_GAME
                board_game = CHESS_BOARD_NONE
            }
            y += row_height + gap
        }
        index += 1
    }
    Line(cast(u64)9030, x, y, width, heading, AppLocaleHost("chess_invite_title"), false)
    y += heading
    if state.friend_count == 0 {
        Line(cast(u64)9031, x, y, width, Scale(56), AppLocaleHost("chess_no_friends"), false)
    }
    index = 0
    while index < state.friend_count {
        friend := AppFriendHost(index)
        friend_busy := FriendBusy(friend.id)
        id := 9300 + index * 2
        Label(cast(u64)id, x, y, width - button_width - gap, row_height,
            DisplayName(friend.name, friend.id))
        if ActionButton(id + 1, x + width - button_width, y + Scale(8), button_width, Scale(40),
            AppLocaleHost(ifx friend_busy then "chess_invited" else "chess_invite"), busy || friend_busy) {
            unused OnlineInvite(state.name, AppLocaleHost("chess_title"), friend.id, state.time, frame.now)
        }
        y += row_height + gap
        index += 1
    }
    End(frame.session)
}

FriendGameView :: (top: s32) {
    margin := ColumnLeft()
    width := ColumnWidth()
    index := OnlineFind(open_game)
    if index < 0 {
        view = CHESS_VIEW_FRIENDS
        board_game = CHESS_BOARD_NONE
        return
    }
    game := online[index]
    sending := pending != CHESS_PENDING_NONE && pending_game == game.id
    // Show the node's game unless a move of ours is on its way.
    if !game.checked {
        unused OnlineCheckNext()
        board_stale = true
        game = online[index]
    }
    if (board_game != CHESS_BOARD_FRIEND || board_revision != game.revision) && !sending {
        unused BoardLoad(game.moves, game.resigned)
        board_game = CHESS_BOARD_FRIEND
        board_revision = game.revision
        board_stale = false
        selected = -1
        promotion_from = -1
    }
    opponent := DisplayName(game.opponent_name, game.opponent)
    status := ""
    if sending {
        status = AppLocaleHost("chess_sending")
    } else if !game.valid {
        status = AppLocaleHost("chess_game_damaged")
    } else if ChessFinished(board_result) {
        status = ResultText(board_result, game.my_color, opponent)
    } else if board_side == game.my_color {
        status = AppLocaleHost(ifx board_check >= 0 then "chess_check" else "chess_your_move")
    } else {
        status = FormatLocaleText("chess_their_move", opponent)
    }
    if NoticeText().count > 0 {
        status = NoticeText()
    }
    Line(cast(u64)8900, margin, top, width, Scale(44), status, true)
    top += Scale(52)
    size := BoardSize(top, Scale(64))
    left := (frame.width - size) / 2
    interactive := game.valid && !sending && pending == CHESS_PENDING_NONE &&
    !ChessFinished(board_result) && board_side == game.my_color
    move := DrawBoard(left, top, size, game.my_color == CHESS_BLACK, game.my_color, interactive)
    if move != 0 {
        BoardReady()
        if BoardPlay(move) && !OnlineSend(index, game.resigned, CHESS_PENDING_MOVE) {
            Notice("chess_send_failed")
            board_game = CHESS_BOARD_NONE
        }
    }
    y := top + size + Scale(16)
    gap := Scale(8)
    half := (width - gap) / 2
    if ActionButton(8910, margin, y, half, Scale(40), AppLocaleHost("chess_back"), false) {
        view = CHESS_VIEW_FRIENDS
        board_game = CHESS_BOARD_NONE
        selected = -1
        promotion_from = -1
        return
    }
    finished := game.checked && ChessFinished(game.result)
    mine := game.owner == state.account
    if finished {
        if ActionButton(8911, margin + half + gap, y, half, Scale(40), AppLocaleHost("chess_remove"),
            pending != CHESS_PENDING_NONE) {
            if mine {
                unused OnlineRemove(game.id)
            } else {
                Hide(game.id)
            }
            view = CHESS_VIEW_FRIENDS
            board_game = CHESS_BOARD_NONE
        }
    } else if ActionButton(8911, margin + half + gap, y, half, Scale(40), AppLocaleHost("chess_resign"),
        pending != CHESS_PENDING_NONE || !game.valid) {
        if !OnlineSend(index, game.my_color + 1, CHESS_PENDING_RESIGN) {
            Notice("chess_send_failed")
        }
    }
}

ChessView :: (message: AppMessage) -> AppMessage {
    frame = ReadAppUiHost()
    state = message
    if state.signed_in && state.shared_revision != online_revision {
        OnlineReload(state)
        if view == CHESS_VIEW_FRIEND_GAME && pending == CHESS_PENDING_NONE {
            board_game = CHESS_BOARD_NONE
        }
    }
    if pending != CHESS_PENDING_NONE && state.shared_status != APP_SHARED_SENDING {
        failed := state.shared_status == APP_SHARED_FAILED || state.shared_status == APP_SHARED_UNAVAILABLE
        if failed {
            Notice("chess_send_failed")
        } else if state.shared_status == APP_SHARED_CONFLICT {
            moving := pending == CHESS_PENDING_MOVE || pending == CHESS_PENDING_RESIGN
            Notice(ifx moving then "chess_game_changed" else "chess_send_failed")
        }
        OnlineSettle(state.shared_status)
        // The board shows the node's game again.
        if view == CHESS_VIEW_FRIEND_GAME {
            board_game = CHESS_BOARD_NONE
        }
    }
    // Games with friends are checked one per frame, never while the
    // computer thinks, since checking uses the engine.
    if !computer_thinking && view != CHESS_VIEW_COMPUTER && OnlineCheckNext() {
        board_stale = true
    }
    margin := ColumnLeft()
    width := ColumnWidth()
    gap := Scale(8)
    half := (width - gap) / 2
    top := Scale(12)
    if ChoiceButton(8100 + 90, margin, top, half, Scale(40), AppLocaleHost("chess_tab_computer"),
        view == CHESS_VIEW_COMPUTER) && view != CHESS_VIEW_COMPUTER {
        view = CHESS_VIEW_COMPUTER
        selected = -1
        promotion_from = -1
    }
    if ChoiceButton(8100 + 91, margin + half + gap, top, half, Scale(40), AppLocaleHost("chess_tab_friends"),
        view != CHESS_VIEW_COMPUTER) && view == CHESS_VIEW_COMPUTER {
        ChessSearchCancel()
        computer_thinking = false
        view = CHESS_VIEW_FRIENDS
        board_game = CHESS_BOARD_NONE
        selected = -1
        promotion_from = -1
        if state.signed_in {
            unused RefreshAppSharedHost()
        }
    }
    top += Scale(52)
    if view == CHESS_VIEW_COMPUTER {
        ComputerView(top)
    } else if view == CHESS_VIEW_FRIENDS {
        FriendsView(top)
    } else {
        FriendGameView(top)
    }
    return Finish()
}
