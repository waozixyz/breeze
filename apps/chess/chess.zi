// Chess: play the computer at three levels, or a friend from the account's
// friend list. It is one of the apps the node offers; the host runs it
// through the generic app interface and never needs code of its own for it.
#import, file "../../src/cells/module_types.zi";
#import, file "../../src/cells/node_app_types.zi";
#import, file "chess_view.zi";
host_api :: #system_library "host_api";
ReadAppHost :: () -> AppMessage #foreign host_api;
WriteAppHost :: (message: AppMessage) #foreign host_api;

ChessApply :: (message: AppMessage) -> AppMessage {
    message.succeeded = true
    if message.action == APP_ROUTE {
        return message
    }
    if message.action == APP_FRAME {
        return ChessView(message)
    }
    message.succeeded = false
    return message
}

#program_export "ChessMain"
Main :: () -> s32 {
    message := ReadAppHost()
    if message.abi != MODULE_ABI {
        return -1
    }
    if message.action == MODULE_IDENTIFY {
        return MODULE_NODE_APP
    }
    WriteAppHost(ChessApply(message))
    return 0
}
