// The rules of chess and the computer opponent. The position lives in this
// module's globals: moves are made and taken back in place, so the search
// never copies a board. Squares use the 0x88 layout (rank * 16 + file), where
// a square with a bit of 0x88 set is off the board.
//
// The search runs a bounded number of positions per call and keeps its
// stack here between calls, so the app keeps drawing while the computer
// thinks, even in the portable interpreter.
#import "vec"

CHESS_EMPTY :: 0
CHESS_PAWN :: 1
CHESS_KNIGHT :: 2
CHESS_BISHOP :: 3
CHESS_ROOK :: 4
CHESS_QUEEN :: 5
CHESS_KING :: 6
CHESS_WHITE :: 0
CHESS_BLACK :: 8

// Castling rights.
CHESS_WHITE_SHORT :: 1
CHESS_WHITE_LONG :: 2
CHESS_BLACK_SHORT :: 4
CHESS_BLACK_LONG :: 8

// A move packs its squares, the promotion kind and what kind of move it is.
CHESS_MOVE_CAPTURE :: 1
CHESS_MOVE_DOUBLE :: 2
CHESS_MOVE_EN_PASSANT :: 4
CHESS_MOVE_CASTLE :: 8

// How a game stands for the side to move.
CHESS_PLAYING :: 0
CHESS_CHECKMATE :: 1
CHESS_STALEMATE :: 2
CHESS_DRAW_FIFTY :: 3
CHESS_DRAW_REPETITION :: 4
CHESS_DRAW_MATERIAL :: 5

CHESS_START_FEN :: "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"

// Moves are taken back only within this window; repetition looks back at
// most 100 reversible moves plus the search, so older entries are never read.
CHESS_HISTORY_SIZE :: 256
CHESS_HISTORY_MASK :: 255
CHESS_MAX_PLY :: 48
CHESS_PLY_MOVES :: 256
CHESS_MOVE_STACK :: 12288
CHESS_TABLE_SIZE :: 16384
CHESS_TABLE_MASK :: 16383
CHESS_INFINITY :: 32000
CHESS_MATE :: 30000
CHESS_MATE_BOUND :: 29000

CHESS_TABLE_EXACT :: 1
CHESS_TABLE_LOWER :: 2
CHESS_TABLE_UPPER :: 3

CHESS_STAGE_ENTER :: 0
CHESS_STAGE_NEXT :: 1

#scope_file
board: [128]s32;
side: s32;
castling: s32;
en_passant: s32 = -1;
halfmove: s32;
fullmove: s32 = 1;
king_square: [2]s32;
hash: u64;
initialized: bool;

undo_move: [CHESS_HISTORY_SIZE]s32;
undo_captured: [CHESS_HISTORY_SIZE]s32;
undo_castling: [CHESS_HISTORY_SIZE]s32;
undo_en_passant: [CHESS_HISTORY_SIZE]s32;
undo_halfmove: [CHESS_HISTORY_SIZE]s32;
undo_score: [CHESS_HISTORY_SIZE]s32;
undo_phase: [CHESS_HISTORY_SIZE]s32;
history_hash: [CHESS_HISTORY_SIZE]u64;
// Moves made since the position was loaded.
history_count: s32;

zobrist_piece: [2048]u64;
zobrist_castling: [16]u64;
zobrist_en_passant: [8]u64;
zobrist_side: u64;
castle_mask: [128]s32;
// The direction from one square to another on the same line, indexed by
// their difference + 119, or 0 when no line joins them.
line_step: [240]s32;

// The position's value is kept up to date as moves are made: each piece's
// worth and place from White's side (black pieces count negative), the
// game phase from the pieces left, and how many of each piece there are.
square_score: [2048]s32;
king_middle_score: [256]s32;
king_end_score: [256]s32;
score_base: s32;
phase_total: s32;
piece_count: [16]s32;

knight_steps: [8]s32 = .[-33, -31, -18, -14, 14, 18, 31, 33];
king_steps: [8]s32 = .[-17, -16, -15, -1, 1, 15, 16, 17];
rook_steps: [4]s32 = .[-16, -1, 1, 16];
bishop_steps: [4]s32 = .[-17, -15, 15, 17];
piece_value: [7]s32 = .[0, 100, 320, 330, 500, 900, 0];
phase_weight: [7]s32 = .[0, 0, 1, 1, 2, 4, 0];

// Piece-square tables as White sees the board, rank 8 first.
pawn_table: [64]s32 = .[
0, 0, 0, 0, 0, 0, 0, 0,
50, 50, 50, 50, 50, 50, 50, 50,
10, 10, 20, 30, 30, 20, 10, 10,
5, 5, 10, 25, 25, 10, 5, 5,
0, 0, 0, 20, 20, 0, 0, 0,
5, -5, -10, 0, 0, -10, -5, 5,
5, 10, 10, -20, -20, 10, 10, 5,
0, 0, 0, 0, 0, 0, 0, 0];
knight_table: [64]s32 = .[
-50, -40, -30, -30, -30, -30, -40, -50,
-40, -20, 0, 0, 0, 0, -20, -40,
-30, 0, 10, 15, 15, 10, 0, -30,
-30, 5, 15, 20, 20, 15, 5, -30,
-30, 0, 15, 20, 20, 15, 0, -30,
-30, 5, 10, 15, 15, 10, 5, -30,
-40, -20, 0, 5, 5, 0, -20, -40,
-50, -40, -30, -30, -30, -30, -40, -50];
bishop_table: [64]s32 = .[
-20, -10, -10, -10, -10, -10, -10, -20,
-10, 0, 0, 0, 0, 0, 0, -10,
-10, 0, 5, 10, 10, 5, 0, -10,
-10, 5, 5, 10, 10, 5, 5, -10,
-10, 0, 10, 10, 10, 10, 0, -10,
-10, 10, 10, 10, 10, 10, 10, -10,
-10, 5, 0, 0, 0, 0, 5, -10,
-20, -10, -10, -10, -10, -10, -10, -20];
rook_table: [64]s32 = .[
0, 0, 0, 0, 0, 0, 0, 0,
5, 10, 10, 10, 10, 10, 10, 5,
-5, 0, 0, 0, 0, 0, 0, -5,
-5, 0, 0, 0, 0, 0, 0, -5,
-5, 0, 0, 0, 0, 0, 0, -5,
-5, 0, 0, 0, 0, 0, 0, -5,
-5, 0, 0, 0, 0, 0, 0, -5,
0, 0, 0, 5, 5, 0, 0, 0];
queen_table: [64]s32 = .[
-20, -10, -10, -5, -5, -10, -10, -20,
-10, 0, 0, 0, 0, 0, 0, -10,
-10, 0, 5, 5, 5, 5, 0, -10,
-5, 0, 5, 5, 5, 5, 0, -5,
0, 0, 5, 5, 5, 5, 0, -5,
-10, 5, 5, 5, 5, 5, 0, -10,
-10, 0, 5, 0, 0, 0, 0, -10,
-20, -10, -10, -5, -5, -10, -10, -20];
king_middle_table: [64]s32 = .[
-30, -40, -40, -50, -50, -40, -40, -30,
-30, -40, -40, -50, -50, -40, -40, -30,
-30, -40, -40, -50, -50, -40, -40, -30,
-30, -40, -40, -50, -50, -40, -40, -30,
-20, -30, -30, -40, -40, -30, -30, -20,
-10, -20, -20, -20, -20, -20, -20, -10,
20, 20, 0, 0, 0, 0, 20, 20,
20, 30, 10, 0, 0, 10, 30, 20];
king_end_table: [64]s32 = .[
-50, -40, -30, -20, -20, -30, -40, -50,
-30, -20, -10, 0, 0, -10, -20, -30,
-30, -10, 20, 30, 30, 20, -10, -30,
-30, -10, 30, 40, 40, 30, -10, -30,
-30, -10, 30, 40, 40, 30, -10, -30,
-30, -10, 20, 30, 30, 20, -10, -30,
-30, -30, 0, 0, 0, 0, -30, -30,
-50, -30, -30, -30, -30, -30, -30, -50];

moves: [CHESS_MOVE_STACK]s32;
move_scores: [CHESS_MOVE_STACK]s32;
legal_moves: [CHESS_PLY_MOVES]s32;
legal_count: s32;

table_key: [CHESS_TABLE_SIZE]u64;
table_move: [CHESS_TABLE_SIZE]s32;
table_depth: [CHESS_TABLE_SIZE]s32;
table_score: [CHESS_TABLE_SIZE]s32;
table_flag: [CHESS_TABLE_SIZE]s32;
killer_first: [CHESS_MAX_PLY]s32;
killer_second: [CHESS_MAX_PLY]s32;
// How often a quiet move of a piece to a square caused a cutoff.
quiet_history: [2048]s32;

// The search's stack, one entry per ply below the position it started from.
search_stage: [CHESS_MAX_PLY]s32;
search_depth: [CHESS_MAX_PLY]s32;
search_alpha: [CHESS_MAX_PLY]s32;
search_beta: [CHESS_MAX_PLY]s32;
search_original_alpha: [CHESS_MAX_PLY]s32;
search_best: [CHESS_MAX_PLY]s32;
search_best_move: [CHESS_MAX_PLY]s32;
search_next: [CHESS_MAX_PLY]s32;
search_end: [CHESS_MAX_PLY]s32;
search_legal: [CHESS_MAX_PLY]s32;
search_current: [CHESS_MAX_PLY]s32;
search_quiet_only: [CHESS_MAX_PLY]bool;
search_in_check: [CHESS_MAX_PLY]bool;
search_table_move: [CHESS_MAX_PLY]s32;
// The child of a later move was looked at less deeply or with a narrow
// window; the depth it deserves when it is looked at again.
search_reduced: [CHESS_MAX_PLY]bool;
search_narrow: [CHESS_MAX_PLY]bool;
search_child_depth: [CHESS_MAX_PLY]s32;
search_ply: s32;
search_active: bool;
search_returning: bool;
search_return_score: s32;
search_iteration: s32;
search_max_depth: s32;
search_node_limit: s32;
search_nodes: s32;
search_quiescence: bool;
search_noise: s32;
search_seed: u64;
search_result: s32;
search_completed_move: s32;
search_completed_score: s32;
search_root_history: s32;

#scope_export

// Pieces and squares.

ChessColor :: (piece: s32) -> s32 {
    return piece & 8
}

ChessKind :: (piece: s32) -> s32 {
    return piece & 7
}

ChessOnBoard :: (square: s32) -> bool {
    return square >= 0 && square < 128 && (square & 0x88) == 0
}

ChessSquare :: (file: s32, rank: s32) -> s32 {
    return rank * 16 + file
}

ChessFile :: (square: s32) -> s32 {
    return square & 7
}

ChessRank :: (square: s32) -> s32 {
    return square >> 4
}

ChessPieceAt :: (square: s32) -> s32 {
    if !ChessOnBoard(square) {
        return CHESS_EMPTY
    }
    return board[square]
}

ChessSideToMove :: () -> s32 {
    return side
}

ChessHalfmoveClock :: () -> s32 {
    return halfmove
}

ChessFullmoveNumber :: () -> s32 {
    return fullmove
}

ChessHash :: () -> u64 {
    return hash
}

ChessKingSquare :: (color: s32) -> s32 {
    return king_square[color >> 3]
}

// Moves.

ChessMoveMake :: (from: s32, to: s32, promotion: s32, flags: s32) -> s32 {
    return from | (to << 7) | (promotion << 14) | (flags << 17)
}

ChessMoveFrom :: (move: s32) -> s32 {
    return move & 127
}

ChessMoveTo :: (move: s32) -> s32 {
    return (move >> 7) & 127
}

ChessMovePromotion :: (move: s32) -> s32 {
    return (move >> 14) & 7
}

ChessMoveFlags :: (move: s32) -> s32 {
    return (move >> 17) & 15
}

// Keys for the position hash come from a fixed sequence, so the same
// position hashes alike in every build.
#scope_file
NextKey :: (state: u64) -> u64 {
    value := state + cast(u64)0x9E3779B97F4A7C15
    value = (value ^ (value >> 30)) * cast(u64)0xBF58476D1CE4E5B9
    value = (value ^ (value >> 27)) * cast(u64)0x94D049BB133111EB
    return value ^ (value >> 31)
}

PieceKey :: (piece: s32, square: s32) -> u64 {
    return zobrist_piece[piece * 128 + square]
}

#scope_export
ChessInit :: () {
    if initialized {
        return
    }
    state: u64 = 20261017
    index: s32 = 0
    while index < 2048 {
        state = NextKey(state)
        zobrist_piece[index] = state
        index += 1
    }
    index = 0
    while index < 16 {
        state = NextKey(state)
        zobrist_castling[index] = state
        index += 1
    }
    index = 0
    while index < 8 {
        state = NextKey(state)
        zobrist_en_passant[index] = state
        index += 1
    }
    zobrist_side = NextKey(state)
    index = 0
    while index < 128 {
        castle_mask[index] = 15
        index += 1
    }
    castle_mask[0] = 15 & ~CHESS_WHITE_LONG
    castle_mask[4] = 15 & ~(CHESS_WHITE_SHORT | CHESS_WHITE_LONG)
    castle_mask[7] = 15 & ~CHESS_WHITE_SHORT
    castle_mask[112] = 15 & ~CHESS_BLACK_LONG
    castle_mask[116] = 15 & ~(CHESS_BLACK_SHORT | CHESS_BLACK_LONG)
    castle_mask[119] = 15 & ~CHESS_BLACK_SHORT
    PrepareScores()
    PrepareLines()
    initialized = true
}

#scope_file
PositionTable :: (kind: s32, at: s32) -> s32 {
    if kind == CHESS_PAWN {
        return pawn_table[at]
    }
    if kind == CHESS_KNIGHT {
        return knight_table[at]
    }
    if kind == CHESS_BISHOP {
        return bishop_table[at]
    }
    if kind == CHESS_ROOK {
        return rook_table[at]
    }
    if kind == CHESS_QUEEN {
        return queen_table[at]
    }
    return 0
}

PrepareScores :: () {
    rank: s32 = 0
    while rank < 8 {
        file: s32 = 0
        while file < 8 {
            square := rank * 16 + file
            white_at := TableIndex(square, CHESS_WHITE)
            black_at := TableIndex(square, CHESS_BLACK)
            kind: s32 = CHESS_PAWN
            while kind <= CHESS_QUEEN {
                square_score[(CHESS_WHITE | kind) * 128 + square] = piece_value[kind] + PositionTable(kind, white_at)
                square_score[(CHESS_BLACK | kind) * 128 + square] = -(piece_value[kind] + PositionTable(kind, black_at))
                kind += 1
            }
            king_middle_score[square] = king_middle_table[white_at]
            king_end_score[square] = king_end_table[white_at]
            king_middle_score[128 + square] = king_middle_table[black_at]
            king_end_score[128 + square] = king_end_table[black_at]
            file += 1
        }
        rank += 1
    }
}

// On the 0x88 board a difference between two squares names one direction,
// whichever squares they are.
PrepareLines :: () {
    from: s32 = 0
    while from < 128 {
        if (from & 0x88) == 0 {
            index: s32 = 0
            while index < 8 {
                step := king_steps[index]
                target := from + step
                while target >= 0 && target < 128 && (target & 0x88) == 0 {
                    line_step[target - from + 119] = step
                    target += step
                }
                index += 1
            }
        }
        from += 1
    }
}

// Rebuilds the kept value and counts from the board.
CountScore :: () {
    score_base = 0
    phase_total = 0
    index: s32 = 0
    while index < 16 {
        piece_count[index] = 0
        index += 1
    }
    rank: s32 = 0
    while rank < 8 {
        file: s32 = 0
        while file < 8 {
            square := rank * 16 + file
            piece := board[square]
            if piece != CHESS_EMPTY {
                piece_count[piece] += 1
                score_base += square_score[piece * 128 + square]
                phase_total += phase_weight[piece & 7]
            }
            file += 1
        }
        rank += 1
    }
}

#scope_export

#scope_file
ComputeHash :: () -> u64 {
    value: u64 = 0
    rank: s32 = 0
    while rank < 8 {
        file: s32 = 0
        while file < 8 {
            square := rank * 16 + file
            if board[square] != CHESS_EMPTY {
                value ^= PieceKey(board[square], square)
            }
            file += 1
        }
        rank += 1
    }
    value ^= zobrist_castling[castling]
    if en_passant >= 0 {
        value ^= zobrist_en_passant[en_passant & 7]
    }
    if side == CHESS_BLACK {
        value ^= zobrist_side
    }
    return value
}

ClearBoard :: () {
    index: s32 = 0
    while index < 128 {
        board[index] = CHESS_EMPTY
        index += 1
    }
    side = CHESS_WHITE
    castling = 0
    en_passant = -1
    halfmove = 0
    fullmove = 1
    king_square[0] = -1
    king_square[1] = -1
    history_count = 0
    CountScore()
}

PieceFromLetter :: (letter: u8) -> s32 {
    if letter == #char "P" { return CHESS_WHITE | CHESS_PAWN }
    if letter == #char "N" { return CHESS_WHITE | CHESS_KNIGHT }
    if letter == #char "B" { return CHESS_WHITE | CHESS_BISHOP }
    if letter == #char "R" { return CHESS_WHITE | CHESS_ROOK }
    if letter == #char "Q" { return CHESS_WHITE | CHESS_QUEEN }
    if letter == #char "K" { return CHESS_WHITE | CHESS_KING }
    if letter == #char "p" { return CHESS_BLACK | CHESS_PAWN }
    if letter == #char "n" { return CHESS_BLACK | CHESS_KNIGHT }
    if letter == #char "b" { return CHESS_BLACK | CHESS_BISHOP }
    if letter == #char "r" { return CHESS_BLACK | CHESS_ROOK }
    if letter == #char "q" { return CHESS_BLACK | CHESS_QUEEN }
    if letter == #char "k" { return CHESS_BLACK | CHESS_KING }
    return CHESS_EMPTY
}

PieceLetter :: (piece: s32) -> u8 {
    letters := "?PNBRQK"
    letter := letters[ChessKind(piece)]
    if ChessColor(piece) == CHESS_BLACK {
        return letter + cast(u8)32
    }
    return letter
}

// Reads a decimal number at text[at:], returning -1 when there is none.
NumberAt :: (text: string, at: s64) -> s32 {
    if at >= text.count {
        return -1
    }
    value: s32 = 0
    digits: s32 = 0
    while at < text.count && text[at] >= #char "0" && text[at] <= #char "9" {
        if digits >= 6 {
            return -1
        }
        value = value * 10 + cast(s32)(text[at] - #char "0")
        digits += 1
        at += 1
    }
    if digits == 0 {
        return -1
    }
    return value
}

SkipField :: (text: string, at: s64) -> s64 {
    while at < text.count && text[at] != #char " " {
        at += 1
    }
    while at < text.count && text[at] == #char " " {
        at += 1
    }
    return at
}

#scope_export

// Loads a position in Forsyth-Edwards Notation. A position without exactly
// one king for each side, or with the side not to move in check, is refused
// and leaves the board empty.
ChessLoadFen :: (fen: string) -> bool {
    ChessInit()
    ClearBoard()
    at: s64 = 0
    rank: s32 = 7
    file: s32 = 0
    white_kings: s32 = 0
    black_kings: s32 = 0
    while at < fen.count && fen[at] != #char " " {
        letter := fen[at]
        if letter == #char "/" {
            if file != 8 || rank == 0 {
                ClearBoard()
                return false
            }
            rank -= 1
            file = 0
        } else if letter >= #char "1" && letter <= #char "8" {
            file += cast(s32)(letter - #char "0")
            if file > 8 {
                ClearBoard()
                return false
            }
        } else {
            piece := PieceFromLetter(letter)
            if piece == CHESS_EMPTY || file > 7 {
                ClearBoard()
                return false
            }
            square := ChessSquare(file, rank)
            // Pawns never stand on the first or last rank.
            if ChessKind(piece) == CHESS_PAWN && (rank == 0 || rank == 7) {
                ClearBoard()
                return false
            }
            board[square] = piece
            if piece == (CHESS_WHITE | CHESS_KING) {
                white_kings += 1
                king_square[0] = square
            }
            if piece == (CHESS_BLACK | CHESS_KING) {
                black_kings += 1
                king_square[1] = square
            }
            file += 1
        }
        at += 1
    }
    if rank != 0 || file != 8 || white_kings != 1 || black_kings != 1 {
        ClearBoard()
        return false
    }
    at = SkipField(fen, at)
    if at < fen.count && fen[at] == #char "b" {
        side = CHESS_BLACK
    } else if at < fen.count && fen[at] == #char "w" {
        side = CHESS_WHITE
    } else {
        ClearBoard()
        return false
    }
    at = SkipField(fen, at)
    while at < fen.count && fen[at] != #char " " {
        letter := fen[at]
        if letter == #char "K" && board[4] == (CHESS_WHITE | CHESS_KING) &&
        board[7] == (CHESS_WHITE | CHESS_ROOK) {
            castling |= CHESS_WHITE_SHORT
        } else if letter == #char "Q" && board[4] == (CHESS_WHITE | CHESS_KING) &&
        board[0] == (CHESS_WHITE | CHESS_ROOK) {
            castling |= CHESS_WHITE_LONG
        } else if letter == #char "k" && board[116] == (CHESS_BLACK | CHESS_KING) &&
        board[119] == (CHESS_BLACK | CHESS_ROOK) {
            castling |= CHESS_BLACK_SHORT
        } else if letter == #char "q" && board[116] == (CHESS_BLACK | CHESS_KING) &&
        board[112] == (CHESS_BLACK | CHESS_ROOK) {
            castling |= CHESS_BLACK_LONG
        }
        at += 1
    }
    at = SkipField(fen, at)
    if at + 1 < fen.count && fen[at] >= #char "a" && fen[at] <= #char "h" &&
    (fen[at + 1] == #char "3" || fen[at + 1] == #char "6") {
        square := ChessSquare(cast(s32)(fen[at] - #char "a"), cast(s32)(fen[at + 1] - #char "1"))
        // The square counts only when a pawn of the side to move can take.
        if PawnCanTakeOn(square, side) {
            en_passant = square
        }
    }
    at = SkipField(fen, at)
    clock := NumberAt(fen, at)
    if clock >= 0 {
        halfmove = clock
        at = SkipField(fen, at)
        number := NumberAt(fen, at)
        if number > 0 {
            fullmove = number
        }
    }
    if ChessSquareAttacked(king_square[(side ^ 8) >> 3], side) {
        ClearBoard()
        return false
    }
    hash = ComputeHash()
    CountScore()
    return true
}

// Whether the hash and kept value still match the board, for tests.
ChessConsistent :: () -> bool {
    kept_score := score_base
    kept_phase := phase_total
    kept_counts: [16]s32
    index: s32 = 0
    while index < 16 {
        kept_counts[index] = piece_count[index]
        index += 1
    }
    CountScore()
    same := kept_score == score_base && kept_phase == phase_total && ComputeHash() == hash
    index = 0
    while index < 16 {
        if kept_counts[index] != piece_count[index] {
            same = false
        }
        index += 1
    }
    return same
}

ChessReset :: () {
    unused ChessLoadFen(CHESS_START_FEN)
}

ChessFen :: () -> string {
    out: Vec(u8)
    rank: s32 = 7
    while rank >= 0 {
        empty: s32 = 0
        file: s32 = 0
        while file < 8 {
            piece := board[ChessSquare(file, rank)]
            if piece == CHESS_EMPTY {
                empty += 1
            } else {
                if empty > 0 {
                    unused VecPush(out, cast(u8)(#char "0" + cast(u8)empty))
                    empty = 0
                }
                unused VecPush(out, PieceLetter(piece))
            }
            file += 1
        }
        if empty > 0 {
            unused VecPush(out, cast(u8)(#char "0" + cast(u8)empty))
        }
        if rank > 0 {
            unused VecPush(out, #char "/")
        }
        rank -= 1
    }
    BuilderPrint(*out, " %", ifx side == CHESS_WHITE then "w" else "b")
    unused VecPush(out, #char " ")
    if castling == 0 {
        unused VecPush(out, #char "-")
    }
    if (castling & CHESS_WHITE_SHORT) != 0 {
        unused VecPush(out, #char "K")
    }
    if (castling & CHESS_WHITE_LONG) != 0 {
        unused VecPush(out, #char "Q")
    }
    if (castling & CHESS_BLACK_SHORT) != 0 {
        unused VecPush(out, #char "k")
    }
    if (castling & CHESS_BLACK_LONG) != 0 {
        unused VecPush(out, #char "q")
    }
    unused VecPush(out, #char " ")
    if en_passant < 0 {
        unused VecPush(out, #char "-")
    } else {
        unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(en_passant)))
        unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(en_passant)))
    }
    BuilderPrint(*out, " % %", halfmove, fullmove)
    return BuilderFinish(out)
}

// Attacks.

// Whether a piece of `by` attacks `square`. Bounds are tested inline
// ((target & 0x88) == 0 also rejects the small negative squares a step can
// reach), since calls are the costly part in the portable interpreter.
ChessSquareAttacked :: (square: s32, by: s32) -> bool {
    if square < 0 || square >= 128 || (square & 0x88) != 0 {
        return false
    }
    if by == CHESS_WHITE {
        target := square - 15
        if (target & 0x88) == 0 && board[target] == (CHESS_WHITE | CHESS_PAWN) {
            return true
        }
        target = square - 17
        if (target & 0x88) == 0 && board[target] == (CHESS_WHITE | CHESS_PAWN) {
            return true
        }
    } else {
        target := square + 15
        if (target & 0x88) == 0 && board[target] == (CHESS_BLACK | CHESS_PAWN) {
            return true
        }
        target = square + 17
        if (target & 0x88) == 0 && board[target] == (CHESS_BLACK | CHESS_PAWN) {
            return true
        }
    }
    knight := by | CHESS_KNIGHT
    king := by | CHESS_KING
    index: s32 = 0
    while index < 8 {
        target := square + knight_steps[index]
        if (target & 0x88) == 0 && board[target] == knight {
            return true
        }
        target = square + king_steps[index]
        if (target & 0x88) == 0 && board[target] == king {
            return true
        }
        index += 1
    }
    rook := by | CHESS_ROOK
    bishop := by | CHESS_BISHOP
    queen := by | CHESS_QUEEN
    index = 0
    while index < 4 {
        step := rook_steps[index]
        target := square + step
        while (target & 0x88) == 0 {
            piece := board[target]
            if piece != CHESS_EMPTY {
                if piece == rook || piece == queen {
                    return true
                }
                break
            }
            target += step
        }
        step = bishop_steps[index]
        target = square + step
        while (target & 0x88) == 0 {
            piece := board[target]
            if piece != CHESS_EMPTY {
                if piece == bishop || piece == queen {
                    return true
                }
                break
            }
            target += step
        }
        index += 1
    }
    return false
}

ChessInCheck :: () -> bool {
    return ChessSquareAttacked(king_square[side >> 3], side ^ 8)
}

#scope_file
// Whether a pawn of `color` could take a pawn that just passed `square`.
PawnCanTakeOn :: (square: s32, color: s32) -> bool {
    pawn := color | CHESS_PAWN
    if color == CHESS_WHITE {
        return (ChessOnBoard(square - 15) && board[square - 15] == pawn) ||
        (ChessOnBoard(square - 17) && board[square - 17] == pawn)
    }
    return (ChessOnBoard(square + 15) && board[square + 15] == pawn) ||
    (ChessOnBoard(square + 17) && board[square + 17] == pawn)
}

// Move generation writes pseudo-legal moves from moves[start]; the mover's
// king may still be left in check, which making the move reveals. Moves are
// written inline rather than through a helper, for the interpreter.
AddPawnMove :: (count: s32, from: s32, to: s32, flags: s32, captures_only: bool) -> s32 {
    rank := to >> 4
    base := from | (to << 7) | (flags << 17)
    if rank == 7 || rank == 0 {
        moves[count] = base | (CHESS_QUEEN << 14)
        if captures_only {
            return count + 1
        }
        moves[count + 1] = base | (CHESS_ROOK << 14)
        moves[count + 2] = base | (CHESS_BISHOP << 14)
        moves[count + 3] = base | (CHESS_KNIGHT << 14)
        return count + 4
    }
    if captures_only && (flags & CHESS_MOVE_CAPTURE) == 0 {
        return count
    }
    moves[count] = base
    return count + 1
}

PawnMoves :: (square: s32, count: s32, captures_only: bool) -> s32 {
    forward: s32 = ifx side == CHESS_WHITE then 16 else -16
    start_rank: s32 = ifx side == CHESS_WHITE then 1 else 6
    enemy := side ^ 8
    ahead := square + forward
    if (ahead & 0x88) == 0 && board[ahead] == CHESS_EMPTY {
        count = AddPawnMove(count, square, ahead, 0, captures_only)
        two := ahead + forward
        if !captures_only && (square >> 4) == start_rank && board[two] == CHESS_EMPTY {
            moves[count] = square | (two << 7) | (CHESS_MOVE_DOUBLE << 17)
            count += 1
        }
    }
    target := ahead - 1
    if (target & 0x88) == 0 {
        piece := board[target]
        if piece != CHESS_EMPTY && (piece & 8) == enemy {
            count = AddPawnMove(count, square, target, CHESS_MOVE_CAPTURE, captures_only)
        } else if target == en_passant {
            moves[count] = square | (target << 7) | ((CHESS_MOVE_CAPTURE | CHESS_MOVE_EN_PASSANT) << 17)
            count += 1
        }
    }
    target = ahead + 1
    if (target & 0x88) == 0 {
        piece := board[target]
        if piece != CHESS_EMPTY && (piece & 8) == enemy {
            count = AddPawnMove(count, square, target, CHESS_MOVE_CAPTURE, captures_only)
        } else if target == en_passant {
            moves[count] = square | (target << 7) | ((CHESS_MOVE_CAPTURE | CHESS_MOVE_EN_PASSANT) << 17)
            count += 1
        }
    }
    return count
}

StepMoves :: (square: s32, count: s32, steps: [8]s32, captures_only: bool) -> s32 {
    enemy := side ^ 8
    index: s32 = 0
    while index < 8 {
        target := square + steps[index]
        if (target & 0x88) == 0 {
            piece := board[target]
            if piece == CHESS_EMPTY {
                if !captures_only {
                    moves[count] = square | (target << 7)
                    count += 1
                }
            } else if (piece & 8) == enemy {
                moves[count] = square | (target << 7) | (CHESS_MOVE_CAPTURE << 17)
                count += 1
            }
        }
        index += 1
    }
    return count
}

SlideMoves :: (square: s32, count: s32, steps: [4]s32, captures_only: bool) -> s32 {
    enemy := side ^ 8
    index: s32 = 0
    while index < 4 {
        step := steps[index]
        target := square + step
        while (target & 0x88) == 0 {
            piece := board[target]
            if piece == CHESS_EMPTY {
                if !captures_only {
                    moves[count] = square | (target << 7)
                    count += 1
                }
            } else {
                if (piece & 8) == enemy {
                    moves[count] = square | (target << 7) | (CHESS_MOVE_CAPTURE << 17)
                    count += 1
                }
                break
            }
            target += step
        }
        index += 1
    }
    return count
}

// The king may not castle out of, through or into check; into check is left
// to the legality test that every king move passes.
CastleMoves :: (count: s32) -> s32 {
    enemy := side ^ 8
    if side == CHESS_WHITE {
        if board[4] != (CHESS_WHITE | CHESS_KING) || ChessSquareAttacked(4, enemy) {
            return count
        }
        if (castling & CHESS_WHITE_SHORT) != 0 && board[5] == CHESS_EMPTY &&
        board[6] == CHESS_EMPTY && board[7] == (CHESS_WHITE | CHESS_ROOK) &&
        !ChessSquareAttacked(5, enemy) {
            moves[count] = ChessMoveMake(4, 6, 0, CHESS_MOVE_CASTLE)
            count += 1
        }
        if (castling & CHESS_WHITE_LONG) != 0 && board[3] == CHESS_EMPTY &&
        board[2] == CHESS_EMPTY && board[1] == CHESS_EMPTY &&
        board[0] == (CHESS_WHITE | CHESS_ROOK) && !ChessSquareAttacked(3, enemy) {
            moves[count] = ChessMoveMake(4, 2, 0, CHESS_MOVE_CASTLE)
            count += 1
        }
        return count
    }
    if board[116] != (CHESS_BLACK | CHESS_KING) || ChessSquareAttacked(116, enemy) {
        return count
    }
    if (castling & CHESS_BLACK_SHORT) != 0 && board[117] == CHESS_EMPTY &&
    board[118] == CHESS_EMPTY && board[119] == (CHESS_BLACK | CHESS_ROOK) &&
    !ChessSquareAttacked(117, enemy) {
        moves[count] = ChessMoveMake(116, 118, 0, CHESS_MOVE_CASTLE)
        count += 1
    }
    if (castling & CHESS_BLACK_LONG) != 0 && board[115] == CHESS_EMPTY &&
    board[114] == CHESS_EMPTY && board[113] == CHESS_EMPTY &&
    board[112] == (CHESS_BLACK | CHESS_ROOK) && !ChessSquareAttacked(115, enemy) {
        moves[count] = ChessMoveMake(116, 114, 0, CHESS_MOVE_CASTLE)
        count += 1
    }
    return count
}

GenerateMoves :: (start: s32, captures_only: bool) -> s32 {
    count := start
    square: s32 = 0
    while square < 120 {
        if (square & 0x88) != 0 {
            square += 8
            continue
        }
        piece := board[square]
        if piece != CHESS_EMPTY && (piece & 8) == side {
            kind := piece & 7
            if kind == CHESS_PAWN {
                count = PawnMoves(square, count, captures_only)
            } else if kind == CHESS_KNIGHT {
                count = StepMoves(square, count, knight_steps, captures_only)
            } else if kind == CHESS_BISHOP {
                count = SlideMoves(square, count, bishop_steps, captures_only)
            } else if kind == CHESS_ROOK {
                count = SlideMoves(square, count, rook_steps, captures_only)
            } else if kind == CHESS_QUEEN {
                count = SlideMoves(square, count, bishop_steps, captures_only)
                count = SlideMoves(square, count, rook_steps, captures_only)
            } else {
                count = StepMoves(square, count, king_steps, captures_only)
                if !captures_only {
                    count = CastleMoves(count)
                }
            }
        }
        square += 1
    }
    return count
}

#scope_export

// Makes a pseudo-legal move. Afterwards ChessLeftInCheck tells whether it
// was legal; take it back with ChessUnmakeMove either way.
ChessMakeMove :: (move: s32) {
    from := move & 127
    to := (move >> 7) & 127
    flags := (move >> 17) & 15
    piece := board[from]
    captured := board[to]
    slot := history_count & CHESS_HISTORY_MASK
    undo_move[slot] = move
    undo_castling[slot] = castling
    undo_en_passant[slot] = en_passant
    undo_halfmove[slot] = halfmove
    undo_score[slot] = score_base
    undo_phase[slot] = phase_total
    history_hash[slot] = hash
    if en_passant >= 0 {
        hash ^= zobrist_en_passant[en_passant & 7]
    }
    hash ^= zobrist_castling[castling]
    if (flags & CHESS_MOVE_EN_PASSANT) != 0 {
        taken: s32 = ifx side == CHESS_WHITE then to - 16 else to + 16
        captured = board[taken]
        board[taken] = CHESS_EMPTY
        hash ^= zobrist_piece[captured * 128 + taken]
        score_base -= square_score[captured * 128 + taken]
        piece_count[captured] -= 1
    } else if captured != CHESS_EMPTY {
        hash ^= zobrist_piece[captured * 128 + to]
        score_base -= square_score[captured * 128 + to]
        phase_total -= phase_weight[captured & 7]
        piece_count[captured] -= 1
    }
    undo_captured[slot] = captured
    board[from] = CHESS_EMPTY
    hash ^= zobrist_piece[piece * 128 + from]
    score_base -= square_score[piece * 128 + from]
    placed := piece
    promotion := (move >> 14) & 7
    if promotion != 0 {
        placed = side | promotion
        piece_count[piece] -= 1
        piece_count[placed] += 1
        phase_total += phase_weight[promotion]
    }
    board[to] = placed
    hash ^= zobrist_piece[placed * 128 + to]
    score_base += square_score[placed * 128 + to]
    if (piece & 7) == CHESS_KING {
        king_square[side >> 3] = to
        if (flags & CHESS_MOVE_CASTLE) != 0 {
            rook_from: s32 = to + 1
            rook_to: s32 = to - 1
            if (to & 7) == 2 {
                rook_from = to - 2
                rook_to = to + 1
            }
            rook := board[rook_from]
            board[rook_from] = CHESS_EMPTY
            board[rook_to] = rook
            hash ^= zobrist_piece[rook * 128 + rook_from]
            hash ^= zobrist_piece[rook * 128 + rook_to]
            score_base += square_score[rook * 128 + rook_to] - square_score[rook * 128 + rook_from]
        }
    }
    castling &= castle_mask[from] & castle_mask[to]
    hash ^= zobrist_castling[castling]
    en_passant = -1
    if (flags & CHESS_MOVE_DOUBLE) != 0 {
        passed := (from + to) / 2
        if PawnCanTakeOn(passed, side ^ 8) {
            en_passant = passed
            hash ^= zobrist_en_passant[passed & 7]
        }
    }
    if (piece & 7) == CHESS_PAWN || captured != CHESS_EMPTY {
        halfmove = 0
    } else {
        halfmove += 1
    }
    if side == CHESS_BLACK {
        fullmove += 1
    }
    side ^= 8
    hash ^= zobrist_side
    history_count += 1
}

ChessUnmakeMove :: () {
    if history_count <= 0 {
        return
    }
    history_count -= 1
    slot := history_count & CHESS_HISTORY_MASK
    move := undo_move[slot]
    side ^= 8
    if side == CHESS_BLACK {
        fullmove -= 1
    }
    from := move & 127
    to := (move >> 7) & 127
    flags := (move >> 17) & 15
    piece := board[to]
    promotion := (move >> 14) & 7
    if promotion != 0 {
        piece_count[piece] -= 1
        piece = side | CHESS_PAWN
        piece_count[piece] += 1
    }
    board[from] = piece
    board[to] = CHESS_EMPTY
    captured := undo_captured[slot]
    if captured != CHESS_EMPTY {
        piece_count[captured] += 1
    }
    if (flags & CHESS_MOVE_EN_PASSANT) != 0 {
        taken: s32 = ifx side == CHESS_WHITE then to - 16 else to + 16
        board[taken] = captured
    } else {
        board[to] = captured
    }
    if (piece & 7) == CHESS_KING {
        king_square[side >> 3] = from
        if (flags & CHESS_MOVE_CASTLE) != 0 {
            rook_from: s32 = to + 1
            rook_to: s32 = to - 1
            if (to & 7) == 2 {
                rook_from = to - 2
                rook_to = to + 1
            }
            board[rook_from] = board[rook_to]
            board[rook_to] = CHESS_EMPTY
        }
    }
    castling = undo_castling[slot]
    en_passant = undo_en_passant[slot]
    halfmove = undo_halfmove[slot]
    score_base = undo_score[slot]
    phase_total = undo_phase[slot]
    hash = history_hash[slot]
}

// After ChessMakeMove: whether the side that moved left its king attacked.
ChessLeftInCheck :: () -> bool {
    mover := side ^ 8
    return ChessSquareAttacked(king_square[mover >> 3], side)
}

#scope_file
// After making `move`: whether it left the mover's king attacked. A move
// that starts off every line through a king that was not in check cannot
// uncover an attack, so only king moves, en passant, checks and moves from
// such a line are tested.
MoveExposesKing :: (move: s32, was_in_check: bool) -> bool {
    mover := side ^ 8
    king := king_square[mover >> 3]
    from := move & 127
    if was_in_check || board[king] != (mover | CHESS_KING) ||
    ((move >> 17) & (CHESS_MOVE_EN_PASSANT | CHESS_MOVE_CASTLE)) != 0 ||
    king == ((move >> 7) & 127) || line_step[from - king + 119] != 0 {
        return ChessSquareAttacked(king, side)
    }
    return false
}

#scope_export

// Legal moves of the side to move, kept until the next call.
ChessGenerateLegal :: () -> s32 {
    in_check := ChessInCheck()
    end := GenerateMoves(0, false)
    legal_count = 0
    index: s32 = 0
    while index < end {
        move := moves[index]
        ChessMakeMove(move)
        if !MoveExposesKing(move, in_check) {
            legal_moves[legal_count] = move
            legal_count += 1
        }
        ChessUnmakeMove()
        index += 1
    }
    return legal_count
}

ChessLegalAt :: (index: s32) -> s32 {
    if index < 0 || index >= legal_count {
        return 0
    }
    return legal_moves[index]
}

// The legal move from `from` to `to`; promotions need their kind.
ChessFindMove :: (from: s32, to: s32, promotion: s32) -> s32 {
    count := ChessGenerateLegal()
    index: s32 = 0
    while index < count {
        move := legal_moves[index]
        if ChessMoveFrom(move) == from && ChessMoveTo(move) == to &&
        ChessMovePromotion(move) == promotion {
            return move
        }
        index += 1
    }
    return 0
}

// Coordinates such as e2e4 or e7e8q; zero unless legal here.
ChessMoveFromText :: (text: string) -> s32 {
    if text.count != 4 && text.count != 5 {
        return 0
    }
    if text[0] < #char "a" || text[0] > #char "h" || text[2] < #char "a" || text[2] > #char "h" ||
    text[1] < #char "1" || text[1] > #char "8" || text[3] < #char "1" || text[3] > #char "8" {
        return 0
    }
    from := ChessSquare(cast(s32)(text[0] - #char "a"), cast(s32)(text[1] - #char "1"))
    to := ChessSquare(cast(s32)(text[2] - #char "a"), cast(s32)(text[3] - #char "1"))
    promotion: s32 = 0
    if text.count == 5 {
        letter := text[4]
        if letter == #char "q" {
            promotion = CHESS_QUEEN
        } else if letter == #char "r" {
            promotion = CHESS_ROOK
        } else if letter == #char "b" {
            promotion = CHESS_BISHOP
        } else if letter == #char "n" {
            promotion = CHESS_KNIGHT
        } else {
            return 0
        }
    }
    return ChessFindMove(from, to, promotion)
}

// Makes the move written in coordinates, such as e2e4 or e7e8q, and returns
// it; zero, with the position unchanged, unless it is legal here. Cheaper
// than ChessMoveFromText for replaying a game, since only the matching
// move is tested.
ChessPlayText :: (text: string) -> s32 {
    if text.count != 4 && text.count != 5 {
        return 0
    }
    if text[0] < #char "a" || text[0] > #char "h" || text[2] < #char "a" || text[2] > #char "h" ||
    text[1] < #char "1" || text[1] > #char "8" || text[3] < #char "1" || text[3] > #char "8" {
        return 0
    }
    from := ChessSquare(cast(s32)(text[0] - #char "a"), cast(s32)(text[1] - #char "1"))
    to := ChessSquare(cast(s32)(text[2] - #char "a"), cast(s32)(text[3] - #char "1"))
    promotion: s32 = 0
    if text.count == 5 {
        letter := text[4]
        if letter == #char "q" {
            promotion = CHESS_QUEEN
        } else if letter == #char "r" {
            promotion = CHESS_ROOK
        } else if letter == #char "b" {
            promotion = CHESS_BISHOP
        } else if letter == #char "n" {
            promotion = CHESS_KNIGHT
        } else {
            return 0
        }
    }
    piece := board[from]
    if piece == CHESS_EMPTY || (piece & 8) != side {
        return 0
    }
    in_check := ChessInCheck()
    end := GenerateMoves(0, false)
    index: s32 = 0
    while index < end {
        move := moves[index]
        if (move & 127) == from && ((move >> 7) & 127) == to && ((move >> 14) & 7) == promotion {
            ChessMakeMove(move)
            if MoveExposesKing(move, in_check) {
                ChessUnmakeMove()
                return 0
            }
            return move
        }
        index += 1
    }
    return 0
}

ChessMoveText :: (move: s32) -> string {
    out: Vec(u8)
    from := ChessMoveFrom(move)
    to := ChessMoveTo(move)
    unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(from)))
    unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(from)))
    unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(to)))
    unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(to)))
    promotion := ChessMovePromotion(move)
    if promotion != 0 {
        letters := "??nbrq"
        unused VecPush(out, letters[promotion])
    }
    return BuilderFinish(out)
}

// Standard algebraic notation for a legal move in this position: Nf3,
// exd5, O-O, e8=Q+, Qh5#.
ChessMoveSan :: (move: s32) -> string {
    out: Vec(u8)
    from := ChessMoveFrom(move)
    to := ChessMoveTo(move)
    flags := ChessMoveFlags(move)
    piece := board[from]
    kind := ChessKind(piece)
    if (flags & CHESS_MOVE_CASTLE) != 0 {
        BuilderPrint(*out, "%", ifx ChessFile(to) == 6 then "O-O" else "O-O-O")
    } else {
        if kind == CHESS_PAWN {
            if (flags & CHESS_MOVE_CAPTURE) != 0 {
                unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(from)))
            }
        } else {
            letters := "??NBRQK"
            unused VecPush(out, letters[kind])
            // Name the file, the rank or both when another piece of the same
            // kind could also go there.
            count := ChessGenerateLegal()
            others: s32 = 0
            same_file: s32 = 0
            same_rank: s32 = 0
            index: s32 = 0
            while index < count {
                other := legal_moves[index]
                other_from := ChessMoveFrom(other)
                if other_from != from && ChessMoveTo(other) == to && board[other_from] == piece {
                    others += 1
                    if ChessFile(other_from) == ChessFile(from) {
                        same_file += 1
                    }
                    if ChessRank(other_from) == ChessRank(from) {
                        same_rank += 1
                    }
                }
                index += 1
            }
            if others > 0 {
                if same_file == 0 {
                    unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(from)))
                } else if same_rank == 0 {
                    unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(from)))
                } else {
                    unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(from)))
                    unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(from)))
                }
            }
        }
        if (flags & CHESS_MOVE_CAPTURE) != 0 {
            unused VecPush(out, #char "x")
        }
        unused VecPush(out, cast(u8)(#char "a" + cast(u8)ChessFile(to)))
        unused VecPush(out, cast(u8)(#char "1" + cast(u8)ChessRank(to)))
        promotion := ChessMovePromotion(move)
        if promotion != 0 {
            letters := "??NBRQ"
            unused VecPush(out, #char "=")
            unused VecPush(out, letters[promotion])
        }
    }
    ChessMakeMove(move)
    if ChessInCheck() {
        mate := ChessGenerateLegal() == 0
        unused VecPush(out, ifx mate then #char "#" else #char "+")
    }
    ChessUnmakeMove()
    return BuilderFinish(out)
}

// Draw rules.

// Neither side can mate: bare kings, one minor piece, or only bishops that
// all stand on squares of one color.
ChessInsufficientMaterial :: () -> bool {
    heavy := piece_count[CHESS_WHITE | CHESS_PAWN] + piece_count[CHESS_BLACK | CHESS_PAWN] +
    piece_count[CHESS_WHITE | CHESS_ROOK] + piece_count[CHESS_BLACK | CHESS_ROOK] +
    piece_count[CHESS_WHITE | CHESS_QUEEN] + piece_count[CHESS_BLACK | CHESS_QUEEN]
    if heavy > 0 {
        return false
    }
    minors := piece_count[CHESS_WHITE | CHESS_KNIGHT] + piece_count[CHESS_BLACK | CHESS_KNIGHT] +
    piece_count[CHESS_WHITE | CHESS_BISHOP] + piece_count[CHESS_BLACK | CHESS_BISHOP]
    if minors <= 1 {
        return true
    }
    knights: s32 = 0
    bishops: s32 = 0
    light_bishops: s32 = 0
    rank: s32 = 0
    while rank < 8 {
        file: s32 = 0
        while file < 8 {
            kind := ChessKind(board[rank * 16 + file])
            if kind == CHESS_PAWN || kind == CHESS_ROOK || kind == CHESS_QUEEN {
                return false
            }
            if kind == CHESS_KNIGHT {
                knights += 1
            }
            if kind == CHESS_BISHOP {
                bishops += 1
                if (rank + file) % 2 == 1 {
                    light_bishops += 1
                }
            }
            file += 1
        }
        rank += 1
    }
    if knights + bishops <= 1 {
        return true
    }
    return knights == 0 && (light_bishops == 0 || light_bishops == bishops)
}

// How many earlier times this position stood, with the same side to move,
// since the last capture or pawn move.
ChessRepetitions :: () -> s32 {
    count: s32 = 0
    back: s32 = 2
    while back <= halfmove && back <= history_count && back < CHESS_HISTORY_SIZE {
        if history_hash[(history_count - back) & CHESS_HISTORY_MASK] == hash {
            count += 1
        }
        back += 2
    }
    return count
}

ChessStatus :: () -> s32 {
    if ChessGenerateLegal() == 0 {
        return ifx ChessInCheck() then CHESS_CHECKMATE else CHESS_STALEMATE
    }
    if ChessInsufficientMaterial() {
        return CHESS_DRAW_MATERIAL
    }
    if halfmove >= 100 {
        return CHESS_DRAW_FIFTY
    }
    if ChessRepetitions() >= 2 {
        return CHESS_DRAW_REPETITION
    }
    return CHESS_PLAYING
}

// Perft counts the leaf positions of every legal line to `depth`, the
// standard check of a move generator.
ChessPerft :: (depth: s32) -> u64 {
    return PerftAt(depth, 0)
}

#scope_file
PerftAt :: (depth: s32, ply: s32) -> u64 {
    if depth == 0 {
        return cast(u64)1
    }
    start := ply * CHESS_PLY_MOVES
    in_check := ChessInCheck()
    end := GenerateMoves(start, false)
    nodes: u64 = 0
    index := start
    while index < end {
        ChessMakeMove(moves[index])
        if !MoveExposesKing(moves[index], in_check) {
            if depth == 1 {
                nodes += cast(u64)1
            } else {
                nodes += PerftAt(depth - 1, ply + 1)
            }
        }
        ChessUnmakeMove()
        index += 1
    }
    return nodes
}

// Evaluation, from the side to move's point of view.

TableIndex :: (square: s32, color: s32) -> s32 {
    if color == CHESS_WHITE {
        return (7 - ChessRank(square)) * 8 + ChessFile(square)
    }
    return ChessRank(square) * 8 + ChessFile(square)
}

CenterDistance :: (square: s32) -> s32 {
    file := ChessFile(square)
    rank := ChessRank(square)
    file_distance := ifx file < 4 then 3 - file else file - 4
    rank_distance := ifx rank < 4 then 3 - rank else rank - 4
    return file_distance + rank_distance
}

KingDistance :: () -> s32 {
    white := king_square[0]
    black := king_square[1]
    files := ChessFile(white) - ChessFile(black)
    ranks := ChessRank(white) - ChessRank(black)
    if files < 0 {
        files = -files
    }
    if ranks < 0 {
        ranks = -ranks
    }
    return files + ranks
}

Material :: (color: s32) -> s32 {
    return piece_count[color | CHESS_PAWN] * 100 + piece_count[color | CHESS_KNIGHT] * 320 +
    piece_count[color | CHESS_BISHOP] * 330 + piece_count[color | CHESS_ROOK] * 500 +
    piece_count[color | CHESS_QUEEN] * 900
}

// The kept value plus the kings, blended from their middle-game to their
// end-game places as pieces come off.
Evaluate :: () -> s32 {
    phase := phase_total
    if phase > 24 {
        phase = 24
    }
    white_king := king_square[0]
    black_king := king_square[1] + 128
    score := score_base
    score += ((king_middle_score[white_king] - king_middle_score[black_king]) * phase +
        (king_end_score[white_king] - king_end_score[black_king]) * (24 - phase)) / 24
    if piece_count[CHESS_WHITE | CHESS_BISHOP] >= 2 {
        score += 30
    }
    if piece_count[CHESS_BLACK | CHESS_BISHOP] >= 2 {
        score -= 30
    }
    // With a clear material lead late in the game, drive the bare king to
    // the edge and bring the own king closer, so the mate gets delivered.
    if phase <= 8 {
        lead := Material(CHESS_WHITE) - Material(CHESS_BLACK)
        if lead >= 400 && piece_count[CHESS_BLACK | CHESS_PAWN] == 0 {
            score += CenterDistance(king_square[1]) * 10 + (14 - KingDistance()) * 4
        } else if lead <= -400 && piece_count[CHESS_WHITE | CHESS_PAWN] == 0 {
            score -= CenterDistance(king_square[0]) * 10 + (14 - KingDistance()) * 4
        }
    }
    if search_noise > 0 {
        mixed := NextKey(hash ^ search_seed)
        spread := cast(u64)(search_noise * 2 + 1)
        score += cast(s32)(mixed % spread) - search_noise
    }
    return ifx side == CHESS_WHITE then score else -score
}

// The search.

MoveScore :: (move: s32, ply: s32, table: s32) -> s32 {
    if move == table {
        return 1000000
    }
    flags := (move >> 17) & 15
    promotion := (move >> 14) & 7
    if (flags & CHESS_MOVE_CAPTURE) != 0 {
        victim: s32 = CHESS_PAWN
        if (flags & CHESS_MOVE_EN_PASSANT) == 0 {
            victim = board[(move >> 7) & 127] & 7
        }
        attacker := board[move & 127] & 7
        return 100000 + piece_value[victim] * 10 - attacker + promotion * 100
    }
    if promotion != 0 {
        return 90000 + promotion
    }
    if move == killer_first[ply] {
        return 80000
    }
    if move == killer_second[ply] {
        return 79000
    }
    return quiet_history[board[move & 127] * 128 + ((move >> 7) & 127)]
}

TableStore :: (ply: s32, depth: s32, score: s32, flag: s32, move: s32) {
    index := cast(s32)(hash & cast(u64)CHESS_TABLE_MASK)
    stored := score
    if stored > CHESS_MATE_BOUND {
        stored += ply
    } else if stored < -CHESS_MATE_BOUND {
        stored -= ply
    }
    if table_key[index] == hash && table_depth[index] > depth && move == 0 {
        return
    }
    table_key[index] = hash
    table_depth[index] = depth
    table_score[index] = stored
    table_flag[index] = flag
    table_move[index] = move
}

TableScore :: (index: s32, ply: s32) -> s32 {
    score := table_score[index]
    if score > CHESS_MATE_BOUND {
        return score - ply
    }
    if score < -CHESS_MATE_BOUND {
        return score + ply
    }
    return score
}

// Passing the move: the other side moves twice. Taken back like a move.
MakeNullMove :: () {
    slot := history_count & CHESS_HISTORY_MASK
    undo_move[slot] = 0
    undo_captured[slot] = CHESS_EMPTY
    undo_castling[slot] = castling
    undo_en_passant[slot] = en_passant
    undo_halfmove[slot] = halfmove
    undo_score[slot] = score_base
    undo_phase[slot] = phase_total
    history_hash[slot] = hash
    if en_passant >= 0 {
        hash ^= zobrist_en_passant[en_passant & 7]
        en_passant = -1
    }
    // Repetitions never reach back across a pass.
    halfmove = 0
    side ^= 8
    hash ^= zobrist_side
    history_count += 1
}

UnmakeNullMove :: () {
    history_count -= 1
    slot := history_count & CHESS_HISTORY_MASK
    side ^= 8
    en_passant = undo_en_passant[slot]
    halfmove = undo_halfmove[slot]
    hash = history_hash[slot]
}

HasPieces :: (color: s32) -> bool {
    return piece_count[color | CHESS_KNIGHT] + piece_count[color | CHESS_BISHOP] +
    piece_count[color | CHESS_ROOK] + piece_count[color | CHESS_QUEEN] > 0
}

PawnGuards :: (square: s32, color: s32) -> bool {
    pawn := color | CHESS_PAWN
    if color == CHESS_WHITE {
        return ((square - 15) & 0x88) == 0 && board[square - 15] == pawn ||
        ((square - 17) & 0x88) == 0 && board[square - 17] == pawn
    }
    return ((square + 15) & 0x88) == 0 && board[square + 15] == pawn ||
    ((square + 17) & 0x88) == 0 && board[square + 17] == pawn
}

SearchReturn :: (score: s32) {
    search_returning = true
    search_return_score = score
}

// Opens the child node after the move or pass just made at `ply`.
SearchPush :: (ply: s32, depth: s32, alpha: s32, beta: s32) {
    child := ply + 1
    search_depth[child] = depth
    search_alpha[child] = alpha
    search_beta[child] = beta
    search_stage[child] = CHESS_STAGE_ENTER
    search_ply = child
}

// Starts searching the node at search_ply, whose depth and window are set.
SearchEnter :: () {
    ply := search_ply
    search_nodes += 1
    alpha := search_alpha[ply]
    beta := search_beta[ply]
    if ply > 0 {
        if halfmove >= 100 || ChessRepetitions() > 0 || ChessInsufficientMaterial() {
            SearchReturn(0)
            return
        }
    }
    if ply >= CHESS_MAX_PLY - 1 {
        SearchReturn(Evaluate())
        return
    }
    in_check := ChessInCheck()
    search_in_check[ply] = in_check
    search_legal[ply] = 0
    search_best_move[ply] = 0
    search_original_alpha[ply] = alpha
    search_table_move[ply] = 0
    if search_depth[ply] <= 0 && !in_check {
        // Quiescence: only captures and queen promotions, so a line is
        // never judged in the middle of an exchange.
        stand := Evaluate()
        if !search_quiescence || stand >= beta {
            SearchReturn(stand)
            return
        }
        if stand > alpha {
            search_alpha[ply] = stand
        }
        search_best[ply] = stand
        search_quiet_only[ply] = true
        SearchGenerate(ply)
        return
    }
    if search_depth[ply] < 0 {
        search_depth[ply] = 0
    }
    depth := search_depth[ply]
    index := cast(s32)(hash & cast(u64)CHESS_TABLE_MASK)
    if table_key[index] == hash {
        search_table_move[ply] = table_move[index]
        if ply > 0 && table_depth[index] >= depth {
            score := TableScore(index, ply)
            flag := table_flag[index]
            if flag == CHESS_TABLE_EXACT ||
            (flag == CHESS_TABLE_LOWER && score >= beta) ||
            (flag == CHESS_TABLE_UPPER && score <= alpha) {
                SearchReturn(score)
                return
            }
        }
    }
    search_best[ply] = -CHESS_INFINITY
    search_quiet_only[ply] = false
    // Null move: when passing still holds beta, a real move will too.
    if ply > 0 && !in_check && depth >= 3 && search_current[ply - 1] != 0 &&
    beta < CHESS_MATE_BOUND && beta > -CHESS_MATE_BOUND && HasPieces(side) &&
    Evaluate() >= beta {
        reduction: s32 = ifx depth > 6 then 3 else 2
        search_current[ply] = 0
        search_stage[ply] = CHESS_STAGE_NEXT
        MakeNullMove()
        SearchPush(ply, depth - 1 - reduction, -beta, -beta + 1)
        return
    }
    SearchGenerate(ply)
}

SearchGenerate :: (ply: s32) {
    start := ply * CHESS_PLY_MOVES
    search_next[ply] = start
    search_end[ply] = GenerateMoves(start, search_quiet_only[ply])
    table := search_table_move[ply]
    index := start
    while index < search_end[ply] {
        move_scores[index] = MoveScore(moves[index], ply, table)
        index += 1
    }
    search_current[ply] = -1
    search_stage[ply] = CHESS_STAGE_NEXT
}

// Tries the next move of the node at search_ply, best scored first.
SearchNext :: () {
    ply := search_ply
    quiet_only := search_quiet_only[ply]
    while search_next[ply] < search_end[ply] {
        at := search_next[ply]
        best := at
        index := at + 1
        while index < search_end[ply] {
            if move_scores[index] > move_scores[best] {
                best = index
            }
            index += 1
        }
        move := moves[best]
        moves[best] = moves[at]
        move_scores[best] = move_scores[at]
        moves[at] = move
        search_next[ply] = at + 1
        if quiet_only {
            // A capture that cannot lift the score to alpha, or that gives a
            // piece for less to a pawn's guard, is not worth looking at.
            to := (move >> 7) & 127
            victim: s32 = CHESS_PAWN
            if ((move >> 17) & CHESS_MOVE_EN_PASSANT) == 0 {
                victim = board[to] & 7
            }
            gain := piece_value[victim] + piece_value[(move >> 14) & 7]
            if search_best[ply] + gain + 200 <= search_alpha[ply] {
                continue
            }
            attacker := board[move & 127] & 7
            if piece_value[attacker] > piece_value[victim] + 50 && PawnGuards(to, side ^ 8) {
                continue
            }
        }
        ChessMakeMove(move)
        if MoveExposesKing(move, search_in_check[ply]) {
            ChessUnmakeMove()
            continue
        }
        search_legal[ply] += 1
        search_current[ply] = move
        depth := search_depth[ply] - 1
        gives_check := ChessInCheck()
        // A check extends the line, so a mate behind it is still seen.
        if gives_check && search_depth[ply] > 0 {
            depth = search_depth[ply]
        }
        search_reduced[ply] = false
        search_narrow[ply] = false
        if quiet_only || search_legal[ply] == 1 {
            SearchPush(ply, depth, -search_beta[ply], -search_alpha[ply])
            return
        }
        // Later moves first only have to show they are no better than the
        // best so far; quiet late moves are also looked at less deeply.
        quiet := ((move >> 17) & CHESS_MOVE_CAPTURE) == 0 && ((move >> 14) & 7) == 0
        if quiet && depth >= 2 && search_legal[ply] > 3 && !gives_check &&
        !search_in_check[ply] && move != killer_first[ply] && move != killer_second[ply] {
            depth -= 1
            search_reduced[ply] = true
        }
        search_narrow[ply] = true
        search_child_depth[ply] = depth
        SearchPush(ply, depth, -search_alpha[ply] - 1, -search_alpha[ply])
        return
    }
    if quiet_only {
        SearchReturn(search_best[ply])
        return
    }
    if search_legal[ply] == 0 {
        SearchReturn(ifx search_in_check[ply] then -CHESS_MATE + ply else 0)
        return
    }
    flag: s32 = CHESS_TABLE_EXACT
    if search_best[ply] <= search_original_alpha[ply] {
        flag = CHESS_TABLE_UPPER
    }
    TableStore(ply, search_depth[ply], search_best[ply], flag, search_best_move[ply])
    SearchReturn(search_best[ply])
}

// Hands a finished child's score to its parent. True when the starting
// position itself finished.
SearchBackUp :: () -> bool {
    score := search_return_score
    search_returning = false
    if search_ply == 0 {
        return true
    }
    ply := search_ply - 1
    move := search_current[ply]
    score = -score
    if move == 0 {
        // The pass: cut off when it held, otherwise search the moves.
        search_ply = ply
        UnmakeNullMove()
        if score >= search_beta[ply] {
            SearchReturn(search_beta[ply])
            return false
        }
        SearchGenerate(ply)
        return false
    }
    // A reduced or narrow look that beat alpha is repeated, first at full
    // depth and then with the full window, before it counts.
    if score > search_alpha[ply] && (search_reduced[ply] || (search_narrow[ply] && score < search_beta[ply])) {
        child := ply + 1
        if search_reduced[ply] {
            search_reduced[ply] = false
            search_child_depth[ply] += 1
            search_depth[child] = search_child_depth[ply]
            search_alpha[child] = -search_alpha[ply] - 1
            search_beta[child] = -search_alpha[ply]
        } else {
            search_narrow[ply] = false
            search_depth[child] = search_child_depth[ply]
            search_alpha[child] = -search_beta[ply]
            search_beta[child] = -search_alpha[ply]
        }
        search_stage[child] = CHESS_STAGE_ENTER
        return false
    }
    search_ply = ply
    ChessUnmakeMove()
    if score > search_best[ply] {
        search_best[ply] = score
        search_best_move[ply] = move
    }
    if score > search_alpha[ply] {
        search_alpha[ply] = score
    }
    if search_alpha[ply] >= search_beta[ply] {
        if !search_quiet_only[ply] {
            if ((move >> 17) & CHESS_MOVE_CAPTURE) == 0 {
                if killer_first[ply] != move {
                    killer_second[ply] = killer_first[ply]
                    killer_first[ply] = move
                }
                at := board[move & 127] * 128 + ((move >> 7) & 127)
                depth := search_depth[ply]
                if quiet_history[at] < 60000 {
                    quiet_history[at] += depth * depth
                }
            }
            TableStore(ply, search_depth[ply], search_best[ply], CHESS_TABLE_LOWER, move)
        }
        SearchReturn(search_best[ply])
    }
    return false
}

SearchStartIteration :: () {
    search_ply = 0
    search_depth[0] = search_iteration
    search_alpha[0] = -CHESS_INFINITY
    search_beta[0] = CHESS_INFINITY
    search_stage[0] = CHESS_STAGE_ENTER
    search_returning = false
}

// Takes back every move and pass of an unfinished iteration.
SearchUnwind :: () {
    while history_count > search_root_history {
        if undo_move[(history_count - 1) & CHESS_HISTORY_MASK] == 0 {
            UnmakeNullMove()
        } else {
            ChessUnmakeMove()
        }
    }
    search_ply = 0
    search_returning = false
}

#scope_export

// Clears what earlier searches learned, such as for a new game.
ChessForget :: () {
    index: s32 = 0
    while index < CHESS_TABLE_SIZE {
        table_key[index] = 0
        table_move[index] = 0
        table_depth[index] = 0
        table_flag[index] = 0
        index += 1
    }
    index = 0
    while index < CHESS_MAX_PLY {
        killer_first[index] = 0
        killer_second[index] = 0
        index += 1
    }
    index = 0
    while index < 2048 {
        quiet_history[index] = 0
        index += 1
    }
}

// Begins a search of the current position. Deeper iterations stop once
// node_limit positions are searched, keeping the last finished one; noise
// adds up to that many centipawns to each position's value, the same for
// that position throughout the game's seed.
ChessSearchBegin :: (depth: s32, node_limit: s32, quiescence: bool, noise: s32, seed: u64) {
    search_max_depth = ifx depth < 1 then 1 else ifx depth > CHESS_MAX_PLY - 8 then CHESS_MAX_PLY - 8 else depth
    search_node_limit = node_limit
    search_quiescence = quiescence
    search_noise = noise
    search_seed = seed
    search_nodes = 0
    search_result = 0
    search_completed_move = 0
    search_completed_score = 0
    search_iteration = 1
    search_root_history = history_count
    search_active = true
    // Older successes count for less, so the order follows this position.
    index: s32 = 0
    while index < 2048 {
        quiet_history[index] = quiet_history[index] / 4
        index += 1
    }
    SearchStartIteration()
}

ChessSearching :: () -> bool {
    return search_active
}

// Searches up to `budget` positions. True once the search has finished and
// ChessSearchMove holds its move; the position is the starting one again.
ChessSearchRun :: (budget: s32) -> bool {
    if !search_active {
        return true
    }
    steps: s32 = 0
    while steps < budget {
        if search_returning {
            if SearchBackUp() {
                // An iteration finished at the starting position.
                search_completed_move = search_best_move[0]
                search_completed_score = search_best[0]
                if search_completed_move == 0 || search_iteration >= search_max_depth ||
                search_completed_score > CHESS_MATE_BOUND ||
                search_nodes >= search_node_limit {
                    search_result = search_completed_move
                    search_active = false
                    return true
                }
                search_iteration += 1
                SearchStartIteration()
            }
        } else if search_stage[search_ply] == CHESS_STAGE_ENTER {
            SearchEnter()
            steps += 1
        } else {
            SearchNext()
        }
        if search_nodes >= search_node_limit && search_iteration > 1 && search_active {
            SearchUnwind()
            search_result = search_completed_move
            search_active = false
            return true
        }
    }
    return false
}

ChessSearchMove :: () -> s32 {
    return search_result
}

ChessSearchScore :: () -> s32 {
    return search_completed_score
}

ChessSearchNodes :: () -> s32 {
    return search_nodes
}

// Stops a search and restores the starting position.
ChessSearchCancel :: () {
    if search_active {
        SearchUnwind()
        search_active = false
    }
}
