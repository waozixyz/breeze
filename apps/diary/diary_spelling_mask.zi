// Images never go to the spelling service, wherever they stand in a line:
// each `![...](...)` is sent as one object replacement character, U+FFFC,
// so photo names, places and hashes stay on this device. The correction
// gets each image back at its mark, in order. A correction that lost or
// added a mark cannot be matched to the images, so it is refused.
#import "vec"
#import "text"
#import "byte_text_linux"

DIARY_SPELLING_MARK :: "\xEF\xBF\xBC"

DiarySpellingLineEnd :: (text: string, start: s64) -> s64 {
    end := start
    while end < text.count && text[end] != cast(u8)10 {
        end += 1
    }
    return end
}

// Where an image that starts at `at` ends, after its closing parenthesis,
// or -1. It is read generously, `![`, then `](` and `)` on the same line,
// so that whatever a destination holds stays masked.
DiarySpellingImageEnd :: (text: string, at: s64) -> s64 {
    if at + 1 >= text.count || text[at] != cast(u8)33 || text[at + 1] != cast(u8)91 {
        return -1
    }
    line_end := DiarySpellingLineEnd(text, at)
    cursor := at + 2
    while cursor + 1 < line_end && (text[cursor] != cast(u8)93 || text[cursor + 1] != cast(u8)40) {
        cursor += 1
    }
    if cursor + 1 >= line_end {
        return -1
    }
    cursor += 2
    while cursor < line_end && text[cursor] != cast(u8)41 {
        cursor += 1
    }
    if cursor >= line_end {
        return -1
    }
    return cursor + 1
}

// Whether a mark the text already holds starts at `at`.
DiarySpellingMarkAt :: (text: string, at: s64) -> bool {
    mark := DIARY_SPELLING_MARK
    return at + mark.count <= text.count && text[at:at + mark.count] == mark
}

// The bytes the mark at `at` stands for, ending where the next byte to read
// is, or -1 when no mark starts there. A mark the entry held itself stands
// for itself.
DiarySpellingMasks :: (text: string, at: s64) -> s64 {
    if DiarySpellingMarkAt(text, at) {
        return at + DIARY_SPELLING_MARK.count
    }
    return DiarySpellingImageEnd(text, at)
}

// The entry as the spelling service sees it: each image one mark.
DiarySpellingMasked :: (text: string) -> string {
    out: Vec(u8)
    at: s64 = 0
    while at < text.count {
        end := DiarySpellingMasks(text, at)
        if end > at {
            BuilderPrint(*out, "%", DIARY_SPELLING_MARK)
            at = end
            continue
        }
        unused VecPush(out, text[at])
        at += 1
    }
    return BuilderFinish(out)
}

// The correction with the original images back at their marks, or "" when
// its marks no longer match the entry's.
DiarySpellingRestored :: (original: string, corrected: string) -> string {
    out: Vec(u8)
    source: s64 = 0
    at: s64 = 0
    while at < corrected.count {
        if !DiarySpellingMarkAt(corrected, at) {
            unused VecPush(out, corrected[at])
            at += 1
            continue
        }
        // The next mark of the original and what it stands for.
        while source < original.count && DiarySpellingMasks(original, source) < 0 {
            source += 1
        }
        if source >= original.count {
            VecFree(out)
            return ""
        }
        end := DiarySpellingMasks(original, source)
        BuilderPrint(*out, "%", original[source:end])
        source = end
        at += DIARY_SPELLING_MARK.count
    }
    while source < original.count && DiarySpellingMasks(original, source) < 0 {
        source += 1
    }
    if source < original.count {
        VecFree(out)
        return ""
    }
    return BuilderFinish(out)
}
