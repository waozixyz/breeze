// A Diary entry is Markdown. This module finds its photo embeds and the
// CommonMark basics the editor previews, and makes the edits that add a
// photo. It reads only the entry's text; files and the account's media
// library belong to the host.
//
// An embed is a CommonMark image anywhere in a line whose destination is a
// photo: `![ALT](photos/YYYY/MM/DD/SHA256.EXT)` for a photo of the account's
// media library, which Photos shows too (the photo's day, its SHA-256 and
// its type), or `![ALT](diary:FILE)` for a photo an older version attached
// to the entry as a Diary file. Other images and text stay ordinary text.
// An inserted photo gets a line of its own.
#import "text"
#import "vec"
#import "byte_text_linux"
#import "text_props"

DIARY_EMBED_ALT_MAX :: 200
DIARY_EMBED_NAME_MAX :: 200

DIARY_TONE_MUTED :: 1
DIARY_TONE_LINK :: 2

// What the editor shows for one entry, rebuilt every frame.
DIARY_PREVIEW_RANGES :: 512
DIARY_PREVIEW_TONES :: 256
DIARY_PREVIEW_HEADINGS :: 128
DIARY_PREVIEW_PHOTOS :: 64
// What one line may add; a line that would not fit ends the preview there.
DIARY_LINE_MARKS :: 64
DIARY_LINE_LINKS :: 16
DIARY_LINE_RUNS :: 64

DiaryEmbed :: struct {
    valid: bool
    // The image's bytes, from its `!` to its closing parenthesis.
    start: s32
    end: s32
    // Its line, without the line break.
    line_start: s32
    line_end: s32
    alt_start: s32
    alt_end: s32
    // The destination, without angle brackets, ends with its target: the
    // Diary file's name after `diary:`, or the whole library place.
    destination_start: s32
    target_start: s32
    target_end: s32
    // A photo of the account's media library (photos/...) or a Diary file
    // (diary:).
    library: bool
}

// Replaces text[start:end]; the caret goes to cursor afterwards.
DiaryEmbedEdit :: struct {
    start: s32
    end: s32
    replacement: string
    cursor: s32
}

// A color role for bytes of the entry.
DiaryTone :: struct {
    start: s32
    end: s32
    tone: s32
}

// A heading's line and level (1 to 6).
DiaryHeading :: struct {
    start: s32
    level: s32
}

// A photo drawn for an embed under its line, after the line's earlier
// photos. On a line of photos alone, away from the caret, the first one
// takes the hidden line's place (cover).
DiaryPhotoBlock :: struct {
    embed: DiaryEmbed
    cover: bool
}

// Every list is sorted by start and disjoint, as Kryon's TextArea requires.
DiaryPreview :: struct {
    hidden: [DIARY_PREVIEW_RANGES]TextRange
    hidden_count: s32
    strong: [DIARY_PREVIEW_RANGES]TextRange
    strong_count: s32
    italic: [DIARY_PREVIEW_RANGES]TextRange
    italic_count: s32
    tones: [DIARY_PREVIEW_TONES]DiaryTone
    tone_count: s32
    headings: [DIARY_PREVIEW_HEADINGS]DiaryHeading
    heading_count: s32
    photos: [DIARY_PREVIEW_PHOTOS]DiaryPhotoBlock
    photo_count: s32
    // Lines after the last one that fit are shown as plain text.
    truncated: bool
}

// ---------------------------------------------------------------- lines

DiaryLineEnd :: (text: string, start: s32) -> s32 {
    end := start
    while end < cast(s32)text.count && text[end] != cast(u8)10 {
        end += 1
    }
    return end
}

DiaryLineStart :: (text: string, at: s32) -> s32 {
    start := at
    if start > cast(s32)text.count {
        start = cast(s32)text.count
    }
    while start > 0 && text[start - 1] != cast(u8)10 {
        start -= 1
    }
    return start
}

DiaryBlank :: (byte: u8) -> bool {
    return byte == cast(u8)32 || byte == cast(u8)9
}

// ---------------------------------------------------------------- embeds

// A Diary file name, as the host stores it.
DiaryFileNameValid :: (name: string) -> bool {
    if name.count == 0 || name.count > DIARY_EMBED_NAME_MAX || name == "." || name == ".." {
        return false
    }
    for byte: name {
        digit := byte >= cast(u8)48 && byte <= cast(u8)57
        letter := byte >= cast(u8)97 && byte <= cast(u8)122
        if !digit && !letter && byte != cast(u8)45 && byte != cast(u8)46 {
            return false
        }
    }
    return true
}

// A media library key: the photo's SHA-256 in lowercase hex.
DiaryMediaKeyValid :: (key: string) -> bool {
    if key.count != 64 {
        return false
    }
    for byte: key {
        digit := byte >= cast(u8)48 && byte <= cast(u8)57
        letter := byte >= cast(u8)97 && byte <= cast(u8)102
        if !digit && !letter {
            return false
        }
    }
    return true
}

DiaryDigits :: (value: string) -> bool {
    for byte: value {
        if byte < cast(u8)48 || byte > cast(u8)57 {
            return false
        }
    }
    return true
}

// The photo types the library keeps.
DiaryPhotoTypeValid :: (format: string) -> bool {
    return format == "jpg" || format == "png" || format == "webp" || format == "gif"
}

// A library photo's place: photos/YYYY/MM/DD/<sha256>.<type>, its day as the
// Photos gallery groups it.
DiaryLibraryPathValid :: (path: string) -> bool {
    if path.count < 86 || path.count > 87 || path[:7] != "photos/" ||
    path[11] != #char "/" || path[14] != #char "/" || path[17] != #char "/" ||
    path[82] != #char "." {
        return false
    }
    if !DiaryDigits(path[7:11]) || !DiaryDigits(path[12:14]) || !DiaryDigits(path[15:17]) {
        return false
    }
    month := (cast(s32)path[12] - 48) * 10 + cast(s32)path[13] - 48
    day := (cast(s32)path[15] - 48) * 10 + cast(s32)path[16] - 48
    if month < 1 || month > 12 || day < 1 || day > 31 {
        return false
    }
    return DiaryMediaKeyValid(path[18:82]) && DiaryPhotoTypeValid(path[83:])
}

// The place of a library photo taken or added on `day` (YYYY-MM-DD), or ""
// when one of its parts is not valid.
DiaryLibraryPath :: (day: string, hash: string, format: string) -> string {
    if day.count != 10 || day[4] != #char "-" || day[7] != #char "-" {
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "photos/%/%/%/%.%", day[:4], day[5:7], day[8:10], hash, format)
    path := BuilderFinish(out)
    if !DiaryLibraryPathValid(path) {
        return ""
    }
    return path
}

// The photo at `at`, where an image's `!` stands, or an invalid embed. An
// image follows CommonMark within one line: `![ALT](DESTINATION)`, with
// spaces or tabs around the destination, an optional "title", 'title' or
// (title) after it, and the destination in <angle brackets> or plain.
// Escaped brackets may appear in ALT. Only a destination naming a photo, a
// library place or a Diary file, makes it an embed.
DiaryEmbedAt :: (text: string, at: s32) -> DiaryEmbed {
    embed: DiaryEmbed
    if at < 0 || at + 1 >= cast(s32)text.count || text[at] != #char "!" ||
    text[at + 1] != #char "[" {
        return embed
    }
    line_start := DiaryLineStart(text, at)
    line_end := DiaryLineEnd(text, at)
    if DiaryEscaped(text, at, line_start) {
        return embed
    }
    close := at + 2
    while close < line_end && text[close] != #char "]" {
        if text[close] == #char "[" {
            return embed
        }
        if text[close] == cast(u8)92 && close + 1 < line_end {
            close += 1
        }
        close += 1
    }
    if close + 1 >= line_end || text[close + 1] != #char "(" ||
    close - (at + 2) > DIARY_EMBED_ALT_MAX {
        return embed
    }
    cursor := DiarySkipBlank(text, close + 2, line_end)
    destination_start := cursor
    destination_end := cursor
    if cursor < line_end && text[cursor] == #char "<" {
        destination_start = cursor + 1
        destination_end = destination_start
        while destination_end < line_end && text[destination_end] != #char ">" &&
        text[destination_end] != #char "<" {
            destination_end += 1
        }
        if destination_end >= line_end || text[destination_end] != #char ">" {
            return embed
        }
        cursor = destination_end + 1
    } else {
        while cursor < line_end && text[cursor] > cast(u8)32 && text[cursor] != #char "(" &&
        text[cursor] != #char ")" {
            cursor += 1
        }
        destination_end = cursor
    }
    after := DiarySkipBlank(text, cursor, line_end)
    if after > cursor && after < line_end && (text[after] == cast(u8)34 ||
        text[after] == cast(u8)39 || text[after] == #char "(") {
        after = DiaryTitleEnd(text, after, line_end)
        if after < 0 {
            return embed
        }
        after = DiarySkipBlank(text, after, line_end)
    }
    if after >= line_end || text[after] != #char ")" {
        return embed
    }
    destination := text[destination_start:destination_end]
    target_start := destination_start
    library := false
    if destination.count > 6 && destination[:6] == "diary:" {
        target_start += 6
        if !DiaryFileNameValid(text[target_start:destination_end]) {
            return embed
        }
    } else if DiaryLibraryPathValid(destination) {
        library = true
    } else {
        return embed
    }
    embed.valid = true
    embed.start = at
    embed.end = after + 1
    embed.line_start = line_start
    embed.line_end = line_end
    embed.alt_start = at + 2
    embed.alt_end = close
    embed.destination_start = destination_start
    embed.target_start = target_start
    embed.target_end = destination_end
    embed.library = library
    return embed
}

DiarySkipBlank :: (text: string, at: s32, end: s32) -> s32 {
    cursor := at
    while cursor < end && DiaryBlank(text[cursor]) {
        cursor += 1
    }
    return cursor
}

// Where an image's title that opens at `at` ends, after its closing quote
// or parenthesis, or -1 when it does not close on the line.
DiaryTitleEnd :: (text: string, at: s32, end: s32) -> s32 {
    closing := text[at]
    if closing == #char "(" {
        closing = #char ")"
    }
    cursor := at + 1
    while cursor < end {
        if text[cursor] == cast(u8)92 && cursor + 1 < end {
            cursor += 2
            continue
        }
        if text[cursor] == closing {
            return cursor + 1
        }
        if text[at] == #char "(" && text[cursor] == #char "(" {
            return -1
        }
        cursor += 1
    }
    return -1
}

// The first embed starting in text[from:to].
DiaryEmbedIn :: (text: string, from: s32, to: s32) -> DiaryEmbed {
    at := from
    if at < 0 {
        at = 0
    }
    while at + 1 < to {
        if text[at] == #char "!" && text[at + 1] == #char "[" {
            embed := DiaryEmbedAt(text, at)
            if embed.valid {
                return embed
            }
        }
        at += 1
    }
    return DiaryEmbed.{}
}

// The first embed starting at or after `from`.
DiaryEmbedNext :: (text: string, from: s32) -> DiaryEmbed {
    return DiaryEmbedIn(text, from, cast(s32)text.count)
}

// Whether the line starting at line_start holds photos and nothing else but
// spaces, as an inserted photo's line does.
DiaryImageLine :: (text: string, line_start: s32) -> bool {
    line_end := DiaryLineEnd(text, line_start)
    found := false
    at := line_start
    while at < line_end {
        if DiaryBlank(text[at]) || text[at] == cast(u8)13 {
            at += 1
            continue
        }
        embed := DiaryEmbedAt(text, at)
        if !embed.valid {
            return false
        }
        found = true
        at = embed.end
    }
    return found
}

// A Diary file's name, or a library photo's whole path.
DiaryEmbedTarget :: (text: string, embed: DiaryEmbed) -> string {
    return text[embed.target_start:embed.target_end]
}

// What the embed links to: diary:FILE or the library place.
DiaryEmbedDestination :: (text: string, embed: DiaryEmbed) -> string {
    return text[embed.destination_start:embed.target_end]
}

DiaryEmbedAlt :: (text: string, embed: DiaryEmbed) -> string {
    return text[embed.alt_start:embed.alt_end]
}

// Whether a diary: embed names this file.
DiaryEmbedReferences :: (text: string, file: string) -> bool {
    embed := DiaryEmbedNext(text, 0)
    while embed.valid {
        if !embed.library && DiaryEmbedTarget(text, embed) == file {
            return true
        }
        embed = DiaryEmbedNext(text, embed.end)
    }
    return false
}

// The bytes of the UTF-8 character at index, or 0 when it is not valid.
DiaryCharacterSize :: (value: string, index: s32) -> s32 {
    lead := value[index]
    size: s32 = 0
    if lead < cast(u8)128 {
        return 1
    }
    if lead >= cast(u8)194 && lead <= cast(u8)223 {
        size = 2
    } else if lead >= cast(u8)224 && lead <= cast(u8)239 {
        size = 3
    } else if lead >= cast(u8)240 && lead <= cast(u8)244 {
        size = 4
    } else {
        return 0
    }
    if index + size > cast(s32)value.count {
        return 0
    }
    for offset: cast(s32)1..size - 1 {
        if (value[index + offset] & cast(u8)192) != cast(u8)128 {
            return 0
        }
    }
    return size
}

// An embed line linking to `destination`, diary:FILE or a library path. Its
// name keeps whole characters up to the length limit; brackets, line breaks
// and invalid bytes become spaces.
DiaryEmbedLine :: (destination: string, name: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "![")
    written: s32 = 0
    index: s32 = 0
    while index < cast(s32)name.count {
        size := DiaryCharacterSize(name, index)
        step := ifx size == 0 then 1 else size
        if written + step > DIARY_EMBED_ALT_MAX {
            break
        }
        byte := name[index]
        if size == 0 || (size == 1 && (byte == #char "[" || byte == #char "]" || byte < cast(u8)32)) {
            BuilderPrint(*out, " ")
        } else {
            BuilderPrint(*out, "%", name[index:index + size])
        }
        written += step
        index += step
    }
    BuilderPrint(*out, "](%)", destination)
    return BuilderFinish(out)
}

// The text with an embed line added at its end. A blank line separates it
// from text before it; embeds that follow each other share no blank line.
DiaryEmbedAppend :: (text: string, line: string) -> string {
    out: Vec(u8)
    count := cast(s32)text.count
    BuilderPrint(*out, "%", text)
    if count == 0 {
        BuilderPrint(*out, "%", line)
        return BuilderFinish(out)
    }
    if text[count - 1] == cast(u8)10 {
        previous := DiaryLineStart(text, count - 1)
        after_embed := DiaryImageLine(text, previous)
        blank := count >= 2 && text[count - 2] == cast(u8)10
        if !after_embed && !blank {
            BuilderPrint(*out, "\n")
        }
    } else if DiaryImageLine(text, DiaryLineStart(text, count)) {
        BuilderPrint(*out, "\n")
    } else {
        BuilderPrint(*out, "\n\n")
    }
    BuilderPrint(*out, "%", line)
    return BuilderFinish(out)
}

// The edit that puts an embed line at `at`, on a line of its own, with the
// caret on the line after it.
DiaryEmbedInsertion :: (text: string, at: s32, line: string) -> DiaryEmbedEdit {
    edit: DiaryEmbedEdit
    count := cast(s32)text.count
    start := at
    if start < 0 {
        start = 0
    }
    if start > count {
        start = count
    }
    while start > 0 && start < count && (text[start] & cast(u8)192) == cast(u8)128 {
        start -= 1
    }
    out: Vec(u8)
    if start > 0 && text[start - 1] != cast(u8)10 {
        BuilderPrint(*out, "\n")
    }
    BuilderPrint(*out, "%\n", line)
    edit.start = start
    edit.end = start
    // At a line break the edit takes it over, so the caret, which an edit
    // leaves after its replacement, starts the next line.
    if start < count && text[start] == cast(u8)10 {
        edit.end = start + 1
    }
    edit.replacement = BuilderFinish(out)
    edit.cursor = start + cast(s32)edit.replacement.count
    return edit
}

// ---------------------------------------------------------------- preview

// One line's marks before they are sorted into the preview.
DiaryLineMarks :: struct {
    hidden: [DIARY_LINE_MARKS]TextRange
    hidden_count: s32
    strong: [DIARY_LINE_MARKS]TextRange
    strong_count: s32
    italic: [DIARY_LINE_MARKS]TextRange
    italic_count: s32
    tones: [DIARY_LINE_MARKS]DiaryTone
    tone_count: s32
    // A mark did not fit; the line is shown as plain text.
    overflow: bool
}

// A link or inline image on a line: `[` at open, text up to text_end, then
// `](destination)` up to end.
DiaryLink :: struct {
    open: s32
    text_end: s32
    end: s32
    image: bool
    // An image whose destination is a photo: an embed.
    photo: bool
}

// A run of `*` or `_` delimiters for emphasis.
DiaryRun :: struct {
    start: s32
    length: s32
    marker: u8
    can_open: bool
    can_close: bool
    // Delimiters still unmatched, taken from its right as an opener and
    // from its left as a closer.
    left: s32
    taken: s32
    dead: bool
}

diary_line: DiaryLineMarks;
diary_links: [DIARY_LINE_LINKS]DiaryLink;
diary_link_count: s32;
diary_runs: [DIARY_LINE_RUNS]DiaryRun;

DiaryMarkHidden :: (marks: *DiaryLineMarks, start: s32, end: s32) {
    if end <= start {
        return
    }
    if marks.hidden_count >= DIARY_LINE_MARKS {
        marks.overflow = true
        return
    }
    marks.hidden[marks.hidden_count] = TextRange.{.start = start, .end = end}
    marks.hidden_count += 1
}

DiaryMarkStrong :: (marks: *DiaryLineMarks, start: s32, end: s32) {
    if end <= start {
        return
    }
    if marks.strong_count >= DIARY_LINE_MARKS {
        marks.overflow = true
        return
    }
    marks.strong[marks.strong_count] = TextRange.{.start = start, .end = end}
    marks.strong_count += 1
}

DiaryMarkItalic :: (marks: *DiaryLineMarks, start: s32, end: s32) {
    if end <= start {
        return
    }
    if marks.italic_count >= DIARY_LINE_MARKS {
        marks.overflow = true
        return
    }
    marks.italic[marks.italic_count] = TextRange.{.start = start, .end = end}
    marks.italic_count += 1
}

DiaryMarkTone :: (marks: *DiaryLineMarks, start: s32, end: s32, tone: s32) {
    if end <= start {
        return
    }
    if marks.tone_count >= DIARY_LINE_MARKS {
        marks.overflow = true
        return
    }
    marks.tones[marks.tone_count] = DiaryTone.{.start = start, .end = end, .tone = tone}
    marks.tone_count += 1
}

// Sorts ranges by start and joins those that overlap or touch, so nested
// emphasis of one kind reads as one range.
DiaryJoinRanges :: (ranges: []TextRange, count: s32) -> s32 {
    for index: cast(s32)1..count - 1 {
        value := ranges[index]
        at := index
        while at > 0 && ranges[at - 1].start > value.start {
            ranges[at] = ranges[at - 1]
            at -= 1
        }
        ranges[at] = value
    }
    joined: s32 = 0
    for index: cast(s32)0..count - 1 {
        if joined > 0 && ranges[index].start <= ranges[joined - 1].end {
            if ranges[index].end > ranges[joined - 1].end {
                ranges[joined - 1].end = ranges[index].end
            }
            continue
        }
        ranges[joined] = ranges[index]
        joined += 1
    }
    return joined
}

// Sorts hidden markers by start. Markers never overlap; one that would is
// shown instead.
DiarySortHidden :: (ranges: []TextRange, count: s32) -> s32 {
    for index: cast(s32)1..count - 1 {
        value := ranges[index]
        at := index
        while at > 0 && ranges[at - 1].start > value.start {
            ranges[at] = ranges[at - 1]
            at -= 1
        }
        ranges[at] = value
    }
    kept: s32 = 0
    for index: cast(s32)0..count - 1 {
        if kept > 0 && ranges[index].start < ranges[kept - 1].end {
            continue
        }
        ranges[kept] = ranges[index]
        kept += 1
    }
    return kept
}

DiarySortTones :: (tones: []DiaryTone, count: s32) -> s32 {
    for index: cast(s32)1..count - 1 {
        value := tones[index]
        at := index
        while at > 0 && tones[at - 1].start > value.start {
            tones[at] = tones[at - 1]
            at -= 1
        }
        tones[at] = value
    }
    kept: s32 = 0
    for index: cast(s32)0..count - 1 {
        if kept > 0 && tones[index].start < tones[kept - 1].end {
            continue
        }
        tones[kept] = tones[index]
        kept += 1
    }
    return kept
}

// A byte escaped by an odd number of backslashes before it.
DiaryEscaped :: (text: string, at: s32, from: s32) -> bool {
    slashes: s32 = 0
    cursor := at - 1
    while cursor >= from && text[cursor] == cast(u8)92 {
        slashes += 1
        cursor -= 1
    }
    return slashes % 2 == 1
}

DiaryPunctuation :: (byte: u8) -> bool {
    return (byte >= cast(u8)33 && byte <= cast(u8)47) || (byte >= cast(u8)58 && byte <= cast(u8)64) ||
    (byte >= cast(u8)91 && byte <= cast(u8)96) || (byte >= cast(u8)123 && byte <= cast(u8)126)
}

// Photos, links and other inline images on text[from:to]. A photo is read
// as an embed; other destinations hold no spaces, as CommonMark's plain
// destinations, and their titles and angle brackets stay text.
DiaryFindLinks :: (text: string, from: s32, to: s32) {
    diary_link_count = 0
    at := from
    while at < to && diary_link_count < DIARY_LINE_LINKS {
        if text[at] == #char "!" {
            embed := DiaryEmbedAt(text, at)
            if embed.valid && embed.end <= to {
                diary_links[diary_link_count] = DiaryLink.{.open = at + 1, .text_end = embed.alt_end,
                    .end = embed.end, .image = true, .photo = true}
                diary_link_count += 1
                at = embed.end
                continue
            }
        }
        if text[at] != #char "[" || DiaryEscaped(text, at, from) {
            at += 1
            continue
        }
        image := at > from && text[at - 1] == #char "!" && !DiaryEscaped(text, at - 1, from)
        close := at + 1
        while close < to && text[close] != #char "]" && text[close] != #char "[" {
            close += 1
        }
        if close >= to || text[close] != #char "]" || close + 1 >= to || text[close + 1] != #char "(" {
            at += 1
            continue
        }
        end := close + 2
        while end < to && text[end] != #char ")" && !DiaryBlank(text[end]) {
            end += 1
        }
        if end >= to || text[end] != #char ")" || end == close + 2 {
            at += 1
            continue
        }
        diary_links[diary_link_count] = DiaryLink.{.open = at, .text_end = close, .end = end + 1, .image = image}
        diary_link_count += 1
        at = end + 1
    }
}

// Whether at lies inside a link or inline image found on the line. Emphasis
// around a link treats it as one piece; its text pairs on its own.
DiaryLinkSyntax :: (at: s32) -> bool {
    for index: cast(s32)0..diary_link_count - 1 {
        link := diary_links[index]
        start := link.open
        if link.image {
            start -= 1
        }
        if at >= start && at < link.end {
            return true
        }
    }
    return false
}

// Emphasis on text[from:to] with CommonMark's flanking rules and its rule of
// three, within one line. Matched markers hide away from the caret's line.
DiaryEmphasis :: (marks: *DiaryLineMarks, text: string, from: s32, to: s32, active: bool) {
    count: s32 = 0
    at := from
    while at < to {
        byte := text[at]
        if (byte != #char "*" && byte != #char "_") || DiaryEscaped(text, at, from) || DiaryLinkSyntax(at) {
            at += 1
            continue
        }
        end := at
        while end < to && text[end] == byte && !DiaryLinkSyntax(end) {
            end += 1
        }
        if count >= DIARY_LINE_RUNS {
            marks.overflow = true
            return
        }
        before: u8 = 32
        if at > from {
            before = text[at - 1]
        }
        after: u8 = 32
        if end < to {
            after = text[end]
        }
        before_space := DiaryBlank(before)
        after_space := DiaryBlank(after)
        left_flanking := !after_space &&
            (!DiaryPunctuation(after) || before_space || DiaryPunctuation(before))
        right_flanking := !before_space &&
            (!DiaryPunctuation(before) || after_space || DiaryPunctuation(after))
        run: DiaryRun
        run.start = at
        run.length = end - at
        run.left = run.length
        run.marker = byte
        if byte == #char "*" {
            run.can_open = left_flanking
            run.can_close = right_flanking
        } else {
            run.can_open = left_flanking && (!right_flanking || DiaryPunctuation(before))
            run.can_close = right_flanking && (!left_flanking || DiaryPunctuation(after))
        }
        diary_runs[count] = run
        count += 1
        at = end
    }
    for closer: cast(s32)0..count - 1 {
        if !diary_runs[closer].can_close {
            continue
        }
        while diary_runs[closer].left > 0 {
            opener: s32 = -1
            candidate := closer - 1
            while candidate >= 0 {
                run := diary_runs[candidate]
                if !run.dead && run.can_open && run.left > 0 && run.marker == diary_runs[closer].marker {
                    both := run.can_close || diary_runs[closer].can_open
                    sum := run.length + diary_runs[closer].length
                    three := both && sum % 3 == 0 &&
                        !(run.length % 3 == 0 && diary_runs[closer].length % 3 == 0)
                    if !three {
                        opener = candidate
                        break
                    }
                }
                candidate -= 1
            }
            if opener < 0 {
                break
            }
            // Openers between the pair can no longer match.
            for between: opener + 1..closer - 1 {
                diary_runs[between].dead = true
            }
            use: s32 = 1
            if diary_runs[opener].left >= 2 && diary_runs[closer].left >= 2 {
                use = 2
            }
            content_start := diary_runs[opener].start + diary_runs[opener].left
            content_end := diary_runs[closer].start + diary_runs[closer].taken
            if !active {
                DiaryMarkHidden(marks, content_start - use, content_start)
                DiaryMarkHidden(marks, content_end, content_end + use)
            }
            if use == 2 {
                DiaryMarkStrong(marks, content_start, content_end)
            } else {
                DiaryMarkItalic(marks, content_start, content_end)
            }
            diary_runs[opener].left -= use
            diary_runs[closer].left -= use
            diary_runs[closer].taken += use
        }
        if diary_runs[closer].left > 0 && !diary_runs[closer].can_open {
            diary_runs[closer].dead = true
        }
    }
}

// Links, then emphasis around and inside them, on text[from:to].
DiaryInline :: (marks: *DiaryLineMarks, text: string, from: s32, to: s32, active: bool, quoted: bool) {
    DiaryFindLinks(text, from, to)
    links: [DIARY_LINE_LINKS]DiaryLink
    link_count := diary_link_count
    for index: cast(s32)0..link_count - 1 {
        links[index] = diary_links[index]
    }
    DiaryEmphasis(marks, text, from, to, active)
    for index: cast(s32)0..link_count - 1 {
        link := links[index]
        // A photo is drawn under its line; its Markdown hides like a link's.
        if link.photo && !active {
            DiaryMarkHidden(marks, link.open - 1, link.end)
        }
        if link.image {
            continue
        }
        if !active {
            DiaryMarkHidden(marks, link.open, link.open + 1)
            DiaryMarkHidden(marks, link.text_end, link.end)
        }
        if !quoted {
            DiaryMarkTone(marks, link.open + 1, link.text_end, DIARY_TONE_LINK)
        }
        // Emphasis inside a link's text pairs only there.
        diary_link_count = 0
        DiaryEmphasis(marks, text, link.open + 1, link.text_end, active)
    }
}

// A heading's level and where its text starts, or level 0.
DiaryHeadingAt :: (text: string, start: s32, end: s32) -> DiaryHeading {
    heading: DiaryHeading
    at := start
    while at < end && at - start < 3 && text[at] == cast(u8)32 {
        at += 1
    }
    level: s32 = 0
    while at < end && text[at] == #char "#" && level < 7 {
        level += 1
        at += 1
    }
    if level < 1 || level > 6 || (at < end && !DiaryBlank(text[at])) {
        return heading
    }
    heading.level = level
    heading.start = at
    return heading
}

// Where a list item's marker ends (before its spaces), or -1.
DiaryListMarkerEnd :: (text: string, start: s32, end: s32) -> s32 {
    at := start
    while at < end && DiaryBlank(text[at]) {
        at += 1
    }
    if at >= end {
        return -1
    }
    marker := text[at]
    if marker == #char "-" || marker == #char "*" || marker == #char "+" {
        at += 1
    } else {
        digits: s32 = 0
        while at < end && text[at] >= cast(u8)48 && text[at] <= cast(u8)57 && digits < 10 {
            at += 1
            digits += 1
        }
        if digits < 1 || digits > 9 || at >= end || (text[at] != #char "." && text[at] != #char ")") {
            return -1
        }
        at += 1
    }
    if at < end && !DiaryBlank(text[at]) {
        return -1
    }
    return at
}

// Where a quote's text starts after `>` and one space, or -1.
DiaryQuoteStart :: (text: string, start: s32, end: s32) -> s32 {
    at := start
    while at < end && at - start < 3 && text[at] == cast(u8)32 {
        at += 1
    }
    if at >= end || text[at] != #char ">" {
        return -1
    }
    at += 1
    if at < end && DiaryBlank(text[at]) {
        at += 1
    }
    return at
}

// A heading's closing `#` run with the spaces before it, hidden like its
// opening marker: the start of that tail, or end when there is none.
DiaryHeadingTail :: (text: string, from: s32, end: s32) -> s32 {
    last := end
    while last > from && DiaryBlank(text[last - 1]) {
        last -= 1
    }
    hashes := last
    while hashes > from && text[hashes - 1] == #char "#" {
        hashes -= 1
    }
    if hashes == last {
        return end
    }
    if hashes == from {
        return from
    }
    if !DiaryBlank(text[hashes - 1]) {
        return end
    }
    tail := hashes
    while tail > from && DiaryBlank(text[tail - 1]) {
        tail -= 1
    }
    return tail
}

DiaryPreviewAdd :: (preview: *DiaryPreview, marks: *DiaryLineMarks) -> bool {
    marks.hidden_count = DiarySortHidden(marks.hidden[:], marks.hidden_count)
    marks.strong_count = DiaryJoinRanges(marks.strong[:], marks.strong_count)
    marks.italic_count = DiaryJoinRanges(marks.italic[:], marks.italic_count)
    marks.tone_count = DiarySortTones(marks.tones[:], marks.tone_count)
    if preview.hidden_count + marks.hidden_count > DIARY_PREVIEW_RANGES ||
    preview.strong_count + marks.strong_count > DIARY_PREVIEW_RANGES ||
    preview.italic_count + marks.italic_count > DIARY_PREVIEW_RANGES ||
    preview.tone_count + marks.tone_count > DIARY_PREVIEW_TONES {
        return false
    }
    for index: cast(s32)0..marks.hidden_count - 1 {
        preview.hidden[preview.hidden_count] = marks.hidden[index]
        preview.hidden_count += 1
    }
    for index: cast(s32)0..marks.strong_count - 1 {
        preview.strong[preview.strong_count] = marks.strong[index]
        preview.strong_count += 1
    }
    for index: cast(s32)0..marks.italic_count - 1 {
        preview.italic[preview.italic_count] = marks.italic[index]
        preview.italic_count += 1
    }
    for index: cast(s32)0..marks.tone_count - 1 {
        preview.tones[preview.tone_count] = marks.tones[index]
        preview.tone_count += 1
    }
    return true
}

// Builds the preview of text for the caret and selection between cursor and
// anchor. While editing, the lines they touch show their Markdown as typed.
DiaryPreviewScan :: (preview: *DiaryPreview, text: string, cursor: s32, anchor: s32, editing: bool) {
    preview.hidden_count = 0
    preview.strong_count = 0
    preview.italic_count = 0
    preview.tone_count = 0
    preview.heading_count = 0
    preview.photo_count = 0
    preview.truncated = false
    first := ifx cursor < anchor then cursor else anchor
    last := ifx cursor < anchor then anchor else cursor
    line: s32 = 0
    count := cast(s32)text.count
    while line <= count {
        end := DiaryLineEnd(text, line)
        active := editing && last >= line && first <= end
        // The line's photos are drawn under it, in order.
        line_photos := preview.photo_count
        embed := DiaryEmbedIn(text, line, end)
        while embed.valid {
            if preview.photo_count >= DIARY_PREVIEW_PHOTOS {
                preview.truncated = true
                return
            }
            preview.photos[preview.photo_count] = DiaryPhotoBlock.{.embed = embed}
            preview.photo_count += 1
            embed = DiaryEmbedIn(text, embed.end, end)
        }
        // A line of photos alone shows its first photo in its place.
        if preview.photo_count > line_photos && DiaryImageLine(text, line) {
            if !active {
                if preview.hidden_count >= DIARY_PREVIEW_RANGES {
                    preview.truncated = true
                    return
                }
                preview.photos[line_photos].cover = true
                preview.hidden[preview.hidden_count] = TextRange.{.start = line, .end = end}
                preview.hidden_count += 1
            }
            line = end + 1
            continue
        }
        diary_line = DiaryLineMarks.{}
        content := line
        quoted := false
        heading := DiaryHeadingAt(text, line, end)
        if heading.level > 0 {
            if preview.heading_count >= DIARY_PREVIEW_HEADINGS {
                preview.truncated = true
                return
            }
            preview.headings[preview.heading_count] = DiaryHeading.{.start = line, .level = heading.level}
            text_start := heading.start
            while text_start < end && DiaryBlank(text[text_start]) {
                text_start += 1
            }
            tail := DiaryHeadingTail(text, text_start, end)
            if !active {
                DiaryMarkHidden(*diary_line, line, text_start)
                DiaryMarkHidden(*diary_line, tail, end)
            }
            DiaryMarkStrong(*diary_line, text_start, tail)
            DiaryInline(*diary_line, text, text_start, tail, active, false)
        } else {
            quote := DiaryQuoteStart(text, line, end)
            if quote >= 0 {
                quoted = true
                DiaryMarkTone(*diary_line, line, end, DIARY_TONE_MUTED)
                content = quote
            } else {
                marker := DiaryListMarkerEnd(text, line, end)
                if marker >= 0 {
                    marker_start := line
                    while DiaryBlank(text[marker_start]) {
                        marker_start += 1
                    }
                    DiaryMarkTone(*diary_line, marker_start, marker, DIARY_TONE_MUTED)
                    content = marker
                }
            }
            DiaryInline(*diary_line, text, content, end, active, quoted)
        }
        if diary_line.overflow {
            // The whole line shows as typed rather than half styled.
            diary_line = DiaryLineMarks.{}
        }
        if !DiaryPreviewAdd(preview, *diary_line) {
            preview.truncated = true
            return
        }
        if heading.level > 0 {
            preview.heading_count += 1
        }
        line = end + 1
    }
}
