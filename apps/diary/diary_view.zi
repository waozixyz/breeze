using ImageFit;
using TextAlign;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;
host_api :: #system_library "host_api";
ReadDiaryUiHost :: () -> DiaryUiFrame #foreign host_api;
WriteDiaryUiHost :: (frame: DiaryUiFrame) #foreign host_api;
DiaryLocaleHost :: (key: string) -> string #foreign host_api;
state: DiaryMessage;
frame: DiaryUiFrame;
pending: bool;

DIARY_PREVIOUS_ICON :: "S1.8rr:M15 5L8 12L15 19"
DIARY_NEXT_ICON :: "S1.8rr:M9 5L16 12L9 19"
DIARY_CALENDAR_ICON :: "S1.6rr:M4 5H20V20H4ZM4 10H20M8 3V7M16 3V7"
DIARY_TIME_ICON :: "S1.6rr:M21 12C21 16.97 16.97 21 12 21C7.03 21 3 16.97 3 12C3 7.03 7.03 3 12 3C16.97 3 21 7.03 21 12ZM12 7V12L15.5 14"
DIARY_PHOTO_ICON :: "S1.6rr:M3 5H21V19H3ZM3 16L8 11L13 16L16 13L21 18M17.5 8.5C17.5 9.33 16.83 10 16 10C15.17 10 14.5 9.33 14.5 8.5C14.5 7.67 15.17 7 16 7C16.83 7 17.5 7.67 17.5 8.5Z"
DIARY_UNDO_ICON :: "S1.8rr:M9 14L4 9L9 4M4 9H14C17.31 9 20 11.69 20 15C20 18.31 17.31 21 14 21H11"
DIARY_REDO_ICON :: "S1.8rr:M15 14L20 9L15 4M20 9H10C6.69 9 4 11.69 4 15C4 18.31 6.69 21 10 21H13"
DIARY_SPELLING_ICON :: "S2rr:M3 14L7.5 3L12 14M4.8 10H10.2M12 17L15.5 20.5L21.5 13"

DiaryObserve :: () -> DiaryUiFrame {
    return ReadDiaryUiHost()
}

DiarySaveDue :: () -> bool {
    return frame.now >= frame.save_at
}

// Markdown bold reads as bold text. Its ** markers stay in the entry but are
// hidden, except on the lines holding the caret or a selection, where they
// can be edited directly.
DIARY_EMPHASIS_MAX :: 256
emphasis_hidden: [DIARY_EMPHASIS_MAX * 2]TextRange;
emphasis_strong: [DIARY_EMPHASIS_MAX]TextRange;
emphasis_hidden_count: s32;
emphasis_strong_count: s32;

DiaryEmphasis :: (value: string, cursor: s32, anchor: s32, editing: bool) {
    emphasis_hidden_count = 0
    emphasis_strong_count = 0
    first := ifx cursor < anchor then cursor else anchor
    last := ifx cursor < anchor then anchor else cursor
    line: s32 = 0
    while line <= cast(s32)value.count && emphasis_strong_count < DIARY_EMPHASIS_MAX {
        end := line
        while end < cast(s32)value.count && value[end] != cast(u8)10 { end += 1 }
        active := editing && last >= line && first <= end
        at := line
        while at + 1 < end && emphasis_strong_count < DIARY_EMPHASIS_MAX {
            if value[at] != cast(u8)42 || value[at + 1] != cast(u8)42 {
                at += 1
                continue
            }
            close := at + 2
            while close + 1 < end && (value[close] != cast(u8)42 || value[close + 1] != cast(u8)42) {
                close += 1
            }
            if close + 1 >= end {
                break
            }
            if close > at + 2 {
                emphasis_strong[emphasis_strong_count] = TextRange.{.start = at + 2, .end = close}
                emphasis_strong_count += 1
                if !active {
                    emphasis_hidden[emphasis_hidden_count] = TextRange.{.start = at, .end = at + 2}
                    emphasis_hidden[emphasis_hidden_count + 1] = TextRange.{.start = close, .end = close + 2}
                    emphasis_hidden_count += 2
                }
            }
            at = close + 2
        }
        line = end + 1
    }
}

DateTitle :: (year: s32, month: s32, day: s32) -> string {
    if month < 1 || month > 12 { return "" }
    keys: [12]string = .["habit_month_1", "habit_month_2", "habit_month_3",
    "habit_month_4", "habit_month_5", "habit_month_6", "habit_month_7",
    "habit_month_8", "habit_month_9", "habit_month_10", "habit_month_11", "habit_month_12"]
    month_text := DiaryLocaleHost(keys[month - 1])
    title: Vec(u8)
    eastern := month_text.count >= 2 && month_text[:2] == "%d"
    if day > 0 && !eastern { BuilderPrint(*title, "% ", day) }
    index: s64 = 0
    while index < month_text.count {
        if index + 1 < month_text.count && month_text[index:index + 2] == "%d" {
            BuilderPrint(*title, "%", year)
            index += 2
        } else {
            BuilderPrint(*title, "%", month_text[index:index + 1])
            index += 1
        }
    }
    if day > 0 && eastern {
        BuilderPrint(*title, "%", day)
        suffix := ifx month_text[month_text.count - 3:] == "월" then "일" else "日"
        BuilderPrint(*title, "%", suffix)
    }
    return BuilderFinish(title)
}

HasWords :: (text: string) -> bool {
    for byte: text {
        if byte != cast(u8)32 && byte != cast(u8)10 && byte != cast(u8)13 && byte != cast(u8)9 {
            return true
        }
    }
    return false
}

Scale :: (value: s32) -> s32 {
    return cast(s32)(cast(float32)value * frame.scale)
}

FinishView :: () -> DiaryMessage {
    WriteDiaryUiHost(frame)
    return state
}

// A button with an icon shows only the icon; its label names it for
// accessibility.
DiaryAction :: ( id: s32, label: string, bounds: Rectangle, enabled: bool = true,
    icon: string = "", selected: bool = false, loading: bool = false) {
    if Button(frame.session, ButtonProps.{.id = id, .bounds = bounds,
            .label = label, .disabled = !enabled, .selected = selected, .loading = loading,
            .icon_shape = icon, .icon_only = icon != "", .fit_content = true,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)(ifx icon != "" then ButtonEmphasisGhost else ButtonEmphasisSoft)}) != 0 {
        // Photos, undo, redo and spelling are host effects.
        frame.focused = false
        if id == 29005 {
            frame.photo_requested = true
            return
        }
        if id == 29014 {
            frame.undo_requested = true
            return
        }
        if id == 29015 {
            frame.redo_requested = true
            return
        }
        if id == 29016 {
            frame.spelling_requested = true
            return
        }
        state.action = DIARY_CONTROL
        state.control = id
        pending = true
        frame.scroll = 0
    }
}

DiaryView :: (message: DiaryMessage, observed: DiaryUiFrame, today: Date) -> DiaryMessage {
    state = message
    frame = observed
    column := CenteredColumnFor(frame.width, Scale(640), Scale(16))
    left := cast(float32)column.x
    width := cast(float32)column.width
    part := (width - cast(float32)Scale(12)) / 3.0
    compact := frame.height < Scale(480)
    top := cast(float32)(ifx compact then Scale(4) else Scale(12))
    control := cast(float32)Scale(44)
    gap := cast(float32)Scale(8)

    // Title bar: the selected date, centered between the previous and next day.
    DiaryAction(29001, "‹", Rectangle.{left, top, control, control}, true, DIARY_PREVIOUS_ICON)
    DiaryAction(29002, "›", Rectangle.{left + width - control, top, control, control},
        OnOrBefore(Next(Date.{state.year, state.month, state.day}, 1), today) &&
        !OnOrBefore(today, Date.{state.year, state.month, state.day}),
        DIARY_NEXT_ICON)
    title := DateTitle(state.year, state.month, state.day)
    title_strong: [1]TextRange = .[TextRange.{.start = 0, .end = cast(s32)title.count}]
    Text(frame.session, TextProps.{.bounds = Rectangle.{left + control + gap, top,
                width - 2.0 * (control + gap), control}, .text = title,
            .font = frame.font + Scale(4), .strong = title_strong[:],
            .align = cast(TextAlign)TextAlignCenter, .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone})

    // Tools: Today and the calendar move between days; undo, redo, spelling,
    // the time and photos change the entry. Today narrows on phones so every
    // icon keeps its target.
    tools := top + control + gap
    tool_gap := cast(float32)Scale(4)
    tool := control
    today_width := width - 6.0 * tool - 5.0 * tool_gap - gap
    if today_width < cast(float32)Scale(64) {
        // The narrowest phones keep Today readable with smaller icon targets.
        today_width = cast(float32)Scale(64)
        tool = (width - today_width - gap - 5.0 * tool_gap) / 6.0
    }
    if today_width > cast(float32)Scale(128) {
        today_width = cast(float32)Scale(128)
    }
    DiaryAction(29004, DiaryLocaleHost("diary_today"), Rectangle.{left, tools, today_width, control})
    DiaryAction(29003, DiaryLocaleHost("tab_diary_calendar"),
        Rectangle.{left + today_width + gap, tools, tool, control},
        true, DIARY_CALENDAR_ICON, state.calendar)
    editable := !state.load_error && state.year > 0
    if !state.calendar {
        idle := editable && !frame.spelling_busy
        DiaryAction(29014, DiaryLocaleHost("diary_undo"),
            Rectangle.{left + width - 5.0 * tool - 4.0 * tool_gap, tools, tool, control},
            idle && frame.can_undo, DIARY_UNDO_ICON)
        DiaryAction(29015, DiaryLocaleHost("diary_redo"),
            Rectangle.{left + width - 4.0 * tool - 3.0 * tool_gap, tools, tool, control},
            idle && frame.can_redo, DIARY_REDO_ICON)
        DiaryAction(29016, DiaryLocaleHost("diary_check_spelling"),
            Rectangle.{left + width - 3.0 * tool - 2.0 * tool_gap, tools, tool, control},
            idle && HasWords(state.text), DIARY_SPELLING_ICON, false, frame.spelling_busy)
        DiaryAction(29013, DiaryLocaleHost("diary_insert_time"),
            Rectangle.{left + width - 2.0 * tool - tool_gap, tools, tool, control},
            !frame.spelling_busy, DIARY_TIME_ICON)
        DiaryAction(29005, DiaryLocaleHost("diary_attach_photo"),
            Rectangle.{left + width - tool, tools, tool, control},
            true, DIARY_PHOTO_ICON)
    }
    content := tools + control + cast(float32)Scale(12)
    content_height := cast(float32)(frame.height - frame.bottom) - content - cast(float32)Scale(16)

    if state.calendar {
        scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)290300,
                .bounds = Rectangle.{left, content, width, content_height},
                .content_height = Scale(344), .scroll_offset = frame.calendar_scroll})
        frame.calendar_scroll = scroll.scroll_offset
        if !scroll.opened {
            return FinishView()
        }
        origin := scroll.content.y
        DiaryAction(29011, "‹", Rectangle.{left, origin, part, cast(float32)Scale(44)})
        DiaryAction(29012, "›", Rectangle.{left + 2.0 * (part + cast(float32)Scale(6)),
                origin, part, cast(float32)Scale(44)},
            state.month_year < today.year ||
            (state.month_year == today.year && state.month_number < today.month))
        Text(frame.session, TextProps.{.bounds = Rectangle.{left + part,
                    origin + cast(float32)Scale(8), part, cast(float32)Scale(32)},
                .text = DateTitle(state.month_year, state.month_number, 0), .font = frame.font})
        weekdays: [7]string = .["habit_day_mon", "habit_day_tue", "habit_day_wed", "habit_day_thu",
        "habit_day_fri", "habit_day_sat", "habit_day_sun"]
        for day: cast(s32)0..cast(s32)6 {
            Text(frame.session, TextProps.{.bounds = Rectangle.{left + cast(float32)day * width / 7.0,
                        origin + cast(float32)Scale(52), width / 7.0, cast(float32)Scale(24)},
                    .text = DiaryLocaleHost(weekdays[day]), .font = frame.font})
        }
        for day: cast(s32)1..state.month_days {
            position := state.month_weekday + day - 1
            label: Vec(u8)
            BuilderPrint(*label, "%", day)
            if state.marks[day] != cast(u8)0 { BuilderPrint(*label, " •") }
            day_title := BuilderFinish(label)
            cell := width / 7.0
            DiaryAction(29100 + day, day_title,
                Rectangle.{left + cast(float32)(position % 7) * cell,
                    origin + cast(float32)Scale(80 + (position / 7) * 44), cell - 2.0,
                    cast(float32)Scale(42)},
                OnOrBefore(Date.{state.month_year, state.month_number, day}, today))
        }
        End(frame.session)
        return FinishView()
    }
    // The editor reaches the bottom; a notice takes room below it only while
    // it is shown.
    notice := frame.photo_error || state.load_error || frame.spelling_notice != ""
    notice_room := ifx notice then Scale(60) else 0
    editor_height := cast(s32)content_height - notice_room
    if editor_height < Scale(120) {
        editor_height = Scale(120)
    }
    page := Scroll(frame.session, ScrollProps.{.key = cast(u64)290301,
            .bounds = Rectangle.{left, content, width, content_height},
            .content_height = editor_height + notice_room +
            (ifx state.photo_count > 0 then Scale(392) else 0), .scroll_offset = frame.page_scroll})
    frame.page_scroll = page.scroll_offset
    if !page.opened {
        return FinishView()
    }
    area: TextAreaProps
    area.key = cast(u64)290200
    area.focus_id = 29020
    area.bounds = Rectangle.{left, page.content.y, width, cast(float32)editor_height}
    area.value = state.text
    area.label = DiaryLocaleHost("tab_diary")
    area.wrap = true
    area.cursor = state.cursor
    area.anchor = state.anchor
    area.scroll_y = frame.scroll
    area.focused = frame.focused
    area.selecting = frame.selecting
    // The entry waits while its spelling is checked, so the correction
    // always applies to the text that was sent.
    area.read_only = !editable || frame.spelling_busy
    area.max_bytes = 2147483646
    area.max_codepoints = 2147483646
    area.input = frame.input
    DiaryEmphasis(state.text, state.cursor, state.anchor, frame.focused && !area.read_only)
    area.hidden = emphasis_hidden[:emphasis_hidden_count]
    area.strong = emphasis_strong[:emphasis_strong_count]
    edited := TextArea(frame.session, area)
    state.cursor = edited.cursor
    state.anchor = edited.anchor
    frame.scroll = edited.scroll_y
    frame.focused = edited.focused
    frame.selecting = edited.selecting
    if edited.edit.changed {
        state.action = DIARY_EDIT
        state.edit_start = edited.edit.start
        state.edit_end = edited.edit.end
        state.replacement = edited.edit.replacement
        pending = true
        frame.save_at = frame.now + 0.75
    }
    if edited.clipboard_write {
        frame.clipboard_write = true
        frame.clipboard_text = edited.clipboard_text
    }

    if notice {
        status := frame.spelling_notice
        if state.load_error {
            status = "diary_read_error"
        }
        if frame.photo_error {
            status = "diary_photo_error"
        }
        Text(frame.session, TextProps.{.bounds = Rectangle.{left,
                    area.bounds.y + area.bounds.height + cast(float32)Scale(12), width, cast(float32)Scale(40)},
                .text = DiaryLocaleHost(status), .font = frame.font})
    }
    if state.photo_count > 0 {
        photo_top := area.bounds.y + area.bounds.height + cast(float32)(notice_room + Scale(12))
        photo_bounds := Rectangle.{left, photo_top, width, cast(float32)Scale(240)}
        if frame.photo_format.count > 0 {
            path: Vec(u8)
            BuilderPrint(*path, "diary/photos/%.%", state.photo_file, frame.photo_format)
            image := BuilderFinish(path)
            Image(frame.session, ImageProps.{.asset_path = image,
                    .alt_text = state.photo_name,
                    .bounds = photo_bounds,
                    .fit = cast(ImageFit)ImageFitContain})
        } else {
            // The entry names a photo whose bytes are not on this device, for
            // example when a sync node keeps photos off. The entry still works.
            Box(frame.session, BoxProps.{.key = cast(u64)29011, .bounds = photo_bounds,
                    .fill = Color.{156, 156, 156, 36}, .radius = cast(float32)Scale(12)})
            Text(frame.session, TextProps.{.key = cast(u64)29012,
                    .text = DiaryLocaleHost("diary_photo_unavailable"),
                    .bounds = Rectangle.{left + cast(float32)Scale(16), photo_top,
                        width - cast(float32)Scale(32), cast(float32)Scale(240)},
                    .font = frame.font, .align = cast(TextAlign)TextAlignCenter,
                    .vertical_align = cast(TextAlign)TextAlignCenter})
        }
        Text(frame.session, TextProps.{.text = state.photo_name,
                .bounds = Rectangle.{left, photo_top + cast(float32)Scale(248), width,
                    cast(float32)Scale(32)}, .font = frame.font})
        DiaryAction(29008, "‹", Rectangle.{left, photo_top + cast(float32)Scale(288),
                part, cast(float32)Scale(44)})
        DiaryAction(29010, DiaryLocaleHost("diary_remove_photo"),
            Rectangle.{left + part + cast(float32)Scale(6), photo_top + cast(float32)Scale(288),
                part, cast(float32)Scale(44)})
        DiaryAction(29009, "›", Rectangle.{left + 2.0 * (part + cast(float32)Scale(6)),
                photo_top + cast(float32)Scale(288), part, cast(float32)Scale(44)})
    }
    End(frame.session)
    return FinishView()
}
