// Photos: the account's photo library, encrypted on this device and kept
// once per photo on the account's nodes. It is one of the apps the node
// offers; the host runs it through the generic app interface and grants it
// the account's media library.
#import, file "../../src/cells/module_types.zi";
#import, file "../../src/cells/node_app_types.zi";
#import, file "photos_view.zi";
host_api :: #system_library "host_api";
ReadAppHost :: () -> AppMessage #foreign host_api;
WriteAppHost :: (message: AppMessage) #foreign host_api;

PhotosApply :: (message: AppMessage) -> AppMessage {
    message.succeeded = true
    if message.action == APP_ROUTE {
        return message
    }
    if message.action == APP_BACK {
        message.succeeded = PhotosBack()
        return message
    }
    if message.action == APP_FRAME {
        return PhotosView(message)
    }
    message.succeeded = false
    return message
}

#program_export "PhotosMain"
Main :: () -> s32 {
    message := ReadAppHost()
    if message.abi != MODULE_ABI {
        return -1
    }
    if message.action == MODULE_IDENTIFY {
        return MODULE_NODE_APP
    }
    WriteAppHost(PhotosApply(message))
    return 0
}
