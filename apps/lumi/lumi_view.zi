using ImageFit;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;
host_api :: #system_library "host_api";
ReadLumiUiHost :: () -> LumiUiFrame #foreign host_api;
WriteLumiUiHost :: (frame: LumiUiFrame) #foreign host_api;
ReadLumiChatRowHost :: (index: s32) -> LumiChatRow #foreign host_api;
ReadLumiSuggestionTaskHost :: (index: s32) -> LumiTask #foreign host_api;
ReadLumiSuggestionHabitHost :: (index: s32) -> LumiTask #foreign host_api;
LumiViewLocaleHost :: (key: string) -> string #foreign host_api;
LumiFeedbackChoiceHost :: (id: string, action: s32) -> bool #foreign host_api;
LumiLoadOlderHost :: () -> bool #foreign host_api;
LumiFirstVisibleRowHost :: (scroll: s32) -> s32 #foreign host_api;
LumiRowOffsetHost :: (index: s32) -> s32 #foreign host_api;
ReadLumiDonationHost :: (coin: s32) -> LumiDonation #foreign host_api;
LumiDonationActionHost :: (coin: s32, action: s32) -> bool #foreign host_api;
frame: LumiUiFrame;
chart_selected_key: u64;
chart_selected_point: s32;
donation_notice: string;
donation_notice_row: s32 = -1;

Scale :: (value: s32) -> s32 {
    return cast(s32)(cast(float32)value * frame.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)height}
}

Suggestion :: (id: s32, text: string, bounds: Rectangle, label: string = "") -> bool {
    if Button(frame.session, ButtonProps.{.id = id, .bounds = bounds,
            .label = ifx label.count > 0 then label else text, .pill = true, .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        frame.value = text
        frame.cursor = cast(s32)text.count
        frame.anchor = frame.cursor
        frame.input_scroll = 0
        frame.selecting = false
        frame.preferred_x_valid = false
        frame.focused = true
        return true
    }
    return false
}

ChartDate :: (date: s32) -> string {
    out: Vec(u8)
    month := date / 100 % 100
    day := date % 100
    BuilderPrint(*out, "%-", date / 10000)
    BuilderPrint(*out, "%", ifx month < 10 then "0" else "")
    BuilderPrint(*out, "%-", month)
    BuilderPrint(*out, "%", ifx day < 10 then "0" else "")
    BuilderPrint(*out, "%", day)
    // Keep date labels independent of the host's locale and timezone.
    text := BuilderFinish(out)
    return text
}

ProgressCard :: (row: LumiChatRow, index: s32, x: s32, y: s32, width: s32) {
    chart := LumiChartRead(row.payload)
    if !chart.valid {
        return
    }
    key := 330000 + index * 64
    selection_key := KeyHash(row.payload)
    selected := ifx chart_selected_key == selection_key then chart_selected_point else 0
    if selected < 0 || selected >= chart.count {
        selected = 0
    }
    plot_y := y + Scale(30)
    plot_height := Scale(130)
    step := cast(float32)width / cast(float32)chart.count
    for point: cast(s32)0..chart.count - 1 {
        left := x + cast(s32)(cast(float32)point * step)
        bar_width := cast(s32)step - Scale(2)
        if bar_width < 1 {
            bar_width = 1
        }
        bar_height: s32 = 0
        if chart.maximum > 0 {
            bar_height = cast(s32)(cast(float64)chart.values[point] / cast(float64)chart.maximum * cast(float64)plot_height)
        }
        if Button(frame.session, ButtonProps.{.id = 310000 + index * 32 + point,
                .bounds = Bounds(left, plot_y, cast(s32)step, plot_height), .invisible = true}) != 0 {
            selected = point
            chart_selected_key = selection_key
            chart_selected_point = point
        }
        Box(frame.session, BoxProps.{.key = cast(u64)(key + point),
                .bounds = Bounds(left, plot_y + plot_height - bar_height, bar_width, bar_height),
                .fill = ifx selected == point then Color.{93, 148, 110, 255} else Color.{156, 188, 143, 200},
                .radius = cast(float32)Scale(2)})
    }
    Box(frame.session, BoxProps.{.key = cast(u64)(key + 31),
            .bounds = Bounds(x, plot_y + plot_height, width, Scale(1)), .fill = Color.{156, 156, 156, 120}})
    summary: Vec(u8)
    BuilderPrint(*summary, "% · %", ChartDate(chart.dates[selected]), chart.values[selected])
    Text(frame.session, TextProps.{.key = cast(u64)(key + 32),
            .bounds = Bounds(x, y, width, Scale(24)), .text = BuilderFinish(summary), .font = Scale(14)})
    half := width / 2
    Text(frame.session, TextProps.{.key = cast(u64)(key + 33),
            .bounds = Bounds(x, plot_y + plot_height + Scale(6), half, Scale(22)),
            .text = ChartDate(chart.dates[0]), .font = Scale(12)})
    Text(frame.session, TextProps.{.key = cast(u64)(key + 34),
            .bounds = Bounds(x + half, plot_y + plot_height + Scale(6), width - half, Scale(22)),
            .text = ChartDate(chart.dates[chart.count - 1]), .font = Scale(12)})
    if chart.maximum == 0 {
        Text(frame.session, TextProps.{.key = cast(u64)(key + 35),
                .bounds = Bounds(x, y + Scale(196), width, Scale(40)),
                .text = LumiViewLocaleHost("lumi_chart_empty"), .font = Scale(14)})
    }
}

DonationCard :: (index: s32, x: s32, y: s32, width: s32) {
    labels: [3]string = .[LumiViewLocaleHost("copy_address_button"),
    LumiViewLocaleHost("open_wallet_button"), LumiViewLocaleHost("trocador_button")]
    for coin: cast(s32)0..cast(s32)1 {
        donation := ReadLumiDonationHost(coin)
        address := donation.address
        if width < Scale(360) && address.count > 42 {
            abbreviated: Vec(u8)
            BuilderPrint(*abbreviated, "%…%", address[:16], address[address.count - 12:])
            address = BuilderFinish(abbreviated)
        }
        key := 340000 + index * 16 + coin * 8
        Text(frame.session, TextProps.{.key = cast(u64)key,
                .bounds = Bounds(x, y, width, Scale(24)), .text = donation.name, .font = frame.font})
        Text(frame.session, TextProps.{.key = cast(u64)(key + 1),
                .bounds = Bounds(x, y + Scale(26), width, Scale(62)),
                .text = address, .font = Scale(12), .selectable = true})
        for action: cast(s32)0..cast(s32)2 {
            if Button(frame.session, ButtonProps.{.id = 320000 + index * 8 + coin * 3 + action,
                    .bounds = Bounds(x, y + Scale(92 + action * 46), width, Scale(42)),
                    .label = labels[action], .tone = cast(ButtonTone)ButtonToneNeutral,
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
                succeeded := LumiDonationActionHost(coin, action)
                donation_notice_row = index
                donation_notice = ""
                if action == 0 && succeeded {
                    donation_notice = "address_copied"
                } else if !succeeded {
                    donation_notice = ifx action == 1 then "wallet_not_installed_toast" else "lumi_unavailable"
                }
            }
        }
        y += Scale(232)
    }
    if donation_notice_row == index && donation_notice.count > 0 {
        Text(frame.session, TextProps.{.key = cast(u64)(340000 + index * 16 + 15),
                .bounds = Bounds(x, y, width, Scale(36)),
                .text = LumiViewLocaleHost(donation_notice), .font = Scale(12)})
    }
}

LumiView :: (message: LumiMessage, commands: LumiCommands) -> LumiMessage {
    frame = ReadLumiUiHost()
    column := CenteredColumnFor(frame.width, Scale(720), Scale(16))
    x := column.x
    width := column.width
    input_height := Scale(48)
    measured_height := frame.draft_height + Scale(24)
    if measured_height > input_height {
        input_height = measured_height
    }
    if input_height > Scale(144) {
        input_height = Scale(144)
    }
    footer := frame.height - frame.bottom - Scale(16) - input_height
    suggestions_top := footer - Scale(ifx LumiTrim(frame.value).count > 0 then 46 else 0)
    history_top := Scale(12)
    chat_height := suggestions_top - history_top - Scale(8)
    if chat_height < Scale(60) {
        chat_height = Scale(60)
    }
    history := Scroll(frame.session, ScrollProps.{.key = cast(u64)300100,
            .bounds = Bounds(x, history_top, width, chat_height),
            .content_height = frame.history_height, .scroll_offset = frame.scroll, .scale = frame.scale})
    frame.scroll = history.scroll_offset
    frame.follow_end = history.scroll_offset == history.max_scroll
    if history.opened {
        first := LumiFirstVisibleRowHost(history.scroll_offset)
        top := cast(s32)history.content.y + LumiRowOffsetHost(first)
        for index: first..frame.chat_count - 1 {
            if top > history_top + chat_height {
                break
            }
            row := ReadLumiChatRowHost(index)
            row_height := row.height
            bubble_width := width - Scale(ifx row.user then 60 else 80)
            left := x + Scale(48)
            if !row.user {
                Image(frame.session, ImageProps.{.key = cast(u64)(300400 + index * 4),
                        .asset_path = "assets/lumi/mascot.png", .alt_text = "Lumi",
                        .bounds = Bounds(x, top + row_height - Scale(54), Scale(40), Scale(40)),
                        .source = Rectangle.{0.0, 0.0, -1254.0, 1254.0},
                        .fit = cast(ImageFit)ImageFitContain})
            }
            Box(frame.session, BoxProps.{.key = cast(u64)(300401 + index * 4),
                    .bounds = Bounds(left, top, bubble_width, row_height - Scale(10)),
                    .fill = ifx row.user then Color.{156, 188, 143, 48} else Color.{156, 156, 156, 24},
                    .radius = cast(float32)Scale(16)})
            if !row.user {
                Text(frame.session, TextProps.{.key = cast(u64)(300402 + index * 4),
                        .bounds = Bounds(left + Scale(14), top + Scale(8),
                        bubble_width - Scale(28), Scale(20)), .text = "Lumi", .font = Scale(12)})
            }
            text_top := Scale(ifx row.user then 12 else 32)
            card_height := Scale(ifx row.kind == LUMI_CHAT_PROGRESS then 242 else
                ifx row.kind == LUMI_CHAT_DONATIONS then 500 else ifx row.kind == LUMI_CHAT_FEEDBACK then 54 else 0)
            text_height := row_height - text_top - Scale(16) - card_height
            formatted := LumiFormatMessage(row.text, !row.user)
            Text(frame.session, TextProps.{.key = cast(u64)(300403 + index * 4),
                    .bounds = Bounds(left + Scale(14), top + text_top,
                    bubble_width - Scale(28), text_height),
                    .text = TextFromBytes(formatted.bytes[:formatted.count]),
                    .strong = formatted.strong[:formatted.strong_count],
                    .font = frame.font, .selectable = true, .wrap = cast(TextWrap)TextWrapAuto})
            card_top := top + text_top + text_height + Scale(8)
            if row.kind == LUMI_CHAT_PROGRESS {
                ProgressCard(row, index, left + Scale(14), card_top, bubble_width - Scale(28))
            } else if row.kind == LUMI_CHAT_DONATIONS {
                DonationCard(index, left + Scale(14), card_top, bubble_width - Scale(28))
            } else if row.kind == LUMI_CHAT_FEEDBACK {
                pending := LumiFeedbackChoiceHost(row.payload, 0)
                if Button(frame.session, ButtonProps.{.id = 351000 + index * 2,
                        .bounds = Bounds(left + Scale(14), card_top, Scale(88), Scale(44)),
                        .label = LumiViewLocaleHost("lumi_feedback_yes"), .disabled = !pending}) != 0 {
                    unused LumiFeedbackChoiceHost(row.payload, 1)
                }
                if Button(frame.session, ButtonProps.{.id = 351001 + index * 2,
                        .bounds = Bounds(left + Scale(108), card_top, Scale(88), Scale(44)),
                        .label = LumiViewLocaleHost("lumi_feedback_no"), .disabled = !pending}) != 0 {
                    unused LumiFeedbackChoiceHost(row.payload, 2)
                }
            }
            top += row_height
        }
        End(frame.session)
    }
    typed := LumiTrim(frame.value)
    candidates: [20]string = .[commands.start_whm, commands.complete_habit,
    commands.start_meditation, commands.start_sun, commands.start_patterns,
    commands.add, commands.complete, commands.reopen,
    commands.lists, commands.habits, commands.practices, commands.diary,
    commands.settings, commands.appearance, commands.dark, commands.light, commands.system, commands.write_diary,
    commands.progress, commands.donations]
    requirements: [20]s32 = .[LUMI_PRACTICES, LUMI_HABITS, LUMI_PRACTICES,
    LUMI_PRACTICES, LUMI_PRACTICES, LUMI_LISTS, LUMI_LISTS, LUMI_LISTS,
    LUMI_LISTS, LUMI_HABITS, LUMI_PRACTICES, LUMI_DIARY, 0, 0, 0, 0, 0, LUMI_DIARY, LUMI_PRACTICES, 0]
    suggestion_count: s32 = 0
    selected: bool
    limit: s32 = 2
    chip_width := (width - Scale(8)) / limit
    action := LumiIntent(typed, commands)
    if action.kind == 0 && frame.choosing_habit {
        action = LumiAction.{.kind = LUMI_COMPLETE_HABIT, .title = typed}
    }
    if typed.count > 0 && !frame.choosing_diary && LumiActionAvailable(action, frame.available_apps) &&
    (action.kind == LUMI_COMPLETE_TODO || action.kind == LUMI_REOPEN_TODO || action.kind == LUMI_COMPLETE_HABIT) {
        count := ifx action.kind == LUMI_COMPLETE_HABIT then frame.habit_count else frame.task_count
        for index: cast(s32)0..count - 1 {
            if suggestion_count >= limit {
                break
            }
            task := ifx action.kind == LUMI_COMPLETE_HABIT then ReadLumiSuggestionHabitHost(index) else ReadLumiSuggestionTaskHost(index)
            eligible := action.kind == LUMI_COMPLETE_HABIT || (action.kind == LUMI_COMPLETE_TODO && !task.done) ||
            (action.kind == LUMI_REOPEN_TODO && task.done)
            if !eligible || !LumiStarts(task.title, action.title) || suggestion_count >= limit {
                continue
            }
            out: Vec(u8)
            command := commands.reopen
            if action.kind == LUMI_COMPLETE_HABIT {
                command = commands.complete_habit
            } else if action.kind == LUMI_COMPLETE_TODO {
                command = commands.complete
            }
            BuilderPrint(*out, "% %", command, task.title)
            completion := BuilderFinish(out)
            selected = Suggestion(30020 + suggestion_count, completion,
                Bounds(x + suggestion_count * (chip_width + Scale(8)), suggestions_top, chip_width, Scale(36)), task.title) || selected
            suggestion_count += 1
        }
    }
    for index: cast(s32)0..cast(s32)19 {
        if typed.count == 0 || frame.choosing_diary || action.kind == LUMI_COMPLETE_HABIT || suggestion_count >= limit {
            break
        }
        candidate_action := LumiIntent(candidates[index], commands)
        practice_match := action.kind == LUMI_START_PRACTICE && candidate_action.kind == LUMI_START_PRACTICE &&
        action.practice == candidate_action.practice
        if (requirements[index] != 0 && (frame.available_apps & requirements[index]) == 0) || suggestion_count >= limit ||
        (typed.count > 0 && !LumiSuggests(candidates[index], typed) && !practice_match) {
            continue
        }
        text := candidates[index]
        if index == 1 || (index >= 5 && index <= 7) {
            out: Vec(u8)
            BuilderPrint(*out, "% ", text)
            text = BuilderFinish(out)
        }
        selected = Suggestion(30030 + index, text,
            Bounds(x + suggestion_count * (chip_width + Scale(8)), suggestions_top, chip_width, Scale(36))) || selected
        suggestion_count += 1
    }
    field := TextArea(frame.session, TextAreaProps.{.key = cast(u64)300200, .focus_id = 30010,
            .bounds = Bounds(x, footer, width - Scale(80), input_height),
            .value = frame.value, .placeholder = LumiViewLocaleHost("lumi_placeholder"), .label = "Lumi",
            .cursor = frame.cursor, .anchor = frame.anchor, .scroll_y = frame.input_scroll,
            .selecting = frame.selecting, .preferred_x = frame.preferred_x,
            .preferred_x_valid = frame.preferred_x_valid, .wrap = true,
            .focused = frame.focused, .input = frame.input, .max_bytes = LUMI_INPUT_MAX - 1,
            .max_codepoints = LUMI_INPUT_MAX - 1})
    if !selected {
        if field.edit.changed && field.edit.start >= 0 && field.edit.end >= field.edit.start &&
        field.edit.end <= frame.value.count {
            out: Vec(u8)
            BuilderPrint(*out, "%", frame.value[:field.edit.start])
            BuilderPrint(*out, "%", field.edit.replacement)
            BuilderPrint(*out, "%", frame.value[field.edit.end:])
            replacement := BuilderFinish(out)
            if replacement.count < LUMI_INPUT_MAX {
                frame.value = replacement
            }
        }
        frame.cursor = field.cursor
        frame.anchor = field.anchor
        frame.input_scroll = field.scroll_y
        frame.selecting = field.selecting
        frame.preferred_x = field.preferred_x
        frame.preferred_x_valid = field.preferred_x_valid
        frame.focused = field.focused
    }
    frame.clipboard_write = field.clipboard_write
    frame.clipboard_text = field.clipboard_text
    send := Button(frame.session, ButtonProps.{.id = 30011,
            .bounds = Bounds(x + width - Scale(72), footer, Scale(72), Scale(48)),
            .label = LumiViewLocaleHost("lumi_send"), .disabled = frame.waiting,
            .loading = frame.waiting, .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0
    if !frame.waiting && (send || field.committed) && LumiTrim(frame.value).count > 0 && !selected {
        message.action = LUMI_SEND
        // The host owns the draft buffer. Keep the submitted text before
        // WriteLumiUiHost clears that buffer for the next message.
        submitted: Vec(u8)
        BuilderPrint(*submitted, "%", frame.value)
        message.input = BuilderFinish(submitted)
        frame.value = ""
        frame.cursor = 0
        frame.anchor = 0
        frame.input_scroll = 0
        frame.selecting = false
        frame.preferred_x_valid = false
        frame.scroll = 1000000
        frame.follow_end = true
    }
    WriteLumiUiHost(frame)
    if message.action != LUMI_SEND && frame.has_older && !frame.follow_end && frame.scroll <= Scale(96) {
        unused LumiLoadOlderHost()
    }
    return message
}
