// Only confirmed useful effects reach these hooks; chat text is never read.
#import "std/text_buffer"
#import "std/vec"
#import, file "../../src/storage/achievements.zi";
#import, file "../../src/storage/storage_core.zi";
#import, file "../../src/apps/package_files.zi";

achievement_lumi_practice_offline: bool;

AchievementLumiEffect :: (source: string, kind: string, offline: bool) {
    day := AchievementToday()
    if source.count == 0 || day == 0 { return }
    unused AchievementRecord("lumi.action", source, day)
    if kind != "" { unused AchievementRecord(kind, source, day, active = false) }
    if offline { unused AchievementRecord("lumi.offline", source, day, active = false) }
}

AchievementLumiCommand :: (kind: string, offline: bool, source: string = "") {
    if source.count > 0 {
        AchievementLumiEffect(source, kind, offline)
        return
    }
    id: [37]u8
    storage_make_uuid(*id[0])
    AchievementLumiEffect(TextUntilNul(id[:]), kind, offline)
}
