// An owned snapshot of one composer edit: the replacement bytes are copied
// into their own owned record only when the edit changed, so carrying it
// past the area's scope keeps no view of the area result, at any length the
// edit produces.
LumiEditKeep :: struct {
    start: s32
    end: s32
    replacement: OwnedText.Text
    changed: bool
    valid: bool
}

LumiEditUpdate :: (result: TextArea.Result) -> LumiEditKeep {
    update: LumiEditKeep
    if result.edit.changed {
        update.replacement = OwnedText.TextCopy(result.edit.replacement)
        update.start = result.edit.start
        update.end = result.edit.end
        update.changed = true
        update.valid = true
    }
    return update
}

// Splice a kept edit into the owned draft, then free the previous bytes
// and move the new record in. The splice copies the old bytes before the
// free, and the call happens after the area result's scope ended, so no
// live view remains. The editor's own bound still caps the result; an
// edit past it is dropped whole, never truncated mid-byte.
ApplyLumiEdit :: (update: LumiEditKeep) -> bool {
    if !update.valid || !update.changed { return false }
    start := update.start
    end := update.end
    count := cast(s32)lumi_draft_text.bytes.count
    if start < 0 || end < start || end > count { return false }
    length := start + cast(s32)update.replacement.bytes.count + (count - end)
    if length > LUMI_INPUT_MAX - 1 { return false }
    out: Vec(u8)
    BuilderPrint(*out, "%", TextView(lumi_draft_text)[:start])
    BuilderPrint(*out, "%", TextView(update.replacement))
    BuilderPrint(*out, "%", TextView(lumi_draft_text)[end:])
    built: OwnedText.Text = OwnedText.TextFromBuilder(out)
    VecFree(lumi_draft_text.bytes)
    lumi_draft_text = built
    return true
}

// An owned snapshot of the area's clipboard text: copied into its own owned
// record inside the area's scope, so no view of the result crosses it.
LumiClipboardKeep :: struct {
    text: OwnedText.Text
    valid: bool
}

LumiClipboardUpdate :: (result: TextArea.Result) -> LumiClipboardKeep {
    update: LumiClipboardKeep
    update.text = OwnedText.TextCopy(result.clipboard_text)
    update.valid = true
    return update
}

// Release a kept edit snapshot that will not be applied: taking it by
// value moves the owned bytes, and they free when this scope ends.
DiscardLumiEdit :: (keep: LumiEditKeep) {
    VecFree(keep.replacement.bytes)
}

// Release a kept clipboard snapshot that will not be used: taking it by
// value moves the owned bytes, and they free when this scope ends.
DiscardLumiClipboard :: (keep: LumiClipboardKeep) {
    VecFree(keep.text.bytes)
}

// Return the composed frame to the host: scalars from the global frame, the
// draft from the owned record, and the frame's other strings from this
// frame's locals, so no host scratch view is ever stored in the global.
WriteLumiFrame :: (provider: string, agreement: string, clipboard: string,
    input: TextArea.Input) {
    out := frame
    out.value = TextView(lumi_draft_text)
    out.clipboard_text = clipboard
    out.provider_host = provider
    out.agreement_text = agreement
    out.input = input
    WriteLumiUiHost(out)
}

// A frame copy with every string cleared: the module keeps its strings in
// owned storage and frame locals, so host scratch views never enter the
// global frame. Every scalar is kept for drawing and the host round-trip.
LumiFrameScalars :: (host: LumiUiFrame) -> LumiUiFrame {
    fresh: LumiUiFrame = LumiUiFrame.{}
    fresh.session = host.session
    fresh.width = host.width
    fresh.height = host.height
    fresh.bottom = host.bottom
    fresh.scale = host.scale
    fresh.font = host.font
    fresh.draft_height = host.draft_height
    fresh.cursor = host.cursor
    fresh.anchor = host.anchor
    fresh.input_scroll = host.input_scroll
    fresh.selecting = host.selecting
    fresh.preferred_x = host.preferred_x
    fresh.preferred_x_valid = host.preferred_x_valid
    fresh.focused = host.focused
    fresh.scroll = host.scroll
    fresh.follow_end = host.follow_end
    fresh.chat_count = host.chat_count
    fresh.history_height = host.history_height
    fresh.has_older = host.has_older
    fresh.task_count = host.task_count
    fresh.habit_count = host.habit_count
    fresh.available_apps = host.available_apps
    fresh.practices_hidden = host.practices_hidden
    fresh.choosing_habit = host.choosing_habit
    fresh.choosing_diary = host.choosing_diary
    fresh.waiting = host.waiting
    fresh.clipboard_write = host.clipboard_write
    fresh.now = host.now
    fresh.background = host.background
    fresh.typing_pause = host.typing_pause
    fresh.online = host.online
    fresh.connection = host.connection
    fresh.agreement = host.agreement
    fresh.agreement_height = host.agreement_height
    return fresh
}

CopyLumiText :: (value: string) -> string {
    copy: Vec(u8)
    BuilderPrint(*copy, "%", value)
    return BuilderFinish(copy)
}

CopyChatRow :: (index: s32) -> string {
    return CopyLumiText(ReadLumiChatRowHost(index).text)
}

MessageTextFromBytes :: (bytes: []u8) -> string { return TextFromBytes(bytes) }
