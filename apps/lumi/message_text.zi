// Reply emphasis is presentation only. Stored messages remain verbatim, and
// typed messages and code keep their literal text.
#import "text_props"
#import "byte_text_linux"
#import, file "../../src/cells/lumi_types.zi";

LumiMessageText :: struct {
    bytes: [LUMI_INPUT_MAX]u8
    count: s32
    strong: [256]TextRange
    strong_count: s32
}

LumiTextEscaped :: (value: string, at: s32) -> bool {
    slashes: s32 = 0
    at -= 1
    while at >= 0 && value[at] == cast(u8)92 {
        slashes += 1
        at -= 1
    }
    return slashes % 2 == 1
}

LumiTextMarker :: (value: string, at: s32) -> bool {
    if at < 0 || at + 1 >= value.count || LumiTextEscaped(value, at) {
        return false
    }
    marker := value[at]
    return (marker == cast(u8)42 || marker == cast(u8)95) && value[at + 1] == marker &&
    (at == 0 || value[at - 1] != marker) &&
    (at + 2 >= value.count || value[at + 2] != marker)
}

LumiTextClosing :: (value: string, at: s32) -> s32 {
    marker := value[at]
    start := at + 2
    if start >= value.count || value[start] <= cast(u8)32 {
        return -1
    }
    code: bool
    while start + 1 < value.count {
        if value[start] == cast(u8)96 && !LumiTextEscaped(value, start) {
            code = !code
        }
        if !code && value[start] == marker && LumiTextMarker(value, start) &&
        start > at + 2 && value[start - 1] > cast(u8)32 {
            return start
        }
        start += 1
    }
    return -1
}

LumiFormatCounts :: struct {
    count: s32
    strong_count: s32
}

// Formats into caller buffers, for text longer than a chat message such
// as Lumi's online terms. Bytes that do not fit are left out.
LumiFormatInto :: (value: string, formatted: bool, bytes: []u8, strong: []TextRange) -> LumiFormatCounts {
    result: LumiFormatCounts
    limit := cast(s32)bytes.count - 1
    at: s32 = 0
    code: bool
    while at < value.count && result.count < limit {
        byte := value[at]
        if formatted && byte == cast(u8)96 && !LumiTextEscaped(value, at) {
            code = !code
        }
        if formatted && !code && LumiTextMarker(value, at) && result.strong_count < cast(s32)strong.count {
            end := LumiTextClosing(value, at)
            if end >= 0 {
                range := TextRange.{.start = result.count}
                at += 2
                while at < end && result.count < limit {
                    bytes[result.count] = value[at]
                    result.count += 1
                    at += 1
                }
                range.end = result.count
                strong[result.strong_count] = range
                result.strong_count += 1
                at = end + 2
                continue
            }
        }
        if formatted && byte == cast(u8)92 && at + 1 < value.count &&
        (value[at + 1] == cast(u8)42 || value[at + 1] == cast(u8)95 || value[at + 1] == cast(u8)92) {
            at += 1
            byte = value[at]
        }
        bytes[result.count] = byte
        result.count += 1
        at += 1
    }
    return result
}

LumiFormatMessage :: (value: string, formatted: bool) -> LumiMessageText {
    result: LumiMessageText
    counts := LumiFormatInto(value, formatted, result.bytes[:], result.strong[:])
    result.count = counts.count
    result.strong_count = counts.strong_count
    return result
}

// Web links in a message, which open from its words.
LUMI_LINKS_MAX :: 16
LUMI_LINK_MAX_BYTES :: 2048

LumiLink :: struct {
    start: s32
    end: s32
}

LumiLinks :: struct {
    items: [LUMI_LINKS_MAX]LumiLink
    count: s32
}

// Runs at every byte of a message, so it looks for the "h" before comparing
// a scheme and builds nothing.
LumiLinkStarts :: (value: string, at: s32) -> s32 {
    if at < 0 || at >= cast(s32)value.count || value[at] != cast(u8)104 {
        return 0
    }
    if at + 8 <= cast(s32)value.count && value[at:at + 8] == "https://" {
        return 8
    }
    if at + 7 <= cast(s32)value.count && value[at:at + 7] == "http://" {
        return 7
    }
    return 0
}

// A link ends at a space, a control character or a quote, and leaves out
// punctuation that closes the sentence around it.
LumiLinkEnd :: (value: string, start: s32) -> s32 {
    end := start
    while end < cast(s32)value.count {
        byte := value[end]
        if byte <= cast(u8)32 || byte == cast(u8)34 || byte == cast(u8)60 || byte == cast(u8)62 ||
        byte == cast(u8)96 {
            break
        }
        end += 1
    }
    while end > start {
        last := value[end - 1]
        closing := last == cast(u8)46 || last == cast(u8)44 || last == cast(u8)59 ||
        last == cast(u8)58 || last == cast(u8)33 || last == cast(u8)63 || last == cast(u8)41 ||
        last == cast(u8)93 || last == cast(u8)125 || last == cast(u8)39 || last == cast(u8)42
        if !closing {
            break
        }
        end -= 1
    }
    return end
}

LumiMessageLinks :: (value: string) -> LumiLinks {
    links: LumiLinks
    at: s32 = 0
    while at < cast(s32)value.count && links.count < LUMI_LINKS_MAX {
        scheme := LumiLinkStarts(value, at)
        previous_word := at > 0 && value[at - 1] > cast(u8)32 && value[at - 1] != cast(u8)40
        if scheme == 0 || previous_word {
            at += 1
            continue
        }
        end := LumiLinkEnd(value, at)
        if end - at > scheme && end - at <= LUMI_LINK_MAX_BYTES {
            links.items[links.count] = LumiLink.{.start = at, .end = end}
            links.count += 1
        }
        at = ifx end > at then end else at + 1
    }
    return links
}

// Only a whole web link Lumi found in a message opens.
LumiLinkValid :: (url: string) -> bool {
    links := LumiMessageLinks(url)
    return links.count == 1 && links.items[0].start == 0 && links.items[0].end == cast(s32)url.count
}
