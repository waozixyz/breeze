#import "geometry"
ImageSchema :: #import "image_props";

// Lumi's picture faces right. Beside her messages she faces the chat, so she
// is drawn mirrored: as a warped image whose corners swap sides, which every
// host draws. The desktop host draws no image with a negative source width,
// and a frame with an image it cannot draw closes the app.
LUMI_MASCOT_PATH :: "assets/lumi/mascot.webp"

// The mascot over bounds facing left. corners, four points, keeps the mesh
// until the image is drawn.
LumiMascotFacingLeft :: (key: u64, bounds: Rectangle, corners: []Vector2) -> ImageSchema.Props {
    picture: ImageSchema.Props
    picture.key = key
    picture.asset_path = LUMI_MASCOT_PATH
    picture.alt_text = "Lumi"
    picture.bounds = bounds
    // A detailed picture drawn far smaller than its pixels.
    picture.smooth = true
    if corners.count < 4 { return picture }
    right := bounds.x + bounds.width
    bottom := bounds.y + bounds.height
    corners[0] = Vector2.{right, bounds.y}
    corners[1] = Vector2.{bounds.x, bounds.y}
    corners[2] = Vector2.{right, bottom}
    corners[3] = Vector2.{bounds.x, bottom}
    picture.mesh.columns = 2
    picture.mesh.rows = 2
    picture.mesh.points = corners[:4]
    return picture
}
