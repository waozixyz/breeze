c :: #system_library "c";
practice_background_start :: (app: *InnerBreeze, id: s32) #foreign c;
practice_active_background_stop :: (app: *InnerBreeze) #foreign c;
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c;
sync_habits_for_activity :: (app: *InnerBreeze, activity: s32) #foreign c;
app_draw_session_exit_modal :: (app: *InnerBreeze, can_save: s32,
    save_message: string, discard_message: string) -> SessionExitModalResult #foreign c;

using ExerciseType;
using AppThemeMode;
using ModalType;
using SessionExitModalResult;
using TextAlign;
using WidgetKind;
using ButtonTone;
using ButtonEmphasis;

astral_course: AstralCourse;
astral_playback: AstralPlayback;
astral_seek_audio_pending: bool;
astral_seek_audio_delay_ms: s32;
astral_seek_silent_cue: s32 = -1;
astral_frame_carry: float64;
astral_scroll: s32;
astral_last_cue: s32 = -1;
astral_exit_was_paused: s32;

AstralActive :: (app: *InnerBreeze) -> s32 {
    return ifx app != null && app_session_screen(app) == ScreenAstralProjection then 1 else 0
}

astral_legacy: bool;
astral_content_error: bool;
astral_reveal_selection: bool;
astral_catalogue: AstralCatalogue;

AstralLegacyAvailable :: () -> bool {
    return !AssetRead("assets/practices/astral_projection/catalogue.json").found
}

astral_catalogue_generation: u64;
astral_session_practice: AstralPractice;

AstralCatalogueLoad :: () -> bool {
    generation := AssetGeneration()
    if astral_catalogue.count == 6 && astral_catalogue_generation == generation {
        return true
    }
    asset := AssetRead("assets/practices/astral_projection/catalogue.json")
    if !asset.found {
        astral_catalogue = AstralCatalogue.{}
        return false
    }
    if !AstralCatalogueParse(asset.data, *astral_catalogue) {
        return false
    }
    astral_catalogue_generation = generation
    astral_content_error = false
    return true
}

AstralSelection :: (app: *InnerBreeze) -> s32 {
    return AstralSelectedIndex(*astral_catalogue, TextFromCString(*app.astral_projection_exercise[0]))
}

// The card always opens the selector. Starting a lesson requires a second action.
AstralStart :: (app: *InnerBreeze) {
    if app == null || !ActivityStartAllowed() {
        return
    }
    astral_content_error = !AstralCatalogueLoad()
    astral_reveal_selection = true
    app.manual_scroll = 0
    app.tutorial_step = 0
    app_switch_screen(app, ScreenStart)
    app_open_modal(app, cast(ModalType)ModalPracticeManual)
}

AstralStartSelected :: (app: *InnerBreeze, allow_legacy: bool) {
    if app == null || !ActivityStartAllowed() {
        return
    }
    astral_legacy = allow_legacy && AstralLegacyAvailable()
    selected: AstralPractice
    path: [192]u8
    if astral_legacy {
        unused AppCopyText("assets/practices/astral_projection/session.json", path[:])
    } else {
        if !AstralCatalogueLoad() {
            astral_content_error = true
            return
        }
        selected = astral_catalogue.practices[AstralSelection(app)]
        unused AppCopyText("assets/practices/astral_projection/sessions/", path[:])
        unused AppAppendText(TextFromCString(*selected.id[0]), path[:])
        unused AppAppendText(".json", path[:])
    }
    asset := AssetRead(TextUntilNul(path[:]))
    if !asset.found || !AstralCourseParse(asset.data, *astral_course) ||
    (!astral_legacy && astral_course.duration != selected.duration) {
        astral_content_error = true
        return
    }
    astral_content_error = false
    astral_session_practice = selected
    if !astral_legacy {
        unused AppCopyText(TextFromCString(*selected.id[0]), app.astral_projection_exercise[:])
        save_settings(app)
    }
    mark_exercise_manual_seen(app, EXERCISE_ASTRAL_PROJECTION)
    app.tutorial_step = 0
    app.manual_scroll = 0
    app.practice_tab = PRACTICE_TAB_PLAY
    astral_playback = AstralPlayback.{}
    astral_seek_audio_pending = false
    astral_seek_audio_delay_ms = 0
    astral_seek_silent_cue = -1
    astral_frame_carry = 0.0
    astral_scroll = 0
    astral_last_cue = -1
    app.session_paused = 0
    PracticeNarrationStop()
    app_close_modal(app)
    PracticeDraftBegin(EXERCISE_ASTRAL_PROJECTION)
    app_switch_screen(app, ScreenAstralProjection)
    meditation_music_start_session(app)
    practice_background_start(app, EXERCISE_ASTRAL_PROJECTION)
}

AstralElapsed :: () -> s32 {
    return astral_playback.position.elapsed_seconds
}

AstralDuration :: () -> s32 {
    return ifx astral_legacy then 0 else astral_course.duration
}

AstralRemaining :: () -> s32 {
    return ifx AstralElapsed() < AstralDuration() then AstralDuration() - AstralElapsed() else 0
}

AstralSave :: (app: *InnerBreeze, output: *u8, capacity: s64) {
    seconds := astral_playback.practiced.elapsed_seconds
    if seconds < 60 {
        return
    }
    details := SessionDetails.{.version = SessionDetailsVersion, .duration_seconds = seconds}
    if !astral_legacy {
        unused AppCopyText(TextFromCString(*astral_session_practice.id[0]), details.item[:])
        unused AppCopyText(AstralText(TextFromCString(*astral_session_practice.title_key[0])), details.title[:])
    }
    // Storage always returns an identity, including exits which do not show
    // a results page. Keep that output alive for the duration of the save.
    saved_path: [FS_PATH_MAX]u8
    if output == null || capacity <= 0 {
        output = *saved_path[0]
        capacity = size_of(type_of(saved_path))
    }
    if data_save_session_path_with_details(*seconds, 1, 0, EXERCISE_ASTRAL_PROJECTION,
        *details, output, capacity) != 0 {
        sync_habits_for_activity(app, EXERCISE_ASTRAL_PROJECTION)
        unused app_auto_sync(app)
    }
}

AstralStop :: (app: *InnerBreeze) {
    PracticeDraftEnd()
    PracticeNarrationStop()
    meditation_music_stop(app)
    practice_active_background_stop(app)
    app.session_paused = 0
    app.volume_popup_active = 0
    app.music_volume_popup_active = 0
    app_close_modal(app)
}

AstralEnd :: (app: *InnerBreeze) {
    AstralSave(app, null, 0)
    AstralStop(app)
    app_switch_screen(app, ScreenStart)
}

AstralAdvanceElapsed :: (app: *InnerBreeze, milliseconds: s32) {
    if AstralActive(app) == 0 {
        return
    }
    before := AstralElapsed()
    duration := AstralDuration()
    paused := app.session_paused != 0
    astral_playback = AstralPlaybackAdvance(astral_playback, milliseconds, paused, duration)
    if !paused && milliseconds > 0 && astral_seek_audio_delay_ms > 0 {
        astral_seek_audio_delay_ms -= milliseconds
    }
    practiced := astral_playback.practiced.elapsed_seconds
    PracticeDraftElapsed(EXERCISE_ASTRAL_PROJECTION, practiced, AstralCueAt(*astral_course, AstralElapsed()), false)
    if duration > 0 && before < duration && AstralElapsed() == duration && practiced >= 60 {
        result_path: [FS_PATH_MAX]u8
        AstralSave(app, *result_path[0], size_of(type_of(result_path)))
        send_session_complete(app)
        AstralStop(app)
        app_prepare_session_results(app, EXERCISE_ASTRAL_PROJECTION,
            practiced, 0, null, null, 0, *result_path[0])
        app_switch_screen(app, ScreenResults)
    }
}

AstralCueKey :: () -> string {
    index := AstralCueAt(*astral_course, AstralElapsed())
    if index < 0 {
        return ""
    }
    return TextFromCString(*astral_course.cues[index].key[0])
}

AstralSeek :: (second: s32) {
    if AstralDuration() <= 0 { return }
    next := AstralSeekPosition(astral_playback, second, AstralDuration())
    if next.position.elapsed_seconds == AstralElapsed() { return }
    astral_playback = next
    astral_frame_carry = 0.0
    PracticeNarrationStop()
    astral_seek_audio_pending = true
    // Let consecutive drag updates settle before restarting one line.
    astral_seek_audio_delay_ms = 160
    astral_seek_silent_cue = -1
    PracticeDraftElapsed(EXERCISE_ASTRAL_PROJECTION, astral_playback.practiced.elapsed_seconds,
        AstralCueAt(*astral_course, AstralElapsed()), true)
}

AstralUpdate :: (app: *InnerBreeze) {
    if AstralActive(app) == 0 {
        return
    }
    meditation_music_update(app)
    if AstralDuration() > 0 && AstralRemaining() == 0 {
        PracticeNarrationStop()
        return
    }
    cue := AstralCueAt(*astral_course, AstralElapsed())
    key := AstralCueKey()
    if astral_seek_audio_pending {
        if app.session_paused != 0 || astral_seek_audio_delay_ms > 0 { return }
        astral_seek_audio_pending = false
        clip_ms := cast(s32)(PracticeNarrationSeconds("astral_projection", key) * 1000.0)
        if !AstralNarrationCanRestart(*astral_course, astral_playback.position, cue, clip_ms) {
            astral_seek_silent_cue = cue
        }
    }
    if cue != astral_seek_silent_cue {
        PracticeNarrationUpdate(app, "astral_projection", key)
    }
}

AstralRequestExit :: (app: *InnerBreeze) {
    astral_exit_was_paused = app.session_paused
    app.session_paused = 1
    PracticeDraftElapsed(EXERCISE_ASTRAL_PROJECTION, astral_playback.practiced.elapsed_seconds, 0, true)
    app_open_modal(app, cast(ModalType)ModalConfirmExitSession)
}

AstralExitPrompt :: (app: *InnerBreeze) -> s32 {
    if app.modal.active == 0 || app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return 0
    }
    result := app_draw_session_exit_modal(app, ifx astral_playback.practiced.elapsed_seconds >= 60 then 1 else 0,
        LocaleText("meditation_save_elapsed_message"), LocaleText("meditation_under_minute_exit_message"))
    if result == cast(SessionExitModalResult)SessionExitModalCancel {
        app_close_modal(app)
        app.session_paused = astral_exit_was_paused
    } else if result == cast(SessionExitModalResult)SessionExitModalSave ||
    result == cast(SessionExitModalResult)SessionExitModalDiscard {
        if result == cast(SessionExitModalResult)SessionExitModalSave {
            AstralSave(app, null, 0)
        }
        AstralStop(app)
        app_switch_screen(app, ScreenStart)
        return 2
    }
    return 1
}

AstralTextAsset :: (code: string) -> AssetView {
    path: [128]u8
    if !AppCopyText("assets/practices/astral_projection/text/", path[:]) ||
    !AppAppendText(code, path[:]) || !AppAppendText(".txt", path[:]) {
        return AssetView.{}
    }
    return AssetRead(TextUntilNul(path[:]))
}

AstralText :: (key: string) -> string {
    localized := AstralTextAsset(LocaleActiveCode())
    english := AstralTextAsset("en")
    return LocaleResolveCatalog(localized.data, english.data, key)
}

AstralCueText :: () -> string {
    return AstralText(AstralCueKey())
}

AstralAppendTime :: (output: []u8, cursor: *s32, second: s32) {
    unused TextBufferAppendNumber(output, cursor, second / 60)
    unused TextBufferAppendByte(output, cursor, cast(u8)58)
    unused TextBufferAppendPaddedNumber(output, cursor, second % 60, 2)
}

AstralTimeText :: (output: []u8, timeline: bool = false) -> string {
    cursor: s32 = 0
    output[0] = cast(u8)0
    if timeline && !astral_legacy {
        AstralAppendTime(output, *cursor, AstralElapsed())
        unused TextBufferAppendByte(output, *cursor, cast(u8)32)
        unused TextBufferAppendByte(output, *cursor, cast(u8)47)
        unused TextBufferAppendByte(output, *cursor, cast(u8)32)
        AstralAppendTime(output, *cursor, AstralDuration())
    } else {
        AstralAppendTime(output, *cursor, ifx astral_legacy then AstralElapsed() else AstralRemaining())
    }
    return TextUntilNul(output)
}

AstralPracticeFigure :: (app: *InnerBreeze, picture: Rectangle, key: u64, alt_text: string) {
    milliseconds := cast(s64)AstralElapsed() * 1000 + astral_playback.position.remainder_ms
    dark := app.theme_mode == APP_THEME_DARK || (app.theme_mode != APP_THEME_LIGHT && app.dark_mode != 0)
    if astral_legacy {
        AstralSceneDraw(app.ui.session, milliseconds, picture, dark, key, alt_text)
        return
    }
    technique := AstralTechniqueAt(TextFromCString(*astral_session_practice.id[0]), *astral_course, milliseconds)
    AstralTechniqueDraw(app.ui.session, technique, milliseconds, picture, dark, key, alt_text)
}

AstralDrawWindow :: (app: *InnerBreeze, picture: Rectangle, output: []u8) -> string {
    AstralPracticeFigure(app, picture, Layout.KeyHash("astral/window/scene"), LocaleText("exercise_astral_projection"))
    return AstralTimeText(output)
}

AstralSessionFigure :: (app: *InnerBreeze, request: PracticeFigureRequest) {
    AstralPracticeFigure(app, request.bounds, request.key, request.alt_text)
}

AstralDraw :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    top := PracticeTitleBarHeight()
    if PracticeTitleBar(app, ifx astral_legacy then LocaleText("exercise_astral_projection") else
        AstralText(TextFromCString(*astral_session_practice.title_key[0])), top) {
        AstralRequestExit(app)
    }
    if AstralExitPrompt(app) != 0 {
        return
    }
    practice_draw_audio_controls(app)
    cue := AstralCueAt(*astral_course, AstralElapsed())
    if cue != astral_last_cue {
        astral_scroll = 0
        astral_last_cue = cue
    }
    time: [32]u8
    frame := PracticeMovementFrameFor(app, EXERCISE_ASTRAL_PROJECTION, top)
    frame.time = FrameTextHold(*app.ui.frame_text, AstralTimeText(time[:], true))
    frame.cue = AstralCueText()
    frame.elapsed_ms = AstralElapsed() * 1000
    frame.length_ms = AstralDuration() * 1000
    frame.progress = ifx AstralDuration() > 0 then AstralElapsed() * 1000 / AstralDuration() else 0
    frame.scroll = astral_scroll
    frame = PracticeMovementRun(app, frame, AstralSessionFigure)
    astral_scroll = frame.scroll
    if frame.action == PRACTICE_MOVEMENT_SEEK {
        AstralSeek(frame.value)
        return
    }
    timeline := TreePrevious(app.ui.session, TreeCurrentParent(app.ui.session),
        Layout.KeyHash("astral/progress"), WidgetKindSlider)
    if TreeFocusedAt(app.ui.session, timeline) {
        direction: s32 = (ifx HostKeyPressed(KEY_RIGHT) then 1 else 0) -
        (ifx HostKeyPressed(KEY_LEFT) then 1 else 0)
        if direction != 0 {
            AstralSeek(AstralElapsed() + direction * 5)
            return
        }
    }
    if frame.action == PRACTICE_MOVEMENT_PAUSE {
        app.session_paused = ifx app.session_paused != 0 then 0 else 1
        PracticeDraftElapsed(EXERCISE_ASTRAL_PROJECTION, astral_playback.practiced.elapsed_seconds, 0, true)
    }
    if app.backgrounded == 0 {
        total := cast(float64)HostFrameSeconds() * 1000.0 + astral_frame_carry
        milliseconds := cast(s32)total
        astral_frame_carry = total - cast(float64)milliseconds
        AstralAdvanceElapsed(app, milliseconds)
    }
    unused center_x
    unused center_y
}
