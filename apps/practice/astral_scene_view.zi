#import "std/math"
#import "kryon/session"
#import "kryon/geometry"
#import, file "astral_scene.zi";
#import, file "workout_moves.zi";
#import, file "../../src/practices/tai_chi/tai_chi_math.zi";
#import, file "../../src/practices/tai_chi/tai_chi_flat.zi";
#import, file "../../src/practices/tai_chi/tai_chi_solve.zi";
#import, file "../../src/practices/tai_chi/tai_chi_draw.zi";
#import, file "../../src/practices/tai_chi/tai_chi_rules.zi";
#import, file "../../src/practices/tai_chi/tai_chi_view.zi";

ASTRAL_EDGE_PATH :: "assets/practices/astral_projection/flat-edge.png"
astral_scene_floor: TaiChiFlatFrame;
astral_scene_figure: TaiChiFlatFrame;

AstralSceneRing :: (view: *TaiChiFlatView, radius: float64, phase: float64, color: u32) {
    frame := *astral_scene_floor
    op := TaiChiFlatOp.{.kind = TAI_CHI_FLAT_LINE, .color = color,
        .alpha = 0.35, .width = 0.005, .first = frame.point_count, .count = 49}
    for index: cast(s32)0..48 {
        angle := cast(float64)index / 48.0 * TAI_CHI_PI * 2.0
        point := TaiChiV3(Cos(angle) * radius, 0.02 + Sin(angle * 2.0 + phase) * 0.015,
            Sin(angle) * radius * 1.35)
        frame.points[frame.point_count] = TaiChiProject(view, point)
        frame.point_count += 1
    }
    frame.ops[frame.op_count] = op
    frame.op_count += 1
}

AstralSceneDraw :: (session: Session, milliseconds: s64, area: Rectangle, dark: bool, key: u64, alt_text: string) {
    if area.width <= 0.0 || area.height <= 0.0 { return }
    scene := AstralSceneAt(milliseconds)
    framing: TaiChiFraming
    framing.camera = scene.camera
    framing.view_height = 1.9
    framing.view_center = 0.28
    across := framing.view_height * cast(float64)area.width / cast(float64)area.height
    if across < 2.8 { framing.view_height *= 2.8 / across }
    view: TaiChiFlatView
    TaiChiFlatViewSet(*view, scene.camera)
    astral_scene_floor.op_count = 0
    astral_scene_floor.point_count = 0
    color := ifx dark then cast(u32)0x6a9ead else cast(u32)0x3f6f8f
    AstralSceneRing(*view, 0.68, scene.phase, color)
    AstralSceneRing(*view, 1.0, scene.phase + 1.4, color)
    AstralSceneRing(*view, 1.32, scene.phase + 2.8, color)
    TaiChiPaintFlatEdge(session, *astral_scene_floor, framing, false, area, key, "", ASTRAL_EDGE_PATH)
    rig := WorkoutRig()
    solved := WorkoutSolve(*scene.pose, *rig)
    look := TaiChiFlatLookNamed("jadeWoman")
    look.top = cast(u32)0x3f6f8f
    look.pants = cast(u32)0x2e7d68
    look.accent = cast(u32)0xf2a65e
    TaiChiFlatPaintLook(*astral_scene_figure, *solved, *rig, look, scene.camera)
    TaiChiPaintFlatEdge(session, *astral_scene_figure, framing, false, area, key + cast(u64)4096, alt_text, ASTRAL_EDGE_PATH)
}
