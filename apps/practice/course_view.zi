// The gallery includes free Foundations and faded, tappable course unlocks.
// Individual movement variants retain their saved item IDs.
#import "session"
#import "geometry"
#import "drawing_props"
#import "dpi"
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Shape :: #import "kryon/shape";
Image :: #import "kryon/image";
Layout :: #import "kryon/layout";
Modal :: #import "kryon/modal";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
#import "semantic"
#import "text_align"
#import "text_measure"
#import "control_props"
#import "kryon/tree"
#import, file "../../src/apps/practice_ui_types.zi";
#import, file "../../src/apps/practice_types.zi";

using SemanticKind;
using ButtonTone;
using ButtonEmphasis;
using ContentAlignment;
using TextAlign;
using Text.Wrap;
host_api :: #system_library "host_api";
ReadPracticeCourseHost :: () -> PracticeCourseFrame #foreign host_api;
WritePracticeCourseHost :: (frame: PracticeCourseFrame) #foreign host_api;
ReadPracticeCourseRowHost :: (lesson: bool, index: s32) -> PracticeCourseRow #foreign host_api;
CourseLocaleHost :: (key: string) -> string #foreign host_api;
course: PracticeCourseFrame;
COURSE_LESSON_LIMIT :: 32
course_lessons: [COURSE_LESSON_LIMIT]PracticeCourseRow;

Scale :: (pixels: s32) -> s32 {
    return ScalePixels(pixels, course.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)height}
}

Locale :: (key: string) -> string {
    return CourseLocaleHost(key)
}

ParagraphHeight :: (text: string, width: s32, font: s32) -> s32 {
    return TextHeight(course.session, Text.Props.{.text = text, .size = font,
            .bounds = Bounds(0, 0, width, 0), .line_gap = Scale(3)})
}

Section :: (text: string, bounds: Rectangle) {
    strong: [1]Text.Range = .[Text.Range.{.start = 0, .end = cast(s32)text.count}]
    Text.Draw(course.session, Text.Props.{.text = text, .bounds = bounds,
            .size = course.font + Scale(2), .strong = strong[:],
            .semantic_kind = cast(SemanticKind)SemanticHeading, .heading_level = 2})
}

Play :: (item: s32) {
    course.action = PRACTICE_COURSE_PLAY
    course.value = item
}

lesson_artwork: [8]string = .[
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-1.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-2.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-3.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-4.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-5.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-6.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-7.webp",
    "assets/practices/shared/tai-chi-gallery/thumbnails/lesson-8.webp"];
lesson_bounds: [COURSE_LESSON_LIMIT]Rectangle;
lesson_indices: [COURSE_LESSON_LIMIT]s32;
lesson_total: s32;
lesson_artwork_indices: [COURSE_LESSON_LIMIT]s32;

LessonHeight :: (row: PracticeCourseRow, width: s32) -> s32 {
    text_width := width - Scale(24)
    return Scale(80) + text_width * 3 / 4 +
        ParagraphHeight(row.title, text_width, course.font + Scale(2)) +
        ParagraphHeight(row.subtitle, text_width, course.font)
}

LessonCard :: (bounds: Rectangle, index: s32, artwork: s32, row: PracticeCourseRow) {
    activated := Button.Draw(course.session, Button.Props.{
        .key = Layout.KeyHash("inbe/tai_chi/lesson") + cast(u64)index,
        .bounds = bounds, .label = row.title, .detail = row.detail, .icon_only = true, .selected = row.done,
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft})
    inset := cast(float32)Scale(12)
    content := Rectangle.{bounds.x + inset, bounds.y + inset,
        bounds.width - inset * 2.0, bounds.height - inset * 2.0}
    picture_h := cast(s32)content.width * 3 / 4
    if artwork >= 0 && artwork < 8 {
        Image.Draw(course.session, Image.Props.{
            .key = Layout.KeyHash("inbe/tai_chi/lesson-image") + cast(u64)index,
            .asset_path = lesson_artwork[artwork], .alt_text = row.title,
            .bounds = Rectangle.{content.x, content.y, content.width, cast(float32)picture_h},
            .radius = cast(float32)Scale(8), .smooth = true,
            .tint = ifx row.locked then cast(u32)0xffffff50 else cast(u32)0xffffffff,
            .fit = Image.ImageFit.ImageFitCover})
        if row.locked {
            center := Vector2.{content.x + content.width * 0.5,
                content.y + cast(float32)picture_h * 0.5}
            unit := cast(float32)Scale(1)
            unused Box.Draw(course.session, Box.Props.{
                .bounds = Rectangle.{center.x - 24.0 * unit, center.y - 24.0 * unit, 48.0 * unit, 48.0 * unit},
                .fill = Color.{28, 36, 40, 224}, .radius = 12.0 * unit})
            unused Shape.Ring(course.session, Shape.RingProps.{
                .center = Vector2.{center.x, center.y - 5.0 * unit},
                .inner_radius = 5.0 * unit, .outer_radius = 7.0 * unit,
                .start_angle = 180.0, .end_angle = 360.0, .color = Color.{255, 255, 255, 255}})
            unused Box.Draw(course.session, Box.Props.{
                .bounds = Rectangle.{center.x - 10.0 * unit, center.y - 5.0 * unit, 20.0 * unit, 17.0 * unit},
                .fill = Color.{255, 255, 255, 255}, .radius = 3.0 * unit})
        }
    }
    content.y += cast(float32)(picture_h + Scale(12))
    heading_h := ParagraphHeight(row.title, cast(s32)content.width, course.font + Scale(2))
    subtitle_h := ParagraphHeight(row.subtitle, cast(s32)content.width, course.font)
    Section(row.title, Rectangle.{content.x, content.y, content.width, cast(float32)heading_h})
    Text.Draw(course.session, Text.Props.{.text = row.subtitle, .size = course.font,
            .bounds = Rectangle.{content.x, content.y + cast(float32)(heading_h + Scale(6)),
                content.width, cast(float32)subtitle_h}})
    Text.Draw(course.session, Text.Props.{.text = row.detail, .size = course.small_font,
            .class_name = course.muted_class,
            .bounds = Rectangle.{content.x, bounds.y + bounds.height - cast(float32)Scale(36),
                content.width, cast(float32)Scale(24)}})
    if activated != 0 {
        if row.kind == PRACTICE_COURSE_FOUNDATION {
            course.lesson = index
            course.item_scroll = 0
        } else {
            Play(row.first)
        }
    }
}

PlanLessonGroup :: (start: s32, count: s32, columns: s32, width: s32, y: s32) -> s32 {
    gap := Scale(12)
    card_w := (width - gap * (columns - 1)) / columns
    offset: s32 = 0
    while offset < count {
        row_count := count - offset
        if row_count > columns {
            row_count = columns
        }
        row_h: s32 = 0
        for column: cast(s32)0..row_count - 1 {
            index := lesson_indices[start + offset + column]
            height := LessonHeight(course_lessons[index], card_w)
            if height > row_h {
                row_h = height
            }
        }
        for column: cast(s32)0..row_count - 1 {
            index := lesson_indices[start + offset + column]
            lesson_bounds[index] = Bounds(column * (card_w + gap), y, card_w, row_h)
        }
        offset += row_count
        y += row_h + gap
    }
    return y
}

Lessons :: (bounds: Rectangle) {
    width := cast(s32)bounds.width - Scale(10)
    columns: s32 = ifx width >= Scale(640) then 3 else 2
    lesson_total = 0
    // Foundations is a free card at the beginning of the same gallery.
    for index: cast(s32)0..course.lesson_count - 1 {
        if course_lessons[index].kind == PRACTICE_COURSE_FOUNDATION {
            course_lessons[index].title = Locale("tai_chi_foundations")
            lesson_indices[lesson_total] = index
            lesson_artwork_indices[index] = 0
            lesson_total += 1
            break
        }
    }
    artwork: s32 = 0
    full: s32 = -1
    for index: cast(s32)0..course.lesson_count - 1 {
        row := course_lessons[index]
        if row.kind == PRACTICE_COURSE_LESSON {
            lesson_indices[lesson_total] = index
            lesson_artwork_indices[index] = artwork
            lesson_total += 1
            artwork += 1
        } else if row.kind == PRACTICE_COURSE_FULL {
            full = index
        }
    }
    if full >= 0 {
        lesson_indices[lesson_total] = full
        lesson_artwork_indices[full] = 7
        lesson_total += 1
    }
    content_height := PlanLessonGroup(0, lesson_total, columns, width, 0)
    scrolled := Scroll.Draw(course.session, Scroll.Props.{.key = Layout.KeyHash("inbe/tai_chi/lessons"),
            .bounds = bounds, .content_height = content_height, .scroll_offset = course.lesson_scroll})
    course.lesson_scroll = scrolled.scroll_offset
    if !scrolled.opened {
        return
    }
    for position: cast(s32)0..lesson_total - 1 {
        index := lesson_indices[position]
        card := lesson_bounds[index]
        card.x += scrolled.content.x
        card.y += scrolled.content.y
        if card.y + card.height >= bounds.y && card.y <= bounds.y + bounds.height {
            LessonCard(card, index, lesson_artwork_indices[index], course_lessons[index])
        }
    }
    unused End(course.session)
}

Foundations :: (bounds: Rectangle) {
    gap := Scale(10)
    if Button.Draw(course.session, Button.Props.{.key = Layout.KeyHash("inbe/tai_chi/back"),
            .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)Scale(44)},
            .label = Locale("back_button"), .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        course.lesson = -1
    }
    bounds.y += cast(float32)(Scale(44) + gap)
    bounds.height -= cast(float32)(Scale(44) + gap)
    content_h: s32 = 0
    for index: cast(s32)0..course.lesson_count - 1 {
        row := course_lessons[index]
        if row.kind == PRACTICE_COURSE_FOUNDATION {
            content_h += ParagraphHeight(row.title, cast(s32)bounds.width - Scale(12), course.font + Scale(2)) + gap +
                row.count * (Scale(64) + gap) + gap
        }
    }
    scrolled := Scroll.Draw(course.session, Scroll.Props.{.key = Layout.KeyHash("inbe/tai_chi/foundation-list"),
            .bounds = bounds, .content_height = content_h, .scroll_offset = course.item_scroll})
    course.item_scroll = scrolled.scroll_offset
    if !scrolled.opened {
        return
    }
    y := scrolled.content.y
    width := bounds.width - cast(float32)Scale(12)
    for index: cast(s32)0..course.lesson_count - 1 {
        row := course_lessons[index]
        if row.kind != PRACTICE_COURSE_FOUNDATION {
            continue
        }
        heading_h := ParagraphHeight(row.title, cast(s32)width, course.font + Scale(2))
        Section(row.title, Rectangle.{scrolled.content.x, y, width, cast(float32)heading_h})
        y += cast(float32)(heading_h + gap)
        for offset: cast(s32)0..row.count - 1 {
            item := row.first + offset
            if y + cast(float32)Scale(64) >= bounds.y && y <= bounds.y + bounds.height {
                detail := ReadPracticeCourseRowHost(false, item)
                if Button.Draw(course.session, Button.Props.{
                        .key = Layout.KeyHash("inbe/tai_chi/foundation") + cast(u64)item,
                        .bounds = Rectangle.{scrolled.content.x, y, width, cast(float32)Scale(64)},
                        .label = detail.title, .detail = detail.detail, .selected = detail.done,
                        .content_alignment = cast(ContentAlignment)ContentAlignmentStart,
                        .tone = cast(ButtonTone)ButtonToneNeutral,
                        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
                    Play(item)
                }
            }
            y += cast(float32)(Scale(64) + gap)
        }
        y += cast(float32)gap
    }
    unused End(course.session)
}

Course :: () {
    width := course.view_width - Scale(32)
    if width > Scale(940) {
        width = Scale(940)
    }
    height := course.view_height - Scale(48)
    if height > Scale(740) {
        height = Scale(740)
    }
    title := Locale(ifx course.lesson < 0 then "tai_chi_course_title" else "tai_chi_foundations")
    frame := Modal.Draw(course.session, Modal.Props.{.key = Layout.KeyHash("inbe/tai_chi/modal"),
            .title = title, .width = width, .height = height, .scale = course.scale,
            .title_at_start = true, .strong_title = true, .dismiss_on_outside = true,
            .has_right_action = true, .right_label = Locale("close_button")})
    if frame.dismissed || frame.right_clicked {
        course.action = PRACTICE_COURSE_CLOSE
        return
    }
    if !frame.opened {
        return
    }
    bounds := frame.layout.content
    if course.lesson < 0 {
        if !course.owned {
            intro := Locale("tai_chi_course_intro")
            intro_h := ParagraphHeight(intro, cast(s32)bounds.width, course.font)
            Text.Draw(course.session, Text.Props.{.text = intro, .size = course.font,
                    .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)intro_h}})
            bounds.y += cast(float32)(intro_h + Scale(12))
            bounds.height -= cast(float32)(intro_h + Scale(12))
        }
        Text.Draw(course.session, Text.Props.{.text = course.progress, .size = course.small_font,
                .class_name = course.muted_class,
                .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)Scale(28)}})
        bounds.y += cast(float32)Scale(36)
        bounds.height -= cast(float32)Scale(36)
        Lessons(bounds)
    } else {
        Foundations(bounds)
    }
    unused End(course.session)
}

PracticeCourseView :: (message: PracticeMessage) -> PracticeMessage {
    course = ReadPracticeCourseHost()
    course.action = PRACTICE_COURSE_NONE
    course.value = 0
    if course.lesson_count < 1 || course.lesson_count > COURSE_LESSON_LIMIT {
        message.succeeded = false
        return message
    }
    for index: cast(s32)0..course.lesson_count - 1 {
        course_lessons[index] = ReadPracticeCourseRowHost(true, index)
    }
    if course.lesson < -1 || course.lesson >= course.lesson_count {
        course.lesson = -1
    }
    Course()
    WritePracticeCourseHost(course)
    message.succeeded = true
    return message
}
