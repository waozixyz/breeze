// One boundary for the public course preview and runtime item access.
TAI_CHI_FREE_FORM_LESSONS :: 3

TaiChiItemFree :: (id: string) -> bool {
    foundation := "foundations/"
    if id.count > foundation.count && id[0:foundation.count] == foundation {
        return true
    }
    prefix := "lesson-"
    if id.count <= prefix.count + 2 || id[0:prefix.count] != prefix {
        return false
    }
    number := cast(s32)id[prefix.count] - cast(s32)48
    return number >= 1 && number <= TAI_CHI_FREE_FORM_LESSONS &&
        id[prefix.count + 1] == cast(u8)47
}
