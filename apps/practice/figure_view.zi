// One bounded host effect per figure keeps the native mesh caches and
// avoids sending hundreds of mesh records over the portable UI boundary.
#import, file "../../src/apps/practice_ui_types.zi";
host_api :: #system_library "host_api";
DrawPracticeFigureHost :: (request: PracticeFigureRequest) #foreign host_api;

PracticeFigure :: (request: PracticeFigureRequest) {
    DrawPracticeFigureHost(request)
}
