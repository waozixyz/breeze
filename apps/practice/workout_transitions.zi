// The custom timeline is sampled directly. Neither the pose nor the equipment
// in a frame depends on any previously rendered frame.
#import, file "workout_sequence.zi";
#import, file "workout_moves.zi";
#import, file "workout_rules.zi";
#import "math"
#import, file "../../src/practices/tai_chi/tai_chi_math.zi";
#import, file "../../src/practices/tai_chi/tai_chi_solve.zi";
#import, file "../../src/practices/tai_chi/tai_chi_rules.zi";

WorkoutEase :: (u: float64) -> float64 {
    t := TaiChiClamp(u, 0.0, 1.0)
    return t * t * t * (10.0 + t * (-15.0 + 6.0 * t))
}

WorkoutEaseRange :: (time: float64, start: float64, end: float64) -> float64 {
    return WorkoutEase((time - start) / (end - start))
}

WorkoutCustomMirrorLead :: (block: WorkoutBlock) -> bool {
    if block.exercise == WORKOUT_STEP_UPS || block.exercise == WORKOUT_LUNGES || block.exercise == WORKOUT_HIGH_KNEES {
        return block.variant == WORKOUT_CUSTOM_LEFT
    }
    return block.exercise == WORKOUT_PUSH_UP_ROTATION && block.variant == WORKOUT_CUSTOM_RIGHT
}

WorkoutCustomCycleCount :: (block: WorkoutBlock) -> s32 {
    if block.exercise == WORKOUT_HIGH_KNEES {
        return ifx block.variant == WORKOUT_CUSTOM_ORDINARY then 4 else 2
    }
    if block.variant != WORKOUT_CUSTOM_LEFT && block.variant != WORKOUT_CUSTOM_RIGHT {
        return WorkoutKeyCount(block.exercise)
    }
    if block.exercise == WORKOUT_PUSH_UP_ROTATION || block.exercise == WORKOUT_STEP_UPS {
        return 4
    }
    return 2
}

WorkoutCustomKey :: (block: WorkoutBlock, index: s32) -> WorkoutKey {
    exercise := block.exercise
    if exercise == WORKOUT_HIGH_KNEES {
        if index % 2 == 0 {
            return WorkoutKeyOf(WorkoutStanding(), 30, 330)
        }
        key := WorkoutKeyframe(exercise, ifx index == 3 || WorkoutCustomMirrorLead(block) then 1 else 0)
        return WorkoutKeyOf(key.pose, 40, 330)
    }
    if exercise == WORKOUT_SIDE_PLANK {
        pose := WorkoutSidePlank(index == 1)
        if block.variant == WORKOUT_CUSTOM_LEFT {
            pose = WorkoutMirror(pose)
        }
        return WorkoutKeyOf(pose, ifx index == 0 then 0 else 2400, 1300)
    }
    frame := index
    if block.variant == WORKOUT_CUSTOM_RIGHT && WorkoutGentleExercise(exercise) && index == 1 {
        frame = 3
    }
    key := WorkoutKeyframe(exercise, frame)
    if WorkoutCustomMirrorLead(block) {
        key.pose = WorkoutMirror(key.pose)
    }
    if exercise == WORKOUT_PLANK {
        WorkoutHandsAt(*key.pose, WORKOUT_AT_WORLD, 0.11, 0.045, 0.595)
        WorkoutFeet(*key.pose, 0.09, -0.935, 0.0, -75.0, 0.0)
    }
    if block.variant == WORKOUT_CUSTOM_SHALLOW && index == 1 {
        upright := WorkoutKeyframe(exercise, 0)
        rig := WorkoutRig()
        key.pose = WorkoutBlend(*upright.pose, *key.pose, 0.46, *rig)
    }
    return key
}

// Preserves stationary foot contact in world space even while the pelvis
// turns. A foot first lifts, then travels, then lands. Feet already elevated
// on a bench use the same swing when moving between support surfaces.
WorkoutPathFoot :: (from: TaiChiFootPose, to: TaiChiFootPose, from_yaw: float64,
    to_yaw: float64, body_yaw: float64, u: float64, clearance: bool, max_clearance: float64) -> TaiChiFootPose {
    a := from
    b := to
    a.yaw += from_yaw
    b.yaw += to_yaw
    pose := WorkoutLerpFoot(a, b, WorkoutEase(u))
    distance := TaiChiHypot(b.x - a.x, b.z - a.z)
    if clearance && (distance > 0.002 || TaiChiAbs(WorkoutLerpAngle(0.0, b.yaw - a.yaw, 1.0)) > 0.25 ||
        TaiChiAbs(b.lift - a.lift) > 0.002) {
        travel := WorkoutEaseRange(u, 0.20, 0.78)
        peak := TaiChiMax(a.lift, b.lift) + TaiChiMin(max_clearance, 0.035 + distance * 0.15)
        pose.x = a.x + (b.x - a.x) * travel
        pose.z = a.z + (b.z - a.z) * travel
        pose.yaw = WorkoutLerpAngle(a.yaw, b.yaw, travel)
        if u < 0.35 {
            pose.lift = a.lift + (peak - a.lift) * WorkoutEaseRange(u, 0.0, 0.35)
        } else if u > 0.60 {
            pose.lift = peak + (b.lift - peak) * WorkoutEaseRange(u, 0.60, 1.0)
        } else {
            pose.lift = peak
        }
    }
    pose.yaw -= body_yaw
    return pose
}

// Transport the keyed knee and elbow planes with their limbs. Blending a
// pole in trunk space can make it cross the limb axis; the IK solver then
// chooses the opposite bend even though the joint targets are continuous.
WorkoutProjectPole :: (pole: TaiChiVector3, axis: TaiChiVector3) -> TaiChiVector3 {
    tangent := TaiChiAddScaled3(pole, axis, -TaiChiDot3(pole, axis))
    if TaiChiLengthSquared3(tangent) < 0.00000001 {
        tangent = TaiChiAddScaled3(TaiChiV3(0.0, 0.0, 1.0), axis, -axis.z)
    }
    return TaiChiNormalize3(tangent)
}

WorkoutTransportPole :: (direction: TaiChiVector3, from_axis: TaiChiVector3, to_axis: TaiChiVector3) -> TaiChiVector3 {
    cross := TaiChiCross3(from_axis, to_axis)
    span := 1.0 + TaiChiDot3(from_axis, to_axis)
    if span <= 0.00001 {
        return WorkoutProjectPole(direction, to_axis)
    }
    first := TaiChiCross3(cross, direction)
    return TaiChiAddScaled3(TaiChiAdd3(direction, first), TaiChiCross3(cross, first), 1.0 / span)
}

WorkoutBendBetween :: (a: TaiChiVector3, b: TaiChiVector3, a_pole: TaiChiVector3, b_pole: TaiChiVector3,
    axis: TaiChiVector3, u: float64) -> TaiChiVector3 {
    first := WorkoutProjectPole(a_pole, a)
    last := WorkoutTransportPole(WorkoutProjectPole(b_pole, b), b, a)
    angle := Atan2(TaiChiDot3(a, TaiChiCross3(first, last)), TaiChiDot3(first, last))
    swing := TaiChiRotate(first, TaiChiAxisAngle(a, angle * u))
    return WorkoutTransportPole(swing, a, axis)
}

WorkoutPlacedFoot :: (pose: *WorkoutPose, side: s32, rig: *TaiChiRig) -> TaiChiPlacedFoot {
    foot := pose.feet[side]
    foot.x /= rig.scale
    foot.z /= rig.scale
    foot.lift /= rig.scale
    foot.yaw = (foot.yaw + pose.yaw) * TAI_CHI_DEGREE
    foot.pitch *= TAI_CHI_DEGREE
    return TaiChiPlaceFoot(foot, rig)
}

WorkoutLegAxis :: (pose: *WorkoutPose, trunk: *WorkoutTrunk, side: s32, rig: *TaiChiRig) -> TaiChiVector3 {
    placed := WorkoutPlacedFoot(pose, side, rig)
    hip := TaiChiAdd3(pose.pelvis, TaiChiHipOffset(side, trunk.pelvis_quat, rig))
    return TaiChiNormalize3(TaiChiSub3(placed.ankle, hip))
}

WorkoutBonePole :: (pole: TaiChiVector3, orientation: TaiChiQuaternion, side: s32) -> TaiChiVector3 {
    return TaiChiRotate(TaiChiV3(pole.x * TaiChiSideSign(side), pole.y, pole.z), orientation)
}

WorkoutPathBend :: (pose: *WorkoutPose, start: *WorkoutPose, end: *WorkoutPose, u: float64, rig: *TaiChiRig) {
    a := WorkoutTrunkFor(start, rig)
    b := WorkoutTrunkFor(end, rig)
    basis := WorkoutTrunkFor(pose, rig)
    for side: cast(s32)0..1 {
        leg := WorkoutBendBetween(WorkoutLegAxis(start, *a, side, rig), WorkoutLegAxis(end, *b, side, rig),
            WorkoutBonePole(start.knees[side], a.pelvis_quat, side), WorkoutBonePole(end.knees[side], b.pelvis_quat, side),
            WorkoutLegAxis(pose, *basis, side, rig), u)
        pose.knees[side] = WorkoutBonePole(leg, WorkoutConjugate(basis.pelvis_quat), 0)
        pose.knees[side].x *= TaiChiSideSign(side)
        initial_hand := WorkoutHandTarget(start, *a, side, rig)
        final_hand := WorkoutHandTarget(end, *b, side, rig)
        hand := WorkoutHandTarget(pose, *basis, side, rig)
        arm := WorkoutBendBetween(TaiChiNormalize3(TaiChiSub3(initial_hand, a.shoulders[side])),
            TaiChiNormalize3(TaiChiSub3(final_hand, b.shoulders[side])),
            WorkoutBonePole(start.hands[side].pole, a.chest_quat, side), WorkoutBonePole(end.hands[side].pole, b.chest_quat, side),
            TaiChiNormalize3(TaiChiSub3(hand, basis.shoulders[side])), u)
        pose.hands[side].pole = WorkoutBonePole(arm, WorkoutConjugate(basis.chest_quat), 0)
        pose.hands[side].pole.x *= TaiChiSideSign(side)
    }
}

WorkoutPathPose :: (from: *WorkoutPose, to: *WorkoutPose, u: float64, rig: *TaiChiRig, foot_clearance: bool) -> WorkoutPose {
    if u <= 0.0 {
        return from.*
    }
    if u >= 1.0 {
        return to.*
    }
    eased := WorkoutEase(u)
    pose := WorkoutBlend(from, to, eased, rig)
    maximum_clearance := ifx TaiChiMax(from.pelvis.y, to.pelvis.y) < 0.43 then 0.065 else 0.13
    for side: cast(s32)0..1 {
        pose.feet[side] = WorkoutPathFoot(from.feet[side], to.feet[side], from.yaw, to.yaw, pose.yaw, u, foot_clearance, maximum_clearance)
        if from.hands[side].mode != to.hands[side].mode {
            a := WorkoutTrunkFor(from, rig)
            b := WorkoutTrunkFor(to, rig)
            first := WorkoutHandTarget(from, *a, side, rig)
            last := WorkoutHandTarget(to, *b, side, rig)
            pose.hands[side].mode = WORKOUT_AT_WORLD
            pose.hands[side].at = TaiChiLerp3(first, last, eased)
        }
    }
    WorkoutPathBend(*pose, from, to, eased, rig)
    return pose
}

WorkoutCustomActivePose :: (block: WorkoutBlock, time_ms: s64, rig: *TaiChiRig) -> WorkoutPose {
    length := cast(s64)block.seconds * 1000
    count := WorkoutCustomCycleCount(block)
    first := WorkoutCustomKey(block, 0).pose
    if time_ms <= 0 || time_ms >= length {
        return first
    }
    if count == 1 {
        // Breathe while holding the contact points. The envelope brings the
        // pose back to the same position and velocity at the end of the hold.
        breathing := first
        WorkoutBreathe(*breathing, time_ms)
        amount := WorkoutEaseRange(cast(float64)time_ms, 0.0, 700.0) *
            WorkoutEaseRange(cast(float64)(length - time_ms), 0.0, 700.0)
        return WorkoutBlend(*first, *breathing, amount, rig)
    }
    period: s32 = 0
    for index: cast(s32)0..count - 1 {
        key := WorkoutCustomKey(block, index)
        period += key.hold_ms + key.move_ms
    }
    cycles := (length + period / 2) / period
    if cycles < 1 {
        cycles = 1
    }
    t := cast(float64)((time_ms * cycles * period) % length) / cast(float64)length
    // Fractional phase is retained when fitting whole repetitions into a
    // block. This keeps both active endpoints in a settled support pose.
    t += cast(float64)((time_ms * cycles * period / length) % period)
    for index: cast(s32)0..count - 1 {
        key := WorkoutCustomKey(block, index)
        if t < cast(float64)key.hold_ms {
            return key.pose
        }
        t -= cast(float64)key.hold_ms
        if t < cast(float64)key.move_ms {
            next := WorkoutCustomKey(block, (index + 1) % count)
            u := t / cast(float64)key.move_ms
            jump := block.exercise == WORKOUT_JUMPING_JACKS
            pose := WorkoutPathPose(*key.pose, *next.pose, u, rig, !jump)
            if jump {
                clearance := Sin(u * TAI_CHI_PI)
                WorkoutLift(*pose, WorkoutHop(block.exercise) * clearance * clearance)
            }
            return pose
        }
        t -= cast(float64)key.move_ms
    }
    return first
}

WorkoutAccessFeet :: (pose: *WorkoutPose, feet: *WorkoutPose, side: s32) {
    pose.feet[side] = feet.feet[side]
    pose.feet[side].yaw += feet.yaw - pose.yaw
}

// Access routes all begin at the same standing position. Numbered keys are
// named by their support action below; reversing a route gives the supported
// way out. The same anchors serve as active entry and exit poses.
WorkoutAccessKey :: (block: WorkoutBlock, anchor: *WorkoutPose, index: s32) -> WorkoutPose {
    pose := WorkoutStanding()
    if index <= 0 {
        return pose
    }
    support := WorkoutBlockSupport(block.exercise)
    if support == WORKOUT_SUPPORT_UPRIGHT {
        if index >= 2 {
            return anchor.*
        }
        WorkoutAccessFeet(*pose, anchor, 0)
        pose.pelvis.x = 0.045
        pose.pelvis.z = anchor.pelvis.z * 0.5
        pose.pelvis.y = 0.85
        return pose
    }
    if support == WORKOUT_SUPPORT_WALL {
        return WorkoutWallSetupKey(*pose, anchor, index)
    }
    if support == WORKOUT_SUPPORT_HANDS {
        if index >= 7 {
            return anchor.*
        }
        // Step forward, squat, place both hands, then step each foot back.
        crouch_z := anchor.hands[0].at.z - 0.27
        pose.pelvis.z = crouch_z * 0.5
        WorkoutFoot(*pose, 0, 0.10, crouch_z, 7.0, 0.0, 0.0)
        if index == 1 {
            return pose
        }
        WorkoutFoot(*pose, 1, -0.10, crouch_z - 0.08, -7.0, 0.0, 0.0)
        pose.pelvis = TaiChiV3(0.0, 0.6, crouch_z - 0.04)
        pose.lean = 27.0
        WorkoutKnees(*pose, 0.52, 0.0, 0.85)
        if index == 2 {
            return pose
        }
        pose.pelvis = TaiChiV3(0.0, 0.28, crouch_z - 0.19)
        pose.lean = 54.0
        WorkoutKnees(*pose, 0.55, 0.0, 0.80)
        pose.hands = anchor.hands
        if index == 3 {
            return pose
        }
        WorkoutAccessFeet(*pose, anchor, 1)
        pose.pelvis.z = -0.19
        pose.lean = 67.0
        if index == 4 {
            return pose
        }
        WorkoutAccessFeet(*pose, anchor, 0)
        pose.pelvis.y = 0.40
        pose.pelvis.z = anchor.pelvis.z
        pose.lean = 72.0
        if index == 5 {
            return pose
        }
        rig := WorkoutRig()
        return WorkoutBlend(*pose, anchor, 0.64, *rig)
    }
    if support == WORKOUT_SUPPORT_BACK || support == WORKOUT_SUPPORT_BENCH {
        last := ifx support == WORKOUT_SUPPORT_BACK then 8 else 6
        if index >= last {
            return anchor.*
        }
        // Get both feet ahead of the hips before lowering. For crunches,
        // plant hands behind the seat, recline onto the back, then release.
        WorkoutAccessFeet(*pose, anchor, 0)
        pose.pelvis = TaiChiV3(0.025, 0.82, anchor.feet[0].z * 0.37)
        if index == 1 {
            return pose
        }
        WorkoutAccessFeet(*pose, anchor, 1)
        pose.pelvis = TaiChiV3(0.0, 0.78, anchor.feet[0].z * 0.74)
        if index == 2 {
            return pose
        }
        pose.pelvis = TaiChiV3(0.0, 0.57, anchor.feet[0].z * 0.52)
        pose.lean = 31.0
        WorkoutHandsAt(*pose, WORKOUT_AT_ARM, 70.0, 12.0, 0.95)
        if index == 3 {
            return pose
        }
        if support == WORKOUT_SUPPORT_BENCH {
            pose.pelvis = TaiChiV3(0.0, 0.51, -0.10)
            pose.lean = -3.0
            pose.hands = anchor.hands
            if index == 5 {
                pose.pelvis.z = -0.16
                pose.pelvis.y = 0.53
                pose.lean = 0.0
            }
            return pose
        }
        pose.pelvis = TaiChiV3(0.0, 0.138, 0.115)
        pose.lean = -25.0
        WorkoutHandsAt(*pose, WORKOUT_AT_WORLD, 0.24, 0.045, -0.17)
        WorkoutFlatHands(*pose, 1.0)
        if index == 4 {
            return pose
        }
        pose.pelvis = TaiChiV3(0.0, 0.12, 0.04)
        pose.lean = -29.0
        if index == 5 {
            return pose
        }
        pose.pelvis = anchor.pelvis
        pose.lean = -55.0
        if index == 6 {
            return pose
        }
        pose.lean = -80.0
        return pose
    }
    // Side plank: lower through a side-facing squat, set the lower hand on
    // the mat and extend the lower leg before stacking the upper foot.
    if index >= 10 {
        return anchor.*
    }
    WorkoutFoot(*pose, 1, -0.27, 0.0, -12.0, 0.0, 0.0)
    pose.pelvis = TaiChiV3(-0.07, 0.79, 0.0)
    if index >= 2 {
        pose.pelvis = TaiChiV3(-0.08, 0.57, -0.07)
        pose.lean = 25.0
        pose.bend = -15.0
        WorkoutHandsAt(*pose, WORKOUT_AT_ARM, 56.0, 52.0, 0.96)
    }
    if index >= 3 {
        pose.pelvis = TaiChiV3(-0.17, 0.30, -0.035)
        pose.lean = 14.0
        pose.bend = -47.0
        pose.hands[1].mode = WORKOUT_AT_WORLD
        pose.hands[1].at = TaiChiV3(-0.60, 0.035, 0.0)
        pose.hands[1].flat = 1.0
    }
    if index >= 4 {
        WorkoutFoot(*pose, 0, 0.35, 0.10, 8.0, 0.0, 0.0)
    }
    if index >= 5 {
        WorkoutFoot(*pose, 1, 0.05, -0.29, -5.0, 0.0, 0.0)
        pose.bend = -55.0
    }
    if index >= 6 {
        WorkoutFoot(*pose, 1, 0.39, -0.12, 0.0, 0.0, 0.0)
        pose.bend = -62.0
    }
    if index >= 7 {
        WorkoutFoot(*pose, 1, 0.59, 0.0, 0.0, 0.0, 0.0)
        pose.bend = -70.0
    }
    if index >= 8 {
        WorkoutFoot(*pose, 0, 0.66, 0.0, 0.0, 0.0, 0.16)
        pose.bend = -74.0
    }
    if index >= 9 {
        pose.pelvis = TaiChiV3(-0.16, 0.32, 0.0)
        pose.lean = 1.0
    }
    return ifx block.variant == WORKOUT_CUSTOM_LEFT then WorkoutMirror(pose) else pose
}

WorkoutAccessPose :: (block: WorkoutBlock, time_ms: s64, rig: *TaiChiRig) -> WorkoutPose {
    start := WorkoutCustomKey(block, 0).pose
    seconds := WorkoutAccessSeconds(block.exercise)
    if time_ms <= 0 {
        return WorkoutStanding()
    }
    if time_ms >= seconds * 1000 {
        return start
    }
    index := cast(s32)(time_ms / 1000)
    from := WorkoutAccessKey(block, *start, index)
    to := WorkoutAccessKey(block, *start, index + 1)
    u := cast(float64)(time_ms % 1000) / 1000.0
    return WorkoutPathPose(*from, *to, u, rig, true)
}

WorkoutCustomFrame :: struct {
    pose: WorkoutPose
    framing: TaiChiFraming
    prop: s32
    prop_opacity: float64
}

WorkoutCustomFraming :: (from: s32, to: s32, u: float64) -> TaiChiFraming {
    a := WorkoutFramingFor(from)
    b := WorkoutFramingFor(to)
    value := a
    value.camera.yaw = a.camera.yaw + (b.camera.yaw - a.camera.yaw) * u
    value.camera.tilt = a.camera.tilt + (b.camera.tilt - a.camera.tilt) * u
    value.camera.center = TaiChiLerp3(a.camera.center, b.camera.center, u)
    value.view_height = a.view_height + (b.view_height - a.view_height) * u
    value.view_center = a.view_center + (b.view_center - a.view_center) * u
    return value
}

WorkoutSequenceFrame :: (sequence: *WorkoutSequence, step: WorkoutStep, rig: *TaiChiRig) -> WorkoutCustomFrame {
    if step.index < 0 || step.index >= sequence.count {
        return WorkoutCustomFrame.{.pose = WorkoutStanding(), .framing = WorkoutFramingFor(WORKOUT_JUMPING_JACKS), .prop = -1}
    }
    next := sequence.blocks[step.index]
    if step.phase == WORKOUT_PHASE_WORK {
        return WorkoutCustomFrame.{.pose = WorkoutCustomActivePose(next, cast(s64)step.elapsed_ms, rig),
            .framing = WorkoutFramingFor(next.exercise), .prop = next.exercise, .prop_opacity = 1.0}
    }
    prior := ifx step.index > 0 then sequence.blocks[step.index - 1] else WorkoutBlock.{.exercise = -1}
    departure := ifx prior.exercise < 0 then 0 else WorkoutAccessSeconds(prior.exercise) * 1000
    arrival := step.length_ms - WorkoutAccessSeconds(next.exercise) * 1000
    time := step.elapsed_ms
    if time < departure {
        return WorkoutCustomFrame.{.pose = WorkoutAccessPose(prior, cast(s64)(departure - time), rig),
            .framing = WorkoutFramingFor(prior.exercise), .prop = prior.exercise, .prop_opacity = 1.0}
    }
    if time >= arrival {
        return WorkoutCustomFrame.{.pose = WorkoutAccessPose(next, cast(s64)(time - arrival), rig),
            .framing = WorkoutFramingFor(next.exercise), .prop = next.exercise, .prop_opacity = 1.0}
    }
    blend := cast(float64)(time - departure) / cast(float64)(arrival - departure)
    prop := ifx blend < 0.5 then prior.exercise else next.exercise
    opacity := ifx blend < 0.5 then 1.0 - WorkoutEase(blend * 2.0) else WorkoutEase((blend - 0.5) * 2.0)
    return WorkoutCustomFrame.{.pose = WorkoutStanding(),
        .framing = WorkoutCustomFraming(prior.exercise, next.exercise, WorkoutEase(blend)),
        .prop = prop, .prop_opacity = opacity}
}
