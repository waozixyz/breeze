using SemanticKind;
using ButtonTone;
using ButtonEmphasis;
using ContentAlignment;
using TextAlign;
using Text.Wrap;
host_api :: #system_library "host_api";
ReadPracticeCourseHost :: () -> PracticeCourseFrame #foreign host_api;
WritePracticeCourseHost :: (frame: PracticeCourseFrame) #foreign host_api;
ReadPracticeCourseRowHost :: (lesson: bool, index: s32) -> PracticeCourseRow #foreign host_api;
CourseLocaleHost :: (key: string) -> string #foreign host_api;
course: PracticeCourseFrame;
COURSE_LESSON_LIMIT :: 32
course_lessons: [COURSE_LESSON_LIMIT]PracticeCourseRow;

Scale :: (pixels: s32) -> s32 {
    return ScalePixels(pixels, course.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)height}
}

Locale :: (key: string) -> string {
    return CourseLocaleHost(key)
}

ParagraphHeight :: (text: string, width: s32, font: s32) -> s32 {
    return TextHeight(course.session, Text.Props.{.text = text, .size = font,
            .bounds = Bounds(0, 0, width, 0), .line_gap = Scale(3)})
}



Play :: (item: s32) {
    course.action = PRACTICE_COURSE_PLAY
    course.value = item
}

lesson_artwork: [14]string = .[
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-1.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-2.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-3.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-4.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-5.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-6.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-7.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/lesson-8.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-posture.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-warm-up.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-standing-meditation.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-stances.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-stepping.webp",
"assets/practices/shared/tai-chi-gallery/thumbnails/foundation-hand-shapes.webp"];
foundations_open: bool;
lesson_bounds: [COURSE_LESSON_LIMIT]Rectangle;
lesson_indices: [COURSE_LESSON_LIMIT]s32;
lesson_total: s32;
lesson_artwork_indices: [COURSE_LESSON_LIMIT]s32;

LessonHeight :: (row: PracticeCourseRow, width: s32) -> s32 {
    text_width := width - Scale(24)
    return Scale(80) + text_width * 3 / 4 +
    ParagraphHeight(row.title, text_width, course.font + Scale(2)) +
    ParagraphHeight(row.subtitle, text_width, course.font)
}



PlanLessonGroup :: (start: s32, count: s32, columns: s32, width: s32, y: s32) -> s32 {
    gap := Scale(12)
    card_w := (width - gap * (columns - 1)) / columns
    offset: s32 = 0
    while offset < count {
        row_count := count - offset
        if row_count > columns {
            row_count = columns
        }
        row_h: s32 = 0
        for column: cast(s32)0..row_count - 1 {
            index := lesson_indices[start + offset + column]
            height := LessonHeight(course_lessons[index], card_w)
            if height > row_h {
                row_h = height
            }
        }
        for column: cast(s32)0..row_count - 1 {
            index := lesson_indices[start + offset + column]
            lesson_bounds[index] = Bounds(column * (card_w + gap), y, card_w, row_h)
        }
        offset += row_count
        y += row_h + gap
    }
    return y
}









PracticeCourseView :: (message: PracticeMessage) -> PracticeMessage {
    course = ReadPracticeCourseHost()
    course.action = PRACTICE_COURSE_NONE
    course.value = 0
    if course.lesson_count < 1 || course.lesson_count > COURSE_LESSON_LIMIT {
        message.succeeded = false
        return message
    }
    for index: cast(s32)0..course.lesson_count - 1 {
        course_lessons[index] = ReadPracticeCourseRowHost(true, index)
    }
    if course.lesson < -1 || course.lesson >= course.lesson_count {
        course.lesson = -1
    }
    if course.lesson >= 0 && course_lessons[course.lesson].kind != PRACTICE_COURSE_FOUNDATION {
        course.lesson = -1
    }
    Course()
    WritePracticeCourseHost(course)
    message.succeeded = true
    return message
}
