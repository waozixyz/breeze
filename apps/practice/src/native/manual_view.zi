#import "manual_view_ui"
#import, file "figure_view.zi";
// A practice's manual: a few pages, each with a picture or a small preview,
// its title with "Step 1 of 4", and what to know, turned with Back and Next,
// a swipe or the arrow keys; the last page's Next starts the practice. The
// Wim Hof manual changes the breathing speed on its breathing page. The host
// keeps the page, the settings and what closing or starting does.
#import "session"
#import "geometry"
#import "vec"
#import "dpi"
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Dropdown :: #import "kryon/dropdown";
Image :: #import "kryon/image";
Layout :: #import "kryon/layout";
Progress :: #import "kryon/progress";
Scroll :: #import "kryon/scroll";
Shape :: #import "kryon/shape";
Slider :: #import "kryon/slider";
Text :: #import "kryon/text";
TitleBar :: #import "kryon/title_bar";
#import "kryon/system_clipboard"
#import "drawing_props"
#import "text_align"
#import "text_measure"
#import "control_props"
#import "swipe_props"
#import "swipe"
#import "kryon/tree"
#import, file "../../../../src/apps/practice_ui_types.zi";
#import, file "../../../../src/apps/practice_types.zi";
