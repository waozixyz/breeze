WORKOUT_EDGE_PATH :: "assets/practices/workout/flat-edge.png"

workout_elapsed_ms: s64;
workout_coverage: WorkoutCoverage;
workout_routine: s32;
// The custom routine as built, and the timeline it plays.
workout_custom_plan: WorkoutPlan;
workout_custom: WorkoutSequence;
workout_session_character: s32;
workout_voice_elapsed_ms: s32 = -1;
workout_resume_cue: [64]u8;
workout_startup: s32;
// A fresh session holds its clock at the start value until the chosen
// figure's model is on screen; a resumed one counts at once.
workout_hold_for_figure: bool;
workout_skip_initial_delta: bool;
workout_frame_carry: float64;
workout_exit_was_paused: s32;
// The phase and exercise last seen, so each change rings once.
workout_last_phase: s32 = -1;
workout_last_exercise: s32 = -1;
workout_last_index: s32 = -1;
workout_figure: TaiChiFlatFrame;
workout_props: TaiChiFlatFrame;

WorkoutActive :: (app: *InnerBreeze) -> s32 {
    return ifx app != null && app_session_screen(app) == ScreenWorkout then 1 else 0
}

WorkoutTitle :: (routine: s32) -> string {
    if routine == WORKOUT_ROUTINE_CUSTOM {
        return LocaleText("workout_custom_entry")
    }
    return ifx routine == WORKOUT_ROUTINE_SHORT then LocaleText("exercise_workout_short") else LocaleText("exercise_workout")
}

WorkoutConfigBack :: (app: *InnerBreeze) {
    app_block_current_click(app)
    PracticeConfigLeave(app, cast(s32)ModalPracticeConfig)
}

WorkoutConfigDraw :: (app: *InnerBreeze) {
    layout: PracticeSubscreenLayout
    PracticeConfigLayout(app, cast(s32)ModalPracticeConfig, AppScale(12), *layout)
    options: [1]Dropdown.Option
    bar := TitleBar.Props.{.title = LocaleText("practice_configure_button"), .height = layout.title_h,
        .has_leading_action = true, .leading_label = LocaleText("back_button")}
    if TitleBar.Draw(app.ui.session, bar, options[:0]).clicked_leading {
        WorkoutConfigBack(app)
        return
    }
    width := app.ui.view_width - Layout.PageSidePaddingFor(app.ui.view_width) * 2
    if width > AppScale(308) {
        width = AppScale(308)
    }
    height := width * 2 / 3
    if height > AppScale(188) {
        height = AppScale(188)
    }
    if height > layout.scroll_h {
        height = layout.scroll_h
    }
    if width <= 0 || height < AppScale(44) {
        return
    }
    x := (app.ui.view_width - width) / 2
    y := layout.scroll_y + (layout.scroll_h - height) / 2
    WorkoutCharacterPreview(app, Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)height})
}

WorkoutManagerOpen :: (app: *InnerBreeze) {
    WorkoutBuilderOpen()
    app_open_modal(app, cast(ModalType)ModalWorkoutManager)
}

WorkoutManagerBack :: (app: *InnerBreeze) {
    app_block_current_click(app)
    if WorkoutBuilderBack() {
        app_close_modal(app)
    }
}

WorkoutManagerDraw :: (app: *InnerBreeze) {
    title := WorkoutTitle(WORKOUT_ROUTINE_CUSTOM)
    height := app.ui.view_height - AppScale(32)
    if height > AppScale(660) {
        height = AppScale(660)
    }
    frame := Modal.Draw(app.ui.session, Modal.Props.{.id = 28900, .title = title,
        .width = AppScale(500), .height = height, .scale = MetricsScale(),
        .has_left_action = true, .left_label = LocaleText("back_button"), .strong_title = true})
    if frame.left_clicked || frame.dismissed {
        WorkoutManagerBack(app)
        return
    }
    if !frame.opened {
        return
    }
    defer { unused End(app.ui.session) }
    if WorkoutBuilderDraw(app, frame.layout.content, PracticeContentReady(EXERCISE_WORKOUT)) == WORKOUT_BUILDER_PLAY &&
    ActivityStartAllowed() && WorkoutBuilderTake(*workout_custom_plan) && WorkoutPlanExpand(*workout_custom_plan, *workout_custom) {
        WorkoutStartRoutine(app, WORKOUT_ROUTINE_CUSTOM)
    }
}

WorkoutStart :: (app: *InnerBreeze) {
    if app != null && ActivityStartAllowed() {
        if app.workout_routine == WORKOUT_ROUTINE_CUSTOM {
            WorkoutManagerOpen(app)
            return
        }
        WorkoutStartRoutine(app, app.workout_routine)
    }
}

WorkoutStartRoutine :: (app: *InnerBreeze, routine: s32) {
    workout_elapsed_ms = 0
    workout_coverage = WorkoutCoverage.{}
    workout_routine = routine
    workout_session_character = app.workout_character
    workout_voice_elapsed_ms = -1
    workout_resume_cue[0] = cast(u8)0
    workout_hold_for_figure = true
    WorkoutEnter(app)
    PracticeDraftBegin(EXERCISE_WORKOUT)
    if routine == WORKOUT_ROUTINE_CUSTOM {
        PracticeDraftSetDefinition(WorkoutPlanEncode(*workout_custom_plan))
    }
    WorkoutCheckpoint(true)
}

WorkoutEnter :: (app: *InnerBreeze) {
    app.exercise_type = EXERCISE_WORKOUT
    mark_exercise_manual_seen(app, EXERCISE_WORKOUT)
    workout_frame_carry = 0.0
    workout_startup = WORKOUT_START_WAITING
    workout_skip_initial_delta = false
    first := WorkoutCurrentStep()
    workout_last_phase = first.phase
    workout_last_exercise = first.exercise
    workout_last_index = first.index
    app.session_paused = 0
    PracticeNarrationStop()
    app_close_modal(app)
    app_switch_screen(app, ScreenWorkout)
}

WorkoutRecovery :: struct {
    routine: s32
    character: s32
    elapsed_ms: s32
    voiced_ms: s32
    duration_ms: s32
    plan: WorkoutPlan
    sequence: WorkoutSequence
    coverage: WorkoutCoverage
}

WorkoutRecoveryStep :: (state: *WorkoutRecovery) -> WorkoutStep {
    return WorkoutTimelineStep(state.routine, *state.sequence, state.elapsed_ms)
}

// A checkpoint holds the routine, character, clock and spoken cue, then the
// covered preparation and work of each step. Checkpoints written before
// grouped routines always held twelve steps.
WORKOUT_RECOVERY_HEADER :: 4

WorkoutRecoveryDecode :: (draft: *PracticeRecoveryDraft, state: *WorkoutRecovery) -> bool {
    if draft.activity != EXERCISE_WORKOUT || draft.resume.count < WORKOUT_RECOVERY_HEADER {
        return false
    }
    values := draft.resume.values[:]
    state.* = WorkoutRecovery.{.routine = values[0], .character = values[1],
        .elapsed_ms = values[2], .voiced_ms = values[3] - 1}
    if state.routine > WORKOUT_ROUTINE_CUSTOM || state.character > 1 || state.voiced_ms > state.elapsed_ms {
        return false
    }
    count := WorkoutRoutineCount(state.routine)
    if state.routine == WORKOUT_ROUTINE_CUSTOM {
        if !WorkoutPlanDecode(TextFromBytes(draft.resume.definition[:draft.resume.definition_length]), *state.plan) ||
            !WorkoutPlanExpand(*state.plan, *state.sequence) {
            return false
        }
        count = state.sequence.count
        state.duration_ms = cast(s32)WorkoutSequenceStart(*state.sequence, count)
    } else {
        if draft.resume.definition_length != 0 {
            return false
        }
        state.duration_ms = WorkoutTotalMilliseconds(state.routine)
    }
    slots := (draft.resume.count - WORKOUT_RECOVERY_HEADER) / 2
    if draft.resume.count != WORKOUT_RECOVERY_HEADER + slots * 2 ||
        (slots != count && !(slots == WORKOUT_EXERCISE_COUNT && count <= WORKOUT_EXERCISE_COUNT)) {
        return false
    }
    for index: cast(s32)0..slots - 1 {
        ready := values[WORKOUT_RECOVERY_HEADER + index]
        work := values[WORKOUT_RECOVERY_HEADER + slots + index]
        ready_limit: s32 = 0
        work_limit: s32 = 0
        if index < count {
            ready_limit = WorkoutLeadMilliseconds(state.routine)
            work_limit = WorkoutWorkMilliseconds(state.routine)
            if state.routine == WORKOUT_ROUTINE_CUSTOM {
                ready_limit = WorkoutSequenceBridge(*state.sequence, index)
                work_limit = state.sequence.blocks[index].seconds * 1000
            }
        }
        if ready > ready_limit || work > work_limit {
            return false
        }
        state.coverage.ready[index] = ready
        state.coverage.work[index] = work
        state.coverage.played_ms += ready + work
    }
    return state.elapsed_ms <= state.duration_ms && state.coverage.played_ms / 1000 == draft.rounds[0]
}

WorkoutCheckpoint :: (force: bool) {
    values: [WORKOUT_RECOVERY_HEADER + WORKOUT_TIMELINE_LIMIT * 2]s32
    values[0] = workout_routine
    values[1] = workout_session_character
    values[2] = cast(s32)workout_elapsed_ms
    values[3] = workout_voice_elapsed_ms + 1
    steps := WorkoutActiveCount()
    for index: cast(s32)0..steps - 1 {
        values[WORKOUT_RECOVERY_HEADER + index] = workout_coverage.ready[index]
        values[WORKOUT_RECOVERY_HEADER + steps + index] = workout_coverage.work[index]
    }
    step := WorkoutCurrentStep()
    PracticeDraftProgress(EXERCISE_WORKOUT, WorkoutPlayedSeconds(), step.index * 4 + step.phase,
        values[:WORKOUT_RECOVERY_HEADER + steps * 2], force)
}

WorkoutContinue :: (app: *InnerBreeze, draft: *PracticeRecoveryDraft) -> bool {
    state: WorkoutRecovery
    if !WorkoutRecoveryDecode(draft, *state) {
        return false
    }
    workout_routine = state.routine
    workout_custom_plan = state.plan
    workout_custom = state.sequence
    workout_elapsed_ms = state.elapsed_ms
    workout_coverage = state.coverage
    workout_session_character = state.character
    workout_voice_elapsed_ms = state.voiced_ms
    workout_resume_cue[0] = cast(u8)0
    workout_hold_for_figure = false
    if state.voiced_ms >= 0 {
        voiced := WorkoutTimelineStep(state.routine, *state.sequence, state.voiced_ms)
        key: [64]u8
        unused AppCopyText(WorkoutNarrationCue(voiced, key[:]), workout_resume_cue[:])
    }
    PracticeDraftResume(draft)
    WorkoutEnter(app)
    return true
}

WorkoutElapsedSeconds :: () -> s32 {
    return cast(s32)(workout_elapsed_ms / 1000)
}

WorkoutDuration :: () -> s32 {
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        return cast(s32)(WorkoutSequenceStart(*workout_custom, workout_custom.count) / 1000)
    }
    return WorkoutTotalMilliseconds(workout_routine) / 1000
}

WorkoutCurrentStep :: () -> WorkoutStep {
    return WorkoutTimelineStep(workout_routine, *workout_custom, workout_elapsed_ms)
}

WorkoutTimelineStep :: (routine: s32, sequence: *WorkoutSequence, milliseconds: s64) -> WorkoutStep {
    if routine == WORKOUT_ROUTINE_CUSTOM {
        return WorkoutSequenceStep(sequence, milliseconds)
    }
    return WorkoutStepAt(routine, milliseconds)
}

WorkoutActiveCount :: () -> s32 {
    return ifx workout_routine == WORKOUT_ROUTINE_CUSTOM then workout_custom.count else WorkoutRoutineCount(workout_routine)
}

WorkoutActiveCompletion :: () -> s32 {
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        return WorkoutSequenceCompleted(*workout_coverage, *workout_custom)
    }
    return WorkoutCompletedMask(*workout_coverage, workout_routine)
}

WorkoutRemaining :: () -> s32 {
    return WorkoutDuration() - WorkoutElapsedSeconds()
}

WorkoutPlayedSeconds :: () -> s32 {
    return workout_coverage.played_ms / 1000
}

WorkoutSave :: (app: *InnerBreeze, output: *u8, capacity: s64) {
    seconds := WorkoutPlayedSeconds()
    if seconds >= 60 && PracticeDraftSaveElapsed(EXERCISE_WORKOUT, seconds, output, capacity) != 0 {
        sync_habits_for_activity(app, EXERCISE_WORKOUT)
        unused app_auto_sync(app)
    }
}

WorkoutStop :: (app: *InnerBreeze) {
    workout_startup = WORKOUT_START_WAITING
    workout_skip_initial_delta = false
    PracticeDraftEnd()
    PracticeNarrationStop()
    meditation_music_stop(app)
    practice_active_background_stop(app)
    app.session_paused = 0
    app.volume_popup_active = 0
    app.music_volume_popup_active = 0
    app_close_modal(app)
}

WorkoutEnd :: (app: *InnerBreeze) {
    WorkoutSave(app, null, 0)
    WorkoutStop(app)
    app_switch_screen(app, ScreenStart)
}

WorkoutFinish :: (app: *InnerBreeze) {
    result_path: [FS_PATH_MAX]u8
    result_path[0] = cast(u8)0
    WorkoutSave(app, *result_path[0], size_of(type_of(result_path)))
    if WorkoutActiveCompletion() == (1 << WorkoutActiveCount()) - 1 {
        send_session_complete(app)
    }
    WorkoutStop(app)
    app_prepare_session_results(app, EXERCISE_WORKOUT,
        WorkoutPlayedSeconds(), 0, null, null, 0, *result_path[0])
    app_switch_screen(app, ScreenResults)
}

// A bell starts each exercise, and a softer one ends it.
WorkoutRing :: (app: *InnerBreeze, step: WorkoutStep) {
    if step.phase == workout_last_phase && step.exercise == workout_last_exercise && step.index == workout_last_index {
        return
    }
    if step.phase == WORKOUT_PHASE_WORK {
        app_play_bell_cue(app, 1.0)
    } else if workout_last_phase == WORKOUT_PHASE_WORK {
        app_play_bell_cue(app, 0.6)
    }
    workout_last_phase = step.phase
    workout_last_exercise = step.exercise
    workout_last_index = step.index
}

WorkoutAdvanceElapsed :: (app: *InnerBreeze, milliseconds: s32) {
    if WorkoutActive(app) == 0 || workout_startup != WORKOUT_START_RUNNING {
        return
    }
    before := workout_elapsed_ms
    paused := app.session_paused != 0
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        workout_elapsed_ms = WorkoutSequenceAdvance(*workout_custom, before, milliseconds, paused)
        WorkoutSequenceCredit(*workout_coverage, *workout_custom, before, workout_elapsed_ms)
    } else {
        workout_elapsed_ms = WorkoutAdvance(workout_routine, before, milliseconds, paused)
        WorkoutCredit(*workout_coverage, workout_routine, before, workout_elapsed_ms)
    }
    step := WorkoutCurrentStep()
    WorkoutRing(app, step)
    WorkoutCheckpoint(false)
    if step.phase == WORKOUT_PHASE_DONE {
        WorkoutFinish(app)
    }
}

WorkoutSeek :: (app: *InnerBreeze, index: s32) {
    if WorkoutActive(app) == 0 || workout_startup != WORKOUT_START_RUNNING ||
    WorkoutCurrentStep().phase == WORKOUT_PHASE_PREPARE || index < 0 || index >= WorkoutActiveCount() {
        return
    }
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        workout_elapsed_ms = WorkoutSequenceStart(*workout_custom, index)
    } else {
        workout_elapsed_ms = WorkoutStepStart(workout_routine, index)
    }
    workout_frame_carry = 0.0
    step := WorkoutCurrentStep()
    workout_last_phase = step.phase
    workout_last_exercise = step.exercise
    workout_last_index = step.index
    PracticeNarrationStop()
    workout_voice_elapsed_ms = -1
    workout_resume_cue[0] = cast(u8)0
    WorkoutCheckpoint(true)
}

WorkoutNarrationCue :: (step: WorkoutStep, output: []u8) -> string {
    return ifx workout_routine == WORKOUT_ROUTINE_CUSTOM then WorkoutSequenceCue(step, output) else WorkoutCueKey(step, output)
}

WorkoutUpdate :: (app: *InnerBreeze) {
    if WorkoutActive(app) == 0 {
        return
    }
    if workout_startup != WORKOUT_START_RUNNING {
        if workout_startup != WORKOUT_START_READY || app.session_paused != 0 || app.backgrounded != 0 {
            return
        }
        workout_startup = WORKOUT_START_RUNNING
        workout_skip_initial_delta = true
        meditation_music_start_session(app)
        practice_background_start(app, EXERCISE_WORKOUT)
    }
    meditation_music_update(app)
    key: [64]u8
    step := WorkoutCurrentStep()
    cue := WorkoutNarrationCue(step, key[:])
    if workout_resume_cue[0] != cast(u8)0 {
        voiced := WorkoutTimelineStep(workout_routine, *workout_custom, workout_voice_elapsed_ms)
        if cue == TextFromCString(*workout_resume_cue[0]) && step.index == voiced.index && step.phase == voiced.phase {
            return
        }
        workout_resume_cue[0] = cast(u8)0
    }
    PracticeNarrationUpdate(app, "workout", cue)
    if app.session_paused == 0 && cue.count > 0 {
        workout_voice_elapsed_ms = cast(s32)workout_elapsed_ms
    }
}

WorkoutRequestExit :: (app: *InnerBreeze) {
    workout_exit_was_paused = app.session_paused
    app.session_paused = 1
    WorkoutCheckpoint(true)
    app_open_modal(app, cast(ModalType)ModalConfirmExitSession)
}

WorkoutExitPrompt :: (app: *InnerBreeze) -> s32 {
    if app.modal.active == 0 || app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return 0
    }
    result := app_draw_session_exit_modal(app, ifx WorkoutPlayedSeconds() >= 60 then 1 else 0,
        // The neutral words of the other timed practices; this is not a meditation.
        LocaleText("patterns_save_elapsed_message"), LocaleText("patterns_under_minute_exit_message"))
    if result == cast(SessionExitModalResult)SessionExitModalCancel {
        app_close_modal(app)
        app.session_paused = workout_exit_was_paused
    } else if result == cast(SessionExitModalResult)SessionExitModalSave ||
    result == cast(SessionExitModalResult)SessionExitModalDiscard {
        if result == cast(SessionExitModalResult)SessionExitModalSave {
            WorkoutSave(app, null, 0)
        }
        WorkoutStop(app)
        app_switch_screen(app, ScreenStart)
        return 2
    }
    return 1
}

// --- Words -----------------------------------------------------------------------

WorkoutGentleText :: (exercise: s32, tip: bool) -> string {
    if exercise == WORKOUT_STEP_JACKS {
        return ifx tip then LocaleText("workout_tip_step_jacks") else LocaleText("workout_name_step_jacks")
    }
    if exercise == WORKOUT_MINI_SQUATS {
        return ifx tip then LocaleText("workout_tip_mini_squats") else LocaleText("workout_name_mini_squats")
    }
    if exercise == WORKOUT_HEEL_RAISES {
        return ifx tip then LocaleText("workout_tip_heel_raises") else LocaleText("workout_name_heel_raises")
    }
    if exercise == WORKOUT_EASY_MARCH {
        return ifx tip then LocaleText("workout_tip_easy_march") else LocaleText("workout_name_easy_march")
    }
    if exercise == WORKOUT_SIDE_REACHES {
        return ifx tip then LocaleText("workout_tip_side_reaches") else LocaleText("workout_name_side_reaches")
    }
    if exercise == WORKOUT_BACK_TAPS {
        return ifx tip then LocaleText("workout_tip_back_taps") else LocaleText("workout_name_back_taps")
    }
    return ""
}

WorkoutExerciseText :: (app: *InnerBreeze, prefix: string, exercise: s32) -> string {
    if WorkoutGentleExercise(exercise) {
        return WorkoutGentleText(exercise, prefix == "workout_tip_")
    }
    key: [64]u8
    return WorkoutText(app, WorkoutKeyFor(prefix, exercise, key[:]))
}

// The exercise being done, or the one to get into position for.
WorkoutHeading :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    return WorkoutExerciseText(app, "workout_name_", step.exercise)
}

// "Get into position" while waiting, "Exercise 2 of 12" while working.
WorkoutSubheading :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    if workout_startup == WORKOUT_START_WAITING {
        return LocaleText("workout_loading_scene")
    }
    if step.phase == WORKOUT_PHASE_PREPARE { return "" }
    if step.phase == WORKOUT_PHASE_REST && workout_routine == WORKOUT_ROUTINE_CUSTOM {
        return LocaleText("workout_custom_transition")
    }
    if step.phase == WORKOUT_PHASE_REST && WorkoutGentleExercise(step.exercise) {
        return LocaleText("workout_rest_before_next")
    }
    if step.phase != WORKOUT_PHASE_WORK {
        return LocaleText("workout_get_into_position")
    }
    buffer: [160]u8
    args: [2]FormatArg = .[FormatArg.{.number = step.index + 1},
        FormatArg.{.number = WorkoutActiveCount()}]
    unused FormatTemplate(LocaleText("workout_exercise_number"), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, TextUntilNul(buffer[:]))
}

// How to do the exercise shown, including the selected custom form or side.
WorkoutTip :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    if workout_routine == WORKOUT_ROUTINE_CUSTOM && step.index >= 0 && step.index < workout_custom.count {
        variant := workout_custom.blocks[step.index].variant
        if variant != WORKOUT_CUSTOM_ORDINARY {
            return LocaleText(WorkoutBuilderVariantKey(variant))
        }
    }
    if workout_routine != WORKOUT_ROUTINE_CUSTOM && step.phase == WORKOUT_PHASE_WORK && step.exercise == WORKOUT_SIDE_PLANK &&
    step.elapsed_ms >= WORKOUT_SIDE_SWITCH_MS && step.elapsed_ms < WORKOUT_SIDE_SWITCH_MS + 3000 {
        return LocaleText("workout_switch_sides")
    }
    return WorkoutExerciseText(app, "workout_tip_", step.exercise)
}

// --- Drawing ---------------------------------------------------------------------

WorkoutDark :: (app: *InnerBreeze) -> bool {
    return app.theme_mode == APP_THEME_DARK || (app.theme_mode != APP_THEME_LIGHT && app.dark_mode != 0)
}

// The figure doing the exercise, getting ready, or moving between exercises.
WorkoutDrawFigure :: (app: *InnerBreeze, step: WorkoutStep, area: Rectangle, key: u64, alt_text: string) -> bool {
    if area.width <= 0.0 || area.height <= 0.0 {
        return false
    }
    rig := WorkoutRig()
    pose: WorkoutPose
    framing := WorkoutFramingFor(step.exercise)
    prop := step.exercise
    prop_opacity := 1.0
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        custom := WorkoutSequenceFrame(*workout_custom, step, *rig)
        pose = custom.pose
        framing = custom.framing
        prop = custom.prop
        prop_opacity = custom.prop_opacity
    } else if step.phase == WORKOUT_PHASE_WORK {
        pose = WorkoutPoseAt(step.exercise, cast(s64)step.elapsed_ms, *rig)
    } else {
        pose = WorkoutRestPose(step, workout_elapsed_ms, *rig)
    }
    if workout_routine != WORKOUT_ROUTINE_CUSTOM && step.phase == WORKOUT_PHASE_REST && step.exercise == WORKOUT_WALL_SIT {
        start := WorkoutFramingFor(WORKOUT_JUMPING_JACKS)
        turn := TaiChiSmoothstep(TaiChiClamp(cast(float64)step.elapsed_ms / 2000.0, 0.0, 1.0))
        framing.camera.yaw = start.camera.yaw + (framing.camera.yaw - start.camera.yaw) * turn
        prop_opacity = TaiChiSmoothstep(TaiChiClamp(cast(float64)step.elapsed_ms / 1200.0, 0.0, 1.0))
    }
    // A wide area shows the same height; a narrow one widens the view so
    // that lying exercises still fit.
    across := framing.view_height * cast(float64)area.width / cast(float64)area.height
    if across < 2.2 {
        framing.view_height = framing.view_height * 2.2 / across
    }
    if prop >= 0 && prop_opacity > 0.0 {
        WorkoutPaintProps(*workout_props, prop, framing.camera, WorkoutDark(app))
        if prop_opacity < 1.0 {
            for index: 0..workout_props.op_count - 1 {
                workout_props.ops[index].alpha *= prop_opacity
            }
        }
        TaiChiPaintFlatEdge(app.ui.session, *workout_props, framing, false, area, key, "", WORKOUT_EDGE_PATH)
    }
    digest := WorkoutPoseDigest(*pose, cast(u64)step.exercise + 1)
    return WorkoutDrawAppearance(app, *pose, *rig, framing, workout_session_character == 1,
        area, key + cast(u64)4096, alt_text, cast(float64)workout_elapsed_ms / 1000.0, digest)
}

// The Workout's figure wears its training clothes; the Customize cards show
// the same figure in them.
WorkoutFigurePlacement :: () -> PracticeFigurePlacement {
    return PracticeFigurePlacement.{.training = true, .training_shorts = true}
}

WorkoutDrawAppearance :: (app: *InnerBreeze, pose: *WorkoutPose, rig: *TaiChiRig,
    framing: TaiChiFraming, man: bool, area: Rectangle, key: u64, alt_text: string,
    seconds: float64, digest: u64) -> bool {
    solved := WorkoutSolve(pose, rig)
    if PracticeFigureDrawModel(app.ui.session, *solved, rig, framing, man, false, area, key,
        alt_text, seconds, digest, WorkoutFigurePlacement()) {
        return true
    }
    look := TaiChiFlatLookNamed(ifx man then "indigoMan" else "jadeWoman")
    TaiChiFlatPaintLook(*workout_figure, *solved, rig, look, framing.camera)
    TaiChiPaintFlatEdge(app.ui.session, *workout_figure, framing, false, area, key, alt_text, WORKOUT_EDGE_PATH)
    return false
}

WorkoutCharacterPreview :: (app: *InnerBreeze, area: Rectangle) {
    rig := WorkoutRig()
    pose := WorkoutStanding()
    framing := TaiChiFraming.{.view_height = rig.height * 1.16, .view_center = rig.height * 0.50}
    digest := WorkoutPoseDigest(*pose, 2)
    label_h := cast(float32)AppScale(32)
    gap := cast(float32)AppScale(6)
    column := (area.width - gap) / 2.0
    key := Layout.KeyHash("workout/customize/character")
    PracticeFigurePrepare(app.workout_character == 1)
    for character: cast(s32)0..1 {
        man := character == 1
        label := LocaleText(ifx man then "workout_character_man" else "workout_character_woman")
        x := area.x + cast(float32)character * (column + gap)
        selected := app.workout_character == character
        bounds := Rectangle.{x, area.y, column, area.height}
        Box.Draw(app.ui.session, Box.Props.{.key = key + cast(u64)(8 + character), .bounds = bounds,
            .fill = StyleTokenColor("surface"), .radius = cast(float32)AppScale(12),
            .border = StyleTokenColor(ifx selected then "accent" else "surface")})
        if Button.Draw(app.ui.session, Button.Props.{.key = key + cast(u64)character,
                .id = 28910 + character, .bounds = bounds,
                .label = label, .invisible = true, .selected = selected}) != 0 && !selected {
            app.workout_character = character
            app.settings_dirty = 1
            save_settings(app)
        }
        figure_h := area.height - label_h - gap * 2.0
        figure_w := column - gap * 2.0
        if figure_h > 0.0 && figure_w > 0.0 {
            framing.view_height = rig.height * 1.16
            if figure_w < figure_h * 0.48 {
                framing.view_height *= cast(float64)(figure_h * 0.48 / figure_w)
            }
            // A card shows the Workout's own current figure, or nothing; never
            // the flat figure painted when a model cannot load.
            solved := WorkoutSolve(*pose, *rig)
            unused PracticeFigureDrawModel(app.ui.session, *solved, *rig, framing, man, false,
                Rectangle.{x + (column - figure_w) / 2.0, area.y + gap, figure_w, figure_h},
                key + cast(u64)(4 + character), label, -1.0, digest, WorkoutFigurePlacement())
        }
        strong: [1]Text.Range = .[.{.start = 0, .end = cast(s32)label.count}]
        Text.Draw(app.ui.session, Text.Props.{.bounds = Rectangle.{x, area.y + area.height - label_h, column, label_h},
            .text = label, .size = AppFontSize(), .strong = strong[:(ifx selected then 1 else 0)],
            .align = cast(TextAlign)TextAlignCenter,
            .vertical_align = cast(TextAlign)TextAlignCenter})
    }
}

WorkoutDrawWindow :: (app: *InnerBreeze, picture: Rectangle, output: []u8) -> string {
    step := WorkoutCurrentStep()
    unused WorkoutDrawFigure(app, step, picture, Layout.KeyHash("workout/window/figure"), "")
    cursor: s32 = 0
    output[0] = cast(u8)0
    heading := WorkoutHeading(app, step)
    for byte: heading {
        unused TextBufferAppendByte(output, *cursor, byte)
    }
    unused TextBufferAppendByte(output, *cursor, cast(u8)32)
    unused TextBufferAppendNumber(output, *cursor, WorkoutStepSecondsLeft(step))
    return TextUntilNul(output)
}

// The session's figure, or the loading dots while its model is on its way.
// A fresh session holds its clock at the start until the chosen character's
// model is on screen; a resumed session, or one whose model is not coming,
// starts at once and falls back to the flat figure.
WorkoutSessionFigure :: (app: *InnerBreeze, request: PracticeFigureRequest) {
    #if #defined(KRYON_TEST_DRIVER) && #defined(DESKTOP_HOST) && OS == .LINUX {
        if workout_startup == WORKOUT_START_WAITING && !WorkoutTestSceneAvailable() {
            return
        }
    }
    unused WorkoutDrawFigure(app, WorkoutCurrentStep(), request.bounds, request.key, request.alt_text)
    if workout_startup != WORKOUT_START_WAITING {
        return
    }
    if workout_hold_for_figure && PracticeFigureModelLoading(workout_session_character == 1) {
        return
    }
    workout_hold_for_figure = false
    workout_startup = WORKOUT_START_READY
}

WorkoutDraw :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    title := WorkoutTitle(workout_routine)
    custom_title: [WORKOUT_CUSTOM_NAME_LIMIT]u8
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        title = FrameTextHold(*app.ui.frame_text, WorkoutSequenceName(*workout_custom, custom_title[:]))
    }
    top := PracticeTitleBarHeight()
    if PracticeTitleBar(app, title, top) {
        WorkoutRequestExit(app)
    }
    if WorkoutExitPrompt(app) != 0 {
        return
    }
    practice_draw_audio_controls(app)
    step := WorkoutCurrentStep()
    frame := PracticeMovementFrameFor(app, EXERCISE_WORKOUT, top)
    frame.heading = WorkoutHeading(app, step)
    frame.subtitle = WorkoutSubheading(app, step)
    frame.cue = ifx workout_startup != WORKOUT_START_WAITING && step.phase == WORKOUT_PHASE_WORK then WorkoutTip(app, step) else ""
    frame.exercise = step.exercise
    frame.view = workout_routine
    frame.progress = WorkoutActiveCompletion()
    blocks: [WORKOUT_TIMELINE_LIMIT]u8
    if workout_routine == WORKOUT_ROUTINE_CUSTOM {
        // The workout frame carries one ASCII exercise ID per block and the
        // current block position. Repeated exercises remain distinct controls.
        for index: cast(s32)0..workout_custom.count - 1 {
            blocks[index] = cast(u8)(65 + workout_custom.blocks[index].exercise)
        }
        frame.time = TextFromBytes(blocks[:workout_custom.count])
        frame.scroll = step.index
    }
    frame.phase = ifx workout_startup == WORKOUT_START_WAITING then WORKOUT_PHASE_LOADING else step.phase
    frame.elapsed_ms = step.elapsed_ms
    frame.length_ms = step.length_ms
    frame.seconds_left = WorkoutStepSecondsLeft(step)
    frame = PracticeMovementRun(app, frame, WorkoutSessionFigure)
    if frame.action == PRACTICE_MOVEMENT_SEEK {
        WorkoutSeek(app, frame.value)
        return
    }
    if frame.action == PRACTICE_MOVEMENT_PAUSE {
        app.session_paused = ifx app.session_paused != 0 then 0 else 1
        WorkoutCheckpoint(true)
    }
    if workout_skip_initial_delta {
        // The host delta can include the expensive first model render.
        workout_skip_initial_delta = false
    } else if workout_startup == WORKOUT_START_RUNNING && app.backgrounded == 0 && app.session_paused == 0 &&
    frame.action != PRACTICE_MOVEMENT_PAUSE {
        total := cast(float64)HostFrameSeconds() * 1000.0 + workout_frame_carry
        milliseconds := cast(s32)total
        workout_frame_carry = total - cast(float64)milliseconds
        WorkoutAdvanceElapsed(app, milliseconds)
    }
    unused center_x
    unused center_y
}
