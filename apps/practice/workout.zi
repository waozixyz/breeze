c :: #system_library "c";
GetFrameTime :: () -> float32 #foreign c;
practice_background_start :: (app: *InnerBreeze, id: s32) #foreign c;
practice_active_background_stop :: (app: *InnerBreeze) #foreign c;
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c;
sync_habits_for_activity :: (app: *InnerBreeze, activity: s32) #foreign c;
app_play_bell_cue :: (app: *InnerBreeze, volume: float32) #foreign c;
app_draw_session_exit_modal :: (app: *InnerBreeze, can_save: s32,
    save_message: string, discard_message: string) -> SessionExitModalResult #foreign c;

using AppThemeMode;
using ExerciseType;
using ModalType;
using SessionExitModalResult;
using TextAlign;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

WORKOUT_EDGE_PATH :: "assets/practices/workout/flat-edge.png"

workout_elapsed_ms: s64;
workout_frame_carry: float64;
workout_exit_was_paused: s32;
// The phase and exercise last seen, so each change rings once.
workout_last_phase: s32 = -1;
workout_last_exercise: s32 = -1;
workout_figure: TaiChiFlatFrame;
workout_props: TaiChiFlatFrame;

WorkoutActive :: (app: *InnerBreeze) -> s32 {
    return ifx app != null && app_session_screen(app) == ScreenWorkout then 1 else 0
}

WorkoutStart :: (app: *InnerBreeze) {
    if app == null || !ActivityStartAllowed() {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_WORKOUT)
    workout_elapsed_ms = 0
    workout_frame_carry = 0.0
    workout_last_phase = WORKOUT_PHASE_PREPARE
    workout_last_exercise = 0
    app.session_paused = 0
    PracticeNarrationStop()
    app_close_modal(app)
    app_switch_screen(app, ScreenWorkout)
    meditation_music_start_session(app)
    practice_background_start(app, EXERCISE_WORKOUT)
}

WorkoutElapsedSeconds :: () -> s32 {
    return cast(s32)(workout_elapsed_ms / 1000)
}

WorkoutDuration :: () -> s32 {
    return WORKOUT_TOTAL_MS / 1000
}

WorkoutRemaining :: () -> s32 {
    return WorkoutDuration() - WorkoutElapsedSeconds()
}

WorkoutSave :: (app: *InnerBreeze, output: *u8, capacity: s64) {
    seconds := WorkoutElapsedSeconds()
    if seconds >= 60 && data_save_session_path_for_activity(*seconds, 1, 0,
        EXERCISE_WORKOUT, output, capacity) != 0 {
        sync_habits_for_activity(app, EXERCISE_WORKOUT)
        unused app_auto_sync(app)
    }
}

WorkoutStop :: (app: *InnerBreeze) {
    PracticeNarrationStop()
    meditation_music_stop(app)
    practice_active_background_stop(app)
    app.session_paused = 0
    app.volume_popup_active = 0
    app.music_volume_popup_active = 0
    app_close_modal(app)
}

WorkoutEnd :: (app: *InnerBreeze) {
    WorkoutSave(app, null, 0)
    WorkoutStop(app)
    app_switch_screen(app, ScreenStart)
}

WorkoutFinish :: (app: *InnerBreeze) {
    result_path: [FS_PATH_MAX]u8
    result_path[0] = cast(u8)0
    WorkoutSave(app, *result_path[0], size_of(type_of(result_path)))
    send_session_complete(app)
    WorkoutStop(app)
    app_prepare_session_results(app, EXERCISE_WORKOUT,
        WorkoutElapsedSeconds(), 0, null, null, 0, *result_path[0])
    app_switch_screen(app, ScreenResults)
}

// A bell starts each exercise, and a softer one ends it.
WorkoutRing :: (app: *InnerBreeze, step: WorkoutStep) {
    if step.phase == workout_last_phase && step.exercise == workout_last_exercise {
        return
    }
    if step.phase == WORKOUT_PHASE_WORK {
        app_play_bell_cue(app, 1.0)
    } else if workout_last_phase == WORKOUT_PHASE_WORK {
        app_play_bell_cue(app, 0.6)
    }
    workout_last_phase = step.phase
    workout_last_exercise = step.exercise
}

WorkoutAdvanceElapsed :: (app: *InnerBreeze, milliseconds: s32) {
    if WorkoutActive(app) == 0 {
        return
    }
    workout_elapsed_ms = WorkoutAdvance(workout_elapsed_ms, milliseconds, app.session_paused != 0)
    step := WorkoutStepAt(workout_elapsed_ms)
    WorkoutRing(app, step)
    if step.phase == WORKOUT_PHASE_DONE {
        WorkoutFinish(app)
    }
}

WorkoutUpdate :: (app: *InnerBreeze) {
    if WorkoutActive(app) == 0 {
        return
    }
    meditation_music_update(app)
    key: [64]u8
    PracticeNarrationUpdate(app, "workout", WorkoutCueKey(WorkoutStepAt(workout_elapsed_ms), key[:]))
}

WorkoutRequestExit :: (app: *InnerBreeze) {
    workout_exit_was_paused = app.session_paused
    app.session_paused = 1
    app_open_modal(app, cast(ModalType)ModalConfirmExitSession)
}

WorkoutExitPrompt :: (app: *InnerBreeze) -> s32 {
    if app.modal.active == 0 || app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return 0
    }
    result := app_draw_session_exit_modal(app, ifx WorkoutElapsedSeconds() >= 60 then 1 else 0,
        LocaleText("meditation_save_elapsed_message"), LocaleText("meditation_under_minute_exit_message"))
    if result == cast(SessionExitModalResult)SessionExitModalCancel {
        app_close_modal(app)
        app.session_paused = workout_exit_was_paused
    } else if result == cast(SessionExitModalResult)SessionExitModalSave ||
    result == cast(SessionExitModalResult)SessionExitModalDiscard {
        if result == cast(SessionExitModalResult)SessionExitModalSave {
            WorkoutSave(app, null, 0)
        }
        WorkoutStop(app)
        app_switch_screen(app, ScreenStart)
        return 2
    }
    return 1
}

// --- Words -----------------------------------------------------------------------

WorkoutTextAsset :: (code: string) -> AssetView {
    path: [128]u8
    if !AppCopyText("assets/practices/workout/text/", path[:]) ||
    !AppAppendText(code, path[:]) || !AppAppendText(".txt", path[:]) {
        return AssetView.{}
    }
    return AssetRead(TextUntilNul(path[:]))
}

// A line of the workout's own words, in the app's language when it has it.
WorkoutText :: (app: *InnerBreeze, key: string) -> string {
    localized := WorkoutTextAsset(LocaleActiveCode())
    english := WorkoutTextAsset("en")
    return FrameTextHold(*app.ui.frame_text, LocaleResolveCatalog(localized.data, english.data, key))
}

WorkoutExerciseText :: (app: *InnerBreeze, prefix: string, exercise: s32) -> string {
    key: [64]u8
    return WorkoutText(app, WorkoutKeyFor(prefix, exercise, key[:]))
}

// "Get ready", "Rest" or the exercise's name.
WorkoutHeading :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    if step.phase == WORKOUT_PHASE_PREPARE {
        return LocaleText("workout_get_ready")
    }
    if step.phase == WORKOUT_PHASE_REST {
        return LocaleText("workout_rest")
    }
    return WorkoutExerciseText(app, "workout_name_", step.exercise)
}

// "Next: Wall sit" while waiting, "Exercise 2 of 12" while working.
WorkoutSubheading :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    buffer: [160]u8
    if step.phase == WORKOUT_PHASE_WORK {
        args: [2]FormatArg = .[FormatArg.{.number = step.exercise + 1}, FormatArg.{.number = WORKOUT_EXERCISE_COUNT}]
        unused FormatTemplate(LocaleText("workout_exercise_number"), args[:], buffer[:])
    } else {
        args: [1]FormatArg = .[FormatArg.{.text = WorkoutExerciseText(app, "workout_name_", step.exercise), .is_text = true}]
        unused FormatTemplate(LocaleText("workout_next"), args[:], buffer[:])
    }
    return FrameTextHold(*app.ui.frame_text, TextUntilNul(buffer[:]))
}

// How to do the exercise shown, or "Switch sides" halfway through the side
// plank.
WorkoutTip :: (app: *InnerBreeze, step: WorkoutStep) -> string {
    if step.phase == WORKOUT_PHASE_WORK && step.exercise == WORKOUT_SIDE_PLANK &&
    step.elapsed_ms >= WORKOUT_SIDE_SWITCH_MS && step.elapsed_ms < WORKOUT_SIDE_SWITCH_MS + 3000 {
        return LocaleText("workout_switch_sides")
    }
    return WorkoutExerciseText(app, "workout_tip_", step.exercise)
}

// --- Drawing ---------------------------------------------------------------------

WorkoutDark :: (app: *InnerBreeze) -> bool {
    return app.theme_mode == APP_THEME_DARK || (app.theme_mode != APP_THEME_LIGHT && app.dark_mode != 0)
}

// The figure doing the step's exercise, or waiting in the next one's first
// pose while getting ready or resting.
WorkoutDrawFigure :: (app: *InnerBreeze, step: WorkoutStep, area: Rectangle, key: u64, alt_text: string) {
    if area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    rig := WorkoutRig()
    pose: WorkoutPose
    if step.phase == WORKOUT_PHASE_WORK {
        pose = WorkoutPoseAt(step.exercise, cast(s64)step.elapsed_ms, *rig)
    } else {
        pose = WorkoutRestPose(step.exercise, workout_elapsed_ms, *rig)
    }
    solved := WorkoutSolve(*pose, *rig)
    framing := WorkoutFramingFor(step.exercise)
    // A wide area shows the same height; a narrow one widens the view so
    // that lying exercises still fit.
    across := framing.view_height * cast(float64)area.width / cast(float64)area.height
    if across < 2.2 {
        framing.view_height = framing.view_height * 2.2 / across
    }
    WorkoutPaintProps(*workout_props, step.exercise, framing.camera, WorkoutDark(app))
    TaiChiPaintFlatEdge(app.ui.session, *workout_props, framing, false, area, key, "", WORKOUT_EDGE_PATH)
    TaiChiFlatPaintLook(*workout_figure, *solved, *rig, TaiChiFlatLookNamed("jadeWoman"), framing.camera)
    TaiChiPaintFlatEdge(app.ui.session, *workout_figure, framing, false, area, key + cast(u64)4096,
        alt_text, WORKOUT_EDGE_PATH)
}

// Twelve short bars across the top, one per exercise, filling as each is
// done.
WorkoutDrawProgress :: (app: *InnerBreeze, step: WorkoutStep, x: s32, y: s32, width: s32) {
    gap := AppScale(4)
    bar_w := (width - gap * (WORKOUT_EXERCISE_COUNT - 1)) / WORKOUT_EXERCISE_COUNT
    bar_h := AppScale(6)
    track := color_with_alpha(StyleTokenColor("text"), 0.14)
    fill := StyleTokenColor("accent")
    for index: cast(s32)0..WORKOUT_EXERCISE_COUNT - 1 {
        bar := Rectangle.{cast(float32)(x + index * (bar_w + gap)), cast(float32)y,
            cast(float32)bar_w, cast(float32)bar_h}
        Box(app.ui.session, BoxProps.{.bounds = bar, .fill = track, .radius = cast(float32)bar_h / 2.0})
        share: float32 = 0.0
        if index < step.exercise || step.phase == WORKOUT_PHASE_DONE {
            share = 1.0
        } else if index == step.exercise && step.phase == WORKOUT_PHASE_WORK {
            share = cast(float32)step.elapsed_ms / cast(float32)step.length_ms
        }
        if share > 0.0 {
            done := bar
            done.width = bar.width * share
            if done.width < cast(float32)bar_h {
                done.width = cast(float32)bar_h
            }
            Box(app.ui.session, BoxProps.{.bounds = done, .fill = fill, .radius = cast(float32)bar_h / 2.0})
        }
    }
}

// The seconds left in the step inside a ring that empties as they pass.
WorkoutDrawCountdown :: (app: *InnerBreeze, step: WorkoutStep, center: Vector2, radius: float32) {
    thickness := cast(float32)AppScale(6)
    Ring(app.ui.session, RingProps.{.center = center, .inner_radius = radius - thickness,
            .outer_radius = radius, .start_angle = 0.0, .end_angle = 360.0,
            .color = color_with_alpha(StyleTokenColor("text"), 0.12)})
    left: float32 = 1.0
    if step.length_ms > 0 {
        left = 1.0 - cast(float32)step.elapsed_ms / cast(float32)step.length_ms
    }
    color := color_with_alpha(StyleTokenColor("text"), 0.55)
    if step.phase == WORKOUT_PHASE_WORK {
        color = StyleTokenColor("accent")
    }
    if left > 0.0 {
        Ring(app.ui.session, RingProps.{.center = center, .inner_radius = radius - thickness,
                .outer_radius = radius, .start_angle = -90.0, .end_angle = -90.0 + 360.0 * left,
                .color = color})
    }
    number: [16]u8
    cursor: s32 = 0
    unused TextBufferAppendNumber(number[:], *cursor, WorkoutStepSecondsLeft(step))
    font := AppScale(30)
    Text(app.ui.session, TextProps.{
            .text = FrameTextHold(*app.ui.frame_text, TextUntilNul(number[:])),
            .bounds = Rectangle.{center.x - radius, center.y - radius, radius * 2.0, radius * 2.0},
            .font = font, .align = cast(TextAlign)TextAlignCenter,
            .vertical_align = cast(TextAlign)TextAlignCenter, .wrap = cast(TextWrap)TextWrapNone})
}

WorkoutDrawWindow :: (app: *InnerBreeze, picture: Rectangle, output: []u8) -> string {
    step := WorkoutStepAt(workout_elapsed_ms)
    WorkoutDrawFigure(app, step, picture, KeyHash("workout/window/figure"), "")
    cursor: s32 = 0
    output[0] = cast(u8)0
    heading := WorkoutHeading(app, step)
    for byte: heading {
        unused TextBufferAppendByte(output, *cursor, byte)
    }
    unused TextBufferAppendByte(output, *cursor, cast(u8)32)
    unused TextBufferAppendNumber(output, *cursor, WorkoutStepSecondsLeft(step))
    return TextUntilNul(output)
}

WorkoutDraw :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    unused center_x
    unused center_y
    top := PracticeTitleBarHeight()
    if PracticeTitleBar(app, LocaleText("exercise_workout"), top) {
        WorkoutRequestExit(app)
    }
    if WorkoutExitPrompt(app) != 0 {
        return
    }
    practice_draw_audio_controls(app)
    step := WorkoutStepAt(workout_elapsed_ms)
    pad := AppScale(20)
    view_w := app.ui.view_width
    view_h := app.ui.view_height
    // Side by side when there is room: the figure on the left, the words,
    // the countdown and Pause on the right.
    wide := view_w >= AppScale(760) && view_w * 10 >= view_h * 12
    panel_w := ifx wide then view_w * 2 / 5 else view_w - pad * 2
    if panel_w > AppScale(560) {
        panel_w = AppScale(560)
    }
    panel_x := ifx wide then view_w - pad - panel_w else pad
    progress_y := top + AppScale(10)
    WorkoutDrawProgress(app, step, pad, progress_y, view_w - pad * 2)
    button_h := AppScale(48)
    ring_r := AppScale(44)
    heading_font := AppScale(26)
    small_font := AppFontSize()
    heading := WorkoutHeading(app, step)
    subheading := WorkoutSubheading(app, step)
    tip := WorkoutTip(app, step)
    heading_h := AppParagraphHeight(heading, panel_w, heading_font, 0)
    sub_h := AppParagraphHeight(subheading, panel_w, small_font, 0)
    tip_h := AppParagraphHeight(tip, panel_w, small_font, AppScale(3))
    content_top := progress_y + AppScale(20)
    words_h := heading_h + AppScale(4) + sub_h
    lower_h := tip_h + AppScale(16) + ring_r * 2 + AppScale(16) + button_h + AppScale(20)
    stage: Rectangle
    panel_top := content_top
    if wide {
        stage = Rectangle.{cast(float32)pad, cast(float32)content_top,
            cast(float32)(panel_x - pad * 2), cast(float32)(view_h - content_top - pad)}
        panel_top = content_top + (view_h - content_top - pad - words_h - AppScale(24) - lower_h) / 2
        if panel_top < content_top {
            panel_top = content_top
        }
    } else {
        stage_h := view_h - content_top - words_h - AppScale(12) - lower_h
        stage = Rectangle.{cast(float32)pad, cast(float32)(content_top + words_h + AppScale(8)),
            cast(float32)(view_w - pad * 2), cast(float32)stage_h}
    }
    emphasis := StrongWhole(heading)
    Text(app.ui.session, TextProps.{.text = heading,
            .bounds = Rectangle.{cast(float32)panel_x, cast(float32)panel_top, cast(float32)panel_w, cast(float32)heading_h},
            .font = heading_font, .align = cast(TextAlign)TextAlignCenter, .strong = emphasis[:1]})
    Text(app.ui.session, TextProps.{.text = subheading,
            .bounds = Rectangle.{cast(float32)panel_x, cast(float32)(panel_top + heading_h + AppScale(4)),
                cast(float32)panel_w, cast(float32)sub_h},
            .font = small_font, .align = cast(TextAlign)TextAlignCenter, .disabled = true})
    if stage.height > cast(float32)AppScale(60) {
        alt: [192]u8
        unused AppCopyText(heading, alt[:])
        WorkoutDrawFigure(app, step, stage, KeyHash("workout/figure"), TextUntilNul(alt[:]))
    }
    lower_y := ifx wide then panel_top + words_h + AppScale(24) else view_h - lower_h
    Text(app.ui.session, TextProps.{.text = tip,
            .bounds = Rectangle.{cast(float32)panel_x, cast(float32)lower_y, cast(float32)panel_w, cast(float32)tip_h},
            .font = small_font, .align = cast(TextAlign)TextAlignCenter})
    ring_center := Vector2.{cast(float32)(panel_x + panel_w / 2),
        cast(float32)(lower_y + tip_h + AppScale(16) + ring_r)}
    WorkoutDrawCountdown(app, step, ring_center, cast(float32)ring_r)
    button_w := AppScale(220)
    if button_w > panel_w {
        button_w = panel_w
    }
    button_y := lower_y + tip_h + AppScale(16) + ring_r * 2 + AppScale(16)
    if Button(app.ui.session, ButtonProps.{.key = KeyHash("workout/pause"),
            .label = LocaleText(ifx app.session_paused != 0 then "patterns_resume_button" else "pause_button"),
            .bounds = Rectangle.{cast(float32)(panel_x + (panel_w - button_w) / 2), cast(float32)button_y,
                cast(float32)button_w, cast(float32)button_h},
            .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        app.session_paused = ifx app.session_paused != 0 then 0 else 1
    }
    if app.backgrounded == 0 {
        total := cast(float64)GetFrameTime() * 1000.0 + workout_frame_carry
        milliseconds := cast(s32)total
        workout_frame_carry = total - cast(float64)milliseconds
        WorkoutAdvanceElapsed(app, milliseconds)
    }
}
