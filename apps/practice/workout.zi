#if #defined(KRYON_TEST_DRIVER) && #defined(DESKTOP_HOST) && OS == .LINUX {
    #import "test_driver"
    #import "std/c_string"

    WorkoutTestGetEnv :: (name: *u8) -> *u8 #foreign c "app_getenv_bytes";
    WorkoutTestFileAccess :: (path: *u8, mode: s32) -> s32 #foreign c "access";

    WorkoutTestSceneAvailable :: () -> bool {
        if !TestDriverActive() {
            return true
        }
        name: [32]u8
        unused CopyCString("INBE_TEST_WORKOUT_READY_FILE", name[:])
        path := WorkoutTestGetEnv(*name[0])
        return path == null || path[0] == cast(u8)0 || WorkoutTestFileAccess(path, 0) == 0
    }
}
practice_background_start :: (app: *InnerBreeze, id: s32) #foreign c;
practice_active_background_stop :: (app: *InnerBreeze) #foreign c;
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c;
sync_habits_for_activity :: (app: *InnerBreeze, activity: s32) #foreign c;
app_play_bell_cue :: (app: *InnerBreeze, volume: float32) #foreign c;
app_draw_session_exit_modal :: (app: *InnerBreeze, can_save: s32,
    save_message: string, discard_message: string) -> SessionExitModalResult #foreign c;

