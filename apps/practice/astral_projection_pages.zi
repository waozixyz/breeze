// Astral Projection's How to and Customize pages, laid out as the other
// meditation practices' are: a two-page guide, and the music and voice
// narration it plays with.
manual_host :: #system_library "c";
app_start_practice_from_ui :: (app: *InnerBreeze, id: s32) -> bool #foreign manual_host "practice_actions_app_start_practice_from_ui";
