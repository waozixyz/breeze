using AppThemeMode;
using ImageFit;
using ExerciseType;
using ModalType;
using TextAlign;
using TextWrap;

ASTRAL_MANUAL_PAGES :: 2

AstralManualStart :: (app: *InnerBreeze) {
    if app == null { return }
    app.tutorial_step = 0
    app.manual_scroll = 0
    app.practice_tab = PRACTICE_TAB_PLAY
    unused app_start_practice_from_ui(app, EXERCISE_ASTRAL_PROJECTION)
}

AstralManualClose :: (app: *InnerBreeze, mark_seen: s32) {
    if app == null { return }
    if mark_seen != 0 {
        mark_exercise_manual_seen(app, EXERCISE_ASTRAL_PROJECTION)
    }
    if app.modal.active != 0 && app.modal.type == cast(ModalType)ModalPracticeManual {
        app_close_modal(app)
        return
    }
    app.tutorial_step = 0
    app.manual_scroll = 0
    app.practice_tab = PRACTICE_TAB_PLAY
    app_switch_screen(app, ScreenStart)
}

// Practices draws the manual (practice_manual_host.zi).
AstralManualDraw :: (app: *InnerBreeze) {
    action := PracticeManualDraw(app)
    if action == PRACTICE_MANUAL_CLOSE {
        AstralManualClose(app, 0)
    } else if action == PRACTICE_MANUAL_START {
        AstralManualStart(app)
    }
}

// Customize: the music that plays, and the voice narration with its
// language, which Practices draws (practice_settings_host.zi).
AstralConfigDraw :: (app: *InnerBreeze) {
    if PracticeSettingsDraw(app, EXERCISE_ASTRAL_PROJECTION) != 0 {
        PracticeConfigLeave(app, cast(s32)ModalPracticeConfig)
    }
}
