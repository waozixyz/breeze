using ButtonTone;
using ButtonEmphasis;
using TextWrap;
using TextAlign;

// A paid practice this account has not unlocked offers its unlock instead of
// a download, even when its pack is on this device.
PracticeDownloadLocked :: (practice: s32) -> bool {
    product := PracticeProduct(practice)
    return product.count > 0 && !UnlockOwned(product)
}

PracticeDownloadPriceText :: (app: *InnerBreeze, key: string) -> string {
    price: [32]u8
    unused DewFormat(unlock_price, DewUnits, price[:])
    args: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(price[:]), .is_text = true}]
    buffer: [256]u8
    unused FormatTemplate(LocaleText(key), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadPriceHeight :: () -> s32 {
    return AppFontSize() + AppScale(16)
}

// The Dew a paid practice needs, with the regular price struck through
// while the node runs an offer.
PracticeDownloadPrice :: (app: *InnerBreeze, x: s32, y: s32, width: s32) {
    font := AppFontSize() + AppScale(6)
    height := PracticeDownloadPriceHeight()
    text: [32]u8
    unused DewFormat(unlock_price, DewUnits, text[:])
    unused AppAppendText(" Dew", text[:])
    price := FrameTextHold(*app.ui.frame_text, TextUntilNul(text[:]))
    left := x
    if UnlockOffer() {
        regular_text: [32]u8
        unused DewFormat(unlock_regular_price, DewUnits, regular_text[:])
        unused AppAppendText(" Dew", regular_text[:])
        regular := FrameTextHold(*app.ui.frame_text, TextUntilNul(regular_text[:]))
        regular_w := AppTextWidth(regular, AppFontSize())
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)y, cast(float32)regular_w, cast(float32)height},
                .text = regular, .font = AppFontSize(), .vertical_align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapNone, .disabled = true, .strikethrough = true})
        left += regular_w + AppScale(12)
    }
    strong: [1]TextRange = .[TextRange.{.start = 0, .end = cast(s32)price.count}]
    price_w := AppTextWidth(price, font)
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)left, cast(float32)y, cast(float32)price_w, cast(float32)height},
            .text = price, .font = font, .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone, .strong = strong[:]})
    // The discount reads at a glance as a tinted badge, such as -90%.
    if UnlockOffer() && unlock_regular_price > 0 {
        percent := ((unlock_regular_price - unlock_price) * 100 + unlock_regular_price / 2) / unlock_regular_price
        badge_text: [16]u8
        unused AppCopyText("-", badge_text[:])
        number: [8]u8
        unused AppFormatS64(percent, number[:])
        unused AppAppendText(TextUntilNul(number[:]), badge_text[:])
        unused AppAppendText("%", badge_text[:])
        badge := FrameTextHold(*app.ui.frame_text, TextUntilNul(badge_text[:]))
        badge_h := AppSmallFontSize() + AppScale(10)
        badge_w := AppTextWidth(badge, AppSmallFontSize()) + AppScale(16)
        left += price_w + AppScale(12)
        tint := StyleTokenColor("accent")
        tint.a = cast(u8)64
        Box(app.ui.session, BoxProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)(y + (height - badge_h) / 2),
                    cast(float32)badge_w, cast(float32)badge_h},
                .fill = tint, .radius = cast(float32)badge_h / 2.0})
        badge_strong: [1]TextRange = .[TextRange.{.start = 0, .end = cast(s32)badge.count}]
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)(y + (height - badge_h) / 2),
                    cast(float32)badge_w, cast(float32)badge_h},
                .text = badge, .font = AppSmallFontSize(), .align = cast(TextAlign)TextAlignCenter,
                .vertical_align = cast(TextAlign)TextAlignCenter, .wrap = cast(TextWrap)TextWrapNone,
                .strong = badge_strong[:]})
    }
}

// The practice alone; its narration languages are chosen below it. Small
// packs show kilobytes instead of a rounded-up megabyte.
PracticeDownloadSizeText :: (app: *InnerBreeze, practice: s32, output: []u8) {
    bytes := PracticeContentBytes(practice)
    small := bytes < 1024 * 1024
    text := LocaleText(ifx PracticeInstalled(practice) && PracticeContentStatus(practice) == 2 then (ifx small then "practice_download_ready_kb" else "practice_download_ready") else
        ifx small then "practice_download_size_kb" else "practice_download_size")
    amount := ifx small then (bytes + 1023) / 1024 else (bytes + 512 * 1024) / (1024 * 1024)
    args: [1]FormatArg = .[FormatArg.{.number = cast(s32)amount}]
    unused FormatTemplate(text, args[:], output)
}

PracticeDownloadStatusText :: (app: *InnerBreeze, practice: s32) -> string {
    buffer: [256]u8
    if PracticeDownloadLocked(practice) {
        // A locked practice shows its size too, under any notice about unlocking.
        notice := ""
        if !DewReady() {
            notice = LocaleText("practice_unlock_account")
        } else if UnlockBuying() {
            notice = LocaleText("practice_unlock_busy")
        } else if unlock_notice.count > 0 {
            notice = LocaleText(unlock_notice)
        }
        if notice.count > 0 {
            unused AppCopyText(notice, buffer[:])
            unused AppAppendText("\n", buffer[:])
        }
        size: [128]u8
        PracticeDownloadSizeText(app, practice, size[:])
        unused AppAppendText(TextUntilNul(size[:]), buffer[:])
        return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
    }
    if PracticePackFind(practice, "") < 0 && PracticeContentReady(practice) {
        return LocaleText("practice_download_included")
    }
    status := PracticeContentStatus(practice)
    if status == 1 || status == 3 {
        return LocaleText(ifx status == 3 then "practice_download_failed" else "practice_download_busy")
    }
    // Shipped with the app: adding it needs no download.
    if status != 2 && !PracticeInstalled(practice) && PracticeShipped(practice) {
        return LocaleText("practice_download_included")
    }
    PracticeDownloadSizeText(app, practice, buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadRowHeight :: (app: *InnerBreeze, practice: s32, width: s32) -> s32 {
    definition := practice_get(practice)
    name := LocaleText(definition.label_key)
    name_h := AppParagraphHeight(name, width, AppFontSize(), AppScale(3))
    narrow := width < AppScale(520)
    status_w := ifx narrow then width else width - AppScale(212)
    status_h := AppParagraphHeight(PracticeDownloadStatusText(app, practice),
        status_w, AppFontSize(), AppScale(3))
    if status_h < AppScale(44) {
        status_h = AppScale(44)
    }
    height := name_h + AppScale(8) + status_h + AppScale(24)
    if PracticeDownloadLocked(practice) {
        height += PracticeDownloadPriceHeight() + AppScale(8)
    }
    included := PracticePackFind(practice, "") < 0 && PracticeContentReady(practice)
    if narrow && !included {
        height += AppScale(52)
    }
    if PracticeDownloadNarrated(practice) {
        height += AppScale(16) + PracticeNarrationBlockHeight(app, practice, width)
    }
    return height
}

PracticeDownloadRow :: (app: *InnerBreeze, practice: s32, x: s32, y: s32, width: s32) {
    definition := practice_get(practice)
    name := LocaleText(definition.label_key)
    name_h := AppParagraphHeight(name, width, AppFontSize(), AppScale(3))
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)name_h},
            .text = name, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    y += name_h + AppScale(8)
    locked := PracticeDownloadLocked(practice)
    if locked {
        PracticeDownloadPrice(app, x, y, width)
        y += PracticeDownloadPriceHeight() + AppScale(8)
    }
    status := PracticeContentStatus(practice)
    narrow := width < AppScale(520)
    status_w := ifx narrow then width else width - AppScale(212)
    text := PracticeDownloadStatusText(app, practice)
    status_h := AppParagraphHeight(text, status_w, AppFontSize(), AppScale(3))
    if status_h < AppScale(44) {
        status_h = AppScale(44)
    }
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)status_w, cast(float32)status_h},
            .text = text, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    button_y := ifx narrow then y + status_h + AppScale(8) else y
    button_w := ifx narrow then width else AppScale(200)
    included := PracticePackFind(practice, "") < 0 && PracticeContentReady(practice)
    if PracticeDownloadNarrated(practice) {
        narration_y := y + status_h + AppScale(16)
        if narrow && !included {
            narration_y += AppScale(52)
        }
        PracticeNarrationBlock(app, practice, x, narration_y, width)
    }
    if locked {
        if DewReady() && Button(app.ui.session, ButtonProps.{
                .id = 17420 + practice,
                .bounds = Rectangle.{cast(float32)(x + width - button_w), cast(float32)button_y,
                    cast(float32)button_w, cast(float32)AppScale(44)},
                .label = PracticeDownloadPriceText(app, "practice_unlock_button"),
                .disabled = practice_active(app) != null || UnlockBuying(),
                .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
            UnlockStart()
        }
    } else if !included && Button(app.ui.session, ButtonProps.{
            .id = 17410 + practice * 2,
            .bounds = Rectangle.{cast(float32)(x + width - button_w), cast(float32)button_y,
                cast(float32)button_w, cast(float32)AppScale(44)},
            .label = LocaleText(ifx status == 2 then "practice_download_remove" else
            ifx status == 1 then "cancel_button" else
            ifx status == 3 then "practice_download_retry" else
            ifx PracticeShipped(practice) then "practice_add_button" else "practice_download_button"),
            .disabled = practice_active(app) != null || (status != 1 && !PracticePackReviewed(practice, "")),
            .tone = cast(ButtonTone)(ifx status == 2 || status == 1 then ButtonToneNeutral else ButtonToneAccent),
            .emphasis = cast(ButtonEmphasis)(ifx status == 2 || status == 1 then ButtonEmphasisSoft else ButtonEmphasisFilled)}) != 0 {
        if status == 2 {
            PracticeContentRemove(practice)
        } else if status == 1 {
            PracticeContentCancel(practice)
        } else {
            if DataTemporary() {
                app.exercise_type = practice
            }
            PracticeContentRequest(practice)
        }
    }
}

// A practice offers narration once it is on this device and unlocked;
// Lumi's guide always does.
PracticeDownloadNarrated :: (content: s32) -> bool {
    if content != PracticeGuide && (!PracticeInstalled(content) || PracticeDownloadLocked(content)) {
        return false
    }
    return PracticeVoiceRecorded(content, PracticeVoiceFor(content))
}

// "Voice narration · Female voice", in the voice chosen in Customize.
PracticeNarrationHeading :: (app: *InnerBreeze, content: s32) -> string {
    buffer: [256]u8
    unused AppCopyText(LocaleText("voice_narration_label"), buffer[:])
    unused AppAppendText(" · ", buffer[:])
    unused AppAppendText(LocaleText(ifx PracticeVoiceFor(content) == "male" then "practice_voice_male" else "practice_voice_female"),
        buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

// What the chips hold: a download in progress, a failure, the languages on
// this device with their size, or how to add one.
PracticeNarrationSummary :: (app: *InnerBreeze, content: s32) -> string {
    voice := PracticeVoiceFor(content)
    busy := ""
    failed := ""
    present: [256]u8
    for rank: cast(s32)0..LocaleLanguageCount() - 1 {
        language := LocaleLanguageAt(rank)
        state := PracticeNarrationState(PracticeNarrationPack(content, language.code, voice))
        if state == 1 && busy.count == 0 {
            busy = language.label
        } else if state == 3 && failed.count == 0 {
            failed = language.label
        } else if state == 2 {
            if present[0] != cast(u8)0 {
                unused AppAppendText(", ", present[:])
            }
            unused AppAppendText(language.label, present[:])
        }
    }
    if busy.count == 0 && failed.count == 0 && present[0] == cast(u8)0 {
        return LocaleText("practice_narration_pick")
    }
    buffer: [512]u8
    if busy.count > 0 || failed.count > 0 {
        args: [1]FormatArg = .[FormatArg.{.text = ifx busy.count > 0 then busy else failed, .is_text = true}]
        unused FormatTemplate(LocaleText(ifx busy.count > 0 then "practice_narration_busy" else "practice_narration_failed"),
            args[:], buffer[:])
        return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 512))
    }
    bytes := PracticeNarrationBytes(content, voice)
    small := bytes < 1024 * 1024
    amount := ifx small then (bytes + 1023) / 1024 else (bytes + 512 * 1024) / (1024 * 1024)
    args: [2]FormatArg = .[FormatArg.{.text = TextUntilNul(present[:]), .is_text = true},
    FormatArg.{.number = cast(s32)amount}]
    unused FormatTemplate(LocaleText(ifx small then "practice_narration_ready_kb" else "practice_narration_ready"),
        args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 512))
}

// One pill per recorded language, in the app's language order, wrapping into
// rows. A tap downloads that language, cancels it, or removes it. Returns
// the height the chips take, and draws them only when asked.
PracticeNarrationChips :: (app: *InnerBreeze, content: s32, x: s32, y: s32, width: s32, draw: bool) -> s32 {
    voice := PracticeVoiceFor(content)
    gap := AppScale(8)
    chip_h := AppScale(44)
    left := x
    top := y
    any := false
    for rank: cast(s32)0..LocaleLanguageCount() - 1 {
        language := LocaleLanguageAt(rank)
        index := PracticeNarrationPack(content, language.code, voice)
        if index < 0 {
            continue
        }
        chip_w := AppTextWidth(language.label, AppFontSize()) + AppScale(36)
        if chip_w > width {
            chip_w = width
        }
        if left > x && left + chip_w > x + width {
            left = x
            top += chip_h + gap
        }
        any = true
        if draw {
            state := PracticeNarrationState(index)
            if Button(app.ui.session, ButtonProps.{
                    .id = 17500 + content * 64 + rank,
                    .bounds = Rectangle.{cast(float32)left, cast(float32)top, cast(float32)chip_w, cast(float32)chip_h},
                    .label = language.label, .pill = true, .selected = state == 2,
                    .disabled = practice_active(app) != null || !PracticeNarrationReviewed(index),
                    // A downloading chip stays tappable to cancel; the line under the chips names it.
                    .tone = cast(ButtonTone)(ifx state == 3 then ButtonToneDanger else
                    ifx state == 2 || state == 1 then ButtonToneAccent else ButtonToneNeutral),
                    .emphasis = cast(ButtonEmphasis)(ifx state == 2 then ButtonEmphasisFilled else ButtonEmphasisSoft)}) != 0 {
                PracticeNarrationToggle(index)
            }
        }
        left += chip_w + gap
    }
    return ifx any then top - y + chip_h else 0
}

PracticeNarrationBlockHeight :: (app: *InnerBreeze, content: s32, width: s32) -> s32 {
    heading_h := AppParagraphHeight(PracticeNarrationHeading(app, content), width, AppFontSize(), AppScale(3))
    summary_h := AppParagraphHeight(PracticeNarrationSummary(app, content), width, AppFontSize(), AppScale(3))
    return heading_h + AppScale(8) + PracticeNarrationChips(app, content, 0, 0, width, false) +
    AppScale(8) + summary_h
}

PracticeNarrationBlock :: (app: *InnerBreeze, content: s32, x: s32, y: s32, width: s32) {
    heading := PracticeNarrationHeading(app, content)
    heading_h := AppParagraphHeight(heading, width, AppFontSize(), AppScale(3))
    strong: [1]TextRange = .[TextRange.{.start = 0, .end = cast(s32)heading.count}]
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)heading_h},
            .text = heading, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto, .strong = strong[:]})
    y += heading_h + AppScale(8)
    y += PracticeNarrationChips(app, content, x, y, width, true) + AppScale(8)
    summary := PracticeNarrationSummary(app, content)
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width,
                cast(float32)AppParagraphHeight(summary, width, AppFontSize(), AppScale(3))},
            .text = summary, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
}

// Lumi's guide has no practice to download, only its narration.
PracticeGuideRowHeight :: (app: *InnerBreeze, width: s32) -> s32 {
    name_h := AppParagraphHeight(LocaleText("lumi_guide_narration_name"), width, AppFontSize(), AppScale(3))
    return name_h + AppScale(8) + PracticeNarrationBlockHeight(app, PracticeGuide, width) + AppScale(24)
}

PracticeGuideRow :: (app: *InnerBreeze, x: s32, y: s32, width: s32) {
    name := LocaleText("lumi_guide_narration_name")
    name_h := AppParagraphHeight(name, width, AppFontSize(), AppScale(3))
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)name_h},
            .text = name, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    PracticeNarrationBlock(app, PracticeGuide, x, y + name_h + AppScale(8), width)
}

#program_export
PracticeDownloadsModalDraw :: (app: *InnerBreeze) {
    PracticeContentReviewNext()
    UnlockRefresh()
    // A finished unlock downloads what it unlocked.
    if UnlockTakeBought() {
        for practice: cast(s32)0..cast(s32)4 {
            if PracticeProduct(practice) == UnlockTaiChi {
                PracticeContentRequest(practice)
            }
        }
    }
    width := app.ui.view_width - AppScale(32)
    if width > AppScale(720) {
        width = AppScale(720)
    }
    height := app.ui.view_height - AppScale(48)
    if height > AppScale(720) {
        height = AppScale(720)
    }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("practices/downloads/modal"), .title = LocaleText("practice_manage_button"),
            .width = width, .height = height, .scale = MetricsScale(),
            .title_at_start = true, .strong_title = true,
            .has_right_action = true, .right_label = LocaleText("close_button")})
    if frame.dismissed || frame.right_clicked {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    row_width := cast(s32)frame.layout.content.width - AppScale(10)
    content_h: s32 = 0
    focus_y: s32 = 0
    for practice: cast(s32)0..cast(s32)4 {
        if PracticeHidden(practice) {
            continue
        }
        if app.practice_downloads_scroll == -(practice + 1) {
            focus_y = content_h
        }
        content_h += PracticeDownloadRowHeight(app, practice, row_width)
    }
    guide := PracticeDownloadNarrated(PracticeGuide)
    if guide {
        content_h += PracticeGuideRowHeight(app, row_width)
    }
    if app.practice_downloads_scroll < 0 {
        app.practice_downloads_scroll = focus_y
    }
    scroll := Scroll(app.ui.session, ScrollProps.{
            .key = KeyHash("practices/downloads/scroll"), .bounds = frame.layout.content,
            .content_height = content_h, .scroll_offset = app.practice_downloads_scroll})
    app.practice_downloads_scroll = scroll.scroll_offset
    if scroll.opened {
        y := cast(s32)scroll.content.y
        for practice: cast(s32)0..cast(s32)4 {
            if PracticeHidden(practice) {
                continue
            }
            PracticeDownloadRow(app, practice, cast(s32)scroll.content.x, y, row_width)
            y += PracticeDownloadRowHeight(app, practice, row_width)
        }
        if guide {
            PracticeGuideRow(app, cast(s32)scroll.content.x, y, row_width)
        }
        End(app.ui.session)
    }
    End(app.ui.session)
}
