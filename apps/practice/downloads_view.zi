// What a practice's card on Practice offers when the practice is not ready:
// Install with its size, Unlock with its price for a paid practice, or
// Cancel while it downloads; practices that come with the app are always
// ready.
#import "entity/dew_model"
#import, file "../../src/app/app_types.zi";
#import, file "../../src/app/app_modal_state.zi";
#import, file "../../src/app/app_settings.zi";
#import, file "../../src/app/exercise_types.zi";
#import, file "../../src/app/color.zi";
#import, file "../../src/app/locale.zi";
#import, file "../../src/app/metrics.zi";
#import, file "../../src/app/text_buffers.zi";
#import, file "../../src/practices/practice_registry.zi";
#import, file "../../src/practices/practice_downloads.zi";
#import, file "../../src/storage/temporary_data.zi";
#import, file "../../src/storage/dew.zi";
#import, file "../../src/storage/practice_unlocks.zi";
#import, file "../../src/screens/dew_worth.zi";
#import "text_buffer"
#import "box_props"
#import "box_widget"
#import "drawing_props"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "geometry"
#import "paint_queue"
#import "text_props"
#import "text_align"
#import "text_widget"
#import "tree"
#import "session"
#import "layout"

using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using TextWrap;
using TextAlign;

// The one thing a card's download button does.
PRACTICE_ACTION_NONE :: 0
PRACTICE_ACTION_INSTALL :: 1
PRACTICE_ACTION_BUY :: 2
PRACTICE_ACTION_CANCEL :: 3

// A paid practice this account has not unlocked offers its unlock instead of
// a download, even when its pack is on this device.
PracticeDownloadLocked :: (practice: s32) -> bool {
    product := PracticeProduct(practice)
    return product.count > 0 && !UnlockOwned(product)
}

PracticeDownloadPriceText :: (app: *InnerBreeze, key: string) -> string {
    price: [32]u8
    unused DewFormat(unlock_price, DewUnits, price[:])
    args: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(price[:]), .is_text = true}]
    buffer: [256]u8
    unused FormatTemplate(LocaleText(key), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadPriceRowHeight :: () -> s32 {
    return AppSmallFontSize() + AppScale(12)
}

// The offer row, with what the price is worth under it once the node's
// rates are known.
PracticeDownloadPriceHeight :: () -> s32 {
    height: s32 = 0
    if UnlockOffer() && unlock_regular_price > 0 {
        height = PracticeDownloadPriceRowHeight()
    }
    worth: [128]u8
    if DewWorthText(unlock_price, worth[:]) {
        height += AppSmallFontSize() + AppScale(6)
    }
    return height
}

// The Unlock button says the price; during an offer the regular price is
// struck through beside its discount badge, such as -90%.
PracticeDownloadPrice :: (app: *InnerBreeze, x: s32, y: s32, width: s32) {
    DewRatesRefresh()
    font := AppSmallFontSize()
    height: s32 = 0
    if UnlockOffer() && unlock_regular_price > 0 {
        height = PracticeDownloadPriceRowHeight()
        regular_text: [32]u8
        unused DewFormat(unlock_regular_price, DewUnits, regular_text[:])
        unused AppAppendText(" Dew", regular_text[:])
        regular := FrameTextHold(*app.ui.frame_text, TextUntilNul(regular_text[:]))
        regular_w := AppTextWidth(regular, font)
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)regular_w, cast(float32)height},
                .text = regular, .font = font, .vertical_align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapNone, .disabled = true, .strikethrough = true})
        percent := ((unlock_regular_price - unlock_price) * 100 + unlock_regular_price / 2) / unlock_regular_price
        badge_text: [16]u8
        unused AppCopyText("-", badge_text[:])
        number: [8]u8
        unused AppFormatS64(percent, number[:])
        unused AppAppendText(TextUntilNul(number[:]), badge_text[:])
        unused AppAppendText("%", badge_text[:])
        badge := FrameTextHold(*app.ui.frame_text, TextUntilNul(badge_text[:]))
        badge_h := font + AppScale(8)
        badge_w := AppTextWidth(badge, font) + AppScale(14)
        left := x + regular_w + AppScale(10)
        tint := StyleTokenColor("accent")
        tint.a = cast(u8)64
        Box(app.ui.session, BoxProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)(y + (height - badge_h) / 2),
                    cast(float32)badge_w, cast(float32)badge_h},
                .fill = tint, .radius = cast(float32)badge_h / 2.0})
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)(y + (height - badge_h) / 2),
                    cast(float32)badge_w, cast(float32)badge_h},
                .text = badge, .font = font, .align = cast(TextAlign)TextAlignCenter,
                .vertical_align = cast(TextAlign)TextAlignCenter, .wrap = cast(TextWrap)TextWrapNone})
    }
    worth: [128]u8
    if DewWorthText(unlock_price, worth[:]) {
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)(y + height),
                    cast(float32)width, cast(float32)(font + AppScale(6))},
                .text = FrameTextHold(*app.ui.frame_text, TextUntilNul(worth[:])),
                .font = font, .vertical_align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapNone})
    }
}

// Narration follows its practice in the language it speaks, so it counts in
// the size.
PracticeDownloadBytes :: (app: *InnerBreeze, practice: s32) -> s64 {
    bytes := PracticeContentBytes(practice)
    if app.voice_narration_enabled != 0 {
        bytes += PracticeNarrationFollowingBytes(practice)
    }
    return bytes
}

// Small packs show kilobytes instead of a rounded-up megabyte.
PracticeDownloadSmall :: (bytes: s64) -> bool {
    return bytes < 1024 * 1024
}

PracticeDownloadAmount :: (bytes: s64) -> s32 {
    if PracticeDownloadSmall(bytes) {
        return cast(s32)((bytes + 1023) / 1024)
    }
    return cast(s32)((bytes + 512 * 1024) / (1024 * 1024))
}

// A practice's size, such as "12 MB" or "596 KB".
PracticeDownloadSize :: (app: *InnerBreeze, practice: s32, output: []u8) {
    bytes := PracticeDownloadBytes(app, practice)
    args: [1]FormatArg = .[FormatArg.{.number = PracticeDownloadAmount(bytes)}]
    unused FormatTemplate(LocaleText(ifx PracticeDownloadSmall(bytes) then "practice_size_kb" else "practice_size_mb"),
        args[:], output)
}

// Content from an older app package, without a pack of its own: on Practice,
// with nothing to manage.
PracticeDownloadIncluded :: (practice: s32) -> bool {
    return PracticePackFind(practice, "") < 0 && PracticeContentReady(practice)
}

// A downloaded copy can be deleted to free its space; a practice that ships
// with the app cannot.
PracticeDownloadStored :: (practice: s32) -> bool {
    return !PracticeDownloadLocked(practice) && !PracticeDownloadIncluded(practice) &&
    !PracticeShipped(practice) && PracticeContentStatus(practice) == 2
}

// Ready to start: on this device, unlocked when it is paid.
PracticeDownloadReady :: (practice: s32) -> bool {
    if PracticeDownloadLocked(practice) {
        return false
    }
    return PracticeDownloadIncluded(practice) || (PracticeInstalled(practice) && PracticeContentReady(practice))
}

// What the card offers in place of Start: Unlock for a paid practice not
// unlocked yet, Cancel while it downloads, Install otherwise, and nothing
// once it is ready.
PracticeDownloadAction :: (practice: s32) -> s32 {
    if PracticeDownloadLocked(practice) {
        return PRACTICE_ACTION_BUY
    }
    if PracticeDownloadReady(practice) {
        return PRACTICE_ACTION_NONE
    }
    if PracticeContentStatus(practice) == 1 {
        return PRACTICE_ACTION_CANCEL
    }
    return PRACTICE_ACTION_INSTALL
}

// The line under a practice's description: how its download is going.
PracticeDownloadLine :: (app: *InnerBreeze, practice: s32) -> string {
    unused app
    status := PracticeContentStatus(practice)
    if status == 1 {
        return LocaleText("practice_download_busy")
    }
    if status == 3 {
        return LocaleText("practice_download_failed")
    }
    return ""
}

// Why a paid practice cannot be unlocked yet, or nothing.
PracticeDownloadNote :: (practice: s32) -> string {
    if !PracticeDownloadLocked(practice) {
        return ""
    }
    if !DewReady() {
        return LocaleText("practice_unlock_account")
    }
    if UnlockBuying() {
        return LocaleText("practice_unlock_busy")
    }
    if unlock_notice.count > 0 {
        return LocaleText(unlock_notice)
    }
    return ""
}

PracticeDownloadActionLabel :: (app: *InnerBreeze, practice: s32, action: s32) -> string {
    if action == PRACTICE_ACTION_BUY {
        return PracticeDownloadPriceText(app, "practice_unlock_button")
    }
    if action == PRACTICE_ACTION_CANCEL {
        return LocaleText("cancel_button")
    }
    // The size rides on the button, so the row's text stays short.
    size: [32]u8
    PracticeDownloadSize(app, practice, size[:])
    label: [128]u8
    unused AppCopyText(LocaleText("practice_install"), label[:])
    unused AppAppendText(" · ", label[:])
    unused AppAppendText(TextUntilNul(size[:]), label[:])
    return FrameTextHold(*app.ui.frame_text, TextUntilNul(label[:]))
}

// Does what a card's download button says.
PracticeDownloadAct :: (app: *InnerBreeze, practice: s32, action: s32) {
    if action == PRACTICE_ACTION_BUY {
        UnlockStart()
    } else if action == PRACTICE_ACTION_CANCEL {
        PracticeContentCancel(practice)
    } else if action == PRACTICE_ACTION_INSTALL {
        if DataTemporary() {
            app.exercise_type = practice
        }
        PracticeContentRequest(practice)
    }
}

// Each frame Practice shows: one stored copy checked, unlocks kept current,
// and a finished unlock downloads what it unlocked.
PracticeDownloadsTick :: () {
    PracticeContentReviewNext()
    UnlockRefresh()
    if UnlockTakeBought() {
        for practice: cast(s32)0..practice_count() - 1 {
            if PracticeProduct(practice) == UnlockTaiChi {
                PracticeContentRequest(practice)
            }
        }
    }
}

// The card's lines under its description: the download's progress or
// failure, the price of a paid practice and why it cannot be unlocked yet.
PracticeCardStatusHeight :: (app: *InnerBreeze, practice: s32, width: s32) -> s32 {
    height: s32 = 0
    line := PracticeDownloadLine(app, practice)
    if line.count > 0 {
        height += AppParagraphHeight(line, width, AppSmallFontSize(), AppScale(3)) + AppScale(4)
    }
    if PracticeDownloadLocked(practice) && PracticeDownloadPriceHeight() > 0 {
        height += PracticeDownloadPriceHeight() + AppScale(4)
    }
    note := PracticeDownloadNote(practice)
    if note.count > 0 {
        height += AppParagraphHeight(note, width, AppSmallFontSize(), AppScale(3)) + AppScale(4)
    }
    return height
}

PracticeCardStatus :: (app: *InnerBreeze, practice: s32, x: s32, y: s32, width: s32) {
    line := PracticeDownloadLine(app, practice)
    if line.count > 0 {
        height := AppParagraphHeight(line, width, AppSmallFontSize(), AppScale(3))
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)(y + AppScale(4)), cast(float32)width, cast(float32)height},
                .text = line, .font = AppSmallFontSize(), .align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapAuto})
        y += height + AppScale(4)
    }
    if PracticeDownloadLocked(practice) && PracticeDownloadPriceHeight() > 0 {
        price_w := width
        if price_w > AppScale(300) {
            price_w = AppScale(300)
        }
        PracticeDownloadPrice(app, x + (width - price_w) / 2, y + AppScale(4), price_w)
        y += PracticeDownloadPriceHeight() + AppScale(4)
    }
    note := PracticeDownloadNote(practice)
    if note.count > 0 {
        height := AppParagraphHeight(note, width, AppSmallFontSize(), AppScale(3))
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)(y + AppScale(4)), cast(float32)width, cast(float32)height},
                .text = note, .font = AppSmallFontSize(), .align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapAuto})
    }
}

// The card's download button in place of Start.
PracticeCardAction :: (app: *InnerBreeze, practice: s32, bounds: Rectangle) {
    action := PracticeDownloadAction(practice)
    if action == PRACTICE_ACTION_NONE {
        return
    }
    disabled := app.modal.active != 0 || practice_active(app) != null
    if action == PRACTICE_ACTION_BUY {
        disabled = disabled || !DewReady() || UnlockBuying()
    } else if action == PRACTICE_ACTION_INSTALL {
        disabled = disabled || !PracticePackReviewed(practice, "")
    }
    cancel := action == PRACTICE_ACTION_CANCEL
    if Button(app.ui.session, ButtonProps.{
            .id = 17410 + practice * 2, .bounds = bounds, .pill = true,
            .label = PracticeDownloadActionLabel(app, practice, action), .disabled = disabled,
            .tone = cast(ButtonTone)(ifx cancel then ButtonToneNeutral else ButtonToneAccent),
            .emphasis = cast(ButtonEmphasis)(ifx cancel then ButtonEmphasisSoft else ButtonEmphasisFilled),
            .size = cast(ControlSize)ControlSizeLarge}) != 0 {
        PracticeDownloadAct(app, practice, action)
    }
}
