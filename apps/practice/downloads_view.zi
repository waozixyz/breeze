// Practice download management, rendered by the current supervising host.
// One list of practices. Each row has one state menu: On Practice, On device
// or Not downloaded, with what each choice does; a paid practice offers its
// unlock instead. A row's handle drags it to another place in the order.
#import, file "../../src/app/app_types.zi";
#import, file "../../src/app/app_modal_state.zi";
#import, file "../../src/app/app_settings.zi";
#import, file "../../src/app/exercise_types.zi";
#import, file "../../src/app/draw.zi";
#import, file "../../src/app/locale.zi";
#import, file "../../src/app/metrics.zi";
#import, file "../../src/app/text_buffers.zi";
#import, file "../../src/practices/practice_registry.zi";
#import, file "../../src/practices/practice_downloads.zi";
#import, file "../../src/storage/temporary_data.zi";
#import, file "../../src/storage/dew.zi";
#import, file "../../src/storage/practice_unlocks.zi";
#import, file "../../src/screens/dew_worth.zi";
#import "text_buffer"
#import "box_props"
#import "box_widget"
#import "drawing_props"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "geometry"
#import "modal_props"
#import "modal_frame_widget"
#import "overlay_props"
#import "overlay_widget"
#import "paint_queue"
#import "reorder"
#import "reorder_widget"
#import "scroll_props"
#import "scroll_widget"
#import "text_props"
#import "text_align"
#import "text_widget"
