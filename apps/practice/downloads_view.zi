using ButtonTone;
using ButtonEmphasis;
using TextWrap;
using TextAlign;

// A paid practice that this account has not unlocked, and that is not on
// this device, offers its unlock instead of a download.
PracticeDownloadLocked :: (practice: s32) -> bool {
    product := PracticeProduct(practice)
    return product.count > 0 && !UnlockOwned(product) && !PracticeInstalled(practice)
}

PracticeDownloadPriceText :: (app: *InnerBreeze, key: string) -> string {
    price: [32]u8
    unused DewFormat(unlock_price, DewUnits, price[:])
    args: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(price[:]), .is_text = true}]
    buffer: [256]u8
    unused FormatTemplate(LocaleText(key), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadPriceHeight :: () -> s32 {
    return AppFontSize() + AppScale(16)
}

// The Dew a paid practice needs, with the regular price struck through
// while the node runs an offer.
PracticeDownloadPrice :: (app: *InnerBreeze, x: s32, y: s32, width: s32) {
    font := AppFontSize() + AppScale(6)
    height := PracticeDownloadPriceHeight()
    text: [32]u8
    unused DewFormat(unlock_price, DewUnits, text[:])
    unused AppAppendText(" Dew", text[:])
    price := FrameTextHold(*app.ui.frame_text, TextUntilNul(text[:]))
    left := x
    if UnlockOffer() {
        regular_text: [32]u8
        unused DewFormat(unlock_regular_price, DewUnits, regular_text[:])
        unused AppAppendText(" Dew", regular_text[:])
        regular := FrameTextHold(*app.ui.frame_text, TextUntilNul(regular_text[:]))
        regular_w := AppTextWidth(regular, AppFontSize())
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)left, cast(float32)y, cast(float32)regular_w, cast(float32)height},
                .text = regular, .font = AppFontSize(), .vertical_align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapNone, .disabled = true, .strikethrough = true})
        left += regular_w + AppScale(12)
    }
    strong: [1]TextRange = .[TextRange.{.start = 0, .end = cast(s32)price.count}]
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)left, cast(float32)y, cast(float32)(x + width - left), cast(float32)height},
            .text = price, .font = font, .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone, .strong = strong[:]})
}

PracticeDownloadStatusText :: (app: *InnerBreeze, practice: s32) -> string {
    if PracticeDownloadLocked(practice) {
        if !DewReady() {
            return LocaleText("practice_unlock_account")
        }
        if UnlockBuying() {
            return LocaleText("practice_unlock_busy")
        }
        if unlock_notice.count > 0 {
            return LocaleText(unlock_notice)
        }
        if UnlockOffer() {
            price: [32]u8
            regular: [32]u8
            unused DewFormat(unlock_price, DewUnits, price[:])
            unused DewFormat(unlock_regular_price, DewUnits, regular[:])
            args: [2]FormatArg = .[FormatArg.{.text = TextUntilNul(price[:]), .is_text = true},
            FormatArg.{.text = TextUntilNul(regular[:]), .is_text = true}]
            buffer: [256]u8
            unused FormatTemplate(LocaleText("practice_unlock_offer"), args[:], buffer[:])
            return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
        }
        return PracticeDownloadPriceText(app, "practice_unlock_status")
    }
    if PracticePackFind(practice, "") < 0 && PracticeContentReady(practice) {
        return LocaleText("practice_download_included")
    }
    status := PracticeContentStatus(practice)
    if status == 1 || status == 3 {
        return LocaleText(ifx status == 3 then "practice_download_failed" else "practice_download_busy")
    }
    // Narration downloads with its practice, so it counts in the size.
    bytes := PracticeContentBytes(practice)
    if app.voice_narration_enabled != 0 && PracticeVoiceStatus(practice) >= 0 {
        bytes += PracticeVoiceBytes(practice)
    }
    // Small packs show kilobytes instead of a rounded-up megabyte.
    small := bytes < 1024 * 1024
    text := LocaleText(ifx status == 2 then (ifx small then "practice_download_ready_kb" else "practice_download_ready") else
        ifx small then "practice_download_size_kb" else "practice_download_size")
    amount := ifx small then (bytes + 1023) / 1024 else (bytes + 512 * 1024) / (1024 * 1024)
    buffer: [256]u8
    args: [1]FormatArg = .[FormatArg.{.number = cast(s32)amount}]
    unused FormatTemplate(text, args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadLanguageText :: (app: *InnerBreeze) -> string {
    buffer: [256]u8
    selected_language := LocaleLanguageAt(LocaleActiveIndex())
    language := selected_language.label
    args: [1]FormatArg = .[FormatArg.{.text = language, .is_text = true}]
    unused FormatTemplate(LocaleText("practice_download_language"), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 256))
}

PracticeDownloadVoiceText :: (practice: s32) -> string {
    voice := PracticeVoiceStatus(practice)
    return LocaleText(ifx voice < 0 then "practice_voice_unavailable" else
        ifx voice == 2 then "practice_voice_ready" else
        ifx voice == 3 then "practice_download_failed" else
        ifx voice == 1 then "practice_voice_busy" else "voice_narration_label")
}

PracticeDownloadRowHeight :: (app: *InnerBreeze, practice: s32, width: s32) -> s32 {
    definition := practice_get(practice)
    name := LocaleText(definition.label_key)
    name_h := AppParagraphHeight(name, width, AppFontSize(), AppScale(3))
    narrow := width < AppScale(520)
    status_w := ifx narrow then width else width - AppScale(212)
    status_h := AppParagraphHeight(PracticeDownloadStatusText(app, practice),
        status_w, AppFontSize(), AppScale(3))
    if status_h < AppScale(44) {
        status_h = AppScale(44)
    }
    height := name_h + AppScale(8) + status_h + AppScale(24)
    if PracticeDownloadLocked(practice) {
        height += PracticeDownloadPriceHeight() + AppScale(8)
    }
    included := PracticePackFind(practice, "") < 0 && PracticeContentReady(practice)
    if narrow && !included {
        height += AppScale(52)
    }
    if PracticeContentName(practice) == "taichi" && app.voice_narration_enabled != 0 &&
    !PracticeDownloadLocked(practice) {
        language_h := AppParagraphHeight(PracticeDownloadLanguageText(app), width, AppFontSize(), AppScale(3))
        voice_h := AppParagraphHeight(PracticeDownloadVoiceText(practice), status_w, AppFontSize(), AppScale(3))
        if voice_h < AppScale(44) {
            voice_h = AppScale(44)
        }
        height += language_h + AppScale(8) + voice_h + AppScale(12)
        if narrow {
            height += AppScale(52)
        }
    }
    return height
}

PracticeDownloadRow :: (app: *InnerBreeze, practice: s32, x: s32, y: s32, width: s32) {
    definition := practice_get(practice)
    name := LocaleText(definition.label_key)
    name_h := AppParagraphHeight(name, width, AppFontSize(), AppScale(3))
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)name_h},
            .text = name, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    y += name_h + AppScale(8)
    locked := PracticeDownloadLocked(practice)
    if locked {
        PracticeDownloadPrice(app, x, y, width)
        y += PracticeDownloadPriceHeight() + AppScale(8)
    }
    status := PracticeContentStatus(practice)
    narrow := width < AppScale(520)
    status_w := ifx narrow then width else width - AppScale(212)
    text := PracticeDownloadStatusText(app, practice)
    status_h := AppParagraphHeight(text, status_w, AppFontSize(), AppScale(3))
    if status_h < AppScale(44) {
        status_h = AppScale(44)
    }
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)status_w, cast(float32)status_h},
            .text = text, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    button_y := ifx narrow then y + status_h + AppScale(8) else y
    button_w := ifx narrow then width else AppScale(200)
    included := PracticePackFind(practice, "") < 0 && PracticeContentReady(practice)
    if locked {
        if DewReady() && Button(app.ui.session, ButtonProps.{
                .id = 17420 + practice,
                .bounds = Rectangle.{cast(float32)(x + width - button_w), cast(float32)button_y,
                    cast(float32)button_w, cast(float32)AppScale(44)},
                .label = PracticeDownloadPriceText(app, "practice_unlock_button"),
                .disabled = practice_active(app) != null || UnlockBuying(),
                .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
            UnlockStart()
        }
    } else if !included && Button(app.ui.session, ButtonProps.{
            .id = 17410 + practice * 2,
            .bounds = Rectangle.{cast(float32)(x + width - button_w), cast(float32)button_y,
                cast(float32)button_w, cast(float32)AppScale(44)},
            .label = LocaleText(ifx status == 2 then "practice_download_remove" else
            ifx status == 1 then "cancel_button" else
            ifx status == 3 then "practice_download_retry" else "practice_download_button"),
            .disabled = practice_active(app) != null || (status != 1 && !PracticePackReviewed(practice, "")),
            .tone = cast(ButtonTone)(ifx status == 2 || status == 1 then ButtonToneNeutral else ButtonToneAccent),
            .emphasis = cast(ButtonEmphasis)(ifx status == 2 || status == 1 then ButtonEmphasisSoft else ButtonEmphasisFilled)}) != 0 {
        if status == 2 {
            PracticeContentRemove(practice)
        } else if status == 1 {
            PracticeContentCancel(practice)
        } else {
            if DataTemporary() {
                app.exercise_type = practice
            }
            PracticeContentRequest(practice, app.voice_narration_enabled != 0)
        }
    }
    if PracticeContentName(practice) != "taichi" || app.voice_narration_enabled == 0 || locked {
        return
    }
    y += status_h + AppScale(12)
    if narrow && !included {
        y += AppScale(52)
    }
    language := PracticeDownloadLanguageText(app)
    language_h := AppParagraphHeight(language, width, AppFontSize(), AppScale(3))
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)language_h},
            .text = language, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    y += language_h + AppScale(8)
    voice := PracticeVoiceStatus(practice)
    voice_label := PracticeDownloadVoiceText(practice)
    voice_h := AppParagraphHeight(voice_label, status_w, AppFontSize(), AppScale(3))
    if voice_h < AppScale(44) {
        voice_h = AppScale(44)
    }
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)status_w, cast(float32)voice_h},
            .text = voice_label, .font = AppFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
    button_y = ifx narrow then y + voice_h + AppScale(8) else y
    if status == 2 && (voice == 0 || voice == 1 || voice == 3) && Button(app.ui.session, ButtonProps.{
            .id = 17411 + practice * 2,
            .bounds = Rectangle.{cast(float32)(x + width - button_w), cast(float32)button_y,
                cast(float32)button_w, cast(float32)AppScale(44)},
            .label = LocaleText(ifx voice == 1 then "cancel_button" else
            ifx voice == 3 then "practice_voice_retry" else "practice_voice_download"),
            .disabled = practice_active(app) != null ||
            (voice != 1 && !PracticePackReviewed(practice, LocaleActiveCode())),
            .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        if voice == 1 {
            PracticeContentCancel(practice)
        } else {
            if DataTemporary() {
                app.exercise_type = practice
            }
            PracticeContentRequest(practice, true)
        }
    }
}

#program_export
PracticeDownloadsModalDraw :: (app: *InnerBreeze) {
    PracticeContentReviewNext()
    UnlockRefresh()
    // A finished unlock downloads what it unlocked.
    if UnlockTakeBought() {
        for practice: cast(s32)0..cast(s32)4 {
            if PracticeProduct(practice) == UnlockTaiChi {
                PracticeContentRequest(practice, app.voice_narration_enabled != 0)
            }
        }
    }
    width := app.ui.view_width - AppScale(32)
    if width > AppScale(720) {
        width = AppScale(720)
    }
    height := app.ui.view_height - AppScale(48)
    if height > AppScale(720) {
        height = AppScale(720)
    }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("practices/downloads/modal"), .title = LocaleText("practice_manage_button"),
            .width = width, .height = height, .scale = MetricsScale(),
            .title_at_start = true, .strong_title = true,
            .has_right_action = true, .right_label = LocaleText("close_button")})
    if frame.dismissed || frame.right_clicked {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    row_width := cast(s32)frame.layout.content.width - AppScale(10)
    content_h: s32 = 0
    focus_y: s32 = 0
    for practice: cast(s32)0..cast(s32)4 {
        if PracticeHidden(practice) {
            continue
        }
        if app.practice_downloads_scroll == -(practice + 1) {
            focus_y = content_h
        }
        content_h += PracticeDownloadRowHeight(app, practice, row_width)
    }
    if app.practice_downloads_scroll < 0 {
        app.practice_downloads_scroll = focus_y
    }
    scroll := Scroll(app.ui.session, ScrollProps.{
            .key = KeyHash("practices/downloads/scroll"), .bounds = frame.layout.content,
            .content_height = content_h, .scroll_offset = app.practice_downloads_scroll})
    app.practice_downloads_scroll = scroll.scroll_offset
    if scroll.opened {
        y := cast(s32)scroll.content.y
        for practice: cast(s32)0..cast(s32)4 {
            if PracticeHidden(practice) {
                continue
            }
            PracticeDownloadRow(app, practice, cast(s32)scroll.content.x, y, row_width)
            y += PracticeDownloadRowHeight(app, practice, row_width)
        }
        End(app.ui.session)
    }
    End(app.ui.session)
}
