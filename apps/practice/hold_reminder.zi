// Reminders follow the elapsed hold, independently of the breathing rounds.
HoldReminderResult :: struct {
    last_bucket: s32
    ring: bool
}

HoldReminderSeconds :: (seconds: s32) -> s32 {
    if seconds == 30 || seconds == 60 {
        return seconds
    }
    return 0
}

HoldReminderAdvance :: (holding: bool, seconds: s32,
    interval: s32, last_bucket: s32) -> HoldReminderResult {
    result: HoldReminderResult
    interval = HoldReminderSeconds(interval)
    if !holding || interval == 0 || seconds < 0 {
        return result
    }
    result.last_bucket = last_bucket
    bucket := seconds / interval
    if bucket > 0 && bucket > last_bucket {
        result.last_bucket = bucket
        result.ring = true
    }
    return result
}
