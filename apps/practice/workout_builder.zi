// The Custom workout editor: saved routines, and a routine built from
// exercise blocks and repeating groups. Each block shows its exercise's
// figure, name and length; tapping one opens its length, rest and form.
#import, file "workout_plan.zi";
#import, file "workout_sequence.zi";
#import, file "workout_rules.zi";
#import, file "workout_moves.zi";
#import, file "workout_transitions.zi";
#import, file "../../src/app/app_types.zi";
#import, file "../../src/app/locale.zi";
#import, file "../../src/app/metrics.zi";
#import, file "../../src/app/cards.zi";
#import, file "../../src/app/text_buffers.zi";
#import, file "../../src/platform/host_clock.zi";
#import, file "../../src/platform/text_input_host.zi";
#import, file "../../src/practices/practice_figure_draw.zi";
#import, file "../../src/practices/practice_movement_host.zi";
#import, file "../../src/practices/tai_chi/tai_chi_solve.zi";
#import, file "../../src/storage/state.zi";
#import, file "../../src/storage/storage_settings.zi";
#import "byte_text_linux"
#import "std/format"
#import "std/text_tools"
#import "text_buffer"
#import "geometry"
#import "control_props"
#import "drawing_props"
#import "text_align"
#import "kryon/tree"
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Layout :: #import "kryon/layout";
Scroll :: #import "kryon/scroll";
Sortable :: #import "kryon/sortable";
Spinbox :: #import "kryon/spinbox";
Text :: #import "kryon/text";
TextField :: #import "kryon/text_field";

using ButtonTone;
using ButtonEmphasis;
using TextAlign;
using Text.Wrap;

WORKOUT_BUILDER_STAY :: 0
WORKOUT_BUILDER_PLAY :: 1
WORKOUT_BUILDER_LIBRARY :: 0
WORKOUT_BUILDER_EDITOR :: 1
WORKOUT_BUILDER_PICKER :: 2

WORKOUT_BUILDER_ROW_BLOCK :: 0
WORKOUT_BUILDER_ROW_GROUP :: 1
WORKOUT_BUILDER_ROW_END :: 2
WORKOUT_BUILDER_ROW_LIMIT :: 48
WORKOUT_BUILDER_NAME_FIELD :: 28910

// One drawn row of the routine: a block, a group's header, or the end of a
// group. `y` is from the top of the list; `height` includes an open panel.
WorkoutBuilderRow :: struct {
    kind: s32
    node: s32
    depth: s32
    y: s32
    height: s32
    face: s32
    // On a group's header, the row that ends it.
    end: s32
}

WorkoutBuilderState :: struct {
    page: s32
    slots: [WORKOUT_CUSTOM_ROUTINE_LIMIT]WorkoutPlan
    occupied: [WORKOUT_CUSTOM_ROUTINE_LIMIT]bool
    // Each slot's stored text, so a save replaces only what was read.
    bases: [WORKOUT_CUSTOM_ROUTINE_LIMIT][WORKOUT_PLAN_TEXT_LIMIT]u8
    base_lengths: [WORKOUT_CUSTOM_ROUTINE_LIMIT]s32
    account: [64]u8
    draft: WorkoutPlan
    slot: s32
    // The block or group whose settings are open, or -1.
    selected: s32
    // Choosing blocks to group.
    choosing: bool
    chosen: [WORKOUT_PLAN_NODE_LIMIT]bool
    dirty: bool
    confirm_back: bool
    editor_scroll: s32
    library_scroll: s32
    picker_scroll: s32
    name: TextField.State
    status: string
    rows: [WORKOUT_BUILDER_ROW_LIMIT]WorkoutBuilderRow
    row_count: s32
    // The rows as the drag sees them, and the drag itself.
    sortable: [WORKOUT_BUILDER_ROW_LIMIT]Sortable.Row
    drag: Sortable.State
}

workout_builder: WorkoutBuilderState;
workout_builder_name: [WORKOUT_CUSTOM_NAME_LIMIT]u8;

WorkoutBuilderKey :: (slot: s32) -> string {
    result: Vec(u8)
    BuilderPrint(*result, "workout_custom_v1_%", slot)
    return BuilderFinish(result)
}

WorkoutBuilderBase :: (slot: s32) -> string {
    return TextFromBytes(workout_builder.bases[slot][:workout_builder.base_lengths[slot]])
}

WorkoutBuilderSetBase :: (slot: s32, text: string) {
    length: s32 = 0
    if text.count <= WORKOUT_PLAN_TEXT_LIMIT {
        for byte: text {
            workout_builder.bases[slot][length] = byte
            length += 1
        }
    }
    workout_builder.base_lengths[slot] = length
}

// Routines saved before groups open as top-level blocks; they are written
// in the current format the next time they are saved.
WorkoutBuilderOpen :: () {
    workout_builder = WorkoutBuilderState.{.page = WORKOUT_BUILDER_LIBRARY, .slot = -1, .selected = -1}
    unused AppCopyText(AppTextFromCString(storage_user_id_buffer(), 64), workout_builder.account[:])
    workout_builder.name.bytes = workout_builder_name[:]
    for slot: cast(s32)0..WORKOUT_CUSTOM_ROUTINE_LIMIT - 1 {
        key := WorkoutBuilderKey(slot)
        text := storage_get_setting_text(key)
        workout_builder.occupied[slot] = text.count > 0 || storage_setting_exists(key) != 0
        WorkoutBuilderSetBase(slot, text)
        if text.count > 0 {
            unused WorkoutPlanDecode(text, *workout_builder.slots[slot])
        }
    }
}

WorkoutBuilderSameAccount :: () -> bool {
    return AppTextFromCString(storage_user_id_buffer(), 64) == TextUntilNul(workout_builder.account[:])
}

WorkoutBuilderFieldSet :: (state: *TextField.State, value: string) {
    length: s32 = 0
    for byte: value {
        state.bytes[length] = byte
        length += 1
    }
    state.length = length
    state.cursor = length
    state.anchor = length
    state.scroll_x = 0
    state.focused = false
}

WorkoutBuilderEdit :: (slot: s32) {
    workout_builder.slot = slot
    workout_builder.draft = ifx slot >= 0 then workout_builder.slots[slot] else WorkoutPlan.{}
    workout_builder.page = WORKOUT_BUILDER_EDITOR
    workout_builder.editor_scroll = 0
    workout_builder.dirty = false
    workout_builder.confirm_back = false
    workout_builder.status = ""
    workout_builder.selected = -1
    workout_builder.choosing = false
    workout_builder.chosen = .{}
    name: [WORKOUT_CUSTOM_NAME_LIMIT]u8
    WorkoutBuilderFieldSet(*workout_builder.name, WorkoutPlanName(*workout_builder.draft, name[:]))
}

WorkoutBuilderChanged :: () {
    workout_builder.dirty = true
    workout_builder.confirm_back = false
    workout_builder.status = ""
}

WorkoutBuilderFreeSlot :: () -> s32 {
    for slot: cast(s32)0..WORKOUT_CUSTOM_ROUTINE_LIMIT - 1 {
        if !workout_builder.occupied[slot] {
            return slot
        }
    }
    return -1
}

WorkoutBuilderTypedName :: () -> string {
    return TextTrim(TextFromBytes(workout_builder_name[:workout_builder.name.length]))
}

// The routine as it would be saved or played: named, with at least one
// block, and short enough to play.
WorkoutBuilderTake :: (output: *WorkoutPlan) -> bool {
    if !WorkoutBuilderSameAccount() || workout_builder.draft.count == 0 || !WorkoutPlanTimesOf(*workout_builder.draft).valid {
        return false
    }
    if !WorkoutPlanSetName(*workout_builder.draft, WorkoutBuilderTypedName()) {
        return false
    }
    <<output = workout_builder.draft
    return true
}

WorkoutBuilderStore :: (slot: s32, plan: *WorkoutPlan) -> bool {
    key := WorkoutBuilderKey(slot)
    value := WorkoutPlanEncode(plan)
    if value.count == 0 {
        return false
    }
    storage_settings_begin_write()
    if workout_builder.slot < 0 {
        if storage_setting_exists(key) == 0 && WorkoutBuilderSameAccount() {
            storage_set_setting_text(key, value)
        }
    } else if storage_setting_text_equals(key, WorkoutBuilderBase(slot)) != 0 && WorkoutBuilderSameAccount() {
        storage_set_setting_text(key, value)
    }
    storage_settings_end_write()
    stored := WorkoutBuilderSameAccount() && storage_setting_text_equals(key, value) != 0
    if stored {
        WorkoutBuilderSetBase(slot, value)
    }
    return stored
}

WorkoutBuilderSave :: () {
    plan: WorkoutPlan
    if !WorkoutBuilderTake(*plan) {
        workout_builder.status = "workout_custom_invalid"
        if workout_builder.draft.count > 0 && !WorkoutPlanTimesOf(*workout_builder.draft).valid {
            workout_builder.status = "workout_custom_too_long"
        }
        return
    }
    slot := workout_builder.slot
    if slot < 0 {
        slot = WorkoutBuilderFreeSlot()
    }
    if slot < 0 {
        workout_builder.status = "workout_custom_full"
        return
    }
    if !WorkoutBuilderStore(slot, *plan) {
        workout_builder.status = "workout_custom_save_failed"
        return
    }
    workout_builder.slot = slot
    workout_builder.slots[slot] = plan
    workout_builder.occupied[slot] = true
    workout_builder.dirty = false
    workout_builder.confirm_back = false
    workout_builder.status = "workout_custom_saved"
}

WorkoutBuilderExercise :: (app: *InnerBreeze, exercise: s32) -> string {
    key: [64]u8
    return WorkoutText(app, WorkoutKeyFor("workout_name_", exercise, key[:]))
}

WorkoutBuilderVariantKey :: (variant: s32) -> string {
    if variant == WORKOUT_CUSTOM_LEFT {
        return "workout_custom_left"
    }
    if variant == WORKOUT_CUSTOM_RIGHT {
        return "workout_custom_right"
    }
    if variant == WORKOUT_CUSTOM_SHALLOW {
        return "workout_custom_shallow"
    }
    return "workout_custom_standard"
}

WorkoutBuilderVariantCount :: (exercise: s32) -> s32 {
    count: s32 = 0
    for variant: cast(s32)0..3 {
        if WorkoutBlockSupports(exercise, variant) {
            count += 1
        }
    }
    return count
}

WorkoutBuilderFormat :: (app: *InnerBreeze, key: string, values: []FormatArg) -> string {
    text: [200]u8
    unused FormatTemplate(LocaleText(key), values, text[:])
    return FrameTextHold(*app.ui.frame_text, TextUntilNul(text[:]))
}

// "4:05", kept for this frame.
WorkoutBuilderClock :: (app: *InnerBreeze, seconds: s32) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "%:", seconds / 60)
    BuilderPrint(*text, "%", seconds % 60 / 10)
    BuilderPrint(*text, "%", seconds % 10)
    return FrameTextHold(*app.ui.frame_text, BuilderFinish(text))
}

WorkoutBuilderButtonProps :: (id: u64, bounds: Rectangle, label: string,
    disabled: bool = false, selected: bool = false) -> Button.Props {
    return Button.Props.{.key = Layout.KeyHash("workout/builder") + id,
        .bounds = bounds, .label = label, .disabled = disabled, .selected = selected,
        .tone = cast(ButtonTone)(ifx selected then ButtonToneAccent else ButtonToneNeutral),
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}
}

WorkoutBuilderSlice :: (area: Rectangle, y: s32, height: s32, column: s32 = 0, columns: s32 = 1) -> Rectangle {
    gap := AppScale(6)
    part := (cast(s32)area.width + gap) / columns
    return Rectangle.{area.x + cast(float32)(column * part), area.y + cast(float32)y,
        cast(float32)(part - gap), cast(float32)height}
}

WorkoutBuilderField :: (app: *InnerBreeze, state: *TextField.State, field: s32, bounds: Rectangle, key: string) -> bool {
    typed: [256]u8
    input := SampleTextFieldInput(state.focused, typed[:])
    result := TextField.Draw(app.ui.session, TextField.StateProps(state.*, TextField.Props.{
        .key = Layout.KeyHash(key), .id = field, .focus_id = field, .bounds = bounds,
        .label = LocaleText(key), .placeholder = LocaleText(key), .input = input}))
    if !TextField.StateApplyResult(state, result) {
        return false
    }
    if result.clipboard_write {
        unused TextInputWriteClipboard(result.clipboard_text)
    }
    if result.committed || result.escaped {
        state.focused = false
    }
    return result.edit.changed
}

// --- Sizes ------------------------------------------------------------------------

WorkoutBuilderControl :: () -> s32 {
    return AppScale(48)
}

WorkoutBuilderStride :: () -> s32 {
    return WorkoutBuilderControl() + AppScale(6)
}

WorkoutBuilderTile :: () -> s32 {
    return AppScale(68)
}

WorkoutBuilderIndent :: () -> s32 {
    return AppScale(12)
}

// A block's panel: length and rest, its forms, then its actions.
WorkoutBuilderPanelHeight :: (node: *WorkoutNode) -> s32 {
    stride := WorkoutBuilderStride()
    height := AppScale(6) + AppScale(24) + stride + stride * 2
    if node.kind == WORKOUT_NODE_EXERCISE && WorkoutBuilderVariantCount(node.exercise) > 1 {
        height += stride
    }
    return height
}

// The rows for the draft, top to bottom; returns the list's height.
WorkoutBuilderLayout :: () -> s32 {
    plan := *workout_builder.draft
    gap := AppScale(6)
    y: s32 = 0
    count: s32 = 0
    open: [WORKOUT_PLAN_GROUP_DEPTH + 1]s32
    open_count: s32 = 0
    for index: cast(s32)0..plan.count {
        // Close the groups that end before this node.
        while open_count > 0 && (index == plan.count || WorkoutPlanEnd(plan, workout_builder.rows[open[open_count - 1]].node) <= index) {
            header := open[open_count - 1]
            open_count -= 1
            row := *workout_builder.rows[count]
            row.* = WorkoutBuilderRow.{.kind = WORKOUT_BUILDER_ROW_END, .node = workout_builder.rows[header].node,
                .depth = workout_builder.rows[header].depth, .y = y, .height = AppScale(34), .face = AppScale(34), .end = -1}
            workout_builder.rows[header].end = count
            y += row.height + gap
            count += 1
        }
        if index == plan.count {
            break
        }
        node := *plan.nodes[index]
        group := node.kind == WORKOUT_NODE_GROUP
        face := ifx group then AppScale(52) else WorkoutBuilderTile()
        height := face
        if index == workout_builder.selected && !workout_builder.choosing {
            height += WorkoutBuilderPanelHeight(node)
        }
        workout_builder.rows[count] = WorkoutBuilderRow.{.kind = ifx group then WORKOUT_BUILDER_ROW_GROUP else WORKOUT_BUILDER_ROW_BLOCK,
            .node = index, .depth = node.depth, .y = y, .height = height, .face = face, .end = -1}
        if group && open_count <= WORKOUT_PLAN_GROUP_DEPTH {
            open[open_count] = count
            open_count += 1
        }
        y += height + gap
        count += 1
    }
    workout_builder.row_count = count
    return y
}

// --- Drawing ----------------------------------------------------------------------

// The exercise's own figure in its moving pose, drawn from the current
// figure model. Repeats of a block share one picture.
WorkoutBuilderThumbnail :: (app: *InnerBreeze, exercise: s32, variant: s32, area: Rectangle, copy: s32, alt_text: string) {
    if area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    rig := WorkoutRig()
    block := WorkoutBlock.{exercise, WORKOUT_CUSTOM_DEFAULT_SECONDS, variant, 0}
    pose := WorkoutCustomKey(block, ifx WorkoutCustomCycleCount(block) > 1 then 1 else 0).pose
    // A tile is square: standing moves fill it, floor moves keep their length.
    framing := WorkoutFramingFor(exercise)
    support := WorkoutBlockSupport(exercise)
    upright := support == WORKOUT_SUPPORT_UPRIGHT || support == WORKOUT_SUPPORT_WALL
    framing.view_height *= ifx upright then 0.62 else 0.9
    solved := WorkoutSolve(*pose, *rig)
    picture := cast(u64)(exercise * 4 + variant)
    key := Layout.KeyHash("workout/builder/figure") + picture + cast(u64)copy * 128
    unused PracticeFigureDrawModel(app.ui.session, *solved, *rig, framing, app.workout_character == 1, false, area,
        key, alt_text, -1.0, WorkoutPoseDigest(*pose, picture + 11),
        PracticeFigurePlacement.{.training = true, .training_shorts = true})
}

WorkoutBuilderCard :: (app: *InnerBreeze, key: u64, bounds: Rectangle, selected: bool, fill: string) {
    border := StyleTokenColor(ifx selected then "accent" else "text")
    if !selected {
        border.a = cast(u8)46
    }
    Box.Draw(app.ui.session, Box.Props.{.key = key, .bounds = bounds, .fill = StyleTokenColor(fill),
        .border = border, .radius = cast(float32)AppScale(12)})
}

WorkoutBuilderDetail :: (app: *InnerBreeze, node: *WorkoutNode) -> string {
    value: [1]FormatArg = .[.{.number = node.seconds}]
    seconds := WorkoutBuilderFormat(app, "workout_custom_seconds_value", value[:])
    if node.rest > 0 {
        args: [2]FormatArg = .[.{.text = seconds, .is_text = true}, .{.number = node.rest}]
        seconds = WorkoutBuilderFormat(app, "workout_custom_block_rest", args[:])
    }
    if WorkoutBuilderVariantCount(node.exercise) > 1 || node.variant != WORKOUT_CUSTOM_ORDINARY {
        joined: Vec(u8)
        BuilderPrint(*joined, "% · %", seconds, LocaleText(WorkoutBuilderVariantKey(node.variant)))
        return FrameTextHold(*app.ui.frame_text, BuilderFinish(joined))
    }
    return seconds
}

WorkoutBuilderGroupTitle :: (app: *InnerBreeze, node: *WorkoutNode) -> string {
    title: [WORKOUT_PLAN_TITLE_LIMIT]u8
    text := WorkoutPlanTitle(node, title[:])
    if text.count == 0 {
        return LocaleText("workout_custom_group_name")
    }
    return FrameTextHold(*app.ui.frame_text, text)
}

WorkoutBuilderGroupDetail :: (app: *InnerBreeze, index: s32) -> string {
    plan := *workout_builder.draft
    args: [3]FormatArg = .[.{.number = plan.nodes[index].repeats},
        .{.text = WorkoutBuilderClock(app, WorkoutPlanNodeSeconds(plan, index)), .is_text = true},
        .{.number = WorkoutPlanNodeSteps(plan, index)}]
    return WorkoutBuilderFormat(app, "workout_custom_group_detail", args[:])
}

// Two lines beside a block's figure, or on a group's header.
WorkoutBuilderLabels :: (app: *InnerBreeze, bounds: Rectangle, title: string, detail: string) {
    half := bounds.height / 2.0
    strong: [1]Text.Range = .[.{.start = 0, .end = cast(s32)title.count}]
    Text.Draw(app.ui.session, Text.Props.{.bounds = Rectangle.{bounds.x, bounds.y, bounds.width, half},
        .text = title, .size = AppFontSize(), .strong = strong[:], .vertical_align = cast(TextAlign)TextAlignEnd,
        .wrap = cast(Text.Wrap)TextWrapEllipsis})
    Text.Draw(app.ui.session, Text.Props.{.bounds = Rectangle.{bounds.x, bounds.y + half, bounds.width, half},
        .text = detail, .size = AppSmallFontSize(), .class_name = MutedTextClass(),
        .vertical_align = cast(TextAlign)TextAlignStart, .wrap = cast(Text.Wrap)TextWrapEllipsis})
}

WorkoutBuilderCheck :: (app: *InnerBreeze, key: u64, bounds: Rectangle, chosen: bool) {
    size := cast(float32)AppScale(24)
    mark := Rectangle.{bounds.x + bounds.width - size - cast(float32)AppScale(12), bounds.y + (bounds.height - size) / 2.0,
        size, size}
    Box.Draw(app.ui.session, Box.Props.{.key = key, .bounds = mark,
        .fill = ifx chosen then StyleTokenColor("accent") else StyleTokenColor("surface"),
        .border = StyleTokenColor(ifx chosen then "accent" else "text"), .radius = size / 2.0})
    if chosen {
        dot := size / 3.0
        Box.Draw(app.ui.session, Box.Props.{.key = key + 1, .bounds = Rectangle.{mark.x + dot, mark.y + dot, dot, dot},
            .fill = StyleTokenColor("surface"), .radius = dot / 2.0})
    }
}

// A mouse drags a block as soon as it moves; on a touch screen a swipe
// scrolls and a held block lifts.
WorkoutBuilderTouch :: () -> bool {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_WEB) {
        return true
    }
    return false
}

// The node slot and depth a drop lands at.
WorkoutBuilderDropAt :: (drop: Sortable.Drop) -> (slot: s32, depth: s32) {
    plan := *workout_builder.draft
    if drop.before >= workout_builder.row_count {
        return plan.count, drop.depth
    }
    row := workout_builder.rows[drop.before]
    if row.kind == WORKOUT_BUILDER_ROW_END {
        return WorkoutPlanEnd(plan, row.node), drop.depth
    }
    return row.node, drop.depth
}

// The routine with the lifted row moved to the drop, when it can take it there.
WorkoutBuilderDropped :: (lifted: s32, drop: Sortable.Drop, output: *WorkoutPlan) -> bool {
    if !drop.valid || lifted < 0 || lifted >= workout_builder.row_count {
        return false
    }
    slot, depth := WorkoutBuilderDropAt(drop)
    <<output = workout_builder.draft
    return WorkoutPlanMove(output, workout_builder.rows[lifted].node, slot, depth) && WorkoutPlanTimesOf(output).valid
}

WorkoutBuilderDrop :: (lifted: s32, y: float32) -> bool {
    drop := Sortable.Target(workout_builder.sortable[:workout_builder.row_count], lifted, y,
        cast(float32)WorkoutBuilderIndent())
    moved: WorkoutPlan
    if !WorkoutBuilderDropped(lifted, drop, *moved) {
        return false
    }
    if WorkoutPlanSameNodes(*moved, *workout_builder.draft) {
        return false
    }
    workout_builder.draft = moved
    workout_builder.selected = -1
    WorkoutBuilderChanged()
    return true
}

// A block or group header: tapping it opens its settings, or chooses it
// while grouping, and dragging it moves it. Returns true when a drop changed
// the routine.
WorkoutBuilderPress :: (app: *InnerBreeze, row_index: s32, face: Rectangle, key: u64, label: string, selected: bool) -> bool {
    node := workout_builder.rows[row_index].node
    if workout_builder.choosing {
        if Button.Draw(app.ui.session, Button.Props.{.key = key, .bounds = face, .label = label,
                .invisible = true, .selected = selected}) != 0 {
            WorkoutBuilderTap(node)
        }
        return false
    }
    result := Sortable.Item(app.ui.session, *workout_builder.drag, Sortable.ItemProps.{.key = key, .row = row_index,
        .bounds = face, .label = label, .now = HostSeconds(), .touch = WorkoutBuilderTouch(),
        .slop = cast(float32)AppScale(6)})
    if result.clicked {
        WorkoutBuilderTap(node)
    }
    return result.dropped && WorkoutBuilderDrop(row_index, result.pointer.y)
}

// Tapping a block opens its settings, or chooses it while grouping.
WorkoutBuilderTap :: (index: s32) {
    if workout_builder.choosing {
        workout_builder.chosen[index] = !workout_builder.chosen[index]
        return
    }
    workout_builder.selected = ifx workout_builder.selected == index then -1 else index
}

WorkoutBuilderBlockFace :: (app: *InnerBreeze, row_index: s32, bounds: Rectangle, copy: s32, visible: bool) -> bool {
    row := *workout_builder.rows[row_index]
    plan := *workout_builder.draft
    node := *plan.nodes[row.node]
    selected := row.node == workout_builder.selected && !workout_builder.choosing
    chosen := workout_builder.choosing && workout_builder.chosen[row.node]
    key := Layout.KeyHash("workout/builder/block") + cast(u64)row.node * 8
    name := WorkoutBuilderExercise(app, node.exercise)
    if visible {
        WorkoutBuilderCard(app, key, bounds, selected || chosen, "surface")
    }
    if WorkoutBuilderPress(app, row_index, bounds, key + 1, name, selected || chosen) {
        return true
    }
    if !visible {
        return false
    }
    WorkoutBuilderBlockLabels(app, node, bounds, copy, name)
    if workout_builder.choosing {
        WorkoutBuilderCheck(app, key + 2, bounds, chosen)
    }
    return false
}

// A block's figure, name and length.
WorkoutBuilderBlockLabels :: (app: *InnerBreeze, node: *WorkoutNode, bounds: Rectangle, copy: s32, name: string) {
    pad := cast(float32)AppScale(6)
    size := bounds.height - pad * 2.0
    WorkoutBuilderThumbnail(app, node.exercise, node.variant, Rectangle.{bounds.x + pad, bounds.y + pad, size, size}, copy, name)
    left := bounds.x + pad * 2.0 + size
    right := ifx workout_builder.choosing then cast(float32)AppScale(48) else pad * 2.0
    WorkoutBuilderLabels(app, Rectangle.{left, bounds.y + pad, bounds.x + bounds.width - left - right, size},
        name, WorkoutBuilderDetail(app, node))
}

WorkoutBuilderGroupFace :: (app: *InnerBreeze, row_index: s32, bounds: Rectangle) -> bool {
    row := *workout_builder.rows[row_index]
    plan := *workout_builder.draft
    node := *plan.nodes[row.node]
    selected := row.node == workout_builder.selected && !workout_builder.choosing
    chosen := workout_builder.choosing && workout_builder.chosen[row.node]
    key := Layout.KeyHash("workout/builder/group") + cast(u64)row.node * 8
    title := WorkoutBuilderGroupTitle(app, node)
    if selected || chosen {
        WorkoutBuilderCard(app, key, bounds, true, "surface")
    }
    if WorkoutBuilderPress(app, row_index, bounds, key + 1, title, selected || chosen) {
        return true
    }
    WorkoutBuilderGroupLabels(app, row.node, bounds, title)
    if workout_builder.choosing {
        WorkoutBuilderCheck(app, key + 2, bounds, chosen)
    }
    return false
}

WorkoutBuilderGroupLabels :: (app: *InnerBreeze, index: s32, bounds: Rectangle, title: string) {
    pad := cast(float32)AppScale(12)
    right := ifx workout_builder.choosing then cast(float32)AppScale(48) else pad
    WorkoutBuilderLabels(app, Rectangle.{bounds.x + pad, bounds.y + cast(float32)AppScale(4), bounds.width - pad - right,
        bounds.height - cast(float32)AppScale(8)}, title, WorkoutBuilderGroupDetail(app, index))
}

// The end of a group: how often it repeats and the rest between rounds.
WorkoutBuilderGroupEnd :: (app: *InnerBreeze, row: *WorkoutBuilderRow, bounds: Rectangle) {
    node := *workout_builder.draft.nodes[row.node]
    args: [2]FormatArg = .[.{.number = node.repeats}, .{.number = node.rest}]
    Text.Draw(app.ui.session, Text.Props.{.bounds = Rectangle.{bounds.x + cast(float32)AppScale(12), bounds.y,
        bounds.width - cast(float32)AppScale(24), bounds.height},
        .text = WorkoutBuilderFormat(app, "workout_custom_group_end", args[:]), .size = AppSmallFontSize(),
        .class_name = MutedTextClass(), .vertical_align = cast(TextAlign)TextAlignCenter,
        .wrap = cast(Text.Wrap)TextWrapEllipsis})
}

WorkoutBuilderSpin :: (app: *InnerBreeze, id: u64, bounds: Rectangle, label: string, value: s32,
    minimum: s32, maximum: s32, step: s32, value_key: string) -> s32 {
    Text.Draw(app.ui.session, Text.Props.{.bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)AppScale(24)},
        .text = label, .size = AppSmallFontSize(), .wrap = cast(Text.Wrap)TextWrapEllipsis})
    shown: [1]FormatArg = .[.{.number = value}]
    result := Spinbox.Draw(app.ui.session, Spinbox.Props.{.key = Layout.KeyHash("workout/builder/spin") + id,
        .bounds = Rectangle.{bounds.x, bounds.y + cast(float32)AppScale(24), bounds.width, bounds.height - cast(float32)AppScale(24)},
        .label = label, .min = minimum, .max = maximum, .step = step, .value = value,
        .value_text = WorkoutBuilderFormat(app, value_key, shown[:])})
    return ifx result.changed then result.value else value
}

// Moves a block or group before the sibling above it, or after the one
// below it, for keyboards and screen readers.
WorkoutBuilderShift :: (index: s32, down: bool) -> s32 {
    plan := *workout_builder.draft
    depth := plan.nodes[index].depth
    if down {
        next := WorkoutPlanEnd(plan, index)
        if next >= plan.count || plan.nodes[next].depth != depth {
            return -1
        }
        after := WorkoutPlanEnd(plan, next)
        moved := after - (WorkoutPlanEnd(plan, index) - index)
        if !WorkoutPlanMove(plan, index, after, depth) {
            return -1
        }
        return moved
    }
    cursor := index - 1
    while cursor >= 0 && plan.nodes[cursor].depth > depth {
        cursor -= 1
    }
    if cursor < 0 || plan.nodes[cursor].depth != depth || !WorkoutPlanMove(plan, index, cursor, depth) {
        return -1
    }
    return cursor
}

// Returns true when the routine's rows changed, so this frame stops drawing them.
WorkoutBuilderSettings :: (app: *InnerBreeze, index: s32, area: Rectangle) -> bool {
    plan := *workout_builder.draft
    node := *plan.nodes[index]
    group := node.kind == WORKOUT_NODE_GROUP
    stride := WorkoutBuilderStride()
    height := WorkoutBuilderControl()
    spin_h := AppScale(24) + height
    y: s32 = AppScale(6)
    if group {
        repeats := WorkoutBuilderSpin(app, 1, WorkoutBuilderSlice(area, y, spin_h, 0, 2), LocaleText("workout_custom_rounds"),
            node.repeats, 1, WORKOUT_PLAN_REPEAT_MAX, 1, "workout_custom_rounds_value")
        if WorkoutPlanAdjustRepeats(plan, index, repeats - node.repeats) {
            WorkoutBuilderChanged()
        }
        rest := WorkoutBuilderSpin(app, 2, WorkoutBuilderSlice(area, y, spin_h, 1, 2), LocaleText("workout_custom_round_rest"),
            node.rest, 0, WORKOUT_CUSTOM_REST_MAX, 5, "workout_custom_seconds_value")
        if WorkoutPlanAdjustRest(plan, index, rest - node.rest) {
            WorkoutBuilderChanged()
        }
    } else {
        seconds := WorkoutBuilderSpin(app, 3, WorkoutBuilderSlice(area, y, spin_h, 0, 2), LocaleText("workout_custom_length"),
            node.seconds, WORKOUT_CUSTOM_MIN_SECONDS, WORKOUT_CUSTOM_MAX_SECONDS, 5, "workout_custom_seconds_value")
        if WorkoutPlanAdjustSeconds(plan, index, seconds - node.seconds) {
            WorkoutBuilderChanged()
        }
        rest := WorkoutBuilderSpin(app, 4, WorkoutBuilderSlice(area, y, spin_h, 1, 2), LocaleText("workout_custom_rest"),
            node.rest, 0, WORKOUT_CUSTOM_REST_MAX, 5, "workout_custom_seconds_value")
        if WorkoutPlanAdjustRest(plan, index, rest - node.rest) {
            WorkoutBuilderChanged()
        }
    }
    y += spin_h + AppScale(6)
    if !group && WorkoutBuilderVariantCount(node.exercise) > 1 {
        columns := WorkoutBuilderVariantCount(node.exercise)
        column: s32 = 0
        for variant: cast(s32)0..3 {
            if !WorkoutBlockSupports(node.exercise, variant) {
                continue
            }
            if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(cast(u64)(30 + variant), WorkoutBuilderSlice(area, y, height, column, columns),
                LocaleText(WorkoutBuilderVariantKey(variant)), false, node.variant == variant)) != 0 &&
                node.variant != variant && WorkoutPlanSetVariant(plan, index, variant) {
                WorkoutBuilderChanged()
            }
            column += 1
        }
        y += stride
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(21, WorkoutBuilderSlice(area, y, height, 0, 2), LocaleText("move_up_button"))) != 0 {
        moved := WorkoutBuilderShift(index, false)
        if moved >= 0 {
            workout_builder.selected = moved
            WorkoutBuilderChanged()
            return true
        }
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(22, WorkoutBuilderSlice(area, y, height, 1, 2), LocaleText("move_down_button"))) != 0 {
        moved := WorkoutBuilderShift(index, true)
        if moved >= 0 {
            workout_builder.selected = moved
            WorkoutBuilderChanged()
            return true
        }
    }
    y += stride
    columns: s32 = ifx group then 3 else 2
    column: s32 = 0
    if group {
        if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(23, WorkoutBuilderSlice(area, y, height, 0, 3), LocaleText("workout_custom_ungroup"))) != 0 &&
            WorkoutPlanUngroup(plan, index) {
            workout_builder.selected = -1
            WorkoutBuilderChanged()
            return true
        }
        column = 1
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(24, WorkoutBuilderSlice(area, y, height, column, columns), LocaleText("workout_custom_duplicate"),
        !WorkoutBuilderFits(index))) != 0 && WorkoutPlanDuplicate(plan, index) {
        workout_builder.selected = WorkoutPlanEnd(plan, index)
        WorkoutBuilderChanged()
        return true
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(25, WorkoutBuilderSlice(area, y, height, column + 1, columns), LocaleText("workout_custom_remove_block"))) != 0 &&
        WorkoutPlanRemove(plan, index) {
        workout_builder.selected = -1
        WorkoutBuilderChanged()
        return true
    }
    return false
}

// Whether a copy of the node still makes a routine that can play.
WorkoutBuilderFits :: (index: s32) -> bool {
    trial := workout_builder.draft
    return WorkoutPlanDuplicate(*trial, index) && WorkoutPlanTimesOf(*trial).valid
}

// Where new blocks go: after the open block, at the end of the open group,
// or at the end of the routine.
WorkoutBuilderInsertAt :: () -> (slot: s32, depth: s32) {
    plan := *workout_builder.draft
    index := workout_builder.selected
    if index < 0 || index >= plan.count {
        return plan.count, 0
    }
    if plan.nodes[index].kind == WORKOUT_NODE_GROUP {
        return WorkoutPlanEnd(plan, index), plan.nodes[index].depth + 1
    }
    return index + 1, plan.nodes[index].depth
}

WorkoutBuilderTotals :: (app: *InnerBreeze, bounds: Rectangle) {
    times := WorkoutPlanTimesOf(*workout_builder.draft)
    text := LocaleText("workout_custom_empty")
    if times.valid {
        args: [3]FormatArg = .[.{.text = WorkoutBuilderClock(app, times.total_seconds), .is_text = true},
            .{.text = WorkoutBuilderClock(app, times.active_seconds), .is_text = true}, .{.number = times.steps}]
        text = WorkoutBuilderFormat(app, "workout_custom_summary", args[:])
    } else if workout_builder.draft.count > 0 {
        text = LocaleText("workout_custom_too_long")
    }
    Text.Draw(app.ui.session, Text.Props.{.bounds = bounds, .text = text, .size = AppFontSize(),
        .vertical_align = cast(TextAlign)TextAlignCenter, .wrap = cast(Text.Wrap)TextWrapAuto})
}

WorkoutBuilderList :: (app: *InnerBreeze, area: Rectangle, stride: s32, height: s32) -> s32 {
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(2, WorkoutBuilderSlice(area, 0, height), LocaleText("workout_custom_new"),
        WorkoutBuilderFreeSlot() < 0)) != 0 {
        WorkoutBuilderEdit(-1)
        return WORKOUT_BUILDER_STAY
    }
    y := stride
    for slot: cast(s32)0..WORKOUT_CUSTOM_ROUTINE_LIMIT - 1 {
        if !workout_builder.occupied[slot] {
            continue
        }
        name: [WORKOUT_CUSTOM_NAME_LIMIT]u8
        label := WorkoutPlanName(*workout_builder.slots[slot], name[:])
        if label.count == 0 {
            label = LocaleText("workout_custom_unavailable")
        }
        if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(cast(u64)(40 + slot), WorkoutBuilderSlice(area, y, height),
            FrameTextHold(*app.ui.frame_text, label), workout_builder.slots[slot].count == 0)) != 0 {
            WorkoutBuilderEdit(slot)
            return WORKOUT_BUILDER_STAY
        }
        y += stride
    }
    return WORKOUT_BUILDER_STAY
}

WorkoutBuilderBack :: () -> bool {
    if workout_builder.page == WORKOUT_BUILDER_PICKER {
        workout_builder.page = WORKOUT_BUILDER_EDITOR
    } else if workout_builder.page == WORKOUT_BUILDER_EDITOR {
        if workout_builder.choosing {
            workout_builder.choosing = false
            return false
        }
        if workout_builder.dirty && !workout_builder.confirm_back {
            workout_builder.confirm_back = true
            return false
        }
        workout_builder.page = WORKOUT_BUILDER_LIBRARY
        workout_builder.status = ""
    } else {
        return true
    }
    return false
}

WorkoutBuilderPickerHeight :: () -> s32 {
    stride := WorkoutBuilderStride()
    tile := WorkoutBuilderTile() + AppScale(6)
    height := stride + AppScale(36) + tile * WORKOUT_MOVE_COUNT
    saved: s32 = 0
    for slot: cast(s32)0..WORKOUT_CUSTOM_ROUTINE_LIMIT - 1 {
        if workout_builder.occupied[slot] && workout_builder.slots[slot].count > 0 && slot != workout_builder.slot {
            saved += 1
        }
    }
    if saved > 0 {
        height += AppScale(36) + tile * saved
    }
    return height
}

WorkoutBuilderAdded :: (slot: s32) {
    workout_builder.selected = slot
    workout_builder.page = WORKOUT_BUILDER_EDITOR
    WorkoutBuilderChanged()
}

WorkoutBuilderHeading :: (app: *InnerBreeze, bounds: Rectangle, key: string) {
    text := LocaleText(key)
    strong: [1]Text.Range = .[.{.start = 0, .end = cast(s32)text.count}]
    Text.Draw(app.ui.session, Text.Props.{.bounds = bounds, .text = text, .size = AppFontSize(), .strong = strong[:],
        .vertical_align = cast(TextAlign)TextAlignCenter})
}

// Exercises and saved routines to add as blocks.
WorkoutBuilderPick :: (app: *InnerBreeze, area: Rectangle, bounds: Rectangle) {
    height := WorkoutBuilderControl()
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(3, WorkoutBuilderSlice(area, 0, height), LocaleText("workout_custom_blocks"))) != 0 {
        workout_builder.page = WORKOUT_BUILDER_EDITOR
        return
    }
    slot, depth := WorkoutBuilderInsertAt()
    tile := WorkoutBuilderTile()
    gap := AppScale(6)
    y := WorkoutBuilderStride()
    WorkoutBuilderHeading(app, WorkoutBuilderSlice(area, y, AppScale(30)), "workout_custom_exercises")
    y += AppScale(36)
    for exercise: cast(s32)0..WORKOUT_MOVE_COUNT - 1 {
        tile_bounds := WorkoutBuilderSlice(area, y, tile)
        y += tile + gap
        node := WorkoutPlanExercise(exercise)
        trial := workout_builder.draft
        fits := WorkoutPlanInsert(*trial, slot, depth, node) && WorkoutPlanTimesOf(*trial).valid
        key := Layout.KeyHash("workout/builder/pick") + cast(u64)exercise * 4
        name := WorkoutBuilderExercise(app, exercise)
        // Every exercise stays reachable; only tiles in view draw their figure.
        visible := tile_bounds.y + tile_bounds.height >= bounds.y && tile_bounds.y <= bounds.y + bounds.height
        if visible {
            WorkoutBuilderCard(app, key, tile_bounds, false, "surface")
        }
        if Button.Draw(app.ui.session, Button.Props.{.key = key + 1, .bounds = tile_bounds, .label = name,
                .invisible = true, .disabled = !fits}) != 0 && fits {
            workout_builder.draft = trial
            WorkoutBuilderAdded(slot)
            return
        }
        if !visible {
            continue
        }
        pad := cast(float32)AppScale(6)
        size := tile_bounds.height - pad * 2.0
        WorkoutBuilderThumbnail(app, exercise, node.variant, Rectangle.{tile_bounds.x + pad, tile_bounds.y + pad, size, size}, 0, name)
        left := tile_bounds.x + pad * 2.0 + size
        WorkoutBuilderLabels(app, Rectangle.{left, tile_bounds.y + pad, tile_bounds.x + tile_bounds.width - left - pad, size},
            name, WorkoutBuilderDetail(app, *node))
    }
    heading := false
    for saved: cast(s32)0..WORKOUT_CUSTOM_ROUTINE_LIMIT - 1 {
        routine := *workout_builder.slots[saved]
        if !workout_builder.occupied[saved] || routine.count == 0 || saved == workout_builder.slot {
            continue
        }
        if !heading {
            WorkoutBuilderHeading(app, WorkoutBuilderSlice(area, y, AppScale(30)), "workout_custom_library")
            y += AppScale(36)
            heading = true
        }
        tile_bounds := WorkoutBuilderSlice(area, y, tile)
        y += tile + gap
        trial := workout_builder.draft
        fits := WorkoutPlanInsertRoutine(*trial, slot, depth, routine) && WorkoutPlanTimesOf(*trial).valid
        key := Layout.KeyHash("workout/builder/pick/routine") + cast(u64)saved * 4
        WorkoutBuilderCard(app, key, tile_bounds, false, "surface")
        name_buffer: [WORKOUT_CUSTOM_NAME_LIMIT]u8
        name := FrameTextHold(*app.ui.frame_text, WorkoutPlanName(routine, name_buffer[:]))
        if Button.Draw(app.ui.session, Button.Props.{.key = key + 1, .bounds = tile_bounds, .label = name,
                .invisible = true, .disabled = !fits}) != 0 && fits {
            workout_builder.draft = trial
            WorkoutBuilderAdded(slot)
            return
        }
        pad := cast(float32)AppScale(6)
        size := tile_bounds.height - pad * 2.0
        first := routine.nodes[0]
        cursor: s32 = 0
        while cursor < routine.count && routine.nodes[cursor].kind == WORKOUT_NODE_GROUP {
            cursor += 1
        }
        if cursor < routine.count {
            first = routine.nodes[cursor]
            WorkoutBuilderThumbnail(app, first.exercise, first.variant, Rectangle.{tile_bounds.x + pad, tile_bounds.y + pad, size, size},
                1 + saved, name)
        }
        times := WorkoutPlanTimesOf(routine)
        left := tile_bounds.x + pad * 2.0 + size
        args: [2]FormatArg = .[.{.text = WorkoutBuilderClock(app, times.total_seconds), .is_text = true}, .{.number = times.steps}]
        WorkoutBuilderLabels(app, Rectangle.{left, tile_bounds.y + pad, tile_bounds.x + tile_bounds.width - left - pad, size},
            name, WorkoutBuilderFormat(app, "workout_custom_routine_detail", args[:]))
    }
}

// The rows and their group frames. A copy number tells repeats of the same
// figure apart.
WorkoutBuilderBlocks :: (app: *InnerBreeze, area: Rectangle, top: s32, bounds: Rectangle) -> bool {
    indent := WorkoutBuilderIndent()
    copies: [WORKOUT_MOVE_COUNT * 4]s32
    for row_index: cast(s32)0..workout_builder.row_count - 1 {
        row := *workout_builder.rows[row_index]
        if row.kind != WORKOUT_BUILDER_ROW_GROUP || row.end < 0 {
            continue
        }
        // A group's frame holds its header, contents and end.
        last := *workout_builder.rows[row.end]
        x := area.x + cast(float32)(row.depth * indent)
        frame := Rectangle.{x, area.y + cast(float32)(top + row.y), area.width - cast(float32)(row.depth * indent),
            cast(float32)(last.y + last.height - row.y)}
        fill := StyleTokenColor("accent")
        fill.a = cast(u8)18
        border := StyleTokenColor("accent")
        border.a = cast(u8)110
        Box.Draw(app.ui.session, Box.Props.{.key = Layout.KeyHash("workout/builder/frame") + cast(u64)row.node,
            .bounds = frame, .fill = fill, .border = border, .radius = cast(float32)AppScale(14)})
    }
    for row_index: cast(s32)0..workout_builder.row_count - 1 {
        row := *workout_builder.rows[row_index]
        inset := row.depth * indent
        face := Rectangle.{area.x + cast(float32)inset, area.y + cast(float32)(top + row.y), area.width - cast(float32)inset,
            cast(float32)row.face}
        workout_builder.sortable[row_index] = Sortable.Row.{.bounds = face, .depth = row.depth, .end = row.end,
            .closes = row.kind == WORKOUT_BUILDER_ROW_END, .fixed = row.kind == WORKOUT_BUILDER_ROW_END}
    }
    for row_index: cast(s32)0..workout_builder.row_count - 1 {
        row := *workout_builder.rows[row_index]
        face := workout_builder.sortable[row_index].bounds
        visible := face.y + face.height >= bounds.y && face.y <= bounds.y + bounds.height
        if row.kind == WORKOUT_BUILDER_ROW_BLOCK {
            node := workout_builder.draft.nodes[row.node]
            picture := node.exercise * 4 + node.variant
            copy := copies[picture]
            copies[picture] += 1
            // The lifted block keeps its press while it is scrolled away.
            if WorkoutBuilderBlockFace(app, row_index, face, copy, visible) {
                return true
            }
        } else if row.kind == WORKOUT_BUILDER_ROW_GROUP {
            if WorkoutBuilderGroupFace(app, row_index, face) {
                return true
            }
        } else {
            WorkoutBuilderGroupEnd(app, row, face)
        }
        if row.kind != WORKOUT_BUILDER_ROW_END && row.node == workout_builder.selected && !workout_builder.choosing {
            panel := Rectangle.{face.x, face.y + face.height, face.width, cast(float32)(row.height - row.face)}
            if WorkoutBuilderSettings(app, row.node, panel) {
                return true
            }
        }
    }
    WorkoutBuilderLiftedRow(app)
    return false
}

// The lifted block follows the pointer, and a bar or an outlined group shows
// where it lands. A place the routine cannot take shows nothing.
WorkoutBuilderLiftedRow :: (app: *InnerBreeze) {
    drag := workout_builder.drag
    if !drag.active || !drag.lifted || drag.row < 0 || drag.row >= workout_builder.row_count {
        return
    }
    drop := Sortable.Target(workout_builder.sortable[:workout_builder.row_count], drag.row, drag.pointer.y,
        cast(float32)WorkoutBuilderIndent())
    row := workout_builder.rows[drag.row]
    ghost := Sortable.Lifted(drag)
    key := Layout.KeyHash("workout/builder/lifted")
    WorkoutBuilderCard(app, key, ghost, true, "surface")
    node := *workout_builder.draft.nodes[row.node]
    if row.kind == WORKOUT_BUILDER_ROW_BLOCK {
        WorkoutBuilderBlockLabels(app, node, ghost, WORKOUT_PLAN_NODE_LIMIT, WorkoutBuilderExercise(app, node.exercise))
    } else {
        WorkoutBuilderGroupLabels(app, row.node, ghost, WorkoutBuilderGroupTitle(app, node))
    }
    // The landing place stays visible over the lifted block.
    moved: WorkoutPlan
    if WorkoutBuilderDropped(drag.row, drop, *moved) {
        Sortable.Indicator(app.ui.session, Layout.KeyHash("workout/builder/drop"), drop, StyleTokenColor("accent"),
            cast(float32)AppScale(4), cast(float32)AppScale(12))
    }
}

WorkoutBuilderToolbar :: (app: *InnerBreeze, area: Rectangle, y: s32, height: s32) -> bool {
    if workout_builder.choosing {
        chosen: s32 = 0
        for index: cast(s32)0..workout_builder.draft.count - 1 {
            if workout_builder.chosen[index] {
                chosen += 1
            }
        }
        trial := workout_builder.draft
        grouped := chosen > 0 && WorkoutPlanGroup(*trial, workout_builder.chosen[:]) >= 0 && WorkoutPlanTimesOf(*trial).valid
        if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(8, WorkoutBuilderSlice(area, y, height, 0, 2),
            LocaleText("workout_custom_group"), !grouped, true)) != 0 && grouped {
            workout_builder.selected = WorkoutPlanGroup(*workout_builder.draft, workout_builder.chosen[:])
            workout_builder.choosing = false
            workout_builder.chosen = .{}
            WorkoutBuilderChanged()
            return true
        }
        if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(9, WorkoutBuilderSlice(area, y, height, 1, 2), LocaleText("cancel_button"))) != 0 {
            workout_builder.choosing = false
            workout_builder.chosen = .{}
            return true
        }
        return false
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(7, WorkoutBuilderSlice(area, y, height, 0, 2), LocaleText("workout_custom_add_block"),
        workout_builder.draft.count >= WORKOUT_PLAN_NODE_LIMIT)) != 0 {
        workout_builder.page = WORKOUT_BUILDER_PICKER
        workout_builder.picker_scroll = 0
        return true
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(10, WorkoutBuilderSlice(area, y, height, 1, 2), LocaleText("workout_custom_select"),
        workout_builder.draft.count == 0)) != 0 {
        workout_builder.choosing = true
        workout_builder.chosen = .{}
        workout_builder.selected = -1
        workout_builder.drag = .{}
        return true
    }
    return false
}

// Rows above the blocks: back, name, total, save and start, a status line
// while there is one, and the toolbar.
WorkoutBuilderStatus :: () -> string {
    if workout_builder.status.count == 0 && workout_builder.choosing {
        return "workout_custom_choose"
    }
    return workout_builder.status
}

WorkoutBuilderHeaderHeight :: () -> s32 {
    rows: s32 = ifx WorkoutBuilderStatus().count > 0 then 6 else 5
    return WorkoutBuilderStride() * rows
}

WorkoutBuilderEditor :: (app: *InnerBreeze, area: Rectangle, bounds: Rectangle, ready: bool) -> s32 {
    stride := WorkoutBuilderStride()
    height := WorkoutBuilderControl()
    back := ifx workout_builder.confirm_back then "workout_custom_discard" else "workout_custom_library"
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(4, WorkoutBuilderSlice(area, 0, height), LocaleText(back))) != 0 {
        unused WorkoutBuilderBack()
        if workout_builder.page == WORKOUT_BUILDER_LIBRARY {
            return WORKOUT_BUILDER_STAY
        }
    }
    if WorkoutBuilderField(app, *workout_builder.name, WORKOUT_BUILDER_NAME_FIELD, WorkoutBuilderSlice(area, stride, height), "workout_custom_name") {
        WorkoutBuilderChanged()
    }
    WorkoutBuilderTotals(app, WorkoutBuilderSlice(area, stride * 2, height))
    named := WorkoutNameValid(WorkoutBuilderTypedName())
    can_play := named && workout_builder.draft.count > 0 && WorkoutPlanTimesOf(*workout_builder.draft).valid
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(5, WorkoutBuilderSlice(area, stride * 3, height, 0, 2), LocaleText("save_button"), !can_play)) != 0 {
        WorkoutBuilderSave()
    }
    if Button.Draw(app.ui.session, WorkoutBuilderButtonProps(6, WorkoutBuilderSlice(area, stride * 3, height, 1, 2), LocaleText("workout_custom_play"), !can_play || !ready, true)) != 0 {
        return WORKOUT_BUILDER_PLAY
    }
    status := WorkoutBuilderStatus()
    toolbar := stride * 4
    if status.count > 0 {
        Text.Draw(app.ui.session, Text.Props.{.bounds = WorkoutBuilderSlice(area, stride * 4, height),
            .text = LocaleText(status), .size = AppSmallFontSize(), .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(Text.Wrap)TextWrapAuto})
        toolbar = stride * 5
    }
    if WorkoutBuilderToolbar(app, area, toolbar, height) {
        return WORKOUT_BUILDER_STAY
    }
    unused WorkoutBuilderBlocks(app, area, WorkoutBuilderHeaderHeight(), bounds)
    return WORKOUT_BUILDER_STAY
}

WorkoutBuilderDraw :: (app: *InnerBreeze, bounds: Rectangle, ready: bool) -> s32 {
    if !WorkoutBuilderSameAccount() {
        WorkoutBuilderOpen()
    }
    stride := WorkoutBuilderStride()
    scroll_at := *workout_builder.editor_scroll
    content_height: s32 = 0
    if workout_builder.page == WORKOUT_BUILDER_LIBRARY {
        scroll_at = *workout_builder.library_scroll
        rows: s32 = 1
        for occupied: workout_builder.occupied {
            if occupied {
                rows += 1
            }
        }
        content_height = stride * rows
    } else if workout_builder.page == WORKOUT_BUILDER_PICKER {
        scroll_at = *workout_builder.picker_scroll
        content_height = WorkoutBuilderPickerHeight()
    } else {
        content_height = WorkoutBuilderHeaderHeight() + WorkoutBuilderLayout()
    }
    scroll := Scroll.Draw(app.ui.session, Scroll.Props.{.key = Layout.KeyHash("workout/builder/scroll") + cast(u64)workout_builder.page,
        .bounds = bounds, .content_height = content_height, .scroll_offset = scroll_at.*})
    scroll_at.* = scroll.scroll_offset
    if workout_builder.page == WORKOUT_BUILDER_EDITOR {
        // A lifted block held near the top or bottom scrolls the routine,
        // but only toward the edge it is being dragged to: lifting a block
        // that already sits near an edge leaves the list where it is.
        drag := workout_builder.drag
        top := bounds.y
        bottom := bounds.y + bounds.height
        if drag.pointer.y >= drag.origin.y {
            top -= bounds.height
        }
        if drag.pointer.y <= drag.origin.y {
            bottom += bounds.height
        }
        scroll_at.* = Sortable.AutoScroll(drag, top, bottom, scroll_at.*, scroll.max_scroll,
            cast(float32)AppScale(44), AppScale(8))
    }
    if !scroll.opened {
        return WORKOUT_BUILDER_STAY
    }
    defer { unused End(app.ui.session) }
    full := cast(s32)scroll.content.width
    width := full - AppScale(4) * 2
    if width <= 0 {
        return WORKOUT_BUILDER_STAY
    }
    area := Rectangle.{scroll.content.x + cast(float32)((full - width) / 2), scroll.content.y, cast(float32)width, scroll.content.height}
    if workout_builder.page == WORKOUT_BUILDER_LIBRARY {
        return WorkoutBuilderList(app, area, stride, WorkoutBuilderControl())
    }
    if workout_builder.page == WORKOUT_BUILDER_PICKER {
        WorkoutBuilderPick(app, area, bounds)
        return WORKOUT_BUILDER_STAY
    }
    return WorkoutBuilderEditor(app, area, bounds, ready)
}
