#import, file "../../src/core/types.zi";
#import, file "../../src/core/breath_timing.zi";

// At the beginning, Back may leave the phase even while its fractional
// timer advances. This keeps a second press usable without pausing first.
WhmBackRestartsPhase :: (session: BreathSession) -> bool {
    if session.phase == BreathPhaseStarting {
        return session.sectick >= 60
    }
    if session.phase == BreathPhaseBreathe ||
    session.phase == BreathPhaseHold ||
    session.phase == BreathPhaseRecover {
        return BreathCountValue(session) > 0
    }
    return false
}

WhmRestartPhase :: (session: BreathSession) -> BreathSession {
    session.dir = 0
    session.r = session.rmin
    session.breath_frame = 0
    session.breathtick = 0
    session.sectick = 0
    session.halftick = 0
    return BreathResetCount(session)
}
