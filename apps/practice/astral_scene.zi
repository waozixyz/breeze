// A quiet floating-body scene on the same articulated 3D rig as Yoga and
// Workout. The host paints its depth-projected shapes through Kryon Images.
#import "std/math"
#import, file "workout_moves.zi";
#import, file "../../src/practices/tai_chi/tai_chi_math.zi";
#import, file "../../src/practices/tai_chi/tai_chi_view.zi";

AstralScene :: struct {
    pose: WorkoutPose
    camera: TaiChiCamera
    phase: float64
}

AstralSceneAt :: (milliseconds: s64) -> AstralScene {
    if milliseconds < 0 { milliseconds = 0 }
    seconds := cast(float64)(milliseconds % 600000) / 1000.0
    scene: AstralScene
    scene.phase = seconds / 28.0
    scene.pose = WorkoutStanding()
    WorkoutBody(*scene.pose, 0.0, 0.18, 0.0, 0.0, -90.0, 0.0, 0.0, 0.0, 2.0)
    WorkoutHandsAt(*scene.pose, WORKOUT_AT_WORLD, 0.28, 0.17, -0.2)
    WorkoutElbows(*scene.pose, 0.5, 0.1, -0.4)
    WorkoutFeet(*scene.pose, 0.1, 0.8, 4.0, 65.0, 0.1)
    WorkoutKnees(*scene.pose, 0.12, 0.0, 1.0)
    WorkoutLift(*scene.pose, 0.4 + Sin(seconds / 11.0) * 0.07)
    WorkoutBreathe(*scene.pose, milliseconds)
    scene.camera.yaw = (-64.0 + Sin(seconds / 31.0) * 7.0) * TAI_CHI_DEGREE
    scene.camera.tilt = (22.0 + Sin(seconds / 37.0) * 2.0) * TAI_CHI_DEGREE
    scene.camera.center = TaiChiV3(0.0, 0.0, 0.0)
    return scene
}
