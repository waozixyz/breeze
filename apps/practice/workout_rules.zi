// The full circuit follows Klika and Jordan (ACSM’s Health & Fitness Journal, 2013).
// The shorter circuit uses standing moves, shorter work and longer recovery.
#import "byte_text_linux"

WORKOUT_ROUTINE_FULL :: 0
WORKOUT_ROUTINE_SHORT :: 1
WORKOUT_EXERCISE_COUNT :: 12
WORKOUT_SHORT_EXERCISE_COUNT :: 6
WORKOUT_PREPARE_MS :: 10000
WORKOUT_WORK_MS :: 30000
WORKOUT_REST_MS :: 10000
WORKOUT_SHORT_READY_MS :: 15000
WORKOUT_SHORT_WORK_MS :: 25000

WORKOUT_PHASE_PREPARE :: 0
WORKOUT_PHASE_WORK :: 1
WORKOUT_PHASE_REST :: 2
WORKOUT_PHASE_DONE :: 3

// The exercises, in the circuit's order.
WORKOUT_JUMPING_JACKS :: 0
WORKOUT_WALL_SIT :: 1
WORKOUT_PUSH_UPS :: 2
WORKOUT_CRUNCHES :: 3
WORKOUT_STEP_UPS :: 4
WORKOUT_SQUATS :: 5
WORKOUT_TRICEPS_DIPS :: 6
WORKOUT_PLANK :: 7
WORKOUT_HIGH_KNEES :: 8
WORKOUT_LUNGES :: 9
WORKOUT_PUSH_UP_ROTATION :: 10
WORKOUT_SIDE_PLANK :: 11
WORKOUT_STEP_JACKS :: 12
WORKOUT_MINI_SQUATS :: 13
WORKOUT_HEEL_RAISES :: 14
WORKOUT_EASY_MARCH :: 15
WORKOUT_SIDE_REACHES :: 16
WORKOUT_BACK_TAPS :: 17
WORKOUT_MOVE_COUNT :: 18

// The side plank holds each side for half of its time.
WORKOUT_SIDE_SWITCH_MS :: WORKOUT_WORK_MS / 2

// Where the workout is: getting ready for the first exercise, doing one,
// resting before the next, or done. `exercise` is the one being done, or
// the one coming next.
WorkoutStep :: struct {
    phase: s32
    exercise: s32
    index: s32
    elapsed_ms: s32
    length_ms: s32
}

WorkoutRoutineCount :: (routine: s32) -> s32 {
    return ifx routine == WORKOUT_ROUTINE_SHORT then WORKOUT_SHORT_EXERCISE_COUNT else WORKOUT_EXERCISE_COUNT
}

WorkoutLeadMilliseconds :: (routine: s32) -> s32 {
    return ifx routine == WORKOUT_ROUTINE_SHORT then WORKOUT_SHORT_READY_MS else WORKOUT_REST_MS
}

WorkoutWorkMilliseconds :: (routine: s32) -> s32 {
    return ifx routine == WORKOUT_ROUTINE_SHORT then WORKOUT_SHORT_WORK_MS else WORKOUT_WORK_MS
}

WorkoutGentleExercise :: (exercise: s32) -> bool {
    return exercise >= WORKOUT_STEP_JACKS && exercise < WORKOUT_MOVE_COUNT
}

// Each step starts with preparation or a recovery of the same length.
WorkoutStepStart :: (routine: s32, index: s32) -> s64 {
    if index < 0 || index >= WorkoutRoutineCount(routine) {
        return -1
    }
    return cast(s64)index * cast(s64)(WorkoutWorkMilliseconds(routine) + WorkoutLeadMilliseconds(routine))
}

WorkoutTotalMilliseconds :: (routine: s32) -> s32 {
    return WorkoutRoutineCount(routine) * (WorkoutLeadMilliseconds(routine) + WorkoutWorkMilliseconds(routine))
}

WorkoutRoutineExercise :: (routine: s32, index: s32) -> s32 {
    if routine == WORKOUT_ROUTINE_SHORT {
        exercises: [WORKOUT_SHORT_EXERCISE_COUNT]s32 = .[WORKOUT_STEP_JACKS, WORKOUT_MINI_SQUATS,
            WORKOUT_HEEL_RAISES, WORKOUT_EASY_MARCH, WORKOUT_SIDE_REACHES, WORKOUT_BACK_TAPS]
        return exercises[index]
    }
    return index
}

WorkoutStepAt :: (routine: s32, elapsed_ms: s64) -> WorkoutStep {
    step: WorkoutStep
    lead_ms := WorkoutLeadMilliseconds(routine)
    work_ms := WorkoutWorkMilliseconds(routine)
    if elapsed_ms < 0 {
        elapsed_ms = 0
    }
    if elapsed_ms < cast(s64)lead_ms {
        step.phase = WORKOUT_PHASE_PREPARE
        step.exercise = WorkoutRoutineExercise(routine, 0)
        step.elapsed_ms = cast(s32)elapsed_ms
        step.length_ms = lead_ms
        return step
    }
    block := cast(s64)(work_ms + lead_ms)
    into := elapsed_ms - cast(s64)lead_ms
    index := into / block
    within := into - index * block
    last := WorkoutRoutineCount(routine) - 1
    if elapsed_ms >= cast(s64)WorkoutTotalMilliseconds(routine) {
        step.phase = WORKOUT_PHASE_DONE
        step.index = last
        step.exercise = WorkoutRoutineExercise(routine, last)
        return step
    }
    if within < cast(s64)work_ms {
        step.phase = WORKOUT_PHASE_WORK
        step.index = cast(s32)index
        step.exercise = WorkoutRoutineExercise(routine, step.index)
        step.elapsed_ms = cast(s32)within
        step.length_ms = work_ms
        return step
    }
    step.phase = WORKOUT_PHASE_REST
    step.index = cast(s32)index + 1
    step.exercise = WorkoutRoutineExercise(routine, step.index)
    step.elapsed_ms = cast(s32)(within - cast(s64)work_ms)
    step.length_ms = lead_ms
    return step
}

// Whole seconds left in the step, counting a started second.
WorkoutStepSecondsLeft :: (step: WorkoutStep) -> s32 {
    left := step.length_ms - step.elapsed_ms
    if left <= 0 {
        return 0
    }
    return (left + 999) / 1000
}

// Moves the clock on while it runs; it stops at the end.
WorkoutAdvance :: (routine: s32, elapsed_ms: s64, step_ms: s32, paused: bool) -> s64 {
    if paused || step_ms <= 0 {
        return elapsed_ms
    }
    next := elapsed_ms + cast(s64)step_ms
    duration := cast(s64)WorkoutTotalMilliseconds(routine)
    if next > duration {
        return duration
    }
    return next
}

// The longest interval played from its start for each exercise. A seek starts
// at an interval boundary, and counting only new time avoids doubling replays.
WorkoutCoverage :: struct {
    ready: [WORKOUT_EXERCISE_COUNT]s32
    work: [WORKOUT_EXERCISE_COUNT]s32
    played_ms: s32
}

WorkoutCredit :: (coverage: *WorkoutCoverage, routine: s32, before: s64, after: s64) {
    cursor := before
    while cursor < after {
        step := WorkoutStepAt(routine, cursor)
        if step.phase == WORKOUT_PHASE_DONE {
            return
        }
        count := cast(s64)(step.length_ms - step.elapsed_ms)
        if count > after - cursor {
            count = after - cursor
        }
        played := step.elapsed_ms + cast(s32)count
        covered := *coverage.ready[step.index]
        if step.phase == WORKOUT_PHASE_WORK {
            covered = *coverage.work[step.index]
        }
        if played > covered.* {
            coverage.played_ms += played - covered.*
            covered.* = played
        }
        cursor += count
    }
}

WorkoutCompletedMask :: (coverage: *WorkoutCoverage, routine: s32) -> s32 {
    mask: s32 = 0
    for index: cast(s32)0..WorkoutRoutineCount(routine) - 1 {
        if coverage.work[index] == WorkoutWorkMilliseconds(routine) {
            mask |= 1 << index
        }
    }
    return mask
}

// Seconds of exercise done so far, without the getting ready or the rests.
WorkoutExerciseSeconds :: (routine: s32, elapsed_ms: s64) -> s32 {
    step := WorkoutStepAt(routine, elapsed_ms)
    if step.phase == WORKOUT_PHASE_PREPARE {
        return 0
    }
    if step.phase == WORKOUT_PHASE_DONE {
        return WorkoutRoutineCount(routine) * WorkoutWorkMilliseconds(routine) / 1000
    }
    done := step.index * WorkoutWorkMilliseconds(routine)
    if step.phase == WORKOUT_PHASE_WORK {
        done += step.elapsed_ms
    }
    return done / 1000
}

WorkoutExerciseKey :: (exercise: s32) -> string {
    keys: [WORKOUT_MOVE_COUNT]string = .["jumping_jacks", "wall_sit", "push_ups", "crunches",
    "step_ups", "squats", "triceps_dips", "plank", "high_knees", "lunges", "push_up_rotation",
    "side_plank", "step_jacks", "mini_squats", "heel_raises", "easy_march", "side_reaches", "back_taps"]
    if exercise < 0 || exercise >= WORKOUT_MOVE_COUNT {
        return ""
    }
    return keys[exercise]
}

// `prefix` and the exercise's key in `output`, such as "workout_name_plank".
WorkoutKeyFor :: (prefix: string, exercise: s32, output: []u8) -> string {
    key := WorkoutExerciseKey(exercise)
    if key.count == 0 || prefix.count + key.count > output.count {
        return ""
    }
    count: s64 = 0
    for byte: prefix {
        output[count] = byte
        count += 1
    }
    for byte: key {
        output[count] = byte
        count += 1
    }
    return TextFromBytes(output[:count])
}

// The countdown into each exercise: the seconds left while getting ready or
// resting, then "Go" for a moment as the exercise starts.
WORKOUT_COUNT_NONE :: -1
WORKOUT_COUNT_GO :: 0
WORKOUT_GO_MS :: 800
// The last seconds before an exercise are spoken one by one.
WORKOUT_SPOKEN_COUNT :: 3

WorkoutCountdownAt :: (step: WorkoutStep) -> s32 {
    if step.phase == WORKOUT_PHASE_PREPARE || step.phase == WORKOUT_PHASE_REST {
        return WorkoutStepSecondsLeft(step)
    }
    if step.phase == WORKOUT_PHASE_WORK && step.elapsed_ms < WORKOUT_GO_MS {
        return WORKOUT_COUNT_GO
    }
    return WORKOUT_COUNT_NONE
}

// The narrated line for the step: what is coming while getting ready or
// resting, three, two, one as it ends, "Go" as the exercise starts, and
// the switch halfway through the side plank.
WorkoutCueKey :: (step: WorkoutStep, output: []u8) -> string {
    if step.phase == WORKOUT_PHASE_PREPARE || step.phase == WORKOUT_PHASE_REST {
        left := WorkoutStepSecondsLeft(step)
        if left >= 1 && left <= WORKOUT_SPOKEN_COUNT {
            counts: [WORKOUT_SPOKEN_COUNT]string = .["workout_say_count_1", "workout_say_count_2",
            "workout_say_count_3"]
            return counts[left - 1]
        }
        // The existing recordings name the full circuit and its exercises.
        // Both circuits can use the neutral countdown and Go recordings.
        if WorkoutGentleExercise(step.exercise) { return "" }
        if step.phase == WORKOUT_PHASE_PREPARE {
            return "workout_say_start"
        }
        return WorkoutKeyFor("workout_say_next_", step.exercise, output)
    }
    if step.phase == WORKOUT_PHASE_WORK {
        if step.exercise == WORKOUT_SIDE_PLANK && step.elapsed_ms >= WORKOUT_SIDE_SWITCH_MS {
            return "workout_say_switch"
        }
        return "workout_say_go"
    }
    return ""
}
