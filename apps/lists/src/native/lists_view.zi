ListsEditText :: (value: string, start: s32, end: s32, inserted: string) -> string {
    edited: Vec(u8)
    BuilderPrint(*edited, "%", value[:start])
    BuilderPrint(*edited, "%", inserted)
    BuilderPrint(*edited, "%", value[end:])
    return BuilderFinish(edited)
}

ListPersonLabel :: (name: string, detail: string) -> string {
    label: Vec(u8)
    BuilderPrint(*label, "% (%)", name, detail)
    return BuilderFinish(label)
}

ListInvitationSender :: (name: string) -> string {
    label: Vec(u8)
    BuilderPrint(*label, "%: %", ListsLocaleHost("elist_invitation_from"), name)
    return BuilderFinish(label)
}

ListShareSummary :: struct {
    names: [3]string
    icons: [3]s32
    count: s32
    title: string
    label: string
}

SharedListSummary :: (current: ListsUiRow) -> ListShareSummary {
    summary: ListShareSummary
    list_id := Copied(current.id)
    owner_id := Copied(current.owner_id)
    owner_name := Copied(ifx current.owner_alias.count > 0 then current.owner_alias else current.people)
    owns := current.owner
    summary.title = Copied(current.title)
    invited_label := Copied(ListsLocaleHost("elist_invited"))
    text: Vec(u8)
    count: s32 = 0
    if !owns {
        BuilderPrint(*text, "%", owner_name)
        summary.names[0] = owner_name
        summary.icons[0] = FriendIcon(owner_id)
        count = 1
    }
    // People who joined come first, then those still invited.
    for pass: cast(s32)0..1 {
        if !owns {
            break
        }
        for index: cast(s32)0..frame.invitation_count - 1 {
            row := ReadListsSharingRowHost(index, true)
            if !SharingMemberShown(row, list_id) || (row.status == "pending") != (pass == 1) {
                continue
            }
            icon := row.profile_icon
            name := Copied(ifx row.target_alias.count > 0 then row.target_alias else
                row.target[:ifx row.target.count > 8 then 8 else row.target.count])
            if text.count > 0 {
                BuilderPrint(*text, " · ")
            }
            if pass == 0 {
                BuilderPrint(*text, "%", name)
            } else {
                BuilderPrint(*text, "% (%)", name, invited_label)
            }
            if count < 3 {
                summary.names[count] = name
                summary.icons[count] = icon
            }
            count += 1
        }
    }
    summary.count = ifx count > 3 then 3 else count
    if count > 0 {
        summary.label = BuilderFinish(text)
    }
    return summary
}

ClearAccessControls :: () { VecClear(sharing_controls) }

AddAccessControl :: (target: [65]u8, bounds: Rectangle, role: s32, disabled: bool) {
    VecPush(sharing_controls, .{target = target, bounds = bounds, role = role, disabled = disabled})
}

SharingAccessControlCount :: () -> s32 { return cast(s32)sharing_controls.count }
SharingAccessControlAt :: (index: s32) -> SharingAccessControl { return sharing_controls[index] }
