// Lists owns its complete screen composition; the host supplies saved rows,
// device input and ordinary Kryon widget effects.
#import "session"
#import "geometry"
#import "text"
#import "vec"
#import "text_props"
#import "text_align"
#import "text_widget"
#import "text_input_props"
#import "text_field_widget"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "checkbox_props"
#import "checkbox_widget"
#import "tab_bar_props"
#import "tab_bar_widget"
#import "scroll_props"
#import "scroll_widget"
#import "modal_props"
#import "modal_frame_widget"
#import "tree"
#import "icon"
#import, file "../../src/cells/lists_ui_types.zi";
#import, file "../../src/cells/lists_types.zi";

using ButtonTone;
using ButtonEmphasis;
using TextAlign;
using TextWrap;
using IconType;
host_api :: #system_library "host_api";
ReadListsUiHost :: () -> ListsUiFrame #foreign host_api;
WriteListsUiHost :: (frame: ListsUiFrame) #foreign host_api;
ReadListsRowHost :: (index: s32, item: bool) -> ListsUiRow #foreign host_api;
ReadListsSharingRowHost :: (index: s32, invitation: bool) -> ListsUiPerson #foreign host_api;
PrepareListsCommandHost :: (request: ListsUiRequest) -> string #foreign host_api;
ListsLocaleHost :: (key: string) -> string #foreign host_api;
frame: ListsUiFrame;
state: ListsMessage;
// The open Share or Invitations dialog's scroll offset.
sharing_scroll: s32;

Scale :: (pixels: s32) -> s32 {
    return cast(s32)(cast(float32)pixels * frame.scale)
}

Bounds :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

BeginInput :: (item: s32, value: string) {
    state.editing_item = item
    state.input_error = 0
    frame.value = value
    frame.cursor = cast(s32)value.count
    frame.anchor = frame.cursor
    frame.scroll_x = 0
    frame.focused = true
}

Finish :: () -> ListsMessage {
    WriteListsUiHost(frame)
    state.succeeded = true
    return state
}

Mutation :: (action: s32, index: s32) {
    state.action = action
    state.index = index
    if state.selected_list >= 0 && state.selected_list < state.list_count {
        row := ReadListsRowHost(state.selected_list, false)
        state.id = row.id
        state.selected_id = row.id
        state.sort_order = row.sort_order
    }
    item := ifx action == LISTS_COMMIT then state.editing_item else index
    if item >= 0 && item < state.item_count {
        row := ReadListsRowHost(item, true)
        state.id = row.id
        state.parent_id = row.parent_id
        state.title = row.title
        state.comment = row.comment
        if action != LISTS_SET_DONE {
            state.done = row.done
        }
        state.sort_order = row.sort_order
    }
    if action == LISTS_COMMIT {
        state.title = frame.value
    }
    if state.selected_list >= 0 && state.selected_list < state.list_count &&
    state.editing_item != -2 && ReadListsRowHost(state.selected_list, false).shared {
        Remote(action)
    }
}

Field :: (bounds: Rectangle) -> bool {
    edited := TextField(frame.session, TextFieldProps.{.key = cast(u64)6501,
            .bounds = bounds, .value = frame.value, .cursor = frame.cursor,
            .anchor = frame.anchor, .scroll_x = frame.scroll_x,
            .focused = frame.focused, .focus_id = 6501,
            .max_bytes = 127, .max_codepoints = 127, .input = frame.input,
            .disabled = frame.sharing_busy || frame.sharing_pending})
    if edited.edit.changed {
        start := edited.edit.start
        end := edited.edit.end
        if start >= 0 && end >= start && end <= frame.value.count {
            value: Vec(u8)
            BuilderPrint(*value, "%", frame.value[:start])
            BuilderPrint(*value, "%", edited.edit.replacement)
            BuilderPrint(*value, "%", frame.value[end:])
            replacement := BuilderFinish(value)
            if replacement.count <= 127 {
                frame.value = replacement
            }
        }
    }
    frame.cursor = edited.cursor
    frame.anchor = edited.anchor
    frame.scroll_x = edited.scroll_x
    frame.focused = edited.focused
    frame.clipboard_write = edited.clipboard_write
    frame.clipboard_text = edited.clipboard_text
    return edited.committed
}

Remote :: (action: s32, target: string = "", invitation: string = "",
    invitation_list: string = "") {
    state.action = action
    state.remote = true
    list: ListsUiRow
    if state.selected_list >= 0 && state.selected_list < state.list_count {
        list = ReadListsRowHost(state.selected_list, false)
    }
    if invitation_list.count > 0 {
        list.id = invitation_list
    }
    state.selected_id = list.id
    state.request_body = PrepareListsCommandHost(ListsUiRequest.{
            .action = action, .index = state.index, .editing_item = state.editing_item,
            .selected_list = state.selected_list, .done = state.done,
            .value = frame.value, .next_id = frame.next_id,
            .target = target, .invitation = invitation, .list_id = list.id})
}

// Cells cannot measure text, so a paragraph's height allows a generous
// average character width; wide characters count twice.
ParagraphHeight :: (text: string, width: s32) -> s32 {
    if text.count == 0 {
        return 0
    }
    columns: s32 = 0
    for index: cast(s32)0..cast(s32)text.count - 1 {
        byte := text[index]
        if byte >= cast(u8)224 {
            columns += 2
        } else if byte < cast(u8)128 || byte >= cast(u8)192 {
            columns += 1
        }
    }
    per_line := width / Scale(8)
    if per_line < 1 {
        per_line = 1
    }
    lines := (columns + per_line - 1) / per_line
    return lines * Scale(22)
}

// Whether a sharing row belongs in the open dialog: every friend for Share,
// invitations still waiting for this account for Invitations.
SharingRowShown :: (row: ListsUiPerson) -> bool {
    return frame.panel == 1 || (row.target == frame.public_id && row.status == "pending")
}

// Share and Invitations open in a dialog over the list.
SharingDialog :: () {
    share := frame.panel == 1
    width := frame.width - Scale(32)
    if width > Scale(440) {
        width = Scale(440)
    }
    detail := ""
    if !frame.connected {
        detail = ListsLocaleHost("elist_connect")
    } else if share {
        detail = ListsLocaleHost("elist_share_detail")
    }
    detail_height := ParagraphHeight(detail, width - Scale(36))
    source_count := ifx share then frame.friend_count else frame.invitation_count
    count: s32 = 0
    for index: cast(s32)0..source_count - 1 {
        if SharingRowShown(ReadListsSharingRowHost(index, !share)) {
            count += 1
        }
    }
    row_height := Scale(ifx share then 52 else 108)
    content_height := detail_height
    if frame.connected {
        if detail_height > 0 {
            content_height += Scale(12)
        }
        shown := ifx count > 4 then 4 else count
        if count == 0 {
            content_height += Scale(48)
        } else {
            content_height += shown * row_height
        }
        content_height += Scale(12) + Scale(44)
    }
    dialog := ModalFrame(frame.session, ModalFrameProps.{.key = cast(u64)6520,
            .title = ListsLocaleHost(ifx share then "elist_share" else "elist_invitations"),
            .width = width, .height = content_height + Scale(74), .scale = frame.scale,
            .has_right_action = true, .right_label = ListsLocaleHost("close_button")})
    if dialog.dismissed || dialog.right_clicked {
        frame.panel = 0
        sharing_scroll = 0
        return
    }
    if !dialog.opened {
        return
    }
    x := cast(s32)dialog.layout.content.x
    y := cast(s32)dialog.layout.content.y
    content_width := cast(s32)dialog.layout.content.width
    bottom := cast(s32)(dialog.layout.content.y + dialog.layout.content.height)
    if detail_height > 0 {
        Text(frame.session, TextProps.{.bounds = Bounds(x, y, content_width, detail_height),
                .text = detail, .wrap = cast(TextWrap)TextWrapAuto})
        y += detail_height + Scale(12)
    }
    if !frame.connected {
        End(frame.session)
        return
    }
    refresh_width := ifx content_width < Scale(140) then content_width else Scale(140)
    if Button(frame.session, ButtonProps.{.key = cast(u64)6511,
            .bounds = Bounds(x + content_width - refresh_width, bottom - Scale(44), refresh_width, Scale(44)),
            .label = ListsLocaleHost("elist_refresh"), .disabled = frame.sharing_busy}) != 0 {
        state.action = LISTS_REFRESH
        state.remote = true
    }
    if count == 0 {
        Text(frame.session, TextProps.{.bounds = Bounds(x, y, content_width, Scale(48)),
                .text = ListsLocaleHost(ifx share then "elist_no_friends" else "elist_no_invitations"),
                .wrap = cast(TextWrap)TextWrapAuto})
        End(frame.session)
        return
    }
    scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)6512,
            .bounds = Bounds(x, y, content_width, bottom - Scale(56) - y),
            .content_height = count * row_height, .scroll_offset = sharing_scroll})
    sharing_scroll = scroll.scroll_offset
    if !scroll.opened {
        End(frame.session)
        return
    }
    row_y := cast(s32)scroll.content.y
    disabled := frame.sharing_busy || frame.sharing_pending
    for index: cast(s32)0..source_count - 1 {
        row := ReadListsSharingRowHost(index, !share)
        if !SharingRowShown(row) {
            continue
        }
        if row_y + row_height <= cast(s32)scroll.viewport.y ||
        row_y >= cast(s32)(scroll.viewport.y + scroll.viewport.height) {
            row_y += row_height
            continue
        }
        if share {
            if InviteRow(row, index, x, row_y, content_width, disabled) {
                End(frame.session)
                End(frame.session)
                return
            }
        } else if InvitationRow(row, index, x, row_y, content_width, disabled) {
            End(frame.session)
            End(frame.session)
            return
        }
        row_y += row_height
    }
    End(frame.session)
    End(frame.session)
}

// A friend and the Invite button for the selected list. True once an
// invitation is sent.
InviteRow :: (row: ListsUiPerson, index: s32, x: s32, y: s32, width: s32, disabled: bool) -> bool {
    friend := row.id
    alias := row.alias
    if alias.count == 0 {
        alias = friend
    }
    status := ""
    selected := ReadListsRowHost(state.selected_list, false)
    for invitation_index: cast(s32)0..frame.invitation_count - 1 {
        invite := ReadListsSharingRowHost(invitation_index, true)
        if invite.list_id == selected.id && invite.target == friend {
            status = invite.status
        }
    }
    button_width := Scale(112)
    Text(frame.session, TextProps.{.bounds = Bounds(x, y, width - button_width - Scale(12), Scale(44)),
            .text = alias, .vertical_align = cast(TextAlign)TextAlignCenter})
    key := "elist_invite"
    if status == "accepted" {
        key = "elist_accepted"
    } else if status == "pending" {
        key = "elist_invited"
    }
    if Button(frame.session, ButtonProps.{.key = cast(u64)(7400 + index),
            .bounds = Bounds(x + width - button_width, y, button_width, Scale(44)),
            .label = ListsLocaleHost(key), .disabled = disabled || status == "pending" || status == "accepted",
            .tone = cast(ButtonTone)ButtonToneAccent}) != 0 {
        Remote(LISTS_INVITE, friend)
        return true
    }
    return false
}

// An invitation to a list, who sent it, and Accept and Decline. True once
// one is chosen.
InvitationRow :: (row: ListsUiPerson, index: s32, x: s32, y: s32, width: s32, disabled: bool) -> bool {
    alias := row.alias
    if alias.count == 0 {
        alias = row.owner
    }
    Text(frame.session, TextProps.{.bounds = Bounds(x, y, width, Scale(24)), .text = row.title})
    Text(frame.session, TextProps.{.bounds = Bounds(x, y + Scale(26), width, Scale(20)), .text = alias})
    button_width := (width - Scale(8)) / 2
    if button_width > Scale(140) {
        button_width = Scale(140)
    }
    accept := Button(frame.session, ButtonProps.{.key = cast(u64)(7600 + index * 2),
            .bounds = Bounds(x, y + Scale(52), button_width, Scale(44)),
            .label = ListsLocaleHost("profile_friend_accept_button"),
            .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
            .disabled = disabled || state.list_count >= 32}) != 0
    decline := Button(frame.session, ButtonProps.{.key = cast(u64)(7601 + index * 2),
            .bounds = Bounds(x + button_width + Scale(8), y + Scale(52), button_width, Scale(44)),
            .label = ListsLocaleHost("profile_friend_decline_button"), .disabled = disabled}) != 0
    if accept || decline {
        Remote(ifx accept then LISTS_ACCEPT else LISTS_DECLINE, "", row.id, row.list_id)
        return true
    }
    return false
}

ListsView :: (message: ListsMessage) -> ListsMessage {
    frame = ReadListsUiHost()
    state = message
    ListsPage()
    if frame.panel != 0 {
        SharingDialog()
    }
    return Finish()
}

// The selected list: its tabs, actions, new item field and items.
ListsPage :: () {
    x := Scale(16)
    width := frame.width - x * 2
    y := Scale(12)
    blocked := frame.sharing_busy || frame.sharing_pending
    tabs: [32]Tab
    for index: cast(s32)0..state.list_count - 1 {
        row := ReadListsRowHost(index, false)
        tabs[index] = Tab.{.key = cast(u64)(6800 + index), .label = row.title}
    }
    if state.list_count > 0 {
        selected := TabBar(frame.session, TabBarProps.{.id = 6500,
                .bounds = Bounds(x, y, width - Scale(56), Scale(44)),
                .selected_index = state.selected_list, .min_tab_width = Scale(88),
                .max_tab_width = Scale(220), .content_sized = true,
                .scroll_offset = frame.tab_scroll, .scale = frame.scale,
                .focus_selected = frame.tab_scroll == 0}, tabs[:state.list_count])
        frame.tab_scroll = selected.scroll_offset
        if selected.selected_index != state.selected_list {
            state.action = LISTS_SELECT
            state.index = selected.selected_index
            frame.panel = 0
            return
        }
    }
    if Button(frame.session, ButtonProps.{.key = cast(u64)6505,
            .bounds = Bounds(x + width - Scale(44), y, Scale(44), Scale(44)),
            .label = ListsLocaleHost("elist_new_list"), .icon_type = cast(s32)IconPlus,
            .icon_only = true, .disabled = blocked || state.list_count >= 32}) != 0 {
        BeginInput(-2, "")
        frame.panel = 0
        return
    }
    y += Scale(56)
    if frame.sharing_status != 0 || frame.sharing_pending {
        key := "elist_saving"
        if frame.sharing_pending && !frame.sharing_busy {
            key = "elist_unconfirmed"
        } else if frame.sharing_status == 2 {
            key = "elist_shared_saved"
        } else if frame.sharing_status == 3 {
            key = "elist_share_failed"
        } else if frame.sharing_status == 4 {
            key = "elist_conflict"
        } else if frame.sharing_status == 5 {
            key = "elist_unavailable"
        }
        notice_width := ifx frame.sharing_pending && !frame.sharing_busy then width - Scale(104) else width
        Text(frame.session, TextProps.{.bounds = Bounds(x, y, notice_width, Scale(64)),
                .text = ListsLocaleHost(key), .wrap = cast(TextWrap)TextWrapAuto})
        if frame.sharing_pending && !frame.sharing_busy {
            if Button(frame.session, ButtonProps.{.key = cast(u64)6513,
                    .bounds = Bounds(x + width - Scale(96), y, Scale(96), Scale(44)),
                    .label = ListsLocaleHost("retry_button")}) != 0 {
                state.action = LISTS_RETRY
                state.remote = true
                return
            }
        }
        y += Scale(72)
    }
    current: ListsUiRow
    if state.selected_list >= 0 && state.selected_list < state.list_count {
        current = ReadListsRowHost(state.selected_list, false)
    }
    if current.shared && current.incomplete {
        blocked = true
        Text(frame.session, TextProps.{.bounds = Bounds(x, y, width, Scale(64)),
                .text = ListsLocaleHost("elist_capacity"), .wrap = cast(TextWrap)TextWrapAuto})
        y += Scale(72)
    }
    if state.editing_item != -2 && state.editing_item != -3 {
        compact := width < Scale(440)
        owner := !current.shared || current.owner
        if Button(frame.session, ButtonProps.{.key = cast(u64)6508,
                .bounds = Bounds(x, y, Scale(88), Scale(44)), .label = ListsLocaleHost("elist_share"),
                .disabled = current.id.count == 0 || !owner || current.incomplete || blocked}) != 0 {
            frame.panel = 1
            frame.focused = false
            sharing_scroll = 0
        }
        label: Vec(u8)
        BuilderPrint(*label, "% (%)", ListsLocaleHost("elist_invitations"), frame.pending_count_text)
        invitations_label := BuilderFinish(label)
        invitations_width := width - Scale(200)
        if compact {
            invitations_width = width - Scale(96)
        }
        if !compact && invitations_width > Scale(176) {
            invitations_width = Scale(176)
        }
        if Button(frame.session, ButtonProps.{.key = cast(u64)6509,
                .bounds = Bounds(x + Scale(96), y, invitations_width, Scale(44)),
                .label = invitations_label,
                .tone = cast(ButtonTone)(ifx frame.pending_count_text != "0" then ButtonToneAccent else ButtonToneNeutral)}) != 0 {
            frame.panel = 2
            frame.focused = false
            sharing_scroll = 0
        }
        action_y := y
        action_width := Scale(44)
        rename_x := x + width - Scale(96)
        delete_x := x + width - Scale(44)
        if compact {
            action_y += Scale(56)
            action_width = (width - Scale(8)) / 2
            rename_x = x
            delete_x = x + action_width + Scale(8)
        }
        if Button(frame.session, ButtonProps.{.key = cast(u64)6503,
                .bounds = Bounds(rename_x, action_y, action_width, Scale(44)),
                .label = ListsLocaleHost("elist_rename"), .icon_only = !compact,
                .icon_type = cast(s32)(ifx compact then IconNone else IconEdit),
                .disabled = current.id.count == 0 || !owner || blocked}) != 0 {
            BeginInput(-3, current.title)
            return
        }
        if Button(frame.session, ButtonProps.{.key = cast(u64)6504,
                .bounds = Bounds(delete_x, action_y, action_width, Scale(44)),
                .label = ListsLocaleHost("delete_button"), .icon_only = !compact,
                .icon_type = cast(s32)(ifx compact then IconNone else IconTrash),
                .disabled = current.id.count == 0 || !owner || blocked}) != 0 {
            Mutation(LISTS_DELETE_LIST, -1)
            return
        }
        y += Scale(ifx compact then 112 else 56)
    }
    if state.input_error != 0 {
        Text(frame.session, TextProps.{.bounds = Bounds(x, y, width, Scale(48)),
                .text = ListsLocaleHost("results_write_failed"), .wrap = cast(TextWrap)TextWrapAuto})
        y += Scale(56)
    }
    if state.editing_item == -2 || state.editing_item == -3 {
        committed := Field(Bounds(x, y, width, Scale(44)))
        button_width := (width - Scale(8)) / 2
        if Button(frame.session, ButtonProps.{.key = cast(u64)6506,
                .label = ListsLocaleHost(ifx state.editing_item == -3 then "done_button" else "elist_create_list"),
                .bounds = Bounds(x, y + Scale(56), button_width, Scale(44)),
                .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
                .disabled = frame.value.count == 0 || blocked}) != 0 || (committed && !blocked) {
            Mutation(LISTS_COMMIT, -1)
        }
        if Button(frame.session, ButtonProps.{.key = cast(u64)6514,
                .label = ListsLocaleHost("cancel_button"),
                .bounds = Bounds(x + button_width + Scale(8), y + Scale(56), button_width, Scale(44)),
                .disabled = blocked}) != 0 {
            state.editing_item = -1
            state.reset_input = true
        }
        return
    }
    if state.list_count == 0 {
        Text(frame.session, TextProps.{.bounds = Bounds(x, y + Scale(32), width, Scale(30)),
                .text = ListsLocaleHost("elist_empty_title"), .align = cast(TextAlign)TextAlignCenter})
        Text(frame.session, TextProps.{.bounds = Bounds(x, y + Scale(72), width, Scale(64)),
                .text = ListsLocaleHost("elist_empty_detail"), .align = cast(TextAlign)TextAlignCenter,
                .wrap = cast(TextWrap)TextWrapAuto})
        return
    }
    committed := Field(Bounds(x, y, width - Scale(96), Scale(44)))
    if Button(frame.session, ButtonProps.{.key = cast(u64)6507,
            .label = ListsLocaleHost(ifx state.editing_item >= 0 then "done_button" else "elist_add_item"),
            .bounds = Bounds(x + width - Scale(88), y, Scale(88), Scale(44)),
            .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
            .disabled = frame.value.count == 0 || blocked}) != 0 || (committed && !blocked) {
        Mutation(LISTS_COMMIT, -1)
        return
    }
    y += Scale(56)
    footer := frame.height - frame.bottom - Scale(60)
    if footer < y + Scale(58) {
        footer = y + Scale(58)
    }
    footer_width := ifx Scale(200) > width then width else Scale(200)
    if Button(frame.session, ButtonProps.{.key = cast(u64)6502,
            .label = ListsLocaleHost(ifx state.show_completed != 0 then "elist_hide_completed" else "elist_show_completed"),
            .bounds = Bounds(x + width - footer_width, footer, footer_width, Scale(44))}) != 0 {
        state.show_completed = ifx state.show_completed == 0 then 1 else 0
        frame.scroll = 0
    }
    visible: [256]bool
    count: s32 = 0
    for index: cast(s32)0..state.item_count - 1 {
        row := ReadListsRowHost(index, true)
        visible[index] = row.parent_id == current.id && (row.done == 0 ||
            state.show_completed != 0 || (row.id == state.completing_id && state.now < state.completing_until))
        if visible[index] {
            count += 1
        }
    }
    scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)6600,
            .bounds = Bounds(x, y, width, footer - y - Scale(12)),
            .content_height = count * Scale(72), .scroll_offset = frame.scroll})
    frame.scroll = scroll.scroll_offset
    if scroll.opened {
        row_y := cast(s32)scroll.content.y
        for index: cast(s32)0..state.item_count - 1 {
            if !visible[index] {
                continue
            }
            if row_y + Scale(64) > cast(s32)scroll.viewport.y &&
            row_y < cast(s32)(scroll.viewport.y + scroll.viewport.height) {
                row := ReadListsRowHost(index, true)
                key := cast(u64)(7000 + index * 4)
                checked := Checkbox(frame.session, CheckboxProps.{.key = key,
                        .bounds = Bounds(x, row_y + Scale(10), Scale(44), Scale(44)),
                        .checked = row.done != 0, .disabled = blocked})
                if checked.changed {
                    state.done = ifx checked.checked then 1 else 0
                    Mutation(LISTS_SET_DONE, index)
                    End(frame.session)
                    return
                }
                Text(frame.session, TextProps.{.bounds = Bounds(x + Scale(52), row_y,
                        width - Scale(156), ifx row.comment.count > 0 then Scale(30) else Scale(64)),
                        .text = row.title, .vertical_align = cast(TextAlign)TextAlignCenter,
                        .strikethrough = row.done != 0})
                if row.comment.count > 0 {
                    Text(frame.session, TextProps.{.bounds = Bounds(x + Scale(52), row_y + Scale(34),
                            width - Scale(156), Scale(24)), .text = row.comment})
                }
                if Button(frame.session, ButtonProps.{.key = key + cast(u64)1,
                        .bounds = Bounds(x + width - Scale(96), row_y + Scale(10), Scale(44), Scale(44)),
                        .label = ListsLocaleHost("elist_rename"), .icon_type = cast(s32)IconEdit,
                        .icon_only = true, .disabled = blocked}) != 0 {
                    BeginInput(index, row.title)
                }
                if Button(frame.session, ButtonProps.{.key = key + cast(u64)2,
                        .bounds = Bounds(x + width - Scale(44), row_y + Scale(10), Scale(44), Scale(44)),
                        .label = ListsLocaleHost("delete_button"), .icon_type = cast(s32)IconTrash,
                        .icon_only = true, .disabled = blocked}) != 0 {
                    Mutation(LISTS_DELETE_ITEM, index)
                    End(frame.session)
                    return
                }
            }
            row_y += Scale(72)
        }
        End(frame.session)
    }
}
