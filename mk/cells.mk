# App packages: the cell bundles, the node apps and the codecs they share.

# App records cross the bundle boundary with codecs generated by Kryon's
# generator on top of Kryon's own widget codec.
APP_CODEC_SCHEMAS := $(KRYON_DIR)/scripts/generate-widget-codecs.py $(KRYON_DIR)/src/backend/widget_codec.zi apps/diary/diary_ui_types.zi $(addprefix src/cells/,inbe_ui_types.zi lists_ui_types.zi lumi_ui_types.zi lumi_types.zi leaderboard_ui_types.zi habits_ui_types.zi)
src/cells/app_codec.zi: scripts/generate-app-codec.py $(APP_CODEC_SCHEMAS)
	python3 scripts/generate-app-codec.py

src/cells/node_app_codec.zi: scripts/generate-node-app-codec.py src/cells/node_app_types.zi $(KRYON_DIR)/scripts/generate-widget-codecs.py $(KRYON_DIR)/src/backend/widget_codec.zi
	python3 scripts/generate-node-app-codec.py

.PHONY: cells
cells: $(CELL_BUNDLES) $(INBE_BUNDLE) $(INBE_FULL_BUNDLE)

$(CELL_BUNDLES) $(INBE_BUNDLE) $(INBE_FULL_BUNDLE) &: $(CELL_SOURCES) $(CELL_RESOURCES) ziran.lock apps/versions.json scripts/check-package-versions.py scripts/generate-package-versions.py scripts/prepare-package-assets.py scripts/animation_inventory.py scripts/build-cells.sh src/practices/sun_salutation/sun_salutation_assets.zi src/practices/sun_salutation/sun_salutation_inventory.zi $(IMAGE_FILES) $(SOUND_FILES) $(FONT_FILES) $(STYLE_FILES) $(LOCALE_FILES) $(ZIRAN_BIN)
	sh scripts/build-cells.sh $(ZIRAN_BIN)

# Apps the node offers build on their own, never into the root package.
NODE_APP_BUNDLES := $(BUILD_DIR)/node-apps/chess.zib $(BUILD_DIR)/node-apps/photos.zib
$(NODE_APP_BUNDLES) &: $(CELL_SOURCES) $(shell rg --files assets/chess assets/photos 2>/dev/null) apps/versions.json scripts/build-node-apps.sh scripts/prepare-package-assets.py $(ZIRAN_BIN)
	sh scripts/build-node-apps.sh $(ZIRAN_BIN)

.PHONY: node-apps
node-apps: $(NODE_APP_BUNDLES)
