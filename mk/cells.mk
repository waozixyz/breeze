# App packages: the cell bundles, the node apps and the codecs they share.

# App records cross the bundle boundary with codecs generated by Kryon's
# generator on top of Kryon's own widget codec.
APP_CODEC_SCHEMAS := $(KRYON_DIR)/scripts/generate-widget-codecs.py $(KRYON_DIR)/src/backend/widget_codec.zi apps/diary/diary_ui_types.zi $(addprefix src/cells/,inbe_ui_types.zi lists_ui_types.zi lumi_ui_types.zi lumi_types.zi leaderboard_ui_types.zi habits_ui_types.zi)
src/cells/app_codec.zi: scripts/generate-app-codec.py $(APP_CODEC_SCHEMAS)
	python3 scripts/generate-app-codec.py

ENTITY_DIR := build/packages/entity
ENTITY_SOURCES = $(wildcard $(ENTITY_DIR)/src/*.zi $(ENTITY_DIR)/assets/entity/*)
# The shared Apps controller is built from the locked Apps package with its
# own pinned graph, so its digest identifies the reviewed Apps release.
APPS_DIR := build/packages/apps
APPS_BUNDLE := build/apps-ui/apps.zib
$(BUILD_DIR)/apps-ui/apps.zib: ziran.lock $(wildcard $(APPS_DIR)/ziran.lock $(APPS_DIR)/src/*.zi $(APPS_DIR)/ui/*.zi $(APPS_DIR)/ui/locales/*.json)
	env -u DISPLAY -u WAYLAND_DISPLAY PATH="$(abspath $(dir $(ZIRAN_BIN))):$$PATH" \
		python3 $(APPS_DIR)/scripts/build-ui.py --output $(abspath $(dir $@))
.PHONY: cells
cells: $(CELL_BUNDLES) $(INBE_BUNDLE) $(INBE_FULL_BUNDLE)

$(CELL_BUNDLES) $(INBE_BUNDLE) $(INBE_FULL_BUNDLE): CHANGELOG.md scripts/release_notes.py $(APPS_BUNDLE) src/cells/apps_controller.zi

$(CELL_BUNDLES) $(INBE_BUNDLE) $(INBE_FULL_BUNDLE) &: $(ENTITY_SOURCES) $(CELL_SOURCES) $(CELL_RESOURCES) ziran.lock apps/versions.json scripts/check-package-versions.py scripts/generate-package-versions.py scripts/prepare-package-assets.py scripts/achievement_icons.py scripts/animation_inventory.py scripts/build-cells.sh src/practices/sun_salutation/sun_salutation_assets.zi src/practices/sun_salutation/sun_salutation_inventory.zi $(IMAGE_FILES) $(SOUND_FILES) $(FONT_FILES) $(STYLE_FILES) $(LOCALE_FILES) $(ZIRAN_BIN)
	sh scripts/build-cells.sh $(ZIRAN_BIN)

# Apps the node offers build on their own, never into the root package.
NODE_APP_NAMES := $(shell python3 -c 'import json; print(" ".join(json.load(open("apps/versions.json")).get("node_apps", {})))')
NODE_APP_BUNDLES := $(addprefix $(BUILD_DIR)/node-apps/,$(addsuffix .zib,$(NODE_APP_NAMES)))
$(NODE_APP_BUNDLES) &: $(CELL_SOURCES) $(shell rg --files $(addprefix assets/,$(NODE_APP_NAMES)) 2>/dev/null) apps/versions.json scripts/build-node-apps.sh scripts/prepare-package-assets.py scripts/achievement_icons.py $(ZIRAN_BIN)
	sh scripts/build-node-apps.sh $(ZIRAN_BIN)

.PHONY: node-apps
node-apps: $(NODE_APP_BUNDLES)
