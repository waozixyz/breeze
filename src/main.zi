#import, file "platform/trace_log.zi";
raylib :: #system_library "raylib";
BeginDrawing :: () #foreign raylib;
EndDrawing :: () #foreign raylib;
ClearBackground :: (color: Color) #foreign raylib;
CloseWindow :: () #foreign raylib;
IsWindowHidden :: () -> bool #foreign raylib;
IsWindowMinimized :: () -> bool #foreign raylib;
WindowShouldClose :: () -> bool #foreign raylib;

raylib_log :: #system_library "raylib";
LOG_INFO :: 3
c :: #system_library "c";
app_init :: (value: *void) #foreign c;
app_destroy :: (value: *void) #foreign c;

using DesktopTrayAction;
using AppClosePromptResult;
using AppMainTab;
using NavigationPlacement;
using ExerciseType;
using FrameStatus;
#import, file "platform/app_host.zi";
#import, file "platform/desktop_tray.zi";
#import, file "app/mini_mode.zi";

WEB_BUILD :: #defined(PLATFORM_WEB)
DESKTOP_TRAY_BUILD :: #defined(DESKTOP_TRAY_ENABLED)

app: InnerBreeze;

destroy_app_window :: () {
    #if DESKTOP_TRAY_BUILD {
        desktop_tray_shutdown()
    }
    app_destroy(cast(*void)*app)
    SetCurrentApp(null)
    CloseWindow()
    Shutdown()
}

shutdown_application :: () {
    destroy_app_window()

    // A desktop update may replace the process only after state, audio, and
    // the platform window have shut down cleanly.
    ApplyPendingUpdate()
}

run_screenshot_if_requested :: () -> s32 {
    result := CaptureScreenshot(*app)
    if result == 0 {
        return 0
    }

    shutdown_application()
    if result > 0 {
        return 0
    }
    return 1
}

practice_probe_frame_count: s32;

practice_probe_mode :: (argc: s32, argv: **u8) -> s32 {
    if argc < 2 {
        return 0
    }
    argument := AppTextFromCString(argv[1], 32)
    if argument == "--practice-banner" {
        return 1
    }
    if argument == "--practice-hero" {
        return 2
    }
    if argument == "--practice-screen" {
        return 3
    }
    if argument == "--practice-nav" {
        return 4
    }
    return 0
}

run_practice_probe :: (mode: s32, size: WindowSize) -> s32 {
    app.ui.session = SessionOpen()
    if !SessionValid(app.ui.session) {
        CloseWindow()
        return 1
    }
    app.ui.view_width = size.width
    app.ui.view_height = size.height
    app.camera.zoom = 1.0
    app.exercise_type = EXERCISE_MEDITATION
    app.main_tab = APP_MAIN_TAB_PRACTICE
    app.practice_tab = PRACTICE_TAB_PLAY
    app.breathing.screen = ScreenStart
    if mode == 4 {
        app.navigation_placement = NAVIGATION_BOTTOM
        app_reset_bottom_nav_routes(*app)
    }
    SetCurrentApp(*app)
    while !WindowShouldClose() {
        first_probe_frame := practice_probe_frame_count == 0
        practice_probe_frame_count += 1
        FrameTextReset(*app.ui.frame_text)
        BeginDrawing()
        ClearBackground(Color.{30, 40, 50, 255})
        bounds := Rectangle.{0.0, 0.0,
            cast(float32)size.width, cast(float32)size.height}
        if cast(s32)BeginFrame(app.ui.session, KeyHash("practice/probe"),
            bounds) == 0 {
            if mode == 4 {
                if first_probe_frame {
                    TraceLog(LOG_INFO, "APP PROBE: before navigation bar")
                }
                app_draw_bottom_nav(*app)
                if first_probe_frame {
                    TraceLog(LOG_INFO, "APP PROBE: after navigation bar")
                }
            } else if mode == 1 {
                practice_draw_card_banner(
                    "assets/practices/meditation/banner-dark.png",
                    Rectangle.{0.0, 0.0,
                        cast(float32)size.width, 360.0})
            } else if mode == 2 {
                unused practice_screen_draw_home_hero(*app)
            } else {
                practice_screen_draw_home(*app)
            }
            if first_probe_frame {
                TraceLog(LOG_INFO, "APP PROBE: before EndFrame")
            }
            unused EndFrame(app.ui.session)
            if first_probe_frame {
                TraceLog(LOG_INFO, "APP PROBE: after EndFrame")
            }
        }
        EndDrawing()
        if mode == 4 && first_probe_frame && CaptureRequested() {
            unused CaptureConfigured()
        }
    }
    SetCurrentApp(null)
    CloseWindow()
    return 0
}

#if DESKTOP_TRAY_BUILD {
    run_desktop_tray_loop :: () {
        quit: s32 = 0

        while quit == 0 {
            tray_action: DesktopTrayAction = desktop_tray_poll_action()
            close_result: AppClosePromptResult =
            cast(AppClosePromptResult)AppClosePromptNone
            close_requested := TakeWindowCloseRequest()

            if ShutdownRequested() != 0 {
                TraceLog(LOG_INFO, "APP: quit requested by shutdown signal")
                quit = 1
            }
            if (IsWindowHidden() || IsWindowMinimized())  && desktop_tray_ready() == 0 {
                TraceLog(LOG_INFO, "APP: tray indicator unavailable; stopping background execution")
                quit = 1
            }
            if quit == 0 && tray_action != cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_NONE {
                desktop_tray_apply_action(*app, tray_action, *quit)
            }
            if close_requested != 0 && app.close_prompt_open == 0 {
                desktop_tray_apply_action(*app,
                    cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_CLOSE_REQUEST,
                    *quit)
            }
            if quit == 0 {
                DrawFrame(*app)
                desktop_tray_update_status(*app)
            }

            close_result = app_consume_close_prompt_result(*app)
            if close_result == cast(AppClosePromptResult)AppClosePromptKeepRunning {
                if desktop_tray_keep_running() == 0 {
                    quit = 1
                }
            } else if close_result == cast(AppClosePromptResult)AppClosePromptQuit {
                TraceLog(LOG_INFO, "APP: quit requested by close prompt")
                quit = 1
            }

            if app.request_quit != 0 {
                TraceLog(LOG_INFO, "APP: quit requested by app layer")
                quit = 1
            }

            tray_action = desktop_tray_poll_action()
            if tray_action != cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_NONE {
                desktop_tray_apply_action(*app, tray_action, *quit)
            }
            close_requested = TakeWindowCloseRequest()
            if close_requested != 0 && app.close_prompt_open == 0 {
                desktop_tray_apply_action(*app,
                    cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_CLOSE_REQUEST,
                    *quit)
            }
        }
    }
}

#if !WEB_BUILD && !DESKTOP_TRAY_BUILD {
    run_desktop_window_loop :: () {
        quit: bool = false

        while ShutdownRequested() == 0 && !quit {
            #if #defined(PLATFORM_DESKTOP) {
                if IsWindowHidden() || IsWindowMinimized() {
                    TraceLog(LOG_INFO, "APP: no tray indicator; stopping background execution")
                    break
                }
            }
            DrawFrame(*app)
            if WindowShouldClose() || TakeWindowCloseRequest() != 0 ||
            ShutdownRequested() != 0 || app.request_quit != 0 {
                quit = true
            }
        }
    }
}

run_application :: (argc: s32, argv: **u8) -> s32 {
    window_size: WindowSize

    probe_mode := practice_probe_mode(argc, argv)
    if probe_mode == 1 || probe_mode == 4 {
        window_size = ifx probe_mode == 4 then WindowSize.{480, 780}
        else WindowSize.{900, 720}
        InitWindow(window_size.width, window_size.height,
            "Practice component probe")
        return run_practice_probe(probe_mode, window_size)
    }

    Prepare(argc, argv)
    window_size = InitialWindowSize()
    ConfigureWindow()

    InitWindow(window_size.width, window_size.height, WindowTitle())
    if FinishWindowSetup() == 0 {
        return 1
    }

    if probe_mode != 0 {
        return run_practice_probe(probe_mode, window_size)
    }

    app_init(cast(*void)*app)
    if !SubappsReady() {
        destroy_app_window()
        return 1
    }
    FinishAppSetup(*app, argc, argv)

    #if WEB_BUILD {
        StartWebLoop(*app)
        return 0
    } else {
        InstallShutdownHandlers()

        #if DESKTOP_TRAY_BUILD {
            // The mini window is a quick practice with nothing to keep
            // running, so it opens no tray icon.
            if !AppMiniMode() {
                desktop_tray_init()
                if ShouldStartHidden(*app) != 0 {
                    TraceLog(LOG_INFO, "APP: starting hidden in the tray (startup mode)")
                    desktop_tray_keep_running()
                }
            }
        }

        screenshot_exit := run_screenshot_if_requested()
        if screenshot_exit != 0 || ScreenshotRequested() != 0 {
            return screenshot_exit
        }

        #if DESKTOP_TRAY_BUILD {
            run_desktop_tray_loop()
        } else {
            run_desktop_window_loop()
        }

        shutdown_application()
        return 0
    }
}

// Emscripten's clang requires main(int, char **); the page passes no arguments.
#if #defined(PLATFORM_WEB) {
    main :: () -> s32 {
        return run_application(0, null)
    }
} else {
    main :: (argc: s32, argv: **u8) -> s32 {
        return run_application(argc, argv)
    }
}
