// Practice modules call these Ziran screen functions without importing the
// screen's registry dependency back into themselves.
#import, file "practice_subscreen_layout.zi";
#import, file "../app/app_types.zi";

c :: #system_library "c";
practice_screen_subscreen_integrated :: (app: *InnerBreeze,
    modal_type: s32) -> s32 #foreign c;
practice_screen_config_layout :: (app: *InnerBreeze, modal_type: s32,
    content_top_gap: s32, layout: *PracticeSubscreenLayout) #foreign c;
practice_screen_handle_config_title :: (app: *InnerBreeze, title: string,
    modal_type: s32, has_leave_config: s32) -> s32 #foreign c;

#program_export
PracticeConfigIntegrated :: (app: *InnerBreeze, modal_type: s32) -> s32 {
    return practice_screen_subscreen_integrated(app, modal_type)
}

#program_export
PracticeConfigLayout :: (app: *InnerBreeze, modal_type: s32,
    content_top_gap: s32, layout: *PracticeSubscreenLayout) {
    practice_screen_config_layout(app, modal_type, content_top_gap, layout)
}

#program_export
PracticeConfigTitle :: (app: *InnerBreeze, title: string,
    modal_type: s32, has_leave_config: s32) -> s32 {
    return practice_screen_handle_config_title(app, title, modal_type,
        has_leave_config)
}
