// A child app gets a loading cover until its first complete picture frame.
// Keep the existing per-app history when moving between a collection's apps.
NodeScreenLoadingState :: struct {
    shown: [16]u64
    next: s32
    opening: u64
    ready_frame: bool
}

NodeScreenWasShown :: (state: *NodeScreenLoadingState, identity: u64) -> bool {
    for shown: state.shown {
        if shown == identity {
            return true
        }
    }
    return false
}

NodeScreenNeedsCover :: (state: *NodeScreenLoadingState, identity: u64, pictures_ready: bool) -> bool {
    // Later sprites belong to gameplay, not to the app's opening stage.
    if NodeScreenWasShown(state, identity) {
        state.opening = 0
        state.ready_frame = false
        return false
    }
    if state.opening != identity {
        state.opening = identity
        state.ready_frame = false
        return true
    }
    if !pictures_ready {
        state.ready_frame = false
        return true
    }
    // The opening frame can be ready before the board has requested its
    // pictures. Keep one fully ready frame covered so its image requests
    // and completed painting are observed before revealing the app.
    if !state.ready_frame {
        state.ready_frame = true
        return true
    }
    state.shown[state.next] = identity
    state.next = (state.next + 1) % cast(s32)state.shown.count
    state.opening = 0
    state.ready_frame = false
    return false
}
