// What each Practice banner is made of: its painted land and figure, its own
// sky scenery and, over the ice bath, the water the cold vapour leaves.
#import, file "practice_banner_sky.zi";
#import, file "practice_banner_steam.zi";

PracticeBannerScene :: struct {
    landscape: string
    character: string
    sky: PracticeSkyScenery
    steam: PracticeSteamSource
}

// The sky is painted a little below the lowest gap in the landscape.
PRACTICE_BANNER_SKY_MARGIN :: 0.03

// The part of the 2:1 painting a banner of this size shows when the painting
// covers it.
PracticeBannerViewFor :: (width: float64, height: float64) -> PracticeBannerView {
    if width <= 0.0 || height <= 0.0 {
        return .{}
    }
    if width <= height * 2.0 {
        shown := width / (height * 2.0)
        return .{(1.0 - shown) * 0.5, 0.0, shown, 1.0}
    }
    shown := height * 2.0 / width
    return .{0.0, (1.0 - shown) * 0.5, 1.0, shown}
}

// The part of VIEW that holds sky, down to just under the land's lowest gap.
PracticeBannerSkyView :: (view: PracticeBannerView, sky: PracticeSkyScenery) -> PracticeBannerView {
    bottom := sky.horizon_line + PRACTICE_BANNER_SKY_MARGIN
    if bottom > view.top + view.height {
        bottom = view.top + view.height
    }
    if bottom <= view.top {
        return .{}
    }
    return .{view.left, view.top, view.width, bottom - view.top}
}

// The part two views share; its width or height is zero when they do not meet.
PracticeBannerViewOverlap :: (a: PracticeBannerView, b: PracticeBannerView) -> PracticeBannerView {
    left := ifx a.left > b.left then a.left else b.left
    top := ifx a.top > b.top then a.top else b.top
    right := ifx a.left + a.width < b.left + b.width then a.left + a.width else b.left + b.width
    bottom := ifx a.top + a.height < b.top + b.height then a.top + a.height else b.top + b.height
    if right <= left || bottom <= top {
        return .{}
    }
    return .{left, top, right - left, bottom - top}
}

#scope_file
practice_banner_ice_bath :: (night: bool) -> PracticeSteamSource {
    color: u32 = ifx night then 0xb6d6ed else 0xf4fbff
    return .{count = 28, seed = 7, left = 0.39, right = 0.61, surface = 0.655, rise = 0.42, drift = 0.022,
        color = color, opacity = ifx night then 0.65 else 0.85}
}

// ASSET is the banner's whole painting. A scene without a landscape has no
