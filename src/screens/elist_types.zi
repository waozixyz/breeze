
ELIST_LIST_MAX :: 32
ELIST_ITEM_MAX :: 256
ELIST_TITLE_SIZE :: 32768
ELIST_COMMENT_SIZE :: 32768

EListList :: struct {
    id: [37]u8
    title: [ELIST_TITLE_SIZE]u8
    sort_order: s32
    deleted_at: s64
    updated_at: s64
    shared: bool
    owner: bool
    owner_id: [65]u8
    owner_alias: [128]u8
    read_only: bool
    revision: s64
    item_total: s32
    incomplete: bool
    // Who has access besides this account, as in ListsUiRow.
    people: [256]u8
    invited: [256]u8
}

EListItem :: struct {
    id: [37]u8
    list_id: [37]u8
    title: [ELIST_TITLE_SIZE]u8
    comment: [ELIST_COMMENT_SIZE]u8
    done: s32
    sort_order: s32
    deleted_at: s64
    updated_at: s64
}

EListState :: struct {
    lists: [ELIST_LIST_MAX]EListList
    items: [ELIST_ITEM_MAX]EListItem
    list_count: s32
    item_count: s32
    selected_list: s32
    loaded: s32
    scroll: s32
    show_completed: s32
    completing_item: [37]u8
    completing_until: float64
    input_cursor: s32
    input_anchor: s32
    input_scroll_x: s32
    input_focused: s32
    comment_cursor: s32
    comment_anchor: s32
    comment_scroll_y: s32
    comment_focused: s32
    editing_item: s32
    input_committed: s32
    input_error: s32
    input: [ELIST_TITLE_SIZE]u8
    input_frame: [ELIST_TITLE_SIZE]u8
    input_comment: [ELIST_COMMENT_SIZE]u8
    input_comment_frame: [ELIST_COMMENT_SIZE]u8
    task_priority: s32
    // Ephemeral host cache; these fields never enter the database or sync.
    visibility_valid: bool
    visibility_selected_list: s32
    visibility_show_completed: s32
    visibility_count: s32
    visibility_deadline: float64
    item_visibility: [ELIST_ITEM_MAX]bool
    tab_scroll: s32
    panel: s32
}

elist_reset :: (state: *EListState, editing_item: s32) {
    for list_index: cast(s32)0..ELIST_LIST_MAX - 1 {
        state.lists[list_index] = EListList.{}
    }
    for item_index: cast(s32)0..ELIST_ITEM_MAX - 1 {
        state.items[item_index] = EListItem.{}
    }
    state.list_count = 0
    state.item_count = 0
    state.selected_list = 0
    state.loaded = 0
    state.scroll = 0
    state.show_completed = 0
    state.completing_item[0] = cast(u8)0
    state.completing_until = 0.0
    state.input_cursor = 0
    state.input_anchor = 0
    state.input_scroll_x = 0
    state.input_focused = 0
    state.comment_cursor = 0
    state.comment_anchor = 0
    state.comment_scroll_y = 0
    state.comment_focused = 0
    state.editing_item = editing_item
    state.input_committed = 0
    state.input_error = 0
    for title_index: cast(s32)0..ELIST_TITLE_SIZE - 1 {
        state.input[title_index] = cast(u8)0
        state.input_frame[title_index] = cast(u8)0
    }
    for comment_index: cast(s32)0..ELIST_COMMENT_SIZE - 1 {
        state.input_comment[comment_index] = cast(u8)0
        state.input_comment_frame[comment_index] = cast(u8)0
    }
    state.task_priority = 0
    state.visibility_valid = false
    state.visibility_selected_list = 0
    state.visibility_show_completed = 0
    state.visibility_count = 0
    state.visibility_deadline = 0.0
    for visibility_index: cast(s32)0..ELIST_ITEM_MAX - 1 {
        state.item_visibility[visibility_index] = false
    }
    state.tab_scroll = 0
    state.panel = 0
}
