
ELIST_LIST_MAX :: 32
ELIST_ITEM_MAX :: 256
ELIST_TITLE_SIZE :: 128
ELIST_COMMENT_SIZE :: 512

EListList :: struct {
    id: [37]u8
    title: [ELIST_TITLE_SIZE]u8
    sort_order: s32
    deleted_at: s64
    updated_at: s64
}

EListItem :: struct {
    id: [37]u8
    list_id: [37]u8
    title: [ELIST_TITLE_SIZE]u8
    comment: [ELIST_COMMENT_SIZE]u8
    done: s32
    sort_order: s32
    deleted_at: s64
    updated_at: s64
}

EListState :: struct {
    lists: [ELIST_LIST_MAX]EListList
    items: [ELIST_ITEM_MAX]EListItem
    list_count: s32
    item_count: s32
    selected_list: s32
    loaded: s32
    scroll: s32
    show_completed: s32
    completing_item: [37]u8
    completing_until: float64
    input_cursor: s32
    input_anchor: s32
    input_scroll_x: s32
    input_focused: s32
    editing_item: s32
    input_committed: s32
    input_error: s32
    input: [ELIST_TITLE_SIZE]u8
    input_frame: [ELIST_TITLE_SIZE]u8
    // Ephemeral host cache; these fields never enter the database or sync.
    visibility_valid: bool
    visibility_selected_list: s32
    visibility_show_completed: s32
    visibility_count: s32
    visibility_deadline: float64
    item_visibility: [ELIST_ITEM_MAX]bool
}
