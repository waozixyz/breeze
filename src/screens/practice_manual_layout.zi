#import "geometry"
#import, file "../core/types.zi";
#import, file "../app/app_chrome.zi";
#import, file "../app/app_nav_state.zi";
#import, file "../app/app_types.zi";
#import, file "../app/metrics.zi";
#import, file "../app/modal_rules.zi";
#import, file "manual_screen.zi";

using ModalType;

PracticeManualLayout :: struct {
    integrated: s32
    title_h: s32
    nav_y: s32
    nav_h: s32
    content_y: s32
    content_h: s32
}

#program_export
practice_screen_manual_layout :: (app: *InnerBreeze,
    modal_type: ModalType, page_count: s32, content_top_gap: s32,
    content_bottom_gap: s32, min_content_h: s32) -> PracticeManualLayout {
    layout: PracticeManualLayout
    if app == null { return layout }
    integrated := app.breathing.screen == ScreenStart  && app.modal.type != modal_type
    if integrated { layout.integrated = 1 }
    layout.title_h = AppTitleBarHeight()
    if integrated { layout.title_h = app_content_top_reserved(app) }
    if app_nav_desktop_rail_enabled(app) != 0 { layout.title_h = 0 }
    if page_count > 1 { layout.nav_h = manual_screen_guide_nav_height() }
    bottom_reserved: s32 = 0
    if integrated { bottom_reserved = app_content_bottom_reserved(app) }
    layout.content_y = layout.title_h + content_top_gap
    layout.nav_y = app.ui.view_height - bottom_reserved - layout.nav_h
    layout.content_h = layout.nav_y - layout.content_y -         content_bottom_gap
    if layout.content_h < min_content_h {
        layout.content_h = min_content_h
    }
    return layout
}
