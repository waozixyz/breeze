using TextWrap;
using TextAlign;
using ButtonTone;
using ButtonEmphasis;
using ModalType;

// The storage plans window: 0 is Free, then each paid size.
profile_storage_tab: s32;
profile_storage_scroll: s32;
// The top-up window asks the node for this account's Monero address once
// per opening; an answer without an address is a failure to retry.
profile_topup_scroll: s32;
profile_topup_started: bool;
profile_topup_failed: bool;
profile_topup_copied: bool;
// Top-up minimums under 0.001 XMR are not worth naming.
TopUpMinimumShown :: 1000000000

ProfileDewText :: (app: *InnerBreeze, text: string, x: s32, y: *s32,
    width: s32, font: s32, draw: bool) {
    height := AppParagraphHeight(text, width, font, 0)
    if draw {
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                    cast(float32)width, cast(float32)height},
                .text = FrameTextHold(*app.ui.frame_text, text),
                .font = font,
                .wrap = cast(TextWrap)TextWrapAuto})
    }
    y.* += height + AppScale(8)
}

ProfileDewButton :: (app: *InnerBreeze, label: string, x: s32, y: *s32,
    width: s32, disabled: bool, draw: bool, detail: string = "") -> bool {
    height := AppScale(ifx detail.count > 0 then 58 else 44)
    clicked := false
    if draw {
        clicked = Button(app.ui.session, ButtonProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                    cast(float32)width, cast(float32)height},
                .label = FrameTextHold(*app.ui.frame_text, label),
                .detail = FrameTextHold(*app.ui.frame_text, detail),
                .tone = cast(ButtonTone)ButtonToneAccent,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
                .disabled = disabled}) != 0
    }
    y.* += height + AppScale(8)
    return clicked
}

ProfileDewFormatDew :: (units: s64, template: string, output: []u8) {
    amount: [48]u8
    unused DewFormat(units, DewUnits, amount[:])
    arguments: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(amount[:]), .is_text = true}]
    unused FormatTemplate(template, arguments[:], output)
}

// Whole gigabytes or megabytes, as the node sizes its plans.
ProfileDewSizeText :: (bytes: s64, output: []u8) {
    gigabyte: s64 = 1073741824
    if bytes >= gigabyte && bytes % gigabyte == 0 {
        unused FormatNumberTemplate(LocaleText("profile_dew_gb"), cast(s32)(bytes / gigabyte), output)
        return
    }
    unused FormatNumberTemplate(LocaleText("profile_dew_mb"), cast(s32)(bytes / 1048576), output)
}

// What the account holds against its allowance, with the node cards' bar.
ProfileDewUsage :: (app: *InnerBreeze, x: s32, y: *s32, width: s32, draw: bool) {
    if dew_account.limit_bytes <= 0 {
        return
    }
    storage := SyncNodeStorage.{.known = true,
        .used_bytes = dew_account.used_bytes, .limit_bytes = dew_account.limit_bytes}
    bar_h := AppScale(8)
    if draw {
        Box(app.ui.session, BoxProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                    cast(float32)width, cast(float32)bar_h},
                .fill = DarkenColor(StyleTokenColor("canvas"), 18),
                .radius = cast(float32)bar_h / 2.0})
        fill_w := cast(s32)(cast(s64)width * cast(s64)SyncNodeStoragePercent(storage) / 100)
        if storage.used_bytes > 0 && fill_w < bar_h {
            fill_w = bar_h
        }
        color := StyleTokenColor("accent")
        if storage.used_bytes >= storage.limit_bytes {
            color = StyleTokenColorOr("storage-full", Color.{179, 38, 30, 255})
        } else if SyncNodeStorageNearlyFull(storage) {
            color = StyleTokenColorOr("storage-warning", Color.{163, 98, 0, 255})
        }
        if fill_w > 0 {
            Box(app.ui.session, BoxProps.{
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                        cast(float32)fill_w, cast(float32)bar_h},
                    .fill = color,
                    .radius = cast(float32)bar_h / 2.0})
        }
    }
    y.* += bar_h + AppScale(8)
    used: [32]u8
    limit: [32]u8
    line: [96]u8
    unused SyncStorageFormatBytes(storage.used_bytes, used[:])
    unused SyncStorageFormatBytes(storage.limit_bytes, limit[:])
    arguments: [2]FormatArg = .[
    FormatArg.{.text = TextUntilNul(used[:]), .is_text = true},
    FormatArg.{.text = TextUntilNul(limit[:]), .is_text = true}]
    unused FormatTemplate(LocaleText("profile_node_storage_used_of"), arguments[:], line[:])
    ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppSmallFontSize(), draw)
}

ProfileDewDaysLeft :: () -> s32 {
    return cast(s32)((dew_account.expires_at - DewNow() + 86399) / 86400)
}

// 1 + the paid size in use, or 0 on the free plan.
ProfileDewCurrentSize :: () -> s32 {
    if dew_account.limit_bytes > dew_account.free_bytes && dew_account.expires_at > DewNow() {
        return ifx dew_account.plan_size > 0 then dew_account.plan_size else 1
    }
    return 0
}

// Measuring and drawing use the same wrapped lines and controls.
ProfileDewContent :: (app: *InnerBreeze, x: s32, y: *s32, width: s32,
    draw: bool) {
    ProfileDewText(app, LocaleText("profile_dew_title"), x, y, width, AppFontSize(), draw)
    value: [48]u8
    if dew_account.known && DewReady() {
        unused DewFormat(dew_account.balance, DewUnits, value[:])
        unused AppAppendText(" Dew", value[:])
    } else {
        unused AppCopyText("—", value[:])
    }
    busy := dew_operation.active
    // Top-ups belong to the balance they fill; the Play build sells no Dew.
    if dew_account.known && DewReady() && DewTopUpAvailable() {
        label := LocaleText("profile_dew_topup")
        button_w := AppTextWidth(label, AppFontSize()) + AppScale(32)
        if button_w > width / 2 {
            button_w = width / 2
        }
        row_y := y.*
        text_w := width - button_w - AppScale(12)
        text_h := AppParagraphHeight(TextUntilNul(value[:]), text_w, AppScale(Text24), 0)
        row_h := AppScale(44)
        if text_h > row_h {
            row_h = text_h
        }
        text_y := row_y + (row_h - text_h) / 2
        ProfileDewText(app, TextUntilNul(value[:]), x, *text_y, text_w, AppScale(Text24), draw)
        button_y := row_y + (row_h - AppScale(44)) / 2
        if ProfileDewButton(app, label, x + width - button_w, *button_y, button_w, busy, draw) {
            ProfileTopUpOpen(app)
        }
        y.* = row_y + row_h + AppScale(8)
    } else {
        ProfileDewText(app, TextUntilNul(value[:]), x, y, width, AppScale(Text24), draw)
    }
    if !DewReady() {
        ProfileDewText(app, LocaleText("profile_dew_connect"), x, y, width, AppSmallFontSize(), draw)
        return
    }
    if !dew_account.known {
        ProfileDewText(app, LocaleText(ifx dew_notice.count > 0 then "profile_dew_error"
            else "profile_dew_loading"), x, y, width, AppSmallFontSize(), draw)
        return
    }
    plan: [96]u8
    current := ProfileDewCurrentSize()
    if current > 0 {
        size: [24]u8
        ProfileDewSizeText(dew_account.limit_bytes, size[:])
        arguments: [2]FormatArg = .[
        FormatArg.{.text = TextUntilNul(size[:]), .is_text = true},
        FormatArg.{.number = ProfileDewDaysLeft()}]
        unused FormatTemplate(LocaleText("profile_dew_paid"), arguments[:], plan[:])
    } else {
        // The node says how much it gives for free; nothing here fixes it.
        free := dew_account.free_bytes
        if free <= 0 {
            free = dew_account.limit_bytes
        }
        if free > 0 {
            size: [24]u8
            ProfileDewSizeText(free, size[:])
            arguments: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(size[:]), .is_text = true}]
            unused FormatTemplate(LocaleText("profile_dew_free"), arguments[:], plan[:])
        } else {
            unused AppCopyText(LocaleText("profile_dew_plan_free"), plan[:])
        }
    }
    ProfileDewText(app, TextUntilNul(plan[:]), x, y, width, AppFontSize(), draw)
    ProfileDewUsage(app, x, y, width, draw)
    if dew_notice.count > 0 {
        ProfileDewText(app, LocaleText(dew_notice), x, y, width, AppSmallFontSize(), draw)
    }
    if dew_account.used_bytes >= dew_account.limit_bytes && dew_account.limit_bytes > 0 {
        ProfileDewText(app, LocaleText("profile_dew_full"), x, y, width, AppSmallFontSize(), draw)
    }
    if !dew_account.enabled {
        ProfileDewText(app, LocaleText("profile_dew_disabled"), x, y, width, AppSmallFontSize(), draw)
    } else if ProfileDewButton(app, LocaleText("profile_dew_plans"), x, y, width, false, draw) {
        ProfileStoragePlansOpen(app)
    }
}

ProfileDewHeight :: (app: *InnerBreeze, width: s32) -> s32 {
    if !DewAvailable() {
        return 0
    }
    y := AppScale(14)
    ProfileDewContent(app, 0, *y, width - AppScale(28), false)
    return y + AppScale(20)
}

ProfileDewDraw :: (app: *InnerBreeze, x: s32, y: *s32, width: s32) {
    height := ProfileDewHeight(app, width)
    if height == 0 {
        return
    }
    if dew_account.known && DewReady() {
        DewRatesRefresh()
    }
    Box(app.ui.session, BoxProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                cast(float32)width, cast(float32)(height - AppScale(8))},
            .fill = DarkenColor(StyleTokenColor("canvas"), 7),
            .radius = cast(float32)AppScale(12)})
    inner := y.* + AppScale(14)
    ProfileDewContent(app, x + AppScale(14), *inner, width - AppScale(28), true)
    y.* += height
}

// "0.1 XMR = 1000 Dew, about 55.66 USD" from the node's funding quote; the
// USD part only while the node has a current Monero price.
ProfileDewExchangeText :: (output: []u8) -> bool {
    rates := DewFundingRate()
    if !rates.known {
        return false
    }
    atomic: s64 = DewExampleAtomic
    units := DewUnitsForXmr(atomic, rates.xmr_atomic_units, rates.token_units)
    if units <= 0 {
        return false
    }
    dew: [48]u8
    xmr: [48]u8
    usd: [48]u8
    unused DewFormat(units, DewUnits, dew[:])
    unused DewFormat(atomic, 1000000000000LL, xmr[:])
    if !DewUsdText(atomic, usd[:]) {
        arguments: [2]FormatArg = .[
        FormatArg.{.text = TextUntilNul(xmr[:]), .is_text = true},
        FormatArg.{.text = TextUntilNul(dew[:]), .is_text = true}]
        return FormatTemplate(LocaleText("profile_dew_exchange_xmr"), arguments[:], output)
    }
    arguments: [3]FormatArg = .[
    FormatArg.{.text = TextUntilNul(xmr[:]), .is_text = true},
    FormatArg.{.text = TextUntilNul(dew[:]), .is_text = true},
    FormatArg.{.text = TextUntilNul(usd[:]), .is_text = true}]
    return FormatTemplate(LocaleText("profile_dew_exchange"), arguments[:], output)
}

ProfileStoragePlansOpen :: (app: *InnerBreeze) {
    // A waiting purchase opens on the size it asked for.
    profile_storage_tab = DewAttemptSize()
    if profile_storage_tab == 0 {
        profile_storage_tab = ProfileDewCurrentSize()
    }
    profile_storage_scroll = 0
    app_open_modal(app, cast(ModalType)ModalStoragePlans)
}

ProfileStoragePlansContent :: (app: *InnerBreeze, x: s32, y: *s32, width: s32,
    draw: bool) {
    line: [192]u8
    ProfileDewFormatDew(dew_account.balance, LocaleText("profile_dew_balance_line"), line[:])
    ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppSmallFontSize(), draw)
    ProfileDewUsage(app, x, y, width, draw)
    labels: [1 + DewPlanCount][24]u8
    unused AppCopyText(LocaleText("profile_dew_plan_free"), labels[0][:])
    for index: cast(s32)0..DewPlanCount - 1 {
        ProfileDewSizeText(dew_account.plans[index].limit_bytes, labels[index + 1][:])
    }
    if draw {
        options: [1 + DewPlanCount]SegmentOption
        for index: cast(s32)0..DewPlanCount {
            options[index].label = FrameTextHold(*app.ui.frame_text, TextUntilNul(labels[index][:]))
        }
        props: SegmentedControlProps
        props.key = KeyHash("profile/storage/tabs")
        props.bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(42)}
        props.height = AppScale(42)
        props.selected_index = profile_storage_tab
        props.has_selection = true
        choice := SegmentedControl(app.ui.session, props, options[:])
        if choice.changed {
            profile_storage_tab = choice.selected_index
            dew_notice = ""
        }
    }
    y.* += AppScale(54)
    tab := profile_storage_tab
    size: [24]u8
    if tab == 0 {
        ProfileDewSizeText(dew_account.free_bytes, size[:])
    } else {
        unused AppCopyText(TextUntilNul(labels[tab][:]), size[:])
    }
    ProfileDewText(app, TextUntilNul(size[:]), x, y, width, AppScale(Text24), draw)
    current := ProfileDewCurrentSize()
    if tab == current {
        if current == 0 {
            unused AppCopyText(LocaleText("profile_dew_plan_current"), line[:])
        } else {
            unused FormatNumberTemplate(LocaleText("profile_dew_plan_current_days"), ProfileDewDaysLeft(), line[:])
        }
        ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppFontSize(), draw)
    } else if tab == 0 {
        ProfileDewText(app, LocaleText("profile_dew_plan_free_after"), x, y, width, AppSmallFontSize(), draw)
    } else if current > 0 {
        ProfileDewText(app, LocaleText("profile_dew_plan_switch"), x, y, width, AppSmallFontSize(), draw)
    }
    if dew_notice.count > 0 {
        ProfileDewText(app, LocaleText(dew_notice), x, y, width, AppSmallFontSize(), draw)
    }
    if tab == 0 {
        return
    }
    if !dew_account.enabled {
        ProfileDewText(app, LocaleText("profile_dew_disabled"), x, y, width, AppSmallFontSize(), draw)
        return
    }
    busy := dew_operation.active
    if dew_attempt[0] != cast(u8)0 {
        if ProfileDewButton(app, LocaleText("profile_dew_retry"), x, y, width, busy, draw) {
            DewBuyStorage("", "")
        }
    } else {
        // Plans are priced in Dew alone.
        offer := dew_account.plans[tab - 1]
        ProfileDewFormatDew(offer.monthly_units, LocaleText("profile_dew_month"), line[:])
        if ProfileDewButton(app, TextUntilNul(line[:]), x, y, width, busy, draw) {
            DewBuyStorage(DewPlanSizes[tab - 1], "monthly")
        }
        ProfileDewFormatDew(offer.yearly_units, LocaleText("profile_dew_year"), line[:])
        if ProfileDewButton(app, TextUntilNul(line[:]), x, y, width, busy, draw) {
            DewBuyStorage(DewPlanSizes[tab - 1], "yearly")
        }
    }
    ProfileDewText(app, LocaleText("profile_dew_rates"), x, y, width, AppSmallFontSize(), draw)
}

ProfileStoragePlansModalDraw :: (app: *InnerBreeze) {
    width := app.ui.view_width - AppScale(32)
    if width > AppScale(520) {
        width = AppScale(520)
    }
    if profile_storage_tab < 0 || profile_storage_tab > DewPlanCount {
        profile_storage_tab = 0
    }
    // The window fits its tallest tab, so switching tabs never resizes it.
    chosen := profile_storage_tab
    tallest: s32 = 0
    for tab: cast(s32)0..DewPlanCount {
        profile_storage_tab = tab
        measured: s32 = 0
        ProfileStoragePlansContent(app, 0, *measured, width - AppScale(46), false)
        if measured > tallest {
            tallest = measured
        }
    }
    profile_storage_tab = chosen
    height := tallest + AppScale(96)
    if height > app.ui.view_height - AppScale(48) {
        height = app.ui.view_height - AppScale(48)
    }
    DewRatesRefresh()
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("profile/storage/modal"), .title = LocaleText("profile_dew_plans"),
            .width = width, .height = height, .scale = MetricsScale(),
            .title_at_start = true, .strong_title = true,
            .has_right_action = true, .right_label = LocaleText("close_button")})
    // Plans need a known account; signing out or switching closes the window.
    if frame.dismissed || frame.right_clicked || !DewReady() || !dew_account.known {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    content_w := cast(s32)frame.layout.content.width - AppScale(10)
    content_h: s32 = 0
    ProfileStoragePlansContent(app, 0, *content_h, content_w, false)
    scroll := Scroll(app.ui.session, ScrollProps.{
            .key = KeyHash("profile/storage/scroll"), .bounds = frame.layout.content,
            .content_height = content_h, .scroll_offset = profile_storage_scroll})
    profile_storage_scroll = scroll.scroll_offset
    if scroll.opened {
        y := cast(s32)scroll.content.y
        ProfileStoragePlansContent(app, cast(s32)scroll.content.x, *y, content_w, true)
        End(app.ui.session)
    }
    End(app.ui.session)
}

ProfileTopUpOpen :: (app: *InnerBreeze) {
    profile_topup_scroll = 0
    profile_topup_started = false
    profile_topup_failed = false
    profile_topup_copied = false
    // Reopening asks for a fresh quote, even if this account has deposited
    // before. Never keep an old address rate for the lifetime of the app.
    dew_address = .{}
    dew_rate_atomic = 0
    dew_rate_units = 0
    dew_confirmations = 0
    dew_minimum_atomic = 0
    app_open_modal(app, cast(ModalType)ModalDewTopUp)
}

// Starts the address request once the shared Dew request is free, and notices
// when it finished without an address.
ProfileTopUpPump :: () {
    if dew_operation.active {
        return
    }
    if dew_address[0] != cast(u8)0 {
        profile_topup_failed = false
        return
    }
    if profile_topup_started {
        profile_topup_failed = true
        return
    }
    if profile_topup_failed {
        return
    }
    DewTopUp()
    profile_topup_started = dew_operation.active
}

// A Monero address is one 95-character word; it is shown in lines that fit.
ProfileTopUpAddressText :: (output: []u8) {
    address := TextUntilNul(dew_address[:])
    at: s64 = 0
    while at < address.count {
        end := at + 32
        if end > address.count {
            end = address.count
        }
        if at > 0 {
            unused AppAppendText("\n", output)
        }
        unused AppAppendText(address[at:end], output)
        at = end
    }
}

// Topping up is the one place Dew shows its money value: the balance's
// worth and the node's exchange rate.
ProfileTopUpContent :: (app: *InnerBreeze, x: s32, y: *s32, width: s32, draw: bool) {
    line: [384]u8
    ProfileDewFormatDew(dew_account.balance, LocaleText("profile_dew_balance_line"), line[:])
    DewAppendWorth(dew_account.balance, line[:])
    ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppSmallFontSize(), draw)
    if ProfileDewExchangeText(line[:]) {
        ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppSmallFontSize(), draw)
    }
    if dew_address[0] == cast(u8)0 {
        if profile_topup_failed {
            ProfileDewText(app, LocaleText("profile_dew_topup_error"), x, y, width, AppFontSize(), draw)
            if ProfileDewButton(app, LocaleText("retry_button"), x, y, width, dew_operation.active, draw) {
                profile_topup_started = false
                profile_topup_failed = false
            }
        } else {
            ProfileDewText(app, LocaleText("profile_dew_topup_loading"), x, y, width, AppFontSize(), draw)
        }
        return
    }
    // A minimum below one Dew's worth is noise, so only a real one is named.
    line = .{}
    if dew_minimum_atomic >= TopUpMinimumShown {
        minimum: [48]u8
        unused DewFormat(dew_minimum_atomic, 1000000000000LL, minimum[:])
        minimum_usd: [48]u8
        if DewUsdText(dew_minimum_atomic, minimum_usd[:]) {
            hint_arguments: [3]FormatArg = .[
            FormatArg.{.text = TextUntilNul(minimum[:]), .is_text = true},
            FormatArg.{.text = TextUntilNul(minimum_usd[:]), .is_text = true},
            FormatArg.{.number = cast(s32)dew_confirmations}]
            unused FormatTemplate(LocaleText("profile_dew_topup_hint_usd"), hint_arguments[:], line[:])
        } else {
            hint_arguments: [2]FormatArg = .[
            FormatArg.{.text = TextUntilNul(minimum[:]), .is_text = true},
            FormatArg.{.number = cast(s32)dew_confirmations}]
            unused FormatTemplate(LocaleText("profile_dew_topup_hint"), hint_arguments[:], line[:])
        }
    } else {
        send_arguments: [1]FormatArg = .[FormatArg.{.number = cast(s32)dew_confirmations}]
        unused FormatTemplate(LocaleText("profile_dew_topup_send"), send_arguments[:], line[:])
    }
    ProfileDewText(app, TextUntilNul(line[:]), x, y, width, AppSmallFontSize(), draw)
    side := width
    if side > AppScale(220) {
        side = AppScale(220)
    }
    uri: [144]u8
    unused AppCopyText("monero:", uri[:])
    unused AppAppendText(TextUntilNul(dew_address[:]), uri[:])
    if draw {
        unused DrawQrCode(app.ui.session, TextUntilNul(uri[:]),
            Rectangle.{cast(float32)(x + (width - side) / 2), cast(float32)y.*,
                cast(float32)side, cast(float32)side})
    }
    y.* += side + AppScale(12)
    // The address lines sit centered under the QR code, clear of the buttons.
    address: [160]u8
    ProfileTopUpAddressText(address[:])
    address_text := TextUntilNul(address[:])
    address_height := AppParagraphHeight(address_text, width, AppSmallFontSize(), 0)
    if draw {
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
                    cast(float32)width, cast(float32)address_height},
                .text = FrameTextHold(*app.ui.frame_text, address_text),
                .font = AppSmallFontSize(),
                .wrap = cast(TextWrap)TextWrapAuto,
                .align = cast(TextAlign)TextAlignCenter})
    }
    y.* += address_height + AppScale(16)
    half := (width - AppScale(8)) / 2
    row_y := y.*
    copy_y := row_y
    if ProfileDewButton(app, LocaleText(ifx profile_topup_copied then "address_copied" else "copy_address_button"),
        x, *copy_y, half, false, draw) {
        profile_topup_copied = TextInputWriteClipboard(TextUntilNul(dew_address[:]))
    }
    wallet_y := row_y
    if ProfileDewButton(app, LocaleText("open_wallet_button"), x + width - half, *wallet_y, half, false, draw) {
        unused OpenUri(TextUntilNul(uri[:]))
    }
    y.* = copy_y
    // Bitcoin, USDT and other coins go through dew.waozi.xyz, which hands
    // the payment to Trocador for this account's own address.
    if ProfileDewButton(app, LocaleText("dew_other_coin_button"), x, y, width, false, draw) {
        link: [160]u8
        unused AppCopyText("https://dew.waozi.xyz/?account=", link[:])
        unused AppAppendText(TextUntilNul(dew_identity[:]), link[:])
        unused OpenUri(TextUntilNul(link[:]))
    }
}

ProfileTopUpModalDraw :: (app: *InnerBreeze) {
    ProfileTopUpPump()
    DewRatesRefresh()
    width := app.ui.view_width - AppScale(32)
    if width > AppScale(480) {
        width = AppScale(480)
    }
    measured: s32 = 0
    ProfileTopUpContent(app, 0, *measured, width - AppScale(46), false)
    height := measured + AppScale(96)
    if height > app.ui.view_height - AppScale(48) {
        height = app.ui.view_height - AppScale(48)
    }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("profile/topup/modal"), .title = LocaleText("profile_dew_topup_title"),
            .width = width, .height = height, .scale = MetricsScale(),
            .title_at_start = true, .strong_title = true,
            .has_right_action = true, .right_label = LocaleText("close_button")})
    if frame.dismissed || frame.right_clicked || !DewReady() || !dew_account.known {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    content_w := cast(s32)frame.layout.content.width - AppScale(10)
    content_h: s32 = 0
    ProfileTopUpContent(app, 0, *content_h, content_w, false)
    scroll := Scroll(app.ui.session, ScrollProps.{
            .key = KeyHash("profile/topup/scroll"), .bounds = frame.layout.content,
            .content_height = content_h, .scroll_offset = profile_topup_scroll})
    profile_topup_scroll = scroll.scroll_offset
    if scroll.opened {
        y := cast(s32)scroll.content.y
        ProfileTopUpContent(app, cast(s32)scroll.content.x, *y, content_w, true)
        End(app.ui.session)
    }
    End(app.ui.session)
}
