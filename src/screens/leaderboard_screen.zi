app_social_refresh_loading :: () -> s32 #foreign c;
app_request_social_refresh :: (app: *InnerBreeze) #foreign c;

LEADERBOARD_ROW_LIMIT :: 64

LeaderboardEntry :: struct {
    user_id: [80]u8
    name: [96]u8
    streak: [48]u8
    average: [48]u8
    streak_value: float64
    average_value: float64
    own: bool
}

// An average received for one friend, matched to the streak rows by ID.
LeaderboardAverage :: struct {
    user_id: [80]u8
    label: [48]u8
    value: float64
}

leaderboard_entries: [LEADERBOARD_ROW_LIMIT]LeaderboardEntry;
leaderboard_averages: [LEADERBOARD_ROW_LIMIT]LeaderboardAverage;
leaderboard_count: s32;
leaderboard_signed_in: bool;
leaderboard_built_revision: s32 = -1;
leaderboard_built_practice: s32 = -1;
leaderboard_built_metric: s32 = -1;
leaderboard_app_names: [16][25]u8;
leaderboard_app_titles: [16][128]u8;
leaderboard_app_count: s32;
leaderboard_built_app: [25]u8;
leaderboard_built_board: [65]u8;
leaderboard_boards: [GAME_SCORES_MAX]s32;
leaderboard_board_count: s32;

#program_export
LeaderboardAppName :: (app: *InnerBreeze) -> string {
    name := AppTextFromCString(*app.leaderboard_app[0], 25)
    return ifx name == "" then "practices" else name
}

// Only apps with something to rank: Practice once a practice is installed,
// and installed apps whose games reported a score, such as Arcade.
LeaderboardListApps :: (app: *InnerBreeze, installed: LeaderboardMessage) {
    leaderboard_app_count = 0
    routes := LauncherRoutes()
    for route: routes {
        slot := AppNavNodeSlot(route)
        if !app_nav_route_available(app, route) ||
        (slot >= 0 && !NodeAppInstalled(slot)) {
            continue
        }
        name := LauncherRouteName(route)
        if name == "" || leaderboard_app_count >= 16 {
            continue
        }
        games: [GAME_SCORES_MAX]s32
        if name == "practices" {
            if installed.practice_count == 0 { continue }
        } else if GameScoresFor(name, games[:]) == 0 {
            continue
        }
        unused AppCopyText(name, leaderboard_app_names[leaderboard_app_count][:])
        unused AppCopyText(app_nav_route_label(route), leaderboard_app_titles[leaderboard_app_count][:])
        leaderboard_app_count += 1
    }
    selected := LeaderboardAppName(app)
    listed := false
    for index: cast(s32)0..leaderboard_app_count - 1 {
        listed = listed || TextUntilNul(leaderboard_app_names[index][:]) == selected
    }
    if !listed && leaderboard_app_count > 0 {
        unused AppCopyText(TextUntilNul(leaderboard_app_names[0][:]), app.leaderboard_app[:])
        app.leaderboard_loaded = 0
    }
    // The chosen app's games; one that no longer reports gives way to the first.
    leaderboard_board_count = 0
    if LeaderboardAppName(app) == "practices" {
        return
    }
    leaderboard_board_count = GameScoresFor(LeaderboardAppName(app), leaderboard_boards[:])
    game := AppTextFromCString(*app.leaderboard_game[0], 65)
    for index: cast(s32)0..leaderboard_board_count - 1 {
        if TextUntilNul(game_scores[leaderboard_boards[index]].game[:]) == game {
            return
        }
    }
    if leaderboard_board_count > 0 {
        unused AppCopyText(TextUntilNul(game_scores[leaderboard_boards[0]].game[:]), app.leaderboard_game[:])
        app.leaderboard_loaded = 0
    }
}

// The game board chosen in an installed app, or "" while Practice is shown.
#program_export
LeaderboardBoardName :: (app: *InnerBreeze) -> string {
    if LeaderboardAppName(app) == "practices" {
        return ""
    }
    return AppTextFromCString(*app.leaderboard_game[0], 65)
}

// Your own score on the chosen game's board, as the game last reported it.
LeaderboardGameValue :: (app: *InnerBreeze) -> float64 {
    for index: cast(s32)0..leaderboard_board_count - 1 {
        score := *game_scores[leaderboard_boards[index]]
        if TextUntilNul(score.game[:]) == LeaderboardBoardName(app) {
            return cast(float64)score.value
        }
    }
    return 0.0
}

LeaderboardGameLevel :: (app: *InnerBreeze) -> float64 {
    for index: cast(s32)0..leaderboard_board_count - 1 {
        score := *game_scores[leaderboard_boards[index]]
        if TextUntilNul(score.game[:]) == LeaderboardBoardName(app) { return cast(float64)score.level }
    }
    return 0.0
}

// The Wim Hof and meditation figures from this device's own records, which
// the node cannot read once sessions sync encrypted, and every game score,
// published with the next refresh. Only these numbers leave the device.
#program_export
LeaderboardStatsBody :: (app: *InnerBreeze) -> string {
    unused app
    GameScoresLoad()
    today := LeaderboardToday()
    out: Vec(u8)
    BuilderPrint(*out, "{\"app\":\"inbe\",\"metrics\":[")
    count: s32 = 0
    practices: [2]s32 = .[EXERCISE_WIM_HOF, EXERCISE_MEDITATION]
    for practice: practices {
        streak: s32
        average: s64
        if storage_profile_activity_stats(practice, today, *streak, *average) == 0 { continue }
        id := LeaderboardPracticeId(practice)
        BuilderPrint(*out, "%{\"practice\":\"%\",\"metric\":\"streak\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
            ifx count > 0 then "," else "", id, cast(s64)streak, cast(s64)streak, today)
        BuilderPrint(*out, ",{\"practice\":\"%\",\"metric\":\"%\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
            id, ifx practice == EXERCISE_MEDITATION then "avg_time" else "avg_hold", average, average, today)
        count += 2
    }
    for index: cast(s32)0..game_score_count - 1 {
        score := *game_scores[index]
        BuilderPrint(*out, "%{\"practice\":\"%\",\"metric\":\"%\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
            ifx count > 0 then "," else "", TextUntilNul(score.game[:]), TextUntilNul(score.metric[:]),
            score.value, score.value, today)
        count += 1
        if score.run {
            BuilderPrint(*out, ",{\"practice\":\"%\",\"metric\":\"level\",\"value\":%,\"label\":\"%\",\"local_date\":%}",
                TextUntilNul(score.game[:]), score.level, score.level, today)
            count += 1
        }
    }
    BuilderPrint(*out, "]}")
    if count == 0 {
        PackageFree(BuilderFinish(out))
        return ""
    }
    return BuilderFinish(out)
}

// Wim Hof ranks average holds and meditation average time as well.
LeaderboardHasAverage :: (practice: s32) -> bool {
    return practice == EXERCISE_WIM_HOF || practice == EXERCISE_MEDITATION
}

LeaderboardPracticeId :: (practice: s32) -> string {
    if practice == EXERCISE_MEDITATION { return "meditation" }
    if practice == EXERCISE_SUN_SALUTATION { return "sun_salutation" }
    if practice == EXERCISE_PATTERNS { return "patterns" }
    if practice == EXERCISE_TAI_CHI { return "tai_chi" }
    if practice == EXERCISE_ASTRAL_PROJECTION { return "astral_projection" }
    if practice == EXERCISE_WORKOUT { return "workout" }
    return "whm"
}

// The board ranks Wim Hof and meditation, the practices with averages,
// when they are installed, in Practice's order.
LeaderboardInstalledPractices :: () -> LeaderboardMessage {
    installed := LeaderboardMessage.{.practices_listed = true}
    for index: cast(s32)0..EXERCISE_COUNT - 1 {
        practice := practice_ordered_id(index)
        if LeaderboardHasAverage(practice) && PracticeInstalled(practice) && installed.practice_count < installed.practices.count {
            installed.practices[installed.practice_count] = practice
            installed.practice_count += 1
        }
    }
    return installed
}

// A practice that is no longer installed gives way to the first installed
// one; reports whether the board changed practice.
LeaderboardKeepInstalled :: (app: *InnerBreeze, installed: LeaderboardMessage) -> bool {
    if installed.practice_count == 0 {
        return false
    }
    for index: cast(s32)0..installed.practice_count - 1 {
        if installed.practices[index] == app.leaderboard_practice {
            return false
        }
    }
    app.leaderboard_practice = installed.practices[0]
    app.leaderboard_metric = LEADERBOARD_STREAK
    return true
}

// The social refresh stores each fetched board under the same key.
LeaderboardCacheKey :: (practice: s32, metric: s32, output: []u8) -> string {
    metric_id: string = "streak"
    if metric == LEADERBOARD_AVERAGE {
        metric_id = ifx practice == EXERCISE_MEDITATION then "avg_time" else "avg_hold"
    }
    if !AppCopyText("leaderboard.breathing.", output) ||
    !AppAppendText(LeaderboardPracticeId(practice), output) ||
    !AppAppendText(".", output) || !AppAppendText(metric_id, output) {
        return ""
    }
    return TextUntilNul(output)
}

LeaderboardLoadBoard :: (practice: s32, metric: s32, output: []u8) {
    key: [96]u8
    name := LeaderboardCacheKey(practice, metric, key[:])
    if name.count == 0 || storage_get_social_cache_json(name, *output[0],
        cast(s64)output.count) == 0 {
        unused AppCopyText("{\"rows\":[]}", output)
    }
}

LeaderboardLoadCache :: (app: *InnerBreeze) {
    if LeaderboardAppName(app) != "practices" {
        out: Vec(u8)
        BuilderPrint(*out, "leaderboard.games.%.%", LeaderboardBoardName(app), GameScoreMetric(LeaderboardBoardName(app), 0))
        key := BuilderFinish(out)
        defer { PackageFree(key) }
        if storage_get_social_cache_json(key, *app.leaderboard_json[0], 8192) == 0 {
            unused AppCopyText("{\"rows\":[]}", app.leaderboard_json[:])
        }
        if GameScoreRun(LeaderboardBoardName(app)) {
            second: Vec(u8)
            BuilderPrint(*second, "leaderboard.games.%.level", LeaderboardBoardName(app))
            second_key := BuilderFinish(second)
            if storage_get_social_cache_json(second_key, *app.leaderboard_avg_json[0], 8192) == 0 {
                unused AppCopyText("{\"rows\":[]}", app.leaderboard_avg_json[:])
            }
            PackageFree(second_key)
        } else {
            unused AppCopyText("{\"rows\":[]}", app.leaderboard_avg_json[:])
        }
        app.leaderboard_loaded = 1
        app.leaderboard_revision += 1
        return
    }
    LeaderboardLoadBoard(app.leaderboard_practice, LEADERBOARD_STREAK, app.leaderboard_json[:])
    LeaderboardLoadBoard(app.leaderboard_practice, LEADERBOARD_AVERAGE, app.leaderboard_avg_json[:])
    app.leaderboard_loaded = 1
    app.leaderboard_revision += 1
}

LeaderboardToday :: () -> s32 {
    local := LocalNow()
    if !local.valid { return 0 }
    return local.year * 10000 + local.month * 100 + local.day
}

LeaderboardFormatTime :: (seconds: s64, output: []u8) {
    if seconds < 0 { seconds = 0 }
    minutes := cast(s32)((seconds % 3600) / 60)
    digits: [3]u8 = .[cast(u8)(48 + minutes / 10), cast(u8)(48 + minutes % 10), cast(u8)0]
    if !AppFormatS64(seconds / 3600, output) || !AppAppendText(":", output) ||
    !AppAppendText(TextUntilNul(digits[:]), output) {
        output[0] = cast(u8)0
    }
}

// Counts and durations round half to even, as the server labels them.
LeaderboardFormatRounded :: (value: float64, output: []u8) {
    if value < -1000000000000000000.0 || value > 1000000000000000000.0 {
        output[0] = cast(u8)0
        return
    }
    rounded := cast(s64)value
    fraction := value - cast(float64)rounded
    if fraction > 0.5 || (fraction == 0.5 && rounded % 2 != 0) {
        rounded += 1
    } else if fraction < -0.5 || (fraction == -0.5 && rounded % 2 != 0) {
        rounded -= 1
    }
    if !AppFormatS64(rounded, output) {
        output[0] = cast(u8)0
    }
}

LeaderboardFormatAverage :: (practice: s32, value: float64, output: []u8) {
    if practice == EXERCISE_MEDITATION {
        LeaderboardFormatTime(cast(s64)(value + 0.5), output)
    } else {
        LeaderboardFormatRounded(value, output)
    }
}

// Your own row uses this device's sessions, which are newer than the server.
LeaderboardOwnValues :: (practice: s32, entry: *LeaderboardEntry) {
    streak: s32 = 0
    average: s64 = 0
    unused storage_profile_activity_stats(practice, LeaderboardToday(), *streak, *average)
    entry.streak_value = cast(float64)streak
    LeaderboardFormatRounded(entry.streak_value, entry.streak[:])
    entry.average_value = cast(float64)average
    LeaderboardFormatAverage(practice, entry.average_value, entry.average[:])
    entry.own = true
}

LeaderboardSeen :: (user_id: string) -> bool {
    for index: cast(s32)0..leaderboard_count - 1 {
        if TextUntilNul(leaderboard_entries[index].user_id[:]) == user_id {
            return true
        }
    }
    return false
}

LeaderboardText :: (json: string, object_at: s32, name: string, output: []u8) -> string {
    output[0] = cast(u8)0
    if ReadStringText(json, FieldAt(json, object_at, name), output) < 0 {
        output[0] = cast(u8)0
    }
    return TextUntilNul(output)
}

LeaderboardNumber :: (json: string, object_at: s32, name: string) -> float64 {
    number := ReadNumber(json, FieldAt(json, object_at, name))
    return ifx number.valid then number.value else 0.0
}

LeaderboardBefore :: (left: *LeaderboardEntry, right: *LeaderboardEntry, metric: s32) -> bool {
    first := ifx metric == LEADERBOARD_AVERAGE then left.average_value else left.streak_value
    other := ifx metric == LEADERBOARD_AVERAGE then right.average_value else right.streak_value
    if first != other { return first > other }
    first = ifx metric == LEADERBOARD_AVERAGE then left.streak_value else left.average_value
    other = ifx metric == LEADERBOARD_AVERAGE then right.streak_value else right.average_value
    if first != other { return first > other }
    return SocialCompareText(TextUntilNul(left.name[:]), TextUntilNul(right.name[:])) < 0
}

LeaderboardRebuild :: (app: *InnerBreeze) {
    practice := app.leaderboard_practice
    metric := app.leaderboard_metric
    if app.leaderboard_loaded == 0 {
        LeaderboardLoadCache(app)
    }
    if app.profile_friends_loaded == 0 {
        load_friends_cache(app)
    }
    practice_app := LeaderboardAppName(app) == "practices"
    run := !practice_app && GameScoreRun(LeaderboardBoardName(app))
    has_average := (practice_app && LeaderboardHasAverage(practice)) || run
    account: AccountKeys
    own_id: string = ""
    if sync_account_load(*account) != 0 && account.public_id[0] != cast(u8)0 {
        own_id = TextUntilNul(account.public_id[:])
    }
    leaderboard_signed_in = own_id.count > 0
    leaderboard_count = 0
    positions: [LEADERBOARD_ROW_LIMIT]s32

    averages: s32 = 0
    if has_average {
        json := TextUntilNul(app.leaderboard_avg_json[:])
        found := ArrayPositions(json, FieldAt(json, 0, "rows"), positions[:])
        for index: cast(s32)0..found - 1 {
            if index >= LEADERBOARD_ROW_LIMIT { break }
            average := *leaderboard_averages[averages]
            if LeaderboardText(json, positions[index], "user_id_hash", average.user_id[:]).count == 0 {
                continue
            }
            unused LeaderboardText(json, positions[index], "label", average.label[:])
            average.value = LeaderboardNumber(json, positions[index], "value")
            averages += 1
        }
    }

    json := TextUntilNul(app.leaderboard_json[:])
    found := ArrayPositions(json, FieldAt(json, 0, "rows"), positions[:])
    for index: cast(s32)0..found - 1 {
        if index >= LEADERBOARD_ROW_LIMIT || leaderboard_count >= LEADERBOARD_ROW_LIMIT { break }
        entry := *leaderboard_entries[leaderboard_count]
        entry.* = LeaderboardEntry.{}
        user_id := LeaderboardText(json, positions[index], "user_id_hash", entry.user_id[:])
        if user_id.count == 0 || LeaderboardSeen(user_id) {
            continue
        }
        alias: [48]u8
        display_name(*entry.name[0], cast(s64)entry.name.count,
            LeaderboardText(json, positions[index], "alias", alias[:]), user_id)
        entry.streak_value = LeaderboardNumber(json, positions[index], "value")
        LeaderboardFormatRounded(entry.streak_value, entry.streak[:])
        unused AppCopyText("—", entry.average[:])
        for item: cast(s32)0..averages - 1 {
            if TextUntilNul(leaderboard_averages[item].user_id[:]) == user_id {
                entry.average_value = leaderboard_averages[item].value
                label := TextUntilNul(leaderboard_averages[item].label[:])
                if run {
                    LeaderboardFormatRounded(entry.average_value, entry.average[:])
                } else if practice == EXERCISE_MEDITATION && label.count > 0 {
                    unused AppCopyText(label, entry.average[:])
                } else {
                    LeaderboardFormatAverage(practice, entry.average_value, entry.average[:])
                }
            }
        }
        if own_id.count > 0 && user_id == own_id {
            if practice_app {
                LeaderboardOwnValues(practice, entry)
            } else {
                entry.own = true
                entry.streak_value = LeaderboardGameValue(app)
                LeaderboardFormatRounded(entry.streak_value, entry.streak[:])
                if run {
                    entry.average_value = LeaderboardGameLevel(app)
                    LeaderboardFormatRounded(entry.average_value, entry.average[:])
                }
            }
        }
        leaderboard_count += 1
    }

    // Friends without a result yet still appear, at zero.
    friends := TextUntilNul(app.profile_friends_json[:])
    found = ArrayPositions(friends, FieldAt(friends, 0, "friends"), positions[:])
    for index: cast(s32)0..found - 1 {
        if index >= LEADERBOARD_ROW_LIMIT || leaderboard_count >= LEADERBOARD_ROW_LIMIT { break }
        entry := *leaderboard_entries[leaderboard_count]
        entry.* = LeaderboardEntry.{}
        // Older servers name the friend's ID "id".
        field := ifx FieldAt(friends, positions[index], "user_id_hash") >= 0 then "user_id_hash" else "id"
        user_id := LeaderboardText(friends, positions[index], field, entry.user_id[:])
        if user_id.count == 0 || LeaderboardSeen(user_id) {
            continue
        }
        alias: [48]u8
        display_name(*entry.name[0], cast(s64)entry.name.count,
            LeaderboardText(friends, positions[index], "alias", alias[:]), user_id)
        LeaderboardFormatRounded(0.0, entry.streak[:])
        if run { LeaderboardFormatRounded(0.0, entry.average[:]) }
        else { LeaderboardFormatAverage(practice, 0.0, entry.average[:]) }
        leaderboard_count += 1
    }

    if own_id.count > 0 && !LeaderboardSeen(own_id) && leaderboard_count < LEADERBOARD_ROW_LIMIT {
        entry := *leaderboard_entries[leaderboard_count]
        entry.* = LeaderboardEntry.{}
        unused AppCopyText(own_id, entry.user_id[:])
        display_name(*entry.name[0], cast(s64)entry.name.count,
            storage_get_setting_text("sync_account_alias"), own_id)
        if practice_app {
            LeaderboardOwnValues(practice, entry)
        } else {
            entry.own = true
            entry.streak_value = LeaderboardGameValue(app)
            LeaderboardFormatRounded(entry.streak_value, entry.streak[:])
            if run {
                entry.average_value = LeaderboardGameLevel(app)
                LeaderboardFormatRounded(entry.average_value, entry.average[:])
            }
        }
        leaderboard_count += 1
    }

    // At most 64 rows: keep equal rows in their received order.
    for index: cast(s32)1..leaderboard_count - 1 {
        current := leaderboard_entries[index]
        at := index
        while at > 0 && LeaderboardBefore(*current, *leaderboard_entries[at - 1], metric) {
            leaderboard_entries[at] = leaderboard_entries[at - 1]
            at -= 1
        }
        leaderboard_entries[at] = current
    }
    leaderboard_built_revision = app.leaderboard_revision
    leaderboard_built_practice = practice
    leaderboard_built_metric = metric
    unused AppCopyText(LeaderboardAppName(app), leaderboard_built_app[:])
    unused AppCopyText(LeaderboardBoardName(app), leaderboard_built_board[:])
}

// The old route remains a redirect for saved navigation and older packages.
// Profile owns the screen; Inner Breeze supplies its installed boards/data.
leaderboard_projection: string;
EntityHostOpenLeaderboard :: () #foreign c;

InbeLeaderboardSnapshot :: (app: *InnerBreeze, request: string) -> string {
    page: ProfileLeaderboard
    account: AccountKeys
    if sync_account_load(*account) != 0 {
        unused AppCopyText(TextUntilNul(account.public_id[:]), page.owner[:])
    }
    if page.owner[0] == cast(u8)0 {
        unused AppCopyText("local", page.owner[:])
    }
    installed := LeaderboardInstalledPractices()
    LeaderboardListApps(app, installed)
    for index: cast(s32)0..leaderboard_app_count - 1 {
        name := TextUntilNul(leaderboard_app_names[index][:])
        title := TextUntilNul(leaderboard_app_titles[index][:])
        if name == "practices" {
            for item: cast(s32)0..installed.practice_count - 1 {
                if page.board_count >= LEADERBOARD_BOARDS { break }
                practice := installed.practices[item]
                board := *page.boards[page.board_count]
                unused AppCopyText(name, board.app[:])
                unused AppCopyText(title, board.app_title[:])
                unused AppCopyText(LeaderboardPracticeId(practice), board.id[:])
                key := ifx practice == EXERCISE_MEDITATION then "exercise_meditation" else "exercise_wim_hof"
                unused AppCopyText(LocaleText(key), board.title[:])
                unused AppCopyText(LocaleText("profile_metric_streak"), board.primary[:])
                unused AppCopyText(LocaleText(ifx practice == EXERCISE_MEDITATION then "profile_metric_avg_time" else "profile_metric_avg_hold"), board.average[:])
                page.board_count += 1
            }
        } else {
            games: [GAME_SCORES_MAX]s32
            count := GameScoresFor(name, games[:])
            for item: cast(s32)0..count - 1 {
                score := *game_scores[games[item]]
                game := TextUntilNul(score.game[:])
                if page.board_count >= LEADERBOARD_BOARDS || !NodeAppInstalledIdentity(name, game) { continue }
                board := *page.boards[page.board_count]
                unused AppCopyText(name, board.app[:])
                unused AppCopyText(title, board.app_title[:])
                unused AppCopyText(game, board.id[:])
                unused AppCopyText(TextUntilNul(score.title[:]), board.title[:])
                unused AppCopyText(LocaleText(ifx score.run then "leaderboard_score" else "leaderboard_levels"), board.primary[:])
                if score.run { unused AppCopyText(LocaleText("leaderboard_level"), board.average[:]) }
                page.board_count += 1
            }
        }
    }
    current := ifx LeaderboardAppName(app) == "practices" then LeaderboardPracticeId(app.leaderboard_practice) else LeaderboardBoardName(app)
    page.selected = ProfileBoardFind(*page, current)
    if page.selected < 0 && page.board_count > 0 { page.selected = 0 }
    owner: [97]u8
    board_id: [65]u8
    metric := ReadNumber(request, FieldAt(request, 0, "metric"))
    if ReadStringText(request, FieldAt(request, 0, "owner"), owner[:]) > 0 &&
    TextUntilNul(owner[:]) == TextUntilNul(page.owner[:]) &&
    ReadStringText(request, FieldAt(request, 0, "board"), board_id[:]) > 0 &&
    metric.valid && (metric.value == 0 || metric.value == 1) {
        chosen := ProfileBoardFind(*page, TextUntilNul(board_id[:]))
        if chosen >= 0 {
            page.selected = chosen
            app.leaderboard_metric = ifx page.boards[chosen].average[0] != cast(u8)0 then cast(s32)metric.value else 0
        }
    }
    if page.selected >= 0 {
        board := *page.boards[page.selected]
        chosen := TextUntilNul(board.id[:])
        changed := chosen != current
        if board.average[0] == cast(u8)0 {
            app.leaderboard_metric = LEADERBOARD_STREAK
        }
        unused AppCopyText(TextUntilNul(board.app[:]), app.leaderboard_app[:])
        if TextUntilNul(board.app[:]) == "practices" {
            for item: cast(s32)0..installed.practice_count - 1 {
                practice := installed.practices[item]
                if LeaderboardPracticeId(practice) == chosen { app.leaderboard_practice = practice }
            }
        } else {
            unused AppCopyText(chosen, app.leaderboard_game[:])
        }
        // Refresh only the selected, currently installed board.
        LeaderboardListApps(app, installed)
        if changed || request == "refresh" {
            if changed { app.leaderboard_metric = LEADERBOARD_STREAK }
            LeaderboardLoadCache(app)
            app_request_social_refresh(app)
        }
        if app.leaderboard_loaded == 0 || leaderboard_built_revision != app.leaderboard_revision ||
        leaderboard_built_practice != app.leaderboard_practice || leaderboard_built_metric != app.leaderboard_metric ||
        TextUntilNul(leaderboard_built_app[:]) != LeaderboardAppName(app) ||
        TextUntilNul(leaderboard_built_board[:]) != LeaderboardBoardName(app) {
            LeaderboardRebuild(app)
        }
        page.metric = app.leaderboard_metric
        page.loading = app_social_refresh_loading() != 0
        page.row_count = leaderboard_count
        for index: cast(s32)0..leaderboard_count - 1 {
            source := *leaderboard_entries[index]
            row := *page.rows[index]
            unused AppCopyText(TextUntilNul(source.name[:]), row.name[:])
            unused AppCopyText(TextUntilNul(source.streak[:]), row.value[:])
            unused AppCopyText(TextUntilNul(source.average[:]), row.average[:])
            row.own = source.own
            if row.own && TextUntilNul(board.app[:]) == "practices" {
                AchievementLeaderboardViewed(chosen)
            }
        }
    }
    EntityProfile.EntityFree(leaderboard_projection)
    leaderboard_projection = ProfileLeaderboardEncode(*page)
    return leaderboard_projection
}

#program_export
leaderboard_screen_enter :: (app: *InnerBreeze) {
    if app == null { return }
    app_open_profile_tab(app, PROFILE_TAB_OVERVIEW)
    EntityHostOpenLeaderboard()
}

#program_export
leaderboard_screen_draw :: (app: *InnerBreeze) {
    if app == null { return }
    app_open_profile_tab(app, PROFILE_TAB_OVERVIEW)
    EntityHostOpenLeaderboard()
}
