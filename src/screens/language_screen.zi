#import "button_props"
#import "button_widget"
#import "control_props"
#import "dropdown"
#import "dropdown_props"
#import "geometry"
#import "image_props"
#import "layout"
#import "semantic"
#import "session"
#import "text_align"
#import "text_props"
#import "text_widget"
#import, file "../core/types.zi";
#import, file "../app/app_types.zi";
#import, file "../app/app_route_state.zi";
#import, file "../app/app_settings.zi";
#import, file "../app/locale.zi";
#import, file "../app/locale_dropdown.zi";
#import, file "../app/language_selection.zi";
#import, file "../app/metrics.zi";
#import, file "../app/route_types.zi";
#import "drawing_props"

using AppMainTab;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

#program_export
language_screen_draw :: (app: *InnerBreeze) {
    if app == null || app.ui.view_width <= 0 || app.ui.view_height <= 0 {
        return
    }

    view_width := app.ui.view_width
    view_height := app.ui.view_height
    column := CenteredColumnFor(view_width, AppScale(340), AppScale(16))
    dropdown_h := AppScale(36)
    dropdown_y := view_height / 2 - dropdown_h / 2
    selected_index := app.language_index
    language_count := LocaleLanguageCount()
    if language_count <= 0 { language_count = 1 }
    if selected_index < 0 || selected_index >= language_count {
        selected_index = 0
    }

    locale_menu: DropdownProps
    locale_menu.id = 260
    locale_menu.bounds = Rectangle.{cast(float32)column.x,
        cast(float32)dropdown_y, cast(float32)column.width,
        cast(float32)dropdown_h
    }
    locale_menu.selected_index = selected_index
    locale_menu.open = app.ui.locale_first_run_menu.open
    locale_menu.highlight_index = app.ui.locale_first_run_menu.highlight_index
    locale_menu.scroll_offset = app.ui.locale_first_run_menu.scroll_offset
    locale_menu.placeholder = LocaleText("language_label")
    app.ui.locale_first_run_menu = LocaleDropdown(app.ui.session, locale_menu)
    app.language_index = app.ui.locale_first_run_menu.selected_index
    if app.ui.locale_first_run_menu.changed {
        apply_language_selection(app, app.language_index, 0)
        // Preview the chosen language without completing setup before Next.
        app.language_selected = 0
        app.settings_dirty = 1
        app.settings_save_delay_ticks = 18
    }

    title := LocaleText("language_picker_title")
    title_font := AppTitleFontSize(title, column.width)
    title_w := AppTextWidth(title, title_font)
    title_text: TextProps
    title_text.text = title
    title_text.font = title_font
    title_text.wrap = cast(TextWrap)TextWrapNone
    title_text.bounds = Rectangle.{cast(float32)((view_width - title_w) / 2),
        cast(float32)AppScale(28), cast(float32)title_w,
        cast(float32)AppTextLineHeight(title_font)
    }
    Text(app.ui.session, title_text)

    label_text: TextProps
    label_text.text = LocaleText("language_label")
    label_text.font = AppFontSize()
    label_text.wrap = cast(TextWrap)TextWrapNone
    label_text.bounds = Rectangle.{cast(float32)column.x,
        cast(float32)(dropdown_y - AppScale(24)),
        cast(float32)column.width,
        cast(float32)AppTextLineHeight(label_text.font)
    }
    Text(app.ui.session, label_text)

    next_label := LocaleText("next_button")
    button_w := AppTextWidth(next_label, AppFontSize()) + AppScale(16)
    if button_w < AppScale(34) { button_w = AppScale(34) }
    button_h := AppTextLineHeight(AppFontSize()) + AppScale(8)
    if button_h < AppScale(34) { button_h = AppScale(34) }
    button: ButtonProps
    button.id = 261
    button.label = next_label
    button.bounds = Rectangle.{cast(float32)((view_width - button_w) / 2),
        cast(float32)(dropdown_y + AppScale(64)),
        cast(float32)button_w, cast(float32)button_h
    }
    button.tone = cast(ButtonTone)ButtonToneNeutral
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    if Button(app.ui.session, button) != 0 {
        app_accept_language_selection(app)
        save_settings(app)
        app_switch_screen(app, ScreenAppSelection)
    }
}

#program_export
language :: (app: *InnerBreeze) {
    language_screen_draw(app)
}
