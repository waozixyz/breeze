PracticeScreenConstants :: enum {
    PRACTICE_CATEGORY_TAB_H :: 40
    PRACTICE_CATEGORY_TOAST_TICKS :: 120
    PRACTICE_CONFIG_TAB_LIST :: -1
}

PracticeLeaveConfigFn :: #type (app: *InnerBreeze) -> ();

practice_activity_count_for_tab :: (tab: s32) -> s32 {
    unused tab
    return practice_count()
}

practice_activity_for_tab :: (tab: s32, index: s32) -> s32 {
    unused tab
    if index < 0 {
        return EXERCISE_WIM_HOF
    }
    if index >= practice_count() {
        return practice_ordered_id(practice_count() - 1)
    }
    return practice_ordered_id(index)
}


empty_options_storage: [1] DropdownOption;
empty_toolbar_actions_storage: [1] ToolbarAction;

empty_title_options :: () -> []DropdownOption {
    return empty_options_storage[:0]
}

no_toolbar_actions :: () -> []ToolbarAction {
    return empty_toolbar_actions_storage[:0]
}

#program_export
practice_screen_subscreen_integrated :: (app: *InnerBreeze, modal_type: s32) -> s32 {
    return cast(s32)(app != null && app.breathing.screen == ScreenStart && cast(s32)app.modal.type != modal_type)
}

#program_export
practice_screen_config_layout :: (app: *InnerBreeze, modal_type: s32, content_top_gap: s32, layout: *PracticeSubscreenLayout) {
    integrated := practice_screen_subscreen_integrated(app, modal_type)
    title_h: s32 = ifx (integrated != 0) then (app_content_top_reserved(app)) else (AppTitleBarHeight())
    scroll_y: s32 = title_h + content_top_gap
    bottom_reserved: s32 = ifx (integrated != 0) then (app_content_bottom_reserved(app)) else (0)
    view_h: s32 = 560
    if app != null {
        view_h = app.ui.view_height
    }
    scroll_h: s32 = view_h - scroll_y - bottom_reserved - (ifx (integrated != 0) then (AppScale(8)) else (0))

    if layout == null {
        return
    }
    if scroll_h < 0 {
        scroll_h = 0
    }
    layout.integrated = integrated
    layout.title_h = title_h
    layout.scroll_y = scroll_y
    layout.scroll_h = scroll_h
}

#program_export
practice_screen_handle_config_title :: (app: *InnerBreeze, title: string, modal_type: s32, has_leave_config: s32) -> s32 {
    title_h: s32 = 0

    if app == null {
        return 0
    }
    title_h = ifx (practice_screen_subscreen_integrated(app, modal_type) != 0) then (app_content_top_reserved(app)) else (AppTitleBarHeight())
    title_result := TitleBar(CurrentApp().ui.session, TitleBarProps.{.title = title, .height = title_h}, empty_title_options())
    if title_result.node < 0 {
        return 0
    }
    if app.modal.active != 0 && cast(s32)app.modal.type == modal_type {
        app_close_modal(app)
    } else {
        if app.settings_dirty != 0 {
            save_settings(app)
        }
        active := practice_active(app)
        if active != null && active.leave_config != null {
            active.leave_config(app)
        }
        unused has_leave_config
        app.settings_scroll = 0
        app.practice_tab = PRACTICE_TAB_PLAY
        app_switch_screen(app, ScreenStart)
    }
    return 1
}

practice_card_banner_asset_path :: (app: *InnerBreeze, exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    dark: bool = app != null && ((app.theme_mode == APP_THEME_DARK)  || (app.theme_mode != APP_THEME_LIGHT && app.dark_mode != 0))

    if id == EXERCISE_WIM_HOF {
        return ifx (dark) then ("assets/practices/whm/banner-dark.png") else ("assets/practices/whm/banner-light.png")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return ifx (dark) then ("assets/practices/sunsalutation/banner-dark.png") else ("assets/practices/sunsalutation/banner-light.png")
    }
    if id == EXERCISE_MEDITATION {
        return ifx (dark) then ("assets/practices/meditation/banner-dark.png") else ("assets/practices/meditation/banner-light.png")
    }
    if id == EXERCISE_PATTERNS {
        return ifx (dark) then ("assets/practices/patterns/banner-dark.png") else ("assets/practices/patterns/banner-light.png")
    }
    return ""
}

sun_salutation_default_repetitions :: () -> s32 {
    return 6
}

practice_banner_probe_count: s32;

practice_draw_card_banner :: (asset_path: string, dest: Rectangle) {
    if asset_path.count == 0 || asset_path[0] == #char "\0" || dest.width <= 0 || dest.height <= 0 {
        return
    }
    first_banner := practice_banner_probe_count == 0
    practice_banner_probe_count += 1
    if first_banner {
        TraceLog(3, "APP PROBE: before banner Image")
    }
    Image(CurrentApp().ui.session, ImageProps.{
            .asset_path = asset_path,
            .bounds = dest,
            .fit = cast(ImageFit)ImageFitCover
        })
    if first_banner {
        TraceLog(3, "APP PROBE: after banner Image")
    }
}

practice_next_ordered :: (app: *InnerBreeze, dir: s32) -> s32 {
    if app == null {
        return EXERCISE_WIM_HOF
    }
    current := practice_clamp_id(app.exercise_type)
    current_order := practice_ordered_index(app, current)
    total := practice_count()

    if total <= 0 {
        return current
    }
    next_index := (current_order + dir + total * 2) % total
    return practice_ordered_id(next_index)
}

practice_home_count :: (app: *InnerBreeze) -> s32 {
    unused app
    return practice_count()
}

practice_ordered_index :: (app: *InnerBreeze, exercise: s32) -> s32 {
    unused app
    {
        i: s32 = 0
        while i < practice_count() {
            id := practice_ordered_id(i)
            if id == exercise {
                return i
            }
            i += 1
        }

    }
    return 0
}

practice_home_carousel_controls_height :: (app: *InnerBreeze) -> s32 {
    return ifx (practice_home_count(app) > 1) then (AppScale(48)) else (0)
}

practice_select_home_card :: (app: *InnerBreeze, exercise: s32) {
    route := AppRoute.{0 }

    if app == null {
        return
    }
    if app.practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    route = app_current_route(app)
    route.screen = ScreenStart
    route.exercise_type = practice_clamp_id(exercise)
    route.practice_tab = PRACTICE_TAB_PLAY
    route.practice_config_tab = 0
    app.manual_scroll = 0
    app.settings_scroll = 0
    app.practice_home_scroll = 0
    app.tutorial_step = 0
    app_switch_route(app, route)
}

practice_home_action_gap :: (content_w: s32) -> s32 {
    return ifx (content_w < AppScale(340)) then (AppScale(8)) else (AppScale(12))
}

practice_home_title :: (exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    if id == EXERCISE_WIM_HOF {
        return LocaleText("practice_home_title_wim_hof")
    }
    if id == EXERCISE_MEDITATION {
        return LocaleText("practice_home_title_meditation")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return LocaleText("practice_home_title_sun_salutation")
    }
    if id == EXERCISE_PATTERNS {
        return LocaleText("practice_home_title_patterns")
    }
    return practice_label(id)
}

practice_home_subtitle :: (exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    if id == EXERCISE_WIM_HOF {
        return LocaleText("practice_home_subtitle_wim_hof")
    }
    if id == EXERCISE_MEDITATION {
        return LocaleText("practice_home_subtitle_meditation")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return LocaleText("practice_home_subtitle_sun_salutation")
    }
    if id == EXERCISE_PATTERNS {
        return LocaleText("practice_home_subtitle_patterns")
    }
    return ""
}

practice_home_meditation_minutes :: (app: *InnerBreeze) -> s32 {
    mode := ifx (app != null) then (app.meditation.duration_mode) else (1)

    if mode == 0 {
        return 5
    }
    if mode == 1 {
        return 15
    }
    if mode == 2 {
        return 30
    }
    if mode == 3 {
        return 60
    }
    if mode == 4 {
        return 120
    }
    return ifx (app != null) then (clampi(app.meditation.custom_minutes, 1, 240)) else (15)
}

practice_home_metadata :: (app: *InnerBreeze, out: *u8, out_size: s64) {
    if out == null || out_size == 0 {
        return
    }
    out[0] = cast(u8)0
    if app == null {
        return
    }
    id := practice_clamp_id(app.exercise_type)
    if id == EXERCISE_MEDITATION {
        FormatLocaleCount(out, out_size, "practice_home_minutes", practice_home_meditation_minutes(app))
    } else if id == EXERCISE_SUN_SALUTATION {
        FormatLocaleCount(out, out_size, "practice_home_repetitions", sun_salutation_default_repetitions())
    } else if id == EXERCISE_PATTERNS {
        ratio: [24] u8
        patterns_ratio_text(app, *ratio[0], size_of(type_of(ratio)))
        if app.patterns.duration_minutes > 0 {
            FormatLocaleCount(out, out_size, "practice_home_patterns_metadata", app.patterns.duration_minutes)
        } else {
            unused AppCopyText(AppTextFromCString(*ratio[0], 24),
                BytesFromPointer(out, cast(u64)out_size))
        }
    } else {
        FormatLocaleCount(out, out_size, "practice_home_wim_hof_metadata",
            app.breathing.max_rounds)
    }
}

practice_draw_title_crescent :: (center_x: s32, y: s32, w: s32,
    color: Color) {
    segments: s32 = 28
    half := cast(float32)w * 0.5f
    start := Vector2.{cast(float32)center_x - half, cast(float32)y - cast(float32)AppScale(3) }
    control := Vector2.{cast(float32)center_x, cast(float32)y + cast(float32)AppScale(26) }
    end := Vector2.{cast(float32)center_x + half, cast(float32)y - cast(float32)AppScale(4) }

    {
        layer: s32 = 0
        while layer < 3 {
            {
                i: s32 = 0
                while i < segments {

                    t0 := cast(float32)i / cast(float32)segments
                    t1 := cast(float32)(i + 1) / cast(float32)segments
                    u0 := 1.0f - t0
                    u1 := 1.0f - t1
                    p0 := Vector2.{
                        u0 * u0 * start.x + 2.0f * u0 * t0 * control.x + t0 * t0 * end.x,
                        u0 * u0 * start.y + 2.0f * u0 * t0 * control.y + t0 * t0 * end.y
                    }
                    p1 := Vector2.{
                        u1 * u1 * start.x + 2.0f * u1 * t1 * control.x + t1 * t1 * end.x,
                        u1 * u1 * start.y + 2.0f * u1 * t1 * control.y + t1 * t1 * end.y
                    }
                    mid := (t0 + t1) * 0.5f
                    edge := ifx (mid < 0.5f) then (mid * 2.0f) else ((1.0f - mid) * 2.0f)
                    if edge < 0.0f {
                        edge = 0.0f
                    }
                    if edge > 1.0f {
                        edge = 1.0f
                    }
                    thickness := cast(float32)AppScale(2)
                    alpha: float32 = 0.58f
                    draw_color := color
                    if layer == 0 {
                        thickness = cast(float32)AppScale(15)
                        alpha = 0.08f
                    } else if layer == 1 {
                        thickness = cast(float32)AppScale(7)
                        alpha = 0.20f
                    }
                    if layer == 2 {
                        draw_color = Color.{.r = 250, .g = 225, .b = 255, .a = 255}
                    }
                    DrawLineEx(p0, p1, thickness * (0.35f + edge * 0.65f),
                        Fade(draw_color, alpha * edge))
                    i += 1
                }
            }

            layer += 1
        }
    }
}

practice_draw_hero_title_text :: (title: string, subtitle: string,
    x: s32, y: s32, w: s32,
    preferred_title_font: s32) {
    if title.count == 0 {
        return
    }

    title_font := preferred_title_font
    title_w: s32 = 0
    subtitle_font := AppFontSize() + AppScale(1)
    subtitle_w: s32 = 0
    title_x: s32 = 0
    title_y: s32 = 0
    subtitle_x: s32 = 0
    subtitle_y: s32 = 0
    underline_w: s32 = 0
    underline_y: s32 = 0
    center_x := x + w / 2
    glow := Color.{.r = 193, .g = 146, .b = 255, .a = 255}
    max_text_w := w - AppScale(36)
    if max_text_w < AppScale(220) {
        max_text_w = w
    }

    while title_font > AppFontSize() + AppScale(4)  && AppTextWidth(title, title_font) > max_text_w {
        title_font -= 1
    }
    title_w = AppTextWidth(title, title_font)
    title_x = x + (w - title_w) / 2
    title_y = y


    Text(CurrentApp().ui.session, TextProps.{
            .text = title,
            .bounds = Rectangle.{cast(float32)(title_x), cast(float32)(title_y), 0, 0},
            .font = title_font,
            .class_name = 0,
            .wrap = cast(TextWrap)TextWrapNone
        })


    if subtitle.count > 0 {
        while subtitle_font > AppScale(Text14)  && AppTextWidth(subtitle, subtitle_font) > max_text_w {
            subtitle_font -= 1
        }
        subtitle_w = AppTextWidth(subtitle, subtitle_font)
        subtitle_x = x + (w - subtitle_w) / 2
        subtitle_y = title_y + title_font + AppScale(14)

        Text(CurrentApp().ui.session, TextProps.{
                .text = subtitle,
                .bounds = Rectangle.{cast(float32)(subtitle_x), cast(float32)(subtitle_y), 0, 0},
                .font = subtitle_font,
                .class_name = 0,
                .wrap = cast(TextWrap)TextWrapNone
            })
    }

    underline_w = title_w * 64 / 100
    if underline_w < AppScale(170) {
        underline_w = AppScale(170)
    }
    if underline_w > AppScale(340) {
        underline_w = AppScale(340)
    }
    underline_y = title_y + title_font + AppScale(50)
    if subtitle.count == 0 {
        underline_y = title_y + title_font + AppScale(22)
    }
    practice_draw_title_crescent(center_x, underline_y, underline_w, glow)
}

practice_home_action_row_widths :: (content_w: s32, manual_w: *s32, config_w: *s32) -> s32 {
    font := AppFontSize()
    pad := AppScale(20)
    gap := practice_home_action_gap(content_w)
    manual_min: s32 = AppTextWidth(LocaleText("practice_manual_button"), font) + pad * 2
    config_min: s32 = AppTextWidth(LocaleText("practice_configure_button"), font) + pad * 2
    half_w: s32 = 0
    available_w: s32 = 0

    if content_w < manual_min + config_min + gap {
        return 0
    }
    available_w = content_w - gap
    half_w = available_w / 2
    if half_w >= manual_min && available_w - half_w >= config_min {
        manual_w.* = half_w
        config_w.* = available_w - half_w
        return 1
    }
    manual_w.* = manual_min
    config_w.* = available_w - manual_w.*
    if config_w.* < config_min {
        config_w.* = config_min
        manual_w.* = available_w - config_w.*
    }
    return ifx (manual_w.* >= manual_min && config_w.* >= config_min) then (1) else (0)
}

practice_home_actions_share_row :: (practice: *PracticeDefinition, content_w: s32) -> s32 {
    manual_w: s32 = 0
    config_w: s32 = 0
    return ifx (practice != null && practice.draw_manual != null && practice.draw_config != null && practice_home_action_row_widths(content_w, *manual_w, *config_w) != 0) then (1) else (0)
}

practice_draw_home_title :: (app: *InnerBreeze, x: s32, y: s32, w: s32) {
    if app == null {
        return
    }

    practice_draw_hero_title_text(practice_home_title(app.exercise_type),
        practice_home_subtitle(app.exercise_type),
        x, y, w, ifx (w >= AppScale(600)) then (AppScale(42)) else (AppScale(34)))
}

practice_screen_draw_home_hero :: (app: *InnerBreeze) -> s32 {
    if app == null {
        return 0
    }

    practice := practice_get(app.exercise_type)
    bottom_reserved := app_content_bottom_reserved(app)
    left_reserved := app_content_left_reserved(app)
    content_view_x := left_reserved
    content_view_w := app.ui.view_width - left_reserved
    if content_view_w < AppScale(320) {
        content_view_x = 0
        content_view_w = app.ui.view_width
    }
    content_w := content_view_w - AppScale(80)
    if content_w > AppScale(940) {
        content_w = AppScale(940)
    }
    if content_w < AppScale(520) {
        content_w = content_view_w - AppScale(32)
    }
    x := content_view_x + (content_view_w - content_w) / 2
    hero_h := app.ui.view_height - bottom_reserved
    if hero_h <= 0 {
        return 0
    }
    hero := Rectangle.{cast(float32)content_view_x, 0, cast(float32)content_view_w, cast(float32)app.ui.view_height }
    button_h := AppScale(48)
    action_gap := AppScale(14)
    total_w := content_w
    if total_w > AppScale(700) {
        total_w = AppScale(700)
    }
    if total_w > content_view_w - AppScale(32) {
        total_w = content_view_w - AppScale(32)
    }
    if total_w < AppScale(360) {
        total_w = content_view_w - AppScale(24)
    }
    secondary_count: s32 = 0
    if practice != null && practice.draw_manual != null {
        secondary_count += 1
    }
    if practice != null && practice.draw_config != null {
        secondary_count += 1
    }
    button_count := 1 + secondary_count
    wide_actions: s32 = ifx (total_w >= AppScale(600)) then (1) else (0)
    secondary_row: s32 = ifx (secondary_count < 2 || practice_home_actions_share_row(practice, total_w) != 0) then (1) else (0)
    rows := ifx (wide_actions != 0) then (1) else (1 + (ifx (secondary_row != 0) then ((ifx (secondary_count > 0) then (1) else (0))) else (secondary_count)))
    bottom_gap: s32 = ifx (bottom_reserved > 0) then (AppScale(28)) else (AppScale(20))
    button_y := hero_h - bottom_gap - rows * button_h - (rows - 1) * action_gap
    pager_h := practice_home_carousel_controls_height(app)
    pager_y := button_y - AppScale(10) - pager_h
    title_y := pager_y - AppScale(100)
    if title_y < AppScale(8) {
        title_y = AppScale(8)
    }
    primary_w: s32 = ifx (wide_actions != 0) then ((total_w - action_gap * (button_count - 1)) / button_count) else (total_w)
    secondary_w: s32 = ifx (wide_actions != 0) then (primary_w) else ((ifx (secondary_row != 0 && secondary_count > 0) then ((total_w - action_gap * (secondary_count - 1)) / secondary_count) else (total_w)))
    action_x := content_view_x + (content_view_w - total_w) / 2
    pager_w := ifx (total_w < AppScale(480)) then (total_w) else (AppScale(480))
    pager_x := content_view_x + (content_view_w - pager_w) / 2

    app.practice_home_bounds_valid = 1
    app.practice_home_bounds_card = hero
    app.practice_home_bounds_start = Rectangle.{0 }
    app.practice_home_bounds_manual = Rectangle.{0 }
    app.practice_home_bounds_config = Rectangle.{0 }

    swipe_spec := SwipeSpec.{
        .bounds = hero,
        .directions = 3,
        .min_distance = cast(float32)AppScale(48),
        .axis_bias = 1.4f,
        .max_duration = 1.2f
    }
    swipe := Swipe(swipe_spec, app.practice_home_swipe,
        app.ui.manual_swipe_frame)
    app.practice_home_swipe = swipe.gesture
    if swipe.claim_pointer { app.ui.manual_swipe_owner = true }
    if swipe.release_pointer { app.ui.manual_swipe_owner = false }
    if swipe.capture_input || swipe.consume_release {
        app_block_current_click(app)
    }
    if app.modal.active == 0 && (swipe.direction == cast(SwipeDirection)SwipeLeft || IsKeyPressed(KEY_RIGHT)) {
        practice_select_home_card(app, practice_next_ordered(app, 1))
    } else if app.modal.active == 0 && (swipe.direction == cast(SwipeDirection)SwipeRight || IsKeyPressed(KEY_LEFT)) {
        practice_select_home_card(app, practice_next_ordered(app, -1))
    }

    banner_path := practice_card_banner_asset_path(app, app.exercise_type)
    if banner_path.count > 0 {
        practice_draw_card_banner(banner_path, Rectangle.{hero.x, hero.y, hero.width, cast(float32)(title_y + AppScale(8))})
    } else {
        DrawRectangleRec(hero, StyleTokenColor("surface"))
    }

    if practice_banner_probe_count == 1 {
        TraceLog(3, "APP PROBE: banner block complete")
    }

    // The banner Image is queued paint, so the fade must be queued after it
    // to cover its bottom edge.
    fade_h := AppScale(120)
    fade_y := title_y - fade_h
    PaintVerticalGradient(app.ui.session, -1,
        Rectangle.{cast(float32)content_view_x, cast(float32)fade_y,
            cast(float32)content_view_w, cast(float32)fade_h},
        Fade(StyleTokenColor("canvas"), 0.0f), StyleTokenColor("canvas"))
    PaintRoundedFill(app.ui.session, -1,
        Rectangle.{cast(float32)content_view_x, cast(float32)title_y,
            cast(float32)content_view_w,
            cast(float32)(app.ui.view_height - title_y)},
        0.0, 4, StyleTokenColor("canvas"))

    practice_draw_home_title(app, x, title_y, content_w)

    if practice_banner_probe_count == 1 {
        TraceLog(3, "APP PROBE: home title complete")
    }

    current_index := practice_ordered_index(app, app.exercise_type)
    selected_index := practice_carousel_controls(Rectangle.{cast(float32)pager_x, cast(float32)pager_y, cast(float32)pager_w, cast(float32)pager_h}, practice_home_count(app), current_index, app.modal.active, 7090)
    if selected_index >= 0 && selected_index != current_index {
        practice_select_home_card(app, practice_ordered_id(selected_index))
    }

    app.practice_home_bounds_start = Rectangle.{cast(float32)action_x, cast(float32)button_y,
        cast(float32)primary_w, cast(float32)button_h
    }
    if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = app.practice_home_bounds_start,
            .label = LocaleText("practice_start_button"),
            .disabled = app != null && app.modal.active != 0,
            .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
            .pill = true
        }) != 0 {
        if practice != null && practice.start != null {
            practice.start(app)
        }
    }
    if wide_actions != 0 {
        action_x += primary_w + action_gap
    } else {
        button_y += button_h + action_gap
    }

    if practice != null && practice.draw_manual != null {
        app.practice_home_bounds_manual = Rectangle.{cast(float32)action_x, cast(float32)button_y,
            cast(float32)secondary_w, cast(float32)button_h
        }
        if Button(CurrentApp().ui.session, ButtonProps.{
                .bounds = app.practice_home_bounds_manual,
                .label = LocaleText("practice_manual_button"),
                .disabled = app != null && app.modal.active != 0,
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
                .pill = true
            }) != 0 {
            practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
        }
        if wide_actions != 0 || secondary_row != 0 {
            action_x += secondary_w + action_gap
        } else {
            button_y += button_h + action_gap
        }
    }

    if practice != null && practice.draw_config != null {
        app.practice_home_bounds_config = Rectangle.{cast(float32)action_x, cast(float32)button_y,
            cast(float32)secondary_w, cast(float32)button_h
        }
        if Button(CurrentApp().ui.session, ButtonProps.{
                .bounds = app.practice_home_bounds_config,
                .label = LocaleText("practice_configure_button"),
                .disabled = app != null && app.modal.active != 0,
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
                .pill = true
            }) != 0 {
            practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
        }
    }

    if practice_banner_probe_count == 1 {
        TraceLog(3, "APP PROBE: home hero complete")
    }
    return 1
}

practice_screen_draw_home :: (app: *InnerBreeze) {
    start(app)
}

practice_activity_label :: (exercise: s32) -> string {
    return practice_label(exercise)
}

practice_clamp_activity_to_tab :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.exercise_type = practice_clamp_id(app.exercise_type)
}

practice_screen_open_tab :: (app: *InnerBreeze, tab: s32) {
    route := AppRoute.{0 }

    if app == null || app.modal.active != 0 {
        return
    }
    if tab == PRACTICE_TAB_PLAY {
        route = app_current_route(app)
        if app.practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_PLAY
        route.screen = ScreenStart
        if app.modal.type == cast(ModalType)ModalPracticeManual || app.modal.type == cast(ModalType)ModalPracticeConfig {
            app_close_modal(app)
        }
        app_switch_route(app, route)
    } else if tab == PRACTICE_TAB_MANUAL {
        route = app_current_route(app)
        if practice_get(app.exercise_type).draw_manual == null {
            return
        }
        if app.practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_MANUAL
        route.screen = ScreenStart
        app.tutorial_step = 0
        app.manual_scroll = 0
        app_switch_route(app, route)
    } else if tab == PRACTICE_TAB_CONFIG {
        route = app_current_route(app)
        if practice_get(app.exercise_type).draw_config == null {
            return
        }
        if app.practice_tab != PRACTICE_TAB_CONFIG {
            reset_settings_preview(app)
            app.settings_scroll = 0
            app.practice_config_tab = 0
        }
        route.practice_tab = PRACTICE_TAB_CONFIG
        route.practice_config_tab = 0
        route.screen = ScreenStart
        app_switch_route(app, route)
    }
}

practice_screen_draw_desktop_tab_bar :: (app: *InnerBreeze, y: s32) -> s32 {
    tabs: [EXERCISE_COUNT] Tab
    values: [EXERCISE_COUNT] s32
    tab_count: s32 = 0
    selected_index: s32 = 0
    clicked: s32 = 0

    if app == null {
        return -1
    }
    {
        i: s32 = 0
        while i < practice_count() {
            id := practice_ordered_id(i)
            if id == app.exercise_type {
                selected_index = tab_count
            }
            values[tab_count] = id
            tabs[tab_count] = Tab.{.label = practice_activity_label(id), .disabled = app.modal.active != 0 }
            tab_count += 1
            i += 1
        }

    }
    if tab_count <= 0 {
        return -1
    }
    bar_result := TabBar(CurrentApp().ui.session, TabBarProps.{.bounds = Rectangle.{0, cast(float32)y, cast(float32)app.ui.view_width, cast(float32)GetTabBarHeight()}, .selected_index = selected_index}, tabs[:tab_count])
    return ifx (bar_result.node >= 0 && bar_result.node < tab_count) then (values[bar_result.node]) else (-1)
}

practice_screen_draw_top_bar :: (app: *InnerBreeze, draw_menu: s32) {
    exercise_options: [EXERCISE_COUNT] DropdownOption
    exercise_values: [EXERCISE_COUNT] s32
    activity_count: s32 = 0
    activity_index: s32 = 0
    route := AppRoute.{0 }

    if app == null {
        return
    }
    practice_clamp_activity_to_tab(app)
    {
        i: s32 = 0
        while i < practice_count() {
            id := practice_ordered_id(i)
            if id == app.exercise_type {
                activity_index = activity_count
            }
            exercise_values[activity_count] = id
            exercise_options[activity_count] = DropdownOption.{.label = practice_activity_label(id)}
            activity_count += 1
            i += 1
        }

    }
    if activity_count <= 0 {
        return
    }
    if draw_menu != 0 {
        menu_result: ToolbarResult = Toolbar(CurrentApp().ui.session, ToolbarProps.{.id = 300, .x = 0, .y = 0, .width = app.ui.view_width, .height = app_content_top_reserved(app)}, exercise_options[:activity_count], no_toolbar_actions())
        if app.modal.active == 0 && menu_result.selected_menu_item >= 0 {
            route = app_current_route(app)
            if app.practice_tab == PRACTICE_TAB_CONFIG {
                app_leave_practice_config(app)
            }
            route.exercise_type = exercise_values[activity_index]
            route.practice_tab = PRACTICE_TAB_PLAY
            route.practice_config_tab = 0
            route.screen = ScreenStart
            app.manual_scroll = 0
            app.settings_scroll = 0
            app.practice_home_scroll = 0
            app.tutorial_step = 0
            app.practice_config_tab = 0
            app_switch_route(app, route)
        }
        return
    }
    if app_should_use_tab_bar(app) != 0 {
        clicked_exercise := practice_screen_draw_desktop_tab_bar(app, 0)
        if clicked_exercise >= 0 && clicked_exercise != app.exercise_type {
            route = app_current_route(app)
            if app.practice_tab == PRACTICE_TAB_CONFIG {
                app_leave_practice_config(app)
            }
            route.exercise_type = clicked_exercise
            route.practice_tab = PRACTICE_TAB_PLAY
            route.practice_config_tab = 0
            route.screen = ScreenStart
            app.manual_scroll = 0
            app.settings_scroll = 0
            app.practice_home_scroll = 0
            app.tutorial_step = 0
            app.practice_config_tab = 0
            app_switch_route(app, route)
        }
    } else {
        Toolbar(CurrentApp().ui.session, ToolbarProps.{.id = 300, .x = 0, .y = 0, .width = app.ui.view_width, .height = GetTabBarHeight()}, exercise_options[:activity_count], no_toolbar_actions())
    }
    if app.modal.active == 0 {
        app.practice_tab = PRACTICE_TAB_PLAY
    }
}

practice_screen_draw_floating_actions :: (app: *InnerBreeze) {
    icon_size := AppScale(22)
    icon_padding := AppScale(9)
    button_w := icon_size + icon_padding * 2
    gap := AppScale(10)
    margin := AppScale(14)
    y := app_content_top_reserved(app) + AppScale(10)
    x := app.ui.view_width - margin

    if app == null || app.modal.active != 0 || app.breathing.screen != ScreenStart {
        return
    }
    practice := practice_get(app.exercise_type)
    if practice.draw_config != null {
        x -= button_w
        if Button(CurrentApp().ui.session, ButtonProps.{
                .id = 0,
                .bounds = Rectangle.{cast(float32)(x), cast(float32)(y),
                    cast(float32)((icon_size) + (icon_padding) * 2),
                    cast(float32)((icon_size) + (icon_padding) * 2)},
                .icon_type = ICON_WRENCH, .icon_only = true,
                .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            }) != 0 {
            practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
        }
        x -= gap
    }
    if practice.draw_manual != null {
        x -= button_w
        if Button(CurrentApp().ui.session, ButtonProps.{
                .id = 0,
                .bounds = Rectangle.{cast(float32)(x), cast(float32)(y),
                    cast(float32)((icon_size) + (icon_padding) * 2),
                    cast(float32)((icon_size) + (icon_padding) * 2)},
                .icon_type = ICON_MANUAL, .icon_only = true,
                .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            }) != 0 {
            practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
        }
    }
}

practice_screen_draw_modal :: (app: *InnerBreeze) {
    if app == null || app.modal.active == 0 {
        return
    }
    if app.modal.type != cast(ModalType)ModalPracticeManual && app.modal.type != cast(ModalType)ModalPracticeConfig && app.modal.type != cast(ModalType)ModalEditProgressiveStartSpeed {
        return
    }
    DrawRectangle(0, 0, app.ui.view_width, app.ui.view_height, StyleTokenColor("canvas"))
    if app.modal.type == cast(ModalType)ModalEditProgressiveStartSpeed {
        practice := practice_get(app.exercise_type)
        if practice.draw_config != null {
            practice.draw_config(app)
        }
        return
    }
    if app.modal.type == cast(ModalType)ModalPracticeManual {
        app.practice_tab = PRACTICE_TAB_MANUAL
        manual_screen_draw(app)
    } else {
        practice := practice_get(app.exercise_type)
        app.practice_tab = PRACTICE_TAB_CONFIG
        if practice.draw_config != null {
            practice.draw_config(app)
        }
    }
}

practice_screen_dismiss_first_run_guide :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.tutorial_seen = 1
    app.tutorial_step = 0
    save_settings(app)
    sync_web_storage_critical()
}

practice_screen_first_run_guide_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app != null && !AppMiniMode() && app.tutorial_seen == 0 && app.modal.active == 0 && app.exercise_type != EXERCISE_SUN_SALUTATION && app.breathing.screen == ScreenStart && app.main_tab != APP_MAIN_TAB_NONE && storage_has_sync_account() == 0) then (1) else (0)
}

practice_screen_prepare_first_run_guide :: (app: *InnerBreeze) {
    if practice_screen_first_run_guide_active(app) == 0 {
        return
    }
    app.practice_tab = PRACTICE_TAB_PLAY
}

practice_home_rect_valid :: (rect: Rectangle) -> s32 {
    return ifx (rect.width > 0 && rect.height > 0) then (1) else (0)
}

practice_home_action_guide_anchor :: (manual: Rectangle, config: Rectangle) -> Rectangle {
    manual_valid := practice_home_rect_valid(manual)
    config_valid := practice_home_rect_valid(config)

    if manual_valid == 0 {
        if config_valid != 0 {
            return config
        }
        return Rectangle.{0}
    }
    if config_valid == 0 {
        return manual
    }

    left: float32 = ifx (manual.x < config.x) then (manual.x) else (config.x)
    top: float32 = ifx (manual.y < config.y) then (manual.y) else (config.y)
    right := manual.x + manual.width
    bottom := manual.y + manual.height
    config_right: float32 = config.x + config.width
    config_bottom: float32 = config.y + config.height

    if config_right > right {
        right = config_right
    }
    if config_bottom > bottom {
        bottom = config_bottom
    }
    return Rectangle.{left, top, right - left, bottom - top }
}

practice_home_carousel_guide_anchor :: (app: *InnerBreeze) -> Rectangle {
    card := app.practice_home_bounds_card
    anchor_w := cast(s32)app.practice_home_bounds_start.width
    anchor_h := practice_home_carousel_controls_height(app)

    anchor_w = cast(s32)card.width - AppScale(32)
    if anchor_w > AppScale(480) {
        anchor_w = AppScale(480)
    }
    anchor_x := cast(s32)(card.x + (card.width - cast(float32)anchor_w) / 2)
    anchor_y := cast(s32)app.practice_home_bounds_start.y - (cast(s32)AppScale(10) + anchor_h)

    return Rectangle.{
        cast(float32)anchor_x,
        cast(float32)anchor_y,
        cast(float32)anchor_w,
        cast(float32)anchor_h
    }
}

practice_screen_draw_first_run_guide :: (app: *InnerBreeze) {
    steps: [3] GuideOverlayStep
    result := GuideOverlayResult.{0 }

    if practice_screen_first_run_guide_active(app) == 0 {
        return
    }
    if app.practice_home_bounds_valid == 0 {
        return
    }
    steps[0] = GuideOverlayStep.{
        practice_home_carousel_guide_anchor(app),
        LocaleText("practice_guide_carousel")
    }
    steps[1] = GuideOverlayStep.{app.practice_home_bounds_start, LocaleText("practice_guide_start") }
    steps[2] = GuideOverlayStep.{practice_home_action_guide_anchor(app.practice_home_bounds_manual, app.practice_home_bounds_config), LocaleText("practice_guide_manual_config") }
    result = GuideOverlay(GuideOverlayProps.{
            .steps = *steps[0],
            .count = 3,
            .step = *app.tutorial_step,
            .view_width = app.ui.view_width,
            .view_height = app.ui.view_height,
            .reserved_top = app_content_top_reserved(app),
            .reserved_bottom = app_content_bottom_reserved(app),
            .max_width = AppScale(300),
            .previous_requested = IsKeyPressed(KEY_LEFT),
            .next_requested = IsKeyPressed(KEY_RIGHT) || IsKeyPressed(KEY_ENTER),
            .close_requested = IsKeyPressed(KEY_BACK) || IsKeyPressed(KEY_ESCAPE)
        })
    if result.changed != 0 {
        save_settings(app)
        sync_web_storage_critical()
    }
    if result.closed != 0 || result.finished != 0 {
        practice_screen_dismiss_first_run_guide(app)
    }
}

start :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("start/root")
    Screen(CurrentApp().ui.session, root)
    if app == null {
        return
    }
    practice_clamp_activity_to_tab(app)
    app.practice_home_bounds_valid = 0
    unused practice_screen_draw_home_hero(app)
    End(CurrentApp().ui.session)
}
