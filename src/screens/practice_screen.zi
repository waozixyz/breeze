KEY_LEFT :: 263;
KEY_RIGHT :: 262;
KEY_ENTER :: 257;
KEY_BACK :: 259;
KEY_ESCAPE :: 256;
clampi :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    if value < min_value { return min_value }
    if value > max_value { return max_value }
    return value
}
