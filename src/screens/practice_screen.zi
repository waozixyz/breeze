empty_options_storage: [1] DropdownOption;

empty_title_options :: () -> []DropdownOption {
    return empty_options_storage[:0]
}

#program_export
practice_screen_subscreen_integrated :: (app: *InnerBreeze, modal_type: s32) -> s32 {
    return cast(s32)(app != null && app.breathing.screen == ScreenStart && cast(s32)app.modal.type != modal_type)
}

#program_export
practice_screen_config_layout :: (app: *InnerBreeze, modal_type: s32, content_top_gap: s32, layout: *PracticeSubscreenLayout) {
    integrated := practice_screen_subscreen_integrated(app, modal_type)
    title_h: s32 = ifx (integrated != 0) then (app_content_top_reserved(app)) else (AppTitleBarHeight())
    scroll_y: s32 = title_h + content_top_gap
    bottom_reserved: s32 = ifx (integrated != 0) then (app_content_bottom_reserved(app)) else (0)
    view_h: s32 = 560
    if app != null {
        view_h = app.ui.view_height
    }
    scroll_h: s32 = view_h - scroll_y - bottom_reserved - (ifx (integrated != 0) then (AppScale(8)) else (0))

    if layout == null {
        return
    }
    if scroll_h < 0 {
        scroll_h = 0
    }
    layout.integrated = integrated
    layout.title_h = title_h
    layout.scroll_y = scroll_y
    layout.scroll_h = scroll_h
}

#program_export
practice_screen_handle_config_title :: (app: *InnerBreeze, title: string, modal_type: s32, has_leave_config: s32) -> s32 {
    title_h: s32 = 0

    if app == null {
        return 0
    }
    title_h = ifx (practice_screen_subscreen_integrated(app, modal_type) != 0) then (app_content_top_reserved(app)) else (AppTitleBarHeight())
    // The page closes only when its back action is pressed.
    bar: TitleBarProps
    bar.title = title
    bar.height = title_h
    bar.has_leading_action = true
    bar.leading_label = LocaleText("back_button")
    title_result := TitleBar(CurrentApp().ui.session, bar, empty_title_options())
    if !title_result.clicked_leading {
        return 0
    }
    unused has_leave_config
    practice_screen_leave_config(app, modal_type)
    return 1
}

// Back on a practice's Customize: the page closes, saving what changed.
#program_export
practice_screen_leave_config :: (app: *InnerBreeze, modal_type: s32) {
    app_block_current_click(app)
    if app.modal.active != 0 && cast(s32)app.modal.type == modal_type {
        app_close_modal(app)
    } else {
        if app.settings_dirty != 0 {
            save_settings(app)
        }
        active := practice_active(app)
        if active != null && active.leave_config != null {
            active.leave_config(app)
        }
        app.settings_scroll = 0
        app.practice_tab = PRACTICE_TAB_PLAY
        app_switch_screen(app, ScreenStart)
    }
}

practice_card_banner_asset_path :: (app: *InnerBreeze, exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    dark: bool = app != null && ((app.theme_mode == APP_THEME_DARK)  || (app.theme_mode != APP_THEME_LIGHT && app.dark_mode != 0))

    if id == EXERCISE_WIM_HOF {
        return ifx (dark) then ("assets/practices/whm/banner-dark.png") else ("assets/practices/whm/banner-light.png")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return ifx (dark) then ("assets/practices/sunsalutation/banner-dark.png") else ("assets/practices/sunsalutation/banner-light.png")
    }
    if id == EXERCISE_MEDITATION {
        return ifx (dark) then ("assets/practices/meditation/banner-dark.png") else ("assets/practices/meditation/banner-light.png")
    }
    if id == EXERCISE_PATTERNS {
        return ifx (dark) then ("assets/practices/patterns/banner-dark.png") else ("assets/practices/patterns/banner-light.png")
    }
    if id == EXERCISE_TAI_CHI {
        return ifx (dark) then ("assets/practices/taichi/banner-dark.png") else ("assets/practices/taichi/banner-light.png")
    }
    if id == EXERCISE_ASTRAL_PROJECTION {
        return ifx dark then "assets/practices/astral_projection/banner-dark.png" else "assets/practices/astral_projection/banner-light.png"
    }
    if id == EXERCISE_WORKOUT {
        return ifx dark then "assets/practices/workout/banner-dark.png" else "assets/practices/workout/banner-light.png"
    }
    return ""
}

practice_banner_probe_count: s32;

practice_draw_card_banner :: (asset_path: string, dest: Rectangle) {
    if asset_path.count == 0 || asset_path[0] == #char "\0" || dest.width <= 0 || dest.height <= 0 {
        return
    }
    first_banner := practice_banner_probe_count == 0
    practice_banner_probe_count += 1
    if first_banner {
        TraceLog(3, "APP PROBE: before banner Image")
    }
    Image(CurrentApp().ui.session, ImageProps.{
            .asset_path = asset_path,
            .bounds = dest,
            .fit = cast(ImageFit)ImageFitCover
        })
    if first_banner {
        TraceLog(3, "APP PROBE: after banner Image")
    }
}

// Practice lists every practice, apart from paid ones where they cannot be
// bought, under a tab for its kind.
practice_home_listed :: (id: s32) -> bool {
    return !PracticeHidden(id)
}

practice_home_kind_of :: (id: s32) -> s32 {
    return practice_get(practice_clamp_id(id)).kind
}

// The listed practices of one kind, in their usual order.
practice_kind_ids :: (kind: s32, ids: []s32) -> s32 {
    count: s32 = 0
    for index: cast(s32)0..practice_count() - 1 {
        id := practice_ordered_id(index)
        if practice_home_listed(id) && practice_home_kind_of(id) == kind && count < ids.count {
            ids[count] = id
            count += 1
        }
    }
    return count
}

// The practices of the chosen practice's kind, which its tab shows.
practice_home_ids :: (ids: []s32) -> s32 {
    return practice_kind_ids(practice_home_kind_of(CurrentApp().exercise_type), ids)
}

// The tabs, in order, and the practice each one last showed.
PRACTICE_HOME_KIND_COUNT :: 4
practice_home_kinds: [4]s32 = .[PRACTICE_KIND_MEDITATION, PRACTICE_KIND_YOGA,
PRACTICE_KIND_MARTIAL_ARTS, PRACTICE_KIND_WORKOUT];
practice_home_kind_choice: [4]s32 = .[-1, -1, -1, -1];
practice_home_tab_scroll: s32;
// The kind whose tab was last brought into view; another kind's tab is
// brought into view once, after which the tabs stay where a swipe leaves them.
practice_home_tab_shown: s32 = -1;

practice_kind_label :: (kind: s32) -> string {
    if kind == PRACTICE_KIND_YOGA {
        return LocaleText("practice_kind_yoga")
    }
    if kind == PRACTICE_KIND_MARTIAL_ARTS {
        return LocaleText("practice_kind_martial_arts")
    }
    if kind == PRACTICE_KIND_WORKOUT {
        return LocaleText("practice_kind_workout")
    }
    return LocaleText("practice_kind_meditation")
}

// One tab for each kind with a practice to list, such as Martial arts only
// where Tai Chi can be bought: each tab's kind, and its kind's place.
practice_home_tab_kinds: [PRACTICE_HOME_KIND_COUNT]s32;
practice_home_tab_slots: [PRACTICE_HOME_KIND_COUNT]s32;

practice_home_tabs :: (app: *InnerBreeze, selected: *s32) -> s32 {
    count: s32 = 0
    current := practice_home_kind_of(app.exercise_type)
    for slot: cast(s32)0..PRACTICE_HOME_KIND_COUNT - 1 {
        kind := practice_home_kinds[slot]
        ids: [EXERCISE_COUNT]s32
        if practice_kind_ids(kind, ids[:]) == 0 {
            continue
        }
        if kind == current {
            selected.* = count
            practice_home_kind_choice[slot] = practice_clamp_id(app.exercise_type)
        }
        practice_home_tab_kinds[count] = kind
        practice_home_tab_slots[count] = slot
        count += 1
    }
    return count
}

// Choosing a tab shows the practice it last showed, or its first.
practice_home_choose_tab :: (app: *InnerBreeze, tab: s32, count: s32) {
    if tab < 0 || tab >= count {
        return
    }
    kind := practice_home_tab_kinds[tab]
    choice := practice_home_kind_choice[practice_home_tab_slots[tab]]
    if choice < 0 || practice_home_kind_of(choice) != kind || !practice_home_listed(choice) {
        ids: [EXERCISE_COUNT]s32
        unused practice_kind_ids(kind, ids[:])
        choice = ids[0]
    }
    practice_select_home_card(app, choice)
}

// A swipe moves through every listed practice in the tabs' order: past a
// tab's last practice it goes on to the next tab, and from the last tab back
// to the first.
practice_next_ordered :: (app: *InnerBreeze, dir: s32) -> s32 {
    if app == null {
        return EXERCISE_WIM_HOF
    }
    current := practice_clamp_id(app.exercise_type)
    ids: [EXERCISE_COUNT]s32
    total: s32 = 0
    for slot: cast(s32)0..PRACTICE_HOME_KIND_COUNT - 1 {
        total += practice_kind_ids(practice_home_kinds[slot], ids[total:])
    }
    if total <= 0 {
        return current
    }
    at: s32 = 0
    for index: cast(s32)0..total - 1 {
        if ids[index] == current {
            at = index
        }
    }
    return ids[(at + dir + total * 2) % total]
}

practice_home_carousel_controls_height :: (app: *InnerBreeze) -> s32 {
    unused app
    ids: [EXERCISE_COUNT]s32
    return ifx practice_home_ids(ids[:]) > 1 then AppScale(48) else 0
}

practice_select_home_card :: (app: *InnerBreeze, exercise: s32) {
    route := AppRoute.{0 }

    if app == null {
        return
    }
    if app.practice_tab == PRACTICE_TAB_CONFIG {
        app_leave_practice_config(app)
    }
    route = app_current_route(app)
    route.screen = ScreenStart
    route.exercise_type = practice_clamp_id(exercise)
    route.practice_tab = PRACTICE_TAB_PLAY
    route.practice_config_tab = 0
    app.manual_scroll = 0
    app.settings_scroll = 0
    app.practice_home_scroll = 0
    app.tutorial_step = 0
    app_switch_route(app, route)
}

practice_home_title :: (exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    if id == EXERCISE_WIM_HOF {
        return LocaleText("practice_home_title_wim_hof")
    }
    if id == EXERCISE_MEDITATION {
        return LocaleText("practice_home_title_meditation")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return LocaleText("practice_home_title_sun_salutation")
    }
    if id == EXERCISE_PATTERNS {
        return LocaleText("practice_home_title_patterns")
    }
    if id == EXERCISE_TAI_CHI {
        return LocaleText("practice_home_title_tai_chi")
    }
    return practice_label(id)
}

practice_home_subtitle :: (exercise: s32) -> string {
    id := practice_clamp_id(exercise)
    if id == EXERCISE_WIM_HOF {
        return LocaleText("practice_home_subtitle_wim_hof")
    }
    if id == EXERCISE_MEDITATION {
        return LocaleText("practice_home_subtitle_meditation")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return LocaleText("practice_home_subtitle_sun_salutation")
    }
    if id == EXERCISE_PATTERNS {
        return LocaleText("practice_home_subtitle_patterns")
    }
    if id == EXERCISE_TAI_CHI {
        return LocaleText("practice_home_subtitle_tai_chi")
    }
    if id == EXERCISE_ASTRAL_PROJECTION {
        return LocaleText("practice_home_subtitle_astral_projection")
    }
    if id == EXERCISE_WORKOUT {
        return LocaleText("practice_home_subtitle_workout")
    }
    return ""
}

// Whether the practice home has a settings button: a practice whose Start
// opens its settings has none.
practice_home_has_config :: (practice: *PracticeDefinition) -> bool {
    return practice != null && practice.draw_config != null && !practice.config_on_start
}

// ---- Practice's home, which Practice draws -------------------------------------

practice_home_frame: PracticeHomeFrame;
practice_home_frame_codec: WidgetPracticeHomeFrameCodec;
practice_home_tab_codec: WidgetPracticeHomeTabCodec;

PracticeHomeCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "practice_home_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPracticeHomeHost" && count == 0 {
        result.* = WidgetEncodePracticeHomeFrame(practice_home_frame, *practice_home_frame_codec)
        return 1
    }
    if name == "WritePracticeHomeHost" && count == 1 && WidgetValidPracticeHomeFrame(arguments[0]) {
        observed := WidgetDecodePracticeHomeFrame(arguments[0], *practice_home_frame_codec)
        practice_home_frame.swipe = observed.swipe
        practice_home_frame.tab_scroll = observed.tab_scroll
        practice_home_frame.action = observed.action
        practice_home_frame.value = observed.value
        practice_home_frame.card = observed.card
        practice_home_frame.start = observed.start
        practice_home_frame.manual = observed.manual
        practice_home_frame.config = observed.config
        practice_home_frame.claim_pointer = observed.claim_pointer
        practice_home_frame.release_pointer = observed.release_pointer
        practice_home_frame.block_click = observed.block_click
        return 1
    }
    if name == "ReadPracticeHomeTabHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        tab: PracticeHomeTab
        if index >= 0 && index < practice_home_frame.tab_count {
            tab = PracticeHomeTab.{.label = practice_kind_label(practice_home_tab_kinds[index]),
                .slot = practice_home_tab_slots[index]}
        }
        result.* = WidgetEncodePracticeHomeTab(tab, *practice_home_tab_codec)
        return 1
    }
    if name == "PracticeLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

practice_home_frame_for :: (app: *InnerBreeze, ids: []s32, listed: s32) -> PracticeHomeFrame {
    practice := practice_get(app.exercise_type)
    frame := PracticeHomeFrame.{.session = app.ui.session, .scale = MetricsScale(),
        .view_width = app.ui.view_width, .view_height = app.ui.view_height,
        .top = app_content_top_reserved(app), .bottom = app_content_bottom_reserved(app),
        .left = app_content_left_reserved(app), .font = AppFontSize(),
        .small_font = AppSmallFontSize(), .canvas_color = StyleTokenColor("canvas"),
        .surface_color = StyleTokenColor("surface"), .accent_color = StyleTokenColor("accent"),
        .modal_active = app.modal.active != 0,
        // While Lumi's guide is open, the arrow keys and swipes are the
        // guide's: choosing another practice under it would start it over.
        .choosing = app.modal.active == 0 && practice_screen_first_run_guide_active(app) == 0,
        .key_left = IsKeyPressed(KEY_LEFT), .key_right = IsKeyPressed(KEY_RIGHT),
        .swipe = app.practice_home_swipe, .swipe_frame = app.ui.manual_swipe_frame,
        .practice = app.exercise_type, .title = practice_home_title(app.exercise_type),
        .subtitle = practice_home_subtitle(app.exercise_type),
        .banner = practice_card_banner_asset_path(app, app.exercise_type),
        .tab_scroll = practice_home_tab_scroll, .listed = listed,
        .has_manual = practice != null && practice.draw_manual != null,
        .has_config = practice_home_has_config(practice)}
    for index: cast(s32)0..listed - 1 {
        if ids[index] == app.exercise_type {
            frame.index = index
        }
    }
    frame.tab_count = practice_home_tabs(app, *frame.tab_selected)
    frame.tab_focus = practice_home_kind_of(app.exercise_type) != practice_home_tab_shown
    PracticeOfferFill(app, app.exercise_type, *frame)
    return frame
}

// Has Practice draw its home and does what was asked there. Returns 1 when
// the home was drawn.
practice_screen_draw_home_hero :: (app: *InnerBreeze) -> s32 {
    if app == null {
        return 0
    }
    PracticeDownloadsTick()
    // A practice that is not listed here gives way to the first one listed.
    if !practice_home_listed(app.exercise_type) && app.modal.active == 0 {
        for index: cast(s32)0..practice_count() - 1 {
            if practice_home_listed(practice_ordered_id(index)) {
                practice_select_home_card(app, practice_ordered_id(index))
                break
            }
        }
    }
    ids: [EXERCISE_COUNT]s32
    listed := practice_home_ids(ids[:])
    if listed == 0 {
        return 0
    }
    practice_home_frame = practice_home_frame_for(app, ids[:], listed)
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(PracticeHomeCall, cast(*void)app)
    drawn := PracticeRun(PracticeMessage.{.action = PRACTICE_HOME_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    // The frame's text lives in this frame's buffers; the next frame
    // replaces it.
    frame := practice_home_frame
    if !drawn.succeeded {
        return 0
    }
    app.practice_home_swipe = frame.swipe
    if frame.claim_pointer { app.ui.manual_swipe_owner = true }
    if frame.release_pointer { app.ui.manual_swipe_owner = false }
    if frame.block_click {
        app_block_current_click(app)
    }
    practice_home_tab_scroll = frame.tab_scroll
    practice_home_tab_shown = practice_home_kind_of(app.exercise_type)
    app.practice_home_bounds_valid = 1
    app.practice_home_bounds_card = frame.card
    app.practice_home_bounds_start = frame.start
    app.practice_home_bounds_manual = frame.manual
    app.practice_home_bounds_config = frame.config
    if frame.action == PRACTICE_HOME_START {
        // One practice runs at a time: Start brings back the practice that
        // runs in its small window instead of starting another over it.
        if app_session_window_restore(app) {
            return 1
        }
        practice := practice_get(app.exercise_type)
        if practice != null && practice.start != null {
            practice.start(app)
        }
    } else if frame.action == PRACTICE_HOME_MANUAL {
        practice_screen_open_tab(app, PRACTICE_TAB_MANUAL)
    } else if frame.action == PRACTICE_HOME_CONFIG {
        practice_screen_open_tab(app, PRACTICE_TAB_CONFIG)
    } else if frame.action == PRACTICE_HOME_OFFER && !frame.offer_disabled {
        PracticeDownloadAct(app, app.exercise_type, frame.offer)
    } else if frame.action == PRACTICE_HOME_STEP {
        practice_select_home_card(app, practice_next_ordered(app, frame.value))
    } else if frame.action == PRACTICE_HOME_PICK && frame.value >= 0 && frame.value < listed {
        practice_select_home_card(app, ids[frame.value])
    } else if frame.action == PRACTICE_HOME_TAB {
        practice_home_choose_tab(app, frame.value, frame.tab_count)
    }
    return 1
}

practice_screen_draw_home :: (app: *InnerBreeze) {
    if account_activity.view_open && ActivityDrawRemote(app) {
        return
    }
    start(app)
}

practice_clamp_activity_to_tab :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.exercise_type = practice_clamp_id(app.exercise_type)
}

practice_screen_open_tab :: (app: *InnerBreeze, tab: s32) {
    route := AppRoute.{0 }

    if app == null || app.modal.active != 0 {
        return
    }
    if tab == PRACTICE_TAB_CONFIG && app.exercise_type == EXERCISE_TAI_CHI {
        tai_chi_customize_open(app)
        return
    }
    if tab == {
        case PRACTICE_TAB_PLAY;
        route = app_current_route(app)
        if app.practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_PLAY
        route.screen = ScreenStart
        if app.modal.type == cast(ModalType)ModalPracticeManual || app.modal.type == cast(ModalType)ModalPracticeConfig {
            app_close_modal(app)
        }
        app_switch_route(app, route)
        case PRACTICE_TAB_MANUAL;
        route = app_current_route(app)
        if practice_get(app.exercise_type).draw_manual == null {
            return
        }
        if app.practice_tab == PRACTICE_TAB_CONFIG {
            app_leave_practice_config(app)
        }
        route.practice_tab = PRACTICE_TAB_MANUAL
        route.screen = ScreenStart
        app.tutorial_step = 0
        app.manual_scroll = 0
        app_switch_route(app, route)
        case PRACTICE_TAB_CONFIG;
        route = app_current_route(app)
        if practice_get(app.exercise_type).draw_config == null {
            return
        }
        if app.practice_tab != PRACTICE_TAB_CONFIG {
            reset_settings_preview(app)
            app.settings_scroll = 0
            app.practice_config_tab = 0
        }
        route.practice_tab = PRACTICE_TAB_CONFIG
        route.practice_config_tab = 0
        route.screen = ScreenStart
        app_switch_route(app, route)
    }
}

practice_screen_draw_modal :: (app: *InnerBreeze) {
    if app == null || app.modal.active == 0 {
        return
    }
    if app.modal.type != cast(ModalType)ModalPracticeManual && app.modal.type != cast(ModalType)ModalPracticeConfig && app.modal.type != cast(ModalType)ModalEditProgressiveStartSpeed {
        return
    }
    // The page is drawn over the canvas. The dock, already drawn this frame
    // while a bottom dock shows, stays above it.
    Box(app.ui.session, BoxProps.{
            .bounds = Rectangle.{0.0, 0.0, cast(float32)app.ui.view_width,
                cast(float32)(app.ui.view_height - app_content_bottom_reserved(app))},
            .fill = StyleTokenColor("canvas")})
    if app.modal.type == cast(ModalType)ModalEditProgressiveStartSpeed {
        practice := practice_get(app.exercise_type)
        if practice.draw_config != null {
            practice.draw_config(app)
        }
        return
    }
    if app.modal.type == cast(ModalType)ModalPracticeManual {
        app.practice_tab = PRACTICE_TAB_MANUAL
        manual_screen_draw(app)
    } else {
        practice := practice_get(app.exercise_type)
        app.practice_tab = PRACTICE_TAB_CONFIG
        if practice.draw_config != null {
            practice.draw_config(app)
        }
    }
}

practice_screen_dismiss_first_run_guide :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.tutorial_seen = 1
    app.tutorial_step = 0
    save_settings(app)
    sync_web_storage_critical()
}

practice_screen_first_run_guide_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app != null && !AppMiniMode() && app.tutorial_seen == 0 && app.modal.active == 0 && app.exercise_type != EXERCISE_SUN_SALUTATION && app.breathing.screen == ScreenStart && app.main_tab != APP_MAIN_TAB_NONE && storage_has_sync_account() == 0) then (1) else (0)
}

practice_screen_prepare_first_run_guide :: (app: *InnerBreeze) {
    if practice_screen_first_run_guide_active(app) == 0 {
        return
    }
    app.practice_tab = PRACTICE_TAB_PLAY
}

practice_home_rect_valid :: (rect: Rectangle) -> s32 {
    return ifx (rect.width > 0 && rect.height > 0) then (1) else (0)
}

practice_home_action_guide_anchor :: (manual: Rectangle, config: Rectangle) -> Rectangle {
    manual_valid := practice_home_rect_valid(manual)
    config_valid := practice_home_rect_valid(config)

    if manual_valid == 0 {
        if config_valid != 0 {
            return config
        }
        return Rectangle.{0}
    }
    if config_valid == 0 {
        return manual
    }

    left: float32 = ifx (manual.x < config.x) then (manual.x) else (config.x)
    top: float32 = ifx (manual.y < config.y) then (manual.y) else (config.y)
    right := manual.x + manual.width
    bottom := manual.y + manual.height
    config_right: float32 = config.x + config.width
    config_bottom: float32 = config.y + config.height

    if config_right > right {
        right = config_right
    }
    if config_bottom > bottom {
        bottom = config_bottom
    }
    return Rectangle.{left, top, right - left, bottom - top }
}

practice_home_carousel_guide_anchor :: (app: *InnerBreeze) -> Rectangle {
    card := app.practice_home_bounds_card
    anchor_w := cast(s32)app.practice_home_bounds_start.width
    anchor_h := practice_home_carousel_controls_height(app)

    anchor_w = cast(s32)card.width - AppScale(32)
    if anchor_w > AppScale(480) {
        anchor_w = AppScale(480)
    }
    anchor_x := cast(s32)(card.x + (card.width - cast(float32)anchor_w) / 2)
    anchor_y := cast(s32)app.practice_home_bounds_start.y - (cast(s32)AppScale(10) + anchor_h)

    return Rectangle.{
        cast(float32)anchor_x,
        cast(float32)anchor_y,
        cast(float32)anchor_w,
        cast(float32)anchor_h
    }
}

// The guide's steps over Practice's home. With one practice installed there
// is no carousel to pick from, so the guide begins at Start.
practice_screen_first_run_guide_steps :: (app: *InnerBreeze, steps: []GuideOverlayStep) -> s32 {
    count: s32 = 0
    if steps.count < 3 {
        return 0
    }
    if practice_home_carousel_controls_height(app) > 0 {
        steps[count] = GuideOverlayStepFor(practice_home_carousel_guide_anchor(app),
            "practice_guide_carousel")
        count += 1
    }
    steps[count] = GuideOverlayStepFor(app.practice_home_bounds_start,
        "practice_guide_start")
    count += 1
    steps[count] = GuideOverlayStepFor(practice_home_action_guide_anchor(
        app.practice_home_bounds_manual, app.practice_home_bounds_config),
        "practice_guide_manual_config")
    count += 1
    return count
}

practice_screen_draw_first_run_guide :: (app: *InnerBreeze) {
    steps: [3] GuideOverlayStep
    result := GuideOverlayResult.{0 }

    if practice_screen_first_run_guide_active(app) == 0 {
        return
    }
    if app.practice_home_bounds_valid == 0 {
        return
    }
    count := practice_screen_first_run_guide_steps(app, steps[:])
    result = GuideOverlay(GuideOverlayProps.{
            .steps = *steps[0],
            .count = count,
            .step = *app.tutorial_step,
            .view_width = app.ui.view_width,
            .view_height = app.ui.view_height,
            .reserved_top = app_content_top_reserved(app),
            .reserved_bottom = app_content_bottom_reserved(app),
            .max_width = AppScale(300),
            .previous_requested = IsKeyPressed(KEY_LEFT),
            .next_requested = IsKeyPressed(KEY_RIGHT) || IsKeyPressed(KEY_ENTER),
            .close_requested = IsKeyPressed(KEY_BACK) || IsKeyPressed(KEY_ESCAPE)
        })
    if result.changed != 0 {
        save_settings(app)
        sync_web_storage_critical()
    }
    if result.closed != 0 || result.finished != 0 {
        practice_screen_dismiss_first_run_guide(app)
    }
}

start :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("start/root")
    Screen(CurrentApp().ui.session, root)
    if app == null {
        return
    }
    practice_clamp_activity_to_tab(app)
    app.practice_home_bounds_valid = 0
    unused practice_screen_draw_home_hero(app)
    End(CurrentApp().ui.session)
}
