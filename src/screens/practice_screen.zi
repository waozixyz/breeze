c3 :: #system_library "c";
#import "byte_text_linux"
ICON_WRENCH :: 30;
ICON_MANUAL :: 31;
IsKeyPressed :: (key: s32) -> bool #foreign c3;
#import, file "../platform/trace_log.zi";
KEY_LEFT :: 263;
KEY_RIGHT :: 262;
KEY_ENTER :: 257;
KEY_BACK :: 259;
KEY_ESCAPE :: 256;
clampi :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    if value < min_value { return min_value }
    if value > max_value { return max_value }
    return value
}
app_close_modal :: (app: *InnerBreeze) #foreign c3;
app_switch_screen :: (app: *InnerBreeze, screen: s32) #foreign c3;
