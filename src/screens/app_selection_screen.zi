// The Apps library is also the first-start screen. Bundled apps are ready
// offline; opening a tile completes setup without a separate install step.
#import, file "../app/app_types.zi";
#import, file "../app/app_launcher_state.zi";

#program_export
app_selection_screen_draw :: (app: *InnerBreeze) {
    if !app.launcher_open {
        app_launcher_toggle(app)
    }
}
