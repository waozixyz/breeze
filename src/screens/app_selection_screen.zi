#import, file "../cells/value_codec.zi";
using HostValueKind;
picker_ui: InbeUiFrame;
picker_codec: WidgetInbeUiFrameCodec;

PickerUiCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "inbe_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPickerUiHost" && count == 0 {
        result.* = WidgetEncodeInbeUiFrame(picker_ui, *picker_codec)
        return 1
    }
    if name == "WritePickerUiHost" && count == 1 && WidgetValidInbeUiFrame(arguments[0]) {
        observed := WidgetDecodeInbeUiFrame(arguments[0], *picker_codec)
        picker_ui.scroll = observed.scroll
        picker_ui.automatic = observed.automatic
        picker_ui.confirm = observed.confirm
        picker_ui.check_updates = observed.check_updates
        return 1
    }
    if name == "PickerLocaleHost" && count == 1 &&
    ModuleScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = ModuleTextData("string"),
            .data = ModuleTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

PackageView :: (index: s32) -> AppPackageView {
    return AppPackageView.{.status = PackageStatus(index), .available = PackageAvailable(index)}
}

#program_export
app_selection_screen_draw :: (app: *InnerBreeze) {
    picker_ui = InbeUiFrame.{.session = app.ui.session,
        .width = app.ui.view_width, .height = app.ui.view_height,
        .scale = MetricsScale(), .font = AppFontSize(), .scroll = app.app_selection_scroll,
        .installed = CellsInstalledMask(), .automatic = PackageAutomaticEnabled(),
        .lists = PackageView(1), .habits = PackageView(2),
        .practices = PackageView(3), .diary = PackageView(4), .lumi = PackageView(5)}
    WidgetHostBegin(app.ui.session)
    CellsUiBegin(PickerUiCall, cast(*void)app)
    selected := InbeUiRun(InbeMessage.{.action = INBE_FRAME, .enabled_apps = app.enabled_apps})
    CellsUiEnd()
    WidgetHostEnd()
    if !selected.succeeded { return }
    app.enabled_apps = selected.enabled_apps & APP_ALL
    app.app_selection_scroll = picker_ui.scroll
    if picker_ui.automatic != PackageAutomaticEnabled() { PackageSetAutomatic(picker_ui.automatic) }
    if picker_ui.check_updates { PackageRequestAll(app.enabled_apps) }
    if picker_ui.confirm {
        if !CellsSetEnabled(app.enabled_apps) {
            return
        }
        for package: cast(s32)1..cast(s32)(PackageCount - 1) {
            bit := PackageBit(package)
            if (app.enabled_apps & bit) != 0 && (CellsInstalledMask() & bit) == 0 {
                PackageRequest(package)
            }
        }
        result := InbeRun(InbeMessage.{.action = INBE_CONFIGURE,
                .enabled_apps = app.enabled_apps & CellsInstalledMask()})
        if !result.succeeded {
            return
        }
        app.apps_selected = 1
        app.main_tab = APP_MAIN_TAB_NONE
        if result.screen == ScreenStart {
            app.main_tab = APP_MAIN_TAB_PRACTICE
        } else if result.screen == ScreenHabits {
            app.main_tab = APP_MAIN_TAB_HABITS
        } else if result.screen == ScreenEList {
            app.main_tab = APP_MAIN_TAB_ELIST
        }
        if result.screen == ScreenLumi {
            app.main_tab = APP_MAIN_TAB_LUMI
        }
        if result.screen == ScreenDiary {
            app.main_tab = APP_MAIN_TAB_DIARY
        }
        app_update_app_navigation(app, app.enabled_apps)
        save_settings(app)
        destination := ifx app.app_selection_return_to_settings then ScreenSettings else result.screen
        app.app_selection_return_to_settings = false
        app_switch_screen(app, destination)
    }
}
