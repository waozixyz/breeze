using Text.Wrap;
using ButtonEmphasis;
using ButtonState;

TelegramAccountPassword :: struct {
    value: [257]u8
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    composition: CompositionState
    preedit: [4096]u8
}

TelegramAccountView :: struct {
    visible: bool
    title_key: string
    message_key: string
    status: string
    restore_failed: bool
    details: string
    review_complete: bool
    review_id: string
    busy: bool
    allowed_actions: u32
    action_labels: [8]string
    password: *TelegramAccountPassword
    password_label: string
    scroll_offset: s32
    review_seen: bool
    seen_review_id: [65]u8
    seen_review_details: [4097]u8
}

// Controller actions: 1 create, 2 restore protected installation, 3 connect,
// 4 cancel, 5 encrypted backup, 6 approve, 7 encrypted recovery backup.
TelegramAccountActionAllowed :: (view: *TelegramAccountView, action: s32) -> bool {
    return view != null && action >= 1 && action <= 7 &&
    (view.allowed_actions & (cast(u32)1 << cast(u32)action)) != cast(u32)0
}

TelegramAccountActionLabel :: (action: s32) -> string {
    if action < 1 || action > 7 {
        return ""
    }
    if action == 1 {
        return LocaleText("sync_create_account_button")
    }
    if action == 2 {
        return LocaleText("telegram_account_restore_button")
    }
    if action == 3 {
        return LocaleText("sync_connect_account_button")
    }
    if action == 4 {
        return LocaleText("cancel_button")
    }
    if action == 5 {
        return LocaleText("sync_backup_key_button")
    }
    if action == 6 {
        return LocaleText("lumi_authorization_approve")
    }
    return LocaleText("telegram_account_recovery_button")
}

TelegramAccountClearPassword :: (password: *TelegramAccountPassword) {
    if password != null {
        SecureWipe(*password.value[0], 257)
        SecureWipe(*password.preedit[0], 4096)
        password.* = TelegramAccountPassword.{}
    }
}

// A controlled widget result borrows value and input bytes. Keep only owned
// edit/preedit bytes until that scope ends, then publish them together.
TelegramAccountPasswordUpdate :: struct {
    replacement: [257]u8
    preedit: [4096]u8
    start: s32
    end: s32
    changed: bool
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    escaped: bool
    composition_active: bool
    composition_length: s32
    composition_cursor: s32
    composition_selection: s32
    valid: bool
}

TelegramAccountObservePassword :: (result: TextField.Result) -> TelegramAccountPasswordUpdate {
    update: TelegramAccountPasswordUpdate
    if result.composition.text.count > update.preedit.count { return update }
    update.start = result.edit.start
    update.end = result.edit.end
    update.changed = result.edit.changed && AppCopyText(result.edit.replacement, update.replacement[:])
    update.cursor = result.cursor
    update.anchor = result.anchor
    update.scroll_x = result.scroll_x
    update.focused = result.focused
    update.escaped = result.escaped
    update.composition_active = result.composition.active
    update.composition_length = cast(s32)result.composition.text.count
    update.composition_cursor = result.composition.cursor
    update.composition_selection = result.composition.selection_length
    for byte, index: result.composition.text { update.preedit[index] = byte }
    update.valid = true
    return update
}

TelegramAccountApplyPassword :: (password: *TelegramAccountPassword, update: *TelegramAccountPasswordUpdate) {
    if !update.valid { return }
    password.composition = CompositionState.{}
    if update.changed {
        unused AppReplaceText(password.value[:], update.start, update.end, TextUntilNul(update.replacement[:]))
    }
    password.cursor = update.cursor
    password.anchor = update.anchor
    password.scroll_x = update.scroll_x
    password.focused = update.focused
    SecureWipe(*password.preedit[0], 4096)
    password.preedit = update.preedit
    password.composition = CompositionState.{
        .active = update.composition_active,
        .text = TextView(password.preedit[0:update.composition_length]),
        .cursor = update.composition_cursor,
        .selection_length = update.composition_selection}
}

TelegramAccountPasswordMask :: (password: *TelegramAccountPassword, output: []u8) -> bool {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if password == null || output.count < 257 || password.value[256] != cast(u8)0 {
        return false
    }
    value := AppTextFromCString(*password.value[0], 257)
    if !Utf8.Valid(value) {
        return false
    }
    count: s32 = 0
    for byte: value {
        if byte < cast(u8)32 || byte == cast(u8)127 {
            return false
        }
        if byte < cast(u8)128 || byte >= cast(u8)192 {
            output[count] = cast(u8)42
            count += 1
        }
    }
    output[count] = cast(u8)0
    return true
}

TelegramAccountHexDigit :: (byte: u8) -> bool {
    return (byte >= cast(u8)48 && byte <= cast(u8)57) ||
    (byte >= cast(u8)97 && byte <= cast(u8)102) ||
    (byte >= cast(u8)65 && byte <= cast(u8)70)
}

// Public fingerprints are grouped for comparison, so ordinary word wrapping
// can show every digit. The verified identity and signed values stay intact.
TelegramAccountReviewText :: (value: string, width: s32, output: []u8) -> bool {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if value.count > 4096 || output.count < value.count * 2 + 1 ||
    width <= 0 || !Utf8.Valid(value) {
        return false
    }
    digits := "0123456789abcdefABCDEF"
    widest: s32 = 0
    for index: 0..cast(s32)digits.count - 1 {
        measured := AppTextWidth(digits[index:index + 1], AppFontSize())
        if measured > widest {
            widest = measured
        }
    }
    group: s32 = 4
    while group > 1 && group * widest > width {
        group -= 1
    }
    if group * widest > width {
        return false
    }
    index: s32 = 0
    used: s32 = 0
    while index < cast(s32)value.count {
        if value[index] == cast(u8)0 {
            output[0] = cast(u8)0
            return false
        }
        end := index
        while end < cast(s32)value.count && TelegramAccountHexDigit(value[end]) {
            end += 1
        }
        if end == index {
            output[used] = value[index]
            used += 1
            index += 1
            continue
        }
        start := index
        while index < end {
            if end - start >= 32 && index > start && (index - start) % group == 0 {
                output[used] = cast(u8)32
                used += 1
            }
            output[used] = value[index]
            used += 1
            index += 1
        }
    }
    output[used] = cast(u8)0
    return true
}

TelegramAccountApprovalReady :: (view: *TelegramAccountView, retained: bool) -> bool {
    return view != null && !view.busy && retained && view.review_complete &&
    view.details.count > 0 && view.details.count <= 4096 &&
    view.review_id.count > 0 && view.review_id.count <= 64 &&
    view.review_seen && TextUntilNul(view.seen_review_id[:]) == view.review_id
}



TelegramAccountNewReviewDisplay :: () -> [8193]u8 {
    result: [8193]u8
    return result
}

TelegramAccountNewParagraphHeights :: () -> [3]s32 {
    result: [3]s32
    return result
}

TelegramAccountNewMask :: () -> [257]u8 {
    result: [257]u8
    return result
}

TelegramAccountNewTyped :: () -> [128]u8 {
    result: [128]u8
    return result
}
