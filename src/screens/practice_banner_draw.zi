#if (#defined(DESKTOP_HOST) && !#defined(_WIN32)) || #defined(ANDROID_BUILD) || #defined(KRYON_WEBGL2) {
    #import "kryon/bitmap_image"
    #import "kryon/drawing_props"
    #import "kryon/geometry"
    #import "kryon/scene"
    #import "kryon/scene_gpu"
    #import "kryon/session"
    #import "std/vec"
    #import, file "../app/assets.zi";
    #import, file "practice_banner_motion.zi";
    #import, file "practice_banner_regions.zi";
    #import, file "practice_banner_shader.zi";
    BannerImage :: #import "kryon/image";
    #if #defined(ANDROID_BUILD) {
        #import "kryon/image_behavior"

        ANDROID_BANNER_WIDTH :: 384
        ANDROID_BANNER_HEIGHT :: 192
        ANDROID_STEAM_WIDTH :: 176
        ANDROID_STEAM_HEIGHT :: 72
    }
    #if #defined(ANDROID_DEBUG) {
        #import "std/byte_text_linux"
        #import "std/c_string"
        #import, file "../app/app_profile.zi";
        banner_android_log :: #system_library "log";
        BannerAndroidLog :: (priority: s32, tag: *u8, line: *u8) -> s32 #foreign banner_android_log "__android_log_write";

        PracticeBannerProfile :: struct {
            frames: s32
            submits_ms: float64
            readbacks_ms: float64
            copies_ms: float64
        }

        #scope_file
        practice_banner_log :: (parts: []string) {
            output: [800]u8
            used: s32
            for part: parts {
                if !ProfileAppend(output[:], *used, part) { return }
            }
            tag: [16]u8
            if CopyCString("InbeBannerGpu", tag[:]) {
                unused BannerAndroidLog(4, *tag[0], *output[0])
            }
        }

        #scope_file
        practice_banner_profile_frame :: (profile: *PracticeBannerProfile, frame: SceneGpuFrame) {
            if !frame.ok { return }
            profile.frames += 1
            profile.submits_ms += frame.submit_ms
            profile.readbacks_ms += frame.readback_ms
            profile.copies_ms += frame.conversion_ms
            if profile.frames < 120 { return }
            metrics: [96]u8
            used: s32
            if ProfileAppendTwoDecimals(metrics[:], *used, profile.submits_ms / 120.0) &&
                ProfileAppend(metrics[:], *used, " readback=") &&
                ProfileAppendTwoDecimals(metrics[:], *used, profile.readbacks_ms / 120.0) &&
                ProfileAppend(metrics[:], *used, " copy=") &&
                ProfileAppendTwoDecimals(metrics[:], *used, profile.copies_ms / 120.0) {
                parts: [2]string = .["offscreen GPU average ms over 120 passes submit=", TextView(metrics[0:used])]
                practice_banner_log(parts[:])
            }
            profile.* = .{}
        }
    }

    PracticeBannerRenderer :: struct {
        banner: PracticeBannerShader
        gpu: SceneGpuContext
        clouds: [PRACTICE_CLOUD_BYTES]u8
        mask: [PRACTICE_BANNER_MASK_WIDTH * PRACTICE_BANNER_MASK_HEIGHT * 4]u8
    }

    #if OS != .WEB {
        #import "std/image"
        #import "std/thread_linux"
        BannerMutex :: #import "std/mutex_linux";

        banner_c :: #system_library "c";
        BannerConditionInit :: (condition: *void, attributes: *void) -> s32 #foreign banner_c "pthread_cond_init";
        BannerConditionWait :: (condition: *void, mutex: *void) -> s32 #foreign banner_c "pthread_cond_wait";
        BannerConditionSignal :: (condition: *void) -> s32 #foreign banner_c "pthread_cond_signal";
        BannerConditionDestroy :: (condition: *void) -> s32 #foreign banner_c "pthread_cond_destroy";

        PracticeBannerPhase :: enum { Idle; Pending; Drawing; Ready; Failed }

        PracticeBannerRequest :: struct {
            revision: u64
            tick: s64
            regions: PracticeBannerRegions
        }

        PracticeBannerWork :: struct {
            thread: Thread
            mutex: BannerMutex.Mutex
            condition: [8]u64
            stop: bool
            phase: PracticeBannerPhase
            request: PracticeBannerRequest
            renderer: PracticeBannerRenderer
            #if #defined(ANDROID_BUILD) {
                steam_gpu: SceneGpuContext
            }
            pixels: Image
            steam: Image
            steam_ready: bool
        }
    }

    PracticeBannerDrawState :: struct {
        motion: PracticeBannerMotion
        texture: Texture2D
        steam: Texture2D
        session: Session
        asset: string
        asset_generation: u64
        revision: u64
        regions: PracticeBannerRegions
        tick: s64
        asset_ready: bool
        unavailable: bool
        wants_frames: bool
        #if #defined(ANDROID_DEBUG) {
            profile_entry: float64
        }
        #if OS == .WEB {
            renderer: PracticeBannerRenderer
            steam_gpu: SceneGpuContext
        } else {
            work: PracticeBannerWork
        }
    }

    practice_banner_draw: PracticeBannerDrawState;
    practice_banner_artwork_frames: bool;

    #scope_export
    PracticeBannerDraw :: (session: Session, key: u64, asset: string, bounds: Rectangle,
        now: float64, visible: bool, reduced_motion: bool, full_sky: bool, artwork_sky: bool) -> Texture2D {
        state := *practice_banner_draw
        tick := PracticeBannerTick(*state.motion, asset, now, visible, reduced_motion)
        if tick <= 0 && (!visible || !reduced_motion || !full_sky || artwork_sky || asset.count == 0) {
            return .{}
        }
        if state.session.slot != session.slot || state.session.epoch != session.epoch {
            #if OS != .WEB {
                BitmapImageRelease(state.session, state.texture)
                BitmapImageRelease(state.session, state.steam)
            }
            state.session = session
            state.texture = .{}
            state.steam = .{}
            state.tick = 0
            if state.unavailable {
                // Retry graphics initialization on a new UI session.
                #if OS == .WEB {
                    SceneGpuRelease(*state.renderer.gpu)
                    SceneGpuRelease(*state.steam_gpu)
                } else {
                    practice_banner_stop(*state.work)
                    practice_banner_draw.work = PracticeBannerWork.{}
                }
                state.unavailable = false
                state.asset = ""
            }
        }
        if state.unavailable {
            return .{}
        }
        generation := AssetGeneration()
        if state.asset != asset || state.regions.full_sky != full_sky || state.regions.artwork_sky != artwork_sky ||
            (!state.asset_ready && state.asset_generation != generation) {
            state.asset = asset
            state.asset_generation = generation
            state.revision += 1
            state.tick = 0
            #if #defined(ANDROID_DEBUG) {
                state.profile_entry = app_profile_now()
            }
            state.regions = PracticeBannerRegionsFor(asset, artwork_sky)
            state.regions.full_sky = full_sky
            state.asset_ready = full_sky || (state.regions.sky[0].radius_x > 0.0 && AssetRead(asset).found)
            #if OS == .WEB {
                if !state.renderer.banner.program.ready {
                    practice_banner_load_clouds(*state.renderer)
                }
                if state.asset_ready && !practice_banner_configure(*state.renderer, state.regions) {
                    state.unavailable = true
                    return .{}
                }
            }
        }
        if !state.asset_ready {
            return .{}
        }
        if reduced_motion {
            // Keep the last displayed sky, or prepare one still frame for a
            // newly opened card that needs the procedural background.
            tick = ifx state.tick > 0 then state.tick else 1
        }
        foreground_steam := full_sky && state.regions.steam_opacity > 0.0
        #if OS == .WEB {
            if tick != state.tick {
                renderer := *state.renderer
                PracticeBannerShaderPhase(*renderer.banner, tick)
                if !artwork_sky {
                    PracticeBannerShaderPass(*renderer.banner, state.regions, false)
                    frame, texture := SceneGpuRenderCanvas(*renderer.gpu, *renderer.banner.scene,
                        renderer.banner.camera, PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT)
                    state.unavailable = !frame.ok || !frame.accelerated || texture.id == 0
                    state.texture = texture
                }
                if !state.unavailable && foreground_steam {
                    PracticeBannerShaderPass(*renderer.banner, state.regions, true)
                    steam_frame, steam := SceneGpuRenderCanvas(*state.steam_gpu, *renderer.banner.scene,
                        renderer.banner.camera, PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT)
                    state.steam = ifx steam_frame.ok then steam else Texture2D.{}
                    if artwork_sky && state.steam.id == 0 {
                        state.unavailable = true
                    }
                }
                state.tick = tick
            }
        } else {
            practice_banner_poll(state, tick)
        }
        if !artwork_sky && !state.unavailable && state.tick > 0 {
            BannerImage.Draw(session, BannerImage.Props.{.key = key, .bounds = bounds,
                .texture = state.texture, .fit = .ImageFitCover, .smooth = true})
        }
        state.wants_frames = !state.unavailable && (!reduced_motion || state.tick != tick)
        return ifx foreground_steam && !state.unavailable && state.tick > 0 then state.steam else Texture2D.{}
    }

    PracticeBannerDrawSteam :: (session: Session, key: u64, bounds: Rectangle, steam: Texture2D,
        crop: Rectangle = .{}) {
        if steam.id == 0 { return }
        #if #defined(ANDROID_BUILD) {
            // Position the cropped render in the same cover framing as the
            // sky and artwork, even when the card clips part of the plume.
            covered := ImageFitBounds(bounds, .{}, PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT, 2)
            if crop.width > 0.0 && crop.height > 0.0 {
                covered.width = bounds.width / crop.width
                covered.height = bounds.height / crop.height
                covered.x = bounds.x - crop.x * covered.width
                covered.y = bounds.y - crop.y * covered.height
            }
            plume := Rectangle.{covered.x + covered.width * BANNER_STEAM_LEFT,
                covered.y + covered.height * (1.0 - BANNER_STEAM_BOTTOM - BANNER_STEAM_HEIGHT),
                covered.width * BANNER_STEAM_WIDTH, covered.height * BANNER_STEAM_HEIGHT}
            clipped := RectangleIntersection(bounds, plume)
            if clipped.width <= 0.0 || clipped.height <= 0.0 { return }
            scale_x := cast(float32)steam.width / plume.width
            scale_y := cast(float32)steam.height / plume.height
            source := Rectangle.{(clipped.x - plume.x) * scale_x, (clipped.y - plume.y) * scale_y,
                clipped.width * scale_x, clipped.height * scale_y}
            BannerImage.Draw(session, BannerImage.Props.{.key = key, .bounds = clipped,
                .source = source, .texture = steam, .smooth = true})
        } else {
            width := cast(float32)steam.width
            height := cast(float32)steam.height
            source := Rectangle.{crop.x * width, crop.y * height, crop.width * width, crop.height * height}
            BannerImage.Draw(session, BannerImage.Props.{.key = key, .bounds = bounds,
                .source = source, .texture = steam, .fit = .ImageFitCover, .smooth = true})
        }
    }

    // Frame pacing consumes the request on the next frame. Navigating away
    // or suppressing motion stops requests when the banner stops drawing.
    PracticeBannerWantsFrames :: () -> bool {
        wants_frames := practice_banner_draw.wants_frames || practice_banner_artwork_frames
        practice_banner_draw.wants_frames = false
        practice_banner_artwork_frames = false
        return wants_frames
    }

    PracticeBannerArtworkFrames :: () {
        practice_banner_artwork_frames = true
    }

    PracticeBannerDrawRelease :: () {
        state := *practice_banner_draw
        #if OS == .WEB {
            SceneGpuRelease(*state.renderer.gpu)
            SceneGpuRelease(*state.steam_gpu)
            SceneFree(*state.renderer.banner.scene)
            VecFree(state.renderer.banner.sky.noise)
        } else {
            practice_banner_stop(*state.work)
            BitmapImageRelease(state.session, state.texture)
            BitmapImageRelease(state.session, state.steam)
        }
        practice_banner_draw = PracticeBannerDrawState.{}
    }

    #scope_file
    practice_banner_load_clouds :: (renderer: *PracticeBannerRenderer) {
        source := AssetRead("assets/app/practice-clouds.rg")
        if source.found && source.data.count == PRACTICE_CLOUD_BYTES {
            for index: 0..PRACTICE_CLOUD_BYTES - 1 {
                renderer.clouds[index] = source.data[index]
            }
        }
    }

    #scope_file
    practice_banner_configure :: (renderer: *PracticeBannerRenderer, regions: PracticeBannerRegions) -> bool {
        if !SceneGpuProbe(*renderer.gpu).available ||
        (!renderer.banner.program.ready && !PracticeBannerShaderInit(*renderer.banner)) {
            return false
        }
        PracticeBannerMask(regions, renderer.mask[:])
        return PracticeBannerShaderLook(*renderer.banner, regions, renderer.mask[:], renderer.clouds[:])
    }

    #if OS != .WEB {
        #scope_file
        practice_banner_upload :: (session: Session, texture: *Texture2D, image: *Image) -> bool {
            if texture.id == 0 {
                texture.* = BitmapImageCreate(session, image.width, image.height, image.pixels[:])
                return texture.id != 0
            }
            return BitmapImageUpdate(session, texture.*, image.pixels[:])
        }

        #scope_file
        practice_banner_poll :: (state: *PracticeBannerDrawState, tick: s64) {
            work := *state.work
            if !ThreadRunning(*work.thread) && !practice_banner_start(work) {
                state.unavailable = true
                return
            }
            unused BannerMutex.Lock(*work.mutex)
            phase := work.phase
            result := work.request
            if phase == .Ready {
                work.phase = .Idle
            }
            unused BannerMutex.Unlock(*work.mutex)
            if phase == .Failed {
                state.unavailable = true
                return
            }
            // Until a new request is sent, the worker is idle and the pixels
            // from a completed frame stay valid for Kryon's texture upload.
            if phase == .Ready && result.revision == state.revision && result.tick <= tick {
                #if #defined(ANDROID_DEBUG) {
                    upload_started := app_profile_now()
                }
                if !result.regions.artwork_sky {
                    state.unavailable = !practice_banner_upload(state.session, *state.texture, *work.pixels)
                }
                if result.regions.full_sky && result.regions.steam_opacity > 0.0 &&
                    (!work.steam_ready || !practice_banner_upload(state.session, *state.steam, *work.steam)) {
                    BitmapImageRelease(state.session, state.steam)
                    state.steam = .{}
                    if result.regions.artwork_sky {
                        state.unavailable = true
                    }
                }
                #if #defined(ANDROID_DEBUG) {
                    if !state.unavailable && state.tick == 0 && state.profile_entry > 0.0 {
                        metrics: [96]u8
                        used: s32
                        finished := app_profile_now()
                        if ProfileAppendTwoDecimals(metrics[:], *used, (finished - state.profile_entry) * 1000.0) &&
                            ProfileAppend(metrics[:], *used, " bitmap_copy_ms=") &&
                            ProfileAppendTwoDecimals(metrics[:], *used, (finished - upload_started) * 1000.0) {
                            parts: [4]string = .["first_banner asset=", state.asset, " entry_ms=", TextView(metrics[0:used])]
                            practice_banner_log(parts[:])
                        }
                    }
                }
                state.tick = result.tick
            }
            if !state.unavailable && state.tick != tick && (phase == .Idle || phase == .Ready) {
                unused BannerMutex.Lock(*work.mutex)
                work.request = .{state.revision, tick, state.regions}
                work.phase = .Pending
                unused BannerConditionSignal(cast(*void)*work.condition[0])
                unused BannerMutex.Unlock(*work.mutex)
            }
        }

        #scope_file
        practice_banner_start :: (work: *PracticeBannerWork) -> bool {
            practice_banner_load_clouds(*work.renderer)
            if !BannerMutex.Open(*work.mutex) {
                return false
            }
            condition := cast(*void)*work.condition[0]
            if BannerConditionInit(condition, null) != 0 {
                unused BannerMutex.Close(*work.mutex)
                return false
            }
            procedure: ThreadProcedure = practice_banner_worker
            if ThreadStart(*work.thread, procedure, cast(*void)work) {
                return true
            }
            unused BannerConditionDestroy(condition)
            unused BannerMutex.Close(*work.mutex)
            return false
        }

        #scope_file
        practice_banner_stop :: (work: *PracticeBannerWork) {
            if !ThreadRunning(*work.thread) {
                return
            }
            condition := cast(*void)*work.condition[0]
            unused BannerMutex.Lock(*work.mutex)
            work.stop = true
            unused BannerConditionSignal(condition)
            unused BannerMutex.Unlock(*work.mutex)
            ThreadWait(*work.thread)
            unused BannerConditionDestroy(condition)
            unused BannerMutex.Close(*work.mutex)
        }

        #scope_file
        practice_banner_worker :: (argument: *void) {
            work := cast(*PracticeBannerWork)argument
            renderer := *work.renderer
            condition := cast(*void)*work.condition[0]
            #if #defined(ANDROID_BUILD) {
                // Keep two equally scaled targets without reallocating the
                // sky target for a plume that covers only part of the card.
                work.pixels.width = ANDROID_BANNER_WIDTH
                work.pixels.height = ANDROID_BANNER_HEIGHT
                work.steam.width = ANDROID_STEAM_WIDTH
                work.steam.height = ANDROID_STEAM_HEIGHT
            } else {
                work.pixels.width = PRACTICE_BANNER_WIDTH
                work.pixels.height = PRACTICE_BANNER_HEIGHT
                work.steam.width = PRACTICE_BANNER_WIDTH
                work.steam.height = PRACTICE_BANNER_HEIGHT
            }
            revision: u64
            #if #defined(ANDROID_DEBUG) {
                profile: PracticeBannerProfile
                profile_enabled := app_profile_env_enabled()
                if profile_enabled {
                    caps := SceneGpuProbe(*renderer.gpu)
                    if caps.available {
                        parts: [6]string = .["offscreen GPU with CPU readback, sky=384x192 steam=176x72 vendor=",
                            TextFromCString(*caps.vendor[0]), " renderer=", TextFromCString(*caps.renderer[0]),
                            " version=", TextFromCString(*caps.version[0])]
                        practice_banner_log(parts[:])
                    } else {
                        parts: [2]string = .["unavailable: ", caps.diagnostic]
                        practice_banner_log(parts[:])
                    }
                }
            }
            // Keep the EGL context on this thread through render and release.
            // Compilation and readback cannot block tab navigation.
            unused BannerMutex.Lock(*work.mutex)
            while !work.stop {
                while work.phase != .Pending && !work.stop {
                    unused BannerConditionWait(condition, BannerMutex.Address(*work.mutex))
                }
                if work.stop {
                    break
                }
                request := work.request
                work.phase = .Drawing
                unused BannerMutex.Unlock(*work.mutex)
                ready := request.revision == revision || practice_banner_configure(renderer, request.regions)
                work.steam_ready = false
                if ready {
                    revision = request.revision
                    PracticeBannerShaderPhase(*renderer.banner, request.tick)
                    if !request.regions.artwork_sky {
                        PracticeBannerShaderPass(*renderer.banner, request.regions, false)
                        frame := SceneGpuRender(*renderer.gpu, *renderer.banner.scene,
                            renderer.banner.camera, *work.pixels)
                        ready = frame.ok && frame.accelerated
                        #if #defined(ANDROID_DEBUG) {
                            if profile_enabled { practice_banner_profile_frame(*profile, frame) }
                        }
                    }
                    if ready && request.regions.full_sky && request.regions.steam_opacity > 0.0 {
                        PracticeBannerShaderPass(*renderer.banner, request.regions, true)
                        #if #defined(ANDROID_BUILD) {
                            steam_gpu := ifx request.regions.artwork_sky then *renderer.gpu else *work.steam_gpu
                            steam_frame := SceneGpuRender(steam_gpu, *renderer.banner.scene,
                                PracticeBannerSteamCamera(renderer.banner.camera), *work.steam)
                        } else {
                            steam_frame := SceneGpuRender(*renderer.gpu, *renderer.banner.scene,
                                renderer.banner.camera, *work.steam)
                        }
                        work.steam_ready = steam_frame.ok && steam_frame.accelerated
                        if request.regions.artwork_sky {
                            ready = work.steam_ready
                        }
                        #if #defined(ANDROID_DEBUG) {
                            if profile_enabled { practice_banner_profile_frame(*profile, steam_frame) }
                        }
                    }
                }
                unused BannerMutex.Lock(*work.mutex)
                work.phase = ifx ready then .Ready else .Failed
            }
            unused BannerMutex.Unlock(*work.mutex)
            SceneGpuRelease(*renderer.gpu)
            #if #defined(ANDROID_BUILD) {
                SceneGpuRelease(*work.steam_gpu)
            }
            SceneFree(*renderer.banner.scene)
            VecFree(renderer.banner.sky.noise)
            VecFree(work.pixels.pixels)
            VecFree(work.steam.pixels)
        }
    }
} else {
    #import "kryon/drawing_props"
    #import "kryon/geometry"
    #import "kryon/session"

    #scope_export
    PracticeBannerDrawRelease :: () {}
    PracticeBannerWantsFrames :: () -> bool { return false }
    PracticeBannerArtworkFrames :: () {}

    PracticeBannerDrawSteam :: (session: Session, key: u64, bounds: Rectangle, steam: Texture2D,
        crop: Rectangle = .{}) {
        unused session
        unused key
        unused bounds
        unused steam
        unused crop
    }

    PracticeBannerDraw :: (session: Session, key: u64, asset: string, bounds: Rectangle,
        now: float64, visible: bool, reduced_motion: bool, full_sky: bool, artwork_sky: bool) -> Texture2D {
        unused session
        unused key
        unused asset
        unused bounds
        unused now
        unused visible
        unused reduced_motion
        unused full_sky
        unused artwork_sky
        return .{}
    }
}
