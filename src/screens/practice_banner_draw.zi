// Draws a Practice banner in layers: the rendered sky, the painted land, the
// painted figure and, over the ice bath, rendered vapour. The sky and the
// vapour are painted from their state several times a second and shown
// through the standard Image widget. The paintings themselves never move.
#import "kryon/bitmap_image"
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/session"
#import "std/vec"
#import, file "../app/app_clock_host.zi";
#import, file "../app/assets.zi";
#import, file "practice_banner_motion.zi";
#import, file "practice_banner_scene.zi";
#import, file "practice_banner_sky.zi";
#import, file "practice_banner_sky_paint.zi";
#import, file "practice_banner_steam.zi";
BannerBox :: #import "kryon/box";
BannerImage :: #import "kryon/image";
BannerLayout :: #import "kryon/layout";

// A rendered layer holds one pixel for every two on screen, up to a width.
// Phones paint fewer pixels, less often.
#if #defined(ANDROID_BUILD) {
    PRACTICE_BANNER_RENDER_WIDTH :: 256
    PRACTICE_BANNER_PAINT_TICKS :: 3
} else {
    PRACTICE_BANNER_RENDER_WIDTH :: 448
    PRACTICE_BANNER_PAINT_TICKS :: 2
}

// Everything one painting needs, so it can be painted away from the frame.
PracticeBannerRequest :: struct {
    revision: u64
    step: s64
    minute: s64
    sky: PracticeSkyScenery
    steam: PracticeSteamSource
    clock: PracticeSkyClock
    seconds: float64
    view: PracticeBannerView
    sky_view: PracticeBannerView
    sky_width: s32
    sky_height: s32
    // A zero width means the banner has no vapour in view.
    steam_view: PracticeBannerView
    steam_width: s32
    steam_height: s32
    // The air under the clouds changes only with the clock or the size.
    air: bool
}

PracticeBannerPhase :: enum { Idle; Pending; Painting; Ready; Failed }

#if (#defined(DESKTOP_HOST) && !#defined(_WIN32)) || #defined(ANDROID_BUILD) {
    #import "std/thread_linux"
    BannerMutex :: #import "std/mutex_linux";

    banner_c :: #system_library "c";
    BannerConditionInit :: (condition: *void, attributes: *void) -> s32 #foreign banner_c "pthread_cond_init";
    BannerConditionWait :: (condition: *void, mutex: *void) -> s32 #foreign banner_c "pthread_cond_wait";
    BannerConditionSignal :: (condition: *void) -> s32 #foreign banner_c "pthread_cond_signal";
    BannerConditionDestroy :: (condition: *void) -> s32 #foreign banner_c "pthread_cond_destroy";

    // A painter thread keeps the pixel work out of the frame: the frame only
    // uploads a finished picture.
    PracticeBannerWork :: struct {
        phase: PracticeBannerPhase
        request: PracticeBannerRequest
        air: Vec(u8)
        sky: Vec(u8)
        steam: Vec(u8)
        thread: Thread
        mutex: BannerMutex.Mutex
        condition: [8]u64
        stop: bool
    }
} else {
    // Without threads the picture is painted when it is asked for.
    PracticeBannerWork :: struct {
        phase: PracticeBannerPhase
        request: PracticeBannerRequest
        air: Vec(u8)
        sky: Vec(u8)
        steam: Vec(u8)
    }
}

PracticeBannerDrawState :: struct {
    motion: PracticeBannerMotion
    session: Session
    asset: string
    asset_generation: u64
    scene: PracticeBannerScene
    layered: bool
    tick: s64
    // Seconds since local midnight when the app's frame clock read zero, so
    // the clouds and the vapour carry on from the time of day.
    day_started: float64
    day_known: bool
    // What was last asked of the painter, and whether its air is still right.
    asked: PracticeBannerRequest
    air_painted: bool
    // The pictures on screen. `shown` is false until this banner has one.
    sky: Texture2D
    steam: Texture2D
    shown: bool
    wants_frames: bool
    work: PracticeBannerWork
}

practice_banner_draw: PracticeBannerDrawState;

// Paints REQUEST into WORK's pixels.
#scope_file
practice_banner_paint :: (work: *PracticeBannerWork, request: PracticeBannerRequest) -> bool {
    count := cast(s64)request.sky_width * cast(s64)request.sky_height * 4
    if !VecResize(work.sky, count) || !VecResize(work.air, count) {
        return false
    }
    sky := PracticeSkyAt(request.sky, request.clock, request.seconds, request.view)
    if request.air {
        PracticeSkyPaintAir(*sky, .{request.sky_view, request.sky_width, request.sky_height, work.air[:]})
    }
    for at: 0..count - 1 {
        work.sky[at] = work.air[at]
    }
    PracticeSkyPaintOver(*sky, .{request.sky_view, request.sky_width, request.sky_height, work.sky[:]})
    if request.steam_width > 0 {
        if !VecResize(work.steam, cast(s64)request.steam_width * cast(s64)request.steam_height * 4) {
            return false
        }
        PracticeSteamPaint(request.steam, request.seconds,
            .{request.steam_view, request.steam_width, request.steam_height, work.steam[:]})
    }
    return true
}

#if (#defined(DESKTOP_HOST) && !#defined(_WIN32)) || #defined(ANDROID_BUILD) {
    #scope_file
    practice_banner_painter :: (argument: *void) {
        work := cast(*PracticeBannerWork)argument
        condition := cast(*void)*work.condition[0]
        unused BannerMutex.Lock(*work.mutex)
        while !work.stop {
            while work.phase != .Pending && !work.stop {
                unused BannerConditionWait(condition, BannerMutex.Address(*work.mutex))
            }
            if work.stop {
                break
            }
            request := work.request
            work.phase = .Painting
            unused BannerMutex.Unlock(*work.mutex)
            painted := practice_banner_paint(work, request)
            unused BannerMutex.Lock(*work.mutex)
            work.phase = ifx painted then .Ready else .Failed
        }
        unused BannerMutex.Unlock(*work.mutex)
    }

    #scope_file
    practice_banner_start :: (work: *PracticeBannerWork) -> bool {
        if ThreadRunning(*work.thread) {
            return true
        }
        if !BannerMutex.Open(*work.mutex) {
            return false
        }
        condition := cast(*void)*work.condition[0]
        if BannerConditionInit(condition, null) != 0 {
            unused BannerMutex.Close(*work.mutex)
            return false
        }
        procedure: ThreadProcedure = practice_banner_painter
        if ThreadStart(*work.thread, procedure, cast(*void)work) {
            return true
        }
        unused BannerConditionDestroy(condition)
        unused BannerMutex.Close(*work.mutex)
        return false
    }

    // The painter's phase. A finished picture is handed over once: until the
    // next request its pixels stay untouched for the upload.
    #scope_file
    practice_banner_phase :: (work: *PracticeBannerWork) -> PracticeBannerPhase {
        if !ThreadRunning(*work.thread) {
            return .Idle
        }
        unused BannerMutex.Lock(*work.mutex)
        phase := work.phase
        if phase == .Ready || phase == .Failed {
            work.phase = .Idle
        }
        unused BannerMutex.Unlock(*work.mutex)
        return phase
    }

    #scope_file
    practice_banner_submit :: (work: *PracticeBannerWork, request: PracticeBannerRequest) -> bool {
        if !practice_banner_start(work) {
            return false
        }
        unused BannerMutex.Lock(*work.mutex)
        work.request = request
        work.phase = .Pending
        unused BannerConditionSignal(cast(*void)*work.condition[0])
        unused BannerMutex.Unlock(*work.mutex)
        return true
    }

    #scope_file
    practice_banner_stop :: (work: *PracticeBannerWork) {
        if !ThreadRunning(*work.thread) {
            return
        }
        condition := cast(*void)*work.condition[0]
        unused BannerMutex.Lock(*work.mutex)
        work.stop = true
        unused BannerConditionSignal(condition)
        unused BannerMutex.Unlock(*work.mutex)
        ThreadWait(*work.thread)
        unused BannerConditionDestroy(condition)
        unused BannerMutex.Close(*work.mutex)
    }
} else {
    #scope_file
    practice_banner_phase :: (work: *PracticeBannerWork) -> PracticeBannerPhase {
        phase := work.phase
        work.phase = .Idle
        return phase
    }

    #scope_file
    practice_banner_submit :: (work: *PracticeBannerWork, request: PracticeBannerRequest) -> bool {
        work.request = request
        work.phase = ifx practice_banner_paint(work, request) then .Ready else .Failed
        return true
    }

    #scope_file
    practice_banner_stop :: (work: *PracticeBannerWork) {
        unused work
    }
}

// Shows PIXELS through TEXTURE, replacing a texture of another size.
#scope_file
practice_banner_upload :: (session: Session, texture: *Texture2D, width: s32, height: s32, pixels: []u8) -> bool {
    if texture.id != 0 && (texture.width != width || texture.height != height) {
        BitmapImageRelease(session, texture.*)
        texture.* = .{}
    }
    if texture.id == 0 {
        texture.* = BitmapImageCreate(session, width, height, pixels)
        return texture.id != 0
    }
    return BitmapImageUpdate(session, texture.*, pixels)
}

// One rendered pixel for every two on screen, in steps of sixteen so that a
// window being resized does not ask for a new size on every frame.
#scope_file
practice_banner_render_width :: (screen: float32) -> s32 {
    width := (cast(s32)(screen * 0.5) + 15) / 16 * 16
    if width < 32 {
        return 32
    }
    return ifx width > PRACTICE_BANNER_RENDER_WIDTH then PRACTICE_BANNER_RENDER_WIDTH else width
}

// The painting is twice as wide as it is tall.
#scope_file
practice_banner_render_height :: (width: s32, view: PracticeBannerView) -> s32 {
    height := cast(s32)(cast(float64)width * view.height / (2.0 * view.width) + 0.5)
    return ifx height < 8 then 8 else height
}

// What the painter should paint now for the banner over BOUNDS.
#scope_file
practice_banner_plan :: (state: *PracticeBannerDrawState, bounds: Rectangle, now: float64) -> PracticeBannerRequest {
    request: PracticeBannerRequest
    request.sky = state.scene.sky
    request.steam = state.scene.steam
    request.view = PracticeBannerViewFor(bounds.width, bounds.height)
    request.sky_view = PracticeBannerSkyView(request.view, state.scene.sky)
    request.sky_width = practice_banner_render_width(bounds.width)
    request.sky_height = practice_banner_render_height(request.sky_width, request.sky_view)
    if state.scene.steam.count > 0 {
        // Only the vapour inside the banner is painted.
        request.steam_view = PracticeBannerViewOverlap(request.view, PracticeSteamView(state.scene.steam))
        if request.steam_view.width > 0.0 && request.steam_view.height > 0.0 {
            request.steam_width = practice_banner_render_width(
                bounds.width * cast(float32)(request.steam_view.width / request.view.width))
            request.steam_height = practice_banner_render_height(request.steam_width, request.steam_view)
        }
    }
    local := LocalNowHost()
    request.minute = cast(s64)local.hour * 60 + cast(s64)local.minute
    request.clock = .{cast(float64)request.minute / 60.0 + cast(float64)local.second / 3600.0,
        PracticeSkyMoonAge(cast(float64)UnixNowHost())}
    // A still banner keeps its step and its clouds where they are; only the
    // clock's colours and light follow, once a minute.
    request.seconds = state.asked.seconds
    request.step = state.asked.step
    if state.tick > 0 || !state.shown {
        request.seconds = state.day_started + now
    }
    if state.tick > 0 {
        request.step = cast(s64)(now * PRACTICE_BANNER_HZ) / PRACTICE_BANNER_PAINT_TICKS
    }
    request.revision = state.asked.revision
    if request.sky_width != state.asked.sky_width || request.sky_height != state.asked.sky_height ||
    request.steam_width != state.asked.steam_width || request.steam_height != state.asked.steam_height {
        request.revision += 1
    }
    request.air = !state.air_painted || request.revision != state.asked.revision ||
    request.minute != state.asked.minute
    return request
}

// Takes a finished picture from the painter and asks for the next one.
#scope_file
practice_banner_update :: (state: *PracticeBannerDrawState, session: Session, bounds: Rectangle, now: float64) {
    work := *state.work
    phase := practice_banner_phase(work)
    if phase == .Ready && work.request.revision == state.asked.revision {
        finished := work.request
        state.shown = practice_banner_upload(session, *state.sky, finished.sky_width, finished.sky_height, work.sky[:])
        if finished.steam_width > 0 {
            unused practice_banner_upload(session, *state.steam, finished.steam_width, finished.steam_height,
                work.steam[:])
        }
        state.air_painted = true
    }
    if phase == .Pending || phase == .Painting {
        return
    }
    request := practice_banner_plan(state, bounds, now)
    if state.shown && state.air_painted && request.revision == state.asked.revision &&
    request.step == state.asked.step && request.minute == state.asked.minute {
        return
    }
    if practice_banner_submit(work, request) {
        state.asked = request
    }
}

#scope_file
practice_banner_air :: (color: PracticeSkyColor) -> Color {
    return .{cast(u8)color.r, cast(u8)color.g, cast(u8)color.b, 255}
}

// Draws the sky and the painted land of ASSET's banner over BOUNDS. False
// means nothing was drawn: the banner is hidden or has no separate layers,
// and shows its whole painting.
#scope_export
PracticeBannerDrawBack :: (session: Session, asset: string, bounds: Rectangle, now: float64,
    visible: bool, reduced_motion: bool) -> bool {
    state := *practice_banner_draw
    state.tick = PracticeBannerTick(*state.motion, asset, now, visible, reduced_motion)
    if state.session.slot != session.slot || state.session.epoch != session.epoch {
        BitmapImageRelease(state.session, state.sky)
        BitmapImageRelease(state.session, state.steam)
        state.sky = .{}
        state.steam = .{}
        state.shown = false
        state.session = session
    }
    generation := AssetGeneration()
    if state.asset != asset || state.asset_generation != generation {
        state.asset = asset
        state.asset_generation = generation
        state.scene = PracticeBannerSceneFor(asset)
        state.layered = state.scene.landscape.count > 0 && AssetRead(state.scene.landscape).found &&
        AssetRead(state.scene.character).found
        // Another banner has another sky: nothing painted so far fits it.
        state.asked.revision += 1
        state.air_painted = false
        state.shown = false
    }
    if !state.layered || !visible {
        return false
    }
    if !state.day_known {
        local := LocalNowHost()
        state.day_started = cast(float64)(cast(s64)local.hour * 3600 + cast(s64)local.minute * 60 +
            cast(s64)local.second) - now
        state.day_known = true
    }
    practice_banner_update(state, session, bounds, now)
    // Frames keep coming while the sky moves or its first picture is awaited.
    state.wants_frames = state.tick > 0 || !state.shown
    view := PracticeBannerViewFor(bounds.width, bounds.height)
    sky_view := PracticeBannerSkyView(view, state.scene.sky)
    sky_bounds := Rectangle.{bounds.x, bounds.y, bounds.width,
        bounds.height * cast(float32)(sky_view.height / view.height)}
    if state.shown {
        BannerImage.Draw(session, BannerImage.Props.{.key = BannerLayout.KeyHash("practice/banner-live-sky"),
                .bounds = sky_bounds, .texture = state.sky, .smooth = true})
    } else {
        // Until the first picture arrives, the air's two colours stand in.
        sky := PracticeSkyAt(state.scene.sky, state.asked.clock, state.asked.seconds, view)
        BannerBox.Draw(session, BannerBox.Props.{.key = BannerLayout.KeyHash("practice/banner-air-waiting"),
                .bounds = sky_bounds, .fill = practice_banner_air(sky.zenith),
                .fill_bottom = practice_banner_air(sky.horizon), .has_fill_bottom = true})
    }
    BannerImage.Draw(session, BannerImage.Props.{.key = BannerLayout.KeyHash("practice/banner-landscape"),
            .bounds = bounds, .asset_path = state.scene.landscape, .fit = .ImageFitCover, .tint = 0xffffffff})
    return true
}

// Draws the painted figure and, over the ice bath, the vapour in front of it.
// Call it after PracticeBannerDrawBack returned true.
PracticeBannerDrawFront :: (session: Session, bounds: Rectangle) {
    state := *practice_banner_draw
    BannerImage.Draw(session, BannerImage.Props.{.key = BannerLayout.KeyHash("practice/banner-character"),
            .bounds = bounds, .asset_path = state.scene.character, .fit = .ImageFitCover, .tint = 0xffffffff})
    if state.scene.steam.count == 0 || state.steam.id == 0 {
        return
    }
    view := PracticeBannerViewFor(bounds.width, bounds.height)
    shown := PracticeBannerViewOverlap(view, PracticeSteamView(state.scene.steam))
    if shown.width <= 0.0 || shown.height <= 0.0 {
        return
    }
    BannerImage.Draw(session, BannerImage.Props.{.key = BannerLayout.KeyHash("practice/banner-steam"),
            .bounds = .{bounds.x + bounds.width * cast(float32)((shown.left - view.left) / view.width),
                bounds.y + bounds.height * cast(float32)((shown.top - view.top) / view.height),
                bounds.width * cast(float32)(shown.width / view.width),
                bounds.height * cast(float32)(shown.height / view.height)},
            .texture = state.steam, .smooth = true})
}

// The banner's motion tick: zero while it is hidden or motion is reduced.
PracticeBannerDrawTick :: () -> s64 {
    return practice_banner_draw.tick
}

// Frame pacing consumes the request on the next frame. Navigating away or
// reducing motion stops the requests when the banner stops moving.
PracticeBannerWantsFrames :: () -> bool {
    wants_frames := practice_banner_draw.wants_frames
    practice_banner_draw.wants_frames = false
    return wants_frames
}

PracticeBannerDrawRelease :: () {
    state := *practice_banner_draw
    practice_banner_stop(*state.work)
    BitmapImageRelease(state.session, state.sky)
    BitmapImageRelease(state.session, state.steam)
    VecFree(state.work.air)
    VecFree(state.work.sky)
    VecFree(state.work.steam)
    practice_banner_draw = PracticeBannerDrawState.{}
}
