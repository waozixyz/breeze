#import "lumi_settings_ui"
// Lumi's own settings page, opened by the wrench in Lumi's title bar and
// left with Back to the chat: whether the person agreed to Lumi's online
// terms, and where Lumi's AI requests go: Inner Breeze's server, or their
// own OpenAI-compatible provider with its base URL, API key and model. The
// terms themselves are shown in Lumi, where they are agreed to. The key is
// written to this device's settings only; it is never shown again, never
// synced and never handed to Lumi's package.
#import "geometry"
#import "session"
#import "text"
Button :: #import "kryon/button";
Dropdown :: #import "kryon/dropdown";
Layout :: #import "kryon/layout";
Scroll :: #import "kryon/scroll";
SegmentedControl :: #import "kryon/segmented_control";
Text :: #import "kryon/text";
TextField :: #import "kryon/text_field";
TitleBar :: #import "kryon/title_bar";
#import "text_input"
#import "control_props"
#import "byte_text_linux"
#import "text_buffer"
#import "keys"
#import "drawing_props"
#import "kryon/tree"
#import, file "../app/app_types.zi";
#import, file "../app/locale.zi";
#import, file "../app/metrics.zi";
#import, file "../app/text_buffers.zi";
#import, file "../app/app_nav_state.zi";
#import, file "../platform/text_input_host.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../apps/lumi_connection.zi";
#import, file "lumi_screen.zi";
#import, file "settings/settings_ui.zi";

using Text.Wrap;
using ButtonTone;
using ButtonEmphasis;

LumiSettingsField :: struct {
    value: [LUMI_PROVIDER_URL_MAX]u8
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    composition: CompositionState
    preedit: [4096]u8
}

// Widget results borrow current value/input bytes. Keep the pending edit and
// composition in owned storage before changing the field's backing buffers.
LumiSettingsFieldUpdate :: struct {
    replacement: [LUMI_PROVIDER_URL_MAX]u8
    preedit: [4096]u8
    start: s32
    end: s32
    changed: bool
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    composition_active: bool
    composition_length: s32
    composition_cursor: s32
    composition_selection: s32
    valid: bool
}

LumiSettingsObserveField :: (result: TextField.Result) -> LumiSettingsFieldUpdate {
    update: LumiSettingsFieldUpdate
    if result.composition.text.count > update.preedit.count { return update }
    update.start = result.edit.start
    update.end = result.edit.end
    update.changed = result.edit.changed && AppCopyText(result.edit.replacement, update.replacement[:])
    update.cursor = result.cursor
    update.anchor = result.anchor
    update.scroll_x = result.scroll_x
    update.focused = result.focused
    update.composition_active = result.composition.active
    update.composition_length = cast(s32)result.composition.text.count
    update.composition_cursor = result.composition.cursor
    update.composition_selection = result.composition.selection_length
    for byte, index: result.composition.text { update.preedit[index] = byte }
    update.valid = true
    return update
}

LumiSettingsApplyField :: (field: *LumiSettingsField, update: *LumiSettingsFieldUpdate) {
    if !update.valid { return }
    field.composition = CompositionState.{}
    if update.changed {
        unused AppReplaceText(field.value[:], update.start, update.end, TextUntilNul(update.replacement[:]))
    }
    field.cursor = update.cursor
    field.anchor = update.anchor
    field.scroll_x = update.scroll_x
    field.focused = update.focused
    SecureWipe(*field.preedit[0], 4096)
    field.preedit = update.preedit
    field.composition = CompositionState.{
        .active = update.composition_active,
        .text = TextView(field.preedit[0:update.composition_length]),
        .cursor = update.composition_cursor,
        .selection_length = update.composition_selection}
}

lumi_settings_url: LumiSettingsField;
lumi_settings_key: LumiSettingsField;
lumi_settings_model: LumiSettingsField;
lumi_settings_loaded: bool;
// 1 saved, 2 the address or model does not work.
lumi_settings_notice: s32;

SETTINGS_LUMI_FIELD :: 48
SETTINGS_LUMI_LABEL :: 26

lumi_settings_text_height :: (text: string, width: s32) -> s32 {
    prepared := Text.PrepareText(Text.Props.{.text = text, .size = AppFontSize(),
            .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
            .wrap = cast(Text.Wrap)TextWrapAuto}, Text.DefaultTextFace())
    return cast(s32)prepared.bounds.height + AppScale(12)
}

lumi_settings_status :: () -> string {
    return LocaleText(ifx LumiAiAgreed() && LumiNodeAgreed() then "lumi_settings_agreed" else "lumi_settings_not_agreed")
}

lumi_settings_terms_body :: (width: s32) -> s32 {
    return lumi_settings_text_height(lumi_settings_status(), width) + AppScale(56)
}

lumi_settings_connection_body :: (width: s32) -> s32 {
    height := AppScale(54)
    if !LumiOwnProviderSelected() {
        return height
    }
    height += AppScale((SETTINGS_LUMI_LABEL + SETTINGS_LUMI_FIELD + 10) * 3)
    height += lumi_settings_text_height(LocaleText("lumi_settings_own_note"), width)
    if lumi_settings_notice != 0 {
        height += lumi_settings_text_height(LocaleText(ifx lumi_settings_notice == 1 then
            "lumi_settings_saved" else "lumi_settings_invalid"), width)
    }
    return height + AppScale(56)
}

lumi_settings_content_height :: (width: s32) -> s32 {
    inner := settings_section_inner_width(width)
    terms_body := lumi_settings_terms_body(inner)
    terms_height := settings_section_height(LocaleText("lumi_settings_terms"), terms_body)
    connection_body := lumi_settings_connection_body(inner)
    return terms_height +
    settings_section_height(LocaleText("lumi_settings_connection"), connection_body)
}

lumi_settings_load :: () {
    if lumi_settings_loaded {
        return
    }
    lumi_settings_loaded = true
    lumi_settings_url = LumiSettingsField.{}
    lumi_settings_model = LumiSettingsField.{}
    lumi_settings_key = LumiSettingsField.{}
    unused AppCopyText(storage_get_setting_text(LumiProviderUrlSetting), lumi_settings_url.value[:])
    unused AppCopyText(storage_get_setting_text(LumiProviderModelSetting), lumi_settings_model.value[:])
    lumi_settings_url.cursor = cast(s32)TextUntilNul(lumi_settings_url.value[:]).count
    lumi_settings_model.cursor = cast(s32)TextUntilNul(lumi_settings_model.value[:]).count
}

// A labelled one-line field. The key's field is secure: it shows dots and
// never copies its text out.


// Saves the address and model, and a newly typed key, when they work.
lumi_settings_save :: () {
    url: [LUMI_PROVIDER_URL_MAX]u8
    model: [LUMI_PROVIDER_MODEL_MAX]u8
    unused AppCopyText(LumiLineTrimmed(TextUntilNul(lumi_settings_url.value[:])), url[:])
    unused AppCopyText(LumiLineTrimmed(TextUntilNul(lumi_settings_model.value[:])), model[:])
    {
        key := AppTextFromCString(*lumi_settings_key.value[0], LUMI_PROVIDER_URL_MAX)
        if !LumiProviderUrlValid(TextUntilNul(url[:])) || !LumiProviderModelValid(TextUntilNul(model[:])) ||
        !LumiProviderKeyValid(key) {
            lumi_settings_notice = 2
            return
        }
        storage_settings_begin_write()
        storage_set_setting_text(LumiProviderUrlSetting, TextUntilNul(url[:]))
        storage_set_setting_text(LumiProviderModelSetting, TextUntilNul(model[:]))
        if key.count > 0 {
            storage_set_setting_text(LumiProviderKeySetting, key)
        }
        storage_settings_end_write()
    }
    SecureWipe(*lumi_settings_key.value[0], LUMI_PROVIDER_URL_MAX)
    SecureWipe(*lumi_settings_key.preedit[0], 4096)
    lumi_settings_key = LumiSettingsField.{}
    lumi_settings_notice = 1
}

LumiLineTrimmed :: (text: string) -> string {
    start: s64 = 0
    end := text.count
    while start < end && text[start] <= cast(u8)32 {
        start += 1
    }
    while end > start && text[end - 1] <= cast(u8)32 {
        end -= 1
    }
    return text[start:end]
}





LUMI_SETTINGS_TITLE :: 52

// The page: Lumi's title bar with Back, then its settings in a scroll.
// Returns true when Back was pressed.


LumiSettingsNewMask :: () -> [LUMI_PROVIDER_URL_MAX]u8 {
    result: [LUMI_PROVIDER_URL_MAX]u8
    return result
}

LumiSettingsNewTyped :: () -> [256]u8 {
    result: [256]u8
    return result
}

LumiSettingsNewOptions :: () -> [1]Dropdown.Option {
    result: [1]Dropdown.Option
    return result
}
