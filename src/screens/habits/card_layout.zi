// Cards keep their row-major order, but each column grows independently.
// Only cards below the selection in its own column need extra space.
HabitCardOffset :: (index: s32, selected: s32, columns: s32,
    collapsed_height: s32, expanded_height: s32, gap: s32) -> s32 {
    if columns < 1 {
        columns = 1
    }
    offset := (index / columns) * (collapsed_height + gap)
    if selected >= 0 && index > selected &&
    index % columns == selected % columns {
        offset += expanded_height - collapsed_height
    }
    return offset
}
