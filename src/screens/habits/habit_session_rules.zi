// Round durations entered by the session editor are whole seconds.
HabitSessionSeconds :: struct {
    valid: bool
    seconds: s32
}

#program_export
habit_session_parse_seconds :: (value: string) -> HabitSessionSeconds {
    invalid: HabitSessionSeconds = .{}
    if value.count == 0 || value.count > 3 { return invalid }
    result: s32 = 0
    index: s64 = 0
    while index < cast(s64)value.count {
        digit := value[index]
        if digit < #char "0" || digit > #char "9" { return invalid }
        result = result * 10 + cast(s32)(digit - #char "0")
        index += 1
    }
    if result == 0 { return invalid }
    return HabitSessionSeconds.{.valid = true, .seconds = result}
}
