// The habit table has a name column and then seven day columns. The days
// share the width the name column leaves, within their limits, and the name
// column takes the rest.
HabitTableDayWidth :: (width: s32, name_min: s32, day_min: s32,
    day_max: s32) -> s32 {
    day := (width - name_min) / 7
    if day > day_max {
        day = day_max
    }
    if day < day_min {
        day = day_min
    }
    return day
}

// Rows keep their order; only the rows below an open row move down by its
// details.
HabitRowOffset :: (position: s32, open: s32, row_height: s32,
    detail_height: s32) -> s32 {
    offset := position * row_height
    if open >= 0 && position > open {
        offset += detail_height
    }
    return offset
}

// The table's columns for its inner width.
HabitTableLayout :: struct {
    // The column before the days: an icon and a name, or the icon alone.
    name_width: s32
    day_width: s32
    // Today and the days before it that fit, at most seven.
    days: s32
    names: bool
}

// With room for the preferred name column and seven days, rows show their
// names. A name column narrower than name_min shows icons only, in
// icon_column; and when even seven days do not fit then, fewer past days
// are shown. The columns never take more than the width.
HabitTableLayoutFor :: (width: s32, name_preferred: s32, name_min: s32,
    icon_column: s32, day_min: s32, day_max: s32) -> HabitTableLayout {
    layout: HabitTableLayout
    layout.days = 7
    layout.names = true
    layout.day_width = HabitTableDayWidth(width, name_preferred, day_min,
        day_max)
    layout.name_width = width - layout.day_width * 7
    if layout.name_width >= name_min {
        return layout
    }
    layout.names = false
    space := width - icon_column
    days := space / day_min
    if days > 7 {
        days = 7
    }
    if days < 1 {
        days = 1
    }
    layout.days = days
    layout.day_width = space / days
    if layout.day_width > day_max {
        layout.day_width = day_max
    }
    if layout.day_width < 1 {
        layout.day_width = 1
    }
    layout.name_width = width - layout.day_width * days
    return layout
}
