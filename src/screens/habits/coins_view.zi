// How coins look wherever Habits shows them: a gold coin beside the
// amount, and the shop's mark. The icons are MingCute's (Apache-2.0).
#import "geometry"
#import "drawing_props"
#import "session"
#import "svg_icon"
#import "text_props"
#import "text_align"
#import "text_widget"
#import, file "../../habits/habit_types.zi";
#import, file "../../habits/habit_coins.zi";
#import, file "../../app/text_buffers.zi";
#import, file "../../app/locale.zi";
#import, file "../../app/metrics.zi";
#import, file "../../app/cards.zi";
CoinIcon :: #import "mingcute/mingcute_filled_copper_coin";
ShopIcon :: #import "mingcute/mingcute_regular_shop";

using TextAlign;
using TextWrap;

// The shop's mark, MingCute's shop.
HabitShopShape :: () -> string {
    return ShopIcon.Shape
}

// A warm gold that reads on light and dark themes alike.
HabitCoinColor :: () -> Color {
    return Color.{.r = 226, .g = 168, .b = 48, .a = 255}
}

HabitCoinIcon :: (session: Session, bounds: Rectangle) {
    PaintSvgIcon(session, -1, CoinIcon.Shape, bounds, HabitCoinColor())
}

// The width a coin and its amount take at a font size.
HabitCoinAmountWidth :: (amount: string, font: s32) -> s32 {
    return AppTextLineHeight(font) + AppScale(6) + AppTextWidth(amount, font)
}

// A coin and its amount, centred on the bounds' height from their left.
HabitCoinAmount :: (session: Session, amount: string, bounds: Rectangle,
    font: s32, strong: bool) {
    size := cast(float32)AppTextLineHeight(font)
    HabitCoinIcon(session, Rectangle.{bounds.x,
            bounds.y + (bounds.height - size) * 0.5, size, size})
    whole := StrongWhole(amount)
    label: TextProps
    label.bounds = Rectangle.{bounds.x + size + cast(float32)AppScale(6),
        bounds.y, bounds.width - size - cast(float32)AppScale(6),
        bounds.height}
    label.text = amount
    label.font = font
    if strong {
        label.strong = whole[:]
    }
    label.vertical_align = cast(TextAlign)TextAlignCenter
    label.wrap = cast(TextWrap)TextWrapNone
    Text(session, label)
}

// What a done day of a habit this hard earns, in words.
HabitDifficultyEarns :: (difficulty: s32) -> string {
    if difficulty == HABIT_DIFFICULTY_EASY {
        return LocaleText("habit_difficulty_earns_easy")
    }
    if difficulty == HABIT_DIFFICULTY_HARD {
        return LocaleText("habit_difficulty_earns_hard")
    }
    if difficulty == HABIT_DIFFICULTY_VERY_HARD {
        return LocaleText("habit_difficulty_earns_very_hard")
    }
    return LocaleText("habit_difficulty_earns_medium")
}
