// The habit shop's host side. Habits draws the shop (apps/habits/
// shop_view.zi); the host keeps the coins, the rewards and the form's
// state, gives them to the page each frame, and saves, deletes or buys a
// reward when the page asks, checking each request against what is stored.
#import "geometry"
#import "session"
#import "byte_text_linux"
#import "bundle_host"
#import "hosted_values"
#import "widget_host"
#import "drawing_props"
#import "box_props"
#import "date_time"
#import, file "../../app/app_types.zi";
#import, file "../../app/app_modal_state.zi";
#import, file "../../app/modal_rules.zi";
#import, file "../../app/locale.zi";
#import, file "../../app/metrics.zi";
#import, file "../../app/cards.zi";
#import, file "../../app/text_buffers.zi";
#import, file "../../habits/habit_types.zi";
#import, file "../../habits/habit_icons.zi";
#import, file "../../habits/habit_coins.zi";
#import, file "../../storage/db.zi";
#import, file "../../storage/storage_settings.zi";
#import, file "../../storage/storage_habit_wallet.zi";
#import, file "../../platform/raylib_text_input.zi";
#import, file "../../apps/habits_ui_types.zi";
#import, file "../../apps/habits_types.zi";
#import, file "../../apps/app_codec.zi";
#import, file "../../apps/hosted_assets.zi";
#import, file "../../apps/module_host.zi";

using ModalType;
using HostValueKind;

HABIT_SHOP_DEFAULT_PRICE :: 5

habit_shop_frame: HabitsShopFrame;
habit_shop_frame_codec: WidgetHabitsShopFrameCodec;
habit_shop_reward_codec: WidgetHabitsShopRewardCodec;
habit_shop_activity_codec: WidgetHabitsShopActivityCodec;

// Reads the coins and rewards again when the stored data changed, as
// after a done day, a purchase or a sync.
HabitShopRefresh :: (app: *InnerBreeze) {
    shop := *app.habit_shop
    revision := storage_data_revision()
    if shop.loaded && shop.revision == revision {
        return
    }
    shop.loaded = true
    shop.revision = revision
    shop.halves = storage_habit_wallet_halves()
    shop.borrow_limit = storage_get_setting_int("habit_shop_borrow_limit", 0)
    shop.reward_count = storage_habit_rewards_load(shop.rewards[:])
    shop.activity_count = storage_habit_activity_load(shop.activity[:])
}

// An Activity line's day, short: Today, or the weekday and the day of the
// month, as "Mon 19".
HabitShopDay :: (app: *InnerBreeze, local_date: s32) -> string {
    local := LocalNow()
    if local.valid && local_date == local.year * 10000 + local.month * 100 + local.day {
        return LocaleText("habits_today")
    }
    year := local_date / 10000
    month := (local_date / 100) % 100
    day := local_date % 100
    if month < 1 || month > 12 || day < 1 || day > 31 {
        return ""
    }
    // Sakamoto's weekday, 0 for Sunday.
    offsets: [12]s32 = .[0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    y := ifx month < 3 then year - 1 else year
    weekday := (y + y / 4 - y / 100 + y / 400 + offsets[month - 1] + day) % 7
    keys: [7]string = .["habit_day_sun", "habit_day_mon", "habit_day_tue", "habit_day_wed",
    "habit_day_thu", "habit_day_fri", "habit_day_sat"]
    label: [48]u8
    if !AppCopyText(LocaleText(keys[weekday]), label[:]) || !AppAppendText(" ", label[:]) {
        return ""
    }
    number: [8]u8
    unused AppFormatS32(day, number[:])
    unused AppAppendText(AppTextFromCString(*number[0], 8), label[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*label[0], 48))
}

// The coins to spend, in half coins.
HabitShopBalance :: (app: *InnerBreeze) -> s64 {
    HabitShopRefresh(app)
    return app.habit_shop.halves
}

HabitShopPriceText :: (app: *InnerBreeze) {
    shop := *app.habit_shop
    unused AppFormatS32(shop.price, shop.price_text[:])
    length := cast(s32)AppTextFromCString(*shop.price_text[0],
        cast(s32)shop.price_text.count).count
    shop.price_cursor = length
    shop.price_anchor = length
}

// An empty form that adds a reward.
HabitShopFormReset :: (app: *InnerBreeze) {
    shop := *app.habit_shop
    shop.editing[0] = cast(u8)0
    shop.name[0] = cast(u8)0
    shop.name_cursor = 0
    shop.name_anchor = 0
    shop.name_scroll_x = 0
    shop.name_focused = 0
    shop.price = HABIT_SHOP_DEFAULT_PRICE
    shop.price_focused = 0
    shop.price_scroll_x = 0
    shop.icon = HABIT_ICON_GIFT
    shop.icon_open = false
    HabitShopPriceText(app)
}

// Opens the shop from the habit list.
HabitShopOpen :: (app: *InnerBreeze) {
    app.habits.screen_mode = HABITS_SCREEN_SHOP
    app.habits.selected = -1
    app.habits.scroll = 0
    HabitShopFormReset(app)
    app.habit_shop.loaded = false
}

// The stored reward with this id, or null.
HabitShopFind :: (app: *InnerBreeze, id: string) -> *HabitReward {
    shop := *app.habit_shop
    if id.count == 0 {
        return null
    }
    index: s32 = 0
    while index < shop.reward_count {
        if AppTextFromCString(*shop.rewards[index].id[0], HABIT_REWARD_ID_SIZE) == id {
            return *shop.rewards[index]
        }
        index += 1
    }
    return null
}

HabitShopRewardValue :: (reward: *HabitReward) -> HabitsShopReward {
    return HabitsShopReward.{
        .id = AppTextFromCString(*reward.id[0], HABIT_REWARD_ID_SIZE),
        .name = AppTextFromCString(*reward.name[0], HABIT_REWARD_NAME_SIZE),
        .price = reward.price, .icon = reward.icon}
}

// The name without spaces around it.
HabitShopTrimmed :: (value: string) -> string {
    start: s64 = 0
    end := value.count
    while start < end && (value[start] == cast(u8)32 || value[start] == cast(u8)9) {
        start += 1
    }
    while end > start && (value[end - 1] == cast(u8)32 || value[end - 1] == cast(u8)9) {
        end -= 1
    }
    return value[start:end]
}

// Saves a reward the page sends: a new one, or a stored one changed.
HabitShopSave :: (app: *InnerBreeze, reward: HabitsShopReward) -> bool {
    name := HabitShopTrimmed(reward.name)
    if name.count == 0 || name.count >= cast(s64)HABIT_REWARD_NAME_SIZE ||
    (reward.id.count > 0 && HabitShopFind(app, reward.id) == null) {
        return false
    }
    saved: [HABIT_REWARD_ID_SIZE]u8
    return storage_habit_reward_save(reward.id, name, reward.price, reward.icon,
        saved[:]) != 0
}

// Buys a stored reward at its stored price, when the coins cover it.
HabitShopBuy :: (app: *InnerBreeze, id: string) -> bool {
    stored := HabitShopFind(app, id)
    limit := cast(s64)storage_get_setting_int("habit_shop_borrow_limit", 0) * 2
    if stored == null ||
    storage_habit_wallet_halves() - cast(s64)stored.price * 2 < -limit {
        return false
    }
    return storage_habit_reward_buy(stored) != 0
}

// Keeps the page's form state and what it asks for.
HabitShopKeep :: (app: *InnerBreeze, observed: HabitsShopFrame) -> bool {
    shop := *app.habit_shop
    // VM strings are borrowed only during this call.
    if !AppCopyText(observed.editing, shop.editing[:]) ||
    !AppCopyText(observed.name, shop.name[:]) ||
    !AppCopyText(observed.price_text, shop.price_text[:]) ||
    !AppCopyText(observed.borrow_text, shop.borrow_text[:]) {
        return false
    }
    shop.name_cursor = observed.name_cursor
    shop.name_anchor = observed.name_anchor
    shop.name_scroll_x = observed.name_scroll_x
    shop.name_focused = ifx observed.name_focused then 1 else 0
    shop.price = HabitRewardPriceClamp(observed.price)
    shop.price_cursor = observed.price_cursor
    shop.price_anchor = observed.price_anchor
    shop.price_scroll_x = observed.price_scroll_x
    shop.price_focused = ifx observed.price_focused then 1 else 0
    shop.borrow_cursor = observed.borrow_cursor
    shop.borrow_anchor = observed.borrow_anchor
    shop.borrow_scroll_x = observed.borrow_scroll_x
    shop.borrow_focused = ifx observed.borrow_focused then 1 else 0
    if observed.borrow_limit != shop.borrow_limit {
        limit := observed.borrow_limit
        if limit < 0 {
            limit = 0
        } else if limit > 9999 {
            limit = 9999
        }
        shop.borrow_limit = limit
        storage_set_setting_int("habit_shop_borrow_limit", limit)
    }
    shop.icon = HabitRewardIconClamp(observed.icon)
    shop.icon_open = observed.icon_open
    app.habits.scroll = observed.scroll
    if observed.clipboard_write {
        unused TextInputWriteClipboard(observed.clipboard_text)
    }
    habit_shop_frame.action = observed.action
    if observed.action == HABITS_SHOP_BUY {
        // Buy asks about the reward as stored, never as the page sent it.
        stored := HabitShopFind(app, observed.buying.id)
        if stored == null {
            habit_shop_frame.action = HABITS_SHOP_NONE
        } else {
            shop.buying = stored.*
        }
    }
    return true
}

HabitShopCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "shop_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    shop := *app.habit_shop
    name := TextFromCString(function)
    if name == "ReadHabitsShopHost" && count == 0 {
        result.* = WidgetEncodeHabitsShopFrame(habit_shop_frame, *habit_shop_frame_codec)
        return 1
    }
    if name == "WriteHabitsShopHost" && count == 1 && WidgetValidHabitsShopFrame(arguments[0]) {
        return ifx HabitShopKeep(app,
            WidgetDecodeHabitsShopFrame(arguments[0], *habit_shop_frame_codec)) then 1 else 0
    }
    if name == "ReadHabitRewardHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        reward: HabitsShopReward
        if index >= 0 && index < shop.reward_count {
            reward = HabitShopRewardValue(*shop.rewards[index])
        }
        result.* = WidgetEncodeHabitsShopReward(reward, *habit_shop_reward_codec)
        return 1
    }
    if name == "ReadHabitActivityHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        line: HabitsShopActivity
        if index >= 0 && index < shop.activity_count {
            entry := *shop.activity[index]
            line = HabitsShopActivity.{
                .name = AppTextFromCString(*entry.name[0], HABIT_REWARD_NAME_SIZE),
                .icon = entry.icon, .halves = entry.halves,
                .day = HabitShopDay(app, entry.local_date)}
        }
        result.* = WidgetEncodeHabitsShopActivity(line, *habit_shop_activity_codec)
        return 1
    }
    if name == "SaveHabitRewardHost" && count == 1 && WidgetValidHabitsShopReward(arguments[0]) {
        saved := HabitShopSave(app, WidgetDecodeHabitsShopReward(arguments[0],
            *habit_shop_reward_codec))
        result.* = HostScalar("bool", ifx saved then 1 else 0)
        return 1
    }
    if name == "DeleteHabitRewardHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        id := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        deleted := HabitShopFind(app, id) != null && storage_habit_reward_delete(id) != 0
        result.* = HostScalar("bool", ifx deleted then 1 else 0)
        return 1
    }
    if name == "BuyHabitRewardHost" && count == 1 && WidgetValidHabitsShopReward(arguments[0]) {
        bought := HabitShopBuy(app, WidgetDecodeHabitsShopReward(arguments[0],
            *habit_shop_reward_codec).id)
        result.* = HostScalar("bool", ifx bought then 1 else 0)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// The page's frame: the coins, the rewards and the form as kept.
HabitShopFrameFor :: (app: *InnerBreeze, bounds: Rectangle, typed: []u8) -> HabitsShopFrame {
    shop := *app.habit_shop
    card := CardProps(bounds)
    return HabitsShopFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .bounds = bounds,
        .view_width = app.ui.view_width, .font = AppFontSize(),
        .small_font = AppSmallFontSize(), .text_color = StyleTokenColor("text"),
        .muted_class = MutedTextClass(), .card_fill = card.fill,
        .card_border = card.border, .card_radius = cast(s32)card.radius,
        .modal_active = app.modal.active != 0,
        .input = SampleTextFieldInput(shop.name_focused != 0 || shop.price_focused != 0 ||
            shop.borrow_focused != 0,
            typed),
        .halves = shop.halves, .borrow_limit = shop.borrow_limit,
        .reward_count = shop.reward_count,
        .activity_count = shop.activity_count, .scroll = app.habits.scroll,
        .editing = AppTextFromCString(*shop.editing[0], HABIT_REWARD_ID_SIZE),
        .name = AppTextFromCString(*shop.name[0], HABIT_REWARD_NAME_SIZE),
        .name_cursor = shop.name_cursor, .name_anchor = shop.name_anchor,
        .name_scroll_x = shop.name_scroll_x, .name_focused = shop.name_focused != 0,
        .price = shop.price,
        .price_text = AppTextFromCString(*shop.price_text[0], cast(s32)shop.price_text.count),
        .price_cursor = shop.price_cursor, .price_anchor = shop.price_anchor,
        .price_scroll_x = shop.price_scroll_x, .price_focused = shop.price_focused != 0,
        .borrow_text = AppTextFromCString(*shop.borrow_text[0], cast(s32)shop.borrow_text.count),
        .borrow_cursor = shop.borrow_cursor, .borrow_anchor = shop.borrow_anchor,
        .borrow_scroll_x = shop.borrow_scroll_x, .borrow_focused = shop.borrow_focused != 0,
        .icon = shop.icon, .icon_open = shop.icon_open,
        .buying = HabitShopRewardValue(*shop.buying)}
}

// Has Habits draw the frame for action; returns what the page asks for, or
// -1 when the package could not draw it.
HabitShopRun :: (app: *InnerBreeze, frame: HabitsShopFrame, action: s32) -> s32 {
    habit_shop_frame = frame
    habit_shop_frame.action = HABITS_SHOP_NONE
    WidgetHostBegin(frame.session, HostedAssetAllowed)
    AppsUiBegin(HabitShopCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = action})
    AppsUiEnd()
    WidgetHostEnd()
    asked := ifx drawn.succeeded then habit_shop_frame.action else -1
    habit_shop_frame = HabitsShopFrame.{}
    return asked
}

// Draws the shop in the bounds and returns false when Back was pressed, or
// when Habits cannot draw it, so the habit list shows instead.
HabitShopPage :: (app: *InnerBreeze, bounds: Rectangle) -> bool {
    HabitShopRefresh(app)
    typed: [64]u8
    asked := HabitShopRun(app, HabitShopFrameFor(app, bounds, typed[:]), HABITS_SHOP_VIEW)
    if asked < 0 || asked == HABITS_SHOP_BACK {
        app.habit_shop.name_focused = 0
        app.habit_shop.price_focused = 0
        app.habit_shop.borrow_focused = 0
        return false
    }
    if asked == HABITS_SHOP_BUY {
        app.habit_shop.name_focused = 0
        app.habit_shop.price_focused = 0
        app.habit_shop.borrow_focused = 0
        app_open_modal(app, cast(ModalType)ModalHabitBuy)
    }
    return true
}

// The dialog that asks before a reward's price is spent.
HabitShopBuyDialog :: (app: *InnerBreeze) {
    if app.modal.active == 0 || app.modal.type != cast(ModalType)ModalHabitBuy {
        return
    }
    HabitShopRefresh(app)
    typed: [1]u8
    frame := HabitShopFrameFor(app, Rectangle.{0.0, 0.0, cast(float32)app.ui.view_width,
            cast(float32)app.ui.view_height}, typed[:])
    frame.modal_active = false
    asked := HabitShopRun(app, frame, HABITS_SHOP_BUY_DIALOG)
    if asked < 0 || asked == HABITS_SHOP_CLOSE {
        app_close_modal(app)
    }
}
