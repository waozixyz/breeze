using ModalType;
using HostValueKind;

HabitScreenRect :: (x: s32, y: s32, width: s32,
    height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

// ---- A day's entries ------------------------------------------------------

// Opens the entry dialog for entry, or for a new entry of the day: now, or
// on another day at this time of day.
HabitScreenOpenEntry :: (app: *InnerBreeze, index: s32, day_index: s32,
    entry: string) {
    if index < 0 || index >= app.habits.count || day_index <= 0 {
        return
    }
    dialog := *app.habits.answer_dialog
    dialog.* = HabitAnswerDialog.{}
    dialog.habit = index
    dialog.day = day_index
    dialog.focus = -1
    unused AppCopyText(entry, dialog.entry[:])
    habit := *app.habits.items[index]
    stored: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    stored_count: s32 = 0
    started: s64 = 0
    ended: s64 = 0
    if entry.count > 0 {
        if !storage_habit_entry_load(entry, *started, *ended, stored[:],
            *stored_count) {
            return
        }
    } else {
        started = UnixNow()
        if day_index != habits_today_index() {
            started = storage_unix_at(day_index,
                storage_local_minutes_of(started))
        }
        if habit.span == 0 {
            ended = started
        }
    }
    dialog.start = storage_local_minutes_of(started)
    dialog.end = -1
    if habit.span != 0 && ended > 0 {
        dialog.end = storage_local_minutes_of(ended)
    }
    dialog.count = HabitAnswersFor(habit, stored[:], stored_count,
        dialog.answers[:])
    answer: s32 = 0
    while answer < dialog.count {
        hours: s32 = 0
        minutes: s32 = 0
        dialog.times[answer] = -1
        if dialog.answers[answer].answer_type == HABIT_ANSWER_TIME &&
        HabitTimeParts(HabitAnswerValue(*dialog.answers[answer]), *hours, *minutes) {
            dialog.times[answer] = hours * 60 + minutes
        }
        answer += 1
    }
    // A span's start and end questions answer its start and end, as
    // entries recorded before the habit measured spans do.
    start_answer := HabitScreenSpanTimeAnswer(app, 0)
    if start_answer >= 0 && dialog.times[start_answer] >= 0 {
        dialog.start = dialog.times[start_answer]
    }
    end_answer := HabitScreenSpanTimeAnswer(app, 1)
    if end_answer >= 0 && dialog.times[end_answer] >= 0 && dialog.end >= 0 {
        dialog.end = dialog.times[end_answer]
    }
    app_open_modal(app, cast(ModalType)ModalHabitEntry)
}

// Saves the dialog's entry. A span's end before its start is on the next
// day; a span without an end keeps running. False keeps the dialog open.
HabitScreenSaveEntry :: (app: *InnerBreeze) -> bool {
    dialog := *app.habits.answer_dialog
    if dialog.habit < 0 || dialog.habit >= app.habits.count {
        return false
    }
    habit := *app.habits.items[dialog.habit]
    start_answer := HabitScreenSpanTimeAnswer(app, 0)
    if start_answer >= 0 {
        dialog.times[start_answer] = dialog.start
    }
    end_answer := HabitScreenSpanTimeAnswer(app, 1)
    if end_answer >= 0 {
        dialog.times[end_answer] = dialog.end
    }
    answer: s32 = 0
    while answer < dialog.count {
        if dialog.answers[answer].answer_type == HABIT_ANSWER_TIME {
            unused HabitAnswerTimeText(dialog.times[answer],
                dialog.answers[answer].value[:])
        }
        answer += 1
    }
    start := dialog.start
    if start < 0 {
        return false
    }
    started := storage_unix_at(dialog.day, start)
    ended := started
    if habit.span != 0 {
        ended = 0
        end := dialog.end
        if end >= 0 {
            if end < start {
                end += HABIT_MINUTES_PER_DAY
            }
            ended = storage_unix_at(dialog.day, end)
        }
    }
    return habit_save_entry(app, dialog.habit, dialog.day,
        AppTextFromCString(*dialog.entry[0], HABIT_ENTRY_ID_SIZE), started, ended,
        dialog.answers[:], dialog.count)
}

// Records the entry without answers: the day is done, and its questions
// were skipped.
HabitScreenSkipEntry :: (app: *InnerBreeze) -> bool {
    dialog := *app.habits.answer_dialog
    answer: s32 = 0
    while answer < dialog.count {
        dialog.answers[answer].value[0] = cast(u8)0
        dialog.times[answer] = -1
        answer += 1
    }
    dialog.focus = -1
    return HabitScreenSaveEntry(app)
}

// The time rows: a span's start and end. Other entries ask no time; they
// keep the time they were recorded.
HabitScreenEntryTimeRows :: (app: *InnerBreeze) -> s32 {
    dialog := *app.habits.answer_dialog
    if dialog.habit < 0 || dialog.habit >= app.habits.count {
        return 0
    }
    return ifx app.habits.items[dialog.habit].span != 0 then 2 else 0
}

// A span habit's first and second time questions ask for its start and
// end: their words name those rows and their answers are the span's start
// and end, so they are not asked again below. The answer's index, or -1.
HabitScreenSpanTimeAnswer :: (app: *InnerBreeze, which: s32) -> s32 {
    dialog := *app.habits.answer_dialog
    if HabitScreenEntryTimeRows(app) != 2 {
        return -1
    }
    seen: s32 = 0
    index: s32 = 0
    while index < dialog.count {
        if dialog.answers[index].answer_type == HABIT_ANSWER_TIME {
            if seen == which {
                return index
            }
            seen += 1
        }
        index += 1
    }
    return -1
}

// Reads a habit day's entries again when the stored data or the day
// changed, with each entry's time and answers as its day screen shows them.
HabitDayEntriesRefresh :: (app: *InnerBreeze, index: s32, day_index: s32) {
    cache := *app.habits.day_entries
    revision := storage_data_revision()
    if cache.habit == index && cache.day == day_index &&
    cache.revision == revision {
        return
    }
    cache.habit = index
    cache.day = day_index
    cache.revision = revision
    cache.count = 0
    if index < 0 || index >= app.habits.count {
        return
    }
    habit := *app.habits.items[index]
    cache.count = storage_habit_day_entries(AppTextFromCString(*habit.id[0],
        HABIT_ID_SIZE), day_index, cache.entries[:])
    entry: s32 = 0
    while entry < cache.count {
        HabitEntryDescribe(habit, *cache.entries[entry])
        entry += 1
    }
}

// An entry's time, or its span's start, end and length, and its answers,
// each on its own line.
HabitEntryDescribe :: (habit: *Habit, entry: *HabitEntrySummary) {
    start_text: [16]u8
    end_text: [16]u8
    length_text: [16]u8
    unused HabitAnswerTimeText(storage_local_minutes_of(entry.started_at),
        start_text[:])
    args: [3]FormatArg
    args[0].text = AppTextFromCString(*start_text[0], 16)
    args[0].is_text = true
    if habit.span == 0 {
        unused FormatTemplate("%s", args[:1], entry.when[:])
    } else if entry.ended_at <= 0 {
        args[1].text = LocaleText("habit_span_running")
        args[1].is_text = true
        unused FormatTemplate("%s - %s", args[:2], entry.when[:])
    } else {
        unused HabitAnswerTimeText(storage_local_minutes_of(entry.ended_at),
            end_text[:])
        unused HabitSpanText(cast(s32)((entry.ended_at - entry.started_at) / 60),
            length_text[:])
        args[1].text = AppTextFromCString(*end_text[0], 16)
        args[1].is_text = true
        args[2].text = AppTextFromCString(*length_text[0], 16)
        args[2].is_text = true
        unused FormatTemplate("%s - %s  ·  %s", args[:], entry.when[:])
    }
    answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    count: s32 = 0
    started: s64 = 0
    ended: s64 = 0
    entry.summary[0] = cast(u8)0
    unused storage_habit_entry_load(AppTextFromCString(*entry.id[0],
        HABIT_ENTRY_ID_SIZE), *started, *ended, answers[:], *count)
    // A span's start and end questions are its times, shown above.
    span_times: [2]s64 = .[-1, -1]
    if habit.span != 0 {
        found: s32 = 0
        question: s32 = 0
        while question < habit.question_count && found < 2 {
            if habit.questions[question].answer_type == HABIT_ANSWER_TIME {
                span_times[found] = habit.questions[question].id
                found += 1
            }
            question += 1
        }
    }
    // Each answer is two lines: its question, then its value.
    index: s32 = 0
    while index < count {
        if answers[index].id == span_times[0] || answers[index].id == span_times[1] {
            index += 1
            continue
        }
        value := HabitAnswerValue(*answers[index])
        if answers[index].answer_type == HABIT_ANSWER_YES_NO {
            value = LocaleText(ifx value == "yes" then "habit_answer_yes"
                else "habit_answer_no")
        }
        if entry.summary[0] != cast(u8)0 {
            unused AppAppendText("\n", entry.summary[:])
        }
        unused AppAppendText(HabitAnswerQuestion(*answers[index]), entry.summary[:])
        unused AppAppendText("\n", entry.summary[:])
        unused AppAppendText(value, entry.summary[:])
        index += 1
    }
}

// ---- The entry dialog, which Habits draws ------------------------------------

habit_entry_frame: HabitsEntryFrame;
habit_entry_frame_codec: WidgetHabitsEntryFrameCodec;
habit_entry_answer_codec: WidgetHabitsAnswerCodec;

HabitEntryAnswer :: (app: *InnerBreeze, index: s32) -> HabitsAnswer {
    dialog := *app.habits.answer_dialog
    answer := *dialog.answers[index]
    return HabitsAnswer.{.question = HabitAnswerQuestion(answer),
        .answer_type = answer.answer_type, .value = HabitAnswerValue(answer),
        .time = dialog.times[index]}
}

// Keeps an answer the dialog changed, as its question's type allows it.
HabitEntryKeepAnswer :: (app: *InnerBreeze, index: s32, changed: HabitsAnswer) -> bool {
    dialog := *app.habits.answer_dialog
    if index < 0 || index >= dialog.count {
        return false
    }
    answer := *dialog.answers[index]
    if answer.answer_type == HABIT_ANSWER_TIME {
        if changed.time < -1 || changed.time >= HABIT_MINUTES_PER_DAY {
            return false
        }
        dialog.times[index] = changed.time
        return true
    }
    if answer.answer_type == HABIT_ANSWER_YES_NO && changed.value != "" &&
    changed.value != "yes" && changed.value != "no" {
        return false
    }
    if changed.value.count >= cast(s64)HABIT_ANSWER_SIZE {
        return false
    }
    // VM strings are borrowed only during this call.
    return AppCopyText(changed.value, answer.value[:])
}

HabitEntryCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "habit_day_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    dialog := *app.habits.answer_dialog
    name := TextFromCString(function)
    if name == "ReadHabitsEntryHost" && count == 0 {
        result.* = WidgetEncodeHabitsEntryFrame(habit_entry_frame, *habit_entry_frame_codec)
        return 1
    }
    if name == "WriteHabitsEntryHost" && count == 1 && WidgetValidHabitsEntryFrame(arguments[0]) {
        observed := WidgetDecodeHabitsEntryFrame(arguments[0], *habit_entry_frame_codec)
        if observed.clipboard_write {
            unused TextInputWriteClipboard(observed.clipboard_text)
        }
        observed.clipboard_text = ""
        habit_entry_frame = observed
        return 1
    }
    if name == "ReadHabitsAnswerHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        answer := HabitsAnswer.{.time = -1}
        if index >= 0 && index < dialog.count {
            answer = HabitEntryAnswer(app, index)
        }
        result.* = WidgetEncodeHabitsAnswer(answer, *habit_entry_answer_codec)
        return 1
    }
    if name == "WriteHabitsAnswerHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    WidgetValidHabitsAnswer(arguments[1]) {
        kept := HabitEntryKeepAnswer(app, cast(s32)arguments[0].integer,
            WidgetDecodeHabitsAnswer(arguments[1], *habit_entry_answer_codec))
        result.* = HostScalar("bool", ifx kept then 1 else 0)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// A time of the dialog as it may be kept: minutes after midnight, or -1.
HabitEntryMinutes :: (minutes: s32) -> s32 {
    if minutes < -1 || minutes >= HABIT_MINUTES_PER_DAY {
        return -1
    }
    return minutes
}

// The entry dialog. Done records a new entry; an entry that exists is
// saved again or deleted.
#program_export
HabitScreenEntryDialog :: (app: *InnerBreeze) {
    if app.modal.active == 0 ||
    app.modal.type != cast(ModalType)ModalHabitEntry { return }
    dialog := *app.habits.answer_dialog
    index := dialog.habit
    day_index := dialog.day
    if index < 0 || index >= app.habits.count || day_index <= 0 {
        app_close_modal(app)
        return
    }
    habit := *app.habits.items[index]
    typed: [64]u8
    habit_entry_frame = HabitsEntryFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .view_height = app.ui.view_height,
        .font = AppFontSize(), .small_font = AppSmallFontSize(),
        .muted_class = MutedTextClass(),
        .name = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE),
        .day = day_index, .today = habits_today_index(),
        .existing = dialog.entry[0] != cast(u8)0, .span = habit.span != 0,
        .start = dialog.start, .end = dialog.end,
        .start_answer = HabitScreenSpanTimeAnswer(app, 0),
        .end_answer = HabitScreenSpanTimeAnswer(app, 1),
        .answer_count = dialog.count, .now = storage_local_minutes_of(UnixNow()),
        .focus = dialog.focus, .cursor = dialog.cursor, .anchor = dialog.anchor,
        .scroll_x = dialog.scroll_x, .scroll = dialog.scroll,
        .input = SampleTextFieldInput(dialog.focus >= 0, typed[:])}
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(HabitEntryCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_ENTRY_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    if !drawn.succeeded {
        habit_entry_frame = HabitsEntryFrame.{}
        app_close_modal(app)
        return
    }
    observed := *habit_entry_frame
    dialog.start = HabitEntryMinutes(observed.start)
    dialog.end = HabitEntryMinutes(observed.end)
    dialog.focus = ifx observed.focus >= 0 && observed.focus < dialog.count then observed.focus else -1
    dialog.cursor = observed.cursor
    dialog.anchor = observed.anchor
    dialog.scroll_x = observed.scroll_x
    dialog.scroll = observed.scroll
    action := observed.action
    habit_entry_frame = HabitsEntryFrame.{}
    if action == HABITS_ENTRY_CANCEL {
        app_close_modal(app)
    } else if action == HABITS_ENTRY_SAVE {
        if HabitScreenSaveEntry(app) {
            app_close_modal(app)
        }
    } else if action == HABITS_ENTRY_SKIP {
        if HabitScreenSkipEntry(app) {
            app_close_modal(app)
        }
    } else if action == HABITS_ENTRY_DELETE {
        if habit_delete_entry(app, index, day_index,
            AppTextFromCString(*dialog.entry[0], HABIT_ENTRY_ID_SIZE)) {
            app_close_modal(app)
        }
    }
}
