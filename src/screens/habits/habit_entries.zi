// A habit day's entries: the dialog that writes one, which Habits draws
// (apps/habits/habit_day_view.zi) over both habit screens, and the entries
// the day's screen lists. The host keeps the dialog's entry and saves,
// skips or deletes it when the dialog asks.
#import, file "../../habits/habit_types.zi";
#import, file "../../habits/habit_model.zi";
#import, file "../../habits/habit_questions.zi";
#import, file "../../habits/habit_answer_stats.zi";
#import, file "../../habits/habit_actions.zi";
#import, file "../../habits/habit_sessions.zi";
#import, file "../../storage/storage_habits.zi";
#import, file "../../storage/db.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/app.zi";
#import, file "../../app/app_modal_state.zi";
#import, file "../../app/modal_rules.zi";
#import, file "../../app/locale.zi";
#import, file "../../app/metrics.zi";
#import, file "../../app/text_buffers.zi";
#import, file "../../app/cards.zi";
#import, file "../../platform/raylib_text_input.zi";
#import, file "../../apps/habits_ui_types.zi";
#import, file "../../apps/habits_types.zi";
#import, file "../../apps/app_codec.zi";
