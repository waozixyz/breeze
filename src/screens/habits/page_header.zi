// The header of Habits' inner pages: Back, then the page's title, strong,
// with its subtitle muted below it.
#import "geometry"
#import "button_props"
#import "control_props"
#import "button_widget"
#import "text_props"
#import "text_align"
#import "text_widget"
#import, file "../../app/app_types.zi";
#import, file "../../app/locale.zi";
#import, file "../../app/metrics.zi";
#import, file "../../app/cards.zi";

using ButtonEmphasis;
using ButtonTone;
using TextAlign;
using TextWrap;

HABIT_BACK_SHAPE :: "S1.8rr:M15 5L8 12L15 19"

// Draws the header and returns the y below it, or -1 when Back was pressed.
HabitPageHeader :: (app: *InnerBreeze, x: s32, y: s32, width: s32,
    title_text: string, subtitle: string, back_id: s32) -> s32 {
    back_label := LocaleText("back_button")
    back_w := AppTextWidth(back_label, AppFontSize()) + AppScale(48)
    if back_w < AppScale(88) {
        back_w = AppScale(88)
    }
    if back_w > width / 3 {
        back_w = width / 3
    }
    back: ButtonProps
    back.bounds = Rectangle.{cast(float32)x, cast(float32)(y + AppScale(2)),
        cast(float32)back_w, cast(float32)AppScale(42)}
    back.id = back_id
    back.label = back_label
    back.tone = cast(ButtonTone)ButtonToneNeutral
    back.emphasis = cast(ButtonEmphasis)ButtonEmphasisOutline
    back.icon_shape = HABIT_BACK_SHAPE
    back.fit_content = true
    back.disabled = app.modal.active != 0
    if Button(app.ui.session, back) != 0 {
        return -1
    }
    title_x := x + back_w + AppScale(16)
    title_w := width - back_w - AppScale(16)
    strong := StrongWhole(title_text)
    title: TextProps
    title.bounds = Rectangle.{cast(float32)title_x, cast(float32)y,
        cast(float32)title_w,
        cast(float32)(ifx subtitle.count > 0 then AppScale(34) else AppScale(46))}
    title.text = title_text
    title.font = AppTitleFontSize(title_text, title_w)
    title.strong = strong[:]
    title.vertical_align = cast(TextAlign)TextAlignCenter
    title.wrap = cast(TextWrap)TextWrapEllipsis
    Text(app.ui.session, title)
    if subtitle.count == 0 {
        return y + AppScale(58)
    }
    label: TextProps
    label.bounds = Rectangle.{cast(float32)title_x, cast(float32)(y + AppScale(34)),
        cast(float32)title_w, cast(float32)AppScale(22)}
    label.text = subtitle
    label.font = AppSmallFontSize()
    label.class_name = MutedTextClass()
    label.wrap = cast(TextWrap)TextWrapEllipsis
    Text(app.ui.session, label)
    return y + AppScale(68)
}
