using ExerciseType;
using HostValueKind;

ANDROID :: #defined(ANDROID_BUILD)

// The day's sessions while the page draws: what was linked to the day,
// ordered by practice, each practice's sessions on its own card.
habit_day_context: HabitLinkedContext;
habit_day_order: [HABIT_LINKED_ENTRY_MAX]s32;
habit_day_order_count: s32;
habit_day_frame: HabitsDayFrame;
habit_day_frame_codec: WidgetHabitsDayFrameCodec;
habit_day_entry_codec: WidgetHabitsDayEntryCodec;
habit_day_session_codec: WidgetHabitsDaySessionCodec;

habit_session_same_path :: (left: *u8, right: *u8) -> bool {
    return AppTextFromCString(left, HABIT_LINKED_PATH_SIZE) ==
    AppTextFromCString(right, HABIT_LINKED_PATH_SIZE)
}

delete_round :: (entry: *HabitLinkedEntry, round: s32) -> s32 {
    rounds: [MaxRounds] s32
    out_count: s32 = 0

    if entry == null || round < 0 || round >= entry.round_count {
        return 0
    }
    if entry.round_count <= 1 {
        return data_delete_session(AppTextFromCString(*entry.path[0],
            HABIT_LINKED_PATH_SIZE))
    }

    {
        i: s32 = 0
        while i < entry.round_count {
            if i != round {
                rounds[out_count] = entry.rounds[i]
                out_count += 1
            }
            i += 1
        }

    }

    return data_replace_session(AppTextFromCString(*entry.path[0],
        HABIT_LINKED_PATH_SIZE), *rounds[0], out_count)
}

// Practices whose sessions count time or repetitions rather than rounds.
habit_session_without_rounds :: (activity: s32) -> bool {
    return activity == EXERCISE_MEDITATION || activity == EXERCISE_SUN_SALUTATION ||
    activity == EXERCISE_TAI_CHI || activity == EXERCISE_ASTRAL_PROJECTION ||
    activity == EXERCISE_WORKOUT
}

// A session's details as one line: a Sun Salutation's length and breaths,
// or the course item it practised.
habit_session_details_text :: (app: *InnerBreeze, entry: *HabitLinkedEntry) -> string {
    if entry.details.version != SessionDetailsVersion {
        return ""
    }
    line: [512]u8
    details := entry.details
    if entry.activity == EXERCISE_SUN_SALUTATION {
        duration: [32]u8
        first: [96]u8
        last: [96]u8
        habit_format_duration(details.duration_seconds, *duration[0], duration.count)
        unused FormatNumberTemplate(LocaleText("sun_salutation_seconds_per_breath"), details.start_seconds, first[:])
        unused FormatNumberTemplate(LocaleText("sun_salutation_seconds_per_breath"), details.end_seconds, last[:])
        unused AppCopyText(AppTextFromCString(*duration[0], 32), line[:])
        unused AppAppendText(" · ", line[:])
        unused AppAppendText(AppTextFromCString(*first[0], 96), line[:])
        unused AppAppendText(" → ", line[:])
        unused AppAppendText(AppTextFromCString(*last[0], 96), line[:])
    } else if details.title[0] != cast(u8)0 {
        key := AppTextFromCString(*details.item[0], 96)
        title := LocaleText(key)
        unused AppCopyText(ifx title == key || title.count == 0 then
            AppTextFromCString(*details.title[0], 160) else title, line[:])
    } else {
        return ""
    }
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*line[0], 512))
}

// A linked session as the day's screen shows it.
habit_day_session :: (app: *InnerBreeze, entry: *HabitLinkedEntry) -> HabitsDaySession {
    time_text: [16]u8
    summary_text: [32]u8
    time_args: [2]FormatArg = .[
    FormatArg.{.number = entry.hour},
    FormatArg.{.number = entry.minute}
    ]
    unused FormatTemplate("%02d:%02d", time_args[:], time_text[:])
    activity := entry.activity
    if activity == EXERCISE_SUN_SALUTATION {
        FormatLocaleCount(*summary_text[0], size_of(type_of(summary_text)),
            "practice_home_repetitions",
            ifx (entry.round_count > 0) then (entry.rounds[0]) else (1))
    } else if habit_session_without_rounds(activity) {
        habit_format_duration(entry.total_seconds, *summary_text[0],
            size_of(type_of(summary_text)))
    } else {
        FormatLocaleCount(*summary_text[0], size_of(type_of(summary_text)),
            "results_rounds", entry.round_count)
    }
    return HabitsDaySession.{.activity = activity, .title = practice_label(activity),
        .time = FrameTextHold(*app.ui.frame_text,
            AppTextFromCString(*time_text[0], size_of(type_of(time_text)))),
        .summary = FrameTextHold(*app.ui.frame_text,
            AppTextFromCString(*summary_text[0], size_of(type_of(summary_text)))),
        .details = habit_session_details_text(app, entry),
        .rounds = ifx habit_session_without_rounds(activity) then 0 else entry.round_count}
}

// The day's sessions by practice, in the order of the practices.
habit_day_order_sessions :: () {
    habit_day_order_count = 0
    activity: s32 = 0
    while activity < EXERCISE_COUNT {
        index: s32 = 0
        while index < habit_day_context.count {
            if habit_day_context.entries[index].activity == activity {
                habit_day_order[habit_day_order_count] = index
                habit_day_order_count += 1
            }
            index += 1
        }
        activity += 1
    }
}

// The session the page shows at a place, or null.
habit_day_session_at :: (index: s32) -> *HabitLinkedEntry {
    if index < 0 || index >= habit_day_order_count {
        return null
    }
    return *habit_day_context.entries[habit_day_order[index]]
}

HabitDayCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "habit_day_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ReadHabitsDayHost" && count == 0 {
        result.* = WidgetEncodeHabitsDayFrame(habit_day_frame, *habit_day_frame_codec)
        return 1
    }
    if name == "WriteHabitsDayHost" && count == 1 && WidgetValidHabitsDayFrame(arguments[0]) {
        observed := WidgetDecodeHabitsDayFrame(arguments[0], *habit_day_frame_codec)
        // VM strings are borrowed only during this call.
        if !AppCopyText(observed.edit_text, app.habit_session_edit.text[:]) {
            observed.editing = false
        }
        observed.edit_text = ""
        habit_day_frame = observed
        return 1
    }
    if name == "ReadHabitsDayEntryHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        cache := *app.habits.day_entries
        item: HabitsDayEntry
        if index >= 0 && index < cache.count {
            entry := *cache.entries[index]
            item = HabitsDayEntry.{
                .id = AppTextFromCString(*entry.id[0], HABIT_ENTRY_ID_SIZE),
                .when = AppTextFromCString(*entry.when[0], 64),
                .summary = AppTextFromCString(*entry.summary[0], HABIT_ENTRY_SUMMARY_SIZE),
                .running = app.habits.items[cache.habit].span != 0 && entry.ended_at <= 0}
        }
        result.* = WidgetEncodeHabitsDayEntry(item, *habit_day_entry_codec)
        return 1
    }
    if name == "ReadHabitsDaySessionHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        entry := habit_day_session_at(cast(s32)arguments[0].integer)
        session: HabitsDaySession
        if entry != null {
            session = habit_day_session(app, entry)
        }
        result.* = WidgetEncodeHabitsDaySession(session, *habit_day_session_codec)
        return 1
    }
    if name == "ReadHabitsDayRoundHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        entry := habit_day_session_at(cast(s32)arguments[0].integer)
        round := cast(s32)arguments[1].integer
        seconds: s32 = 0
        if entry != null && round >= 0 && round < entry.round_count {
            seconds = entry.rounds[round]
        }
        result.* = HostScalar("s32", cast(s64)seconds)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// The page's place of the session whose round is being changed, or -1.
habit_day_editing_session :: (app: *InnerBreeze) -> s32 {
    if app.habit_session_edit.active == 0 {
        return -1
    }
    index: s32 = 0
    while index < habit_day_order_count {
        if habit_session_same_path(*app.habit_session_edit.path[0],
            *habit_day_context.entries[habit_day_order[index]].path[0]) {
            return index
        }
        index += 1
    }
    return -1
}

// Keeps the round the page changes: its session's path, its round and the
// seconds typed, already copied in by WriteHabitsDayHost.
habit_day_keep_editing :: (app: *InnerBreeze, observed: *HabitsDayFrame) {
    entry := habit_day_session_at(observed.edit_session)
    if !observed.editing || entry == null || observed.edit_round < 0 ||
    observed.edit_round >= entry.round_count {
        habit_session_cancel_edit(app)
        return
    }
    app.habit_session_edit.active = 1
    app.habit_session_edit.kind = HABIT_SESSION_EDIT_ROUND
    app.habit_session_edit.round = observed.edit_round
    app.habit_session_edit.cursor = observed.edit_cursor
    unused AppCopyText(AppTextFromCString(*entry.path[0], HABIT_LINKED_PATH_SIZE),
        app.habit_session_edit.path[:])
}

habit_session_commit_edit :: (app: *InnerBreeze, entry: *HabitLinkedEntry) -> s32 {
    if app == null || entry == null || app.habit_session_edit.active == 0 {
        return 0
    }

    if app.habit_session_edit.kind == HABIT_SESSION_EDIT_ROUND {
        parsed := habit_session_parse_seconds(AppTextFromCString(
            *app.habit_session_edit.text[0],
            size_of(type_of(app.habit_session_edit.text))))
        rounds: [MaxRounds] s32

        if app.habit_session_edit.round < 0  || app.habit_session_edit.round >= entry.round_count {
            return 0
        }
        if !parsed.valid {
            return 0
        }
        {
            i: s32 = 0
            while i < entry.round_count {
                rounds[i] = entry.rounds[i]
                i += 1
            }

        }
        rounds[app.habit_session_edit.round] = parsed.seconds
        if data_replace_session(AppTextFromCString(*entry.path[0],
            HABIT_LINKED_PATH_SIZE), *rounds[0], entry.round_count) == 0 {
            return 0
        }
        habit_session_changed(app, -1)
        habit_session_cancel_edit(app)
        return 1
    }

    return 0
}

// Does what the day's screen asked for once it is drawn.
habit_day_apply :: (app: *InnerBreeze, observed: *HabitsDayFrame) {
    index := app.habit_detail_index
    day_index := app.habit_detail_day
    action := observed.action
    cache := *app.habits.day_entries
    if action == HABITS_DAY_SCREEN_CLOSE {
        habit_session_cancel_edit(app)
        app_switch_screen(app, ScreenHabits)
    } else if action == HABITS_DAY_SCREEN_ADD_ENTRY {
        HabitScreenOpenEntry(app, index, day_index, "")
    } else if (action == HABITS_DAY_SCREEN_EDIT_ENTRY || action == HABITS_DAY_SCREEN_DELETE_ENTRY ||
        action == HABITS_DAY_SCREEN_END_SPAN) &&
    observed.action_index >= 0 && observed.action_index < cache.count {
        // The entry's id outlives the cache, which these actions read again.
        id: [HABIT_ENTRY_ID_SIZE]u8
        unused AppCopyText(AppTextFromCString(*cache.entries[observed.action_index].id[0],
            HABIT_ENTRY_ID_SIZE), id[:])
        entry_id := AppTextFromCString(*id[0], HABIT_ENTRY_ID_SIZE)
        if action == HABITS_DAY_SCREEN_EDIT_ENTRY {
            HabitScreenOpenEntry(app, index, day_index, entry_id)
        } else if action == HABITS_DAY_SCREEN_DELETE_ENTRY {
            unused habit_delete_entry(app, index, day_index, entry_id)
        } else if habit_end_span(app, index) && app.habits.items[index].question_count > 0 {
            HabitScreenOpenEntry(app, index, day_index, entry_id)
        }
    } else if action == HABITS_DAY_SCREEN_DELETE_SESSION || action == HABITS_DAY_SCREEN_DELETE_ROUND {
        entry := habit_day_session_at(observed.action_index)
        if entry != null {
            deleted: s32 = 0
            if action == HABITS_DAY_SCREEN_DELETE_SESSION {
                deleted = data_delete_session(AppTextFromCString(*entry.path[0],
                    HABIT_LINKED_PATH_SIZE))
            } else {
                deleted = delete_round(entry, observed.action_round)
            }
            if deleted != 0 {
                habit_session_changed(app, habit_day_context.count)
            }
        }
        habit_session_cancel_edit(app)
    } else if action == HABITS_DAY_SCREEN_SAVE_ROUND {
        entry := habit_day_session_at(observed.action_index)
        if entry != null && app.habit_session_edit.active != 0 {
            unused habit_session_commit_edit(app, entry)
        }
    } else if action == HABITS_DAY_SCREEN_STEP_COUNT &&
    (observed.action_step == 1 || observed.action_step == -1) {
        habit_apply_count_action(app, index, day_index, observed.action_step,
            habit_day_context.count)
        app_auto_sync(app)
    }
}

habit_session_draw_edit_screen :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if app.habit_detail_index < 0 || app.habit_detail_index >= app.habits.count {
        app_switch_screen(app, ScreenHabits)
        return
    }
    habit := *app.habits.items[app.habit_detail_index]
    habit_collect_linked_entries(habit, app.habit_detail_day, *habit_day_context)
    // A day with neither sessions nor a habit that keeps entries has
    // nothing to show.
    if habit_day_context.count <= 0 && !habit_keeps_entries(habit) {
        habit_session_cancel_edit(app)
        app_switch_screen(app, ScreenHabits)
        return
    }
    habit_day_order_sessions()
    HabitDayEntriesRefresh(app, app.habit_detail_index, app.habit_detail_day)
    date_text: [32]u8
    habit_format_date(app.habit_detail_day, *date_text[0], size_of(type_of(date_text)))
    keyboard := app.on_screen_keyboard_enabled != 0
    #if ANDROID {
        keyboard = true
    }
    editing := habit_day_editing_session(app)
    typed: [64]u8
    card := CardProps(Rectangle.{})
    habit_day_frame = HabitsDayFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .view_width = app.ui.view_width,
        .view_height = app.ui.view_height, .bottom = app_content_bottom_reserved(app),
        .font = AppFontSize(), .small_font = AppSmallFontSize(),
        .text_color = StyleTokenColor("text"), .surface_color = StyleTokenColor("surface"),
        .canvas_color = StyleTokenColor("canvas"), .card_fill = card.fill,
        .card_border = card.border, .muted_class = MutedTextClass(),
        .modal_active = app.modal.active != 0,
        .title = AppTextFromCString(*date_text[0], size_of(type_of(date_text))),
        .keeps_entries = habit_keeps_entries(habit), .span = habit.span != 0,
        .counting = habit_counting_enabled(habit) != 0,
        .count = HabitEffectiveDayCount(habit, app.habit_detail_day, *habit_day_context),
        .minimum_count = habit_day_context.count,
        .entry_count = app.habits.day_entries.count, .session_count = habit_day_order_count,
        .scroll = app.habit_session_edit.scroll, .editing = editing >= 0,
        .edit_session = editing, .edit_round = app.habit_session_edit.round,
        .edit_text = AppTextFromCString(*app.habit_session_edit.text[0],
            size_of(type_of(app.habit_session_edit.text))),
        .edit_cursor = app.habit_session_edit.cursor, .keyboard = keyboard,
        .input = SampleTextFieldInput(editing >= 0, typed[:])}
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    CellsUiBegin(HabitDayCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_DAY_VIEW})
    CellsUiEnd()
    WidgetHostEnd()
    if drawn.succeeded {
        app.habit_session_edit.scroll = habit_day_frame.scroll
        habit_day_keep_editing(app, *habit_day_frame)
        habit_day_apply(app, *habit_day_frame)
    }
    habit_day_frame = HabitsDayFrame.{}
    HabitScreenEntryDialog(app)
}
