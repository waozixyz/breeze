using ModalType;
using HabitSyncMode;
using ExerciseType;
using HostValueKind;

save_settings :: (app: *InnerBreeze) #foreign c "save_settings";
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c "app_auto_sync";
app_apply_nav_route :: (app: *InnerBreeze, route: s32) #foreign c;

habit_edit_practice_label :: (id: s32) -> string {
    if id == EXERCISE_MEDITATION { return LocaleText("exercise_meditation") }
    if id == EXERCISE_SUN_SALUTATION { return LocaleText("exercise_sun_salutation") }
    if id == EXERCISE_PATTERNS { return LocaleText("exercise_patterns") }
    if id == EXERCISE_TAI_CHI { return LocaleText("exercise_tai_chi") }
    if id == EXERCISE_ASTRAL_PROJECTION { return LocaleText("exercise_astral_projection") }
    if id == EXERCISE_WORKOUT { return LocaleText("exercise_workout") }
    return LocaleText("exercise_wim_hof")
}

habit_edit_begin_new :: (app: *InnerBreeze) {
    default_color: Color = Color.{.r = 99, .g = 196, .b = 165, .a = 255}

    if app == null {
        return
    }

    app.habit_edit = HabitEditState.{}
    app.habit_edit.active = 1
    app.habit_edit.is_new = 1
    app.habit_edit.index = -1
    app.habit_edit.color = default_color
    app.habit_edit.sync_mode = HABIT_SYNC_NONE
    app.habit_edit.counter_target = 1
    app.habit_edit.reminder_hour = -1
    app.habit_edit.schedule = HabitScheduleFromWeekdays(0)
    app.habit_edit.cursor = 0
    app.habit_edit.focused = 0
    app.habits.scroll = 0
    app.habits.tab = HABIT_TAB_EDIT
    habit_edit_counter_text(app)
    habit_edit_span_fill(app)
    habit_edit_goal_fill_all(app)
    app.habit_edit_original = app.habit_edit
    app_switch_screen(app, ScreenHabitEdit)
}

habit_edit_begin :: (app: *InnerBreeze, index: s32) {
    if app == null || index < 0 || index >= app.habits.count {
        return
    }

    app.habit_edit = HabitEditState.{}
    app.habit_edit.active = 1
    app.habit_edit.index = index
    app.habit_edit.color = app.habits.items[index].color
    app.habit_edit.sync_mode = app.habits.items[index].sync_mode
    app.habit_edit.sync_activity = app.habits.items[index].sync_activity
    app.habit_edit.counter_enabled = app.habits.items[index].counter_enabled
    app.habit_edit.counter_target = habit_counter_target(*app.habits.items[index])
    app.habit_edit.schedule = HabitScheduleCurrent(*app.habits.items[index])
    app.habit_edit.reminder_hour = app.habits.items[index].reminder_hour
    app.habit_edit.icon = app.habits.items[index].icon
    app.habit_edit.difficulty = app.habits.items[index].difficulty
    app.habit_edit.custom_coins = app.habits.items[index].custom_coins
    app.habit_edit.coin_halves = app.habits.items[index].coin_halves
    app.habit_edit.questions = app.habits.items[index].questions
    app.habit_edit.question_count = app.habits.items[index].question_count
    app.habit_edit.span = app.habits.items[index].span
    app.habit_edit.span_goal = app.habits.items[index].span_goal
    habit_edit_span_fill(app)
    habit_edit_goal_fill_all(app)
    AppCopyText(AppTextFromCString(*app.habits.items[index].name[0],
        HABIT_NAME_SIZE), app.habit_edit.text[:])
    AppCopyText(AppTextFromCString(*app.habits.items[index].description[0],
        HABIT_DESCRIPTION_SIZE), app.habit_edit.description[:])
    app.habit_edit.cursor = cast(s32)AppTextFromCString(
        *app.habit_edit.text[0], HABIT_NAME_SIZE).count
    app.habit_edit.description_cursor = cast(s32)AppTextFromCString(
        *app.habit_edit.description[0], HABIT_DESCRIPTION_SIZE).count
    app.habits.tab = HABIT_TAB_EDIT
    app.habits.scroll = 0
    habit_edit_counter_text(app)
    app.habit_edit_original = app.habit_edit
    app_switch_screen(app, ScreenHabitEdit)
}

habit_edit_goal_same :: (first: HabitGoal, second: HabitGoal) -> bool {
    return first.kind == second.kind && first.low == second.low && first.high == second.high
}

#program_export
habit_edit_changed :: (app: *InnerBreeze) -> bool {
    if app == null || app.habit_edit.active == 0 {
        return false
    }
    edit := *app.habit_edit
    original := *app.habit_edit_original
    if AppTextFromCString(*edit.text[0], HABIT_NAME_SIZE) !=
    AppTextFromCString(*original.text[0], HABIT_NAME_SIZE) ||
    AppTextFromCString(*edit.description[0], HABIT_DESCRIPTION_SIZE) !=
    AppTextFromCString(*original.description[0], HABIT_DESCRIPTION_SIZE) ||
    edit.color.r != original.color.r || edit.color.g != original.color.g ||
    edit.color.b != original.color.b || edit.color.a != original.color.a ||
    edit.sync_activity != original.sync_activity || edit.sync_mode != original.sync_mode ||
    edit.counter_enabled != original.counter_enabled || edit.counter_target != original.counter_target ||
    edit.reminder_hour != original.reminder_hour || edit.icon != original.icon ||
    edit.difficulty != original.difficulty ||
    edit.custom_coins != original.custom_coins || edit.coin_halves != original.coin_halves ||
    edit.span != original.span || !habit_edit_goal_same(edit.span_goal, original.span_goal) ||
    !HabitScheduleSame(*edit.schedule, *original.schedule) ||
    edit.question_count != original.question_count {
        return true
    }
    if edit.counter_focused != 0 &&
    AppTextFromCString(*edit.counter_text[0], 8) != AppTextFromCString(*original.counter_text[0], 8) {
        return true
    }
    for index: cast(s32)0..edit.question_count - 1 {
        question := *edit.questions[index]
        before := *original.questions[index]
        if question.id != before.id || question.answer_type != before.answer_type ||
        HabitQuestionText(question) != HabitQuestionText(before) ||
        !habit_edit_goal_same(question.goal, before.goal) {
            return true
        }
        if edit.goal_focused != 0 &&
        (AppTextFromCString(*edit.goal_low[index][0], 16) != AppTextFromCString(*original.goal_low[index][0], 16) ||
            AppTextFromCString(*edit.goal_high[index][0], 16) != AppTextFromCString(*original.goal_high[index][0], 16)) {
            return true
        }
    }
    if edit.span != 0 {
        for index: cast(s32)0..cast(s32)3 {
            if AppTextFromCString(*edit.span_typed[index][0], 8) !=
            AppTextFromCString(*original.span_typed[index][0], 8) {
                return true
            }
        }
    }
    return false
}

#program_export
habit_edit_request_leave :: (app: *InnerBreeze, route: s32) -> bool {
    if !habit_edit_changed(app) {
        return false
    }
    if app.modal.active != 0 && app.modal.type == cast(ModalType)ModalHabitUnsaved {
        return true
    }
    app.habit_edit_exit_route = route
    app_open_modal(app, cast(ModalType)ModalHabitUnsaved)
    return true
}

#program_export
habit_edit_back :: (app: *InnerBreeze) {
    if habit_edit_request_leave(app, HABIT_EDIT_EXIT_BACK) {
        return
    }
    habit_edit_cancel(app)
    app_switch_screen(app, ScreenHabits)
}

#program_export
habit_edit_resolve_leave :: (app: *InnerBreeze, action: s32) {
    route := app.habit_edit_exit_route
    app_close_modal(app)
    if action == 2 {
        habit_edit_commit(app)
        if app.habit_edit.active != 0 {
            return
        }
    } else if action == 3 {
        habit_edit_cancel(app)
        app_switch_screen(app, ScreenHabits)
    } else {
        return
    }
    if route != HABIT_EDIT_EXIT_BACK {
        app_apply_nav_route(app, route)
    }
}

habit_edit_cancel :: (app: *InnerBreeze) {
    if app == null {
        return
    }

    app.habit_edit = HabitEditState.{}
    app.habit_edit.index = -1
    app.habit_edit.color = Color.{.r = 99, .g = 196, .b = 165, .a = 255}
    app.habit_edit.sync_mode = HABIT_SYNC_NONE
    if app.breathing.screen == ScreenHabitEdit {
        app.habits.screen_mode = HABITS_SCREEN_OVERVIEW
        app.habits.selected = -1
        app.habits.tab = HABIT_TAB_WEEKLY
        app.habits.view_mode = HABIT_VIEW_WEEKLY
        app.habits.scroll = 0
    }
}

habit_edit_commit :: (app: *InnerBreeze) {
    if app == null || app.habit_edit.active == 0 {
        return
    }
    // A formula that does not read keeps the editor open on it.
    if app.habit_edit.schedule.repeat == HABIT_REPEAT_FORMULA &&
    !habit_edit_formula_valid(app) {
        return
    }
    HabitQuestionsKeepWorded(app.habit_edit.questions[:],
        *app.habit_edit.question_count)
    message := HabitsMessageFor(app, HABITS_COMMIT)
    message.active = app.habit_edit.active != 0
    message.is_new = app.habit_edit.is_new != 0
    message.index = app.habit_edit.index
    message.name = AppTextFromCString(*app.habit_edit.text[0], HABIT_NAME_SIZE)
    message.description = AppTextFromCString(*app.habit_edit.description[0], HABIT_DESCRIPTION_SIZE)
    message.color = app.habit_edit.color
    message.sync_activity = app.habit_edit.sync_activity
    message.sync_mode = app.habit_edit.sync_mode
    message.weekdays = HabitScheduleWeekdays(app.habit_edit.schedule)
    message.reminder_hour = app.habit_edit.reminder_hour
    message.counter_enabled = app.habit_edit.counter_enabled
    message.counter_target = app.habit_edit.counter_target
    message.name_error = app.habit_edit.name_error
    message = HabitsRun(message)
    app.habit_edit.name_error = message.name_error
    if message.name_error != 0 {
        app.habits.scroll = 0
        return
    }
    if !message.succeeded {
        return
    }
    if message.cancel_edit {
        habit_edit_cancel(app)
        HabitsAcceptView(app, message)
        if message.action == HABITS_OVERVIEW {
            app_auto_sync(app)
            save_settings(app)
            app_switch_screen(app, ScreenHabits)
        }
    }
}

// Shows the daily target as its number; an empty entry keeps the
// last target until the field is left.
habit_edit_counter_text :: (app: *InnerBreeze) {
    unused AppFormatS32(app.habit_edit.counter_target,
        app.habit_edit.counter_text[:])
    length := cast(s32)AppTextFromCString(*app.habit_edit.counter_text[0],
        cast(s32)app.habit_edit.counter_text.count).count
    app.habit_edit.counter_cursor = length
    app.habit_edit.counter_anchor = length
}

// A number goal's bounds as typed, in the slot's fields; a time goal's
// bounds are picked as minutes and need none.
habit_edit_goal_fill :: (app: *InnerBreeze, slot: s32, answer_type: s32,
    goal: HabitGoal) {
    edit := *app.habit_edit
    edit.goal_low[slot][0] = cast(u8)0
    edit.goal_high[slot][0] = cast(u8)0
    if answer_type != HABIT_ANSWER_NUMBER {
        return
    }
    if goal.low >= 0 {
        unused AppFormatS32(goal.low, edit.goal_low[slot][:])
    }
    if goal.high >= 0 {
        unused AppFormatS32(goal.high, edit.goal_high[slot][:])
    }
}

// Every question's typed fields from their goals, as after questions move.
habit_edit_goal_fill_all :: (app: *InnerBreeze) {
    edit := *app.habit_edit
    index: s32 = 0
    while index < edit.question_count {
        habit_edit_goal_fill(app, index, edit.questions[index].answer_type,
            edit.questions[index].goal)
        index += 1
    }
}

habit_edit_focus_only :: (app: *InnerBreeze, field: s32) {
    app.habit_edit.focused = ifx field == 1 then 1 else 0
    app.habit_edit.description_focused = ifx field == 2 then 1 else 0
    app.habit_edit.counter_focused = ifx field == 3 then 1 else 0
    app.habit_edit.coin_focused = ifx field == 7 then 1 else 0
    app.habit_edit.formula_focused = ifx field == 4 then 1 else 0
    if field != 5 {
        app.habit_edit.question_focused = 0
    }
    if field != 6 {
        app.habit_edit.goal_focused = 0
    }
}

habit_edit_formula_valid :: (app: *InnerBreeze) -> bool {
    return HabitFormulaValid(
        HabitScheduleFormulaText(*app.habit_edit.schedule))
}

habit_edit_span_fill :: (app: *InnerBreeze) {
    edit := *app.habit_edit
    values: [2]s32 = .[edit.span_goal.low, edit.span_goal.high]
    for bound: cast(s32)0..cast(s32)1 {
        unused AppFormatS32(values[bound] / 60, edit.span_typed[bound * 2][:])
        minutes: [8]u8
        unused AppFormatS32(values[bound] % 60, minutes[:])
        if values[bound] % 60 < 10 {
            unused AppCopyText("0", edit.span_typed[bound * 2 + 1][:])
            unused AppAppendText(AppTextFromCString(*minutes[0], 8),
                edit.span_typed[bound * 2 + 1][:])
        } else {
            unused AppCopyText(AppTextFromCString(*minutes[0], 8),
                edit.span_typed[bound * 2 + 1][:])
        }
    }
}

habit_edit_confirmation :: (app: *InnerBreeze, deleting: bool) -> s32 {
    result := HabitsUiDraw(HabitsUiFrame.{.session = app.ui.session},
        ifx deleting then HABITS_DELETE_DIALOG else HABITS_UNSAVED_DIALOG,
        cast(*void)app)
    if result.drawn {
        return result.action
    }
    // Keep editor confirmations working with an older installed Habits
    // package. Both paths use the same package-owned composition.
    native := HabitEditorDialog(HabitEditorDialogProps.{
            .session = app.ui.session, .deleting = deleting,
            .title = LocaleText(ifx deleting then "habit_delete_title" else "habit_unsaved_title"),
            .message = LocaleText(ifx deleting then "habit_delete_message" else "habit_unsaved_message"),
            .keep_editing = LocaleText("habit_keep_editing"),
            .save = LocaleText("save_button"), .discard = LocaleText("discard_button"),
            .cancel = LocaleText("cancel_button"), .delete_label = LocaleText("delete_button")})
    return native.action
}

// ---- The editor, which Habits draws ------------------------------------------

habit_edit_frame: HabitsEditFrame;
habit_edit_frame_codec: WidgetHabitsEditFrameCodec;
habit_edit_question_codec: WidgetHabitsEditQuestionCodec;
habit_edit_practice_codec: WidgetHabitsEditPracticeCodec;

HabitEditText :: (buffer: []u8) -> string {
    return AppTextFromCString(*buffer[0], cast(s32)buffer.count)
}

habit_edit_question_value :: (app: *InnerBreeze, index: s32) -> HabitsEditQuestion {
    edit := *app.habit_edit
    question := *edit.questions[index]
    return HabitsEditQuestion.{.id = question.id, .answer_type = question.answer_type,
        .text = HabitQuestionText(question), .goal_kind = question.goal.kind,
        .goal_low = question.goal.low, .goal_high = question.goal.high,
        .low_text = HabitEditText(edit.goal_low[index][:]),
        .high_text = HabitEditText(edit.goal_high[index][:])}
}

// Keeps a question the editor changed, as far as its kinds allow.
habit_edit_keep_question :: (app: *InnerBreeze, index: s32, changed: HabitsEditQuestion) -> bool {
    edit := *app.habit_edit
    if index < 0 || index >= edit.question_count ||
    changed.answer_type < HABIT_ANSWER_TEXT || changed.answer_type > HABIT_ANSWER_YES_NO ||
    changed.goal_kind < HABIT_GOAL_NONE || changed.goal_kind > HABIT_GOAL_BELOW_AVERAGE {
        return false
    }
    question := *edit.questions[index]
    // VM strings are borrowed only during this call.
    if !AppCopyText(changed.text, question.text[:]) ||
    !AppCopyText(changed.low_text, edit.goal_low[index][:]) ||
    !AppCopyText(changed.high_text, edit.goal_high[index][:]) {
        return false
    }
    question.answer_type = changed.answer_type
    question.goal = HabitGoal.{.kind = changed.goal_kind, .low = changed.goal_low,
        .high = changed.goal_high}
    return true
}

HabitEditCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "habit_edit_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ReadHabitsEditHost" && count == 0 {
        result.* = WidgetEncodeHabitsEditFrame(habit_edit_frame, *habit_edit_frame_codec)
        return 1
    }
    if name == "WriteHabitsEditHost" && count == 1 && WidgetValidHabitsEditFrame(arguments[0]) {
        habit_edit_keep(app, WidgetDecodeHabitsEditFrame(arguments[0], *habit_edit_frame_codec))
        return 1
    }
    if name == "ReadHabitsEditQuestionHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        question: HabitsEditQuestion
        if index >= 0 && index < app.habit_edit.question_count {
            question = habit_edit_question_value(app, index)
        }
        result.* = WidgetEncodeHabitsEditQuestion(question, *habit_edit_question_codec)
        return 1
    }
    if name == "WriteHabitsEditQuestionHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    WidgetValidHabitsEditQuestion(arguments[1]) {
        kept := habit_edit_keep_question(app, cast(s32)arguments[0].integer,
            WidgetDecodeHabitsEditQuestion(arguments[1], *habit_edit_question_codec))
        result.* = HostScalar("bool", ifx kept then 1 else 0)
        return 1
    }
    if name == "ReadHabitsEditPracticeHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        practice: HabitsEditPractice
        if index >= 0 && index < EXERCISE_COUNT {
            id := practice_ordered_id(index)
            practice = HabitsEditPractice.{.label = habit_edit_practice_label(id),
                .mask = habit_activity_mask_for(id)}
        }
        result.* = WidgetEncodeHabitsEditPractice(practice, *habit_edit_practice_codec)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// The editor's frame: the habit being edited and its fields as kept.
habit_edit_frame_for :: (app: *InnerBreeze, picking: bool, field: []u8,
    area: []u8) -> HabitsEditFrame {
    edit := *app.habit_edit
    rule := *edit.schedule
    card := CardProps(Rectangle.{})
    local := LocalNow()
    typing := edit.focused != 0 || edit.counter_focused != 0 || edit.coin_focused != 0 ||
    edit.formula_focused != 0 || edit.question_focused != 0 || edit.goal_focused != 0
    return HabitsEditFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .view_width = app.ui.view_width,
        .view_height = app.ui.view_height, .font = AppFontSize(),
        .small_font = AppSmallFontSize(), .text_color = StyleTokenColor("text"),
        .canvas_color = StyleTokenColor("canvas"), .card_fill = card.fill,
        .card_border = card.border, .muted_class = MutedTextClass(),
        .ink_dark_class = KssClassId(KssMakeName("ink-dark")),
        .ink_light_class = KssClassId(KssMakeName("ink-light")),
        .picking_practices = picking, .today = habits_today_index(),
        .now = ifx local.valid then local.hour * 60 + local.minute else 0,
        .is_new = edit.is_new != 0, .name = HabitEditText(edit.text[:]),
        .name_cursor = edit.cursor, .name_anchor = edit.name_anchor,
        .name_scroll_x = edit.name_scroll_x, .name_focused = edit.focused != 0,
        .name_error = edit.name_error, .description = HabitEditText(edit.description[:]),
        .description_cursor = edit.description_cursor,
        .description_anchor = edit.description_anchor,
        .description_scroll_y = edit.description_scroll_y,
        .description_focused = edit.description_focused != 0,
        .color = edit.color, .more_colors = edit.more_colors != 0, .icon = edit.icon,
        .more_icons = edit.more_icons != 0, .repeat = rule.repeat, .every = rule.every,
        .start = rule.start, .weekdays = rule.weekdays, .month_days = rule.month_days,
        .last_day = rule.last_day != 0, .week_of_month = rule.week_of_month,
        .formula = HabitScheduleFormulaText(rule), .formula_cursor = edit.formula_cursor,
        .formula_anchor = edit.formula_anchor, .formula_scroll_x = edit.formula_scroll_x,
        .formula_focused = edit.formula_focused != 0, .reminder_hour = edit.reminder_hour,
        .difficulty = edit.difficulty, .custom_coins = edit.custom_coins,
        .coin_halves = edit.coin_halves, .coin_text = HabitEditText(edit.coin_text[:]),
        .coin_cursor = edit.coin_cursor, .coin_anchor = edit.coin_anchor,
        .coin_scroll_x = edit.coin_scroll_x, .coin_focused = edit.coin_focused != 0,
        .counter_enabled = edit.counter_enabled != 0, .counter_target = edit.counter_target,
        .counter_text = HabitEditText(edit.counter_text[:]),
        .counter_cursor = edit.counter_cursor, .counter_anchor = edit.counter_anchor,
        .counter_scroll_x = edit.counter_scroll_x,
        .counter_focused = edit.counter_focused != 0, .span = edit.span != 0,
        .span_kind = edit.span_goal.kind, .span_low = edit.span_goal.low,
        .span_high = edit.span_goal.high,
        .span_low_hours = HabitEditText(edit.span_typed[0][:]),
        .span_low_minutes = HabitEditText(edit.span_typed[1][:]),
        .span_high_hours = HabitEditText(edit.span_typed[2][:]),
        .span_high_minutes = HabitEditText(edit.span_typed[3][:]),
        .sync_activity = edit.sync_activity, .practice_count = EXERCISE_COUNT,
        .question_count = edit.question_count, .question_focused = edit.question_focused,
        .question_cursor = edit.question_cursor, .question_anchor = edit.question_anchor,
        .question_scroll_x = edit.question_scroll_x, .goal_focused = edit.goal_focused,
        .goal_cursor = edit.goal_cursor, .goal_anchor = edit.goal_anchor,
        .goal_scroll_x = edit.goal_scroll_x, .scroll = app.habits.scroll,
        .input = SampleTextFieldInput(typing, field),
        .area_input = SampleTextAreaInput(edit.description_focused != 0, area)}
}

habit_edit_clamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

// Keeps what the editor changed, within the values a habit can take.
habit_edit_keep :: (app: *InnerBreeze, observed: HabitsEditFrame) {
    edit := *app.habit_edit
    rule := *edit.schedule
    // VM strings are borrowed only during this call; a text too long for
    // its field keeps the one before.
    unused AppCopyText(observed.name, edit.text[:])
    unused AppCopyText(observed.description, edit.description[:])
    unused AppCopyText(observed.counter_text, edit.counter_text[:])
    unused AppCopyText(observed.coin_text, edit.coin_text[:])
    unused AppCopyText(observed.span_low_hours, edit.span_typed[0][:])
    unused AppCopyText(observed.span_low_minutes, edit.span_typed[1][:])
    unused AppCopyText(observed.span_high_hours, edit.span_typed[2][:])
    unused AppCopyText(observed.span_high_minutes, edit.span_typed[3][:])
    unused HabitScheduleSetFormula(rule, observed.formula)
    if observed.clipboard_write {
        unused TextInputWriteClipboard(observed.clipboard_text)
    }
    edit.cursor = observed.name_cursor
    edit.name_anchor = observed.name_anchor
    edit.name_scroll_x = observed.name_scroll_x
    edit.focused = ifx observed.name_focused then 1 else 0
    edit.name_error = habit_edit_clamp(observed.name_error, 0, 2)
    edit.description_cursor = observed.description_cursor
    edit.description_anchor = observed.description_anchor
    edit.description_scroll_y = observed.description_scroll_y
    edit.description_focused = ifx observed.description_focused then 1 else 0
    edit.color = observed.color
    edit.color.a = 255
    edit.more_colors = ifx observed.more_colors then 1 else 0
    if observed.icon == HABIT_ICON_LETTER ||
    (observed.icon >= 0 && observed.icon <= HABIT_ICON_COUNT) {
        edit.icon = observed.icon
    }
    edit.more_icons = ifx observed.more_icons then 1 else 0
    rule.repeat = habit_edit_clamp(observed.repeat, HABIT_REPEAT_DAILY, HABIT_REPEAT_NONE)
    rule.every = habit_edit_clamp(observed.every, 1, HABIT_SCHEDULE_EVERY_MAX)
    rule.start = observed.start
    rule.weekdays = observed.weekdays & 127
    rule.month_days = observed.month_days & 0x7fffffff
    rule.last_day = ifx observed.last_day then 1 else 0
    rule.week_of_month = habit_edit_clamp(observed.week_of_month, -1, 5)
    edit.formula_cursor = observed.formula_cursor
    edit.formula_anchor = observed.formula_anchor
    edit.formula_scroll_x = observed.formula_scroll_x
    edit.formula_focused = ifx observed.formula_focused then 1 else 0
    edit.reminder_hour = habit_edit_clamp(observed.reminder_hour, -1, 23)
    edit.difficulty = habit_edit_clamp(observed.difficulty, 0, HABIT_DIFFICULTY_COUNT - 1)
    edit.custom_coins = observed.custom_coins
    edit.coin_halves = observed.coin_halves
    edit.coin_cursor = observed.coin_cursor
    edit.coin_anchor = observed.coin_anchor
    edit.coin_scroll_x = observed.coin_scroll_x
    edit.coin_focused = ifx observed.coin_focused then 1 else 0
    edit.counter_enabled = ifx observed.counter_enabled then 1 else 0
    edit.counter_target = habit_edit_clamp(observed.counter_target, 0, HABIT_COUNTER_TARGET_MAX)
    edit.counter_cursor = observed.counter_cursor
    edit.counter_anchor = observed.counter_anchor
    edit.counter_scroll_x = observed.counter_scroll_x
    edit.counter_focused = ifx observed.counter_focused then 1 else 0
    edit.span = ifx observed.span then 1 else 0
    edit.span_goal = HabitGoal.{
        .kind = habit_edit_clamp(observed.span_kind, HABIT_GOAL_NONE, HABIT_GOAL_BELOW_AVERAGE),
        .low = observed.span_low, .high = observed.span_high}
    edit.sync_activity = observed.sync_activity & ((cast(s32)1 << EXERCISE_COUNT) - 1)
    edit.question_focused = habit_edit_clamp(observed.question_focused, 0, edit.question_count)
    edit.question_cursor = observed.question_cursor
    edit.question_anchor = observed.question_anchor
    edit.question_scroll_x = observed.question_scroll_x
    edit.goal_focused = observed.goal_focused
    edit.goal_cursor = observed.goal_cursor
    edit.goal_anchor = observed.goal_anchor
    edit.goal_scroll_x = observed.goal_scroll_x
    app.habits.scroll = observed.scroll
    habit_edit_frame.action = observed.action
    habit_edit_frame.action_index = observed.action_index
}

// Does what the editor asked for once it is drawn.
habit_edit_apply :: (app: *InnerBreeze, action: s32, index: s32) {
    edit := *app.habit_edit
    if action == HABITS_EDIT_BACK {
        habit_edit_back(app)
    } else if action == HABITS_EDIT_SAVE {
        habit_edit_commit(app)
    } else if action == HABITS_EDIT_DELETE && edit.is_new == 0 {
        app_open_modal(app, cast(ModalType)ModalConfirmDeleteHabit)
    } else if action == HABITS_EDIT_PRACTICES {
        app_open_modal(app, cast(ModalType)ModalHabitPracticePicker)
    } else if action == HABITS_EDIT_PRACTICES_DONE {
        app_close_modal(app)
    } else if action == HABITS_EDIT_ADD_QUESTION &&
    HabitQuestionAdd(edit.questions[:], *edit.question_count, UnixNow()) {
        habit_edit_goal_fill(app, edit.question_count - 1, HABIT_ANSWER_TEXT, HabitGoal.{})
        edit.question_focused = edit.question_count
        edit.question_cursor = 0
        edit.question_anchor = 0
        edit.question_scroll_x = 0
        habit_edit_focus_only(app, 5)
    } else if action == HABITS_EDIT_REMOVE_QUESTION && index >= 0 &&
    index < edit.question_count {
        HabitQuestionRemove(edit.questions[:], *edit.question_count, index)
        edit.question_focused = 0
        edit.goal_focused = 0
        habit_edit_goal_fill_all(app)
    }
}

// Has Habits draw the editor, or its practice picker.
habit_edit_run :: (app: *InnerBreeze, picking: bool) {
    field: [64]u8
    area: [128]u8
    habit_edit_frame = habit_edit_frame_for(app, picking, field[:], area[:])
    habit_edit_frame.action = HABITS_EDIT_NONE
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(HabitEditCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_EDIT_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    action := habit_edit_frame.action
    index := habit_edit_frame.action_index
    habit_edit_frame = HabitsEditFrame.{}
    if drawn.succeeded {
        habit_edit_apply(app, action, index)
    } else if picking {
        app_close_modal(app)
    }
}

habit_edit_modal :: (app: *InnerBreeze) -> bool {
    if app.modal.active == 0 { return false }
    if app.modal.type == cast(ModalType)ModalHabitUnsaved {
        action := habit_edit_confirmation(app, false)
        if action != 0 {
            habit_edit_resolve_leave(app, action)
        }
    } else if app.modal.type == cast(ModalType)ModalHabitPracticePicker {
        habit_edit_run(app, true)
    } else if app.modal.type == cast(ModalType)ModalConfirmDeleteHabit {
        action := habit_edit_confirmation(app, true)
        if action != 0 {
            app_close_modal(app)
            if action == 2 {
                index := app.habit_edit.index
                habit_edit_cancel(app)
                habits_delete(*app.habits, index)
                unused app_auto_sync(app)
                save_settings(app)
                app_switch_screen(app, ScreenHabits)
            }
        }
    }
    return true
}

habit_edit_draw_form :: (app: *InnerBreeze) {
    if habit_edit_modal(app) { return }
    if TextInputKeyPressed(TextInputKeyEscape) {
        habit_edit_back(app)
        return
    }
    habit_edit_run(app, false)
}

habit_edit_draw :: (app: *InnerBreeze) {
    if app == null { return }
    if app.habit_edit.active == 0 {
        app_switch_screen(app, ScreenHabits)
        return
    }
    root: ColumnProps
    root.key = KeyHash("habit_edit/root")
    Screen(app.ui.session, root)
    habit_edit_draw_form(app)
    unused End(app.ui.session)
}
