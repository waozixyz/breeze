habits_day_index :: (days_ago: s32) -> s32 {
    local := LocalNow()
    if !local.valid || days_ago < 0 || days_ago > HABIT_WEEKLY_MAX_DAYS {
        return habits_today_index()
    }
    result := HabitDayIndexAgo(local.year, local.month, local.day, days_ago)
    return ifx (result > 0) then (result) else (habits_today_index())
}

#program_export
habits_screen_dismiss_first_run_guide :: (app: *InnerBreeze) {
    if app == null { return }
    app.habits_guide_seen = 1
    app.habits_guide_step = 0
    HabitScreenSave(app)
}

#program_export
habits_screen_first_run_guide_active :: (app: *InnerBreeze) -> s32 {
    if app == null || app.habits_guide_seen != 0 ||
    habits_active_count(*app.habits) <= 0 || app.modal.active != 0 ||
    app.breathing.screen != ScreenHabits ||
    storage_has_sync_account() != 0 { return 0 }
    return 1
}

#program_export
habits_screen_prepare_first_run_guide :: (app: *InnerBreeze) {
    if habits_screen_first_run_guide_active(app) == 0 { return }
    if app.habits_guide_step < 0 { app.habits_guide_step = 0 }
    if app.habits_guide_step >= HABITS_GUIDE_STEPS {
        app.habits_guide_step = HABITS_GUIDE_STEPS - 1
    }
    app.habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app.habits.selected = -1
    if app.habits_guide_step >= 2 {
        app.habits.selected = habits_active_at(*app.habits, 0)
    }
    app.habits.tab = HABIT_TAB_WEEKLY
    app.habits.view_mode = HABIT_VIEW_WEEKLY
}

#program_export
habits_screen_draw_first_run_guide :: (app: *InnerBreeze) {
    if habits_screen_first_run_guide_active(app) == 0 { return }
    steps: [HABITS_GUIDE_STEPS]GuideOverlayStep
    steps[0] = GuideOverlayStep.{app.habits_guide_anchors[0],
        LocaleText("habits_guide_overview_progress")}
    steps[1] = GuideOverlayStep.{app.habits_guide_anchors[1],
        LocaleText("habits_guide_overview_grid")}
    steps[2] = GuideOverlayStep.{app.habits_guide_anchors[2],
        LocaleText("habits_guide_meditation_views")}
    steps[3] = GuideOverlayStep.{app.habits_guide_anchors[3],
        LocaleText("habits_guide_meditation_statistics")}
    steps[4] = GuideOverlayStep.{app.habits_guide_anchors[4],
        LocaleText("habits_guide_meditation_edit")}
    steps[5] = GuideOverlayStep.{app.habits_guide_anchors[5],
        LocaleText("habits_guide_meditation_session_data")}
    props: GuideOverlayProps
    props.steps = *steps[0]
    props.count = HABITS_GUIDE_STEPS
    props.step = *app.habits_guide_step
    props.view_width = app.ui.view_width
    props.view_height = app.ui.view_height
    props.reserved_bottom = app_content_bottom_reserved(app)
    props.max_width = AppScale(300)
    props.paragraph_font = AppFontSize()
    props.previous_requested = app.ui.manual_previous
    props.next_requested = app.ui.manual_next
    props.close_requested = app.ui.manual_close
    result := GuideOverlay(props)
    if result.changed != 0 { HabitScreenSave(app) }
    if result.finished != 0 || result.closed != 0 {
        habits_screen_dismiss_first_run_guide(app)
    }
}

HabitScreenCompletion :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> bool {
    habit := *app.habits.items[index]
    if habit_completed_day(habit, day_index) != 0 { return true }
    if habit_is_linked(habit) == 0 { return false }
    linked := habit_cached_linked_entries(app, index, day_index)
    if linked == null { return false }
    if habit_counting_enabled(habit) != 0 {
        return HabitEffectiveDayCount(habit, day_index, linked) >=
        habit_counter_target(habit)
    }
    return HabitLinkedHasDay(linked, day_index)
}

HabitScreenDueToday :: (app: *InnerBreeze) -> s32 {
    due: s32 = 0
    today := habits_today_index()
    index: s32 = 0
    while index < app.habits.count {
        if habit_scheduled_day(*app.habits.items[index], today) != 0 {
            due += 1
        }
        index += 1
    }
    return due
}

HabitScreenDoneToday :: (app: *InnerBreeze) -> s32 {
    done: s32 = 0
    today := habits_today_index()
    index: s32 = 0
    while index < app.habits.count {
        if habit_scheduled_day(*app.habits.items[index], today) != 0 &&
        HabitScreenCompletion(app, index, today) { done += 1 }
        index += 1
    }
    return done
}

// Linked practice sessions set the lowest count a day can have.
HabitScreenLinkedCount :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> s32 {
    return HabitLinkedSessionCountForDay(
        habit_cached_linked_entries(app, index, day_index), day_index)
}

HabitScreenDayCount :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> s32 {
    return HabitEffectiveDayCount(*app.habits.items[index], day_index,
        habit_cached_linked_entries(app, index, day_index))
}

// A step button draws its minus or plus as bars sized to the button, which
// read clearly where a "-" or "+" glyph is thin and small.
HabitScreenStepButton :: (app: *InnerBreeze, id: s32, bounds: Rectangle,
    plus: bool, disabled: bool) -> bool {
    props: ButtonProps
    props.id = id
    props.bounds = bounds
    props.tone = cast(ButtonTone)ButtonToneNeutral
    props.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    props.disabled = disabled
    clicked := Button(app.ui.session, props) != 0
    side := bounds.height
    if bounds.width < side { side = bounds.width }
    length := side * 0.36
    thickness := cast(float32)AppScale(3)
    center_x := bounds.x + bounds.width * 0.5
    center_y := bounds.y + bounds.height * 0.5
    color := StyleTokenColor("text")
    if disabled { color = Fade(color, 0.35) }
    PaintRoundedFill(app.ui.session, -1, Rectangle.{
            center_x - length * 0.5, center_y - thickness * 0.5,
            length, thickness}, thickness * 0.5, 6, color)
    if plus {
        PaintRoundedFill(app.ui.session, -1, Rectangle.{
                center_x - thickness * 0.5, center_y - length * 0.5,
                thickness, length}, thickness * 0.5, 6, color)
    }
    return clicked
}

HabitScreenAdjustCount :: (app: *InnerBreeze, index: s32,
    day_index: s32, delta: s32) {
    habit_step_count(app, index, day_index, delta)
    unused app_auto_sync(app)
}

// Counting habits open a dialog to count a day up or down; a tap alone
// would only ever add one.
HabitScreenOpenCount :: (app: *InnerBreeze, index: s32, day_index: s32) {
    app.habits.count_dialog_habit = index
    app.habits.count_dialog_day = day_index
    app_open_modal(app, cast(ModalType)ModalHabitCount)
}

HabitScreenDayAction :: (app: *InnerBreeze, index: s32,
    day_index: s32, decrement: bool) {
    if app == null || index < 0 || index >= app.habits.count {
        return
    }
    habit := *app.habits.items[index]
    message := HabitsMessageFor(app, HABITS_DAY_ACTION)
    message.index = index
    message.modal_active = app.modal.active != 0
    message.scheduled = habit_scheduled_day(habit, day_index) != 0
    message.completed = HabitScreenCompletion(app, index, day_index)
    message.counter_enabled = habit_counting_enabled(habit)
    message.linked_count = HabitScreenLinkedCount(app, index, day_index)
    message.decrement = decrement
    message = HabitsRun(message)
    if !message.succeeded {
        return
    }
    if message.day_action == HABITS_DAY_DECREMENT {
        HabitScreenAdjustCount(app, index, day_index, -1)
    } else if message.day_action == HABITS_DAY_COUNT {
        HabitScreenOpenCount(app, index, day_index)
    } else if message.day_action == HABITS_DAY_LINKED {
        habit_open_linked_edit_page(app, index, day_index)
    } else if message.day_action == HABITS_DAY_TOGGLE {
        habit_toggle_day(*app.habits, index, day_index)
        unused app_auto_sync(app)
    }
    if message.block_click {
        app_block_current_click(app)
    }
}

// A day button. With a dot, as for a counting habit's calendar day, the
// label sits at the top and the day's dot with its count below it, and the
// dot rather than the button shows that the day is complete.
HabitScreenDayButton :: (app: *InnerBreeze, index: s32,
    day_index: s32, label: string, id: s32, bounds: Rectangle, dot: bool) {
    habit := *app.habits.items[index]
    scheduled := habit_scheduled_day(habit, day_index) != 0
    complete := HabitScreenCompletion(app, index, day_index)
    disabled := !scheduled && !complete
    filled := complete && !dot
    props: ButtonProps
    props.bounds = bounds
    props.id = id
    props.label = ifx (dot) then ("") else (label)
    props.tone = cast(ButtonTone)(ifx (filled) then
        (ButtonToneAccent) else (ButtonToneNeutral))
    props.emphasis = cast(ButtonEmphasis)(ifx (filled) then
        (ButtonEmphasisFilled) else (ButtonEmphasisSoft))
    props.selected = filled
    props.disabled = disabled || app.modal.active != 0
    clicked := Button(app.ui.session, props) != 0
    if dot {
        top := cast(s32)bounds.y + AppScale(3)
        number: TextProps
        number.bounds = HabitScreenRect(cast(s32)bounds.x, top,
            cast(s32)bounds.width, AppScale(18))
        number.text = label
        number.font = AppSmallFontSize()
        number.align = cast(TextAlign)TextAlignCenter
        number.vertical_align = cast(TextAlign)TextAlignCenter
        number.wrap = cast(TextWrap)TextWrapNone
        number.disabled = props.disabled
        Text(app.ui.session, number)
        count := HabitScreenDayCount(app, index, day_index)
        if count > 0 || complete {
            radius := AppScale(12)
            HabitScreenDayDot(app,
                cast(s32)(bounds.x + bounds.width / 2),
                cast(s32)(bounds.y + bounds.height) - AppScale(4) - radius,
                radius, habit.color, complete, true, count)
        }
    }
    if clicked {
        HabitScreenDayAction(app, index, day_index, false)
    }
    if !disabled && IsMouseButtonReleased(HABITS_MOUSE_RIGHT) &&
    app.ui.mouse_x >= cast(s32)bounds.x &&
    app.ui.mouse_y >= cast(s32)bounds.y &&
    app.ui.mouse_x < cast(s32)(bounds.x + bounds.width) &&
    app.ui.mouse_y < cast(s32)(bounds.y + bounds.height) {
        HabitScreenDayAction(app, index, day_index, true)
    }
}

HabitScreenWeekdayLabel :: (day_index: s32, column: s32) -> string {
    if column == 0 {
        return LocaleText("habits_today")
    }
    weekday := habit_weekday_bit(day_index)
    if weekday == 0 {
        return LocaleText("habit_day_mon")
    }
    if weekday == 1 {
        return LocaleText("habit_day_tue")
    }
    if weekday == 2 {
        return LocaleText("habit_day_wed")
    }
    if weekday == 3 {
        return LocaleText("habit_day_thu")
    }
    if weekday == 4 {
        return LocaleText("habit_day_fri")
    }
    if weekday == 5 {
        return LocaleText("habit_day_sat")
    }
    return LocaleText("habit_day_sun")
}

HabitScreenTextColor :: (background: Color) -> Color {
    luma := cast(s32)background.r * 299 + cast(s32)background.g * 587 +
    cast(s32)background.b * 114
    if luma >= 128000 {
        return Color.{0, 0, 0, 255}
    }
    return Color.{255, 255, 255, 255}
}

HabitScreenCircle :: (app: *InnerBreeze, x: s32, y: s32,
    radius: s32, color: Color) {
    bounds := HabitScreenRect(x - radius, y - radius, radius * 2,
        radius * 2)
    PaintRoundedFill(app.ui.session, -1, bounds,
        cast(float32)radius, 12, color)
}

HabitScreenLine :: (app: *InnerBreeze, x1: s32, y1: s32,
    x2: s32, y2: s32, color: Color) {
    PaintLine(app.ui.session, -1, Rectangle.{
            cast(float32)x1, cast(float32)y1,
            cast(float32)(x2 - x1), cast(float32)(y2 - y1)
        }, color)
}


// A day's dot: filled once the day is complete, showing the day's count
// when the habit counts and a check when it does not.
HabitScreenDayDot :: (app: *InnerBreeze, center_x: s32, center_y: s32,
    radius: s32, accent: Color, complete: bool, counting: bool, count: s32) {
    surface := StyleTokenColor("surface")
    foreground := StyleTokenColor("text")
    HabitScreenCircle(app, center_x, center_y + AppScale(1),
        radius + AppScale(2), Fade(Color.{0, 0, 0, 255}, 0.16))
    show_count := counting && count > 0
    if complete {
        HabitScreenCircle(app, center_x, center_y,
            radius + AppScale(1), LightenColor(accent, 16))
        HabitScreenCircle(app, center_x, center_y, radius, accent)
        if !show_count {
            check := HabitScreenTextColor(accent)
            HabitScreenLine(app, center_x - radius / 2, center_y,
                center_x - radius / 8, center_y + radius / 3, check)
            HabitScreenLine(app, center_x - radius / 8,
                center_y + radius / 3, center_x + radius / 2,
                center_y - radius / 3, check)
        }
    } else {
        HabitScreenCircle(app, center_x, center_y,
            radius + AppScale(1), Fade(foreground, 0.54))
        HabitScreenCircle(app, center_x, center_y,
            radius - AppScale(2), surface)
        if !show_count {
            HabitScreenCircle(app, center_x - AppScale(2),
                center_y - AppScale(3), ifx radius / 3 > AppScale(2) then
                (radius / 3) else (AppScale(2)),
                Fade(Color.{255, 255, 255, 255}, 0.16))
        }
    }

    if show_count {
        count_text := HabitScreenNumber(app, count)
        count_font := AppFitFontSize(count_text, radius * 2 - AppScale(2),
            radius + AppScale(4), AppScale(8))
        count_color := foreground
        if complete { count_color = HabitScreenTextColor(accent) }
        PaintLabel(app.ui.session, -1, count_text,
            center_x - AppTextWidth(count_text, count_font) / 2,
            center_y - AppTextLineHeight(count_font) / 2, count_font,
            count_color)
    }
}


HabitScreenStreak :: (app: *InnerBreeze, index: s32) -> s32 {
    streak: s32 = 0
    ago: s32 = 0
    while ago < 370 {
        day := habits_day_index(ago)
        habit := *app.habits.items[index]
        if habit_scheduled_day(habit, day) == 0 {
            ago += 1
            continue
        }
        if !HabitScreenCompletion(app, index, day) { break }
        streak += 1
        ago += 1
    }
    return streak
}

HabitScreenWeekProgress :: (app: *InnerBreeze, index: s32,
    scheduled: *s32) -> s32 {
    completed: s32 = 0
    due: s32 = 0
    ago: s32 = 0
    while ago < 7 {
        day := habits_day_index(ago)
        habit := *app.habits.items[index]
        if habit_scheduled_day(habit, day) != 0 {
            due += 1
            if HabitScreenCompletion(app, index, day) { completed += 1 }
        }
        ago += 1
    }
    scheduled.* = due
    return completed
}

HabitScreenMetric :: (app: *InnerBreeze, x: s32, y: s32,
    width: s32, height: s32, label: string, value: string,
    accent: Color) {
    surface := StyleTokenColor("surface")
    panel: BoxProps
    panel.bounds = HabitScreenRect(x, y, width, height)
    panel.fill = DarkenColor(surface, 3)
    panel.radius = cast(float32)AppScale(8)
    Box(app.ui.session, panel)
    bar: BoxProps
    bar.bounds = HabitScreenRect(x, y, AppScale(4), height)
    bar.fill = accent
    Box(app.ui.session, bar)
    label_props: TextProps
    label_props.bounds = HabitScreenRect(x + AppScale(14), y + AppScale(8),
        width - AppScale(18), AppScale(18))
    label_props.text = label
    label_props.font = AppSmallFontSize()
    label_props.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, label_props)
    value_props: TextProps
    value_props.bounds = HabitScreenRect(x + AppScale(14), y + AppScale(32),
        width - AppScale(18), AppScale(24))
    value_props.text = value
    value_props.font = AppFontSize()
    value_props.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, value_props)
}



// A habit's own icon, or the one its linked practice suggests; 0 when it
// has neither and shows the first letter of its name.
HabitScreenIconFor :: (app: *InnerBreeze, index: s32) -> s32 {
    habit := *app.habits.items[index]
    if habit.icon >= 1 && habit.icon <= HABIT_ICON_COUNT {
        return habit.icon
    }
    if habit.icon == HABIT_ICON_LETTER {
        return 0
    }
    if (habit.sync_activity & habit_activity_mask_for(EXERCISE_MEDITATION)) != 0 {
        return HABIT_ICON_LOTUS
    }
    if (habit.sync_activity & habit_activity_mask_for(EXERCISE_SUN_SALUTATION)) != 0 {
        return HABIT_ICON_YOGA
    }
    breathing := habit_activity_mask_for(EXERCISE_WIM_HOF) |
        habit_activity_mask_for(EXERCISE_PATTERNS)
    if (habit.sync_activity & breathing) != 0 {
        return HABIT_ICON_LUNGS
    }
    return 0
}

// The table's lines: one pixel high, or more on a dense screen.
HabitScreenHairline :: () -> s32 {
    height := AppScale(1)
    if height < 1 {
        height = 1
    }
    return height
}

// The first character of a name, whole even when it takes several bytes.
HabitScreenFirstLetter :: (name: string) -> string {
    if name.count == 0 {
        return ""
    }
    end: s64 = 1
    while end < name.count && (name[end] & cast(u8)192) == cast(u8)128 {
        end += 1
    }
    return name[0:end]
}

// A habit's icon: a circle in its colour with the icon, or the first letter
// of its name, in the colour that reads on it.
HabitScreenHabitIcon :: (app: *InnerBreeze, index: s32, bounds: Rectangle) {
    habit := *app.habits.items[index]
    radius := cast(s32)(bounds.width * 0.5)
    center_x := cast(s32)bounds.x + radius
    center_y := cast(s32)bounds.y + radius
    HabitScreenCircle(app, center_x, center_y, radius, habit.color)
    color := HabitScreenTextColor(habit.color)
    shape := HabitIconShape(HabitScreenIconFor(app, index))
    if shape.count > 0 {
        inset := bounds.width * 0.22
        PaintSvgIcon(app.ui.session, -1, shape, Rectangle.{bounds.x + inset,
                bounds.y + inset, bounds.width - inset * 2.0,
                bounds.height - inset * 2.0}, color)
        return
    }
    letter := HabitScreenFirstLetter(AppTextFromCString(*habit.name[0],
        HABIT_NAME_SIZE))
    font := AppFontSize()
    PaintLabel(app.ui.session, -1, letter,
        center_x - AppTextWidth(letter, font) / 2,
        center_y - AppTextLineHeight(font) / 2, font, color)
}

// One of the last seven days in a habit's row: its circle marks the day.
HabitScreenDayCell :: (app: *InnerBreeze, habit_index: s32, day_index: s32,
    column: s32, bounds: Rectangle) {
    habit := *app.habits.items[habit_index]
    linked := habit_cached_linked_entries(app, habit_index, day_index)
    count := HabitEffectiveDayCount(habit, day_index, linked)
    complete := HabitScreenCompletion(app, habit_index, day_index)
    scheduled := habit_scheduled_day(habit, day_index) != 0
    marker: ButtonProps
    marker.id = cast(s32)5200000 + habit_index * 16 + column
    marker.bounds = bounds
    marker.invisible = true
    marker.disabled = (!scheduled && !complete) || app.modal.active != 0
    clicked := Button(app.ui.session, marker) != 0
    if habit_index == habits_active_at(*app.habits, 0) && column == 0 {
        habits_first_day_bounds = bounds
    }
    center_x := cast(s32)(bounds.x + bounds.width * 0.5)
    center_y := cast(s32)(bounds.y + bounds.height * 0.5)
    radius := cast(s32)(bounds.width * 0.3)
    if radius > AppScale(14) {
        radius = AppScale(14)
    }
    if radius < AppScale(9) {
        radius = AppScale(9)
    }
    mouse_over := !marker.disabled &&
    app.ui.mouse_x >= cast(s32)bounds.x &&
    app.ui.mouse_x < cast(s32)(bounds.x + bounds.width) &&
    app.ui.mouse_y >= cast(s32)bounds.y &&
    app.ui.mouse_y < cast(s32)(bounds.y + bounds.height)
    if mouse_over {
        HabitScreenCircle(app, center_x, center_y, radius + AppScale(5),
            Fade(habit.color, 0.24))
    }
    HabitScreenDayDot(app, center_x, center_y, radius, habit.color, complete,
        habit_counting_enabled(habit) != 0, count)
    if clicked {
        HabitScreenDayAction(app, habit_index, day_index, false)
    }
}

// The day names over the table's day columns, today first.
HabitScreenTableHeader :: (app: *InnerBreeze, x: s32, y: s32,
    layout: HabitTableLayout, height: s32) {
    day_w := layout.day_width
    column: s32 = 0
    while column < layout.days {
        label := HabitScreenWeekdayLabel(habits_day_index(column), column)
        props: TextProps
        props.bounds = HabitScreenRect(x + column * day_w, y, day_w, height)
        props.text = label
        props.font = AppFitFontSize(label, day_w - AppScale(4),
            AppSmallFontSize(), AppScale(10))
        props.align = cast(TextAlign)TextAlignCenter
        props.vertical_align = cast(TextAlign)TextAlignCenter
        props.wrap = cast(TextWrap)TextWrapNone
        Text(app.ui.session, props)
        column += 1
    }
}

// A habit's row: its icon and name, which open its details and drag it to
// another place, and then a circle for each of the last seven days.
// Returns true when the row was tapped.
HabitScreenRow :: (app: *InnerBreeze, index: s32, bounds: Rectangle,
    layout: HabitTableLayout, pad: s32, open: bool) -> bool {
    habit := *app.habits.items[index]
    row: ButtonProps
    row.id = 4200 + index
    row.bounds = bounds
    row.tone = cast(ButtonTone)ButtonToneNeutral
    row.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    row.selected = open
    row.disabled = app.modal.active != 0
    tapped := HabitScreenRowDrag(app, index, row)
    clicked := Button(app.ui.session, row) != 0 || tapped
    node := TreeSubmitted(app.ui.session, TreeCurrentParent(app.ui.session),
        cast(u64)row.id, WidgetKindButton)
    TreeSetDragCapture(app.ui.session, node, HabitScreenRowDragAtOnce())
    HabitScreenRowFace(app, index, bounds, layout, pad)
    x := cast(s32)bounds.x + pad + layout.name_width
    column: s32 = 0
    while column < layout.days {
        HabitScreenDayCell(app, index, habits_day_index(column), column,
            HabitScreenRect(x + column * layout.day_width, cast(s32)bounds.y,
            layout.day_width, cast(s32)bounds.height))
        column += 1
    }
    return clicked
}

// A habit's icon and name at the start of its row; without room for the
// name, a smaller icon alone.
HabitScreenRowFace :: (app: *InnerBreeze, index: s32, bounds: Rectangle,
    layout: HabitTableLayout, pad: s32) {
    habit := *app.habits.items[index]
    icon_size := AppScale(ifx layout.names then HABITS_ROW_ICON_SIZE else HABITS_ROW_SMALL_ICON_SIZE)
    HabitScreenHabitIcon(app, index, HabitScreenRect(cast(s32)bounds.x + pad,
        cast(s32)(bounds.y + (bounds.height - cast(float32)icon_size) * 0.5),
        icon_size, icon_size))
    if !layout.names {
        return
    }
    name: TextProps
    name.bounds = HabitScreenRect(cast(s32)bounds.x + pad + icon_size +
        AppScale(10), cast(s32)bounds.y,
        layout.name_width - icon_size - AppScale(14), cast(s32)bounds.height)
    name.text = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE)
    name.font = AppFontSize()
    name.vertical_align = cast(TextAlign)TextAlignCenter
    name.wrap = cast(TextWrap)TextWrapEllipsis
    Text(app.ui.session, name)
}

// An open habit's details below its row: its description, its history,
// statistics and editor, and its current streak and this week's days.
HabitScreenRowDetailHeight :: (app: *InnerBreeze, index: s32) -> s32 {
    height := AppScale(8) + AppScale(52) + AppScale(12) + AppScale(64) +
        AppScale(14)
    if app.habits.items[index].description[0] != cast(u8)0 {
        height += AppScale(26)
    }
    return height
}

HabitScreenRowDetail :: (app: *InnerBreeze, index: s32, bounds: Rectangle,
    pad: s32) {
    habit := *app.habits.items[index]
    x := cast(s32)bounds.x + pad
    width := cast(s32)bounds.width - pad * 2
    y := cast(s32)bounds.y + AppScale(8)
    description := AppTextFromCString(*habit.description[0],
        HABIT_DESCRIPTION_SIZE)
    if description.count > 0 {
        text: TextProps
        text.bounds = HabitScreenRect(x, y, width, AppScale(22))
        text.text = description
        text.font = AppSmallFontSize()
        text.wrap = cast(TextWrap)TextWrapEllipsis
        Text(app.ui.session, text)
        y += AppScale(26)
    }
    action_size := AppScale(52)
    action_gap := (width - action_size * 3) / 2
    action_icons: [3]s32 = .[cast(s32)IconCalendar, cast(s32)IconStat, cast(s32)IconEdit]
    column: s32 = 0
    while column < 3 {
        action: ButtonProps
        action.id = 5600000 + index * 3 + column
        action.bounds = HabitScreenRect(x + column * (action_size + action_gap),
            y, action_size, action_size)
        action.icon_type = action_icons[column]
        action.icon_only = true
        action.tone = cast(ButtonTone)ButtonToneNeutral
        action.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        action.disabled = app.modal.active != 0
        if Button(app.ui.session, action) != 0 {
            if column == 0 {
                habits_open_history(app)
            } else if column == 1 {
                habits_open_statistics(app)
            } else {
                habit_edit_begin(app, index)
            }
        }
        if index == habits_active_at(*app.habits, 0) {
            app.habits_guide_anchors[2 + column] = action.bounds
        }
        column += 1
    }
    if index == habits_active_at(*app.habits, 0) {
        app.habits_guide_anchors[5] = app.habits_guide_anchors[1]
    }
    scheduled: s32 = 0
    done := HabitScreenWeekProgress(app, index, *scheduled)
    streak := HabitScreenStreak(app, index)
    streak_value: [64]u8
    statistics_format_day_count(*streak_value[0], 64, streak)
    streak_text := FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*streak_value[0], 64))
    week_value: [32]u8
    week_args: [2]FormatArg
    week_args[0].number = done
    week_args[1].number = scheduled
    unused FormatTemplate("%d / %d", week_args[:], week_value[:])
    week_text := FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*week_value[0], 32))
    metric_y := y + action_size + AppScale(12)
    metric_gap := AppScale(10)
    metric_width := (width - metric_gap) / 2
    HabitScreenMetric(app, x, metric_y, metric_width, AppScale(64),
        LocaleText("habit_stats_current_streak"), streak_text,
        habit.color)
    HabitScreenMetric(app, x + metric_width + metric_gap, metric_y,
        width - metric_width - metric_gap, AppScale(64),
        LocaleText("profile_progress_title"), week_text,
        LightenColor(habit.color, 18))
}

// The habit list shows active habits in their order; deactivated habits
// wait in their own list below it.
HabitScreenActiveIndices :: (app: *InnerBreeze, out: []s32) -> s32 {
    count: s32 = 0
    index: s32 = 0
    while index < app.habits.count && count < cast(s32)out.count {
        if app.habits.items[index].deactivated == 0 {
            out[count] = index
            count += 1
        }
        index += 1
    }
    return count
}


HabitScreenUpdateDrag :: (app: *InnerBreeze, point: Vector2) {
    app.habits.drag_pointer = point
    dx := point.x - app.habits.drag_origin.x
    dy := point.y - app.habits.drag_origin.y
    threshold := cast(float32)AppScale(6)
    if dx * dx + dy * dy >= threshold * threshold {
        app.habits.drag_moving = 1
    }
}

// A mouse drags a habit row as soon as it moves. On a touch screen a swipe
// over the rows scrolls them, so a row is lifted only once held.
HabitScreenRowDragAtOnce :: () -> bool {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_WEB) {
        return false
    }
    return true
}

HabitScreenBeginDrag :: (app: *InnerBreeze, index: s32, bounds: Rectangle,
    drag: PointerDrag, lifted: bool) {
    app.habits.dragging = 1
    app.habits.drag_habit = index
    app.habits.drag_lifted = ifx lifted then 1 else 0
    app.habits.drag_pressed_at = GetTime()
    app.habits.drag_moving = 0
    app.habits.drag_released = 0
    app.habits.drag_at_edge = 0
    app.habits.drag_scroll_carry = 0.0
    app.habits.drag_bounds = bounds
    app.habits.drag_origin = Vector2.{drag.x, drag.y}
    app.habits.drag_grab = Vector2.{drag.grab_x, drag.grab_y}
}

HabitScreenEndDrag :: (app: *InnerBreeze) {
    app.habits.dragging = 0
    app.habits.drag_habit = -1
    app.habits.drag_lifted = 0
    app.habits.drag_moving = 0
    app.habits.drag_released = 0
    app.habits.drag_at_edge = 0
    app.habits.drag_scroll_carry = 0.0
}

// The drop place and the dragged copy are outlined in the text colour,
// which stands out on every theme.
HabitScreenDragOutline :: (app: *InnerBreeze, bounds: Rectangle) {
    PaintRoundedOutline(app.ui.session, -1, bounds,
        cast(float32)AppScale(12), 12, cast(float32)AppScale(2),
        Fade(StyleTokenColor("text"), 0.8))
}

// Three short bars at a row's end show that the row can be dragged.
HabitScreenGrip :: (app: *InnerBreeze, bounds: Rectangle) {
    width := cast(float32)AppScale(18)
    thickness := cast(float32)AppScale(2)
    spacing := cast(float32)AppScale(5)
    x := bounds.x + bounds.width - cast(float32)AppScale(16) - width
    y := bounds.y + bounds.height * 0.5 - spacing - thickness * 0.5
    color := Fade(StyleTokenColor("text"), 0.45)
    bar: s32 = 0
    while bar < 3 {
        PaintRoundedFill(app.ui.session, -1, Rectangle.{x,
                y + cast(float32)bar * spacing, width, thickness},
            thickness * 0.5, 6, color)
        bar += 1
    }
}

// A habit's icon, name and grip, in a deactivated habit's row or in the
// copy that follows the pointer while a habit is dragged.
HabitScreenDragFace :: (app: *InnerBreeze, index: s32,
    bounds: Rectangle) {
    habit := *app.habits.items[index]
    icon_size := AppScale(32)
    HabitScreenHabitIcon(app, index, HabitScreenRect(
        cast(s32)bounds.x + AppScale(12),
        cast(s32)(bounds.y + (bounds.height - cast(float32)icon_size) * 0.5),
        icon_size, icon_size))
    name: TextProps
    name.bounds = HabitScreenRect(cast(s32)bounds.x + AppScale(54),
        cast(s32)bounds.y, cast(s32)bounds.width - AppScale(104),
        cast(s32)bounds.height)
    name.text = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE)
    name.font = AppFontSize()
    name.vertical_align = cast(TextAlign)TextAlignCenter
    name.wrap = cast(TextWrap)TextWrapEllipsis
    Text(app.ui.session, name)
    HabitScreenGrip(app, bounds)
}

// An inactive habit's row below the inactive habits' header. It drags like
// a habit's row: back into the habits above makes it active again.
HabitScreenDeactivatedRow :: (app: *InnerBreeze, index: s32,
    bounds: Rectangle) {
    row: ButtonProps
    row.id = 4900 + index
    row.bounds = bounds
    row.tone = cast(ButtonTone)ButtonToneNeutral
    row.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    row.disabled = app.modal.active != 0
    unused HabitScreenRowDrag(app, index, row)
    unused Button(app.ui.session, row)
    node := TreeSubmitted(app.ui.session, TreeCurrentParent(app.ui.session),
        cast(u64)row.id, WidgetKindButton)
    TreeSetDragCapture(app.ui.session, node, HabitScreenRowDragAtOnce())
    HabitScreenDragFace(app, index, bounds)
}

// The inactive habits' header row after the habits: their count and a
// chevron. A tap shows or hides their rows below it.
HabitScreenInactiveHeader :: (app: *InnerBreeze, bounds: Rectangle,
    count: s32, pad: s32) {
    text: [96]u8
    args: [1]FormatArg
    args[0].number = count
    unused FormatTemplate(LocaleText("habits_inactive_section"), args[:],
        text[:])
    header: ButtonProps
    header.id = 4110
    header.bounds = bounds
    header.label = FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*text[0], cast(s32)text.count))
    header.content_alignment = cast(ContentAlignment)ContentAlignmentStart
    header.tone = cast(ButtonTone)ButtonToneNeutral
    header.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    header.disabled = app.modal.active != 0
    open := app.habits.show_deactivated != 0
    clicked := Button(app.ui.session, header) != 0
    // The chevron at the row's end points down while the rows are hidden.
    chevron_x := cast(s32)(bounds.x + bounds.width) - pad - AppScale(12)
    chevron_y := cast(s32)(bounds.y + bounds.height * 0.5)
    span := AppScale(5)
    tip := ifx open then (chevron_y - span / 2) else (chevron_y + span / 2)
    ends := ifx open then (chevron_y + span / 2) else (chevron_y - span / 2)
    chevron_color := Fade(StyleTokenColor("text"), 0.7)
    HabitScreenLine(app, chevron_x - span, ends, chevron_x, tip, chevron_color)
    HabitScreenLine(app, chevron_x, tip, chevron_x + span, ends, chevron_color)
    if clicked {
        app.habits.show_deactivated = ifx open then 0 else 1
    }
}

// A press on a habit row that moves drags the row to another place in
// the list; the list keeps scrolling with a swipe until a touch is held.
// Returns true when the row was tapped without being dragged.
HabitScreenRowDrag :: (app: *InnerBreeze, index: s32,
    card: ButtonProps) -> bool {
    key := cast(u64)card.id
    previous := TreePrevious(app.ui.session,
        TreeCurrentParent(app.ui.session), key, WidgetKindButton)
    drag := TreeTakeDragAt(app.ui.session, previous)
    if drag.started && !card.disabled {
        HabitScreenBeginDrag(app, index, card.bounds, drag,
            HabitScreenRowDragAtOnce())
    }
    if app.habits.dragging == 0 || app.habits.drag_habit != index {
        return false
    }
    point := Vector2.{drag.x, drag.y}
    if drag.active && app.habits.drag_lifted == 0 {
        dx := point.x - app.habits.drag_origin.x
        dy := point.y - app.habits.drag_origin.y
        threshold := cast(float32)AppScale(6)
        if dx * dx + dy * dy >= threshold * threshold {
            // A swipe before the hold scrolls the list instead.
            HabitScreenEndDrag(app)
            return false
        }
        if GetTime() - app.habits.drag_pressed_at >= HABITS_CARD_HOLD_SECONDS {
            app.habits.drag_lifted = 1
            app.habits.drag_moving = 1
            TreeCapturePressAt(app.ui.session, previous)
        }
        return false
    }
    if drag.active {
        HabitScreenUpdateDrag(app, point)
        return false
    }
    if !drag.ended {
        return false
    }
    if app.habits.drag_lifted == 0 {
        HabitScreenEndDrag(app)
        return true
    }
    HabitScreenUpdateDrag(app, point)
    if app.habits.drag_moving == 0 {
        HabitScreenEndDrag(app)
        return TreeHoveredAt(app.ui.session, previous)
    }
    app.habits.drag_released = 1
    return false
}


// Scrolls the habit table while a dragged habit is near its top or bottom
// edge or past it, faster the further it goes.
HabitScreenEdgeScroll :: (app: *InnerBreeze, list: ScrollResult,
    point: Vector2) {
    now := GetTime()
    elapsed := cast(float32)(now - app.habits.drag_scroll_at)
    app.habits.drag_scroll_at = now
    if elapsed > 0.1 {
        elapsed = 0.1
    }
    margin := cast(float32)AppScale(HABITS_DRAG_EDGE_MARGIN)
    top := list.viewport.y + margin
    bottom := list.viewport.y + list.viewport.height - margin
    depth: float32 = 0.0
    if point.y < top {
        depth = (point.y - top) / margin
    } else if point.y > bottom {
        depth = (point.y - bottom) / margin
    }
    if depth > 2.0 {
        depth = 2.0
    }
    if depth < -2.0 {
        depth = -2.0
    }
    if depth == 0.0 {
        app.habits.drag_at_edge = 0
        app.habits.drag_scroll_carry = 0.0
        return
    }
    if app.habits.drag_at_edge == 0 {
        app.habits.drag_at_edge = 1
        app.habits.drag_edge_since = now
    }
    if now - app.habits.drag_edge_since < HABITS_DRAG_EDGE_WAIT_SECONDS {
        return
    }
    speed := cast(float32)AppScale(HABITS_DRAG_EDGE_SPEED)
    app.habits.drag_scroll_carry += speed * depth * elapsed
    step := cast(s32)app.habits.drag_scroll_carry
    app.habits.drag_scroll_carry -= cast(float32)step
    app.habits.scroll += step
    if app.habits.scroll < 0 {
        app.habits.scroll = 0
    }
    if app.habits.scroll > list.max_scroll {
        app.habits.scroll = list.max_scroll
    }
}

// While a habit is dragged over the habit list, the row it would take the
// place of is outlined, or the whole list when it would go last. Releasing
// it there moves a row to that place or reactivates a deactivated habit.
// A row dragged onto the inactive habits below the list becomes inactive.
HabitScreenDrop :: (app: *InnerBreeze, list: ScrollResult,
    cards: []Rectangle, count: s32, gap: s32, section: Rectangle) {
    if app.habits.dragging == 0 {
        return
    }
    dragged := app.habits.drag_habit
    if dragged < 0 || dragged >= app.habits.count {
        HabitScreenEndDrag(app)
        return
    }
    reactivating := app.habits.items[dragged].deactivated != 0
    point := app.habits.drag_pointer
    // Over the inactive habits, a habit is dropped among them.
    in_section := app.habits.drag_moving != 0 && section.height > 0.0 &&
        PointInBounds(point.x, point.y, section)
    target: s32 = -1
    if app.habits.drag_moving != 0 && !in_section &&
    PointInBounds(point.x, point.y, list.viewport) {
        target = count
        highlight := list.viewport
        half := cast(float32)(gap / 2)
        position: s32 = 0
        while position < count {
            area := cards[position]
            area.x -= half
            area.y -= half
            area.width += half * 2.0
            area.height += half * 2.0
            if PointInBounds(point.x, point.y, area) {
                target = position
                highlight = RectangleIntersection(cards[position],
                    list.viewport)
                break
            }
            position += 1
        }
        HabitScreenDragOutline(app, highlight)
    }
    over_section := !reactivating && in_section
    if over_section {
        HabitScreenDragOutline(app, section)
    }
    if app.habits.drag_released != 0 {
        if over_section {
            habits_deactivate(*app.habits, dragged)
            unused app_auto_sync(app)
            HabitScreenSave(app)
        } else if target >= 0 {
            if reactivating {
                unused habits_reactivate(*app.habits, dragged, target)
            } else {
                unused habits_move_active(*app.habits, dragged, target)
            }
            unused app_auto_sync(app)
            HabitScreenSave(app)
        }
        HabitScreenEndDrag(app)
        app_block_current_click(app)
        return
    }
    if app.habits.drag_moving == 0 {
        return
    }
    HabitScreenEdgeScroll(app, list, point)
    lifted := app.habits.drag_bounds
    lifted.x = point.x - app.habits.drag_grab.x
    lifted.y = point.y - app.habits.drag_grab.y
    radius := cast(float32)AppScale(12)
    PaintRoundedFill(app.ui.session, -1, lifted, radius, 12,
        StyleTokenColor("surface"))
    HabitScreenDragOutline(app, lifted)
    HabitScreenDragFace(app, dragged, lifted)
}

HabitScreenOverview :: (app: *InnerBreeze,
    geometry: HabitScreenGeometry) {
    heading_h := AppScale(34)
    button_h := AppScale(42)
    gap := AppScale(12)
    add_label := LocaleText("habit_new_button")
    add_width := AppTextWidth(add_label, AppFontSize()) + AppScale(40)
    if add_width < AppScale(120) {
        add_width = AppScale(120)
    }
    if add_width > geometry.width * 2 / 3 {
        add_width = geometry.width * 2 / 3
    }
    heading: TextProps
    heading.bounds = HabitScreenRect(geometry.x, geometry.y,
        geometry.width - add_width - gap, heading_h)
    heading.text = LocaleText("tab_habits")
    heading.font = AppTitleFontSize(heading.text,
        cast(s32)heading.bounds.width)
    heading.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, heading)
    add_button := HabitScreenButtonProps(app, add_label, 4100,
        geometry.x + geometry.width - add_width, geometry.y,
        add_width, button_h, false, app.habits.count >= HABIT_MAX)
    add_button.tone = cast(ButtonTone)ButtonToneAccent
    add_button.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    add_button.pill = true
    if Button(app.ui.session, add_button) != 0 {
        habit_edit_begin_new(app)
        return
    }
    summary_y := geometry.y + heading_h + gap
    due := HabitScreenDueToday(app)
    done := HabitScreenDoneToday(app)
    summary_text: [96]u8
    summary_args: [2]FormatArg
    summary_args[0].number = done
    summary_args[1].number = due
    unused FormatTemplate(LocaleText("habits_done_count_label"),
        summary_args[:], summary_text[:])
    formatted_summary := FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*summary_text[0],
        size_of(type_of(summary_text))))
    summary: TextProps
    summary.bounds = HabitScreenRect(geometry.x, summary_y,
        geometry.width, AppScale(24))
    summary.text = formatted_summary
    summary.font = AppFontSize()
    summary.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, summary)
    app.habits_guide_anchors[0] = HabitScreenRect(geometry.x, summary_y,
        geometry.width, AppScale(24))
    progress_y := summary_y + AppScale(28)
    progress_w := geometry.width
    if progress_w > AppScale(420) {
        progress_w = AppScale(420)
    }
    progress_bounds := HabitScreenRect(geometry.x, progress_y,
        progress_w, AppScale(6))
    PaintRoundedFill(app.ui.session, -1, progress_bounds,
        cast(float32)AppScale(3), 8,
        Fade(StyleTokenColor("text"), 0.12f))
    if due > 0 && done > 0 {
        progress_fill := progress_w * done / due
        if progress_fill > progress_w {
            progress_fill = progress_w
        }
        PaintRoundedFill(app.ui.session, -1,
            HabitScreenRect(geometry.x, progress_y,
            progress_fill, AppScale(6)),
            cast(float32)AppScale(3), 8,
            StyleTokenColor("accent"))
    }
    // Habits without an icon get one the node's GLM service chooses.
    if HabitIconChoicePoll(*app.habits) {
        habits_save(*app.habits)
        unused app_auto_sync(app)
        HabitScreenSave(app)
    }
    unused HabitIconChoiceStart(*app.habits)
    if app.habits.dragging != 0 {
        pointer := PointerSample(app.ui.session)
        if !pointer.down && !pointer.released {
            HabitScreenEndDrag(app)
        } else if app.habits.drag_lifted != 0 {
            HabitScreenUpdateDrag(app, Vector2.{pointer.x, pointer.y})
            if pointer.released {
                app.habits.drag_released = 1
            }
        }
    }
    active: [HABIT_MAX]s32
    active_count := HabitScreenActiveIndices(app, active[:])
    selected_position: s32 = -1
    position: s32 = 0
    while position < active_count {
        if active[position] == app.habits.selected {
            selected_position = position
        }
        position += 1
    }
    deactivated_count := app.habits.count - active_count
    show_section := app.habits.count > 0
    list_y := summary_y + AppScale(54)
    list_bottom := geometry.y + geometry.height
    header_h := AppScale(HABITS_TABLE_HEADER_HEIGHT)
    rows_y := list_y + header_h
    if list_bottom < rows_y {
        list_bottom = rows_y
    }
    viewport := HabitScreenRect(geometry.x, rows_y, geometry.width,
        list_bottom - rows_y)
    row_h := AppScale(HABITS_ROW_HEIGHT)
    detail_h: s32 = 0
    if selected_position >= 0 {
        detail_h = HabitScreenRowDetailHeight(app, active[selected_position])
    }
    active_h := active_count * row_h + detail_h
    if active_count == 0 {
        active_h = AppScale(80)
    }
    // After the habits, the inactive habits' header, and their rows when it
    // is open.
    section_h: s32 = 0
    inactive_row_h := AppScale(HABITS_DEACTIVATED_ROW_HEIGHT)
    if show_section {
        section_h = AppScale(HABITS_INACTIVE_HEADER_HEIGHT)
        if app.habits.show_deactivated != 0 {
            section_h += AppScale(HABITS_DEACTIVATED_HINT_HEIGHT) +
                deactivated_count * inactive_row_h
        }
    }
    content_h := active_h + section_h
    // The table's panel holds the day names and the rows, as tall as the
    // rows need up to the space there is.
    panel_rows_h := content_h
    if panel_rows_h > cast(s32)viewport.height {
        panel_rows_h = cast(s32)viewport.height
    }
    panel: BoxProps
    panel.bounds = HabitScreenRect(geometry.x, list_y, geometry.width,
        header_h + panel_rows_h)
    panel.fill = StyleTokenColor("surface")
    panel.border = Fade(StyleTokenColor("text"), 0.12)
    panel.radius = cast(float32)AppScale(14)
    Box(app.ui.session, panel)
    scrolled := HabitScreenScroll(app, "inbe/habits/overview", viewport,
        content_h)
    if !scrolled.opened { return }
    pad := AppScale(12)
    table_x := cast(s32)scrolled.content.x
    table_w := cast(s32)scrolled.content.width
    layout := HabitTableLayoutFor(table_w - pad * 2,
        AppScale(HABITS_NAME_PREFERRED_WIDTH), AppScale(HABITS_NAME_MIN_WIDTH),
        AppScale(HABITS_ICON_COLUMN_WIDTH), AppScale(HABITS_DAY_MIN_WIDTH),
        AppScale(HABITS_DAY_MAX_WIDTH))
    if active_count == 0 {
        empty: TextProps
        empty.bounds = HabitScreenRect(table_x + pad,
            cast(s32)scrolled.content.y + AppScale(10),
            table_w - pad * 2, AppScale(48))
        empty.text = LocaleText("habit_empty_title")
        empty.font = AppFontSize()
        empty.wrap = cast(TextWrap)TextWrapNone
        Text(app.ui.session, empty)
    }
    rows: [HABIT_MAX]Rectangle
    position = 0
    while position < active_count {
        index := active[position]
        open := position == selected_position
        row := HabitScreenRect(table_x,
            cast(s32)scrolled.content.y + HabitRowOffset(position,
            selected_position, row_h, detail_h), table_w, row_h)
        rows[position] = row
        if position > 0 {
            PaintRoundedFill(app.ui.session, -1, HabitScreenRect(table_x + pad,
                cast(s32)row.y, table_w - pad * 2, HabitScreenHairline()), 0.0,
                1, Fade(StyleTokenColor("text"), 0.08))
        }
        if position == 0 {
            app.habits_guide_anchors[1] = row
        }
        if HabitScreenRow(app, index, row, layout, pad, open) {
            End(app.ui.session)
            if open {
                habits_collapse_card(app)
            } else {
                habits_expand_card(app, index)
            }
            return
        }
        if open {
            HabitScreenRowDetail(app, index, HabitScreenRect(table_x,
                cast(s32)(row.y + row.height), table_w, detail_h), pad)
        }
        position += 1
    }
    section := HabitScreenRect(table_x,
        cast(s32)scrolled.content.y + active_h, table_w, section_h)
    if show_section {
        PaintRoundedFill(app.ui.session, -1, HabitScreenRect(table_x,
            cast(s32)section.y, table_w, HabitScreenHairline()), 0.0, 1,
            Fade(StyleTokenColor("text"), 0.12))
        HabitScreenInactiveHeader(app, HabitScreenRect(table_x,
            cast(s32)section.y, table_w,
            AppScale(HABITS_INACTIVE_HEADER_HEIGHT)),
            deactivated_count, pad)
    }
    if show_section && app.habits.show_deactivated != 0 {
        y := cast(s32)section.y + AppScale(HABITS_INACTIVE_HEADER_HEIGHT)
        hint: TextProps
        hint.bounds = HabitScreenRect(table_x + pad, y, table_w - pad * 2,
            AppScale(HABITS_DEACTIVATED_HINT_HEIGHT))
        hint.text = LocaleText("habits_deactivated_hint")
        hint.font = AppSmallFontSize()
        hint.vertical_align = cast(TextAlign)TextAlignCenter
        hint.wrap = cast(TextWrap)TextWrapAuto
        Text(app.ui.session, hint)
        y += AppScale(HABITS_DEACTIVATED_HINT_HEIGHT)
        index: s32 = 0
        while index < app.habits.count {
            if app.habits.items[index].deactivated != 0 {
                HabitScreenDeactivatedRow(app, index, HabitScreenRect(table_x,
                    y, table_w, inactive_row_h))
                y += inactive_row_h
            }
            index += 1
        }
    }
    End(app.ui.session)
    HabitScreenTableHeader(app, table_x + pad + layout.name_width, list_y,
        layout, header_h)
    PaintRoundedFill(app.ui.session, -1, HabitScreenRect(geometry.x, rows_y,
        geometry.width, HabitScreenHairline()), 0.0, 1,
        Fade(StyleTokenColor("text"), 0.12))
    HabitScreenDrop(app, scrolled, rows[:], active_count, 0,
        RectangleIntersection(section, scrolled.viewport))
}
// A habit's pages are separate: its view (week or calendar), its
// statistics, and its editor. Each has only Back and its own title here;
// none of them links sideways into the others.
HabitScreenPageHeader :: (app: *InnerBreeze,
    geometry: HabitScreenGeometry, index: s32, subtitle: string) -> s32 {
    y := geometry.y
    habit := *app.habits.items[index]
    if Button(app.ui.session, HabitScreenButtonProps(app, LocaleText("back_button"), 4300,
        geometry.x, y, AppScale(72), AppScale(40), false, false)) != 0 {
        habits_return_to_overview(app)
        return -1
    }
    name := AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE)
    title: TextProps
    title.bounds = HabitScreenRect(geometry.x + AppScale(82), y,
        geometry.width - AppScale(82), AppScale(40))
    title.text = name
    title.font = AppTitleFontSize(name, geometry.width - AppScale(82))
    title.vertical_align = cast(TextAlign)TextAlignCenter
    title.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, title)
    y += AppScale(44)
    if subtitle.count > 0 {
        label: TextProps
        label.bounds = HabitScreenRect(geometry.x + AppScale(82), y,
            geometry.width - AppScale(82), AppScale(24))
        label.text = subtitle
        label.font = AppSmallFontSize()
        label.wrap = cast(TextWrap)TextWrapNone
        Text(app.ui.session, label)
        y += AppScale(32)
    } else {
        y += AppScale(8)
    }
    return y
}

// The habit view switches only between its week list and its calendar.
HabitScreenViewSwitch :: (app: *InnerBreeze,
    geometry: HabitScreenGeometry, top: s32) -> s32 {
    options: [2]SegmentOption = .[
    SegmentOption.{.label = LocaleText("habit_focus_week")},
    SegmentOption.{.label = LocaleText("habit_focus_calendar")}
    ]
    props: SegmentedControlProps
    props.id = 4301
    props.bounds = HabitScreenRect(geometry.x, top, geometry.width, AppScale(42))
    props.height = AppScale(42)
    props.selected_index = ifx (app.habits.view_mode == HABIT_VIEW_CALENDAR) then (1) else (0)
    props.has_selection = true
    props.disabled = app.modal.active != 0
    switch := SegmentedControl(app.ui.session, props, options[:])
    if switch.changed {
        app.habits.view_mode = ifx (switch.selected_index == 1) then (HABIT_VIEW_CALENDAR) else (HABIT_VIEW_WEEKLY)
        app.habits.scroll = 0
        HabitScreenSave(app)
    }
    return top + AppScale(54)
}

HabitScreenWeekly :: (app: *InnerBreeze,
    geometry: HabitScreenGeometry, index: s32, top: s32) {
    row_h := AppScale(46)
    gap := AppScale(8)
    count := app.habits.weekly_days
    if count < HABIT_WEEKLY_INITIAL_DAYS { count = HABIT_WEEKLY_INITIAL_DAYS }
    if count > HABIT_WEEKLY_MAX_DAYS { count = HABIT_WEEKLY_MAX_DAYS }
    app.habits.weekly_days = count
    content_h := count * (row_h + gap) + AppScale(52)
    viewport := HabitScreenRect(geometry.x, top, geometry.width,
        geometry.height - (top - geometry.y))
    scrolled := HabitScreenScroll(app, "inbe/habits/week", viewport, content_h)
    if !scrolled.opened { return }
    first_row := (scrolled.scroll_offset - row_h) / (row_h + gap)
    if first_row < 0 { first_row = 0 }
    last_row := (scrolled.scroll_offset + cast(s32)viewport.height +
        row_h) / (row_h + gap)
    if last_row >= count { last_row = count - 1 }
    row := first_row
    while row <= last_row {
        row_y := cast(s32)scrolled.content.y + row * (row_h + gap)
        day := habits_day_index(row)
        label := HabitScreenDate(app, day)
        habit := *app.habits.items[index]
        if habit_counting_enabled(habit) != 0 {
            linked := habit_cached_linked_entries(app, index, day)
            count_today := HabitEffectiveDayCount(habit, day, linked)
            count_text: [64]u8
            count_args: [5]FormatArg
            count_args[0].number = day / 10000
            count_args[1].number = (day / 100) % 100
            count_args[2].number = day % 100
            count_args[3].number = count_today
            count_args[4].number = habit_counter_target(habit)
            unused FormatTemplate("%04d-%02d-%02d  %d/%d",
                count_args[:], count_text[:])
            label = FrameTextHold(*app.ui.frame_text,
                AppTextFromCString(*count_text[0], cast(s32)count_text.count))
        }
        HabitScreenDayButton(app, index, day, label, 4400 + row,
            HabitScreenRect(geometry.x, row_y, geometry.width, row_h), false)
        row += 1
    }
    if count < HABIT_WEEKLY_MAX_DAYS {
        button_y := cast(s32)scrolled.content.y + count * (row_h + gap)
        if Button(app.ui.session, HabitScreenButtonProps(app, LocaleText("habit_load_more_button"),
            4500, geometry.x, button_y, geometry.width,
            AppScale(42), false, false)) != 0 {
            app.habits.weekly_days += HABIT_WEEKLY_LOAD_DAYS
            if app.habits.weekly_days > HABIT_WEEKLY_MAX_DAYS {
                app.habits.weekly_days = HABIT_WEEKLY_MAX_DAYS
            }
        }
    }
    app.habits_guide_anchors[5] = HabitScreenRect(
        geometry.x, top, geometry.width, row_h)
    End(app.ui.session)
}

HabitScreenMonthParts :: (app: *InnerBreeze, year: *s32,
    month: *s32) {
    local := LocalNow()
    year.* = local.year
    month.* = local.month + app.habits.month_offset
    while month.* < 1 { month.* += 12; year.* -= 1 }
    while month.* > 12 { month.* -= 12; year.* += 1 }
}

HabitScreenCalendar :: (app: *InnerBreeze,
    geometry: HabitScreenGeometry, index: s32, top: s32) {
    year: s32
    month: s32
    HabitScreenMonthParts(app, *year, *month)
    if !DateValid(year, month, 1) { return }
    header_h := AppScale(42)
    gap := AppScale(6)
    arrow_w := AppScale(48)
    if Button(app.ui.session, HabitScreenButtonProps(app, "<", 4600, geometry.x, top,
        arrow_w, header_h, false, false)) != 0 {
        app.habits.month_offset -= 1
    }
    if Button(app.ui.session, HabitScreenButtonProps(app, ">", 4601,
        geometry.x + geometry.width - arrow_w, top,
        arrow_w, header_h, false,
        app.habits.month_offset >= 0)) != 0 {
        app.habits.month_offset += 1
    }
    title := HabitScreenMonth(app, year, month)
    month_title: TextProps
    month_title.bounds = HabitScreenRect(geometry.x + arrow_w + gap,
        top, geometry.width - (arrow_w + gap) * 2, header_h)
    month_title.text = title
    month_title.font = AppFontSize()
    month_title.align = cast(TextAlign)TextAlignCenter
    month_title.vertical_align = cast(TextAlign)TextAlignCenter
    month_title.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, month_title)
    first := DaysFromCivil(year, month, 1)
    weekday := cast(s32)((first + 3) % 7)
    cell_w := (geometry.width - gap * 6) / 7
    counting := habit_counting_enabled(*app.habits.items[index]) != 0
    // A counting habit's day holds its date above its count.
    cell_h := AppScale(ifx counting then 56 else 50)
    today := habits_today_index()
    day: s32 = 1
    while DateValid(year, month, day) {
        slot := weekday + day - 1
        column := slot % 7
        row := slot / 7
        x := geometry.x + column * (cell_w + gap)
        y := top + header_h + gap + row * (cell_h + gap)
        day_index := year * 10000 + month * 100 + day
        if day_index <= today {
            label := HabitScreenNumber(app, day)
            HabitScreenDayButton(app, index, day_index, label,
                4700 + slot, HabitScreenRect(x, y, cell_w, cell_h),
                counting)
        }
        day += 1
    }
}

HabitScreenCountText :: (app: *InnerBreeze, bounds: Rectangle,
    text: string, font: s32) {
    props: TextProps
    props.bounds = bounds
    props.text = text
    props.font = font
    props.align = cast(TextAlign)TextAlignCenter
    props.vertical_align = cast(TextAlign)TextAlignCenter
    props.wrap = cast(TextWrap)TextWrapNone
    Text(app.ui.session, props)
}

// The count dialog: the day's count with large steps down and up. Linked
// practice sessions are the floor, and their sessions open from here.
HabitScreenCountDialog :: (app: *InnerBreeze) {
    if app.modal.active == 0 ||
    app.modal.type != cast(ModalType)ModalHabitCount { return }
    index := app.habits.count_dialog_habit
    day_index := app.habits.count_dialog_day
    if index < 0 || index >= app.habits.count || day_index <= 0 ||
    habit_counting_enabled(*app.habits.items[index]) == 0 {
        app_close_modal(app)
        return
    }
    habit := *app.habits.items[index]
    count := HabitScreenDayCount(app, index, day_index)
    linked_count := HabitScreenLinkedCount(app, index, day_index)
    gap := AppScale(12)
    step_h := AppScale(56)
    button_h := AppScale(44)
    content_h := AppScale(24) + AppScale(64) + AppScale(24) + gap +
    step_h + gap + button_h
    if linked_count > 0 { content_h += button_h + gap }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("habits/count-dialog"),
            .title = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE),
            .width = AppScale(340), .height = content_h + AppScale(74),
            .scale = MetricsScale(),
            .has_right_action = true,
            .right_label = LocaleText("close_button")})
    if frame.dismissed || frame.right_clicked {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    content := frame.layout.content
    x := cast(s32)content.x
    y := cast(s32)content.y
    width := cast(s32)content.width

    day_text := HabitScreenDate(app, day_index)
    if day_index == habits_today_index() {
        day_text = LocaleText("habits_today")
    }
    HabitScreenCountText(app, HabitScreenRect(x, y, width, AppScale(24)),
        day_text, AppSmallFontSize())
    y += AppScale(24)
    HabitScreenCountText(app, HabitScreenRect(x, y, width, AppScale(64)),
        HabitScreenNumber(app, count), AppScale(Text48))
    y += AppScale(64)
    target_text: [96]u8
    target_args: [2]FormatArg
    target_args[0].text = LocaleText("habit_counter_target")
    target_args[0].is_text = true
    target_args[1].number = habit_counter_target(habit)
    unused FormatTemplate("%s  %d", target_args[:], target_text[:])
    HabitScreenCountText(app, HabitScreenRect(x, y, width, AppScale(24)),
        FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*target_text[0], cast(s32)target_text.count)),
        AppSmallFontSize())
    y += AppScale(24) + gap

    step_w := (width - gap) / 2
    if HabitScreenStepButton(app, 5720000,
        HabitScreenRect(x, y, step_w, step_h), false, count <= linked_count) {
        HabitScreenAdjustCount(app, index, day_index, -1)
    }
    if HabitScreenStepButton(app, 5720001,
        HabitScreenRect(x + width - step_w, y, step_w, step_h), true, false) {
        HabitScreenAdjustCount(app, index, day_index, 1)
    }
    y += step_h + gap

    if linked_count > 0 {
        sessions_text: [96]u8
        sessions_args: [1]FormatArg
        sessions_args[0].number = linked_count
        unused FormatTemplate(LocaleText(ifx (linked_count == 1)
            then ("session_count_singular") else ("session_count_plural")),
            sessions_args[:], sessions_text[:])
        sessions: ButtonProps
        sessions.id = 5720002
        sessions.bounds = HabitScreenRect(x, y, width, button_h)
        sessions.label = FrameTextHold(*app.ui.frame_text,
            AppTextFromCString(*sessions_text[0],
            cast(s32)sessions_text.count))
        sessions.tone = cast(ButtonTone)ButtonToneNeutral
        sessions.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        if Button(app.ui.session, sessions) != 0 {
            unused End(app.ui.session)
            habit_open_linked_edit_page(app, index, day_index)
            return
        }
        y += button_h + gap
    }
    done: ButtonProps
    done.id = 5720003
    done.bounds = HabitScreenRect(x, y, width, button_h)
    done.label = LocaleText("done_button")
    done.tone = cast(ButtonTone)ButtonToneNeutral
    done.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    if Button(app.ui.session, done) != 0 {
        app_close_modal(app)
    }
    unused End(app.ui.session)
}

#program_export
draw_habits_screen :: (app: *InnerBreeze) {
    if app == null { return }
    HabitScreenDrawPage(app)
    HabitScreenCountDialog(app)
}

HabitScreenDrawPage :: (app: *InnerBreeze) {
    habits_first_day_bounds = Rectangle.{}
    geometry := HabitScreenLayout(app)
    if geometry.width <= 0 || geometry.height <= 0 { return }
    if app.habits.screen_mode == HABITS_SCREEN_OVERVIEW || app.habits.count <= 0 ||
    app.habits.selected < 0 || app.habits.selected >= app.habits.count ||
    app.habits.items[app.habits.selected].deactivated != 0 {
        HabitScreenOverview(app, geometry)
        return
    }
    selected := app.habits.selected
    if app.habits.screen_mode == HABITS_SCREEN_STATISTICS {
        top := HabitScreenPageHeader(app, geometry, selected,
            LocaleText("habit_statistics_title"))
        if top < 0 { return }
        draw_statistics_content(app, top)
        return
    }
    top := HabitScreenPageHeader(app, geometry, selected, "")
    if top < 0 { return }
    top = HabitScreenViewSwitch(app, geometry, top)
    if app.habits.view_mode == HABIT_VIEW_CALENDAR {
        HabitScreenCalendar(app, geometry, selected, top)
    } else {
        HabitScreenWeekly(app, geometry, selected, top)
    }
}

#program_export
habits :: (app: *InnerBreeze) { draw_habits_screen(app) }
