HABITS_GUIDE_STEPS :: 7;
// The name column's width in design units, as Habits clamps it.
HABITS_NAME_MIN_WIDTH :: 72;
HABITS_NAME_MAXIMUM_WIDTH :: 320;
// The first habit's today marker from the last drawn frame; the web smoke
// test clicks it.
habits_first_day_bounds: Rectangle;

HabitScreenGeometry :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
}

HabitScreenLayout :: (app: *InnerBreeze) -> HabitScreenGeometry {
    layout: HabitScreenGeometry
    if app == null { return layout }
    column := CenteredColumnFor(app.ui.view_width,
        AppScale(1120), AppScale(16))
    layout.x = column.x
    layout.width = column.width
    layout.y = AppScale(20)
    layout.height = app.ui.view_height - layout.y -
    app_content_bottom_reserved(app) - AppScale(12)
    if layout.height < 0 { layout.height = 0 }
    return layout
}

HabitScreenSave :: (app: *InnerBreeze) {
    save_settings(app)
    sync_web_storage_critical()
}

habits_expand_card :: (app: *InnerBreeze, index: s32) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_EXPAND)
    message.index = index
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        app.habits.reveal_selected = 1
        HabitScreenSave(app)
    }
}

habits_open_history :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_HISTORY)
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        HabitScreenSave(app)
    }
}

habits_open_statistics :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_STATISTICS)
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        HabitScreenSave(app)
    }
}

habits_return_to_overview :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_OVERVIEW)
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        HabitScreenSave(app)
    }
}

habits_collapse_card :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_COLLAPSE)
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        HabitScreenSave(app)
    }
}

habits_day_index :: (days_ago: s32) -> s32 {
    local := LocalNow()
    if !local.valid || days_ago < 0 || days_ago > HABIT_WEEKLY_MAX_DAYS {
        return habits_today_index()
    }
    result := HabitDayIndexAgo(local.year, local.month, local.day, days_ago)
    return ifx (result > 0) then (result) else (habits_today_index())
}

#program_export
habits_screen_dismiss_first_run_guide :: (app: *InnerBreeze) {
    if app == null { return }
    app.habits_guide_seen = 1
    app.habits_guide_step = 0
    HabitScreenSave(app)
}

#program_export
habits_screen_first_run_guide_active :: (app: *InnerBreeze) -> s32 {
    if app == null || app.habits_guide_seen != 0 ||
    habits_active_count(*app.habits) <= 0 || app.modal.active != 0 ||
    app.breathing.screen != ScreenHabits ||
    storage_has_sync_account() != 0 { return 0 }
    return 1
}

#program_export
habits_screen_prepare_first_run_guide :: (app: *InnerBreeze) {
    if habits_screen_first_run_guide_active(app) == 0 { return }
    if app.habits_guide_step < 0 { app.habits_guide_step = 0 }
    if app.habits_guide_step >= HABITS_GUIDE_STEPS {
        app.habits_guide_step = HABITS_GUIDE_STEPS - 1
    }
    app.habits.screen_mode = HABITS_SCREEN_OVERVIEW
    app.habits.selected = -1
    if app.habits_guide_step >= 3 {
        app.habits.selected = habits_active_at(*app.habits, 0)
    }
    app.habits.tab = HABIT_TAB_WEEKLY
    app.habits.view_mode = HABIT_VIEW_WEEKLY
}

#program_export
habits_screen_draw_first_run_guide :: (app: *InnerBreeze) {
    if habits_screen_first_run_guide_active(app) == 0 { return }
    steps: [HABITS_GUIDE_STEPS]GuideOverlayStep
    steps[0] = GuideOverlayStepFor(app.habits_guide_anchors[0],
        "habits_guide_overview_progress")
    steps[1] = GuideOverlayStepFor(app.habits_guide_anchors[6],
        "habits_guide_coins")
    steps[2] = GuideOverlayStepFor(app.habits_guide_anchors[1],
        "habits_guide_overview_grid")
    steps[3] = GuideOverlayStepFor(app.habits_guide_anchors[2],
        "habits_guide_meditation_views")
    steps[4] = GuideOverlayStepFor(app.habits_guide_anchors[3],
        "habits_guide_meditation_statistics")
    steps[5] = GuideOverlayStepFor(app.habits_guide_anchors[4],
        "habits_guide_meditation_edit")
    steps[6] = GuideOverlayStepFor(app.habits_guide_anchors[5],
        "habits_guide_meditation_session_data")
    props: GuideOverlayProps
    props.steps = *steps[0]
    props.count = HABITS_GUIDE_STEPS
    props.step = *app.habits_guide_step
    props.view_width = app.ui.view_width
    props.view_height = app.ui.view_height
    props.reserved_bottom = app_content_bottom_reserved(app)
    props.max_width = AppScale(300)
    props.paragraph_font = AppFontSize()
    props.previous_requested = app.ui.manual_previous
    props.next_requested = app.ui.manual_next
    props.close_requested = app.ui.manual_close
    result := GuideOverlay(props)
    if result.changed != 0 { HabitScreenSave(app) }
    if result.finished != 0 || result.closed != 0 {
        habits_screen_dismiss_first_run_guide(app)
    }
}

HabitScreenCompletion :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> bool {
    habit := *app.habits.items[index]
    linked := habit_cached_linked_entries(app, index, day_index)
    return HabitEffectiveDayComplete(habit, day_index, linked)
}

// Linked practice sessions set the lowest count a day can have.
HabitScreenLinkedCount :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> s32 {
    return HabitLinkedSessionCountForDay(
        habit_cached_linked_entries(app, index, day_index), day_index)
}

HabitScreenDayCount :: (app: *InnerBreeze, index: s32,
    day_index: s32) -> s32 {
    return HabitEffectiveDayCount(*app.habits.items[index], day_index,
        habit_cached_linked_entries(app, index, day_index))
}

HabitScreenAdjustCount :: (app: *InnerBreeze, index: s32,
    day_index: s32, delta: s32) {
    habit_step_count(app, index, day_index, delta)
    unused app_auto_sync(app)
}

// Counting habits open a dialog to count a day up or down; a tap alone
// would only ever add one.
HabitScreenOpenCount :: (app: *InnerBreeze, index: s32, day_index: s32) {
    app.habits.count_dialog_habit = index
    app.habits.count_dialog_day = day_index
    app_open_modal(app, cast(ModalType)ModalHabitCount)
}

HabitScreenDayAction :: (app: *InnerBreeze, index: s32,
    day_index: s32, decrement: bool) {
    if app == null || index < 0 || index >= app.habits.count {
        return
    }
    habit := *app.habits.items[index]
    message := HabitsMessageFor(app, HABITS_DAY_ACTION)
    message.index = index
    message.modal_active = app.modal.active != 0
    message.scheduled = habit_scheduled_day(habit, day_index) != 0
    message.completed = HabitScreenCompletion(app, index, day_index)
    message.counter_enabled = habit_counting_enabled(habit)
    message.linked_count = HabitScreenLinkedCount(app, index, day_index)
    message.question_count = habit.question_count
    message.span = habit.span != 0
    message.decrement = decrement
    message = HabitsRun(message)
    if !message.succeeded {
        return
    }
    if message.day_action == HABITS_DAY_DECREMENT {
        HabitScreenAdjustCount(app, index, day_index, -1)
    } else if message.day_action == HABITS_DAY_COUNT {
        HabitScreenOpenCount(app, index, day_index)
    } else if message.day_action == HABITS_DAY_LINKED {
        habit_open_linked_edit_page(app, index, day_index)
    } else if message.day_action == HABITS_DAY_QUESTIONS {
        HabitScreenQuestionsTap(app, index, day_index)
    } else if message.day_action == HABITS_DAY_SPAN {
        HabitScreenSpanTap(app, index, day_index)
    } else if message.day_action == HABITS_DAY_TOGGLE {
        habit_toggle_day(*app.habits, index, day_index)
        unused app_auto_sync(app)
    }
    if message.block_click {
        app_block_current_click(app)
    }
}

// Whether a day of a habit holds its running span.
HabitScreenSpanRunning :: (habit: *Habit, day_index: s32) -> bool {
    return habit.span != 0 && habit.running_entry[0] != cast(u8)0 &&
    habit.running_day == day_index
}

HabitScreenStreak :: (app: *InnerBreeze, index: s32) -> s32 {
    streak: s32 = 0
    ago: s32 = 0
    while ago < 370 {
        day := habits_day_index(ago)
        habit := *app.habits.items[index]
        if habit_scheduled_day(habit, day) == 0 {
            ago += 1
            continue
        }
        if !HabitScreenCompletion(app, index, day) { break }
        streak += 1
        ago += 1
    }
    return streak
}

HabitScreenWeekProgress :: (app: *InnerBreeze, index: s32,
    scheduled: *s32) -> s32 {
    completed: s32 = 0
    due: s32 = 0
    ago: s32 = 0
    while ago < 7 {
        day := habits_day_index(ago)
        habit := *app.habits.items[index]
        if habit_scheduled_day(habit, day) != 0 {
            due += 1
            if HabitScreenCompletion(app, index, day) { completed += 1 }
        }
        ago += 1
    }
    scheduled.* = due
    return completed
}

// A habit's own icon, or the one its linked practice suggests; 0 when it
// has neither and shows the first letter of its name.
HabitScreenIconFor :: (app: *InnerBreeze, index: s32) -> s32 {
    habit := *app.habits.items[index]
    if habit.icon >= 1 && habit.icon <= HABIT_ICON_COUNT {
        return habit.icon
    }
    if habit.icon == HABIT_ICON_LETTER {
        return 0
    }
    if (habit.sync_activity & habit_activity_mask_for(EXERCISE_MEDITATION)) != 0 {
        return HABIT_ICON_LOTUS
    }
    if (habit.sync_activity & habit_activity_mask_for(EXERCISE_SUN_SALUTATION)) != 0 {
        return HABIT_ICON_YOGA
    }
    if (habit.sync_activity & habit_activity_mask_for(EXERCISE_TAI_CHI)) != 0 {
        return HABIT_ICON_YIN_YANG
    }
    breathing := habit_activity_mask_for(EXERCISE_WIM_HOF) |
    habit_activity_mask_for(EXERCISE_PATTERNS)
    if (habit.sync_activity & breathing) != 0 {
        return HABIT_ICON_LUNGS
    }
    if (habit.sync_activity & HABIT_LINK_DIARY) != 0 {
        return HABIT_ICON_QUILL_PEN
    }
    return 0
}

// A tap on a day of a habit that asks questions: an open day takes a new
// entry, a done day opens its data.
HabitScreenQuestionsTap :: (app: *InnerBreeze, index: s32, day_index: s32) {
    if HabitScreenCompletion(app, index, day_index) {
        habit_open_linked_edit_page(app, index, day_index)
        return
    }
    HabitScreenOpenEntry(app, index, day_index, "")
}

// A tap on a day of a habit that measures spans. On its day or today the
// running span opens, so its end is picked there or it keeps running; a tap
// never ends it. Otherwise a day with spans opens their data, today starts
// one, and another day takes a span typed in.
HabitScreenSpanTap :: (app: *InnerBreeze, index: s32, day_index: s32) {
    habit := *app.habits.items[index]
    running: [HABIT_ENTRY_ID_SIZE]u8
    unused AppCopyText(AppTextFromCString(*habit.running_entry[0],
        HABIT_ENTRY_ID_SIZE), running[:])
    running_day := habit.running_day
    if running[0] != cast(u8)0 &&
    (day_index == running_day || day_index == habits_today_index()) {
        HabitScreenOpenEntry(app, index, running_day,
            AppTextFromCString(*running[0], HABIT_ENTRY_ID_SIZE))
        return
    }
    if storage_habit_day_has_entries(AppTextFromCString(*habit.id[0],
        HABIT_ID_SIZE), day_index, false) {
        habit_open_linked_edit_page(app, index, day_index)
        return
    }
    if day_index == habits_today_index() && running[0] == cast(u8)0 {
        unused habit_start_span(app, index)
        return
    }
    HabitScreenOpenEntry(app, index, day_index, "")
}

// The count dialog: the day's count with large steps down and up. Linked
// practice sessions are the floor, and their sessions open from here. The
// Habits package draws it (habits_view.zi); the host applies its step or
// opens the day.
HabitScreenCountDialog :: (app: *InnerBreeze) {
    if app.modal.active == 0 ||
    app.modal.type != cast(ModalType)ModalHabitCount { return }
    index := app.habits.count_dialog_habit
    day_index := app.habits.count_dialog_day
    if index < 0 || index >= app.habits.count || day_index <= 0 ||
    habit_counting_enabled(*app.habits.items[index]) == 0 {
        app_close_modal(app)
        return
    }
    habit := *app.habits.items[index]
    frame := HabitsUiFrame.{
        .session = app.ui.session,
        .scale = MetricsScale(),
        .small_font = AppSmallFontSize(),
        .text_color = StyleTokenColor("text"),
        .name = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE),
        .day = day_index,
        .today = day_index == habits_today_index(),
        .count = HabitScreenDayCount(app, index, day_index),
        .target = habit_counter_target(habit),
        .linked_count = HabitScreenLinkedCount(app, index, day_index),
        .asks = habit.question_count > 0}
    result := HabitsUiDraw(frame, HABITS_COUNT_DIALOG, cast(*void)app)
    if !result.drawn {
        app_close_modal(app)
        return
    }
    action := result.action
    if action == HABITS_COUNT_DECREMENT {
        HabitScreenAdjustCount(app, index, day_index, -1)
    } else if action == HABITS_COUNT_INCREMENT {
        HabitScreenAdjustCount(app, index, day_index, 1)
    } else if action == HABITS_COUNT_OPEN_DAY {
        habit_open_linked_edit_page(app, index, day_index)
    } else if action == HABITS_COUNT_CLOSE {
        if habit_counter_target(habit) == 0 &&
        HabitScreenDayCount(app, index, day_index) == 0 {
            unused habit_complete_day(app, index, day_index)
        }
        app_close_modal(app)
    }
}

// ---- The habit list, which Habits draws -------------------------------------

habit_list_frame: HabitsListFrame;
habit_list_frame_codec: WidgetHabitsListFrameCodec;
habit_list_row_codec: WidgetHabitsListRowCodec;
habit_list_day_codec: WidgetHabitsListDayCodec;

// A mouse drags a habit row as soon as it moves. On a touch screen a swipe
// over the rows scrolls them, so a row is lifted only once held.
HabitScreenTouch :: () -> bool {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_WEB) {
        return true
    }
    return false
}

// A habit as the list shows it. Its streak and this week's days only show
// in its details, so they are counted for the open habit alone.
HabitScreenListRow :: (app: *InnerBreeze, index: s32) -> HabitsListRow {
    habit := *app.habits.items[index]
    row := HabitsListRow.{
        .name = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE),
        .description = AppTextFromCString(*habit.description[0], HABIT_DESCRIPTION_SIZE),
        .color = habit.color, .icon = HabitScreenIconFor(app, index),
        .deactivated = habit.deactivated != 0,
        .counting = habit_counting_enabled(habit) != 0,
        .target = habit_counter_target(habit)}
    if index == app.habits.selected {
        planned: s32 = 0
        row.week_done = HabitScreenWeekProgress(app, index, *planned)
        row.week_planned = planned
        row.streak = HabitScreenStreak(app, index)
    }
    return row
}

HabitScreenListDay :: (app: *InnerBreeze, index: s32, day: s32) -> HabitsListDay {
    habit := *app.habits.items[index]
    linked := habit_cached_linked_entries(app, index, day)
    return HabitsListDay.{.day = day,
        .planned = habit_scheduled_day(habit, day) != 0,
        .complete = HabitEffectiveDayComplete(habit, day, linked),
        .count = HabitEffectiveDayCount(habit, day, linked),
        .running = HabitScreenSpanRunning(habit, day)}
}

HabitScreenListCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "habit_list_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ReadHabitsListHost" && count == 0 {
        result.* = WidgetEncodeHabitsListFrame(habit_list_frame, *habit_list_frame_codec)
        return 1
    }
    if name == "WriteHabitsListHost" && count == 1 && WidgetValidHabitsListFrame(arguments[0]) {
        habit_list_frame = WidgetDecodeHabitsListFrame(arguments[0], *habit_list_frame_codec)
        return 1
    }
    if name == "ReadHabitsListRowHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        row: HabitsListRow
        if index >= 0 && index < app.habits.count {
            row = HabitScreenListRow(app, index)
        }
        result.* = WidgetEncodeHabitsListRow(row, *habit_list_row_codec)
        return 1
    }
    if name == "ReadHabitsListDayHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        day := cast(s32)arguments[1].integer
        state := HabitsListDay.{.day = day}
        if index >= 0 && index < app.habits.count &&
        DateValid(day / 10000, (day / 100) % 100, day % 100) {
            state = HabitScreenListDay(app, index, day)
        }
        result.* = WidgetEncodeHabitsListDay(state, *habit_list_day_codec)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// The list's frame: the page's look and bounds, and the state the host
// keeps for it.
HabitScreenListFrame :: (app: *InnerBreeze, geometry: HabitScreenGeometry) -> HabitsListFrame {
    habits := *app.habits
    bounds := HabitScreenRect(geometry.x, geometry.y, geometry.width, geometry.height)
    card := CardProps(bounds)
    return HabitsListFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .bounds = bounds,
        .font = AppFontSize(), .small_font = AppSmallFontSize(),
        .text_color = StyleTokenColor("text"), .surface_color = StyleTokenColor("surface"),
        .accent_color = StyleTokenColor("accent"), .card_fill = card.fill,
        .card_border = card.border, .muted_class = MutedTextClass(),
        .ink_dark_class = KssClassId(KssMakeName("ink-dark")),
        .ink_light_class = KssClassId(KssMakeName("ink-light")),
        .modal_active = app.modal.active != 0, .touch = HabitScreenTouch(),
        .now = GetTime(), .today = habits_today_index(), .habit_count = habits.count,
        .habit_limit = HABIT_MAX, .halves = HabitShopBalance(app),
        .screen_mode = habits.screen_mode, .view_mode = habits.view_mode,
        .selected = habits.selected, .scroll = habits.scroll,
        .name_width = habits.name_width, .show_deactivated = habits.show_deactivated != 0,
        .reveal_selected = habits.reveal_selected != 0, .weekly_days = habits.weekly_days,
        .month_offset = habits.month_offset, .dragging = habits.dragging != 0,
        .drag_habit = habits.drag_habit, .drag_lifted = habits.drag_lifted != 0,
        .drag_moving = habits.drag_moving != 0, .drag_origin = habits.drag_origin,
        .drag_at_edge = habits.drag_at_edge != 0, .drag_edge_since = habits.drag_edge_since,
        .drag_scroll_at = habits.drag_scroll_at, .drag_scroll_carry = habits.drag_scroll_carry,
        .drag_pointer = habits.drag_pointer, .drag_grab = habits.drag_grab,
        .drag_bounds = habits.drag_bounds, .name_resizing = habits.name_resizing != 0,
        .name_resize_origin = habits.name_resize_origin,
        .name_resize_start = habits.name_resize_start}
}

// A guide anchor the page drew this frame; one it did not draw keeps the
// last place it had.
HabitScreenAnchor :: (app: *InnerBreeze, slot: s32, bounds: Rectangle) {
    if bounds.width > 0.0 && bounds.height > 0.0 {
        app.habits_guide_anchors[slot] = bounds
    }
}

// Keeps the state the page changed.
HabitScreenListKeep :: (app: *InnerBreeze, observed: HabitsListFrame) {
    habits := *app.habits
    habits.scroll = observed.scroll
    if observed.name_width >= HABITS_NAME_MIN_WIDTH &&
    observed.name_width <= HABITS_NAME_MAXIMUM_WIDTH {
        habits.name_width = observed.name_width
    }
    // The column's width is saved once its border is let go.
    if habits.name_resizing != 0 && !observed.name_resizing {
        SettingsBeginWrite()
        unused SettingsStoreInt("habits_name_width", habits.name_width)
        SettingsEndWrite()
    }
    habits.name_resizing = ifx observed.name_resizing then 1 else 0
    habits.name_resize_origin = observed.name_resize_origin
    habits.name_resize_start = observed.name_resize_start
    habits.show_deactivated = ifx observed.show_deactivated then 1 else 0
    habits.reveal_selected = ifx observed.reveal_selected then 1 else 0
    if observed.weekly_days >= HABIT_WEEKLY_INITIAL_DAYS &&
    observed.weekly_days <= HABIT_WEEKLY_MAX_DAYS {
        habits.weekly_days = observed.weekly_days
    }
    if observed.month_offset <= 0 {
        habits.month_offset = observed.month_offset
    }
    if observed.view_mode == HABIT_VIEW_CALENDAR || observed.view_mode == HABIT_VIEW_WEEKLY {
        habits.view_mode = observed.view_mode
    }
    habits.dragging = ifx observed.dragging then 1 else 0
    habits.drag_habit = observed.drag_habit
    habits.drag_lifted = ifx observed.drag_lifted then 1 else 0
    habits.drag_moving = ifx observed.drag_moving then 1 else 0
    habits.drag_origin = observed.drag_origin
    habits.drag_at_edge = ifx observed.drag_at_edge then 1 else 0
    habits.drag_edge_since = observed.drag_edge_since
    habits.drag_scroll_at = observed.drag_scroll_at
    habits.drag_scroll_carry = observed.drag_scroll_carry
    habits.drag_pointer = observed.drag_pointer
    habits.drag_grab = observed.drag_grab
    habits.drag_bounds = observed.drag_bounds
    habits_first_day_bounds = observed.first_day
    HabitScreenAnchor(app, 0, observed.anchor_progress)
    HabitScreenAnchor(app, 1, observed.anchor_table)
    HabitScreenAnchor(app, 2, observed.anchor_history)
    HabitScreenAnchor(app, 3, observed.anchor_statistics)
    HabitScreenAnchor(app, 4, observed.anchor_edit)
    HabitScreenAnchor(app, 5, observed.anchor_day)
    HabitScreenAnchor(app, 6, observed.anchor_coins)
    if observed.save {
        HabitScreenSave(app)
    }
}

// Does what the page asked for once it is drawn.
HabitScreenListApply :: (app: *InnerBreeze, observed: HabitsListFrame) {
    action := observed.action
    index := observed.action_habit
    valid := index >= 0 && index < app.habits.count
    if action == HABITS_LIST_ADD {
        habit_edit_begin_new(app)
    } else if action == HABITS_LIST_SHOP {
        HabitShopOpen(app)
        HabitScreenSave(app)
    } else if action == HABITS_LIST_OPEN && valid {
        habits_expand_card(app, index)
    } else if action == HABITS_LIST_CLOSE {
        habits_collapse_card(app)
    } else if action == HABITS_LIST_DAY && valid && observed.action_day > 0 {
        HabitScreenDayAction(app, index, observed.action_day, observed.action_decrement)
    } else if (action == HABITS_LIST_HISTORY || action == HABITS_LIST_STATISTICS) && valid {
        app.habits.selected = index
        if action == HABITS_LIST_HISTORY {
            habits_open_history(app)
        } else {
            habits_open_statistics(app)
        }
    } else if action == HABITS_LIST_EDIT && valid {
        habit_edit_begin(app, index)
    } else if (action == HABITS_LIST_MOVE || action == HABITS_LIST_DEACTIVATE ||
        action == HABITS_LIST_REACTIVATE) && valid {
        if action == HABITS_LIST_DEACTIVATE {
            habits_deactivate(*app.habits, index)
        } else if action == HABITS_LIST_REACTIVATE {
            unused habits_reactivate(*app.habits, index, observed.action_target)
        } else {
            unused habits_move_active(*app.habits, index, observed.action_target)
        }
        unused app_auto_sync(app)
        HabitScreenSave(app)
        app_block_current_click(app)
    } else if action == HABITS_LIST_BACK {
        habits_return_to_overview(app)
    }
}

// Has Habits draw the habit list or the selected habit's page.
HabitScreenList :: (app: *InnerBreeze, geometry: HabitScreenGeometry) {
    habit_list_frame = HabitScreenListFrame(app, geometry)
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(HabitScreenListCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_LIST_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    observed := habit_list_frame
    habit_list_frame = HabitsListFrame.{}
    if !drawn.succeeded {
        return
    }
    HabitScreenListKeep(app, observed)
    HabitScreenListApply(app, observed)
}

#program_export
draw_habits_screen :: (app: *InnerBreeze) {
    if app == null { return }
    HabitScreenDrawPage(app)
    HabitScreenCountDialog(app)
    HabitScreenEntryDialog(app)
    HabitShopBuyDialog(app)
}

HabitScreenDrawPage :: (app: *InnerBreeze) {
    habits_first_day_bounds = Rectangle.{}
    geometry := HabitScreenLayout(app)
    if geometry.width <= 0 || geometry.height <= 0 { return }
    if app.habits.screen_mode == HABITS_SCREEN_SHOP {
        if !HabitShopPage(app, HabitScreenRect(geometry.x, geometry.y,
            geometry.width, geometry.height)) {
            habits_return_to_overview(app)
        }
        return
    }
    overview := app.habits.screen_mode == HABITS_SCREEN_OVERVIEW || app.habits.count <= 0 ||
    app.habits.selected < 0 || app.habits.selected >= app.habits.count ||
    app.habits.items[app.habits.selected].deactivated != 0
    if !overview && app.habits.screen_mode == HABITS_SCREEN_STATISTICS {
        if !draw_statistics_page(app) {
            habits_return_to_overview(app)
        }
        return
    }
    if overview {
        // Habits without an icon get one the node's GLM service chooses.
        if HabitIconChoicePoll(*app.habits) {
            habits_save(*app.habits)
            unused app_auto_sync(app)
            HabitScreenSave(app)
        }
        unused HabitIconChoiceStart(*app.habits)
    }
    HabitScreenList(app, geometry)
}

#program_export
habits :: (app: *InnerBreeze) { draw_habits_screen(app) }
