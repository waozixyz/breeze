HABITS_GUIDE_STEPS :: 7;
HABITS_MOUSE_RIGHT :: 1;
// The habit table: day names over the rows, each row a habit's icon and
// name and then a circle for each of the last seven days.
HABITS_TABLE_HEADER_HEIGHT :: 40;
HABITS_ROW_HEIGHT :: 60;
HABITS_ROW_ICON_SIZE :: 34;
// Without room for names, rows show a smaller icon alone.
HABITS_ROW_SMALL_ICON_SIZE :: 28;
HABITS_ICON_COLUMN_WIDTH :: 36;
HABITS_NAME_PREFERRED_WIDTH :: 150;
HABITS_NAME_MIN_WIDTH :: 72;
HABITS_NAME_MAXIMUM_WIDTH :: 320;
HABITS_NAME_RESIZE_HANDLE_WIDTH :: 24;
HABITS_DAY_MIN_WIDTH :: 30;
HABITS_DAY_MAX_WIDTH :: 72;
HABITS_DEACTIVATED_ROW_HEIGHT :: 52;
HABITS_INACTIVE_HEADER_HEIGHT :: 52;
HABITS_DEACTIVATED_HINT_HEIGHT :: 40;
// A dragged habit within this distance of the list's top or bottom edge, or
// past it, scrolls the list after a short wait, so passing the edge on the
// way in does not. It scrolls this many units a second at the edge, and up
// to twice as fast further past it.
HABITS_DRAG_EDGE_MARGIN :: 48;
HABITS_DRAG_EDGE_WAIT_SECONDS :: 0.15;
HABITS_DRAG_EDGE_SPEED :: 700;
// On a touch screen a row is lifted to move after this long a hold. A
// shorter hold lifted rows when a finger rested before scrolling.
HABITS_CARD_HOLD_SECONDS :: 0.6;
// The first habit's today marker from the last drawn frame; the web smoke
// test clicks it.
habits_first_day_bounds: Rectangle;

HabitScreenGeometry :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
}

HabitScreenButtonProps :: (app: *InnerBreeze, label: string, id: s32,
    x: s32, y: s32, width: s32, height: s32,
    selected: bool, disabled: bool) -> ButtonProps {
    props: ButtonProps
    props.bounds = HabitScreenRect(x, y, width, height)
    props.id = id
    props.label = label
    props.tone = cast(ButtonTone)(ifx (selected) then
        (ButtonToneAccent) else (ButtonToneNeutral))
    props.emphasis = cast(ButtonEmphasis)(ifx (selected) then
        (ButtonEmphasisFilled) else (ButtonEmphasisSoft))
    props.selected = selected
    props.disabled = disabled || app.modal.active != 0
    return props
}

HabitScreenNumber :: (app: *InnerBreeze, value: s32) -> string {
    buffer: [24]u8
    if !FormatNumberTemplate("%d", value, buffer[:]) { return "" }
    return FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*buffer[0], cast(s32)buffer.count))
}

HabitScreenMonthKeys: [12]string = .["habit_month_1", "habit_month_2",
"habit_month_3", "habit_month_4", "habit_month_5", "habit_month_6",
"habit_month_7", "habit_month_8", "habit_month_9", "habit_month_10",
"habit_month_11", "habit_month_12"];

// The month and year in the language's own order, such as "September 2026"
// or "2026年9月".
HabitScreenMonth :: (app: *InnerBreeze, year: s32, month: s32) -> string {
    if month < 1 || month > 12 { return "" }
    buffer: [64]u8
    args: [1]FormatArg
    args[0].number = year
    if !FormatTemplate(LocaleText(HabitScreenMonthKeys[month - 1]), args[:],
        buffer[:]) { return "" }
    return FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*buffer[0], cast(s32)buffer.count))
}

HabitScreenLayout :: (app: *InnerBreeze) -> HabitScreenGeometry {
    layout: HabitScreenGeometry
    if app == null { return layout }
    column := CenteredColumnFor(app.ui.view_width,
        AppScale(1120), AppScale(16))
    layout.x = column.x
    layout.width = column.width
    layout.y = AppScale(20)
    layout.height = app.ui.view_height - layout.y -
    app_content_bottom_reserved(app) - AppScale(12)
    if layout.height < 0 { layout.height = 0 }
    return layout
}

HabitScreenScroll :: (app: *InnerBreeze, key: string,
    bounds: Rectangle, content_height: s32, keep_scrollbar: bool) -> ScrollResult {
    scroll_key := KeyHash(key)
    props: ScrollProps
    props.key = scroll_key
    props.bounds = bounds
    props.content_height = content_height
    props.keep_scrollbar = keep_scrollbar
    props.scroll_offset = app.habits.scroll
    result := Scroll(app.ui.session, props)
    app.habits.scroll = result.scroll_offset
    return result
}

HabitScreenSave :: (app: *InnerBreeze) {
    save_settings(app)
    sync_web_storage_critical()
}

habits_expand_card :: (app: *InnerBreeze, index: s32) {
    if app == null {
        return
    }
    message := HabitsMessageFor(app, HABITS_EXPAND)
    message.index = index
    message = HabitsRun(message)
    HabitsAcceptView(app, message)
    if message.succeeded {
        app.habits.reveal_selected = 1
        HabitScreenSave(app)
    }
}

habits_return_to_focus :: (app: *InnerBreeze) {
    if app == null {
        return
