// Habit navigation and presentation. Habit persistence and counting rules live
// in the habit modules; this screen composes them with Kryon's current widgets.
raylib_input :: #system_library "raylib";
IsMouseButtonReleased :: (button: s32) -> bool #foreign raylib_input;

