#import "std/math"
#import "std/vec"
#import "kryon/shader"
#import "kryon/scene"
#import "kryon/scene_render"
#import, file "practice_banner_motion.zi";
#import, file "practice_banner_regions.zi";
#import, file "practice_banner_stars.zi";
Sky :: #import "kryon/daylight";

PRACTICE_BANNER_WIDTH :: 576
PRACTICE_BANNER_HEIGHT :: 288
PRACTICE_CLOUD_BYTES :: Sky.DAYLIGHT_NOISE * Sky.DAYLIGHT_NOISE * 2

BANNER_REFLECTION :: 12
BANNER_WAVE :: 13
BANNER_WATER :: 14

// The steam quad covers just the space around and above the bath.
BANNER_STEAM_LEFT :: 0.27
BANNER_STEAM_BOTTOM :: 0.44
BANNER_STEAM_WIDTH :: 0.46
BANNER_STEAM_HEIGHT :: 0.38
BANNER_STEAM_TINT :: 0
BANNER_STEAM_PHASE :: 1
BANNER_STEAM_OPACITY :: 2

PracticeBannerShader :: struct {
    sky: Sky.DaylightSky
    program: ShaderProgram
    scene: Scene
    camera: SceneCamera
    uniforms: [15]ShaderValue
    samplers: [3]ShaderSampler
    stars: [PRACTICE_BANNER_WIDTH * PRACTICE_BANNER_HEIGHT * 4]u8
    steam_program: ShaderProgram
    steam_uniforms: [3]ShaderValue
    sky_node: s32
    steam_node: s32
}

#scope_file
practice_banner_program :: (program: *ShaderProgram) -> bool {
    // Registers 19 and above belong to the banner. Daylight takes UV in r3
    // and renders the atmosphere in r9. Water traces that same sky backwards
    // through a moving surface normal before the daylight material shades it.
    reflection: [24]ShaderInstruction = .[
    .{.op = .ShaderSample, .dest = 19, .a = 3, .slot = 1},
    .{.op = .ShaderLiteral, .dest = 20, .value = .{0, 1, 0, 0}},
    .{.op = .ShaderDot, .dest = 21, .a = 19, .b = 20},
    .{.op = .ShaderLiteral, .dest = 22, .value = .{1, 0, 0, 0}},
    .{.op = .ShaderDot, .dest = 23, .a = 19, .b = 22},
    .{.op = .ShaderMax, .dest = 23, .a = 23, .b = 21},
    .{.op = .ShaderLiteral, .dest = 24, .value = .{0.002, 0, 0, 0}},
    .{.op = .ShaderDiscardLess, .a = 23, .b = 24},
    .{.op = .ShaderLiteral, .dest = 24, .value = .{255, 255, 255, 255}},
    .{.op = .ShaderMultiply, .dest = 21, .a = 21, .b = 24},
    .{.op = .ShaderLiteral, .dest = 24, .value = .{1, 1, 1, 1}},
    .{.op = .ShaderMin, .dest = 21, .a = 21, .b = 24},
    .{.op = .ShaderLiteral, .dest = 25, .value = .{14, 84, 0, 0}},
    .{.op = .ShaderDot, .dest = 25, .a = 3, .b = 25},
    .{.op = .ShaderUniform, .dest = 26, .slot = BANNER_WAVE},
    .{.op = .ShaderAdd, .dest = 25, .a = 25, .b = 26},
    .{.op = .ShaderSin, .dest = 29, .a = 25},
    .{.op = .ShaderLiteral, .dest = 26, .value = .{0.041, 0.018, 0, 0}},
    .{.op = .ShaderMultiply, .dest = 25, .a = 29, .b = 26},
    .{.op = .ShaderLiteral, .dest = 26, .value = .{1, -1, 0, 0}},
    .{.op = .ShaderMultiply, .dest = 26, .a = 3, .b = 26},
    .{.op = .ShaderUniform, .dest = 27, .slot = BANNER_REFLECTION},
    .{.op = .ShaderAdd, .dest = 26, .a = 26, .b = 27},
    .{.op = .ShaderAdd, .dest = 26, .a = 26, .b = 25},
    ]
    refract := ShaderInstruction.{.op = .ShaderMix, .dest = 3, .a = 3, .b = 26, .c = 21}
    composite: [12]ShaderInstruction = .[
    .{.op = .ShaderUniform, .dest = 26, .slot = BANNER_WATER},
    .{.op = .ShaderLiteral, .dest = 27, .value = .{0.48, 0.56, 0.62, 0}},
    .{.op = .ShaderMix, .dest = 26, .a = 26, .b = Sky.DAYLIGHT_REG_SKY, .c = 27},
    // Surface slopes change the reflected brightness along each crest.
    .{.op = .ShaderLiteral, .dest = 30, .value = .{0.12, 0.12, 0.12, 0}},
    .{.op = .ShaderMultiply, .dest = 29, .a = 29, .b = 30},
    .{.op = .ShaderAdd, .dest = 29, .a = 29, .b = 24},
    .{.op = .ShaderMultiply, .dest = 26, .a = 26, .b = 29},
    .{.op = .ShaderMix, .dest = Sky.DAYLIGHT_REG_SKY, .a = Sky.DAYLIGHT_REG_SKY, .b = 26, .c = 21},
    .{.op = .ShaderLiteral, .dest = 27, .value = .{0, 0, 0, 1}},
    .{.op = .ShaderMultiply, .dest = 23, .a = 23, .b = 27},
    .{.op = .ShaderAdd, .dest = Sky.DAYLIGHT_REG_SKY, .a = Sky.DAYLIGHT_REG_SKY, .b = 23},
    .{.op = .ShaderOutput, .a = Sky.DAYLIGHT_REG_SKY},
    ]
    material: Sky.DaylightSkyCode
    Sky.DaylightSkyProgram(*material)
    // Take the material's linear RGB without its final opaque alpha or output.
    count := reflection.count + 1 + material.count - 2 + composite.count
    if count > SHADER_INSTRUCTIONS {
        return false
    }
    code: [SHADER_INSTRUCTIONS]ShaderInstruction
    at: s32
    for instruction: reflection {
        code[at] = instruction
        at += 1
    }
    code[at] = refract
    at += 1
    catalog_coordinates := false
    catalog_sample := false
    for index: 0..material.count - 3 {
        step := material.code[index]
        // The catalogue covers the banner once. Only the cloud noise tiles.
        if step.op == .ShaderLiteral && step.dest == Sky.DAYLIGHT_REG_Q &&
            step.value.x == 5.0 && step.value.y == 3.0 {
            step.value = .{1, 1, 0, 0}
            catalog_coordinates = true
        }
        if catalog_coordinates && step.op == .ShaderSample && step.dest == Sky.DAYLIGHT_REG_Q {
            step.slot = 2
            catalog_sample = true
        }
        if step.op == .ShaderLiteral && step.dest == Sky.DAYLIGHT_REG_Q &&
            step.value.x == 1.0 && step.value.y == 0.7 {
            // Broad low clouds with horizontally elongated silhouettes.
            step.value = .{1.45, 0.54, 0, 0}
        }
        if step.op == .ShaderLiteral && step.dest == Sky.DAYLIGHT_REG_R &&
            step.value.x == 1.7 && step.value.y == 1.1 {
            // Smaller, faster detail breaks up the primary cloud edges.
            step.value = .{2.4, 1.35, 0, 0}
        }
        if catalog_coordinates && step.op == .ShaderLiteral && step.dest == Sky.DAYLIGHT_REG_T {
            if step.value.x == 0.35 { step.value = .{0.08, 0.08, 0.08, 0.08} }
            if step.value.x == 0.65 { step.value = .{0.92, 0.92, 0.92, 0.92} }
        }
        code[at] = step
        at += 1
    }
    for instruction: composite {
        code[at] = instruction
        at += 1
    }
    return catalog_sample && ShaderCompile(program, code[:at]).ok
}

#scope_file
practice_banner_steam_program :: (program: *ShaderProgram) -> bool {
    // A rising wave sways the masked ribbons and carries their density upward.
    code: [29]ShaderInstruction = .[
    .{.op = .ShaderLiteral, .dest = 4, .value = .{12, 22, 0, 0}},
    .{.op = .ShaderDot, .dest = 4, .a = 3, .b = 4},
    .{.op = .ShaderUniform, .dest = 5, .slot = BANNER_STEAM_PHASE},
    .{.op = .ShaderAdd, .dest = 4, .a = 4, .b = 5},
    .{.op = .ShaderSin, .dest = 4, .a = 4},
    .{.op = .ShaderLiteral, .dest = 5, .value = .{BANNER_STEAM_WIDTH, BANNER_STEAM_HEIGHT, 0, 0}},
    .{.op = .ShaderMultiply, .dest = 5, .a = 3, .b = 5},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{BANNER_STEAM_LEFT, BANNER_STEAM_BOTTOM, 0, 0}},
    .{.op = .ShaderAdd, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0.012, 0, 0, 0}},
    .{.op = .ShaderMultiply, .dest = 6, .a = 4, .b = 6},
    .{.op = .ShaderAdd, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderSample, .dest = 5, .a = 5, .slot = 0},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0, 0, 1, 0}},
    .{.op = .ShaderDot, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0.48, 0.48, 0.48, 0.48}},
    .{.op = .ShaderMultiply, .dest = 4, .a = 4, .b = 6},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0.52, 0.52, 0.52, 0.52}},
    .{.op = .ShaderAdd, .dest = 4, .a = 4, .b = 6},
    .{.op = .ShaderUniform, .dest = 6, .slot = BANNER_STEAM_OPACITY},
    .{.op = .ShaderMultiply, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderMultiply, .dest = 5, .a = 5, .b = 4},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0.002, 0, 0, 0}},
    .{.op = .ShaderDiscardLess, .a = 5, .b = 6},
    .{.op = .ShaderLiteral, .dest = 6, .value = .{0, 0, 0, 1}},
    .{.op = .ShaderMultiply, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderUniform, .dest = 6, .slot = BANNER_STEAM_TINT},
    .{.op = .ShaderAdd, .dest = 5, .a = 5, .b = 6},
    .{.op = .ShaderOutput, .a = 5},
    ]
    return ShaderCompile(program, code[:]).ok
}

#scope_file
practice_banner_catalog :: (pixels: []u8) {
    // Gnomonic view of Orion and the surrounding sky. East appears on the
    // left. The center is above the horizon and the horizontal FOV is 92°.
    radians := 0.0174532925199433
    center := 3.0 * radians
    half_width := Tan(46.0 * radians)
    for star: practice_banner_stars {
        dec := star.dec * radians
        ra := (star.ra - 83.0) * radians
        depth := Sin(center) * Sin(dec) + Cos(center) * Cos(dec) * Cos(ra)
        x := 0.5 - Cos(dec) * Sin(ra) / (2.0 * half_width * depth)
        elevation := Cos(center) * Sin(dec) - Sin(center) * Cos(dec) * Cos(ra)
        y := 0.19 - elevation / (half_width * depth)
        px := x * PRACTICE_BANNER_WIDTH - 0.5
        py := y * PRACTICE_BANNER_HEIGHT - 0.5
        // Compress magnitudes for a small banner while preserving the rank
        // of bright and faint stars. Subpixel footprints prevent flicker.
        brightness := 0.11 * Pow(10.0, (530.0 - cast(float64)star.magnitude) / 640.0)
        for row: cast(s32)py - 2..cast(s32)py + 2 {
            for column: cast(s32)px - 2..cast(s32)px + 2 {
                if row < 0 || row >= PRACTICE_BANNER_HEIGHT || column < 0 || column >= PRACTICE_BANNER_WIDTH {
                    continue
                }
                dx := cast(float64)column - px
                dy := cast(float64)row - py
                level := brightness * Exp(-2.35 * (dx * dx + dy * dy)) * 255.0
                value := cast(u8)(ifx level < 255.0 then level else 255.0)
                at := (row * PRACTICE_BANNER_WIDTH + column) * 4 + 2
                if value > pixels[at] {
                    pixels[at] = value
                }
            }
        }
    }
}

#scope_export
PracticeBannerShaderInit :: (banner: *PracticeBannerShader, clouds: []u8) -> bool {
    if !practice_banner_program(*banner.program) || !practice_banner_steam_program(*banner.steam_program) {
        return false
    }
    // Two density channels sampled from a NOAA photograph of cumulus clouds.
    // A missing observation leaves a clear sky.
    observed := clouds.count == PRACTICE_CLOUD_BYTES
    for pixel: 0..PRACTICE_CLOUD_BYTES / 2 - 1 {
        unused VecPush(banner.sky.noise, ifx observed then clouds[pixel * 2] else cast(u8)0)
        unused VecPush(banner.sky.noise, ifx observed then clouds[pixel * 2 + 1] else cast(u8)0)
        unused VecPush(banner.sky.noise, cast(u8)0)
        unused VecPush(banner.sky.noise, cast(u8)255)
    }
    practice_banner_catalog(banner.stars[:])
    banner.samplers[0] = .{Sky.DAYLIGHT_NOISE, Sky.DAYLIGHT_NOISE, banner.sky.noise[:], true}
    banner.samplers[2] = .{PRACTICE_BANNER_WIDTH, PRACTICE_BANNER_HEIGHT, banner.stars[:], false}
    SceneInit(*banner.scene)
    banner.scene.background = .{0, 0, 0, 0}
    material := Sky.DaylightSkyMaterial(*banner.program, banner.uniforms[:], banner.samplers[:])
    material.transparent = true
    banner.sky_node = Plane(*banner.scene, 2.0, 1.0, material)
    steam := Sky.DaylightSkyMaterial(*banner.steam_program, banner.steam_uniforms[:], banner.samplers[1:2])
    steam.transparent = true
    banner.steam_node = Plane(*banner.scene, 2.0 * BANNER_STEAM_WIDTH, BANNER_STEAM_HEIGHT, steam)
    unused SetPosition(*banner.scene, banner.steam_node, 2.0 * BANNER_STEAM_LEFT + BANNER_STEAM_WIDTH - 1.0,
        BANNER_STEAM_BOTTOM + BANNER_STEAM_HEIGHT * 0.5 - 0.5, 0.002)
    unused SetVisible(*banner.scene, banner.steam_node, false)
    FreezeGeometry(*banner.scene)
    banner.camera = OrthographicCamera(-1.0, 1.0, 0.5, -0.5, 0.1, 4.0)
    banner.camera.position = .{0, 0, 1}
    banner.camera.target = .{0, 0, 0}
    return !banner.scene.failed
}

#scope_file
practice_banner_linear_channel :: (value: u32) -> float64 {
    encoded := cast(float64)(value & 255) / 255.0
    if encoded <= 0.04045 {
        return encoded / 12.92
    }
    return Pow((encoded + 0.055) / 1.055, 2.4)
}

#scope_file
practice_banner_linear :: (rgb: u32) -> ShaderValue {
    return .{practice_banner_linear_channel(rgb >> 16), practice_banner_linear_channel(rgb >> 8),
        practice_banner_linear_channel(rgb), 0.0}
}

#scope_export
PracticeBannerShaderLook :: (banner: *PracticeBannerShader, regions: PracticeBannerRegions, mask: []u8) {
    look := regions.look
    daylight := Sky.DaylightAt(look.hour)
    daylight.zenith = practice_banner_linear(look.zenith)
    daylight.horizon = practice_banner_linear(look.horizon)
    Sky.DaylightSkyUpdate(*banner.sky, daylight, 0.0, 2.0, look.waterline)
    for slot: 0..banner.sky.uniforms.count - 1 {
        banner.uniforms[slot] = banner.sky.uniforms[slot]
    }
    banner.samplers[1] = .{PRACTICE_BANNER_MASK_WIDTH, PRACTICE_BANNER_MASK_HEIGHT, mask, false}
    banner.uniforms[BANNER_REFLECTION] = .{0, 2.0 * look.waterline, 0, 0}
    banner.uniforms[BANNER_WATER] = practice_banner_linear(look.water)
    banner.uniforms[Sky.DAYLIGHT_SUN_AT] = .{look.light_x, 1.0 - look.light_y, 0, 0}
    night := look.hour >= 18.5
    if night {
        banner.uniforms[Sky.DAYLIGHT_SUN_COLOR] = .{0.62, 0.72, 0.92, 0}
    }
    banner.uniforms[Sky.DAYLIGHT_SUN_SHAPE] = .{60, 0.0005, 5800, 0}
    banner.uniforms[Sky.DAYLIGHT_STARS] = .{ifx night then 0.72 else 0.0, 0,
        ifx night then 0.10 else 0.23, 0}
    banner.uniforms[Sky.DAYLIGHT_CLOUD] = .{ifx night then 0.055 else 0.025, 4.5,
        ifx night then 0.45 else 0.96, 0}
    banner.uniforms[Sky.DAYLIGHT_CLOUD_LIT] = practice_banner_linear(look.cloud_light)
    banner.uniforms[Sky.DAYLIGHT_CLOUD_SHADE] = practice_banner_linear(look.cloud_shadow)
    opacity := regions.steam_opacity
    banner.steam_uniforms[BANNER_STEAM_TINT] = practice_banner_linear(regions.steam_color)
    banner.steam_uniforms[BANNER_STEAM_OPACITY] = .{opacity, opacity, opacity, opacity}
    unused SetVisible(*banner.scene, banner.steam_node, opacity > 0.0)
}

PracticeBannerShaderPass :: (banner: *PracticeBannerShader, regions: PracticeBannerRegions, steam_only: bool) {
    unused SetVisible(*banner.scene, banner.sky_node, !steam_only)
    unused SetVisible(*banner.scene, banner.steam_node,
        regions.steam_opacity > 0.0 && (steam_only || !regions.full_sky))
}

PracticeBannerShaderPhase :: (banner: *PracticeBannerShader, tick: s64) {
    seconds := cast(float64)(tick - 1) / PRACTICE_BANNER_HZ
    low_cloud := seconds * 0.0063
    high_cloud := seconds * 0.0108
    banner.uniforms[Sky.DAYLIGHT_CLOUD_A] = .{low_cloud - Sky.DaylightFloor(low_cloud), 0, 0, 0}
    banner.uniforms[Sky.DAYLIGHT_CLOUD_B] = .{high_cloud - Sky.DaylightFloor(high_cloud), 0, 0, 0}
    twinkle := seconds * 0.37
    banner.uniforms[Sky.DAYLIGHT_STARS].y = twinkle - Sky.DaylightFloor(twinkle)
    turn := seconds * 0.26
    wave := -6.283185307179586 * (turn - Sky.DaylightFloor(turn))
    banner.uniforms[BANNER_WAVE] = .{wave, wave + 0.7, wave, wave}
    steam_turn := seconds * 0.56
    steam := -6.283185307179586 * (steam_turn - Sky.DaylightFloor(steam_turn))
    banner.steam_uniforms[BANNER_STEAM_PHASE] = .{steam, steam, steam, steam}
}
