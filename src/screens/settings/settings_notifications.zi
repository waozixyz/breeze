using ButtonTone;
using ButtonEmphasis;
using TextAlign;

settings_notifications_button_row_height :: () -> s32 {
    return AppScale(56)
}

// A reminder fits on one row when its practice picker keeps a usable width
// beside the switch, time, and remove controls; otherwise it takes two.
settings_notifications_entry_wide :: (width: s32) -> bool {
    return width >= AppScale(520)
}

settings_notifications_entry_height :: (width: s32) -> s32 {
    if settings_notifications_entry_wide(width) {
        return AppScale(56)
    }
    return AppScale(56) + AppScale(46)
}

settings_notifications_count :: (app: *InnerBreeze) -> s32 {
    count := app.reminder_count
    if count < 0 {
        count = 0
    }
    if count > APP_REMINDER_MAX {
        count = APP_REMINDER_MAX
    }
    return count
}

settings_notifications_general_body :: (width: s32) -> s32 {
    return toggle_row_height(
        LocaleText("notifications_friend_request_label"), width) +
        toggle_row_height(
            LocaleText("notifications_habit_reminders_label"), width) +
        settings_notifications_button_row_height()
}

settings_notifications_reminders_body :: (app: *InnerBreeze,
    width: s32) -> s32 {
    count := settings_notifications_count(app)
    height := count * settings_notifications_entry_height(width)
    if count < APP_REMINDER_MAX {
        height += settings_notifications_button_row_height()
    }
    return height
}

settings_notifications_push_body :: () -> s32 {
    return AppScale(44) + settings_notifications_button_row_height()
}

#program_export
settings_notifications_content_height :: (app: *InnerBreeze,
    content_width: s32) -> s32 {
    if app == null {
        return AppScale(30)
    }
    inner := settings_section_inner_width(content_width)
    height: s32 = 0
    if AndroidPlatform() != 0 {
        height += settings_section_height(
            LocaleText("notifications_push_section"),
            settings_notifications_push_body())
    }
    height += settings_section_height(LocaleText("notifications_section"),
        settings_notifications_general_body(inner))
    height += settings_section_height(
        LocaleText("notifications_reminders_section"),
        settings_notifications_reminders_body(app, inner))
    return height
}

// A full-width secondary button centred in its own row of a section.
settings_notifications_button_row :: (app: *InnerBreeze, id: s32, x: s32,
    width: s32, y: *s32, label: string) -> bool {
    button: ButtonProps
    button.id = id
    button.bounds = Rectangle.{cast(float32)x,
        cast(float32)(y.* + AppScale(10)), cast(float32)width,
        cast(float32)AppScale(36)}
    button.label = label
    button.tone = cast(ButtonTone)ButtonToneNeutral
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    y.* += settings_notifications_button_row_height()
    return Button(app.ui.session, button) != 0
}

settings_notifications_remove_reminder :: (app: *InnerBreeze,
    index: s32) {
    if app == null || index < 0 || index >= app.reminder_count  || index >= APP_REMINDER_MAX {
        return
    }
    cursor := index
    while cursor + 1 < app.reminder_count  && cursor + 1 < APP_REMINDER_MAX {
        app.reminders[cursor] = app.reminders[cursor + 1]
        app.ui.reminder_menus[cursor] = app.ui.reminder_menus[cursor + 1]
        cursor += 1
    }
    app.reminder_count -= 1
    app.ui.reminder_menus[app.reminder_count].open = false
    app.settings_dirty = 1
    save_settings(app)
}

settings_notifications_draw_entry :: (app: *InnerBreeze, index: s32,
    x: s32, width: s32, y: *s32) -> bool {
    reminder := *app.reminders[index]
    control_height := AppScale(36)
    gap := AppScale(12)
    remove_width := settings_button_width(LocaleText("remove_button"), AppScale(88))
    toggle_width := toggle_switch_width()
    toggle_height := toggle_switch_height()
    time_bytes: [6]u8
    hour := reminder.hour
    if hour < 0 {
        hour = 0
    }
    if hour > 23 {
        hour = 23
    }
    time_bytes[0] = cast(u8)(48 + hour / 10)
    time_bytes[1] = cast(u8)(48 + hour % 10)
    time_bytes[2] = cast(u8)58
    time_bytes[3] = cast(u8)48
    time_bytes[4] = cast(u8)48
    time_bytes[5] = cast(u8)0
    time_text := FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*time_bytes[0], 6))
    stepper_width := control_height * 2 +
        AppTextWidth(time_text, AppFontSize()) + AppScale(24)

    first_center := y.* + AppScale(28)
    toggle_x := x
    toggle_center := first_center
    menu_x := x + toggle_width + gap
    menu_width := width - toggle_width - stepper_width - remove_width - gap * 3
    stepper_x := x + width - remove_width - gap - stepper_width
    stepper_center := first_center
    if !settings_notifications_entry_wide(width) {
        menu_x = x
        menu_width = width - remove_width - gap
        toggle_center = first_center + AppScale(46)
        stepper_x = x + width - stepper_width
        stepper_center = toggle_center
    }

    enabled: ToggleProps
    enabled.id = cast(s32)4010 + index
    enabled.bounds = Rectangle.{cast(float32)toggle_x,
        cast(float32)(toggle_center - toggle_height / 2),
        cast(float32)toggle_width, cast(float32)toggle_height}
    enabled.label = practice_label(reminder.practice)
    enabled.value = reminder.enabled != 0
    toggle_result := Toggle(app.ui.session, enabled)
    if toggle_result.changed {
        reminder.enabled = ifx toggle_result.value then 1 else 0
        app.settings_dirty = 1
        save_settings(app)
    }

    options: [APP_REMINDER_PRACTICE_COUNT]DropdownOption
    for practice: 0..(APP_REMINDER_PRACTICE_COUNT - 1) {
        options[practice].label = practice_label(cast(s32)practice)
    }
    menu: DropdownProps
    menu.id = cast(s32)400 + index * 4
    menu.bounds = Rectangle.{cast(float32)menu_x,
        cast(float32)(first_center - control_height / 2),
        cast(float32)menu_width, cast(float32)control_height}
    menu.selected_index = reminder.practice
    menu.open = app.ui.reminder_menus[index].open
    menu.highlight_index = app.ui.reminder_menus[index].highlight_index
    menu.scroll_offset = app.ui.reminder_menus[index].scroll_offset
    app.ui.reminder_menus[index] = Dropdown(app.ui.session, menu, options[:])
    if app.ui.reminder_menus[index].changed {
        reminder.practice = app.ui.reminder_menus[index].selected_index
        app.settings_dirty = 1
        save_settings(app)
    }

    time: SpinboxProps
    time.id = cast(s32)401 + index * 2
    time.bounds = Rectangle.{cast(float32)stepper_x,
        cast(float32)(stepper_center - control_height / 2),
        cast(float32)stepper_width, cast(float32)control_height}
    time.label = practice_label(reminder.practice)
    time.min = 0
    time.max = 23
    time.value = reminder.hour
    time.value_text = time_text
    time.wrap = true
    time_result := Spinbox(app.ui.session, time)
    if time_result.changed {
        reminder.hour = time_result.value
        app.settings_dirty = 1
        save_settings(app)
    }

    remove: ButtonProps
    remove.id = cast(s32)440 + index
    remove.bounds = Rectangle.{cast(float32)(x + width - remove_width),
        cast(float32)(first_center - control_height / 2),
        cast(float32)remove_width, cast(float32)control_height}
    remove.label = LocaleText("remove_button")
    remove.tone = cast(ButtonTone)ButtonToneNeutral
    remove.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    y.* += settings_notifications_entry_height(width)
    if Button(app.ui.session, remove) != 0 {
        settings_notifications_remove_reminder(app, index)
        return true
    }
    return false
}

settings_notifications_close_picker :: (app: *InnerBreeze) {
    if app != null {
        app.push_picker_open = 0
    }
}

#program_export
settings_notifications_handle_overlays :: (app: *InnerBreeze) {
    if app == null || AndroidPlatform() == 0  || app.push_picker_open == 0 {
        return
    }
    count := app.push_distributor_count
    if count < 0 {
        count = 0
    }
    if count > APP_PUSH_DISTRIBUTOR_MAX {
        count = APP_PUSH_DISTRIBUTOR_MAX
    }
    actions: [APP_PUSH_DISTRIBUTOR_MAX + 1]ActionModalAction
    index: s32 = 0
    while index < count {
        actions[index].label = AppTextFromCString(
            *app.push_distributor_labels[index][0], 64)
        actions[index].tone = cast(ButtonTone)ButtonToneNeutral
        actions[index].emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        index += 1
    }
    actions[count].label = LocaleText("close_button")
    actions[count].tone = cast(ButtonTone)ButtonToneNeutral
    actions[count].emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    props: ActionModalProps
    props.id = 720
    props.title = LocaleText("notifications_push_picker_title")
    props.max_width = AppScale(440)
    result := ActionModal(app.ui.session, props, actions[:count + 1])
    if result.action > 0 && result.action <= count {
        PushConfigureWith(app, result.action - 1)
        settings_notifications_close_picker(app)
    } else if result.action != 0 {
        settings_notifications_close_picker(app)
    }
}

settings_notifications_draw_push :: (app: *InnerBreeze,
    x: s32, width: s32, y: *s32) {
    if AndroidPlatform() == 0 {
        return
    }
    section := settings_section_begin(app, x, width, y,
        LocaleText("notifications_push_section"),
        settings_notifications_push_body())
    status: TextProps
    status.text = LocaleText("notifications_push_status_off")
    if PushRegistered() != 0 {
        status.text = LocaleText("notifications_push_status_on")
    }
    status.font = AppFontSize()
    status.vertical_align = cast(TextAlign)TextAlignCenter
    status.bounds = Rectangle.{cast(float32)section.inner_x,
        cast(float32)y.*, cast(float32)section.inner_width,
        cast(float32)AppScale(44)}
    Text(app.ui.session, status)
    y.* += AppScale(44)
    settings_row_divider(app, section, y.*)
    if settings_notifications_button_row(app, 730, section.inner_x,
        section.inner_width, y, LocaleText("notifications_push_setup")) {
        PushRefresh(app)
        if app.push_distributor_count > 0 {
            app.push_picker_open = 1
        } else {
            PushConfigure()
        }
    }
    settings_section_end(y)
}

#program_export
settings_notifications_draw :: (app: *InnerBreeze, x: s32,
    width: s32, y: *s32) {
    if app == null || y == null {
        return
    }
    settings_notifications_draw_push(app, x, width, y)
    inner := settings_section_inner_width(width)
    general := settings_section_begin(app, x, width, y,
        LocaleText("notifications_section"),
        settings_notifications_general_body(inner))
    friend := app.notification_friend_request
    if commit_toggle_row(app, general.inner_x, general.inner_width, y,
        LocaleText("notifications_friend_request_label"), *friend, 0) != 0 {
        app.notification_friend_request = friend
        save_settings(app)
    }
    settings_row_divider(app, general, y.*)
    habit := app.notification_habit_reminders
    if commit_toggle_row(app, general.inner_x, general.inner_width, y,
        LocaleText("notifications_habit_reminders_label"), *habit, 0) != 0 {
        app.notification_habit_reminders = habit
        save_settings(app)
    }
    settings_row_divider(app, general, y.*)
    if settings_notifications_button_row(app, 740, general.inner_x,
        general.inner_width, y, LocaleText("notifications_test")) {
        unused send_test_notification(app)
    }
    settings_section_end(y)

    reminders := settings_section_begin(app, x, width, y,
        LocaleText("notifications_reminders_section"),
        settings_notifications_reminders_body(app, inner))
    index: s32 = 0
    while index < app.reminder_count && index < APP_REMINDER_MAX {
        if index > 0 {
            settings_row_divider(app, reminders, y.*)
        }
        if !settings_notifications_draw_entry(app, index,
            reminders.inner_x, reminders.inner_width, y) {
            index += 1
        }
    }
    if app.reminder_count < APP_REMINDER_MAX {
        if app.reminder_count > 0 {
            settings_row_divider(app, reminders, y.*)
        }
        if settings_notifications_button_row(app, 750, reminders.inner_x,
            reminders.inner_width, y, LocaleText("reminder_add")) {
            reminder := *app.reminders[app.reminder_count]
            reminder.practice = 0
            reminder.hour = 8
            reminder.enabled = 1
            reminder.last_day = 0
            app.ui.reminder_menus[app.reminder_count].open = false
            app.reminder_count += 1
            app.settings_dirty = 1
            save_settings(app)
        }
    }
    settings_section_end(y)
}
