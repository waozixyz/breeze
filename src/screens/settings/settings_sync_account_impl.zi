sync_server_url_key: string = "sync_server_url";
sync_server_url_default: string = "https://api.waozi.xyz";
sync_account_alias_key: string = "sync_account_alias";
server_anchor: s32;
server_scroll_x: s32;
sync_account_details: bool;
alias_anchor: s32;
alias_scroll_x: s32;

#if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
    SettingsAccountRequest :: struct {
        operation: StoredOperation
        transfer: NetworkTransfer
        output: [4096]u8
        owner: *InnerBreeze
        deleting: bool
        alias_result: s32
    }
    settings_account_request: SettingsAccountRequest;
}

#program_export
settings_sync_account_cancel :: (app: *InnerBreeze) {
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        if settings_account_request.owner == app {
            CancelStoredOperation(*settings_account_request.operation)
            settings_account_request = SettingsAccountRequest.{}
        }
    }
    unused app
}

#program_export
settings_sync_account_pump :: (app: *InnerBreeze) {
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        request := *settings_account_request
        if request.owner != app {
            return
        }
        if !request.deleting &&
        (app.modal.active == 0 || app.modal.type != cast(ModalType)ModalSyncAlias) {
            settings_sync_account_cancel(app)
            return
        }
        if !request.operation.active || !PollStoredOperation(*request.operation) {
            return
        }
        succeeded := request.operation.result == cast(s32)SyncResult.SYNC_OK
        if request.deleting {
            request.owner = null
            if succeeded {
                unused sync_account_clear()
                settings_screen_set_status_success(LocaleText("sync_remote_data_cleared"), "")
            } else {
                settings_screen_set_status_error(LocaleText("sync_failed"))
            }
        } else {
            request.alias_result = ifx (succeeded) then (1) else (2)
        }
    }
    unused app
}

#if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
    SettingsBeginAlias :: (app: *InnerBreeze, server: string,
        alias: string) -> bool {
        request := *settings_account_request
        if request.operation.active {
            return false
        }
        request.* = SettingsAccountRequest.{}
        body: [512]u8
        if !BuildAliasBody(storage_get_setting_text("sync_public_id"),
            alias, body[:]) {
            return false
        }
        request.owner = app
        return BeginStoredRequest(*request.operation, server,
            NetworkTransport(*request.transfer), "POST", "/api/v1/account/alias",
            TextUntilNul(body[:]), settings_account_request.output[:], true)
    }
}

SettingsSyncRect :: (x: s32, y: s32, width: s32,
    height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

SettingsSyncTextProps :: (value: string,
    x: s32, y: s32, width: s32, height: s32,
    small: bool) -> Text.Props {
    props: Text.Props
    props.bounds = SettingsSyncRect(x, y, width, height)
    props.text = value
    props.size = ifx (small) then (AppSmallFontSize()) else (AppFontSize())
    props.wrap = cast(Text.Wrap)TextWrapNone
    return props
}

SettingsSyncButtonProps :: (label: string, x: s32, y: s32,
    width: s32, height: s32, id: s32, accent: bool) -> Button.Props {
    props: Button.Props
    props.bounds = SettingsSyncRect(x, y, width, height)
    props.id = id
    props.label = label
    props.tone = cast(ButtonTone)(ifx (accent) then
        (ButtonToneAccent) else (ButtonToneNeutral))
    props.emphasis = cast(ButtonEmphasis)(ifx (accent) then
        (ButtonEmphasisFilled) else (ButtonEmphasisSoft))
    return props
}

SettingsSyncAccountId :: (account: *AccountKeys) -> string {
    if account == null {
        return ""
    }
    return AppTextFromCString(*account.public_id[0], ACCOUNT_PUBLIC_ID_HEX_SIZE)
}

SettingsSyncLoadAccountId :: (app: *InnerBreeze, account_id: *string) -> bool {
    account: AccountKeys
    available := sync_account_load(*account) != 0
    account_id.* = FrameTextHold(*app.ui.frame_text, SettingsSyncAccountId(*account))
    return available
}

SettingsSyncNormalizeAlias :: (app: *InnerBreeze) {
    output: [40]u8
    value := AppTextFromCString(*app.sync_alias_input[0], 40)
    index: s32 = 0
    written: s32 = 0
    if value.count > 0 && value[0] == #char "@" {
        index = 1
    }
    while index < cast(s32)value.count && written < 32 {
        byte := value[index]
        if byte >= #char "A" && byte <= #char "Z" {
            byte = cast(u8)(byte - #char "A" + #char "a")
        }
        if (byte >= #char "a" && byte <= #char "z") ||
        (byte >= #char "0" && byte <= #char "9") ||
        byte == #char "_" {
            output[written] = byte
            written += 1
        }
        index += 1
    }
    output[written] = cast(u8)0
    unused AppCopyText(AppTextFromCString(*output[0], 40),
        app.sync_alias_input[:])
    app.sync_alias_cursor = written
}

SettingsSyncAliasValid :: (value: string) -> bool {
    if value.count < 4 || value.count > 32 {
        return false
    }
    index: s32 = 0
    while index < cast(s32)value.count {
        byte := value[index]
        if !((byte >= #char "a" && byte <= #char "z") ||
            (byte >= #char "0" && byte <= #char "9") ||
            byte == #char "_") { return false }
        index += 1
    }
    return true
}

SettingsSyncServerNormalize :: (app: *InnerBreeze,
    output: []u8) -> bool {
    value := AppTextFromCString(*app.sync_server_url[0], 256)
    if !NormalizeUrl(value, output) {
        return false
    }
    normalized := AppTextFromCString(*output[0], cast(s32)output.count)
    if !AppCopyText(normalized, app.sync_server_url[:]) {
        return false
    }
    app.sync_server_url_cursor = cast(s32)normalized.count
    return true
}

SettingsSyncServerSave :: (app: *InnerBreeze) {
    normalized: [256]u8
    if !SyncNodeAddress(AppTextFromCString(*app.sync_server_url[0], 256), normalized[:]) {
        settings_screen_set_status_error(LocaleText("sync_server_url_invalid"))
        return
    }
    url := AppTextFromCString(*normalized[0], 256)
    if !SyncNodeAdd(url) {
        settings_screen_set_status_error(LocaleText("sync_nodes_limit"))
        return
    }
    app.sync_server_url[0] = cast(u8)0
    app.sync_server_url_cursor = 0
    app.sync_server_url_focused = 0
    settings_screen_set_status_success(LocaleText("sync_server_saved"), "")
}

SettingsSyncOpenAlias :: (app: *InnerBreeze) {
    alias := storage_get_setting_text(sync_account_alias_key)
    unused AppCopyText(alias, app.sync_alias_input[:])
    SettingsSyncNormalizeAlias(app)
    app.sync_alias_focused = 1
    app_open_modal(app, cast(ModalType)ModalSyncAlias)
}

SettingsSyncRunConnect :: (app: *InnerBreeze) {
    account: AccountKeys
    normalized: [256]u8
    if sync_account_load(*account) == 0 {
        storage_set_sync_enabled(0)
        settings_screen_set_status_error(LocaleText("sync_no_account"))
        return
    }
    if !SettingsSyncServerNormalize(app, normalized[:]) {
        storage_set_sync_enabled(0)
        settings_screen_set_status_error(LocaleText("sync_server_url_invalid"))
        return
    }
    storage_set_setting_text(sync_server_url_key,
        AppTextFromCString(*normalized[0], 256))
    storage_set_sync_enabled(1)
    settings_screen_clear_status()
    unused app_request_sync(app)
}

#program_export
settings_sync_account_save_prepared :: (app: *InnerBreeze,
    account: *AccountKeys, action: PendingSyncAccountAction,
    choice: SyncAccountLocalDataChoice) -> s32 {
    if app == null || account == null {
        return 0
    }
    result := sync_account_save(account, choice)
    if result == cast(SyncAccountSaveResult)SYNC_ACCOUNT_SAVE_NEEDS_CLEAR {
        app.pending_sync_account = account.*
        app.pending_sync_account_action = cast(s32)action
        app_open_modal(app, cast(ModalType)ModalConfirmSyncAccountSwitch)
        return 0
    }
    if result != cast(SyncAccountSaveResult)SYNC_ACCOUNT_SAVE_OK {
        return 0
    }
    app.pending_sync_account = AccountKeys.{}
    app.pending_sync_account_action = cast(s32)PendingSyncAccountNone
    if action == cast(PendingSyncAccountAction)PendingSyncAccountCreate {
        settings_screen_set_status_success(LocaleText("sync_account_created"), "")
    } else {
        if app.sync_server_url[0] == cast(u8)0 {
            saved := storage_get_setting_text(sync_server_url_key)
            if saved.count == 0 {
                saved = sync_server_url_default
            }
            unused AppCopyText(saved, app.sync_server_url[:])
        }
        SettingsSyncRunConnect(app)
    }
    return 1
}

SettingsSyncCreate :: (app: *InnerBreeze) -> s32 {
    account: AccountKeys
    if sync_account_generate(*account) == 0 {
        settings_screen_set_status_error(LocaleText("sync_account_create_failed"))
        return 0
    }
    saved := settings_sync_account_save_prepared(app, *account,
        cast(PendingSyncAccountAction)PendingSyncAccountCreate,
        cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK)
    if saved == 0 && app.modal.type != cast(ModalType)ModalConfirmSyncAccountSwitch {
        settings_screen_set_status_error(LocaleText("sync_account_create_failed"))
    }
    return saved
}

SettingsSyncConnected :: (app: *InnerBreeze) -> bool {
    account: AccountKeys
    saved: [256]u8
    if sync_account_load(*account) == 0 || storage_sync_enabled() == 0 {
        return false
    }
    return NormalizeUrl(storage_get_setting_text(sync_server_url_key), saved[:])
}

#program_export
settings_sync_account_clear_remote_confirmed :: (app: *InnerBreeze) {
    normalized: [256]u8
    if app == null || !SettingsSyncConnected(app) ||
    !NormalizeUrl(storage_get_setting_text(sync_server_url_key),
        normalized[:]) {
        settings_screen_set_status_error(LocaleText("sync_server_url_invalid"))
        return
    }
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        request := *settings_account_request
        if request.operation.active {
            return
        }
        request.* = SettingsAccountRequest.{}
        request.owner = app
        request.deleting = true
        if !BeginStoredDelete(*request.operation,
            AppTextFromCString(*normalized[0], 256), NetworkTransport(*request.transfer)) {
            request.owner = null
            settings_screen_set_status_error(LocaleText("sync_failed"))
        }
    } else {
        result := DeleteStoredAccount(AppTextFromCString(*normalized[0], 256))
        if result != cast(s32)SyncResult.SYNC_OK {
            settings_screen_set_status_error(LocaleText("sync_failed"))
            return
        }
        unused sync_account_clear()
        settings_screen_set_status_success(LocaleText("sync_remote_data_cleared"), "")
    }
}

SettingsSyncNodeHintHeight :: (width: s32) -> s32 {
    hint_props: Text.Props = SettingsSyncTextProps(LocaleText("sync_nodes_hint"), 0, 0, width, 0, true)
    hint_props.wrap = cast(Text.Wrap)TextWrapAuto
    return cast(s32)Text.PrepareText(hint_props, Text.DefaultTextFace()).bounds.height
}

// Connecting another device by QR code. Every device can show a code; a
// phone can also scan one. The section shows the current step while active.
SettingsDeviceLinkCodeSide :: (width: s32) -> s32 {
    side := width
    if side > AppScale(300) {
        side = AppScale(300)
    }
    return side
}

SettingsDeviceLinkHeight :: (width: s32) -> s32 {
    stage := device_link.stage
    if stage == cast(DeviceLinkStage)DeviceLinkShowing {
        return AppScale(30 + 56 + 58) + SettingsDeviceLinkCodeSide(width)
    }
    if stage == cast(DeviceLinkStage)DeviceLinkConfirm || stage == cast(DeviceLinkStage)DeviceLinkWaiting {
        return AppScale(30 + 52 + 60 + 48 + 10)
    }
    if stage == cast(DeviceLinkStage)DeviceLinkIdle {
        return AppScale(30 + 52 + 48 + 10)
    }
    return AppScale(30 + 52 + 48 + 10)
}

SettingsDeviceLinkUpdate :: (app: *InnerBreeze) {
    DeviceLinkPump()
    DeviceLinkTestScan()
    // A code scanned by the camera arrives like an imported file.
    scanned: [512]u8
    if AndroidPickerPoll(cast(s32)ANDROID_IMPORT_KIND_QR_CODE, scanned[:]) == .AndroidPickerSelected {
        unused DeviceLinkScan(AppTextFromCString(*scanned[0], 512))
    }
    received := DeviceLinkAccountReceived()
    if received != null {
        if settings_sync_account_save_prepared(app, received,
            cast(PendingSyncAccountAction)PendingSyncAccountImport,
            cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK) != 0 {
            SettingsSyncNow(app)
        }
        DeviceLinkImported()
    }
}

SettingsDeviceLinkOpenScanner :: () {
    if !AndroidScannerOpen(cast(s32)ANDROID_IMPORT_KIND_QR_CODE, LocaleText("device_link_scan_prompt")) {
        settings_screen_set_status_error(LocaleText("device_link_failed"))
    }
}

SettingsDeviceLinkDigits :: (app: *InnerBreeze, value: s32) -> string {
    // Six digits in two groups, as 042 917.
    digits: [7]u8
    remaining := value
    index: s32 = 6
    while index >= 0 {
        if index == 3 {
            digits[index] = cast(u8)32
        } else {
            digits[index] = cast(u8)(48 + remaining % 10)
            remaining = remaining / 10
        }
        index -= 1
    }
    return FrameTextHold(*app.ui.frame_text, TextFromBytes(digits[:]))
}

SettingsSyncStatusHeight :: (width: s32) -> s32 {
    height := AppParagraphHeight(LocaleText(app_sync_status_key()), width, AppSmallFontSize(), 0)
    return ifx height > AppScale(24) then height else AppScale(24)
}

#program_export
settings_sync_account_config_content_height :: (content_w: s32) -> s32 {
    account: AccountKeys
    link := SettingsDeviceLinkHeight(content_w)
    if sync_account_load(*account) == 0 {
        return AppScale(176) + link
    }
    hint_height := SettingsSyncNodeHintHeight(content_w)
    return AppScale(357 + SyncNodeCount() * 60 + (ifx sync_account_details then 240 else 0)) + hint_height + link + SettingsSyncStatusHeight(content_w) - AppScale(24)
}

SettingsSyncEnsureNode :: () {
    if SyncNodeCount() == 0 {
        unused SyncNodeAdd(sync_server_url_default)
    }
}

SettingsSyncDisplayId :: (app: *InnerBreeze, account_id: string) -> string {
    alias := storage_get_setting_text(sync_account_alias_key)
    if alias.count > 0 {
        label: [96]u8
        label[0] = #char "@"
        unused AppCopyText(alias, label[1:])
        return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*label[0], 96))
    }
    if account_id.count < 16 {
        return FrameTextHold(*app.ui.frame_text, account_id)
    }
    out: Vec(u8)
    BuilderPrint(*out, "%…%", account_id[:4], account_id[account_id.count - 4:])
    shortened := BuilderFinish(out)
    defer { PackageFree(shortened) }
    return FrameTextHold(*app.ui.frame_text, shortened)
}

SettingsSyncPreferredNode :: (app: *InnerBreeze) -> string {
    preferred := storage_get_setting_text("sync_preferred_node")
    if preferred.count == 0 {
        preferred = storage_get_setting_text(sync_server_url_key)
    }
    return FrameTextHold(*app.ui.frame_text, preferred)
}

SettingsSyncNodeAddress :: (app: *InnerBreeze, index: s32) -> string {
    address := SyncNodeAt(index)
    defer { PackageFree(address) }
    return FrameTextHold(*app.ui.frame_text, address)
}

SettingsSyncNow :: (app: *InnerBreeze) {
    storage_set_sync_enabled(1)
    unused app_request_sync(app)
}

SettingsSyncCopyId :: (account_id: string) {
    unused TextInputWriteClipboard(account_id)
    settings_screen_set_status_success(LocaleText("sync_public_id_copied"), "")
}

SettingsSyncLogout :: () {
    unused sync_account_clear()
    settings_screen_set_status_success(LocaleText("sync_logged_out_local_data_kept"), "")
}

#program_export
settings_sync_account_draw_config :: (app: *InnerBreeze, x: s32, width: s32, y: *s32) {
    SettingsSyncAccountConfig(app, x, width, y)
}

SettingsSyncTakeAliasResult :: (app: *InnerBreeze) -> s32 {
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        request := *settings_account_request
        if request.owner == app && request.alias_result != 0 {
            result := request.alias_result
            request.alias_result = 0
            request.owner = null
            return result
        }
    } else {
        unused app
    }
    return 0
}

SettingsSyncAliasBusy :: () -> bool {
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        return settings_account_request.operation.active
    } else {
        return false
    }
}

SettingsSyncSubmitAlias :: (app: *InnerBreeze, alias: string) -> s32 {
    url: [256]u8
    if !SettingsSyncConnected(app) ||
        !NormalizeUrl(storage_get_setting_text(sync_server_url_key), url[:]) {
        return 2
    }
    address := AppTextFromCString(*url[0], 256)
    #if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
        if !SettingsBeginAlias(app, address, alias) {
            return 2
        }
        return 0
    } else {
        return ifx RegisterAliasStored(address, alias) == cast(s32)SyncResult.SYNC_OK then 1 else 2
    }
}

#program_export
settings_sync_account_draw_alias_modal :: (app: *InnerBreeze) -> s32 {
    return SettingsSyncAliasModal(app)
}

#program_export
PublicIdDisplayGroups :: (id: string, out: []u8) -> string {
    if id.count != 64 || out.count < 72 {
        if out.count == 0 || !AppCopyText(id, out) {
            if out.count != 0 { out[0] = cast(u8)0 }
            return TextFromCString(*out[0])
        }
        return TextFromCString(*out[0])
    }

    group: s32 = 0
    while group < 8 {
        start := group * 8
        destination := group * 9
        index: s32 = 0
        while index < 8 {
            out[destination + index] = id[start + index]
            index += 1
        }
        if group == 3 {
            out[35] = cast(u8)10
        } else if group != 7 {
            out[destination + 8] = cast(u8)32
        }
        group += 1
    }
    out[71] = cast(u8)0
    return TextFromCString(*out[0])
}

NewTyped :: () -> [128]u8 {
    result: [128]u8
    return result
}

NewAliasLabel :: () -> [96]u8 {
    result: [96]u8
    return result
}

NewByteBuffer :: () -> Vec(u8) {
    result: Vec(u8)
    return result
}

NewDisplayedId :: () -> [80]u8 {
    result: [80]u8
    return result
}

#program_export
settings_sync_account_draw_public_id_modal :: (app: *InnerBreeze, public_id: string = "") -> s32 {
    return SettingsSyncPublicIdModal(app, public_id)
}
