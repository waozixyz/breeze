AppearanceErrorText :: (app: *InnerBreeze, error: string) -> string {
    message: Vec(u8)
    BuilderPrint(*message, "%:%:%  %", AppTextFromCString(*style_error_path[0], 64), style_error_line, style_error_column, error)
    details := BuilderFinish(message)
    result := FrameTextHold(*app.ui.frame_text, details)
    PackageFree(details)
    return result
}
