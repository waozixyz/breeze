update_available :: () -> s32 #foreign c "update_available";
update_can_self_update :: () -> s32 #foreign c "update_can_self_update";
update_is_downloading :: () -> s32 #foreign c "update_is_downloading";
update_download_fraction :: () -> float64 #foreign c "update_download_fraction";
update_row_action :: () #foreign c "update_row_action";
update_row_text_native :: () -> *u8 #foreign c "update_row_text";
update_action_label_native :: () -> *u8 #foreign c "update_action_label";
update_error_text_native :: () -> *u8 #foreign c "update_error_text";
update_download_url_native :: () -> *u8 #foreign c "update_download_url";

update_host_text :: (value: *u8) -> string {
    if value == null { return "" }
    return AppTextFromCString(value, 1024)
}
