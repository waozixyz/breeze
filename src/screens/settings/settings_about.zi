about_link_icon_columns :: (content_w: s32) -> s32 {
    link_count: s32 = 3
    icon_size: s32 = AppScale(32)
    icon_padding: s32 = AppScale(4)
    icon_spacing: s32 = AppScale(20)
    icon_btn_w: s32 = icon_size + icon_padding * 2
    max_columns: s32 = 3
    min_columns: s32 = 2
    if content_w < AppScale(240) {
        min_columns = 2
    }

    {
        columns: s32 = max_columns
        while columns >= min_columns {
            total_w := icon_btn_w * columns + icon_spacing * (columns - 1)
            if total_w <= content_w {
                return columns
            }
            columns -= 1
        }
    }
    return min_columns
}

about_link_icons_height :: (content_w: s32) -> s32 {
    link_count: s32 = 3
    icon_size: s32 = AppScale(32)
    icon_padding: s32 = AppScale(4)
    row_spacing: s32 = AppScale(16)
    icon_btn_w: s32 = icon_size + icon_padding * 2
    columns: s32 = about_link_icon_columns(content_w)
    rows: s32 = (link_count + columns - 1) / columns

    return rows * icon_btn_w + (rows - 1) * row_spacing
}

// Show apps installed on this device, not every app offered by the node.
about_route_installed :: (app: *InnerBreeze, route: s32) -> bool {
    if app == null {
        return false
    }
    slot := AppNavNodeSlot(route)
    if slot >= 0 {
        return NodeAppInstalled(slot) && PackageAvailable(NodeAppIndex(slot))
    }
    return (app.enabled_apps & app_nav_route_bit(route)) != 0 &&
    PackageAvailable(LauncherAppPackage(route))
}

// Core and each installed app.
about_package_count :: (app: *InnerBreeze) -> s32 {
    count: s32 = 1
    routes := LauncherRoutes()
    for route: routes {
        if about_route_installed(app, route) {
            count += 1
        }
    }
    return count
}



settings_about_content_height :: (content_w: s32) -> s32 {
    description_height := AppParagraphHeight(LocaleText("about_text"), content_w,
        AppFontSize(), AppScale(4))
    update_row := ifx (update_available() != 0) then (AppScale(72)) else (0)

    pending_root := ifx PackageRootPending() then AppScale(28) else 0
    // One version row for each package, Core included.
    package_rows := about_package_count(CurrentApp()) * AppScale(28)
    return AppScale(188) + package_rows + update_row + pending_root + description_height + about_link_icons_height(content_w) +
    about_package_updates_height(content_w)
}

// Changes the answer to the Apps question about package updates.
about_package_updates_height :: (content_w: s32) -> s32 {
    if !PackageUpdatesPossible() {
        return 0
    }
    note_h := AppParagraphHeight(LocaleText("package_updates_note"), content_w,
        AppFontSize(), AppScale(4))
    return toggle_row_height(LocaleText("package_updates_setting"), content_w) +
    note_h + AppScale(20)
}



ABOUT_SOCIAL_DISCORD :: 0
ABOUT_SOCIAL_TELEGRAM :: 1
ABOUT_SOCIAL_GITHUB :: 2

about_social_icon_asset :: (app: *InnerBreeze, kind: s32) -> string {
    if kind == ABOUT_SOCIAL_TELEGRAM {
        return "assets/social/telegram.svg"
    }
    if kind == ABOUT_SOCIAL_GITHUB {
        return ifx (app != null && app.dark_mode == 0) then ("assets/social/github-dark-on-light.webp") else ("assets/social/github-light-on-dark.webp")
    }
    return "assets/social/discord.webp"
}

about_social_icon_alt :: (kind: s32) -> string {
    if kind == ABOUT_SOCIAL_TELEGRAM {
        return "Telegram"
    }
    if kind == ABOUT_SOCIAL_GITHUB {
        return "GitHub"
    }
    return "Discord"
}





