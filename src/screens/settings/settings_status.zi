#import "std/vec"

// Settings messages own their bytes. Replacing a message preserves any older
// value a caller is still reading on native and portable targets.
SettingsStatus :: struct {
    message: string
    detail: string
    kind: s32
}

current: SettingsStatus;
StatusTextCapacity :: 4096
StatusOwn :: (text: string) -> string {
    count := text.count
    if count >= StatusTextCapacity {
        count = StatusTextCapacity - 1
        // End before a partial UTF-8 sequence when bounding a long detail.
        while count > 0 && (text[count] & cast(u8)192) == cast(u8)128 {
            count -= 1
        }
    }
    bytes: Vec(u8)
    if !BuilderAppend(bytes, text[0:count]) {
        VecFree(bytes)
        return ""
    }
    return BuilderFinish(bytes)
}

StatusStore :: (message: string, detail: string, kind: s32) {
    // Finish both copies before replacing current: either input may be a
    // field of the previous status, including when the fields are swapped.
    next: SettingsStatus
    next.message = StatusOwn(message)
    next.detail = StatusOwn(detail)
    next.kind = kind
    current = next
}

#program_export
settings_screen_set_status_success :: (message: string, detail: string) {
    StatusStore(message, detail, 1)
}

#program_export
settings_screen_set_status_error :: (message: string) {
    StatusStore(message, "", 2)
}

#program_export
settings_screen_clear_status :: () {
    current = SettingsStatus.{}
}

#program_export
settings_screen_status :: () -> SettingsStatus {
    return current
}
