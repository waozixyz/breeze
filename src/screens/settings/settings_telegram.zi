using Text.Wrap;
using ButtonEmphasis;
using AppNavRoute;

settings_telegram_text_height :: (key: string, width: s32) -> s32 {
    prepared := Text.PrepareText(Text.Props.{.text = LocaleText(key), .size = AppFontSize(),
            .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
            .wrap = cast(Text.Wrap)TextWrapAuto}, Text.DefaultTextFace())
    return cast(s32)prepared.bounds.height + AppScale(16)
}

settings_telegram_format_fields :: (format: string, fields: []string) -> string {
    out: Vec(u8)
    start: s64 = 0
    field: s32 = 0
    for index: 0..cast(s64)format.count - 1 {
        if format[index] == cast(u8)37 {
            if field >= cast(s32)fields.count {
                VecFree(out)
                return ""
            }
            BuilderPrint(*out, "%", format[start:index])
            BuilderPrint(*out, "%", fields[field])
            field += 1
            start = index + 1
        }
    }
    if field != cast(s32)fields.count {
        VecFree(out)
        return ""
    }
    BuilderPrint(*out, "%", format[start:])
    return BuilderFinish(out)
}

settings_telegram_review_text :: (width: s32) -> string {
    if !lumi_authorization_ready {
        return ""
    }
    pending := *lumi_authorization_pending
    signing: [65]u8
    encryption: [65]u8
    bot: [24]u8
    user: [24]u8
    expiry: [24]u8
    if !HashText(TextUntilNul(pending.signing_key[:]), signing[:]) ||
    !HashText(TextUntilNul(pending.encryption_key[:]), encryption[:]) ||
    !AppFormatS64(pending.bot_id, bot[:]) || !AppFormatS64(pending.telegram_id, user[:]) ||
    !AppFormatS64(pending.expires_at, expiry[:]) {
        return ""
    }
    details: [8]string = .[TextUntilNul(pending.app_id[:]), TextUntilNul(pending.account_id[:]),
    TextUntilNul(bot[:]), TextUntilNul(user[:]), TextUntilNul(pending.node_id[:]),
    TextUntilNul(pending.audience[:]), TextUntilNul(pending.scopes[0].collection[:]), TextUntilNul(expiry[:])]
    fingerprints: [2]string = .[TextUntilNul(signing[:]), TextUntilNul(encryption[:])]
    identity_text := settings_telegram_format_fields(LocaleText("lumi_authorization_details"), details[:])
    keys_text := settings_telegram_format_fields(LocaleText("lumi_authorization_fingerprints"), fingerprints[:])
    if identity_text.count == 0 || keys_text.count == 0 {
        PackageFree(identity_text)
        PackageFree(keys_text)
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "%\n\n%", identity_text, keys_text)
    PackageFree(identity_text)
    PackageFree(keys_text)
    raw_review := BuilderFinish(out)
    display: [8193]u8
    complete := TelegramAccountReviewText(raw_review, width, display[:])
    PackageFree(raw_review)
    if !complete {
        return ""
    }
    formatted: Vec(u8)
    BuilderPrint(*formatted, "%", TextUntilNul(display[:]))
    return BuilderFinish(formatted)
}

// Mini App approval appears only while a request waits for this device.
settings_telegram_authorization_active :: () -> bool {
    return lumi_authorization_ready || lumi_authorization_pending.request_id[0] != cast(u8)0 ||
    lumi_authorization_state == 5
}

settings_telegram_content_height :: (width: s32) -> s32 {
    height := settings_telegram_text_height(LumiTelegramStatusKey(), width) + AppScale(64)
    if storage_get_setting_text("sync_private_key").count == 0 || !lumi_telegram_connection.linked {
        return height
    }
    height += AppScale(112)
    if !settings_telegram_authorization_active() {
        return height
    }
    height += settings_telegram_text_height(LumiAuthorizationStatusKey(), width) + AppScale(112)
    if lumi_authorization_ready {
        height += settings_telegram_text_height("lumi_authorization_stars_disclosure", width) + AppScale(56)
    }
    review := settings_telegram_review_text(width)
    if review.count > 0 {
        prepared := Text.PrepareText(Text.Props.{.text = review, .size = AppFontSize(),
                .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
                .wrap = cast(Text.Wrap)TextWrapAuto}, Text.DefaultTextFace())
        height += cast(s32)prepared.bounds.height + AppScale(16)
        PackageFree(review)
    }
    return height
}

settings_telegram_stars_review: [65]u8;
settings_telegram_stars_key: u64 = 2605726463190171648;

settings_telegram_stars_ready :: (review: string, disclosure: string, label: string) -> bool {
    pending := *lumi_authorization_pending
    owner := TextUntilNul(pending.account_id[:])
    request := TextUntilNul(pending.request_id[:])
    if LumiAuthorizationBusy() || review == "" || disclosure == "" || label == "" ||
    label == LocaleText("lumi_authorization_approve") || owner.count != 64 || request.count != 32 ||
    storage_get_setting_text("sync_public_id") != owner {
        settings_telegram_stars_review[0] = 0
        return false
    }
    fields: Vec(u8)
    BuilderPrint(*fields, "%:%:%:%:%:%:%:%", owner, request,
        review.count, review, disclosure.count, disclosure, label.count, label)
    document := BuilderFinish(fields)
    digest: [65]u8
    hashed := HashText(document, digest[:])
    PackageFree(document)
    if !hashed {
        settings_telegram_stars_review[0] = 0
        return false
    }
    if TextUntilNul(settings_telegram_stars_review[:]) != TextUntilNul(digest[:]) {
        settings_telegram_stars_review = digest
        settings_telegram_stars_key += 1
    }
    return true
}

// One line says what to do next and one button does it.
