using TextWrap;
using ButtonEmphasis;
using AppNavRoute;

settings_telegram_text_height :: (key: string, width: s32) -> s32 {
    prepared := PrepareText(TextProps.{.text = LocaleText(key), .font = AppFontSize(),
            .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
            .wrap = cast(TextWrap)TextWrapAuto}, DefaultTextFace())
    return cast(s32)prepared.bounds.height + AppScale(16)
}

settings_telegram_format_fields :: (format: string, fields: []string) -> string {
    out: Vec(u8)
    start: s64 = 0
    field: s32 = 0
    for index: 0..cast(s64)format.count - 1 {
        if format[index] == cast(u8)37 {
            if field >= cast(s32)fields.count {
                VecFree(out)
                return ""
            }
            BuilderPrint(*out, "%", format[start:index])
            BuilderPrint(*out, "%", fields[field])
            field += 1
            start = index + 1
        }
    }
    if field != cast(s32)fields.count {
        VecFree(out)
        return ""
    }
    BuilderPrint(*out, "%", format[start:])
    return BuilderFinish(out)
}

settings_telegram_review_text :: () -> string {
    if !lumi_authorization_ready {
        return ""
    }
    pending := *lumi_authorization_pending
    signing: [65]u8
    encryption: [65]u8
    bot: [24]u8
    user: [24]u8
    expiry: [24]u8
    if !HashText(TextUntilNul(pending.signing_key[:]), signing[:]) ||
    !HashText(TextUntilNul(pending.encryption_key[:]), encryption[:]) ||
    !AppFormatS64(pending.bot_id, bot[:]) || !AppFormatS64(pending.telegram_id, user[:]) ||
    !AppFormatS64(pending.expires_at, expiry[:]) {
        return ""
    }
    details: [8]string = .[TextUntilNul(pending.app_id[:]), TextUntilNul(pending.account_id[:]),
    TextUntilNul(bot[:]), TextUntilNul(user[:]), TextUntilNul(pending.node_id[:]),
    TextUntilNul(pending.audience[:]), TextUntilNul(pending.scopes[0].collection[:]), TextUntilNul(expiry[:])]
    fingerprints: [2]string = .[TextUntilNul(signing[:]), TextUntilNul(encryption[:])]
    identity_text := settings_telegram_format_fields(LocaleText("lumi_authorization_details"), details[:])
    keys_text := settings_telegram_format_fields(LocaleText("lumi_authorization_fingerprints"), fingerprints[:])
    if identity_text.count == 0 || keys_text.count == 0 {
        PackageFree(identity_text)
        PackageFree(keys_text)
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "%\n\n%", identity_text, keys_text)
    PackageFree(identity_text)
    PackageFree(keys_text)
    return BuilderFinish(out)
}

settings_telegram_content_height :: (width: s32) -> s32 {
    height := settings_telegram_text_height("lumi_telegram_body", width) +
    settings_telegram_text_height(LumiTelegramStatusKey(), width) + AppScale(120)
    if storage_get_setting_text("sync_private_key").count == 0 || !lumi_telegram_linked {
        return height
    }
    height += settings_telegram_text_height(LumiAuthorizationStatusKey(), width) + AppScale(112)
    review := settings_telegram_review_text()
    if review.count > 0 {
        prepared := PrepareText(TextProps.{.text = review, .font = AppFontSize(),
                .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
                .wrap = cast(TextWrap)TextWrapAuto}, DefaultTextFace())
        height += cast(s32)prepared.bounds.height + AppScale(16)
        PackageFree(review)
    }
    return height
}

settings_telegram_draw :: (app: *InnerBreeze, x: s32, width: s32, y: *s32) {
    keys: [2]string = .["lumi_telegram_body", LumiTelegramStatusKey()]
    for key: keys {
        height := settings_telegram_text_height(key, width)
        Text(app.ui.session, TextProps.{.text = LocaleText(key), .font = AppFontSize(),
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)height},
                .wrap = cast(TextWrap)TextWrapAuto})
        y.* += height
    }
    has_account := storage_has_sync_account() != 0 &&
    storage_get_setting_text("sync_private_key").count > 0
    linked := lumi_telegram_linked && has_account
    label := "lumi_telegram_connect"
    if !has_account {
        label = "sync_connect_account_button"
    } else if linked {
        label = "lumi_telegram_open"
    }
    if Button(app.ui.session, ButtonProps.{.id = 7650,
            .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(48)},
            .label = LocaleText(label), .disabled = LumiTelegramBusy(), .loading = LumiTelegramBusy()}) != 0 {
        if !has_account {
            app_apply_nav_route(app, cast(s32)APP_NAV_ROUTE_PROFILE)
        } else if linked {
            if !LumiTelegramOpen() {
                lumi_telegram_error = true
            }
        } else {
            LumiTelegramLink()
        }
    }
    y.* += AppScale(56)
    if linked {
        status_height := settings_telegram_text_height(LumiAuthorizationStatusKey(), width)
        Text(app.ui.session, TextProps.{.text = LocaleText(LumiAuthorizationStatusKey()), .font = AppFontSize(),
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)status_height},
                .wrap = cast(TextWrap)TextWrapAuto})
        y.* += status_height
        review_visible := false
        review := settings_telegram_review_text()
        if review.count > 0 {
            prepared := PrepareText(TextProps.{.text = review, .font = AppFontSize(),
                    .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0},
                    .wrap = cast(TextWrap)TextWrapAuto}, DefaultTextFace())
            review_height := cast(s32)prepared.bounds.height + AppScale(16)
            held_review := FrameTextHold(*app.ui.frame_text, review)
            review_visible = held_review.count > 0
            Text(app.ui.session, TextProps.{.text = held_review, .font = AppFontSize(),
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)review_height},
                    .wrap = cast(TextWrap)TextWrapAuto})
            y.* += review_height
            PackageFree(review)
        }
        if lumi_authorization_ready {
            if Button(app.ui.session, ButtonProps.{.id = 7652,
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(48)},
                    .label = LocaleText("lumi_authorization_approve"),
                    .disabled = LumiAuthorizationBusy() || !review_visible,
                    .loading = LumiAuthorizationBusy()}) != 0 {
                LumiAuthorizationApprove()
            }
            y.* += AppScale(56)
        } else if lumi_authorization_pending.request_id[0] == cast(u8)0 && !LumiAuthorizationHasGrant() {
            if Button(app.ui.session, ButtonProps.{.id = 7653,
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(48)},
                    .label = LocaleText("lumi_authorization_request"), .disabled = LumiAuthorizationBusy(),
                    .loading = LumiAuthorizationBusy()}) != 0 {
                LumiAuthorizationRequest()
            }
            y.* += AppScale(56)
        }
        if lumi_authorization_pending.request_id[0] != cast(u8)0 {
            if Button(app.ui.session, ButtonProps.{.id = 7654,
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(48)},
                    .label = LocaleText("cancel_button"), .disabled = LumiAuthorizationBusy(),
                    .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 {
                LumiAuthorizationCancel()
            }
            y.* += AppScale(56)
        }
        if Button(app.ui.session, ButtonProps.{.id = 7651,
                .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, cast(float32)width, cast(float32)AppScale(48)},
                .label = LocaleText(ifx LumiAuthorizationHasGrant() then "lumi_authorization_revoke" else "lumi_telegram_disconnect"),
                .disabled = LumiTelegramBusy(),
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 {
            LumiTelegramDisconnect()
        }
        y.* += AppScale(56)
    }
}
