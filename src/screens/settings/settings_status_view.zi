#import, file "settings_status.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/current_app.zi";
#import, file "../../app/metrics.zi";
#import "geometry"
#import "session"
#import "text_props"
#import "text_widget"

using TextWrap;

settings_draw_status_line :: (value: string, x: s32, y: s32) {
    app := CurrentApp()
    if app == null || value.count == 0 {
        return
    }
    Text(app.ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y, 0.0, 0.0},
        .text = value,
        .wrap = cast(TextWrap)TextWrapNone
    })
}

#program_export
settings_screen_draw_status_reserved :: (x: s32, y: *s32,
    reserved_h: s32) {
    if y == null {
        return
    }
    status := settings_screen_status()
    status_y := y.*
    if status.message.count != 0 {
        settings_draw_status_line(status.message, x, status_y)
        status_y += AppScale(18)
        if status.detail.count != 0 {
            settings_draw_status_line(status.detail, x, status_y)
        }
    }
    y.* += reserved_h
}
