using AppOrientationMode;
using ButtonTone;
using ButtonEmphasis;

settings_device_orientation_option_count :: () -> s32 {
    if DesktopPlatform() != 0 {
        return 3
    }
    return 4
}

settings_device_clamp :: (value: s32, minimum: s32, maximum: s32) -> s32 {
    if value < minimum {
        return minimum
    }
    if value > maximum {
        return maximum
    }
    return value
}

settings_device_language_body :: (width: s32) -> s32 {
    return toggle_row_height(LocaleText("language_system_label"), width) +
    settings_choice_row_height(LocaleText("language_label"), width)
}

settings_device_display_body :: (width: s32) -> s32 {
    height := settings_choice_row_height(LocaleText("orientation_label"), width)
    if DesktopPlatform() != 0 {
        height += toggle_row_height(LocaleText("fullscreen_label"), width)
        height += toggle_row_height(LocaleText("on_screen_keyboard_label"), width)
    }
    return height
}

settings_device_window_body :: (width: s32) -> s32 {
    return settings_choice_row_height(
        LocaleText("desktop_startup_mode_label"), width) +
    settings_choice_row_height(
        LocaleText("desktop_close_action_label"), width)
}

settings_device_playback_body :: (width: s32) -> s32 {
    height := toggle_row_height(LocaleText("play_in_background_label"), width)
    if AndroidPlatform() != 0 {
        height += toggle_row_height(LocaleText("picture_in_picture_label"), width)
    }
    return height
}

#program_export
settings_device_content_height :: (content_width: s32) -> s32 {
    width := content_width
    if width <= 0 {
        width = AppScale(240)
    }
    inner := settings_section_inner_width(width)
    height := settings_section_height(LocaleText("language_label"),
        settings_device_language_body(inner))
    height += settings_section_height(LocaleText("settings_section_display"),
        settings_device_display_body(inner))
    if DesktopPlatform() != 0 {
        height += settings_section_height(
            LocaleText("settings_section_window"),
            settings_device_window_body(inner))
    }
    height += settings_section_height(
        LocaleText("settings_section_playback"),
        settings_device_playback_body(inner))
    return height
}

settings_device_draw_language :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, state: *SettingsDeviceState) {
    inner := settings_section_inner_width(width)
    section := settings_section_begin(app, x, width, y,
        LocaleText("language_label"), settings_device_language_body(inner))
    language_system := app.language_system
    if commit_toggle_row(app, section.inner_x, section.inner_width, y,
        LocaleText("language_system_label"), *language_system, 0) != 0 {
        app.language_system = language_system
        if app.language_system != 0 {
            apply_system_language_selection(app, 1)
        } else {
            apply_language_selection(app, app.language_index, 1)
        }
    }
    settings_row_divider(app, section, y.*)
    language_props: DropdownProps
    language_props.id = 101
    language_props.bounds = settings_choice_row(app, section.inner_x,
        section.inner_width, y, LocaleText("language_label"))
    language_props.selected_index = app.language_index
    language_props.placeholder = LocaleText("language_label")
    language_props.disabled = app.language_system != 0
    locale_settings_menu := LocaleDropdown(app.ui.session, language_props)
    if locale_settings_menu.changed {
        app.language_index = locale_settings_menu.selected_index
        state.language_menu_changed = 1
    }
    settings_section_end(y)
}

settings_device_draw_display :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, state: *SettingsDeviceState) {
    desktop := DesktopPlatform() != 0
    inner := settings_section_inner_width(width)
    section := settings_section_begin(app, x, width, y,
        LocaleText("settings_section_display"),
        settings_device_display_body(inner))
    orientation_count := settings_device_orientation_option_count()
    app.orientation_mode = settings_device_clamp(app.orientation_mode,
        cast(s32)APP_ORIENTATION_SYSTEM, orientation_count - 1)
    orientation_options: [4]DropdownOption
    orientation_options[0].label = LocaleText("orientation_system")
    orientation_options[1].label = LocaleText("orientation_portrait")
    orientation_options[2].label = LocaleText("orientation_landscape")
    orientation_options[3].label = LocaleText("orientation_sensor")
    orientation: DropdownProps
    orientation.id = 103
    orientation.bounds = settings_choice_row(app, section.inner_x,
        section.inner_width, y, LocaleText("orientation_label"))
    orientation.selected_index = app.orientation_mode
    orientation_settings_menu := Dropdown(app.ui.session, orientation,
        orientation_options[:orientation_count])
    if orientation_settings_menu.changed {
        app.orientation_mode = orientation_settings_menu.selected_index
        state.orientation_changed = 1
    }
    if desktop {
        settings_row_divider(app, section, y.*)
        fullscreen := app.fullscreen_enabled
        if commit_toggle_row(app, section.inner_x, section.inner_width, y,
            LocaleText("fullscreen_label"), *fullscreen, 0) != 0 {
            app.fullscreen_enabled = fullscreen
            app_desktop_set_fullscreen(app.fullscreen_enabled)
        }
        settings_row_divider(app, section, y.*)
        keyboard := app.on_screen_keyboard_enabled
        if commit_toggle_row(app, section.inner_x, section.inner_width, y,
            LocaleText("on_screen_keyboard_label"), *keyboard, 0) != 0 {
            app.on_screen_keyboard_enabled = keyboard
        }
    }
    settings_section_end(y)
}

settings_device_draw_window :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32) {
    inner := settings_section_inner_width(width)
    section := settings_section_begin(app, x, width, y,
        LocaleText("settings_section_window"),
        settings_device_window_body(inner))
    startup_options: [2]DropdownOption
    startup_options[0].label = LocaleText("desktop_startup_mode_normal")
    startup_options[1].label = LocaleText("desktop_startup_mode_minimized")
    startup: DropdownProps
    startup.id = 104
    startup.bounds = settings_choice_row(app, section.inner_x,
        section.inner_width, y, LocaleText("desktop_startup_mode_label"))
    startup.selected_index = app.desktop_startup_mode
    startup_settings_menu := Dropdown(app.ui.session, startup,
        startup_options[:])
    if startup_settings_menu.changed {
        app.desktop_startup_mode = startup_settings_menu.selected_index
        app.settings_dirty = 1
        save_settings(app)
    }
    settings_row_divider(app, section, y.*)
    close_options: [3]DropdownOption
    close_options[0].label = LocaleText("desktop_close_action_ask")
    close_options[1].label = LocaleText("desktop_close_action_keep_running")
    close_options[2].label = LocaleText("desktop_close_action_quit")
    close: DropdownProps
    close.id = 105
    close.bounds = settings_choice_row(app, section.inner_x,
        section.inner_width, y, LocaleText("desktop_close_action_label"))
    close.selected_index = app.desktop_close_action
    close_settings_menu := Dropdown(app.ui.session, close,
        close_options[:])
    if close_settings_menu.changed {
        app.desktop_close_action = close_settings_menu.selected_index
        app.settings_dirty = 1
        save_settings(app)
    }
    settings_section_end(y)
}

settings_device_draw_playback :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32) {
    inner := settings_section_inner_width(width)
    section := settings_section_begin(app, x, width, y,
        LocaleText("settings_section_playback"),
        settings_device_playback_body(inner))
    play_in_background := app.breathing.play_in_background
    if commit_toggle_row(app, section.inner_x, section.inner_width, y,
        LocaleText("play_in_background_label"), *play_in_background, 0) != 0 {
        app.breathing.play_in_background = play_in_background
    }
    // Android's floating practice window over other apps.
    if AndroidPlatform() != 0 {
        picture_in_picture := app.picture_in_picture_enabled
        if commit_toggle_row(app, section.inner_x, section.inner_width, y,
            LocaleText("picture_in_picture_label"), *picture_in_picture, 1) != 0 {
            app.picture_in_picture_enabled = picture_in_picture
        }
    }
    settings_section_end(y)
}

#program_export
settings_device_draw :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, state: *SettingsDeviceState) {
    if app == null || y == null || state == null {
        return
    }
    if DesktopPlatform() == 0 {
        app.on_screen_keyboard_enabled = 1
    }
    settings_device_draw_language(app, x, width, y, state)
    settings_device_draw_display(app, x, width, y, state)
    if DesktopPlatform() != 0 {
        settings_device_draw_window(app, x, width, y)
    }
    settings_device_draw_playback(app, x, width, y)
}

#program_export
settings_device_handle_overlays :: (app: *InnerBreeze,
    state: *SettingsDeviceState) {
    if app == null || state == null {
        return
    }
    if state.language_menu_changed != 0 {
        apply_language_selection(app, app.language_index, 1)
    }
    if state.orientation_changed != 0 {
        app.orientation_mode = settings_device_clamp(app.orientation_mode,
            cast(s32)APP_ORIENTATION_SYSTEM,
            settings_device_orientation_option_count() - 1)
        app_apply_orientation_preference(app)
        app.settings_dirty = 1
        save_settings(app)
    }
}
