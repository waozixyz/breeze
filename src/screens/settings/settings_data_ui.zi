using ModalType;
using PendingSyncAccountAction;
using SyncAccountLocalDataChoice;
using StorageImportMode;
using ButtonTone;
using ButtonEmphasis;
using TextWrap;
using AndroidImportKind;
using AndroidImportResult;

app_reload_after_import :: (app: *InnerBreeze,
    reload_settings: s32) #foreign c;
app_pick_file :: (title: *u8, filter: *u8,
    suggested_name: *u8, save: bool,
    output: *u8, capacity: s32) -> s32 #foreign c;
malloc :: (size: usize) -> *void #foreign c;
android_share_bytes :: (data: *u8, size: u64, filename: *u8,
    mime: *u8, title: *u8) -> s32 #foreign c;
#if #defined(PLATFORM_WEB) {
    web_download_file :: (path: *u8, filename: *u8,
        mime: *u8) -> s32 #foreign c;
}
free :: (value: *void) #foreign c;

pending_import_path: [4096]u8;
pending_import_info: DataImportInfo;
pending_android_import_kind: s32 = -1;

SettingsDataRect :: (x: s32, y: s32, width: s32,
    height: s32) -> Rectangle {
    return Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)height}
}

SettingsDataTextProps :: (value: string,
    x: s32, y: s32, width: s32, height: s32) -> TextProps {
    props: TextProps
    props.bounds = SettingsDataRect(x, y, width, height)
    props.text = value
    return props
}

SettingsDataButtonProps :: (label: string, x: s32, y: s32,
    width: s32, id: s32, accent: bool) -> ButtonProps {
    props: ButtonProps
    props.bounds = SettingsDataRect(x, y, width, AppScale(38))
    props.id = id
    props.label = label
    props.tone = cast(ButtonTone)(ifx (accent) then
        (ButtonToneAccent) else (ButtonToneNeutral))
    props.emphasis = cast(ButtonEmphasis)(ifx (accent) then
        (ButtonEmphasisFilled) else (ButtonEmphasisSoft))
    return props
}

SettingsDataPick :: (title: string, filter: string,
    suggested: string, save: bool, output: []u8) -> s32 {
    title_bytes: [256]u8
    filter_bytes: [128]u8
    suggested_bytes: [256]u8
    if output.count == 0 || output.count > 2147483647 ||
    !AppCopyText(title, title_bytes[:]) ||
    !AppCopyText(filter, filter_bytes[:]) ||
    !AppCopyText(suggested, suggested_bytes[:]) { return -1 }
    return app_pick_file(*title_bytes[0], *filter_bytes[0],
        *suggested_bytes[0], save, *output[0], cast(s32)output.count)
}

SettingsDataExportPath :: (filename: string, output: []u8) -> bool {
    root: [512]u8
    name: [256]u8
    if output.count == 0 ||
    !AppCopyText(data_root(), root[:]) ||
    !AppCopyText(filename, name[:]) {
        return false
    }
    return storage_join_path(*output[0], cast(u64)output.count,
        *root[0], *name[0]) != 0
}

SettingsDataReleaseExportPath :: (path: string) {
    if WebPlatform() != 0 || AndroidPlatform() != 0 {
        unused RemoveFile(path)
    }
}

SettingsDataReleaseWebImport :: (path: string) {
    if WebPlatform() != 0 {
        unused RemoveFile(path)
    }
}

SettingsDataDeliverExport :: (path: string, filename: string,
    mime: string) -> bool {
    path_bytes: [4096]u8
    name_bytes: [256]u8
    mime_bytes: [128]u8
    title_bytes: [256]u8
    if !AppCopyText(path, path_bytes[:]) ||
    !AppCopyText(filename, name_bytes[:]) ||
    !AppCopyText(mime, mime_bytes[:]) ||
    !AppCopyText(LocaleText("share_sheet_title"), title_bytes[:]) {
        return false
    }
    #if #defined(PLATFORM_WEB) {
        downloaded := web_download_file(*path_bytes[0], *name_bytes[0],
            *mime_bytes[0]) != 0
        SettingsDataReleaseExportPath(path)
        return downloaded
    }
    if AndroidPlatform() == 0 {
        return true
    }
    file := OpenRead(path)
    if !file.valid {
        return false
    }
    size := FileSize(file)
    if size <= 0 || size > 2147483647 {
        unused CloseFile(file)
        return false
    }
    bytes := cast(*u8)malloc(cast(usize)size)
    if bytes == null {
        unused CloseFile(file)
        return false
    }
    read_count := ReadAt(file, BytesFromPointer(bytes, cast(u64)size), 0)
    closed := CloseFile(file)
    if read_count != size || !closed {
        free(cast(*void)bytes)
        return false
    }
    shared := android_share_bytes(bytes, cast(u64)size,
        *name_bytes[0], *mime_bytes[0], *title_bytes[0]) != 0
    free(cast(*void)bytes)
    SettingsDataReleaseExportPath(path)
    return shared
}

SettingsDataBeginAndroidImport :: (kind: s32) -> bool {
    mime: [16]u8
    if !AppCopyText("*/*", mime[:]) {
        return false
    }
    if android_import_open_picker_for(kind, *mime[0]) == 0 {
        return false
    }
    pending_android_import_kind = kind
    return true
}

SettingsDataImportSucceeded :: (app: *InnerBreeze,
    import_settings: bool) {
    app_reload_after_import(app, ifx (import_settings) then (1) else (0))
    settings_screen_set_status_success(LocaleText("imported_data"), "")
}

SettingsDataPerformImport :: (app: *InnerBreeze, path: string,
    mode: StorageImportMode) -> bool {
    if app == null || path.count == 0 {
        settings_screen_set_status_error(LocaleText("import_invalid_file"))
        return false
    }
    if data_import_with_mode(path, mode) != 0 {
        SettingsDataImportSucceeded(app,
            mode == cast(StorageImportMode)STORAGE_IMPORT_DATA_AND_SETTINGS)
        return true
    }
    settings_screen_set_status_error(LocaleText("import_failed"))
    return false
}

SettingsDataInspectImport :: (app: *InnerBreeze, path: string) {
    info: DataImportInfo
    if path.count == 0 || data_inspect_import(path, *info) == 0 ||
    info.valid == 0 {
        SettingsDataReleaseWebImport(path)
        settings_screen_set_status_error(LocaleText("import_invalid_file"))
        return
    }
    if (info.has_sessions != 0 || info.has_habits != 0) &&
    info.has_settings != 0 {
        if !AppCopyText(path, pending_import_path[:]) {
            SettingsDataReleaseWebImport(path)
            settings_screen_set_status_error(LocaleText("import_invalid_file"))
            return
        }
        pending_import_info = info
        app_open_modal(app, cast(ModalType)ModalConfirmImportDataSettings)
        settings_screen_clear_status()
        return
    }
    unused SettingsDataPerformImport(app, path,
        cast(StorageImportMode)STORAGE_IMPORT_DATA_ONLY)
    SettingsDataReleaseWebImport(path)
}

SettingsDataImportKeyPath :: (app: *InnerBreeze, path: string) -> s32 {
    account: SyncAccount
    path_bytes: [4096]u8
    if path.count == 0 || !AppCopyText(path, path_bytes[:]) ||
    sync_account_import_private_key_preview(*account, *path_bytes[0]) == 0 {
        SettingsDataReleaseWebImport(path)
        settings_screen_set_status_error(LocaleText("sync_private_key_import_failed"))
        return 0
    }
    saved := settings_sync_account_save_prepared(app, *account,
        cast(PendingSyncAccountAction)PendingSyncAccountImport,
        cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK)
    SettingsDataReleaseWebImport(path)
    if saved == 0 && app.modal.type != cast(ModalType)ModalConfirmSyncAccountSwitch {
        settings_screen_set_status_error(LocaleText("sync_private_key_import_failed"))
        return 0
    }
    return 1
}

SettingsDataSaveKey :: (app: *InnerBreeze, filename: string) -> s32 {
    account: SyncAccount
    path: [4096]u8
    if sync_account_load(*account) == 0 {
        return 3
    }
    if AndroidPlatform() != 0 {
        if !SettingsDataExportPath(filename, path[:]) {
            return 3
        }
    } else {
        choice := SettingsDataPick(LocaleText("sync_save_key_dialog_title"),
            "Key files | *.key", filename, true, path[:])
        if choice == 0 {
            return 4
        }
        if choice < 0 {
            return 3
        }
    }
    if sync_account_export_private_key(*account, *path[0]) == 0 {
        SettingsDataReleaseExportPath(AppTextFromCString(*path[0], 4096))
        return 3
    }
    if !SettingsDataDeliverExport(
        AppTextFromCString(*path[0], 4096), filename,
        "application/octet-stream") {
        SettingsDataReleaseExportPath(AppTextFromCString(*path[0], 4096))
        return 3
    }
    settings_screen_set_status_success(
        LocaleText("sync_private_key_backup_saved"), "")
    unused app
    return 2
}

SettingsDataImportKey :: (app: *InnerBreeze) -> s32 {
    if AndroidPlatform() != 0 {
        return ifx SettingsDataBeginAndroidImport(
            cast(s32)ANDROID_IMPORT_KIND_SYNC_KEY) then 1 else 0
    }
    path: [4096]u8
    choice := SettingsDataPick(LocaleText("sync_import_key_dialog_title"),
        "Key files | *.key", "", false, path[:])
    if choice == 0 {
        settings_screen_set_status_error(
            LocaleText("sync_private_key_import_cancelled"))
        return 1
    }
    if choice < 0 {
        return 0
    }
    return SettingsDataImportKeyPath(app,
        AppTextFromCString(*path[0], 4096))
}

#program_export
settings_data_register_sync_key_dialogs :: () {
    settings_sync_account_set_save_dialog(SettingsDataSaveKey)
    settings_sync_account_set_import_dialog(SettingsDataImportKey)
}

#program_export
settings_data_open_sync_account_config :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    settings_data_register_sync_key_dialogs()
    saved := storage_get_setting_text("sync_server_url")
    if saved.count == 0 {
        saved = "https://api.waozi.xyz"
    }
    unused AppCopyText(saved, app.sync_server_url[:])
    app.sync_server_url_cursor = cast(s32)saved.count
    app_open_profile_tab(app, PROFILE_TAB_SYNC)
}

SettingsDataImport :: (app: *InnerBreeze) {
    if AndroidPlatform() != 0 {
        if !SettingsDataBeginAndroidImport(
            cast(s32)ANDROID_IMPORT_KIND_DATA) {
            settings_screen_set_status_error(LocaleText("import_failed"))
        }
        return
    }
    path: [4096]u8
    choice := SettingsDataPick(LocaleText("import_data_dialog_title"),
        "Inbe data | *.zip *.db *.1list", "", false, path[:])
    if choice == 0 {
        settings_screen_set_status_error(LocaleText("import_cancelled"))
    } else if choice < 0 {
        settings_screen_set_status_error(LocaleText("import_failed"))
    } else {
        SettingsDataInspectImport(app, AppTextFromCString(*path[0], 4096))
    }
}

SettingsDataExport :: (app: *InnerBreeze) {
    if data_has_any() == 0 {
        settings_screen_set_status_error(LocaleText("no_data_to_export"))
        return
    }
    filename: [64]u8
    path: [4096]u8
    data_default_export_filename(*filename[0], 64)
    name := AppTextFromCString(*filename[0], 64)
    if AndroidPlatform() != 0 {
        if !SettingsDataExportPath(name, path[:]) {
            settings_screen_set_status_error(LocaleText("export_failed"))
            return
        }
    } else {
        choice := SettingsDataPick(LocaleText("export_data_dialog_title"),
            "Zip archives | *.zip", name, true, path[:])
        if choice == 0 {
            settings_screen_set_status_error(LocaleText("export_cancelled"))
            return
        }
        if choice < 0 {
            settings_screen_set_status_error(LocaleText("export_failed"))
            return
        }
    }
    path_text := AppTextFromCString(*path[0], 4096)
    if data_export(path_text) == 0 ||
    !SettingsDataDeliverExport(path_text, name, "application/zip") {
        SettingsDataReleaseExportPath(path_text)
        settings_screen_set_status_error(LocaleText("export_failed"))
    } else {
        settings_screen_set_status_success(LocaleText("exported_label"), "")
    }
    unused app
}

SettingsDataExportCsv :: (app: *InnerBreeze) {
    path: [4096]u8
    if AndroidPlatform() != 0 {
        if !SettingsDataExportPath("sessions.csv", path[:]) {
            settings_screen_set_status_error(LocaleText("export_failed"))
            return
        }
    } else {
        choice := SettingsDataPick(LocaleText("export_csv_dialog_title"),
            "CSV files | *.csv", "sessions.csv", true, path[:])
        if choice == 0 {
            settings_screen_set_status_error(LocaleText("export_cancelled"))
            return
        }
        if choice < 0 {
            settings_screen_set_status_error(LocaleText("export_failed"))
            return
        }
    }
    path_text := AppTextFromCString(*path[0], 4096)
    if storage_export_sessions_csv(path_text) == 0 ||
    !SettingsDataDeliverExport(path_text, "sessions.csv", "text/csv") {
        SettingsDataReleaseExportPath(path_text)
        settings_screen_set_status_error(LocaleText("export_failed"))
    } else {
        settings_screen_set_status_success(LocaleText("exported_label"), "")
    }
    unused app
}

#program_export
settings_data_content_height :: (content_w: s32) -> s32 {
    unused content_w
    return AppScale(326)
}

#program_export
settings_data_draw_actions :: (app: *InnerBreeze,
    x: s32, width: s32, y: *s32) {
    if app == null || y == null {
        return
    }
    settings_data_register_sync_key_dialogs()
    y.* += AppScale(8)
    import_button := SettingsDataButtonProps(LocaleText("import_data_button"),
        x, y.*, width, 5301, true)
    if Button(app.ui.session, import_button) != 0 {
        SettingsDataImport(app)
    }
    y.* += AppScale(50)
    export_button := SettingsDataButtonProps(LocaleText("export_data_button"),
        x, y.*, width, 5302, true)
    if Button(app.ui.session, export_button) != 0 {
        SettingsDataExport(app)
    }
    y.* += AppScale(50)
    csv_button := SettingsDataButtonProps(LocaleText("export_csv_button"),
        x, y.*, width, 5303, false)
    if Button(app.ui.session, csv_button) != 0 {
        SettingsDataExportCsv(app)
    }
    y.* += AppScale(50)
    account: SyncAccount
    if sync_account_load(*account) == 0 {
        clear_button := SettingsDataButtonProps(
            LocaleText("clear_local_data_button"),
            x, y.*, width, 5304, false)
        if Button(app.ui.session, clear_button) != 0 {
            if data_has_any() != 0 {
                app_open_modal(app, cast(ModalType)ModalConfirmDeleteData)
            } else {
                settings_screen_set_status_error(LocaleText("no_data_to_delete"))
            }
        }
        y.* += AppScale(50)
    }
    settings_screen_draw_status_reserved(x, y, AppScale(42))
}

#program_export
settings_data_draw_sync_status :: (x: s32, width: s32, y: *s32) {
    app := CurrentApp()
    if app == null || y == null {
        return
    }
    status: StorageSyncStatus
    if storage_sync_status(*status) == 0 || status.has_account == 0 {
        return
    }
    Text(app.ui.session, SettingsDataTextProps(
        LocaleText("sync_status_title"),
        x, y.*, width, AppScale(26)))
    y.* += AppScale(28)
    queued: [64]u8
    unused FormatNumberTemplate(LocaleText("sync_status_queued"),
        cast(s32)status.queued_changes, queued[:])
    Text(app.ui.session, SettingsDataTextProps(
        FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*queued[0], 64)),
        x, y.*, width, AppScale(24)))
    y.* += AppScale(28)
    Text(app.ui.session, SettingsDataTextProps(
        LocaleText(app_sync_status_key()),
        x, y.*, width, AppScale(48)))
    y.* += AppScale(52)
}

settings_data_handle_import :: (app: *InnerBreeze) {
    if app == null || AndroidPlatform() == 0 ||
    pending_android_import_kind < 0 {
        return
    }
    path: [4096]u8
    kind := pending_android_import_kind
    result := android_import_poll_result_for(kind, *path[0], 4096)
    if result == cast(s32)ANDROID_IMPORT_RESULT_NONE {
        return
    }
    pending_android_import_kind = -1
    if result == cast(s32)ANDROID_IMPORT_RESULT_CANCELLED {
        key := "import_cancelled"
        if kind == cast(s32)ANDROID_IMPORT_KIND_SYNC_KEY {
            key = "sync_private_key_import_cancelled"
        }
        settings_screen_set_status_error(LocaleText(key))
        return
    }
    selected := AppTextFromCString(*path[0], 4096)
    if kind == cast(s32)ANDROID_IMPORT_KIND_SYNC_KEY {
        unused SettingsDataImportKeyPath(app, selected)
    } else {
        SettingsDataInspectImport(app, selected)
    }
}

SettingsDataPrompt :: (app: *InnerBreeze, key: string,
    title: string, message: string, labels: []string) -> s32 {
    actions: [3]ActionModalAction
    index: s32 = 0
    while index < cast(s32)labels.count && index < 3 {
        actions[index].label = labels[index]
        actions[index].tone = cast(ButtonTone)(ifx (index == 0) then
            (ButtonToneNeutral) else (ButtonToneAccent))
        actions[index].emphasis = cast(ButtonEmphasis)(ifx (index == 0) then
            (ButtonEmphasisSoft) else (ButtonEmphasisFilled))
        index += 1
    }
    props: ActionModalProps
    props.key = KeyHash(key)
    props.title = title
    props.message = message
    props.max_width = AppScale(440)
    result := ActionModal(app.ui.session, props, actions[0:labels.count])
    return result.action
}

review_choice: s32 = 2;
review_scroll: s32;
review_cached_choice: s32 = -1;
review_cached_revision: s64 = -1;
review_cached_text: *u8;
review_cached_available: bool;

SettingsReviewReset :: () {
    free(cast(*void)review_cached_text)
    review_cached_text = null
    review_cached_choice = -1
    review_cached_revision = -1
    review_choice = 2
    review_scroll = 0
}

SettingsReviewLines :: (app: *InnerBreeze, value: string,
    bounds: Rectangle, offset: s32, font: s32, line_height: s32) {
    start: s32 = 0
    y := cast(s32)bounds.y - offset
    while start < cast(s32)value.count {
        line := NextTextLine(value, start, bounds.width - cast(float32)AppScale(12),
            cast(TextWrap)TextWrapAuto, font, "ui")
        if y + line_height >= cast(s32)bounds.y &&
        y < cast(s32)(bounds.y + bounds.height) {
            props := SettingsDataTextProps(value[line.start:line.end],
                cast(s32)bounds.x, y, cast(s32)bounds.width - AppScale(12), line_height)
            props.font = font
            props.wrap = cast(TextWrap)TextWrapNone
            Text(app.ui.session, props)
        }
        y += line_height
        if line.next <= start {
            break
        }
        start = line.next
    }
}

SettingsDataReviewModal :: (app: *InnerBreeze) -> s32 {
    if review_cached_revision != storage_data_revision() &&
    storage_sync_review_clear_if_no_visible_diff() != 0 {
        SettingsReviewReset()
        app_close_modal(app)
        app_reload_after_import(app, 0)
        return 0
    }
    width := app.ui.view_width - AppScale(32)
    if width > AppScale(680) {
        width = AppScale(680)
    }
    height := app.ui.view_height - AppScale(32)
    if height > AppScale(720) {
        height = AppScale(720)
    }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("inbe/data/sync-review"),
            .title = LocaleText("sync_review_title"),
            .width = width, .height = height,
            .has_right_action = true, .right_label = LocaleText("cancel_button")})
    if frame.dismissed || frame.right_clicked {
        SettingsReviewReset()
        app_close_modal(app)
        return 0
    }
    if !frame.opened {
        return 0
    }
    content := frame.layout.content
    x := cast(s32)content.x
    y := cast(s32)content.y
    text_width := cast(s32)content.width
    options: [3]string = .["review_merge", "sync_review_keep_local", "sync_review_use_remote"]
    modes: [3]s32 = .[2, 0, 1]
    index: s32 = 0
    while index < 3 {
        button := SettingsDataButtonProps(LocaleText(options[index]),
            x, y, text_width, 5351 + index, review_choice == modes[index])
        if Button(app.ui.session, button) != 0 && review_choice != modes[index] {
            review_choice = modes[index]
            review_scroll = 0
        }
        y += AppScale(44)
        index += 1
    }
    revision := storage_data_revision()
    if review_cached_choice != review_choice || review_cached_revision != revision {
        free(cast(*void)review_cached_text)
        review_cached_text = null
        review_cached_available = storage_sync_review_plan(review_choice, *review_cached_text) != 0
        review_cached_choice = review_choice
        review_cached_revision = storage_data_revision()
    }
    explanation_key := "review_merge_detail"
    if review_choice == 0 {
        explanation_key = "review_keep_detail"
    }
    if review_choice == 1 {
        explanation_key = "review_replace_detail"
    }
    // The cache owns the full preview; render only visible wrapped lines so
    // large reviews never hit a fixed frame-text or tree-label capacity.
    value := LocaleText("review_unavailable")
    if review_cached_available {
        value = AppTextFromCString(review_cached_text, 2147483647)
    }
    explanation := LocaleText(explanation_key)
    font := AppScale(14)
    line_height := AppTextLineHeight(font)
    direction := LocaleText("review_before_after")
    direction_height := AppParagraphHeight(direction, text_width, font, 0)
    direction_props: TextProps = SettingsDataTextProps(direction,
        x, y, text_width, direction_height)
    direction_props.font = font
    direction_props.wrap = cast(TextWrap)TextWrapAuto
    Text(app.ui.session, direction_props)
    y += direction_height + AppScale(8)
    view := SettingsDataRect(x, y, text_width,
        cast(s32)(content.y + content.height) - y - AppScale(50))
    explanation_height := AppParagraphHeight(explanation,
        text_width - AppScale(12), font, 0) + line_height
    props: ScrollProps
    props.key = KeyHash("inbe/data/sync-review/details")
    props.bounds = view
    props.content_height = explanation_height +
    AppParagraphHeight(value, text_width - AppScale(12), font, 0)
    props.scroll_offset = review_scroll
    scrolled := Scroll(app.ui.session, props)
    review_scroll = scrolled.scroll_offset
    if scrolled.opened {
        SettingsReviewLines(app, explanation, view, review_scroll, font, line_height)
        SettingsReviewLines(app, value, view, review_scroll - explanation_height, font, line_height)
        unused End(app.ui.session)
    }
    apply := SettingsDataButtonProps(LocaleText("review_apply"),
        x, cast(s32)(content.y + content.height) - AppScale(40), text_width, 5354, true)
    apply.disabled = !review_cached_available
    decision: s32 = 0
    if Button(app.ui.session, apply) != 0 {
        decision = review_choice + 1
    }
    unused End(app.ui.session)
    return decision
}

#program_export
settings_data_draw_modals :: (app: *InnerBreeze) -> s32 {
    if app == null || app.modal.active == 0 {
        SettingsReviewReset()
        return 0
    }
    modal := app.modal.type
    if modal == cast(ModalType)ModalConfirmImportDataSettings {
        labels: [3]string = .{
            LocaleText("cancel_button"),
            LocaleText("import_data_only_button"),
            LocaleText("import_data_settings_button")}
        choice := SettingsDataPrompt(app, "inbe/data/import-choice",
            LocaleText("import_choice_title"),
            LocaleText("import_choice_message"), labels[:])
        if choice > 0 {
            path := AppTextFromCString(*pending_import_path[0], 4096)
            app_close_modal(app)
            if choice == 1 {
                settings_screen_set_status_error(LocaleText("import_cancelled"))
            } else {
                mode := cast(StorageImportMode)STORAGE_IMPORT_DATA_ONLY
                if choice == 3 {
                    mode = cast(StorageImportMode)STORAGE_IMPORT_DATA_AND_SETTINGS
                }
                unused SettingsDataPerformImport(app, path, mode)
            }
            SettingsDataReleaseWebImport(path)
            pending_import_path[0] = cast(u8)0
            pending_import_info = DataImportInfo.{}
        }
        return 1
    }
    if modal == cast(ModalType)ModalConfirmDeleteData {
        labels: [2]string = .{LocaleText("cancel_button"),
            LocaleText("clear_button")}
        choice := SettingsDataPrompt(app, "inbe/data/delete-local",
            LocaleText("clear_local_data_title"),
            LocaleText("clear_local_data_message"), labels[:])
        if choice > 0 {
            app_close_modal(app)
            if choice == 2 {
                deleted := data_delete_all()
                habits_free(*app.habits)
                app.habits = Habits.{}
                app.habits.loaded = 1
                if deleted > 0 {
                    deleted_text: [128]u8
                    unused FormatNumberTemplate(LocaleText("deleted_sessions"),
                        cast(s32)deleted, deleted_text[:])
                    settings_screen_set_status_success(
                        AppTextFromCString(*deleted_text[0], 128), "")
                } else {
                    settings_screen_set_status_success(
                        LocaleText("no_data_to_delete"), "")
                }
            } else {
                settings_screen_set_status_error(LocaleText("delete_cancelled"))
            }
        }
        return 1
    }
    if modal == cast(ModalType)ModalConfirmDeleteSyncAccount {
        labels: [2]string = .{LocaleText("cancel_button"),
            LocaleText("clear_button")}
        choice := SettingsDataPrompt(app, "inbe/data/delete-remote",
            LocaleText("sync_clear_remote_data_title"),
            LocaleText("sync_clear_remote_data_message"), labels[:])
        if choice > 0 {
            app_close_modal(app)
            if choice == 2 {
                settings_sync_account_clear_remote_confirmed(app)
            } else {
                settings_screen_set_status_error(
                    LocaleText("sync_clear_remote_data_cancelled"))
            }
        }
        return 1
    }
    if modal == cast(ModalType)ModalConfirmSyncAccountSwitch {
        labels: [3]string = .{LocaleText("cancel_button"),
            LocaleText("sync_account_switch_merge_button"),
            LocaleText("sync_account_switch_clear_button")}
        choice := SettingsDataPrompt(app, "inbe/data/account-switch",
            LocaleText("sync_account_switch_title"),
            LocaleText("sync_account_switch_message"), labels[:])
        if choice > 0 {
            account: SyncAccount = app.pending_sync_account
            action := cast(PendingSyncAccountAction)app.pending_sync_account_action
            app_close_modal(app)
            if choice == 1 {
                app.pending_sync_account = SyncAccount.{}
                app.pending_sync_account_action = cast(s32)PendingSyncAccountNone
                settings_screen_set_status_error(
                    LocaleText("sync_account_switch_cancelled"))
            } else {
                local_choice := cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_MERGE
                if choice == 3 {
                    local_choice = cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_REPLACE
                }
                if settings_sync_account_save_prepared(app, *account,
                    action, local_choice) == 0 {
                    settings_screen_set_status_error(
                        LocaleText("sync_account_switch_failed"))
                } else if action != cast(PendingSyncAccountAction)PendingSyncAccountImport {
                    app_reload_after_import(app, 0)
                }
            }
        }
        return 1
    }
    if modal == cast(ModalType)ModalSyncAccountBackup {
        result := settings_sync_account_draw_backup_modal(app)
        if result != 0 {
            app_close_modal(app)
            if result == 3 {
                settings_screen_set_status_error(
                    LocaleText("sync_private_key_backup_failed"))
            }
        }
        return 1
    }
    if modal == cast(ModalType)ModalSyncReview {
        choice := SettingsDataReviewModal(app)
        if choice > 0 {
            if storage_apply_pending_sync_review(
                choice - 1) != 0 {
                app_close_modal(app)
                if choice != 1 {
                    app_reload_after_import(app, 0)
                }
                key := "sync_review_keeping_local"
                if choice == 2 {
                    key = "sync_review_using_remote"
                }
                if choice == 3 { key = "review_merged" }
                SettingsReviewReset()
                settings_screen_set_status_success(LocaleText(key), "")
            } else {
                settings_screen_set_status_error(LocaleText("sync_review_failed"))
            }
        }
        return 1
    }
    return 0
}
