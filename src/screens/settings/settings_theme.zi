#import "settings_theme_ui"
#import, file "../../app/modal_rules.zi";
#import, file "../../app/app_types.zi";
#import, file "settings_types.zi";
Dropdown :: #import "kryon/dropdown";

#import, file "../../app/app_modal_state.zi";
#import, file "../../app/theme_catalog.zi";
#import, file "../../app/locale.zi";

#import, file "settings_ui.zi";
#import, file "settings_appearance.zi";
#import, file "../../app/metrics.zi";

using ModalType;
ANDROID :: #defined(ANDROID_BUILD)
#if ANDROID {
    c :: #system_library "c";
    android_device_app_icon :: () -> s32 #foreign c;
    android_device_set_app_icon :: (icon: s32) -> s32 #foreign c;
}

settings_theme_scale_label_height :: (width: s32) -> s32 {
    height := AppParagraphHeight(LocaleText("appearance_scale_label"),
        width, AppFontSize(), 0)
    if height < AppScale(22) { height = AppScale(22) }
    return height
}

settings_theme_scale_stacked :: (width: s32) -> bool {
    return AppTextWidth(LocaleText("appearance_scale_label"), AppFontSize()) +
    AppScale(80) > width
}

settings_theme_scale_row_height :: (width: s32) -> s32 {
    height := AppScale(86)
    if settings_theme_scale_stacked(width) {
        height += settings_theme_scale_label_height(width) + AppScale(6)
    }
    return height
}

settings_theme_icon_row_height :: () -> s32 {
    return AppScale(72)
}

settings_theme_theme_body :: (width: s32) -> s32 {
    height: s32 = 0
    #if ANDROID {
        height += settings_theme_icon_row_height()
    }
    height += settings_choice_row_height(LocaleText("theme_color_label"), width)
    height += settings_choice_row_height(LocaleText("theme_mode_label"), width)
    return height
}

settings_theme_layout_body :: (app: *InnerBreeze, width: s32) -> s32 {
    height := settings_theme_scale_row_height(width)
    height += settings_choice_row_height(LocaleText("navigation_placement"),
        width)
    return height
}

settings_theme_content_height :: (app: *InnerBreeze, content_w: s32) -> s32 {
    inner := settings_section_inner_width(content_w)
    return settings_section_height(LocaleText("theme_label"),
        settings_theme_theme_body(inner)) +
    settings_section_height(LocaleText("settings_section_layout"),
        settings_theme_layout_body(app, inner)) + settings_appearance_height(inner)
}

SettingsAppIconAvailable :: () -> bool {
    #if ANDROID {
        return true
    } else {
        return false
    }
}

SettingsAppIconLoad :: (state: *SettingsThemeState) {
    #if ANDROID {
        if state.app_icon_loaded == 0 {
            state.app_icon = android_device_app_icon()
            state.app_icon_loaded = 1
        }
    } else {
        unused state
    }
}

SettingsAppIconOpen :: (app: *InnerBreeze, state: *SettingsThemeState) {
    #if ANDROID {
        state.app_icon = android_device_app_icon()
        state.app_icon_error = 0
        app_open_modal(app, cast(ModalType)ModalAppIconPicker)
    } else {
        unused app
        unused state
    }
}

SettingsAppIconSelect :: (app: *InnerBreeze, state: *SettingsThemeState, icon: s32) -> bool {
    #if ANDROID {
        state.app_icon_error = ifx android_device_set_app_icon(icon) == 0 then 1 else 0
        state.app_icon = android_device_app_icon()
        app_block_current_click(app)
        return state.app_icon_error == 0
    } else {
        unused app
        unused state
        unused icon
        return false
    }
}

#program_export
settings_screen_draw_app_icon_modal :: (app: *InnerBreeze) {
    #if ANDROID {
        SettingsAppIconModal(app)
    } else {
        unused app
    }
}

ThemeLabel :: (id: s32) -> string {
    if id == 0 { return LocaleText("theme_sky") }
    if id == 1 { return LocaleText("theme_ocean") }
    if id == 2 { return LocaleText("theme_forest") }
    if id == 3 { return LocaleText("theme_sunset") }
    if id == 4 { return LocaleText("theme_lavender") }
    if id == 5 { return LocaleText("theme_cherry") }
    if id == 6 { return LocaleText("theme_dawn") }
    if id == 7 { return LocaleText("theme_sage") }
    if id == 8 { return LocaleText("theme_sepia") }
    if id == 9 { return LocaleText("theme_mono") }
    if id == 10 { return LocaleText("theme_mint") }
    if id == 11 { return LocaleText("theme_cobalt") }
    if id == 12 { return "Sweet" }
    return LocaleText("theme_mono")
}

#program_export
settings_screen_draw_theme_picker_modal :: (app: *InnerBreeze) {
    SettingsThemePickerModal(app)
}

theme_picker_content_height :: (w: s32) -> s32 {
    unused w
    return ThemeCount * AppScale(46)
}

NewPlacements :: () -> [5]Dropdown.Option {
    result: [5]Dropdown.Option
    return result
}

NewThemeOptions :: () -> [ThemeCount+1]Dropdown.Option {
    result: [ThemeCount+1]Dropdown.Option
    return result
}

NewFollowDeviceLabel :: () -> [128]u8 {
    result: [128]u8
    return result
}

NewModeOptions :: () -> [3]Dropdown.Option {
    result: [3]Dropdown.Option
    return result
}

NewPercentage :: () -> [24]u8 {
    result: [24]u8
    return result
}
