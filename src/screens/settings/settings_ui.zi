}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
settings_choice_row :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, label: string) -> Rectangle {
    return settings_choice_rowView(app, x, width, y, label)
}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
commit_slider_row :: (app: *InnerBreeze, id: s32, x: s32,
    width: s32, y: *s32, row_height: s32, label: string,
    minimum: s32, maximum: s32, value: *s32, suffix: string,
    save_now: s32) -> s32 {
    return commit_slider_rowView(app, id, x, width, y, row_height, label, minimum, maximum, value, suffix, save_now)
}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
draw_audio_meter :: (app: *InnerBreeze, level: float32,
    x: s32, y: s32, width: s32, label: string) -> s32 {
    return draw_audio_meterView(app, level, x, y, width, label)
}
