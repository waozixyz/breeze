using TextAlign;
using TextWrap;
using SemanticKind;

// Settings pages group related rows into titled sections. A section is a
// heading above a framed card; rows inside the card share one inset, one
// height rule, and a divider between neighbours.

#program_export
settings_section_inset :: () -> s32 {
    return AppScale(16)
}

settings_section_title_height :: () -> s32 {
    return AppScale(30)
}

settings_section_padding :: () -> s32 {
    return AppScale(4)
}

settings_section_gap :: () -> s32 {
    return AppScale(20)
}

SettingsSection :: struct {
    inner_x: s32
    inner_width: s32
}

// Total height of a section whose rows take body_height.
#program_export
settings_section_height :: (title: string, body_height: s32) -> s32 {
    height := body_height + settings_section_padding() * 2 +
        settings_section_gap()
    if title != "" {
        height += settings_section_title_height()
    }
    return height
}

settings_section_inner_width :: (width: s32) -> s32 {
    return width - settings_section_inset() * 2
}

#program_export
settings_section_begin :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, title: string, body_height: s32) -> SettingsSection {
    section: SettingsSection
    section.inner_x = x + settings_section_inset()
    section.inner_width = settings_section_inner_width(width)
    if title != "" {
        heading: TextProps
        heading.text = title
        heading.font = AppSmallFontSize()
        heading.wrap = cast(TextWrap)TextWrapNone
        heading.semantic_kind = cast(SemanticKind)SemanticHeading
        heading.heading_level = 2
        heading.bounds = Rectangle.{cast(float32)(x + AppScale(4)),
            cast(float32)y.*, cast(float32)(width - AppScale(4)),
            cast(float32)AppScale(22)}
        Text(app.ui.session, heading)
        y.* += settings_section_title_height()
    }
    frame: FieldsetProps
    frame.bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
        cast(float32)width,
        cast(float32)(body_height + settings_section_padding() * 2)}
    Fieldset(app.ui.session, frame)
    y.* += settings_section_padding()
    return section
}

#program_export
settings_section_end :: (y: *s32) {
    y.* += settings_section_padding() + settings_section_gap()
}

// A hairline between two rows of the same section.
#program_export
settings_row_divider :: (app: *InnerBreeze, section: SettingsSection,
    y: s32) {
    line: SeparatorProps
    line.bounds = Rectangle.{cast(float32)section.inner_x, cast(float32)y,
        cast(float32)section.inner_width, 1.0}
    Separator(app.ui.session, line)
}

settings_choice_control_width :: (width: s32) -> s32 {
    control := width * 45 / 100
    if control > AppScale(300) {
        control = AppScale(300)
    }
    if control < AppScale(180) {
        control = AppScale(180)
    }
    return control
}

// A choice row puts its label beside the control when both fit, and the
// label above a full-width control otherwise.
settings_choice_row_stacked :: (label: string, width: s32) -> bool {
    label_width := width - settings_choice_control_width(width) - AppScale(16)
    return label_width < AppScale(140) ||
        AppTextWidth(label, AppFontSize()) > label_width
}

#program_export
settings_choice_row_height :: (label: string, width: s32) -> s32 {
    if settings_choice_row_stacked(label, width) {
        return AppScale(10) + AppScale(22) + AppScale(6) +
            AppScale(36) + AppScale(12)
    }
    return AppScale(56)
}

// Draws the row label and returns where the caller places its control.
#program_export
settings_choice_row :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, label: string) -> Rectangle {
    control_height := AppScale(36)
    text: TextProps
    text.text = label
    text.font = AppFontSize()
    text.wrap = cast(TextWrap)TextWrapNone
    control: Rectangle
    if settings_choice_row_stacked(label, width) {
        text.bounds = Rectangle.{cast(float32)x,
            cast(float32)(y.* + AppScale(10)), cast(float32)width,
            cast(float32)AppScale(22)}
        control = Rectangle.{cast(float32)x,
            cast(float32)(y.* + AppScale(38)), cast(float32)width,
            cast(float32)control_height}
    } else {
        row_height := settings_choice_row_height(label, width)
        control_width := settings_choice_control_width(width)
        text.bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
            cast(float32)(width - control_width - AppScale(16)),
            cast(float32)row_height}
        text.vertical_align = cast(TextAlign)TextAlignCenter
        control = Rectangle.{cast(float32)(x + width - control_width),
            cast(float32)(y.* + (row_height - control_height) / 2),
            cast(float32)control_width, cast(float32)control_height}
    }
    Text(app.ui.session, text)
    y.* += settings_choice_row_height(label, width)
    return control
}

#program_export
toggle_switch_width :: () -> s32 {
    return AppScale(50)
}

toggle_switch_height :: () -> s32 {
    return AppScale(28)
}

#program_export
toggle_row_height :: (label: string, width: s32) -> s32 {
    if width <= 0 {
        width = AppScale(160)
    }
    toggle_width := toggle_switch_width()
    toggle_height := toggle_switch_height()
    gap := AppScale(18)
    label_width := width - toggle_width - gap
    if label_width < AppScale(120) {
        label_width = width
    }
    label_height := AppParagraphHeight(label, label_width, 0, 0)
    if label_width < width {
        row_height := label_height
        if row_height < toggle_height {
            row_height = toggle_height
        }
        row_height += AppScale(16)
        if row_height < AppScale(52) {
            row_height = AppScale(52)
        }
        return row_height
    }
    row_height := label_height + AppScale(8) + toggle_height + AppScale(18)
    if row_height < AppScale(70) {
        row_height = AppScale(70)
    }
    return row_height
}

draw_toggle_row :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, label: string, value: *s32) -> bool {
    if app == null || y == null || value == null  || !SessionValid(app.ui.session) {
        return false
    }
    row_height := toggle_row_height(label, width)
    toggle_width := toggle_switch_width()
    toggle_height := toggle_switch_height()
    gap := AppScale(18)
    label_width := width - toggle_width - gap
    if label_width < AppScale(120) {
        label_width = width
    }
    label_height := AppParagraphHeight(label, label_width, 0, 0)
    toggle_x := x
    toggle_y := y.* + (row_height - toggle_height) / 2
    label_y: s32
    if label_width < width {
        label_y = y.* + (row_height - label_height) / 2
        toggle_x = x + width - toggle_width
    } else {
        label_y = y.* + AppScale(8)
        toggle_y = label_y + label_height + AppScale(8)
    }

    text: TextProps
    text.text = label
    text.font = AppFontSize()
    text.wrap = cast(TextWrap)TextWrapAuto
    text.bounds = Rectangle.{cast(float32)x, cast(float32)label_y,
        cast(float32)label_width, cast(float32)label_height
}
    Text(app.ui.session, text)

    props: ToggleProps
    props.id = cast(s32)62000 + y.*
    props.bounds = Rectangle.{cast(float32)toggle_x,
        cast(float32)toggle_y, cast(float32)toggle_width,
        cast(float32)toggle_height
}
    props.value = value.* != 0
    props.label = label
    result := Toggle(app.ui.session, props)
    y.* += row_height
    if result.changed {
        value.* = ifx result.value then 1 else 0
    }
    return result.changed
}

#program_export
commit_toggle_row :: (app: *InnerBreeze, x: s32, width: s32,
    y: *s32, label: string, value: *s32, save_now: s32) -> s32 {
    if !draw_toggle_row(app, x, width, y, label, value) {
        return 0
    }
    app.settings_dirty = 1
    if save_now != 0 {
        save_settings(app)
    }
    return 1
}

#program_export
commit_slider_row :: (app: *InnerBreeze, id: s32, x: s32,
    width: s32, y: *s32, row_height: s32, label: string,
    minimum: s32, maximum: s32, value: *s32, suffix: string,
    save_now: s32) -> s32 {
    if app == null || y == null || value == null  || !SessionValid(app.ui.session) {
        return 0
    }
    template: string = "%d"
    if suffix == "s" {
        template = "%ds"
    }
    if suffix == "x" {
        template = "%dx"
    }
    number_buffer: [32]u8
    unused FormatNumberTemplate(template, value.*, number_buffer[:])
    number := FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*number_buffer[0], 32))

    label_props: TextProps
    label_props.text = label
    label_props.font = AppSmallFontSize()
    label_props.wrap = cast(TextWrap)TextWrapNone
    label_props.bounds = Rectangle.{cast(float32)x, cast(float32)y.*,
        cast(float32)(width - AppScale(64)), cast(float32)AppScale(20)
}
    Text(app.ui.session, label_props)
    number_props: TextProps
    number_props.text = number
    number_props.font = AppSmallFontSize()
    number_props.wrap = cast(TextWrap)TextWrapNone
    number_props.align = cast(TextAlign)TextAlignEnd
    number_props.bounds = Rectangle.{cast(float32)(x + width - AppScale(64)),
        cast(float32)y.*, cast(float32)AppScale(64),
        cast(float32)AppScale(20)
}
    Text(app.ui.session, number_props)

    slider: DiscreteSliderProps
    slider.id = id
    slider.bounds = Rectangle.{cast(float32)x,
        cast(float32)(y.* + AppScale(20)), cast(float32)width,
        cast(float32)AppScale(36)
}
    slider.semantic_label = label
    slider.value = value.*
    slider.min = minimum
    slider.max = maximum
    result := DiscreteSlider(app.ui.session, slider)
    y.* += row_height
    if !result.changed {
        return 0
    }
    value.* = result.value
    app.settings_dirty = 1
    if save_now != 0 {
        save_settings(app)
    }
    return 1
}

#program_export
audio_meter_height :: () -> s32 {
    return AppScale(18) + AppScale(10) + AppScale(8)
}

#program_export
draw_audio_meter :: (app: *InnerBreeze, level: float32,
    x: s32, y: s32, width: s32, label: string) -> s32 {
    if app == null || width <= 0 || !SessionValid(app.ui.session) {
        return audio_meter_height()
    }
    if level < 0.0 {
        level = 0.0
    }
    if level > 1.0 {
        level = 1.0
    }
    text: TextProps
    text.text = label
    text.font = AppSmallFontSize()
    text.wrap = cast(TextWrap)TextWrapNone
    text.bounds = Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)width, cast(float32)AppScale(18)
}
    Text(app.ui.session, text)
    progress: ProgressProps
    progress.bounds = Rectangle.{cast(float32)x,
        cast(float32)(y + AppScale(18)), cast(float32)width,
        cast(float32)AppScale(10)
}
    progress.min = 0
    progress.max = 1000
    progress.value = cast(s32)(level * 1000.0)
    Progress(app.ui.session, progress)
    return audio_meter_height()
}
