using HostValueKind;
using TextWrap;
using AndroidImportKind;

c :: #system_library "c";
GetTime :: () -> float64 #foreign c;
NodePressedKey :: () -> s32 #foreign c "GetKeyPressed";
app_request_social_refresh :: (app: *InnerBreeze) #foreign c;

node_screen_frame: AppUiFrame;
node_screen_frame_codec: WidgetAppUiFrameCodec;
node_screen_person_codec: WidgetAppPersonCodec;
node_screen_friend_id: [80]u8;
node_screen_friend_name: [80]u8;
node_screen_alias: [80]u8;
// The account's public ID, copied: settings reads share one buffer.
node_screen_account: [80]u8;

NodeScreenFriends :: (app: *InnerBreeze) -> string {
    if app.profile_friends_loaded == 0 {
        load_friends_cache(app)
    }
    return AppTextFromCString(*app.profile_friends_json[0], 8192)
}

NodeScreenFriendCount :: (app: *InnerBreeze) -> s32 {
    json := NodeScreenFriends(app)
    count := ArrayCount(json, FieldAt(json, 0, "friends"))
    return ifx count < 0 then 0 else count
}

NodeScreenFriend :: (app: *InnerBreeze, index: s32) -> AppPerson {
    json := NodeScreenFriends(app)
    friends := FieldAt(json, 0, "friends")
    if index < 0 || index >= ArrayCount(json, friends) {
        return AppPerson.{}
    }
    at := ElementAt(json, friends, index)
    id := NodeAppJsonText(json, at, "user_id_hash", node_screen_friend_id[:])
    alias := NodeAppJsonText(json, at, "alias", node_screen_alias[:])
    return AppPerson.{.id = id, .name = NodeAppPersonName(alias, id, node_screen_friend_name[:])}
}

NodeScreenUiCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if AppModule(TextFromCString(module)) && name == "ClipboardCopyHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        result.* = HostScalar("bool", ifx TextInputWriteClipboard(AppArgumentText(arguments[0])) then 1 else 0)
        return 1
    }
    if name == "ReadAppUiHost" && count == 0 {
        result.* = WidgetEncodeAppUiFrame(node_screen_frame, *node_screen_frame_codec)
        return 1
    }
    if name == "AppLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := NodeAppText(arguments[0])
        translated := NodeAppLocaleText(app.node_app_slot, AppTextFromCString(*app.language[0], 16), key)
        result.* = NodeAppString(ifx translated != "" then translated else LocaleText(key))
        return 1
    }
    if name == "AppFriendHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        person := NodeScreenFriend(app, cast(s32)arguments[0].integer)
        result.* = WidgetEncodeAppPerson(person, *node_screen_person_codec)
        return 1
    }
    return WidgetHostCall(context, module, function, arguments, count, result)
}

// The platform picker a granted app asked for (MediaPickHost): the
// desktop's file dialog, or Android's photo picker, whose answer arrives on
// a later frame. Each picked file is added to the library once.
node_screen_media_waiting: bool;

NodeScreenMediaAdd :: (path: string) {
    if path.count == 0 {
        NodeAppMediaPicked(MediaImport.{}, true)
        return
    }
    NodeAppMediaPicked(MediaImportFile(path), true)
}

NodeScreenMediaPicker :: (app: *InnerBreeze) {
    if node_screen_media_waiting {
        path: [4096]u8
        result := AndroidPickerPoll(cast(s32)ANDROID_IMPORT_KIND_MEDIA, path[:])
        if result == .AndroidPickerNone {
            return
        }
        node_screen_media_waiting = false
        app.file_dialog_active = 0
        if result == .AndroidPickerSelected {
            selected := AppTextFromCString(*path[0], cast(s32)path.count)
            NodeScreenMediaAdd(selected)
            // The picker's private copy; the library keeps its own file.
            if selected.count > 0 {
                unused RemoveFile(selected)
            }
        } else {
            NodeAppMediaPicked(MediaImport.{}, false)
        }
        return
    }
    if !node_media_pick_requested {
        return
    }
    node_media_pick_requested = false
    app.file_dialog_active = 1
    if AndroidPlatform() != 0 {
        node_screen_media_waiting = AndroidPickerOpen(cast(s32)ANDROID_IMPORT_KIND_MEDIA, "image/*")
        if !node_screen_media_waiting {
            app.file_dialog_active = 0
            NodeAppMediaPicked(MediaImport.{}, true)
        }
        return
    }
    path: [4096]u8
    selected := PickFile(FilePickerProps.{.title = LocaleText("photos_add"),
            .filter = "Images | *.png *.jpg *.jpeg *.webp *.gif"}, path[:])
    app.file_dialog_active = 0
    if selected == 1 {
        NodeScreenMediaAdd(AppTextFromCString(*path[0], cast(s32)path.count))
    } else {
        NodeAppMediaPicked(MediaImport.{}, selected < 0)
    }
}

// Opening the app reads friends and shared records again. An installed app
// that is not running starts now, or downloads again when it cannot.
#program_export
node_app_screen_enter :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    name := NodeAppName(app.node_app_slot)
    if name.count > 0 && !NodeAppRunning(app.node_app_slot) {
        unused NodeAppInstall(name)
    }
    if name.count > 0 && !NodeAppLocal(name) {
        index := NodeAppIndex(app.node_app_slot)
        if !PackagePending(index) {
            if PackageAutomaticEnabled() {
                PackageRequest(index)
            } else {
                PackageCheckForUpdate(index)
            }
        }
    }
    load_friends_cache(app)
    app_request_social_refresh(app)
    lists_refresh_at = 0.0
}

// Route changes ask this before showing an app: only one on this device
// opens, never one still downloading.
#program_export
node_app_screen_opens :: (slot: s32) -> bool {
    return NodeAppInstalled(slot)
}

// When an installed app cannot run, a line says so.
NodeScreenNotice :: (app: *InnerBreeze, key: string) {
    margin := AppScale(16)
    Text(app.ui.session, TextProps.{.text = LocaleText(key), .font = AppFontSize(),
            .wrap = cast(TextWrap)TextWrapAuto,
            .bounds = Rectangle.{cast(float32)margin, cast(float32)AppScale(24),
                cast(float32)(app.ui.view_width - margin * 2), cast(float32)AppScale(64)}})
}

#program_export
node_app_screen_draw :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    slot := app.node_app_slot
    name := NodeAppName(slot)
    if name.count == 0 {
        return
    }
    if !NodeAppRunning(slot) {
        if NodeAppInstalled(slot) && NodeAppOpen(slot) {
            NodeScreenNotice(app, "node_app_loading")
            return
        }
        // Only installed apps open, so this screen never says installing.
        NodeScreenNotice(app, "node_app_unavailable")
        return
    }
    node_screen_frame = AppUiFrame.{.session = app.ui.session, .width = app.ui.view_width,
        .height = app.ui.view_height, .bottom = app_content_bottom_reserved(app),
        .scale = MetricsScale(), .font = AppFontSize(), .now = GetTime(), .dark = app.dark_mode != 0}
    unused AppCopyText(storage_get_setting_text("sync_public_id"), node_screen_account[:])
    message := AppMessage.{.action = APP_FRAME, .screen = ScreenNodeApp, .name = name,
        .locale = AppTextFromCString(*app.language[0], 16),
        .account = TextUntilNul(node_screen_account[:]),
        .signed_in = ListsNetworkReady(), .friend_count = NodeScreenFriendCount(app),
        .shared_count = NodeAppSharedCount(name), .invitation_count = NodeAppInvitationCount(name),
        .shared_revision = ListsSharedRevision(), .shared_status = lists_status,
        .time = now_seconds()}
    typed: [1024]u8
    if NodeAppPortable(slot) || node_runners[slot].nested != null {
        input := SampleTextFieldInput(true, typed[:])
        key := NodePressedKey()
        // Native and IME commands are sampled with the field input. Keep
        // them even when the raw key queue has already been drained.
        if input.commit { key = TextInputKeyEnter }
        else if input.backspace { key = TextInputKeyBackspace }
        else if input.escape { key = TextInputKeyEscape }
        modifiers: s32 = 0
        if input.shift { modifiers |= 1 }
        if TextInputKeyDown(TextInputKeyLeftControl) || TextInputKeyDown(TextInputKeyRightControl) {
            modifiers |= 2
        }
        if node_runners[slot].nested != null {
            NodeTreeFrame(slot, node_screen_frame, key, modifiers, input)
        } else {
            NodeAppPortableFrame(slot, app.ui.session,
                Rectangle.{0.0, 0.0, cast(float32)app.ui.view_width,
                    cast(float32)(app.ui.view_height - app_content_bottom_reserved(app))},
                app.dark_mode != 0, MetricsScale(), AppFontSize(), key, modifiers, input)
        }
    }
    if node_runners[slot].nested != null {
        WidgetHostBegin(app.ui.session, NodeTreeAssetAllowed, NodeTreeAssetPath)
    } else {
        WidgetHostBegin(app.ui.session, HostedAssetAllowed, WidgetHostPackedPath)
    }
    NodeAppUiBegin(NodeScreenUiCall, cast(*void)app)
    unused NodeAppRunMessage(slot, message)
    NodeAppUiEnd()
    WidgetHostEnd()
    NodeScreenMediaPicker(app)
}
