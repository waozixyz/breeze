// The screen of an app the node offers, such as Chess. The app draws itself
// with hosted Kryon widgets; this screen supplies its frame, its text in the
// person's language and the account's friends.
#import "byte_text_linux"
#import "text_buffer"
#import "json_scan"
#import "vec"
#import "text"
#import "session"
#import "geometry"
