c :: #system_library "c";
GetTime :: () -> float64 #foreign c;

// Seconds of row measuring per frame. A long chat is measured across frames
// behind a loading bar, so nothing else on screen, such as a minimized
// practice's window, waits for it.
LUMI_MEASURE_BUDGET :: 0.004

#program_export
app_lumi_input_focused :: (app: *InnerBreeze) -> bool {
    return app != null && app.breathing.screen == ScreenLumi && lumi_ui.focused
}

app_lumi_reset :: () {
    LumiOnlineCancel()
    LumiStoreReset()
    lumi_ui = LumiUiFrame.{}
    lumi_input[0] = cast(u8)0
    lumi_tasks = EListState.{}
    lumi_tasks_revision = -1
    VecFree(lumi_row_heights)
    VecFree(lumi_row_keys)
    VecFree(lumi_row_offsets)
    lumi_rows_measured = 0
    lumi_rows_history_pending = false
    lumi_draft_width = 0
    lumi_pending_route = -1
    lumi_pending_practice = -1
    lumi_settings_open = false
    lumi_history_loading = false
    lumi_choosing_habit = false
    lumi_choosing_diary = false
    LumiDeleteClear()
}

// Lumi's online terms in the app's language, for where requests go now:
// what is sent, where it goes, what Inner Breeze's server keeps, safety and
// the person's choice. Each sentence states what the code does: the request
// built in lumi_online.zi, app_tools.zi, diary_spelling.zi and
// habit_icon_choice.zi, and in Daochi chat.zi (prompt, provider request,
// spelling, habit icons, daily counts), feedback_http.zi, lumi_telegram.zi
// and the deploy workflow's 30-day database backups. Change them together.
LumiAgreementCompose :: (host: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "**%**\n\n", LocaleText("lumi_agreement_title"))
    BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_intro"))
    BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_sent"))
    if host.count > 0 {
        args: [1]FormatArg
        args[0].text = host
        args[0].is_text = true
        // Room for the longest translation and the longest provider host.
        where: [2048]u8
        unused FormatTemplate(LocaleText("lumi_agreement_where_own"), args[:], where[:])
        BuilderPrint(*out, "%\n\n", TextUntilNul(where[:]))
    } else {
        BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_where_node"))
        BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_kept"))
    }
    BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_server"))
    BuilderPrint(*out, "%\n\n", LocaleText("lumi_agreement_safety"))
    BuilderPrint(*out, "%", LocaleText("lumi_agreement_choice"))
    return BuilderFinish(out)
}

// Composes and measures the terms while their panel is open.
LumiAgreementPrepare :: (width: s32) {
    if lumi_ui.agreement == 0 {
        lumi_ui.agreement_text = ""
        lumi_ui.agreement_height = 0
        return
    }
    key := (KeyHash(lumi_ui.provider_host) ^ KeyHash(LocaleActiveCode()) ^ AssetGeneration()) *
    cast(u64)1099511628211 + cast(u64)width * cast(u64)31 + cast(u64)lumi_ui.font
    if key != lumi_agreement_key || lumi_agreement_text.count == 0 {
        lumi_agreement_key = key
        lumi_ui.agreement_text = ""
        PackageFree(lumi_agreement_text)
        lumi_agreement_text = LumiAgreementCompose(lumi_ui.provider_host)
        counts := LumiFormatInto(lumi_agreement_text, true, lumi_agreement_bytes[:],
            lumi_agreement_strong[:])
        prepared := PrepareText(TextProps.{.text = TextFromBytes(lumi_agreement_bytes[:counts.count]),
                .font = lumi_ui.font, .wrap = cast(TextWrap)TextWrapAuto,
                .strong = lumi_agreement_strong[:counts.strong_count],
                .bounds = Rectangle.{0.0, 0.0, cast(float32)width, 0.0}}, DefaultTextFace())
        lumi_agreement_height = cast(s32)prepared.bounds.height + AppScale(16)
    }
    lumi_ui.agreement_text = lumi_agreement_text
    lumi_ui.agreement_height = lumi_agreement_height
}

// Whether opening Lumi now shows its online terms: not yet agreed for where
// requests would go, never withdrawn or switched offline, with an own
// provider ready to name, and not shown before in this run.
LumiAgreementPromptWanted :: () -> bool {
    return LUMI_AGREEMENT_REQUIRED != 0 && !lumi_agreement_prompted && lumi_ui.agreement == 0 &&
    StoredAccountMode() != AccountModeDelegate && LumiOnlineWanted() && !LumiAiAgreed() &&
    !LumiNodeDeclined() && (!LumiOwnProviderSelected() || LumiOwnProviderReady())
}

// The title bar's connection button. Going online without the agreement
// for where requests go opens the terms instead: 1 online, 2 terms shown,
// 0 offline.
LumiSetOnline :: (on: bool) -> s32 {
    if StoredAccountMode() == AccountModeDelegate {
        return 0
    }
    lumi_ui.agreement = 0
    if !on {
        // The next pump cancels anything in flight; nothing new starts.
        storage_set_setting_int(LumiOnlineSetting, 0)
        return 0
    }
    if LumiOwnProviderSelected() && !LumiOwnProviderReady() {
        // Terms naming no address would say nothing; set the provider first.
        LumiStoreAppend(LocaleText("lumi_online_setup"), false)
        return 0
    }
    if !LumiAiAgreed() {
        lumi_ui.agreement = 1
        return 2
    }
    storage_set_setting_int(LumiOnlineSetting, 1)
    return 1
}

// The terms panel's buttons: 1 agree and go online, 2 not now, 3 withdraw,
// 4 close.
LumiAgreementChoice :: (choice: s32) -> bool {
    if StoredAccountMode() == AccountModeDelegate || choice < 1 || choice > 4 {
        return false
    }
    asked := lumi_ui.agreement
    lumi_ui.agreement = 0
    if choice == 1 && asked != 0 {
        return LumiAgree()
    }
    if choice == 3 {
        return LumiWithdraw()
    }
    return true
}

// Settings shows the terms where they live, in Lumi.
#program_export
app_lumi_show_agreement :: (app: *InnerBreeze) {
    if app == null || StoredAccountMode() == AccountModeDelegate {
        return
    }
    lumi_ui.agreement = ifx LumiAiAgreed() then 2 else 1
    lumi_settings_open = false
    app_apply_nav_route(app, APP_NAV_ROUTE_LUMI)
}

// Back on Lumi's settings page returns to the chat.
#program_export
app_lumi_settings_back :: (app: *InnerBreeze) -> bool {
    if app == null || app.breathing.screen != ScreenLumi || !lumi_settings_open {
        return false
    }
    lumi_settings_open = false
    return true
}

// Opening a conversation never submits it: the user supplies the desired look.
AppearanceAskLumi :: (app: *InnerBreeze, scope: string) {
    prompt: Vec(u8)
    BuilderPrint(*prompt, "% %: ", LocaleText("appearance_kss_prompt"), scope)
    text := BuilderFinish(prompt)
    defer { PackageFree(text) }
    unused AppCopyText(text, lumi_input[:])
    lumi_ui.value = AppTextFromCString(*lumi_input[0], LUMI_INPUT_MAX)
    lumi_ui.cursor = cast(s32)lumi_ui.value.count
    lumi_ui.anchor = lumi_ui.cursor
    lumi_ui.focused = true
    app_apply_nav_route(app, APP_NAV_ROUTE_LUMI)
}

// An installed delegate is restricted to the approved Lumi collection even
// when this same local profile already contains enabled private apps.
LumiHistoryAvailable :: () -> bool {
    return StoredAccountMode() != AccountModeDelegate || StoredDelegateAvailable() != 0
}

LumiToolsAvailable :: () -> bool {
    return StoredAccountMode() != AccountModeDelegate
}

LumiContextAvailable :: (app: *InnerBreeze) -> bool {
    return app != null && LumiHistoryAvailable() &&
    (LumiToolsAvailable() || (app.enabled_apps & CellsInstalledMask() & APP_LUMI) != 0)
}

LumiDelegateHostAllowed :: (name: string) -> bool {
    return name == "LumiFirstVisibleRowHost" || name == "LumiRowOffsetHost" ||
    name == "LumiEnglishLocaleHost" ||
    name == "LumiLoadOlderHost" || name == "ReadLumiToolsHost" ||
    name == "ReadLumiUiHost" || name == "WriteLumiUiHost" ||
    name == "LumiLocaleHost" || name == "LumiViewLocaleHost" ||
    name == "LumiLocaleRevisionHost" ||
    name == "ReadLumiChatRowHost" || name == "AppendLumiChatHost" ||
    name == "StartLumiOnlineHost"
}

LumiHostAllowed :: (app: *InnerBreeze, name: string) -> bool {
    return LumiToolsAvailable() || (LumiContextAvailable(app) && LumiDelegateHostAllowed(name))
}

// What the account may see of the chat. Each check reads settings, so a pass
// over many rows reads it once.
LumiRowAccess :: struct {
    history: bool
    tools: bool
}

LumiRowAccessNow :: () -> LumiRowAccess {
    return LumiRowAccess.{.history = LumiHistoryAvailable(), .tools = LumiToolsAvailable()}
}

// Retain archived message text without invoking tools embedded in older
// progress or feedback cards from the full owner installation.
LumiVisibleRow :: (row: LumiChatRow, access: LumiRowAccess) -> LumiChatRow {
    if !access.history {
        return LumiChatRow.{}
    }
    visible := row
    if !access.tools {
        visible.kind = LUMI_CHAT_TEXT
        visible.payload = ""
    }
    return visible
}

// Lumi sees the habits in the habit list: position counts active habits
// only, as LumiHabitCount does.
LumiHabitCount :: (app: *InnerBreeze) -> s32 {
    if !app_nav_route_available(app, APP_NAV_ROUTE_HABITS) {
        return 0
    }
    return habits_active_count(*app.habits)
}

LumiHabitAt :: (app: *InnerBreeze, position: s32) -> LumiTask {
    if !LumiToolsAvailable() || !app_nav_route_available(app, APP_NAV_ROUTE_HABITS) {
        return LumiTask.{}
    }
    index := habits_active_at(*app.habits, position)
    if index < 0 {
        return LumiTask.{}
    }
    habit := *app.habits.items[index]
    day := habits_today_index()
    count := HabitEffectiveDayCount(habit, day, habit_cached_linked_entries(app, index, day))
    target := ifx habit_counting_enabled(habit) != 0 then habit_counter_target(habit) else 1
    return LumiTask.{.id = AppTextFromCString(*habit.id[0], HABIT_ID_SIZE),
        .title = AppTextFromCString(*habit.name[0], HABIT_NAME_SIZE), .done = count >= target}
}

// The habit's last two weeks, so Lumi can coach from real progress: the
// days it was planned and done, and the current run of done days.
LumiHabitProgress :: struct {
    scheduled_days: s32
    done_days: s32
    streak: s32
}

LUMI_PROGRESS_DAYS :: 14
LUMI_STREAK_DAYS :: 365

LumiPreviousDay :: (day_index: s32) -> s32 {
    year := day_index / 10000
    month := (day_index / 100) % 100
    day := day_index % 100
    if day > 1 {
        return day_index - 1
    }
    month -= 1
    if month < 1 {
        month = 12
        year -= 1
    }
    return year * 10000 + month * 100 + habit_days_in_month(year, month)
}

LumiHabitProgressAt :: (app: *InnerBreeze, position: s32) -> LumiHabitProgress {
    progress: LumiHabitProgress
    if !LumiToolsAvailable() || !app_nav_route_available(app, APP_NAV_ROUTE_HABITS) {
        return progress
    }
    index := habits_active_at(*app.habits, position)
    if index < 0 {
        return progress
    }
    habit := *app.habits.items[index]
    target := ifx habit_counting_enabled(habit) != 0 then habit_counter_target(habit) else 1
    // Day 0 lists the habit's linked practice sessions on every day.
    linked := habit_cached_linked_entries(app, index, 0)
    today := habits_today_index()
    day := today
    streak_open := true
    for offset: cast(s32)0..LUMI_STREAK_DAYS - 1 {
        done := HabitEffectiveDayCount(habit, day, linked) >= target
        scheduled := habit_scheduled_day(habit, day) != 0
        if offset < LUMI_PROGRESS_DAYS {
            if scheduled {
                progress.scheduled_days += 1
            }
            if done {
                progress.done_days += 1
            }
        }
        // Today still counts toward the streak until it ends, and days off
        // the habit's schedule neither extend nor break it.
        if streak_open {
            if done {
                progress.streak += 1
            } else if scheduled && day != today {
                streak_open = false
            }
        }
        if !streak_open && offset >= LUMI_PROGRESS_DAYS - 1 {
            break
        }
        day = LumiPreviousDay(day)
    }
    return progress
}

LumiTaskAt :: (index: s32) -> LumiTask {
    if !LumiToolsAvailable() {
        return LumiTask.{}
    }
    if index < 0 || index >= lumi_tasks.item_count {
        return LumiTask.{}
    }
    item := *lumi_tasks.items[index]
    return LumiTask.{.id = AppTextFromCString(*item.id[0], 37),
        .title = AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE), .done = item.done != 0}
}

// Every proposed action is checked again against live state at execution.
LumiPerform :: (app: *InnerBreeze, action: LumiAction) -> bool {
    if !LumiToolsAvailable() {
        return false
    }
    if app == null || (CellsInstalledMask() & APP_LUMI) == 0 {
        return false
    }
    if action.kind == LUMI_SHOW_PROGRESS {
        payload := LumiProgressJson(app, action.practice, action.route)
        defer { PackageFree(payload) }
        if payload.count == 0 {
            return false
        }
        return LumiStoreAppendCard(LocaleText(LumiChartTitleKey(action.practice)), false, LUMI_CHAT_PROGRESS, payload)
    }
    if action.kind == LUMI_SET_THEME {
        return AppSetTheme(app, action.title)
    }
    if action.kind == LUMI_SET_MODE {
        return AppSetThemeMode(app, action.route)
    }
    if action.kind == LUMI_WRITE_DIARY {
        return app_nav_route_available(app, APP_NAV_ROUTE_DIARY) &&
        app_diary_append(action.title)
    }
    if action.kind == LUMI_REPORT_FEEDBACK {
        context := AppFeedbackContext(app)
        defer { PackageFree(context) }
        title := action.title
        if title.count > 160 {
            end: s64 = 160
            while end > 0 && (title[end] & cast(u8)192) == cast(u8)128 {
                end -= 1
            }
            title = title[:end]
        }
        id := FeedbackDraft(title, action.title, context)
        defer { PackageFree(id) }
        return id.count == 32 && LumiStoreAppendCard(LocaleText("lumi_feedback_confirm"),
            false, LUMI_CHAT_FEEDBACK, id)
    }
    if action.kind == LUMI_OPEN && action.route == APP_NAV_ROUTE_SETTINGS {
        lumi_pending_route = APP_NAV_ROUTE_SETTINGS
        if action.practice == 1 {
            app.settings_tab = SETTINGS_TAB_THEME
        }
        return true
    }
    if action.kind == LUMI_OPEN {
        if (action.route != APP_NAV_ROUTE_ELIST && action.route != APP_NAV_ROUTE_HABITS &&
            action.route != APP_NAV_ROUTE_PRACTICE && action.route != APP_NAV_ROUTE_DIARY) ||
        !app_nav_route_available(app, action.route) {
            return false
        }
        lumi_pending_route = action.route
        return true
    }
    if action.kind == LUMI_START_PRACTICE {
        if !app_can_start_practice(app, action.practice) {
            return false
        }
        // Starting can change routes and cell instances. Finish this cell frame
        // before invoking the native practice, within the same app frame.
        lumi_pending_practice = action.practice
        return true
    }
    if action.kind == LUMI_COMPLETE_HABIT {
        if !app_nav_route_available(app, APP_NAV_ROUTE_HABITS) {
            return false
        }
        for position: cast(s32)0..LumiHabitCount(app) - 1 {
            if LumiHabitAt(app, position).id == action.id && action.id.count > 0 {
                return habit_complete_day(app, habits_active_at(*app.habits, position),
                    habits_today_index())
            }
        }
        return false
    }
    if !app_nav_route_available(app, APP_NAV_ROUTE_ELIST) ||
    storage_elist_load(cast(*void)*lumi_tasks) == 0 {
        return false
    }
    if action.kind == LUMI_ADD_TODO {
        if action.title.count == 0 || action.title.count >= ELIST_TITLE_SIZE || lumi_tasks.list_count == 0 ||
        lumi_tasks.item_count >= ELIST_ITEM_MAX {
            return false
        }
        selected := app.elist.selected_list
        if selected < 0 || selected >= lumi_tasks.list_count {
            selected = 0
        }
        parent := AppTextFromCString(*lumi_tasks.lists[selected].id[0], 37)
        if storage_elist_create_item(parent, action.title, "", null) == 0 {
            return false
        }
    } else if action.kind == LUMI_COMPLETE_TODO || action.kind == LUMI_REOPEN_TODO {
        found: bool
        for index: cast(s32)0..lumi_tasks.item_count - 1 {
            item := *lumi_tasks.items[index]
            id := AppTextFromCString(*item.id[0], 37)
            if id != action.id {
                continue
            }
            done: s32 = ifx action.kind == LUMI_COMPLETE_TODO then 1 else 0
            if item.done == done || storage_elist_update_item(id,
                AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE),
                AppTextFromCString(*item.comment[0], ELIST_COMMENT_SIZE), done, item.sort_order) == 0 {
                return false
            }
            found = true
            break
        }
        if !found {
            return false
        }
    } else {
        return false
    }
    app.elist.loaded = 0
    app.elist.visibility_valid = false
    unused storage_elist_load(cast(*void)*lumi_tasks)
    return true
}

LumiUiCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    owner := TextFromCString(module)
    if owner != "lumi" && owner != "lumi_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if StoredAccountMode() == AccountModeDelegate {
        if !LumiHostAllowed(cast(*InnerBreeze)context, name) {
            return 0
        }
        if name == "StartLumiOnlineHost" && count == 1 &&
        HostScalarValid(arguments[0], "string", cast(s32)HostString) {
            // The portable composer interprets true as an already handled
            // reply. No broad online request or waiting state is created.
            LumiStoreAppend(LocaleText("lumi_online_unavailable"), false)
            result.* = HostScalar("bool", 1)
            return 1
        }
    }
    if name == "LumiLocaleRevisionHost" && count == 0 {
        language := LocaleActiveCode()
        assets := AssetGeneration()
        if language != AppTextFromCString(*lumi_locale_language[0], 32) || assets != lumi_locale_assets {
            unused AppCopyText(language, lumi_locale_language[:])
            lumi_locale_assets = assets
            lumi_locale_revision += 1
        }
        result.* = HostScalar("s64", lumi_locale_revision)
        return 1
    }
    if (name == "LumiFirstVisibleRowHost" || name == "LumiRowOffsetHost") && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        requested := cast(s32)arguments[0].integer
        index: s32 = 0
        // Offsets are ready once every row is measured.
        if lumi_row_offsets.count != lumi_row_heights.count + 1 {
            result.* = HostScalar("s32", 0)
            return 1
        }
        if name == "LumiRowOffsetHost" {
            index = requested
            if index < 0 { index = 0 }
            if index >= lumi_row_offsets.count { index = cast(s32)lumi_row_offsets.count - 1 }
        } else {
            low: s32 = 0
            high := cast(s32)lumi_row_heights.count
            while low < high {
                middle := low + (high - low) / 2
                if lumi_row_offsets[middle + 1] <= requested { low = middle + 1 }
                else { high = middle }
            }
            index = low
        }
        offset := ifx index >= 0 && index < lumi_row_offsets.count then lumi_row_offsets[index] else 0
        result.* = HostScalar("s32", ifx name == "LumiRowOffsetHost" then offset else index)
        return 1
    }
    // Selected messages are deleted one row at a time; row 0 is the greeting,
    // which is not stored and cannot be deleted.
    if name == "LumiDeleteRowHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        deleted := index > 0 && index < lumi_ui.chat_count && LumiStoreDelete(index - 1)
        result.* = HostScalar("bool", ifx deleted then 1 else 0)
        return 1
    }
    if name == "LumiLoadOlderHost" && count == 0 {
        previous := LumiStoreCount()
        lumi_history_loading = LumiStoreLoadOlder()
        lumi_history_added_rows = LumiStoreCount() - previous
        result.* = HostScalar("bool", ifx lumi_history_loading then 1 else 0)
        return 1
    }
    if name == "LumiFeedbackChoiceHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        id := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        action := cast(s32)arguments[1].integer
        // The confirmation card is the whole exchange; its buttons show the choice.
        succeeded := FeedbackChoice(id, action)
        result.* = HostScalar("bool", ifx succeeded then 1 else 0)
        return 1
    }
    // Lumi packages before 1.5.0 still ask for donation cards, which Inner
    // Breeze no longer offers: they read nothing and do nothing.
    if name == "ReadLumiDonationHost" && count == 1 {
        result.* = WidgetEncodeLumiDonation(LumiDonation.{}, *lumi_donation_codec)
        return 1
    }
    if name == "LumiDonationActionHost" && count == 2 {
        result.* = HostScalar("bool", 0)
        return 1
    }
    if name == "StartLumiOnlineHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        input := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        result.* = HostScalar("bool", ifx LumiOnlineStart(input) then 1 else 0)
        return 1
    }
    if name == "SetLumiOnlineHost" && count == 1 &&
    HostScalarValid(arguments[0], "bool", cast(s32)HostInteger) {
        result.* = HostScalar("s32", LumiSetOnline(arguments[0].integer != 0))
        return 1
    }
    if name == "LumiAgreementHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        chosen := LumiAgreementChoice(cast(s32)arguments[0].integer)
        result.* = HostScalar("bool", ifx chosen then 1 else 0)
        return 1
    }
    if name == "OpenLumiSettingsHost" && count == 0 {
        lumi_settings_open = true
        lumi_settings_scroll = 0
        result.* = HostScalar("bool", 1)
        return 1
    }
    // The offline harness runs the same validated tools as the online model.
    if name == "LumiToolHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        tool := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        tool_arguments := TextFromBytes(BytesFromPointer(arguments[1].data, cast(u64)arguments[1].length))
        PackageFree(lumi_tool_text)
        lumi_tool_text = AppToolExecute(cast(*InnerBreeze)context, tool, tool_arguments)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(lumi_tool_text), .length = cast(usize)lumi_tool_text.count}
        return 1
    }
    if name == "ConfirmLumiDeleteHost" && count == 1 &&
    HostScalarValid(arguments[0], "bool", cast(s32)HostInteger) {
        deleted := ConfirmLumiDelete(cast(*InnerBreeze)context, arguments[0].integer != 0)
        result.* = HostScalar("bool", ifx deleted then 1 else 0)
        return 1
    }
    if name == "LumiEnglishLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleEnglishText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    if name == "ReadLumiToolsHost" && count == 0 {
        result.* = WidgetEncodeLumiTools(LumiTools.{.available_apps = lumi_ui.available_apps,
                .task_count = lumi_ui.task_count, .habit_count = lumi_ui.habit_count,
                .choosing_habit = lumi_choosing_habit, .choosing_diary = lumi_choosing_diary,
                .confirming_delete = LumiDeletePending()}, *lumi_tools_codec)
        return 1
    }
    if name == "SetLumiHabitChoiceHost" && count == 1 && HostScalarValid(arguments[0], "bool", cast(s32)HostInteger) {
        lumi_choosing_habit = arguments[0].integer != 0
        return 1
    }
    if name == "SetLumiDiaryChoiceHost" && count == 1 && HostScalarValid(arguments[0], "bool", cast(s32)HostInteger) {
        lumi_choosing_diary = arguments[0].integer != 0
        return 1
    }
    if name == "ReadLumiUiHost" && count == 0 {
        result.* = WidgetEncodeLumiUiFrame(lumi_ui, *lumi_ui_codec)
        return 1
    }
    if name == "WriteLumiUiHost" && count == 1 && WidgetValidLumiUiFrame(arguments[0]) {
        frame := WidgetDecodeLumiUiFrame(arguments[0], *lumi_ui_codec)
        if frame.value.count >= LUMI_INPUT_MAX || !AppCopyText(frame.value, lumi_input[:]) {
            return 0
        }
        lumi_ui.value = AppTextFromCString(*lumi_input[0], LUMI_INPUT_MAX)
        lumi_ui.cursor = frame.cursor
        lumi_ui.anchor = frame.anchor
        lumi_ui.input_scroll = frame.input_scroll
        lumi_ui.selecting = frame.selecting
        lumi_ui.preferred_x = frame.preferred_x
        lumi_ui.preferred_x_valid = frame.preferred_x_valid
        lumi_ui.focused = frame.focused
        lumi_ui.scroll = frame.scroll
        lumi_ui.follow_end = frame.follow_end
        if frame.clipboard_write {
            unused TextInputWriteClipboard(frame.clipboard_text)
        }
        return 1
    }
    if (name == "LumiLocaleHost" || name == "LumiViewLocaleHost") && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    if name == "LumiTaskCountHost" && count == 0 {
        result.* = HostScalar("s32", lumi_tasks.item_count)
        return 1
    }
    if (name == "ReadLumiTaskHost" || name == "ReadLumiSuggestionTaskHost") && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        result.* = WidgetEncodeLumiTask(LumiTaskAt(cast(s32)arguments[0].integer), *lumi_task_codec)
        return 1
    }
    if (name == "ReadLumiHabitHost" || name == "ReadLumiSuggestionHabitHost") && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        result.* = WidgetEncodeLumiTask(LumiHabitAt(cast(*InnerBreeze)context,
            cast(s32)arguments[0].integer), *lumi_task_codec)
        return 1
    }
    if name == "ReadLumiChatRowHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        if index < 0 || index >= lumi_ui.chat_count {
            return 0
        }
        row := LumiMeasuredRow(index, LumiRowAccessNow())
        result.* = WidgetEncodeLumiChatRow(row, *lumi_row_codec)
        return 1
    }
    if name == "AppendLumiChatHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "bool", cast(s32)HostInteger) {
        text := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        LumiStoreAppend(text, arguments[1].integer != 0)
        return 1
    }
    if name == "PerformLumiActionHost" && count == 1 && WidgetValidLumiAction(arguments[0]) {
        action := WidgetDecodeLumiAction(arguments[0], *lumi_action_codec)
        result.* = HostScalar("bool", ifx LumiPerform(cast(*InnerBreeze)context, action) then 1 else 0)
        return 1
    }
    return 0
}

// The chat's row at index: Lumi's greeting first, then the stored messages.
LumiChatRowAt :: (index: s32, access: LumiRowAccess) -> LumiChatRow {
    if index == 0 {
        return LumiVisibleRow(LumiChatRow.{.text = LocaleText("lumi_greeting")}, access)
    }
    return LumiVisibleRow(LumiStoreRow(index - 1), access)
}

// Identifies what a row's height depends on: its text, author and kind.
LumiRowKey :: (index: s32, access: LumiRowAccess) -> u64 {
    row := LumiChatRowAt(index, access)
    marker := cast(u64)(row.kind * 2 + (ifx row.user then 1 else 0) + 1)
    return (KeyHash(row.text) ^ marker) * cast(u64)1099511628211
}

LumiMeasuredRow :: (index: s32, access: LumiRowAccess) -> LumiChatRow {
    row := LumiChatRowAt(index, access)
    if index < 0 || index >= lumi_row_heights.count {
        return row
    }
    if lumi_row_heights[index] == 0 {
        column_width := CenteredColumnFor(lumi_ui.width, AppScale(720), AppScale(16)).width
        formatted := LumiFormatMessage(row.text, !row.user)
        prepared := PrepareText(TextProps.{.text = TextFromBytes(formatted.bytes[:formatted.count]),
                .font = lumi_ui.font, .bounds = Rectangle.{0.0, 0.0,
                    cast(float32)(column_width - cast(s32)((ifx row.user then 88.0 else 108.0) * lumi_ui.scale)), 0.0}},
            DefaultTextFace())
        height := cast(s32)prepared.bounds.height + cast(s32)((ifx row.user then 38.0 else 58.0) * lumi_ui.scale)
        if row.kind == LUMI_CHAT_PROGRESS {
            height += AppScale(242)
        } else if row.kind == LUMI_CHAT_FEEDBACK {
            height += AppScale(54)
        }
        minimum := AppScale(ifx row.user then 54 else 80)
        lumi_row_heights[index] = ifx height < minimum then minimum else height
    }
    row.height = lumi_row_heights[index]
    return row
}

// Starts measuring the chat's rows again. While the layout is unchanged, a
// row keeps the height measured for the same content, wherever a sync, a new
// message or older history moved it.
LumiRowsReset :: (layout_changed: bool) {
    previous_keys: Vec(u64)
    previous_heights: Vec(s32)
    VecSwap(previous_keys, lumi_row_keys)
    VecSwap(previous_heights, lumi_row_heights)
    previous_count := cast(s32)previous_keys.count
    access := LumiRowAccessNow()
    // Rows mostly keep their order, so each search starts after the last
    // match.
    next: s32 = 0
    for index: cast(s32)0..lumi_ui.chat_count - 1 {
        key := LumiRowKey(index, access)
        height: s32 = 0
        if !layout_changed && previous_count > 0 {
            for step: cast(s32)0..previous_count - 1 {
                candidate := (next + step) % previous_count
                if previous_keys[candidate] == key {
                    height = previous_heights[candidate]
                    next = (candidate + 1) % previous_count
                    break
                }
            }
        }
        unused VecPush(lumi_row_keys, key)
        unused VecPush(lumi_row_heights, height)
    }
    VecFree(previous_keys)
    VecFree(previous_heights)
    VecFree(lumi_row_offsets)
    lumi_rows_measured = 0
}

// Measures rows for up to the frame's budget. Returns true once every row is
// measured and the rows' offsets are ready.
LumiRowsMeasure :: () -> bool {
    if lumi_row_offsets.count == lumi_ui.chat_count + 1 {
        return true
    }
    started := GetTime()
    access := LumiRowAccessNow()
    while lumi_rows_measured < lumi_ui.chat_count {
        unused LumiMeasuredRow(lumi_rows_measured, access)
        lumi_rows_measured += 1
        if GetTime() - started >= LUMI_MEASURE_BUDGET {
            break
        }
    }
    if lumi_rows_measured < lumi_ui.chat_count {
        return false
    }
    VecFree(lumi_row_offsets)
    unused VecPush(lumi_row_offsets, cast(s32)0)
    total: s32 = 0
    for index: cast(s32)0..lumi_ui.chat_count - 1 {
        total += lumi_row_heights[index]
        unused VecPush(lumi_row_offsets, total)
    }
    return true
}

// Shown while a long chat is still being measured: how far it has come.
LumiDrawLoading :: (app: *InnerBreeze) {
    column := CenteredColumnFor(app.ui.view_width, AppScale(320), AppScale(24))
    middle := (app.ui.view_height - app_content_bottom_reserved(app)) / 2
    Text(app.ui.session, TextProps.{.key = KeyHash("inbe/lumi/loading"),
            .text = LocaleText("lumi_loading"), .font = AppFontSize(),
            .bounds = Rectangle.{cast(float32)column.x, cast(float32)(middle - AppScale(32)),
                cast(float32)column.width, cast(float32)AppScale(24)},
            .align = cast(TextAlign)TextAlignCenter})
    progress: ProgressProps
    progress.key = KeyHash("inbe/lumi/loading-progress")
    progress.bounds = Rectangle.{cast(float32)column.x, cast(float32)middle,
        cast(float32)column.width, cast(float32)AppScale(8)}
    progress.min = 0
    progress.max = lumi_ui.chat_count
    progress.value = lumi_rows_measured
    Progress(app.ui.session, progress)
}

LumiPrepareTools :: (app: *InnerBreeze) {
    if StoredAccountMode() == AccountModeDelegate {
        // Validate before loading either chat history or unrelated private
        // tables. Expiry/revocation also drops cached plaintext UI rows.
        current := LumiContextAvailable(app)
        if !current {
            LumiStoreReset()
        }
        lumi_tasks = EListState.{}
        lumi_tasks_revision = -1
        lumi_choosing_diary = false
        lumi_choosing_habit = false
        lumi_ui.available_apps = ifx current then (app.enabled_apps & CellsInstalledMask() & APP_LUMI) else 0
        lumi_ui.task_count = 0
        lumi_ui.habit_count = 0
        lumi_ui.choosing_habit = false
        lumi_ui.choosing_diary = false
        lumi_ui.waiting = false
        lumi_ui.chat_count = ifx current then LumiStoreCount() + 1 else 0
        lumi_ui.online = false
        lumi_ui.connection = false
        lumi_ui.agreement = 0
        lumi_ui.provider_host = ""
        return
    }

    owner_changed := lumi_store_loaded && AppTextFromCString(*lumi_owner[0], 64) !=
    AppTextFromCString(storage_user_id_buffer(), 64)
    if owner_changed {
        app_lumi_reset()
    }
    chat_count := LumiStoreCount() + 1
    if lumi_ui.chat_count == 0 && chat_count > 1 {
        lumi_ui.scroll = 1000000
    }
    lumi_ui.chat_count = chat_count
    if app_nav_route_available(app, APP_NAV_ROUTE_ELIST) {
        revision := storage_data_revision()
        if revision != lumi_tasks_revision {
            unused storage_elist_load(cast(*void)*lumi_tasks)
            lumi_tasks_revision = storage_data_revision()
        }
    } else {
        lumi_tasks.item_count = 0
        lumi_tasks_revision = -1
    }
    lumi_ui.task_count = lumi_tasks.item_count
    lumi_ui.available_apps = app.enabled_apps & CellsInstalledMask()
    if (lumi_ui.available_apps & APP_DIARY) == 0 {
        lumi_choosing_diary = false
    }
    if (lumi_ui.available_apps & APP_HABITS) == 0 {
        lumi_choosing_habit = false
    }
    lumi_ui.choosing_habit = lumi_choosing_habit
    lumi_ui.choosing_diary = lumi_choosing_diary
    lumi_ui.waiting = LumiOnlineWaiting()
    lumi_ui.habit_count = LumiHabitCount(app)
    lumi_ui.online = LumiToggleOn()
    lumi_ui.connection = true
    lumi_provider_host_text = .{}
    if LumiOwnProviderSelected() {
        url: [LUMI_PROVIDER_URL_MAX]u8
        unused AppCopyText(storage_get_setting_text(LumiProviderUrlSetting), url[:])
        unused AppCopyText(LumiProviderHost(TextUntilNul(url[:])), lumi_provider_host_text[:])
    }
    lumi_ui.provider_host = AppTextFromCString(*lumi_provider_host_text[0], LUMI_PROVIDER_URL_MAX)
}

// Telegram and the native composer run the same interpreter against live app
// state. No render frame or remembered action is needed for a remote message.
LumiSubmit :: (app: *InnerBreeze, input: string) -> bool {
    if app == null || input.count == 0 || input.count >= LUMI_INPUT_MAX ||
    !LumiContextAvailable(app) {
        return false
    }
    LumiPrepareTools(app)
    lumi_pending_route = -1
    lumi_pending_practice = -1
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    CellsUiBegin(LumiUiCall, cast(*void)app)
    response := LumiRun(LumiMessage.{.action = LUMI_SEND, .input = input})
    CellsUiEnd()
    WidgetHostEnd()
    if lumi_pending_practice >= 0 && !app_start_practice(app, lumi_pending_practice) {
        LumiStoreAppend(LocaleText("lumi_unavailable"), false)
    }
    if lumi_pending_route >= 0 {
        app_apply_nav_route(app, lumi_pending_route)
    }
    return response.succeeded
}

#program_export
lumi_screen_draw :: (app: *InnerBreeze) {
    if !LumiContextAvailable(app) {
        return
    }
    // Opening the chat again starts from its newest messages, like Telegram.
    opened_at := GetTime()
    if opened_at - lumi_last_drawn > 1.0 {
        LumiStoreShowNewest()
        lumi_history_loading = false
        lumi_ui.follow_end = true
        lumi_ui.scroll = 1000000
        lumi_agreement_due = true
        lumi_settings_open = false
    }
    lumi_last_drawn = opened_at
    if lumi_settings_open {
        if lumi_settings_page_draw(app, *lumi_settings_scroll) {
            lumi_settings_open = false
            app_block_current_click(app)
        }
        return
    }
    LumiPrepareTools(app)
    lumi_ui.session = app.ui.session
    if lumi_ui.follow_end && (lumi_ui.width != app.ui.view_width || lumi_ui.height != app.ui.view_height) {
        lumi_ui.scroll = 1000000
    }
    lumi_ui.width = app.ui.view_width
    lumi_ui.height = app.ui.view_height
    lumi_ui.bottom = app_content_bottom_reserved(app)
    lumi_ui.scale = MetricsScale()
    lumi_ui.now = GetTime()
    if !lumi_ui.waiting {
        lumi_waiting_since = -1.0
    } else if lumi_waiting_since < 0.0 {
        lumi_waiting_since = lumi_ui.now
    }
    lumi_ui.typing_pause = lumi_ui.waiting && lumi_ui.now - lumi_waiting_since < LUMI_TYPING_DELAY
    lumi_ui.background = StyleTokenColor("canvas")
    lumi_ui.font = AppFontSize()
    revision := LumiStoreRevision()
    history_changed := revision != lumi_rows_revision
    assets := AssetGeneration()
    language := LocaleActiveCode()
    layout_changed := lumi_ui.width != lumi_rows_width ||
    lumi_ui.font != lumi_rows_font || lumi_ui.scale != lumi_rows_scale ||
    assets != lumi_rows_assets ||
    language != AppTextFromCString(*lumi_rows_language[0], 32)
    if history_changed || layout_changed {
        LumiRowsReset(layout_changed)
        lumi_rows_history_pending = lumi_rows_history_pending || history_changed
        lumi_rows_revision = revision
        lumi_rows_width = lumi_ui.width
        lumi_rows_font = lumi_ui.font
        lumi_rows_scale = lumi_ui.scale
        lumi_rows_assets = assets
        unused AppCopyText(language, lumi_rows_language[:])
    }
    if !LumiRowsMeasure() {
        LumiDrawLoading(app)
        return
    }
    history_measured := lumi_rows_history_pending
    lumi_rows_history_pending = false
    lumi_ui.history_height = ifx lumi_row_offsets.count > 0 then lumi_row_offsets[lumi_row_offsets.count - 1] else 0
    lumi_ui.has_older = lumi_has_older
    if lumi_history_loading {
        access := LumiRowAccessNow()
        for index: cast(s32)1..lumi_history_added_rows {
            lumi_ui.scroll += LumiMeasuredRow(index, access).height
        }
        lumi_history_loading = false
    } else if lumi_ui.follow_end && history_measured {
        lumi_ui.scroll = 1000000
    }
    column_width := CenteredColumnFor(lumi_ui.width, AppScale(720), AppScale(16)).width
    draft_width := column_width - AppScale(112)
    if lumi_ui.value != AppTextFromCString(*lumi_draft[0], LUMI_INPUT_MAX) ||
    draft_width != lumi_draft_width || lumi_ui.font != lumi_draft_font || assets != lumi_draft_assets ||
    language != AppTextFromCString(*lumi_draft_language[0], 32) {
        unused AppCopyText(lumi_ui.value, lumi_draft[:])
        lumi_draft_width = draft_width
        lumi_draft_font = lumi_ui.font
        lumi_draft_assets = assets
        unused AppCopyText(language, lumi_draft_language[:])
        draft := PrepareText(TextProps.{.text = lumi_ui.value, .font = lumi_ui.font,
                .wrap = cast(TextWrap)TextWrapAuto,
                .bounds = Rectangle.{0.0, 0.0, cast(float32)draft_width, 0.0}},
            DefaultTextFace())
        lumi_draft_height = cast(s32)draft.bounds.height
    }
    lumi_ui.draft_height = lumi_draft_height
    if lumi_agreement_due {
        lumi_agreement_due = false
        if LumiAgreementPromptWanted() {
            lumi_agreement_prompted = true
            lumi_ui.agreement = 1
        }
    }
    // The terms wrap clear of their scroll bar, as Lumi's view draws them.
    LumiAgreementPrepare(column_width - AppScale(24))
    typed: [512]u8
    lumi_ui.input = SampleTextAreaInput(lumi_ui.focused, typed[:])
    enter := lumi_ui.input.enter || lumi_ui.input.commit
    lumi_ui.input.enter = enter && lumi_ui.input.shift
    lumi_ui.input.commit = enter && !lumi_ui.input.shift
    lumi_pending_route = -1
    lumi_pending_practice = -1
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    CellsUiBegin(LumiUiCall, cast(*void)app)
    response := LumiRun(LumiMessage.{.action = LUMI_FRAME})
    CellsUiEnd()
    WidgetHostEnd()
    if lumi_pending_practice >= 0 && !app_start_practice(app, lumi_pending_practice) {
        LumiStoreAppend(LocaleText("lumi_unavailable"), false)
    }
    if response.succeeded && response.action == LUMI_SEND && !LumiStoreSave() {
        LumiStoreAppend(LocaleText("results_write_failed"), false)
    }
    if lumi_pending_route >= 0 {
        app_apply_nav_route(app, lumi_pending_route)
    }
}

#program_export
app_lumi_session_result :: (app: *InnerBreeze) {
    if app == null || app.lumi_practice == 0 { return }
    app.lumi_practice = 0
    result := app.session_result
    out: Vec(u8)
    BuilderPrint(*out, "%\n", LocaleText("lumi_session_complete"))
    if result.round_count > 0 {
        BuilderPrint(*out, "%: %\n", LocaleText("lumi_session_rounds"), result.round_count)
        for index: cast(s32)0..result.round_count - 1 {
            BuilderPrint(*out, "%: % %\n", index + 1, result.round_values[index], LocaleText("lumi_session_seconds"))
        }
    } else {
        BuilderPrint(*out, "% %", result.primary_value,
            LocaleText(ifx result.activity == EXERCISE_SUN_SALUTATION then "lumi_session_repetitions" else "lumi_session_seconds"))
        if result.secondary_value > 0 { BuilderPrint(*out, " · % %", result.secondary_value, LocaleText("lumi_session_cycles")) }
        BuilderPrint(*out, "\n")
    }
    BuilderPrint(*out, "%", LocaleText(ifx result.saved != 0 then "results_saved_status" else "results_unsaved_status"))
    text := BuilderFinish(out)
    LumiOnlineAppend(text)
    PackageFree(text)
    unused LumiStoreSave()
    if result.saved != 0 { app.ui.sync_requested = true }
    app.session_result = SessionResult.{}
    app_apply_nav_route(app, APP_NAV_ROUTE_LUMI)
}
