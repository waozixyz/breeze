#import, file "../habits/habit_calendar.zi";

// Gregorian civil-day arithmetic keeps chart buckets stable across DST changes.
statistics_day_number :: (day_index: s32) -> s64 {
    year: s64 = day_index / 10000
    month: s64 = (day_index / 100) % 100
    day: s64 = day_index % 100
    if year < 1 || year > 9999 || month < 1 || month > 12 ||
        day < 1 || day > cast(s64)habit_days_in_month(cast(s32)year,
            cast(s32)month) { return -1 }
    if month <= 2 { year -= 1 }
    era := year / 400
    year_of_era := year - era * 400
    month_prime := month - 3
    if month <= 2 { month_prime = month + 9 }
    day_of_year := (153 * month_prime + 2) / 5 + day - 1
    year_of_era_day := year_of_era * 365 + year_of_era / 4 -
        year_of_era / 100 + day_of_year
    return era * 146097 + year_of_era_day
}

statistics_day_offset_from_today :: (day_index: s32,
    today_index: s32) -> s32 {
    today := statistics_day_number(today_index)
    target := statistics_day_number(day_index)
    if today < 0 || target < 0 || target > today || today - target > 30 {
        return -1
    }
    return cast(s32)(today - target)
}

