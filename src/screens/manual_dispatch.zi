#import, file "../app/app_types.zi";
#import, file "../app/exercise_types.zi";
#import, file "../practices/meditation/meditation_manual.zi";
#import, file "../practices/sun_salutation/sun_salutation_manual.zi";
#import, file "../practices/patterns/patterns_manual.zi";
#import, file "../practices/whm/whm_manual.zi";

using ExerciseType;

manual_screen_close_tutorial :: (app: *InnerBreeze, mark_seen: s32) {
    if app == null {
        return
    }
    id: s32 = practice_clamp_id(app.exercise_type)
    if id == EXERCISE_MEDITATION {
        meditation_manual_close(app, mark_seen)
    } else if id == EXERCISE_SUN_SALUTATION {
        sun_manual_close(app, mark_seen)
    } else if id == EXERCISE_PATTERNS {
        patterns_manual_close(app, mark_seen)
    } else {
        whm_manual_close(app, mark_seen)
    }
}

manual_screen_draw :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    id: s32 = practice_clamp_id(app.exercise_type)
    if id == EXERCISE_MEDITATION {
        meditation_manual_draw(app)
    } else if id == EXERCISE_SUN_SALUTATION {
        sun_manual_draw(app)
    } else if id == EXERCISE_PATTERNS {
        patterns_manual_draw(app)
    } else {
        whm_manual_draw(app)
    }
}

manual :: (app: *InnerBreeze) {
    manual_screen_draw(app)
}
