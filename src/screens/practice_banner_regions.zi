#import "std/math"

// Feathered ellipses in the painted artwork, in 0..100 coordinates from
// the top left of each source. The title fade and the subjects stay still.
PracticeBannerPatch :: struct {
    x: float64
    y: float64
    radius_x: float64
    radius_y: float64
}

PracticeBannerClouds :: struct {
    offset_x: float64
    offset_y: float64
    width_scale: float64
    height_scale: float64
    threshold: float64
    opacity: float64
}

PracticeBannerLook :: struct {
    zenith: u32
    horizon: u32
    cloud_light: u32
    cloud_shadow: u32
    water: u32
    light_x: float64
    light_y: float64
    waterline: float64
    hour: float64
    clouds: PracticeBannerClouds
    disc: float64
}

PracticeBannerPlume :: struct {
    x: float64
    y: float64
    height: float64
    width: float64
    drift: float64
    curl: float64
}

PracticeBannerRegions :: struct {
    sky: [3]PracticeBannerPatch
    water: [3]PracticeBannerPatch
    look: PracticeBannerLook
    steam: [3]PracticeBannerPlume
    steam_color: u32
    steam_opacity: float64
    full_sky: bool
    artwork_sky: bool
}

PracticeBannerRegionsFor :: (asset: string, artwork_sky: bool = false) -> PracticeBannerRegions {
    if artwork_sky {
        // Both original paintings place the ice bath in the same source coordinates.
        night := asset == "assets/practices/whm/banner-dark.webp"
        steam: [3]PracticeBannerPlume = .[.{47.2, 65, 24, 2.5, -2, 1.0},
            .{50.5, 64.5, 27, 2.9, 0.5, 1.1}, .{53.8, 64, 21, 2.4, 1.8, 1.0}]
        steam_color: u32 = ifx night then 0xb6d6ed else 0xe4f3f6
        return .{.steam = steam, .steam_color = steam_color, .steam_opacity = 0.72,
            .artwork_sky = true}
    }
    if asset == "assets/practices/whm/banner-light.webp" {
        sky: [3]PracticeBannerPatch = .[.{56, 9, 45, 23}, .{76, 28, 16, 9}, .{}]
        water: [3]PracticeBannerPatch = .[.{20, 55, 11, 10}, .{80, 53, 16, 13}, .{}]
        steam: [3]PracticeBannerPlume = .[.{36, 49, 19, 3.0, -4, 1.6},
            .{56, 49, 20, 2.9, 0.5, 1.2}, .{63, 50, 18, 2.9, -1.5, 1.4}]
        return .{sky, water, .{0x78addc, 0xf5d9b7, 0xffebca, 0xa2aec3, 0x267b8b, 0.69, 0.29, 0.56, 8.2, .{0.09, 0.72, 1.12, 0.34, 0.10, 0.48}, 0.018},
            steam, 0xe4f3f6, 0.82, false, false}
    }
    if asset == "assets/practices/whm/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{52, 8, 25, 20}, .{67, 25, 23, 13}, .{87, 10, 13, 17}]
        water: [3]PracticeBannerPatch = .[.{24, 55, 13, 12}, .{72, 49, 13, 8}, .{}]
        steam: [3]PracticeBannerPlume = .[.{43, 50, 23, 2.8, -1, 1.8},
            .{51, 36, 16, 2.5, 2, 1.6}, .{54, 51, 22, 2.8, 2.5, 1.6}]
        return .{sky, water, .{0x0a1b41, 0x274774, 0x6582aa, 0x243b68, 0x0d314d, 0.23, 0.13, 0.55, 23.0, .{0.20, 0.60, 0.84, 0.65, 0.17, 0.30}, 0.023},
            steam, 0xb6d6ed, 0.81, false, false}
    }
    if asset == "assets/practices/patterns/banner-light.webp" {
        sky: [3]PracticeBannerPatch = .[.{14, 32, 19, 24}, .{85, 31, 17, 21}, .{49, 5, 55, 16}]
        water: [3]PracticeBannerPatch = .[.{29, 73, 7, 4}, .{73, 73, 13, 6}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x78b4d9, 0xe5e7c7, 0xffeeb6, 0xb9bac8, 0x7bb3ab, 0.79, 0.25, 0.47, 11.0, .{0.67, 0.10, 1.83, 0.47, 0.10, 0.65}, 0.016}}
    }
    if asset == "assets/practices/patterns/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{13, 32, 15, 20}, .{85, 31, 17, 22}, .{49, 4, 53, 21}]
        water: [3]PracticeBannerPatch = .[.{29, 76, 9, 3}, .{69, 77, 8, 4}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x262052, 0x925082, 0xad7a9f, 0x4b3867, 0x373657, 0.75, 0.47, 0.45, 18.8, .{0.19, 0.25, 1.33, 0.73, 0.13, 0.52}, 0.023}}
    }
    if asset == "assets/practices/meditation/banner-light.webp" {
