        water: [3]PracticeBannerPatch = .[.{23, 59, 18, 12}, .{78, 59, 15, 14}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x0a2549, 0x34577e, 0x7194b3, 0x223a62, 0x1b4a68, 0.27, 0.13, 0.53, 22.4, .{0.52, 0.79, 0.92, 0.46, 0.21, 0.26}, 0.017}}
