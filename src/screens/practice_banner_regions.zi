        water: [3]PracticeBannerPatch = .[.{27, 60, 14, 11}, .{81, 60, 14, 9}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x90b9e1, 0xffe3cc, 0xfff4e6, 0xbcc5db, 0x7fb7cf, 0.64, 0.32, 0.54, 9.7, .{0.39, 0.03, 0.79, 0.62, 0.08, 0.58}, 0.021}}
