        water: [3]PracticeBannerPatch = .[.{27, 62, 9, 5}, .{69, 68, 15, 8}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x586893, 0xf89977, 0xfdd2b8, 0x8e779c, 0x46526e, 0.63, 0.32, 0.48, 17.9, .{0.47, 0.65, 1.26, 1.10, 0.08, 0.69}, 0.033}}
    }
    if asset == "assets/practices/astral_projection/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{40, 13, 29, 18}, .{64, 29, 18, 11}, .{68, 4, 17, 9}]
        water: [3]PracticeBannerPatch = .[.{28, 62, 9, 5}, .{66, 66, 11, 7}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x0a2549, 0x2c4f79, 0x6c8eae, 0x233c60, 0x123b58, 0.72, 0.13, 0.48, 23.1, .{0.72, 0.52, 1.94, 0.58, 0.14, 0.41}, 0.015}}
    }
    if asset == "assets/practices/sunsalutation/banner-light.webp" {
        sky: [3]PracticeBannerPatch = .[.{21, 12, 22, 18}, .{50, 12, 29, 18}, .{88, 12, 17, 17}]
        return .{.sky = sky, .look = .{0xc4b1b1, 0xffd997, 0xffeed0, 0xe0baac, 0, 0.72, 0.34, 0.52, 7.0, .{0.34, 0.47, 1.10, 0.32, 0.16, 0.49}, 0.039}}
    }
    if asset == "assets/practices/sunsalutation/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{22, 14, 24, 21}, .{50, 12, 24, 17}, .{86, 16, 18, 21}]
        return .{.sky = sky, .look = .{0x281d53, 0xbb6682, 0xd68ca4, 0x5e4579, 0, 0.72, 0.47, 0.53, 18.7, .{0.11, 0.36, 0.95, 0.67, 0.09, 0.57}, 0.031}}
