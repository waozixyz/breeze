        return .{.sky = sky, .look = .{0x5992c7, 0xd6e5ec, 0xfff2d5, 0xb1bcd1, 0, 0.66, 0.21, 0.55, 12.5, .{0.81, 0.29, 1.85, 0.51, 0.10, 0.83}, 0.015}}
    }
    if asset == "assets/practices/taichi/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{52, 7, 17, 10}, .{77, 8, 15, 10}, .{}]
        return .{.sky = sky, .look = .{0x171c58, 0x424485, 0x8589b4, 0x3a3e75, 0, 0.66, 0.22, 0.55, 22.2, .{0.54, 0.18, 1.83, 0.29, 0.13, 0.35}, 0.022}}
    }
    if asset == "assets/practices/workout/banner-short-light.webp" {
        return .{.look = .{0x86b1cd, 0xffe1b5, 0xffedcc, 0xb6acb8, 0x7e9a95, 0.25, 0.28, 0.51, 8.7,
            .{0.29, 0.88, 0.91, 0.48, 0.11, 0.55}, 0.028}}
    }
    if asset == "assets/practices/workout/banner-short-dark.webp" {
        return .{.look = .{0x192741, 0x526b76, 0x839eb0, 0x384a61, 0x254b57, 0.31, 0.18, 0.51, 21.0,
            .{0.44, 0.43, 1.11, 0.66, 0.16, 0.44}, 0.024}}
    }
    if asset == "assets/practices/workout/banner-light.webp" {
        sky: [3]PracticeBannerPatch = .[.{27, 12, 18, 16}, .{68, 13, 24, 16}, .{52, 3, 22, 13}]
        water: [3]PracticeBannerPatch = .[.{68, 60, 8, 8}, .{81, 73, 12, 9}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x5c9dcc, 0xd5e9e6, 0xffefd2, 0xb5c2d4, 0x4c9dc0, 0.75, 0.23, 0.50, 11.2, .{0.06, 0.54, 1.62, 0.87, 0.12, 0.76}, 0.018}}
    }
    if asset == "assets/practices/workout/banner-dark.webp" {
        sky: [3]PracticeBannerPatch = .[.{34, 18, 13, 12}, .{65, 14, 12, 13}, .{52, 4, 22, 11}]
        water: [3]PracticeBannerPatch = .[.{65, 55, 11, 8}, .{79, 59, 10, 7}, .{}]
        return .{.sky = sky, .water = water, .look = .{0x0d264e, 0x3d5b82, 0x7696b9, 0x253e64, 0x214c6b, 0.80, 0.14, 0.50, 22.7, .{0.91, 0.62, 1.52, 0.87, 0.14, 0.32}, 0.019}}
    }
    return .{}
}

PRACTICE_BANNER_MASK_WIDTH :: 192
PRACTICE_BANNER_MASK_HEIGHT :: 96

PracticeBannerMask :: (regions: PracticeBannerRegions, pixels: []u8) {
    for row: 0..PRACTICE_BANNER_MASK_HEIGHT - 1 {
        y := (cast(float64)row + 0.5) * 100.0 / PRACTICE_BANNER_MASK_HEIGHT
        for column: 0..PRACTICE_BANNER_MASK_WIDTH - 1 {
            x := (cast(float64)column + 0.5) * 100.0 / PRACTICE_BANNER_MASK_WIDTH
            at := (row * PRACTICE_BANNER_MASK_WIDTH + column) * 4
            pixels[at] = ifx regions.full_sky then 255 else practice_banner_coverage(regions.sky[:], x, y)
            pixels[at + 1] = ifx regions.full_sky then 0 else practice_banner_coverage(regions.water[:], x, y)
            steam: u8
            if regions.steam_opacity > 0.0 {
                steam = practice_banner_steam_coverage(regions.steam[:], x, y)
            }
            pixels[at + 2] = steam
            pixels[at + 3] = 255
        }
    }
}

#scope_file
practice_banner_steam_coverage :: (plumes: []PracticeBannerPlume, x: float64, y: float64) -> u8 {
    coverage: float64
    for plume: plumes {
        rise := (plume.y - y) / plume.height
        if rise <= 0.0 || rise >= 1.0 {
            continue
        }
        center := plume.x + plume.drift * rise + plume.curl * Sin(rise * 10.0)
        offset := (x - center) / (plume.width * (0.45 + 0.65 * rise))
        across := 1.0 - offset * offset
        if across > 0.0 {
            start := rise * 6.0
            along := (ifx start < 1.0 then start else 1.0) * (1.0 - rise)
            plume_coverage := across * across * along
            if plume_coverage > coverage {
                coverage = plume_coverage
            }
        }
    }
    return cast(u8)(coverage * 255.0 + 0.5)
}

#scope_file
practice_banner_coverage :: (patches: []PracticeBannerPatch, x: float64, y: float64) -> u8 {
    coverage: float64
    for patch: patches {
        if patch.radius_x <= 0.0 || patch.radius_y <= 0.0 {
            continue
        }
        dx := (x - patch.x) / patch.radius_x
        dy := (y - patch.y) / patch.radius_y
        t := (1.0 - dx * dx - dy * dy) * 1.8
        if t > coverage {
            coverage = ifx t < 1.0 then t else 1.0
        }
    }
    return cast(u8)(255.0 * coverage * coverage * (3.0 - 2.0 * coverage) + 0.5)
}
