// First run asks one question: download voice guidance or not. Settings and
// each practice keep the voice controls for later changes.
#import "button_props"
#import "button_widget"
#import "control_props"
#import "geometry"
#import "layout"
#import "text_buffer"
#import "text_props"
#import "text_widget"
#import, file "../app/app_types.zi";
#import, file "../app/audio_setup.zi";
#import, file "../app/locale.zi";
#import, file "../app/metrics.zi";
#import, file "../app/text_buffers.zi";

using ButtonTone;
using ButtonEmphasis;
using TextWrap;

AudioSetupSizeText :: (bytes: s64, buffer: []u8) -> string {
    amount := cast(s32)((bytes + 1023) / 1024)
    format := "practice_size_kb"
    if bytes >= 1024 * 1024 {
        amount = cast(s32)((bytes + 512 * 1024) / (1024 * 1024))
        format = "practice_size_mb"
    }
    args: [1]FormatArg = .[FormatArg.{.number = amount}]
    unused FormatTemplate(LocaleText(format), args[:], buffer)
    return TextUntilNul(buffer)
}

// One line of text centered across the screen at this height.
AudioSetupLine :: (app: *InnerBreeze, text: string, font: s32, y: s32) {
    width := AppTextWidth(text, font)
    Text(app.ui.session, TextProps.{.text = text, .font = font,
            .bounds = Rectangle.{cast(float32)((app.ui.view_width - width) / 2),
                cast(float32)y, cast(float32)width, cast(float32)AppTextLineHeight(font)},
            .wrap = cast(TextWrap)TextWrapNone})
}

AudioSetupScreen :: (app: *InnerBreeze) {
    column := CenteredColumnFor(app.ui.view_width, AppScale(380), AppScale(16))
    gap := AppScale(12)
    button_height := AppScale(48)
    title := LocaleText("optional_audio_title")
    title_font := AppTitleFontSize(title, column.width)
    size_buffer: [64]u8
    size := AudioSetupSizeText(AudioSetupBytes(), size_buffer[:])
    content_height := AppTextLineHeight(title_font) + AppTextLineHeight(AppSmallFontSize()) +
        button_height * 2 + gap * 4
    y := (app.ui.view_height - content_height) / 2
    if y < AppScale(16) {
        y = AppScale(16)
    }

    AudioSetupLine(app, title, title_font, y)
    y += AppTextLineHeight(title_font) + gap
    AudioSetupLine(app, size, AppSmallFontSize(), y)
    y += AppTextLineHeight(AppSmallFontSize()) + gap * 2

    if Button(app.ui.session, ButtonProps.{.id = 264,
            .bounds = Rectangle.{cast(float32)column.x, cast(float32)y,
                cast(float32)column.width, cast(float32)button_height},
            .label = LocaleText("practice_narration_download"),
            .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
        AudioSetupFinish(app, true)
        return
    }
    y += button_height + gap
    if Button(app.ui.session, ButtonProps.{.id = 265,
            .bounds = Rectangle.{cast(float32)column.x, cast(float32)y,
                cast(float32)column.width, cast(float32)button_height},
            .label = LocaleText("optional_audio_skip"),
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        AudioSetupFinish(app, false)
    }
}
