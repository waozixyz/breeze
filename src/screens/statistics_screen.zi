c3 :: #system_library "c";
app_content_bottom_reserved :: (app: *InnerBreeze) -> s32 #foreign c3;
habit_cached_linked_entries :: (app: *InnerBreeze,
    habit_index: s32, day_filter: s32) -> *HabitLinkedContext #foreign c3;
// A habit's statistics. Habits draws them (apps/habits/habit_stats_view.zi);
// this host counts the figures from the habit's days, its linked sessions,
// their moods and its entries, keeps them cached until the stored data
// changes, and gives them to the page on request.
