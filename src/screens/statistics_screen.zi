using ExerciseType;
using HabitSyncMode;
using HostValueKind;

statistics_mood_cache: StorageMoodStats = StorageMoodStats.{};
statistics_mood_cache_clock: s64 = 0;
statistics_mood_cache_activity: s32 = 0;
statistics_mood_cache_days: s32 = -1;
statistics_mood_cache_count: s32 = 0;
statistics_mood_cache_valid: s32 = 0;

statistics_cached_mood_stats :: (activity_mask: s32, days: s32,
    stats: *StorageMoodStats) -> s32 {
    session_clock := storage_session_change_clock()

    if stats == null || activity_mask == 0 {
        return 0
    }
    if statistics_mood_cache_valid != 0  && statistics_mood_cache_clock == session_clock  && statistics_mood_cache_activity == activity_mask  && statistics_mood_cache_days == days {
        stats.* = statistics_mood_cache
        return statistics_mood_cache_count
    }

    statistics_mood_cache_count = storage_mood_stats(activity_mask, days,
        *statistics_mood_cache)
    statistics_mood_cache_clock = session_clock
    statistics_mood_cache_activity = activity_mask
    statistics_mood_cache_days = days
    statistics_mood_cache_valid = 1
    stats.* = statistics_mood_cache
    return statistics_mood_cache_count
}

statistics_day_count :: (habit: *Habit, linked_ctx: *HabitLinkedContext, day_index: s32) -> s32 {
    count := HabitEffectiveDayCount(habit, day_index, linked_ctx)

    if count > 0 {
        return count
    }
    return ifx (habit_completed_day(habit, day_index) != 0 || HabitLinkedHasDay(linked_ctx, day_index)) then (1) else (0)
}

statistics_day_of_week :: (day_index: s32) -> s32 {
    weekday := habit_weekday_bit(day_index)
    if weekday < 0 { return -1 }
    return (weekday + 1) % 7
}

// ---- What a habit's entries add up to ------------------------------------

statistics_answers: [HABIT_QUESTION_MAX]HabitAnswerStats;
statistics_answers_count: s32;
// A span habit's lengths, starts and ends.
statistics_spans: [3]HabitAnswerStats;
statistics_answers_revision: s64 = -1;
statistics_answers_today: s32;
statistics_answers_habit: [HABIT_ID_SIZE]u8;
// Each chart's point labels, written when the statistics are read: the
// spans' lengths first, then each question's.
STATISTICS_LABEL_SIZE :: 112
statistics_labels: [HABIT_QUESTION_MAX + 1][HABIT_ANSWER_POINT_MAX][STATISTICS_LABEL_SIZE]u8;
// The habit's latest changes, newest first.
STATISTICS_CHANGE_MAX :: 12
statistics_changes: [STATISTICS_CHANGE_MAX]HabitChangeRecord;
statistics_changes_count: s32;
// Each change as its line reads.
STATISTICS_CHANGE_LINE_SIZE :: 320
statistics_change_lines: [STATISTICS_CHANGE_MAX][STATISTICS_CHANGE_LINE_SIZE]u8;

// The last days up to today, oldest first.
statistics_last_days :: (today_index: s32, days: []s32) {
    year := today_index / 10000
    month := (today_index / 100) % 100
    day := today_index % 100
    slot := cast(s32)days.count - 1
    while slot >= 0 {
        days[slot] = year * 10000 + month * 100 + day
        day -= 1
        if day == 0 {
            month -= 1
            if month == 0 {
                year -= 1
                month = 12
            }
            day = habit_days_in_month(year, month)
        }
        slot -= 1
    }
}

statistics_today_index :: () -> s32 {
    local := LocalNow()
    if !local.valid { return 0 }
    return local.year * 10000 + local.month * 100 + local.day
}

// The habit's entry statistics, read again when its data or the day changes.
statistics_answer_stats :: (active: *Habit) -> s32 {
    today := statistics_today_index()
    habit_id := AppTextFromCString(*active.id[0], HABIT_ID_SIZE)
    revision := storage_data_revision()
    if revision == statistics_answers_revision &&
    today == statistics_answers_today &&
    AppTextFromCString(*statistics_answers_habit[0], HABIT_ID_SIZE) == habit_id &&
    statistics_answers_count == active.question_count {
        return statistics_answers_count
    }
    statistics_answers_revision = revision
    statistics_answers_today = today
    unused AppCopyText(habit_id, statistics_answers_habit[:])
    days: [HABIT_ANSWER_STATS_DAYS]s32
    statistics_last_days(today, days[:])
    statistics_answers_count = 0
    while statistics_answers_count < active.question_count {
        unused storage_habit_answer_stats(habit_id,
            *active.questions[statistics_answers_count], days[:],
            *statistics_answers[statistics_answers_count])
        statistics_label_points(*statistics_answers[statistics_answers_count],
            days[:], statistics_answers_count + 1)
        statistics_answers_count += 1
    }
    unused storage_habit_span_stats(active, days[:], *statistics_spans[0],
        *statistics_spans[1], *statistics_spans[2])
    statistics_label_points(*statistics_spans[0], days[:], 0)
    statistics_changes_count = storage_habit_changes_load(habit_id,
        statistics_changes[:])
    change: s32 = 0
    while change < statistics_changes_count {
        unused HabitChangeDescribe(*statistics_changes[change].change,
            statistics_change_lines[change][:])
        change += 1
    }
    return statistics_answers_count
}

// Each point's label: its day, its value, and whether it met the goal it
// had then, as "2026-10-12 · 07:40 · on target: Before 08:00".
statistics_label_points :: (stats: *HabitAnswerStats, days: []s32,
    chart: s32) {
    index: s32 = 0
    while index < stats.point_count {
        point := *stats.points[index]
        date: [16]u8
        date_args: [3]FormatArg
        day := days[point.slot]
        date_args[0].number = day / 10000
        date_args[1].number = (day / 100) % 100
        date_args[2].number = day % 100
        unused FormatTemplate("%04d-%02d-%02d", date_args[:], date[:])
        value: [24]u8
        goal: [96]u8
        verdict: [112]u8
        args: [3]FormatArg
        args[0].text = AppTextFromCString(*date[0], 16)
        args[0].is_text = true
        args[1].text = HabitStatsValueText(stats.answer_type, point.value, value[:])
        args[1].is_text = true
        template := "%s · %s"
        used: s32 = 2
        if point.good >= 0 {
            verdict_args: [1]FormatArg
            verdict_args[0].text = HabitGoalDescribe(point.goal, stats.answer_type,
                point.benchmark, goal[:])
            verdict_args[0].is_text = true
            unused FormatTemplate(LocaleText(ifx point.good == 1
                then "habit_stats_point_on_target" else "habit_stats_point_off_target"),
                verdict_args[:], verdict[:])
            args[2].text = AppTextFromCString(*verdict[0], 112)
            args[2].is_text = true
            template = "%s · %s · %s"
            used = 3
        }
        unused FormatTemplate(template, args[:used], statistics_labels[chart][index][:])
        index += 1
    }
}

// A span habit's start and end questions are its span's times: its
// statistics are about the span's length, so they get no charts of their own.
statistics_answer_shown :: (active: *Habit, index: s32) -> bool {
    return HabitSpanQuestionRole(active.questions[:], active.question_count,
        active.span != 0, index) == 0
}

// ---- The page, which Habits draws ---------------------------------------------

STATISTICS_HOLD_MAX :: 256
STATISTICS_HOLD_DAYS :: 31

habit_stats_frame: HabitsStatsFrame;
habit_stats_frame_codec: WidgetHabitsStatsFrameCodec;
habit_stats_chart_codec: WidgetHabitsStatsChartCodec;
habit_stats_point_codec: WidgetHabitsStatsPointCodec;
habit_stats_recent_codec: WidgetHabitsStatsRecentCodec;
habit_stats_hold_codec: WidgetHabitsStatsHoldCodec;
habit_stats_change_codec: WidgetHabitsStatsChangeCodec;
// The habit the page shows while it draws.
habit_stats_habit: *Habit;
habit_stats_holds: [STATISTICS_HOLD_MAX]HabitsStatsHold;
habit_stats_hold_count: s32;

// Each Wim Hof round of the last 31 days, and whether the habit has any at
// all.
habit_stats_collect_holds :: (linked: *HabitLinkedContext, today: s32) -> bool {
    habit_stats_hold_count = 0
    any := false
    if linked == null {
        return false
    }
    index: s32 = 0
    while index < linked.count {
        entry := *linked.entries[index]
        if entry.activity == EXERCISE_WIM_HOF && entry.round_count > 0 {
            any = true
            days_ago := statistics_day_offset_from_today(
                entry.year * 10000 + entry.month * 100 + entry.day, today)
            round: s32 = 0
            while days_ago >= 0 && days_ago < STATISTICS_HOLD_DAYS && round < entry.round_count &&
            habit_stats_hold_count < STATISTICS_HOLD_MAX {
                habit_stats_holds[habit_stats_hold_count] = HabitsStatsHold.{
                    .days_ago = days_ago,
                    .time = entry.hour * 3600 + entry.minute * 60 + entry.second,
                    .round = round, .seconds = entry.rounds[round]}
                habit_stats_hold_count += 1
                round += 1
            }
        }
        index += 1
    }
    return any
}

// The page's frame: the figures counted over the habit's last year.
habit_stats_frame_for :: (app: *InnerBreeze, index: s32) -> HabitsStatsFrame {
    active := *app.habits.items[index]
    linked := habit_cached_linked_entries(app, index, 0)
    card := CardProps(Rectangle.{})
    frame := HabitsStatsFrame.{
        .session = app.ui.session, .scale = MetricsScale(), .view_width = app.ui.view_width,
        .view_height = app.ui.view_height, .bottom = app_content_bottom_reserved(app),
        .font = AppFontSize(), .small_font = AppSmallFontSize(),
        .text_color = StyleTokenColor("text"), .canvas_color = StyleTokenColor("canvas"),
        .card_fill = card.fill, .card_border = card.border, .muted_class = MutedTextClass(),
        .modal_active = app.modal.active != 0,
        .name = AppTextFromCString(*active.name[0], HABIT_NAME_SIZE), .color = active.color,
        .scroll = app.habits.scroll, .span = active.span != 0,
        .question_count = active.question_count, .span_start_average = -1,
        .span_end_average = -1}
    local := LocalNow()
    if !local.valid {
        return frame
    }
    year := local.year
    month := local.month
    day := local.day
    today := year * 10000 + month * 100 + day
    weekdays: [7]s32
    running: s32 = 0
    current: s32 = 0
    day_number: s32 = 0
    while day_number < 365 {
        day_index := year * 10000 + month * 100 + day
        count := statistics_day_count(active, linked, day_index)
        scheduled := habit_scheduled_day(active, day_index) != 0
        if day_number < 30 && count > 0 {
            frame.last_30_done += 1
        }
        if day_number < 56 && count > 0 {
            weekday := statistics_day_of_week(day_index)
            if weekday >= 0 && weekday < 7 {
                weekdays[weekday] += 1
            }
        }
        if count > 0 {
            running += 1
            if running > frame.best_streak {
                frame.best_streak = running
            }
            if day_number == current {
                current += 1
            }
        } else if !scheduled {
            // Days off the schedule neither extend nor break a streak.
            if day_number == current {
                current += 1
            }
        } else {
            running = 0
        }
        day -= 1
        if day == 0 {
            month -= 1
            if month == 0 {
                year -= 1
                month = 12
            }
            day = habit_days_in_month(year, month)
        }
        day_number += 1
    }
    frame.current_streak = current
    frame.sunday = weekdays[0]
    frame.monday = weekdays[1]
    frame.tuesday = weekdays[2]
    frame.wednesday = weekdays[3]
    frame.thursday = weekdays[4]
    frame.friday = weekdays[5]
    frame.saturday = weekdays[6]
    if linked != null && linked.count > 0 {
        best: [32]u8
        total: [32]u8
        habit_format_duration(linked.best_seconds, *best[0], size_of(type_of(best)))
        habit_format_duration(linked.total_seconds, *total[0], size_of(type_of(total)))
        frame.linked = true
        frame.best_time = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*best[0], 32))
        frame.total_time = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*total[0], 32))
    }
    if active.sync_mode == HABIT_SYNC_ACTIVITIES && active.sync_activity != 0 {
        mood: StorageMoodStats = .{}
        if statistics_cached_mood_stats(active.sync_activity, 0, *mood) > 0 && mood.total > 0 {
            frame.mood_total = mood.total
            frame.mood_average = mood.average
            frame.mood_1 = mood.counts[0]
            frame.mood_2 = mood.counts[1]
            frame.mood_3 = mood.counts[2]
            frame.mood_4 = mood.counts[3]
            frame.mood_5 = mood.counts[4]
        }
    }
    if habit_stats_collect_holds(linked, today) {
        frame.hold_count = habit_stats_hold_count
        frame.hold_days = ifx app.habits.hold_stats_range_days == 31 then 31 else 7
    }
    unused statistics_answer_stats(active)
    frame.change_count = statistics_changes_count
    if active.span != 0 && statistics_spans[1].point_count > 0 {
        frame.span_start_average = HabitAnswerStatsAverage100(*statistics_spans[1])
        frame.span_end_average = HabitAnswerStatsAverage100(*statistics_spans[2])
    }
    return frame
}

// A chart's figures: the span's lengths for chart 0, a question's for the
// question's index + 1.
habit_stats_chart_of :: (chart: s32) -> *HabitAnswerStats {
    active := habit_stats_habit
    if active == null || chart < 0 || chart > statistics_answers_count {
        return null
    }
    if chart == 0 {
        return ifx active.span != 0 then *statistics_spans[0] else null
    }
    return *statistics_answers[chart - 1]
}

habit_stats_chart :: (chart: s32) -> HabitsStatsChart {
    stats := habit_stats_chart_of(chart)
    if stats == null {
        return HabitsStatsChart.{}
    }
    active := habit_stats_habit
    value := HabitsStatsChart.{.answer_type = stats.answer_type, .shown = true,
        .point_count = stats.point_count, .lowest = stats.lowest, .highest = stats.highest,
        .sum = stats.sum, .average = HabitAnswerStatsAverage100(stats), .days = stats.days,
        .answered = stats.answered, .yes = stats.yes, .judged = stats.judged,
        .good = stats.good, .recent_count = stats.recent_count}
    if chart > 0 {
        value.title = HabitQuestionText(*active.questions[chart - 1])
        value.shown = statistics_answer_shown(active, chart - 1)
    }
    return value
}

HabitStatsCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*InnerBreeze)context
    if BandChartHostSupports(TextFromCString(module), TextFromCString(function)) {
        return BandChartHostCall(app.ui.session, module, function, arguments, count, result)
    }
    if TextFromCString(module) != "habit_stats_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadHabitsStatsHost" && count == 0 {
        result.* = WidgetEncodeHabitsStatsFrame(habit_stats_frame, *habit_stats_frame_codec)
        return 1
    }
    if name == "WriteHabitsStatsHost" && count == 1 && WidgetValidHabitsStatsFrame(arguments[0]) {
        observed := WidgetDecodeHabitsStatsFrame(arguments[0], *habit_stats_frame_codec)
        habit_stats_frame.scroll = observed.scroll
        habit_stats_frame.hold_days = observed.hold_days
        habit_stats_frame.action = observed.action
        return 1
    }
    if name == "ReadHabitsStatsChartHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        result.* = WidgetEncodeHabitsStatsChart(habit_stats_chart(cast(s32)arguments[0].integer),
            *habit_stats_chart_codec)
        return 1
    }
    if name == "ReadHabitsStatsPointHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        chart := cast(s32)arguments[0].integer
        index := cast(s32)arguments[1].integer
        stats := habit_stats_chart_of(chart)
        point: HabitsStatsPoint
        if stats != null && index >= 0 && index < stats.point_count {
            source := *stats.points[index]
            point = HabitsStatsPoint.{.slot = source.slot, .value = source.value,
                .good = source.good,
                .label = AppTextFromCString(*statistics_labels[chart][index][0], STATISTICS_LABEL_SIZE),
                .goal_kind = source.goal.kind, .goal_low = source.goal.low,
                .goal_high = source.goal.high, .benchmark = source.benchmark}
        }
        result.* = WidgetEncodeHabitsStatsPoint(point, *habit_stats_point_codec)
        return 1
    }
    if name == "ReadHabitsStatsRecentHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        stats := habit_stats_chart_of(cast(s32)arguments[0].integer)
        index := cast(s32)arguments[1].integer
        recent: HabitsStatsRecent
        if stats != null && index >= 0 && index < stats.recent_count {
            recent = HabitsStatsRecent.{.day = stats.recent_days[index],
                .text = AppTextFromCString(*stats.recent[index][0], HABIT_ANSWER_SIZE)}
        }
        result.* = WidgetEncodeHabitsStatsRecent(recent, *habit_stats_recent_codec)
        return 1
    }
    if name == "ReadHabitsStatsHoldHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        hold := HabitsStatsHold.{.days_ago = -1}
        if index >= 0 && index < habit_stats_hold_count {
            hold = habit_stats_holds[index]
        }
        result.* = WidgetEncodeHabitsStatsHold(hold, *habit_stats_hold_codec)
        return 1
    }
    if name == "ReadHabitsStatsChangeHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        change: HabitsStatsChange
        if index >= 0 && index < statistics_changes_count {
            record := *statistics_changes[index]
            day := storage_local_date_of(record.at)
            minutes := storage_local_minutes_of(record.at)
            date: [24]u8
            args: [5]FormatArg
            args[0].number = day / 10000
            args[1].number = (day / 100) % 100
            args[2].number = day % 100
            args[3].number = minutes / 60
            args[4].number = minutes % 60
            unused FormatTemplate("%04d-%02d-%02d %02d:%02d", args[:], date[:])
            change = HabitsStatsChange.{
                .when = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*date[0], 24)),
                .line = AppTextFromCString(*statistics_change_lines[index][0],
                    STATISTICS_CHANGE_LINE_SIZE)}
        }
        result.* = WidgetEncodeHabitsStatsChange(change, *habit_stats_change_codec)
        return 1
    }
    if name == "HabitsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// Has Habits draw the selected habit's statistics. Returns false when Back
// was pressed.
draw_statistics_page :: (app: *InnerBreeze) -> bool {
    if app == null || app.habits.count <= 0 {
        return true
    }
    index := app.habits.selected
    if index < 0 || index >= app.habits.count {
        index = 0
    }
    habit_stats_habit = *app.habits.items[index]
    habit_stats_frame = habit_stats_frame_for(app, index)
    habit_stats_frame.action = HABITS_STATS_NONE
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    CellsUiBegin(HabitStatsCall, cast(*void)app)
    drawn := HabitsRun(HabitsMessage.{.action = HABITS_STATS_VIEW})
    CellsUiEnd()
    WidgetHostEnd()
    scroll := habit_stats_frame.scroll
    hold_days := habit_stats_frame.hold_days
    action := habit_stats_frame.action
    habit_stats_frame = HabitsStatsFrame.{}
    habit_stats_habit = null
    if !drawn.succeeded {
        return true
    }
    app.habits.scroll = scroll
    if hold_days == 7 || hold_days == 31 {
        app.habits.hold_stats_range_days = hold_days
    }
    return action != HABITS_STATS_BACK
}
