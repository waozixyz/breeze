using ExerciseType;
using HostValueKind;
using TextAlign;
using TextWrap;

session_result_format_duration :: (seconds: s32, out: []u8) -> bool {
    if seconds < 0 {
        seconds = 0
    }
    if seconds >= 3600 {
        args: [2]FormatArg = .[
            FormatArg.{.number = seconds / 3600},
            FormatArg.{.number = (seconds % 3600) / 60}
        ]
        return FormatTemplate("%dh %02dm", args[:], out)
    } else if seconds >= 60 {
        args: [2]FormatArg = .[
            FormatArg.{.number = seconds / 60},
            FormatArg.{.number = seconds % 60}
        ]
        return FormatTemplate("%dm %02ds", args[:], out)
    } else {
        args: [1]FormatArg = .[FormatArg.{.number = seconds}]
        return FormatTemplate("%ds", args[:], out)
    }
}

session_result_format_number :: (key: string, value: s32, out: []u8) -> bool {
    args: [1]FormatArg = .[FormatArg.{.number = value}]
    return FormatTemplate(LocaleText(key), args[:], out)
}

session_result_format_text :: (key: string, value: string, out: []u8) -> bool {
    args: [1]FormatArg = .[FormatArg.{.text = value, .is_text = true}]
    return FormatTemplate(LocaleText(key), args[:], out)
}

session_result_round_stats :: (result: *SessionResult, best: *s32, avg: *s32) {
    total: s32 = 0
    best.* = 0
    avg.* = 0
    {
        i: s32 = 0
        while i < result.round_count {
            seconds := result.round_values[i]
            if seconds < 0 {
                seconds = 0
            }
            total += seconds
            if seconds > best.* {
                best.* = seconds
            }
            i += 1
        }

    }
    if result.round_count > 0 {
        avg.* = total / result.round_count
    }
}

// ---- The results screen, which Practices draws ----------------------------------

practice_results_frame: PracticeResultsFrame;
practice_results_frame_codec: WidgetPracticeResultsFrameCodec;
practice_results_round_codec: WidgetPracticeResultRoundCodec;

PracticeResultsCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*InnerBreeze)context
    if TextFromCString(module) != "results_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPracticeResultsHost" && count == 0 {
        result.* = WidgetEncodePracticeResultsFrame(practice_results_frame, *practice_results_frame_codec)
        return 1
    }
    if name == "WritePracticeResultsHost" && count == 1 && WidgetValidPracticeResultsFrame(arguments[0]) {
        observed := WidgetDecodePracticeResultsFrame(arguments[0], *practice_results_frame_codec)
        practice_results_frame.scroll = observed.scroll
        practice_results_frame.action = observed.action
        practice_results_frame.value = observed.value
        return 1
    }
    if name == "ReadPracticeResultRoundHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        round: PracticeResultRound
        if index >= 0 && index < app.session_result.round_count && index < MaxRounds {
            round.seconds = app.session_result.round_values[index]
        }
        result.* = WidgetEncodePracticeResultRound(round, *practice_results_round_codec)
        return 1
    }
    if name == "ResultsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

// Has Practices draw a finished practice's results and does what was asked
// there: keeps the mood, discards the session, or closes the results.
practice_draw_results :: (app: *InnerBreeze, center_x: s32, center_y: s32,
                          hover: *s32) {
    if app == null {
        return
    }
    result := *app.session_result
    if result.active == 0 {
        session_draw_results_screen(app, center_x, center_y, hover)
        return
    }
    round_count := result.round_count
    if round_count > MaxRounds {
        round_count = MaxRounds
    }
    practice_results_frame = PracticeResultsFrame.{.session = app.ui.session,
        .scale = MetricsScale(), .view_width = app.ui.view_width, .view_height = app.ui.view_height,
        .canvas_color = StyleTokenColor("canvas"), .surface_color = StyleTokenColor("surface"),
        .border_color = StyleTokenColor("border"), .link_color = StyleTokenColor("link"),
        .text_color = StyleTokenColor("text"), .center_x = center_x, .temporary = DataTemporary(),
        .activity = result.activity, .name = practice_label(result.activity),
        .primary = result.primary_value, .secondary = result.secondary_value,
        .detail = AppTextFromCString(*result.detail[0], 96), .saved = result.saved != 0,
        .write_failed = result.write_failed != 0, .mood = result.mood, .round_count = round_count,
        .scroll = app.results_scroll, .habit_offer = result.habit_offer}
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(PracticeResultsCall, cast(*void)app)
    drawn := PracticeRun(PracticeMessage.{.action = PRACTICE_RESULTS_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    frame := practice_results_frame
    if !drawn.succeeded {
        return
    }
    app.results_scroll = frame.scroll
    if frame.action == PRACTICE_RESULTS_MOOD && frame.value >= 1 && frame.value <= 5 {
        app.session_result.mood = frame.value
    } else if frame.action == PRACTICE_RESULTS_DISCARD && result.saved != 0 {
        session_result_discard(app)
    } else if frame.action == PRACTICE_RESULTS_DONE {
        session_result_done(app)
    } else if frame.action == PRACTICE_RESULTS_ADD_HABIT &&
    result.habit_offer == PRACTICE_HABIT_OFFER_ASK {
        if habits_add_for_practice(*app.habits, result.activity, practice_label(result.activity)) >= 0 {
            result.habit_offer = PRACTICE_HABIT_OFFER_ADDED
        }
    } else if frame.action == PRACTICE_RESULTS_SKIP_HABIT {
        result.habit_offer = PRACTICE_HABIT_OFFER_NONE
    }
}

// The lines a finished practice's floating window shows: the results its
// results screen leads with, as many as fit a small window.
session_result_window_lines :: (result: *SessionResult, first: []u8,
    second: []u8) -> s32 {
    if result.activity == EXERCISE_WIM_HOF {
        unused session_result_format_number("results_rounds",
            result.round_count, first)
        if result.round_count <= 0 {
            return 1
        }
        best: s32 = 0
        average: s32 = 0
        session_result_round_stats(result, *best, *average)
        unused session_result_format_number("results_best", best, second)
        return 2
    }
    if result.activity == EXERCISE_SUN_SALUTATION {
        unused session_result_format_number("results_repetitions",
            result.primary_value, first)
        return 1
    }
    duration: [32]u8
    unused session_result_format_duration(result.primary_value, duration[:])
    unused session_result_format_text("results_duration",
        AppTextFromCString(*duration[0], 32), first)
    if result.activity == EXERCISE_PATTERNS && result.secondary_value > 0 {
        unused session_result_format_number("results_cycles",
            result.secondary_value, second)
        return 2
    }
    return 1
}

// A practice that finished in its floating window says so there, above
// its name and its main results, until the window opens back into the
// app's screen.
practice_draw_results_window :: (app: *InnerBreeze, bounds: Rectangle,
    result: *SessionResult) {
    session := app.ui.session
    lines: [2][80]u8
    count := session_result_window_lines(result, lines[0][:], lines[1][:])
    padding := cast(float32)AppScale(12)
    width := bounds.width - padding * 2.0
    heading_height := cast(float32)AppScale(32)
    rule_height := cast(float32)AppScale(3)
    name_height := cast(float32)AppScale(22)
    line_height := cast(float32)AppScale(24)
    gap := cast(float32)AppScale(10)
    total := heading_height + gap + rule_height + gap + name_height + gap +
    cast(float32)count * line_height
    y := bounds.y + (bounds.height - total) * 0.5
    x := bounds.x + padding

    heading := LocaleText("session_window_finished")
    Text(session, TextProps.{.key = KeyHash("inbe/picture-window/results/heading"),
            .bounds = Rectangle.{x, y, width, heading_height},
            .text = heading,
            .font = AppFitFontSize(heading, cast(s32)width, AppScale(24), AppScale(14)),
            .wrap = cast(TextWrap)TextWrapNone,
            .align = cast(TextAlign)TextAlignCenter,
            .vertical_align = cast(TextAlign)TextAlignCenter})
    y += heading_height + gap
    rule_width := cast(float32)AppScale(40)
    Box(session, BoxProps.{.key = KeyHash("inbe/picture-window/results/rule"),
            .bounds = Rectangle.{bounds.x + (bounds.width - rule_width) * 0.5, y,
                rule_width, rule_height},
            .fill = StyleTokenColor("accent"), .radius = rule_height * 0.5})
    y += rule_height + gap

    name := practice_label(result.activity)
    Text(session, TextProps.{.key = KeyHash("inbe/picture-window/results/name"),
            .bounds = Rectangle.{x, y, width, name_height},
            .text = name,
            .font = AppFitFontSize(name, cast(s32)width, AppScale(15), AppScale(11)),
            .wrap = cast(TextWrap)TextWrapNone,
            .align = cast(TextAlign)TextAlignCenter,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .class_name = KssClassId(KssMakeName("launcher-muted"))})
    y += name_height + gap

    keys: [2]u64 = .[KeyHash("inbe/picture-window/results/line-1"),
    KeyHash("inbe/picture-window/results/line-2")]
    index: s32 = 0
    while index < count {
        line := FrameTextHold(*app.ui.frame_text,
            AppTextFromCString(*lines[index][0], 80))
        Text(session, TextProps.{.key = keys[index],
                .bounds = Rectangle.{x, y, width, line_height},
                .text = line,
                .font = AppFitFontSize(line, cast(s32)width, AppScale(17), AppScale(11)),
                .wrap = cast(TextWrap)TextWrapNone,
                .align = cast(TextAlign)TextAlignCenter,
                .vertical_align = cast(TextAlign)TextAlignCenter})
        y += line_height
        index += 1
    }
}
