elist_ids_equal :: (first: *u8, second: *u8) -> bool {
    if first == null || second == null {
        return false
    }
    index: s32 = 0
    while index < 37 {
        if first[index] != second[index] {
            return false
        }
        if first[index] == cast(u8)0 {
            return true
        }
        index += 1
    }
    return false
}

elist_field :: (app: *InnerBreeze, bounds: Rectangle,
    typed: []u8) -> TextFieldProps {
    current := AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE)
    if !AppCopyText(current, app.elist.input_frame[:]) {
        app.elist.input_frame[0] = cast(u8)0
    }
    return TextFieldProps.{
        .bounds = bounds,
        .value = AppTextFromCString(*app.elist.input_frame[0],
            ELIST_TITLE_SIZE),
        .cursor = app.elist.input_cursor,
        .anchor = app.elist.input_anchor,
        .scroll_x = app.elist.input_scroll_x,
        .focused = app.elist.input_focused != 0,
        .focus_id = 6501,
        .max_bytes = ELIST_TITLE_SIZE - 1,
        .max_codepoints = ELIST_TITLE_SIZE - 1,
        .input = SampleTextFieldInput(app.elist.input_focused != 0, typed)
    }
}

elist_accept_field :: (app: *InnerBreeze, result: TextFieldResult) {
    if result.edit.changed {
        if !AppReplaceText(app.elist.input[:], result.edit.start,
            result.edit.end, result.edit.replacement) {
            app.elist.input_committed = 0
            return
        }
    }
    app.elist.input_cursor = result.cursor
    app.elist.input_anchor = result.anchor
    app.elist.input_scroll_x = result.scroll_x
    app.elist.input_focused = ifx (result.focused) then (1) else (0)
    app.elist.input_committed = ifx (result.committed) then (1) else (0)
    if result.clipboard_write {
        TextInputWriteClipboard(result.clipboard_text)
    }
}

elist_reload :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.elist.loaded = storage_elist_load(cast(*void)*app.elist)
}

elist_begin_input :: (app: *InnerBreeze, editing_item: s32,
    text: string) {
    if !AppCopyText(text, app.elist.input[:]) {
        app.elist.input[0] = cast(u8)0
    }
    app.elist.input_cursor = cast(s32)AppTextFromCString(
        *app.elist.input[0], ELIST_TITLE_SIZE).count
    app.elist.input_anchor = app.elist.input_cursor
    app.elist.input_scroll_x = 0
    app.elist.input_focused = 1
    app.elist.input_error = 0
    app.elist.input_committed = 0
    app.elist.editing_item = editing_item
}

elist_message_for :: (state: *EListState, action: s32, index: s32) -> ListsMessage {
    message: ListsMessage
    message.action = action
    message.index = index
    message.selected_list = state.selected_list
    message.list_count = state.list_count
    message.item_count = state.item_count
    message.editing_item = state.editing_item
    message.show_completed = state.show_completed
    message.input_error = state.input_error
    message.completing_until = state.completing_until
    message.completing_id = AppTextFromCString(*state.completing_item[0], 37)
    if state.selected_list >= 0 && state.selected_list < state.list_count {
        list := *state.lists[state.selected_list]
        message.selected_id = AppTextFromCString(*list.id[0], 37)
        message.id = message.selected_id
        message.sort_order = list.sort_order
    }
    item_index := ifx action == LISTS_COMMIT then state.editing_item else index
    if item_index >= 0 && item_index < state.item_count {
        item := *state.items[item_index]
        message.id = AppTextFromCString(*item.id[0], 37)
        message.parent_id = AppTextFromCString(*item.list_id[0], 37)
        message.title = AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE)
        message.comment = AppTextFromCString(*item.comment[0], ELIST_COMMENT_SIZE)
        message.done = item.done
        message.sort_order = item.sort_order
    }
    return message
}

elist_accept_message :: (app: *InnerBreeze, message: ListsMessage) {
    state := *app.elist
    if !message.succeeded {
        state.input_error = 1
        return
    }
    state.input_error = message.input_error
    if message.changed {
        state.visibility_valid = false
    }
    state.selected_list = message.selected_list
    state.editing_item = message.editing_item
    state.show_completed = message.show_completed
    state.completing_until = message.completing_until
    AppCopyText(message.completing_id, state.completing_item[:])
    if message.reset_scroll {
        state.scroll = 0
    }
    if message.reset_input {
        state.input[0] = cast(u8)0
        state.input_cursor = 0
        state.input_anchor = 0
        state.input_scroll_x = 0
        state.input_focused = 0
        state.input_error = 0
        state.input_committed = 0
    }
    if message.reload {
        elist_reload(app)
    }
    if message.action == LISTS_COMMIT && message.selected_id.count > 0 {
        index: s32 = 0
        while index < state.list_count {
            if AppTextFromCString(*state.lists[index].id[0], 37) == message.selected_id {
                state.selected_list = index
                break
            }
            index += 1
        }
    }
    if message.sync {
        app_auto_sync(app)
    }
}

elist_commit_input :: (app: *InnerBreeze) {
    message := elist_message_for(*app.elist, LISTS_COMMIT, -1)
    message.title = AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE)
    elist_accept_message(app, ListsRun(message))
}

elist_content_bounds :: (app: *InnerBreeze) -> Rectangle {
    pad := AppScale(16)
    return Rectangle.{
        cast(float32)pad, 0.0,
        cast(float32)(app.ui.view_width - pad * 2),
        cast(float32)app.ui.view_height
    }
}

elist_select_list :: (app: *InnerBreeze, index: s32) {
    message := elist_message_for(*app.elist, LISTS_SELECT, index)
    elist_accept_message(app, ListsRun(message))
}

elist_set_done :: (app: *InnerBreeze, index: s32,
    done: s32, now: float64) -> bool {
    message := elist_message_for(*app.elist, LISTS_SET_DONE, index)
    message.done = done
    message.now = now
    message = ListsRun(message)
    elist_accept_message(app, message)
    return message.succeeded
}

// The Lists ZIB owns presentation and interaction. This adapter exposes only
// typed device observations, bounded saved rows and retained input state.
#import "bundle_host"
#import "byte_text_linux"
#import, file "../cells/lists_ui_types.zi";
#import, file "../cells/widget_codec.zi";
#import, file "../cells/widget_host.zi";
#import, file "../cells/value_codec.zi";
using HostValueKind;
lists_ui: ListsUiFrame;
lists_ui_codec: WidgetListsUiFrameCodec;
lists_row_codec: WidgetListsUiRowCodec;

ListsUiCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "lists_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ReadListsUiHost" && count == 0 {
        result.* = WidgetEncodeListsUiFrame(lists_ui, *lists_ui_codec)
        return 1
    }
    if name == "WriteListsUiHost" && count == 1 && WidgetValidListsUiFrame(arguments[0]) {
        observed := WidgetDecodeListsUiFrame(arguments[0], *lists_ui_codec)
        if !AppCopyText(observed.value, app.elist.input[:]) {
            return 0
        }
        app.elist.input_cursor = observed.cursor
        app.elist.input_anchor = observed.anchor
        app.elist.input_scroll_x = observed.scroll_x
        app.elist.input_focused = ifx observed.focused then 1 else 0
        app.elist.scroll = observed.scroll
        if observed.clipboard_write {
            unused TextInputWriteClipboard(observed.clipboard_text)
        }
        return 1
    }
    if name == "ReadListsRowHost" && count == 2 &&
    ModuleScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    ModuleScalarValid(arguments[1], "bool", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        item := arguments[1].integer != 0
        row: ListsUiRow
        if item && index >= 0 && index < app.elist.item_count {
            source := *app.elist.items[index]
            row.id = AppTextFromCString(*source.id[0], 37)
            row.parent_id = AppTextFromCString(*source.list_id[0], 37)
            row.title = AppTextFromCString(*source.title[0], ELIST_TITLE_SIZE)
            row.comment = AppTextFromCString(*source.comment[0], ELIST_COMMENT_SIZE)
            row.done = source.done
            row.sort_order = source.sort_order
        } else if !item && index >= 0 && index < app.elist.list_count {
            source := *app.elist.lists[index]
            row.id = AppTextFromCString(*source.id[0], 37)
            row.title = AppTextFromCString(*source.title[0], ELIST_TITLE_SIZE)
            row.sort_order = source.sort_order
        }
        result.* = WidgetEncodeListsUiRow(row, *lists_row_codec)
        return 1
    }
    if name == "ListsLocaleHost" && count == 1 &&
    ModuleScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = ModuleTextData("string"),
            .data = ModuleTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

draw_elist_screen :: (app: *InnerBreeze) {
    if app.elist.loaded == 0 {
        elist_reload(app)
    }
    typed: [ELIST_TITLE_SIZE]u8
    lists_ui = ListsUiFrame.{.session = app.ui.session,
        .width = app.ui.view_width, .height = app.ui.view_height,
        .bottom = app_content_bottom_reserved(app), .scale = MetricsScale(),
        .input = SampleTextFieldInput(app.elist.input_focused != 0, typed[:]),
        .value = AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE),
        .cursor = app.elist.input_cursor, .anchor = app.elist.input_anchor,
        .scroll_x = app.elist.input_scroll_x, .focused = app.elist.input_focused != 0,
        .scroll = app.elist.scroll}
    message := elist_message_for(*app.elist, LISTS_FRAME, -1)
    message.now = GetTime()
    WidgetHostBegin(app.ui.session)
    CellsUiBegin(ListsUiCall, cast(*void)app)
    message = ListsUiRun(message)
    CellsUiEnd()
    WidgetHostEnd()
    if !message.succeeded {
        app.request_quit = 1
        return
    }
    elist_accept_message(app, message)
}

elist :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("elist/root")
    Screen(app.ui.session, root)
    draw_elist_screen(app)
    End(app.ui.session)
}
