elist_ids_equal :: (first: *u8, second: *u8) -> bool {
    if first == null || second == null {
        return false
    }
    index: s32 = 0
    while index < 37 {
        if first[index] != second[index] {
            return false
        }
        if first[index] == cast(u8)0 {
            return true
        }
        index += 1
    }
    return false
}

elist_reload :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.elist.loaded = storage_elist_load(cast(*void)*app.elist)
}

elist_begin_input :: (app: *InnerBreeze, editing_item: s32,
    text: string) {
    if !AppCopyText(text, app.elist.input[:]) {
        app.elist.input[0] = cast(u8)0
    }
    app.elist.input_cursor = cast(s32)AppTextFromCString(
        *app.elist.input[0], ELIST_TITLE_SIZE).count
    app.elist.input_anchor = app.elist.input_cursor
    app.elist.input_scroll_x = 0
    app.elist.input_focused = 1
    app.elist.input_error = 0
    app.elist.input_committed = 0
    app.elist.editing_item = editing_item
}

elist_message_for :: (state: *EListState, action: s32, index: s32) -> ListsMessage {
    message: ListsMessage
    message.action = action
    message.index = index
    message.selected_list = state.selected_list
    message.list_count = state.list_count
    message.item_count = state.item_count
    message.editing_item = state.editing_item
    message.show_completed = state.show_completed
    message.input_error = state.input_error
    message.completing_until = state.completing_until
    message.completing_id = AppTextFromCString(*state.completing_item[0], 37)
    if state.selected_list >= 0 && state.selected_list < state.list_count {
        list := *state.lists[state.selected_list]
        message.selected_id = AppTextFromCString(*list.id[0], 37)
        message.id = message.selected_id
        message.sort_order = list.sort_order
    }
    item_index := ifx action == LISTS_COMMIT then state.editing_item else index
    if item_index >= 0 && item_index < state.item_count {
        item := *state.items[item_index]
        message.id = AppTextFromCString(*item.id[0], 37)
        message.parent_id = AppTextFromCString(*item.list_id[0], 37)
        message.title = AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE)
        message.comment = AppTextFromCString(*item.comment[0], ELIST_COMMENT_SIZE)
        message.done = item.done
        message.sort_order = item.sort_order
    }
    return message
}

elist_clear_input :: (state: *EListState) {
    state.input[0] = cast(u8)0
    state.input_cursor = 0
    state.input_anchor = 0
    state.input_scroll_x = 0
    state.input_focused = 0
    state.input_error = 0
    state.input_committed = 0
}

elist_accept_message :: (app: *InnerBreeze, message: ListsMessage) {
    state := *app.elist
    if !message.succeeded {
        state.input_error = 1
        return
    }
    if message.remote {
        // A deleted shared item leaves Edit at once, like a private one;
        // the node confirms the deletion later.
        if message.reset_input {
            elist_clear_input(state)
            state.editing_item = message.editing_item
        }
        ListsNetworkStart(message)
        return
    }
    state.input_error = message.input_error
    if message.changed {
        state.visibility_valid = false
    }
    state.selected_list = message.selected_list
    state.editing_item = message.editing_item
    state.show_completed = message.show_completed
    state.completing_until = message.completing_until
    AppCopyText(message.completing_id, state.completing_item[:])
    if message.reset_scroll {
        state.scroll = 0
    }
    if message.reset_input {
        elist_clear_input(state)
    }
    if message.reload {
        elist_reload(app)
    }
    if message.action == LISTS_COMMIT && message.selected_id.count > 0 {
        index: s32 = 0
        while index < state.list_count {
            if AppTextFromCString(*state.lists[index].id[0], 37) == message.selected_id {
                state.selected_list = index
                break
            }
            index += 1
        }
    }
    if message.sync {
        app_auto_sync(app)
    }
}

elist_commit_input :: (app: *InnerBreeze) {
    message := elist_message_for(*app.elist, LISTS_COMMIT, -1)
    message.title = AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE)
    elist_accept_message(app, ListsRun(message))
}

elist_content_bounds :: (app: *InnerBreeze) -> Rectangle {
    pad := AppScale(16)
    return Rectangle.{
        cast(float32)pad, 0.0,
        cast(float32)(app.ui.view_width - pad * 2),
        cast(float32)app.ui.view_height
    }
}

elist_select_list :: (app: *InnerBreeze, index: s32) {
    message := elist_message_for(*app.elist, LISTS_SELECT, index)
    elist_accept_message(app, ListsRun(message))
}

elist_set_done :: (app: *InnerBreeze, index: s32,
    done: s32, now: float64) -> bool {
    message := elist_message_for(*app.elist, LISTS_SET_DONE, index)
    message.done = done
    message.now = now
    message = ListsRun(message)
    elist_accept_message(app, message)
    return message.succeeded
}

// The Lists ZX owns presentation and interaction. This adapter exposes only
// typed device observations, bounded saved rows and retained input state.
#import "bundle_host"
#import "byte_text_linux"
#import "json_scan"
#import, file "../apps/lists_ui_types.zi";
#import, file "../apps/app_codec.zi";
#import "widget_host"
#import "hosted_values"
#import, file "../apps/hosted_assets.zi";
#import, file "../apps/value_codec.zi";
using HostValueKind;
lists_ui: ListsUiFrame;
lists_ui_codec: WidgetListsUiFrameCodec;
lists_row_codec: WidgetListsUiRowCodec;
lists_friends: [8192]u8;
lists_sharing_source: string;
// The invitations to lists, as indexes into the shared cache's invitations:
// other apps' invitations, such as to a Chess game, are left out.
lists_invitation_rows: Vec(s32);
lists_invitation_count: s32;
lists_person_codec: WidgetListsUiPersonCodec;
lists_person_text: [9][512]u8;
lists_pending_number: [24]u8;
lists_prepared_body: string;
lists_request_codec: WidgetListsUiRequestCodec;

ListsUiCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "lists_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ReadListsUiHost" && count == 0 {
        result.* = WidgetEncodeListsUiFrame(lists_ui, *lists_ui_codec)
        return 1
    }
    if name == "WriteListsUiHost" && count == 1 && WidgetValidListsUiFrame(arguments[0]) {
        observed := WidgetDecodeListsUiFrame(arguments[0], *lists_ui_codec)
        if !AppCopyText(observed.value, app.elist.input[:]) {
            return 0
        }
        app.elist.input_cursor = observed.cursor
        app.elist.input_anchor = observed.anchor
        app.elist.input_scroll_x = observed.scroll_x
        app.elist.input_focused = ifx observed.focused then 1 else 0
        app.elist.scroll = observed.scroll
        app.elist.tab_scroll = observed.tab_scroll
        app.elist.panel = observed.panel
        if observed.clipboard_write {
            unused TextInputWriteClipboard(observed.clipboard_text)
        }
        return 1
    }
    if name == "ReadListsRowHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "bool", cast(s32)HostInteger) {
        index := cast(s32)arguments[0].integer
        item := arguments[1].integer != 0
        row: ListsUiRow
        if item && index >= 0 && index < app.elist.item_count {
            source := *app.elist.items[index]
            row.id = AppTextFromCString(*source.id[0], 37)
            row.parent_id = AppTextFromCString(*source.list_id[0], 37)
            row.title = AppTextFromCString(*source.title[0], ELIST_TITLE_SIZE)
            row.comment = AppTextFromCString(*source.comment[0], ELIST_COMMENT_SIZE)
            row.done = source.done
            row.sort_order = source.sort_order
        } else if !item && index >= 0 && index < app.elist.list_count {
            source := *app.elist.lists[index]
            row.id = AppTextFromCString(*source.id[0], 37)
            row.title = AppTextFromCString(*source.title[0], ELIST_TITLE_SIZE)
            row.sort_order = source.sort_order
            row.shared = source.shared
            row.owner = source.owner
            row.owner_id = AppTextFromCString(*source.owner_id[0], 65)
            row.owner_alias = AppTextFromCString(*source.owner_alias[0], 128)
            row.read_only = source.read_only
            row.people = AppTextFromCString(*source.people[0], 256)
            row.invited = AppTextFromCString(*source.invited[0], 256)
            row.revision = source.revision
            row.incomplete = source.incomplete
        }
        result.* = WidgetEncodeListsUiRow(row, *lists_row_codec)
        return 1
    }
    if name == "ListsLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    if name == "ReadListsSharingRowHost" && count == 2 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "bool", cast(s32)HostInteger) {
        invitation := arguments[1].integer != 0
        source := ifx invitation then lists_sharing_source else AppTextFromCString(*lists_friends[0], 8192)
        array := FieldAt(source, 0, ifx invitation then "invitations" else "friends")
        index := cast(s32)arguments[0].integer
        if invitation {
            index = ifx index >= 0 && index < lists_invitation_count then lists_invitation_rows[index] else -1
        }
        row: ListsUiPerson
        if index >= 0 && index < ArrayCount(source, array) {
            object := ElementAt(source, array, index)
            fields: [9]string = .[ifx invitation then "id" else "user_id_hash", "alias", "owner", "target", "list_id", "title", "status", "target_alias", "access"]
            for field: cast(s32)0..8 {
                ListsCopyJson(source, object, fields[field], lists_person_text[field][:])
            }
            row.id = AppTextFromCString(*lists_person_text[0][0], 512)
            row.alias = AppTextFromCString(*lists_person_text[1][0], 512)
            row.owner = AppTextFromCString(*lists_person_text[2][0], 512)
            row.target = AppTextFromCString(*lists_person_text[3][0], 512)
            row.list_id = AppTextFromCString(*lists_person_text[4][0], 512)
            row.title = AppTextFromCString(*lists_person_text[5][0], 512)
            row.status = AppTextFromCString(*lists_person_text[6][0], 512)
            row.target_alias = AppTextFromCString(*lists_person_text[7][0], 512)
            row.access = AppTextFromCString(*lists_person_text[8][0], 512)
            if !invitation {
                row.profile_icon = ListsProfileIcon(source, object)
            } else {
                // An invitation shows the other person: whoever it went to,
                // or the owner when it came to this account.
                person := ifx row.target == storage_get_setting_text("sync_public_id") then row.owner else row.target
                row.profile_icon = ListsFriendIcon(AppTextFromCString(*lists_friends[0], 8192), person)
            }
        }
        result.* = WidgetEncodeListsUiPerson(row, *lists_person_codec)
        return 1
    }
    if name == "PrepareListsCommandHost" && count == 1 && WidgetValidListsUiRequest(arguments[0]) {
        request := WidgetDecodeListsUiRequest(arguments[0], *lists_request_codec)
        PackageFree(lists_prepared_body)
        lists_prepared_body = ListsPrepareCommand(*app.elist, request)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(lists_prepared_body), .length = cast(usize)lists_prepared_body.count}
        return 1
    }
    return 0
}

// A friend's profile picture as Kryon's icon number. The node still keeps
// pictures chosen in older clients by their own numbers 1 to 11; those map
// to the same pictures.
ListsProfileIcon :: (friends: string, friend: s32) -> s32 {
    at := FieldAt(friends, friend, "profile_icon")
    if at < 0 {
        return 0
    }
    icon := cast(s32)ReadNumber(friends, at).value
    return ProfilePictureFromRemote(icon)
}

ListsFriendIcon :: (friends: string, id: string) -> s32 {
    if id.count == 0 {
        return 0
    }
    array := FieldAt(friends, 0, "friends")
    for index: cast(s32)0..ArrayCount(friends, array) - 1 {
        friend := ElementAt(friends, array, index)
        user: [65]u8
        ListsCopyJson(friends, friend, "user_id_hash", user[:])
        if AppTextFromCString(*user[0], 65) == id {
            return ListsProfileIcon(friends, friend)
        }
    }
    return 0
}

draw_elist_screen :: (app: *InnerBreeze) {
    ListsNetworkContext()
    if app.elist.loaded == 0 {
        elist_reload(app)
    }
    typed: [ELIST_TITLE_SIZE]u8
    next_id := ListsNetworkNextId()
    defer { PackageFree(next_id) }
    unused storage_get_social_cache_json("friends.list", *lists_friends[0], 8192)
    lists_sharing_source = ListsSharedCache()
    invitations := FieldAt(lists_sharing_source, 0, "invitations")
    incoming: s32 = 0
    lists_invitation_count = 0
    VecClear(lists_invitation_rows)
    for index: cast(s32)0..ArrayCount(lists_sharing_source, invitations) - 1 {
        row := ElementAt(lists_sharing_source, invitations, index)
        list_id: [64]u8
        ListsCopyJson(lists_sharing_source, row, "list_id", list_id[:])
        if !SharedIdLooksLikeList(AppTextFromCString(*list_id[0], 64)) {
            continue
        }
        unused VecPush(lists_invitation_rows, index)
        lists_invitation_count += 1
        target := ReadString(lists_sharing_source, FieldAt(lists_sharing_source, row, "target"))
        status := ReadString(lists_sharing_source, FieldAt(lists_sharing_source, row, "status"))
        if SpanEqualsASCII(lists_sharing_source, target, storage_get_setting_text("sync_public_id")) &&
        SpanEqualsASCII(lists_sharing_source, status, "pending") {
            incoming += 1
        }
    }
    unused AppFormatS64(incoming, lists_pending_number[:])
    lists_ui = ListsUiFrame.{.session = app.ui.session,
        .width = app.ui.view_width, .height = app.ui.view_height,
        .bottom = app_content_bottom_reserved(app), .scale = MetricsScale(),
        .input = SampleTextFieldInput(app.elist.input_focused != 0, typed[:]),
        .value = AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE),
        .cursor = app.elist.input_cursor, .anchor = app.elist.input_anchor,
        .scroll_x = app.elist.input_scroll_x, .focused = app.elist.input_focused != 0,
        .scroll = app.elist.scroll, .tab_scroll = app.elist.tab_scroll,
        .panel = app.elist.panel, .sharing_status = lists_status,
        .sharing_busy = ListsNetworkSaving(), .sharing_pending = ListsNetworkNeedsRetry(),
        .connected = ListsNetworkReady(), .public_id = storage_get_setting_text("sync_public_id"),
        .friend_count = ArrayCount(AppTextFromCString(*lists_friends[0], 8192),
            FieldAt(AppTextFromCString(*lists_friends[0], 8192), 0, "friends")),
        .invitation_count = lists_invitation_count,
        .pending_count_text = AppTextFromCString(*lists_pending_number[0], 24),
        .next_id = next_id, .profile_icon = app.profile_picture_icon}
    message := elist_message_for(*app.elist, LISTS_FRAME, -1)
    message.now = GetTime()
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(ListsUiCall, cast(*void)app)
    message = ListsUiRun(message)
    AppsUiEnd()
    WidgetHostEnd()
    lists_ui = ListsUiFrame.{}
    lists_sharing_source = ""
    PackageFree(lists_prepared_body)
    lists_prepared_body = ""
    if !message.succeeded {
        app.request_quit = 1
        return
    }
    elist_accept_message(app, message)
}

elist :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("elist/root")
    Screen(app.ui.session, root)
    draw_elist_screen(app)
    End(app.ui.session)
}
