using TextAlign;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

elist_ids_equal :: (first: *u8, second: *u8) -> bool {
    if first == null || second == null {
        return false
    }
    index: s32 = 0
    while index < 37 {
        if first[index] != second[index] {
            return false
        }
        if first[index] == cast(u8)0 {
            return true
        }
        index += 1
    }
    return false
}

elist_field :: (app: *InnerBreeze, bounds: Rectangle,
    typed: []u8) -> TextFieldProps {
    current := AppTextFromCString(*app.elist.input[0], ELIST_TITLE_SIZE)
    if !AppCopyText(current, app.elist.input_frame[:]) {
        app.elist.input_frame[0] = cast(u8)0
    }
    return TextFieldProps.{
        .bounds = bounds,
        .value = AppTextFromCString(*app.elist.input_frame[0],
            ELIST_TITLE_SIZE),
        .cursor = app.elist.input_cursor,
        .anchor = app.elist.input_anchor,
        .scroll_x = app.elist.input_scroll_x,
        .focused = app.elist.input_focused != 0,
        .focus_id = 6501,
        .max_bytes = ELIST_TITLE_SIZE - 1,
        .max_codepoints = ELIST_TITLE_SIZE - 1,
        .input = SampleTextFieldInput(app.elist.input_focused != 0, typed)
    }
}

elist_accept_field :: (app: *InnerBreeze, result: TextFieldResult) {
    if result.edit.changed {
        if !AppReplaceText(app.elist.input[:], result.edit.start,
            result.edit.end, result.edit.replacement) {
            app.elist.input_committed = 0
            return
        }
    }
    app.elist.input_cursor = result.cursor
    app.elist.input_anchor = result.anchor
    app.elist.input_scroll_x = result.scroll_x
    app.elist.input_focused = ifx (result.focused) then (1) else (0)
    app.elist.input_committed = ifx (result.committed) then (1) else (0)
    if result.clipboard_write {
        TextInputWriteClipboard(result.clipboard_text)
    }
}

elist_reload :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.elist.loaded = storage_elist_load(cast(*void)*app.elist)
}

elist_begin_input :: (app: *InnerBreeze, editing_item: s32,
    text: string) {
    if !AppCopyText(text, app.elist.input[:]) {
        app.elist.input[0] = cast(u8)0
    }
    app.elist.input_cursor = cast(s32)AppTextFromCString(
        *app.elist.input[0], ELIST_TITLE_SIZE).count
    app.elist.input_anchor = app.elist.input_cursor
    app.elist.input_scroll_x = 0
    app.elist.input_focused = 1
    app.elist.input_error = 0
    app.elist.input_committed = 0
    app.elist.editing_item = editing_item
}

elist_commit_input :: (app: *InnerBreeze) {
    state: *EListState = *app.elist
    saved: s32 = 0
    created_id: [37]u8
    title := AppTextFromCString(*state.input[0], ELIST_TITLE_SIZE)
    if title.count == 0 {
        return
    }

    if state.editing_item == -2 {
        saved = storage_elist_create_list(title, *created_id[0])
    } else if state.editing_item == -3 &&
        state.selected_list >= 0 && state.selected_list < state.list_count {
        list: *EListList = *state.lists[state.selected_list]
        saved = storage_elist_update_list(
            AppTextFromCString(*list.id[0], 37), title, list.sort_order)
    } else if state.editing_item >= 0 &&
        state.editing_item < state.item_count {
        item: *EListItem = *state.items[state.editing_item]
        saved = storage_elist_update_item(
            AppTextFromCString(*item.id[0], 37), title,
            AppTextFromCString(*item.comment[0], ELIST_COMMENT_SIZE),
            item.done, item.sort_order)
    } else if state.selected_list >= 0 &&
        state.selected_list < state.list_count {
        saved = storage_elist_create_item(
            AppTextFromCString(*state.lists[state.selected_list].id[0], 37),
            title, "", null)
    }
    if saved == 0 {
        state.input_error = 1
        return
    }

    state.input_error = 0
    state.input[0] = cast(u8)0
    state.input_cursor = 0
    state.input_anchor = 0
    state.input_scroll_x = 0
    state.input_focused = 0
    state.input_committed = 0
    state.editing_item = -1
    elist_reload(app)
    if created_id[0] != cast(u8)0 {
        index: s32 = 0
        while index < state.list_count {
            if elist_ids_equal(*state.lists[index].id[0], *created_id[0]) {
                state.selected_list = index
                break
            }
            index += 1
        }
    }
    app_auto_sync(app)
}

elist_content_bounds :: (app: *InnerBreeze) -> Rectangle {
    pad := AppScale(16)
    return Rectangle.{
        cast(float32)pad, 0.0,
        cast(float32)(app.ui.view_width - pad * 2),
        cast(float32)app.ui.view_height
    }
}

elist_select_list :: (app: *InnerBreeze, index: s32) {
    state: *EListState = *app.elist
    if index < 0 || index >= state.list_count || index == state.selected_list {
        return
    }
    state.selected_list = index
    state.scroll = 0
    state.show_completed = 0
    state.completing_item[0] = cast(u8)0
    state.completing_until = 0.0
    state.editing_item = -1
    state.input[0] = cast(u8)0
    state.input_cursor = 0
    state.input_anchor = 0
    state.input_scroll_x = 0
    state.input_focused = 0
    state.input_error = 0
    state.input_committed = 0
}

elist_item_visible :: (state: *EListState, index: s32, now: float64) -> bool {
    if index < 0 || index >= state.item_count ||
        state.selected_list < 0 || state.selected_list >= state.list_count {
        return false
    }
    item: *EListItem = *state.items[index]
    if !elist_ids_equal(*item.list_id[0],
        *state.lists[state.selected_list].id[0]) {
        return false
    }
    return item.done == 0 || state.show_completed != 0 ||
        (now < state.completing_until &&
            elist_ids_equal(*item.id[0], *state.completing_item[0]))
}

elist_set_done :: (app: *InnerBreeze, index: s32,
    done: s32, now: float64) -> bool {
    if index < 0 || index >= app.elist.item_count {
        return false
    }
    item: *EListItem = *app.elist.items[index]
    if storage_elist_update_item(
        AppTextFromCString(*item.id[0], 37),
        AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE),
        AppTextFromCString(*item.comment[0], ELIST_COMMENT_SIZE),
        done, item.sort_order) == 0 {
        app.elist.input_error = 1
        return false
    }
    app.elist.input_error = 0
    item.done = done
    if done != 0 {
        AppCopyText(AppTextFromCString(*item.id[0], 37),
            app.elist.completing_item[:])
        app.elist.completing_until = now + 0.45
    } else if elist_ids_equal(*item.id[0],
        *app.elist.completing_item[0]) {
        app.elist.completing_item[0] = cast(u8)0
    }
    elist_reload(app)
    app_auto_sync(app)
    return true
}

elist_draw_empty :: (app: *InnerBreeze, x: s32, y: s32, w: s32) {
    title := LocaleText("elist_empty_title")
    detail := LocaleText("elist_empty_detail")

    Text(app.ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)w, cast(float32)AppScale(30)},
        .text = title,
        .align = cast(TextAlign)TextAlignCenter,
        .wrap = cast(TextWrap)TextWrapAuto
    })
    Text(app.ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)(y + AppScale(40)), cast(float32)w, cast(float32)AppScale(48)},
        .text = detail,
        .align = cast(TextAlign)TextAlignCenter,
        .wrap = cast(TextWrap)TextWrapAuto
    })
}

draw_elist_screen :: (app: *InnerBreeze) {
    state: *EListState
    if app == null {
        return
    }
    content := elist_content_bounds(app)
    x := cast(s32)content.x
    content_w := cast(s32)content.width
    y := AppScale(12)

    tab_h := AppScale(44)
    list_tabs: [ELIST_LIST_MAX] Tab

    state = *app.elist
    if state.loaded == 0 {
        elist_reload(app)
    }

    {
        i: s32 = 0
        while i < state.list_count {
            list_tabs[i] = Tab.{
                .key = KeyHash(AppTextFromCString(*state.lists[i].id[0], 37)),
                .label = FrameTextHold(*app.ui.frame_text,
                    AppTextFromCString(*state.lists[i].title[0],
                        ELIST_TITLE_SIZE))
            }
            i += 1
        }

    }
    header_action_w := AppScale(118)
    header_gap := AppScale(10)
    header_actions := header_action_w
    if state.list_count > 0 && state.selected_list >= 0 {
        header_actions += AppScale(88)
    }
    selector_w := content_w - header_actions - header_gap
    if selector_w < AppScale(160) {
        header_actions = header_action_w
        selector_w = content_w - header_actions - header_gap
    }
    if selector_w < AppScale(120) {
        selector_w = content_w - header_action_w - header_gap
    }
    if selector_w < 0 {
        selector_w = 0
    }
    if state.list_count > 0 && selector_w > 0 {
        selected := TabBar(app.ui.session, TabBarProps.{
            .id = 6500,
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)selector_w, cast(float32)tab_h},
            .selected_index = state.selected_list,
            .min_tab_width = AppScale(88),
            .max_tab_width = selector_w
        }, list_tabs[:state.list_count])
        elist_select_list(app, selected.selected_index)
    }
    if Button(app.ui.session, ButtonProps.{
        .key = cast(u64)6505,
        .bounds = Rectangle.{cast(float32)(x + content_w - header_action_w), cast(float32)(y),
            cast(float32)header_action_w, cast(float32)(tab_h)},
        .label = LocaleText("elist_new_list"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
        .disabled = false
    }) != 0 {
        elist_begin_input(app, -2, "")
        return
    }
    if state.list_count > 0 && state.selected_list >= 0  && header_actions > header_action_w {
        icon_y := y + (tab_h - (AppScale(22) + AppScale(8) * 2)) / 2
        edit_x := x + content_w - header_action_w - AppScale(84)
        if Button(app.ui.session, ButtonProps.{
            .key = cast(u64)6503,
            .bounds = Rectangle.{cast(float32)edit_x, cast(float32)icon_y,
                cast(float32)((AppScale(22)) + (AppScale(8)) * 2),
                cast(float32)((AppScale(22)) + (AppScale(8)) * 2)},
            .label = "✎",
            .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        }) != 0 {
            elist_begin_input(app, -3,
                AppTextFromCString(*state.lists[state.selected_list].title[0],
                    ELIST_TITLE_SIZE))
        }
        if Button(app.ui.session, ButtonProps.{
            .key = cast(u64)6504,
            .bounds = Rectangle.{cast(float32)(edit_x + AppScale(40)), cast(float32)icon_y,
                cast(float32)((AppScale(22)) + (AppScale(8)) * 2),
                cast(float32)((AppScale(22)) + (AppScale(8)) * 2)},
            .label = "×",
            .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        }) != 0 {
            storage_elist_delete_list(AppTextFromCString(
                *state.lists[state.selected_list].id[0], 37))
            state.selected_list = 0
            elist_reload(app)
            app_auto_sync(app)
            return
        }
    }
    y += tab_h + AppScale(16)

    if state.input_error != 0 {
        Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)content_w, cast(float32)AppScale(40)},
            .text = LocaleText("results_write_failed"),
            .wrap = cast(TextWrap)TextWrapAuto
        })
        y += AppScale(48)
    }

    if state.editing_item == -2 || state.editing_item == -3 {
        typed: [ELIST_TITLE_SIZE]u8
        field := TextField(app.ui.session, elist_field(app,
            Rectangle.{cast(float32)x, cast(float32)y,
                cast(float32)content_w, cast(float32)AppScale(44)},
            typed[:]))
        elist_accept_field(app, field)
        y += AppScale(52)
        if Button(app.ui.session, ButtonProps.{
            .bounds = Rectangle.{cast(float32)(x), cast(float32)(y), cast(float32)(content_w), cast(float32)(AppScale(40))},
            .label = ifx (state.editing_item == -3) then (LocaleText("done_button")) else (LocaleText("elist_create_list")),
            .tone = cast(ButtonTone)ButtonToneAccent,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
            .disabled = state.input[0] == #char "\0"
        }) != 0 || state.input_committed != 0 {
            elist_commit_input(app)
        }
        return
    }

    if state.list_count == 0 {
        elist_draw_empty(app, x, y + AppScale(48), content_w)
        return
    }

    field_w := content_w - AppScale(92)
    typed: [ELIST_TITLE_SIZE]u8
    field := TextField(app.ui.session, elist_field(app,
        Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)field_w, cast(float32)AppScale(44)},
        typed[:]))
    elist_accept_field(app, field)
    if Button(app.ui.session, ButtonProps.{
        .bounds = Rectangle.{cast(float32)(x + field_w + AppScale(8)), cast(float32)(y), cast(float32)(AppScale(84)), cast(float32)(AppScale(44))},
        .label = ifx (state.editing_item >= 0) then (LocaleText("done_button")) else (LocaleText("elist_add_item")),
        .tone = cast(ButtonTone)ButtonToneAccent,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled,
        .disabled = state.input[0] == #char "\0"
    }) != 0 || state.input_committed != 0 {
        elist_commit_input(app)
    }
    y += AppScale(52)

    row_h := AppScale(58)
    now := GetTime()
    footer_h := AppScale(44)
    footer_y := app.ui.view_height - app_content_bottom_reserved(app) -
        AppScale(28) - footer_h
    if footer_y < y + AppScale(58) {
        footer_y = y + AppScale(58)
    }
    if Button(app.ui.session, ButtonProps.{
        .id = 6502,
        .bounds = Rectangle.{cast(float32)x, cast(float32)footer_y, cast(float32)content_w, cast(float32)footer_h},
        .label = ifx (state.show_completed != 0) then
            (LocaleText("elist_hide_completed")) else
            (LocaleText("elist_show_completed")),
        .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    }) != 0 {
        state.show_completed = ifx (state.show_completed == 0) then (1) else (0)
        state.scroll = 0
    }
    visible_count: s32 = 0
    {
        i: s32 = 0
        while i < state.item_count {
            if elist_item_visible(state, i, now) {
                visible_count += 1
            }
            i += 1
        }

    }
    scroll_key: u64 = cast(u64)6600
    scroll_bounds := Rectangle.{
        cast(float32)x, cast(float32)y,
        cast(float32)content_w,
        cast(float32)(footer_y - y - AppScale(12))
    }
    scroll := Scroll(app.ui.session, ScrollProps.{
        .key = scroll_key,
        .bounds = scroll_bounds,
        .content_height = visible_count * (row_h + AppScale(8)),
        .scroll_offset = state.scroll,
        .input = ScrollObservationFor(scroll_key, scroll_bounds)
    })
    state.scroll = scroll.scroll_offset
    CommitScroll(scroll_key, scroll.frame)
    if scroll.opened {
        row_y: s32 = cast(s32)scroll.content.y
        changed: bool = false
        index: s32 = 0
        while index < state.item_count {
            if !elist_item_visible(state, index, now) {
                index += 1
                continue
            }
            if row_y + row_h <= cast(s32)scroll.viewport.y ||
                row_y >= cast(s32)(scroll.viewport.y +
                    scroll.viewport.height) {
                row_y += row_h + AppScale(8)
                index += 1
                continue
            }
            item: *EListItem = *state.items[index]
            item_key := KeyHash(AppTextFromCString(*item.id[0], 37))
            Box(app.ui.session, BoxProps.{
                .key = item_key * cast(u64)4,
                .bounds = Rectangle.{cast(float32)x, cast(float32)row_y,
                    cast(float32)content_w, cast(float32)row_h},
                .fill = Color.{128, 128, 128, 24},
                .border = Color.{128, 128, 128, 48},
                .radius = cast(float32)AppScale(8)
            })

            checked := Checkbox(app.ui.session, CheckboxProps.{
                .key = item_key * cast(u64)4 + cast(u64)1,
                .bounds = Rectangle.{
                    cast(float32)(x + AppScale(10)),
                    cast(float32)(row_y + AppScale(17)),
                    cast(float32)AppScale(28),
                    cast(float32)AppScale(28)
                },
                .checked = item.done != 0
            })
            if checked.changed {
                elist_set_done(app, index,
                    ifx (checked.checked) then (1) else (0), now)
                changed = true
                break
            }

            has_comment := item.comment[0] != cast(u8)0
            title_height := ifx (has_comment) then (AppScale(24)) else (row_h)
            title_y: s32 = row_y
            if has_comment {
                title_y += AppScale(6)
            }
            Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{
                    cast(float32)(x + AppScale(46)),
                    cast(float32)title_y,
                    cast(float32)(content_w - AppScale(132)),
                    cast(float32)title_height
                },
                    .text = FrameTextHold(*app.ui.frame_text,
                        AppTextFromCString(*item.title[0],
                            ELIST_TITLE_SIZE)),
                .wrap = cast(TextWrap)TextWrapNone,
                .align = cast(TextAlign)TextAlignCenter,
                .vertical_align = cast(TextAlign)TextAlignCenter,
                .strikethrough = item.done != 0
            })
            if has_comment {
                Text(app.ui.session, TextProps.{
                    .bounds = Rectangle.{
                        cast(float32)(x + AppScale(46)),
                        cast(float32)(row_y + AppScale(32)),
                        cast(float32)(content_w - AppScale(132)),
                        cast(float32)AppScale(18)
                    },
                        .text = FrameTextHold(*app.ui.frame_text,
                            AppTextFromCString(*item.comment[0],
                                ELIST_COMMENT_SIZE)),
                    .wrap = cast(TextWrap)TextWrapNone
                })
            }
            if Button(app.ui.session, ButtonProps.{
                .key = item_key * cast(u64)4 + cast(u64)2,
                .bounds = Rectangle.{
                    cast(float32)(x + content_w - AppScale(78)),
                    cast(float32)(row_y + AppScale(12)),
                    cast(float32)AppScale(34), cast(float32)AppScale(34)
                },
                .label = "✎",
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            }) != 0 {
                elist_begin_input(app, index,
                    AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE))
            }
            if Button(app.ui.session, ButtonProps.{
                .key = item_key * cast(u64)4 + cast(u64)3,
                .bounds = Rectangle.{
                    cast(float32)(x + content_w - AppScale(40)),
                    cast(float32)(row_y + AppScale(12)),
                    cast(float32)AppScale(34), cast(float32)AppScale(34)
                },
                .label = "×",
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            }) != 0 {
                storage_elist_delete_item(
                    AppTextFromCString(*item.id[0], 37))
                elist_reload(app)
                app_auto_sync(app)
                changed = true
                break
            }
            row_y += row_h + AppScale(8)
            index += 1
        }
        End(app.ui.session)
        if changed {
            return
        }
    }
}

elist :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("elist/root")
    Screen(app.ui.session, root)
    draw_elist_screen(app)
    End(app.ui.session)
}
