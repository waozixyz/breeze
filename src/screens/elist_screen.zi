c :: #system_library "c";
GetTime :: () -> float64 #foreign c;
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c;
#import, file "../app/app_types.zi";
#import, file "../app/locale.zi";
#import, file "../platform/raylib_text_input.zi";
#import, file "../platform/scroll_input.zi";
