#import "button_props"
#import "geometry"
#import "text_align"
#import "text_props"
#import "control_props"
#import "drawing_props"
#import "button_widget"
#import "text_widget"
#import, file "../app/current_app.zi";
#import, file "../app/metrics.zi";
#import, file "../app/text_buffers.zi";
#import, file "../app/app_types.zi";

using ArrowDirection;
using TextAlign;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

practice_carousel_controls :: (bounds: Rectangle,
    count: s32, selected: s32, disabled: s32,
    id: s32) -> s32 {
    button_size := cast(float32)AppScale(48)
    inset := bounds.width * 0.08f
    button_y := bounds.y + (bounds.height - button_size) / 2
    result: s32 = -1

    if count <= 1 || bounds.width <= 0 || bounds.height <= 0 {
        return result
    }
    if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = Rectangle.{bounds.x + inset, button_y,
                button_size, button_size},
            .id = id + 1,
            .class_name = 0,
            .disabled = disabled != 0,
            .arrow = true, .direction = cast(ArrowDirection)ArrowLeft,
            .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
        }) != 0 {
        result = ifx (selected > 0) then (selected - 1) else (count - 1)
    }
    if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = Rectangle.{bounds.x + bounds.width - button_size - inset, button_y,
                button_size, button_size},
            .id = id + 2,
            .class_name = 0,
            .disabled = disabled != 0,
            .arrow = true, .direction = cast(ArrowDirection)ArrowRight,
            .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
        }) != 0 {
        result = ifx (selected < count - 1) then (selected + 1) else (0)
    }
    progress: [32]u8
    unused FormatTwoNumberTemplate("%d / %d", selected + 1, count,
        progress[:])
    Text(CurrentApp().ui.session, TextProps.{
            .text = FrameTextHold(*CurrentApp().ui.frame_text,
            AppTextFromCString(*progress[0], 32)),
            .bounds = bounds,
            .font = AppScale(18),
            .align = cast(TextAlign)TextAlignCenter,
            .vertical_align = cast(TextAlign)TextAlignCenter,
            .wrap = cast(TextWrap)TextWrapNone
        })
    return result
}
