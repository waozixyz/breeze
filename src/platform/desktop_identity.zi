// Application identity is selected before the desktop window is created.
DesktopIdentityInfo :: struct {
    app_id: string
    display_name: string
}

DesktopIdentity :: (debug_profile: bool) -> DesktopIdentityInfo {
    if debug_profile {
        return DesktopIdentityInfo.{
            .app_id = "xyz.waozi.inbe.debug",
            .display_name = "Inner Breeze (Debug)",
        }
    }
    return DesktopIdentityInfo.{
        .app_id = "xyz.waozi.inbe",
        .display_name = "Inner Breeze",
    }
}
