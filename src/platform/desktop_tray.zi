#import, file "desktop_tray_data.zi";
TRAY_WINDOWS :: #defined(_WIN32) && !#defined(KRYON_BACKEND_TERMI)
TRAY_GTK :: #defined(DESKTOP_TRAY_ENABLED) && !#defined(_WIN32) && !#defined(KRYON_BACKEND_TERMI) && !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB)
TRAY_INDICATOR :: #defined(DESKTOP_TRAY_AYATANA) || #defined(DESKTOP_TRAY_APPINDICATOR)

#if TRAY_GTK {
    #import, file "desktop_tray_gtk.zi";
}
#if TRAY_WINDOWS {
    #import, file "desktop_tray_windows.zi";
}

#program_export
DesktopTrayInit :: (spec: *DesktopTraySpec) -> s32 {
    #if TRAY_WINDOWS || TRAY_GTK {
        return TrayInit(spec)
    }
    unused spec
    return 0
}

#program_export
DesktopTrayVisible :: () -> s32 {
    #if TRAY_WINDOWS || TRAY_GTK {
        return TrayVisible()
    }
    return 0
}

#program_export
DesktopTrayShutdown :: () {
    #if TRAY_WINDOWS || TRAY_GTK {
        TrayShutdown()
    }
}

#program_export
DesktopTrayPollAction :: () -> s32 {
    #if TRAY_WINDOWS || TRAY_GTK {
        return TrayPollAction()
    }
    return 0
}

#program_export
DesktopTraySetStatus :: (text: *u8) {
    #if TRAY_WINDOWS || TRAY_GTK {
        TraySetStatus(text)
        return
    }
    unused text
}

#program_export
DesktopTraySetMenu :: (items: *DesktopTrayMenuItem, count: s32) {
    #if TRAY_WINDOWS || TRAY_GTK {
        TraySetMenu(items, count)
        return
    }
    unused items
    unused count
}

#program_export
DesktopTraySetActivateAction :: (action: s32) {
    #if TRAY_WINDOWS || TRAY_GTK {
        TraySetActivate(action)
        return
    }
    unused action
}

#program_export
DesktopTraySetIcon :: (icon_path: *u8) {
    #if TRAY_WINDOWS || TRAY_GTK {
        TraySetIcon(icon_path)
        return
    }
    unused icon_path
}
