c :: #system_library "c";

#if #defined(PLATFORM_WEB) {
    BrowserStorageFlush :: (log_success: s32) #foreign c "browser_storage_flush";
    BrowserStorageWait :: (timeout_ms: s32, log_success: s32) -> s32 #foreign c "browser_storage_wait";
    BrowserExtensionHost :: () -> s32 #foreign c "web_extension_host_js";
}

#program_export
app_web_storage_flush :: (log_success: s32) {
    #if #defined(PLATFORM_WEB) {
        BrowserStorageFlush(log_success)
    }
    unused log_success
}

#program_export
app_web_storage_flush_critical :: (timeout_ms: s32, log_success: s32) -> s32 {
    #if #defined(PLATFORM_WEB) {
        return BrowserStorageWait(timeout_ms, log_success)
    }
    unused timeout_ms
    unused log_success
    return 1
}

#program_export
app_web_extension_available :: () -> s32 {
    #if #defined(PLATFORM_WEB) {
        return BrowserExtensionHost()
    }
    return 0
}
