// The native Plan 9 test build intentionally has no persistent SQLite
// engine. These handles retain the old successful/no-rows stub semantics.
#if #defined(PLAN9_BUILD) && !#defined(PLAN9_SQLITE_VFS) {
    #import "c_string"
    c :: #system_library "c";
    Plan9SqliteAllocate :: (count: usize, bytes: usize) -> *void #foreign c "calloc";
    Plan9SqliteRelease :: (memory: *void) #foreign c "free";
    Plan9SqliteLength :: (text: *u8) -> usize #foreign c "strlen";
    Plan9SqliteError: [64]u8;
    Plan9SqliteEmpty: [1]u8;

    #program_export
    sqlite3_open :: (filename: *u8, database: **void) -> s32 {
        unused filename
        if database == null {
            return 21
        }
        database.* = Plan9SqliteAllocate(1, 1)
        if database.* == null {
            return 7
        }
        return 0
    }

    #program_export
    sqlite3_open_v2 :: (filename: *u8, database: **void,
        flags: s32, vfs: *u8) -> s32 {
        unused flags
        unused vfs
        return sqlite3_open(filename, database)
    }

    #program_export
    sqlite3_close :: (database: *void) -> s32 {
        Plan9SqliteRelease(database)
        return 0
    }

    #program_export
    sqlite3_exec :: (database: *void, sql: *u8, callback: *void,
        argument: *void, error: **u8) -> s32 {
        unused database
        unused sql
        unused callback
        unused argument
        if error != null {
            error.* = null
        }
        return 0
    }

    #program_export
    sqlite3_prepare_v2 :: (database: *void, sql: *u8, length: s32,
        statement: **void, tail: **u8) -> s32 {
        unused database
        if statement == null {
            return 21
        }
        statement.* = Plan9SqliteAllocate(1, 1)
        if statement.* == null {
            return 7
        }
        if tail != null {
            tail.* = null
            if sql != null {
                count := cast(usize)length
                if length < 0 {
                    count = Plan9SqliteLength(sql)
                }
                tail.* = *sql[count]
            }
        }
        return 0
    }

    #program_export
    sqlite3_finalize :: (statement: *void) -> s32 {
        Plan9SqliteRelease(statement)
        return 0
    }

    #program_export
    sqlite3_column_text :: (statement: *void, column: s32) -> *u8 {
        unused statement
        unused column
        return *Plan9SqliteEmpty[0]
    }

    #program_export
    sqlite3_errmsg :: (database: *void) -> *u8 {
        unused database
        CopyCString("sqlite unavailable on Plan 9 test build", Plan9SqliteError[:])
        return *Plan9SqliteError[0]
    }

    #program_export
    sqlite3_free :: (memory: *void) {
        Plan9SqliteRelease(memory)
    }

    #program_export
    sqlite3_busy_timeout :: (database: *void, milliseconds: s32) -> s32 {
        unused database
        unused milliseconds
        return 0
    }

    #program_export
    sqlite3_step :: (statement: *void) -> s32 {
        unused statement
        return 101
    }

    #program_export
    sqlite3_reset :: (statement: *void) -> s32 {
        unused statement
        return 0
    }

    #program_export
    sqlite3_clear_bindings :: (statement: *void) -> s32 {
        unused statement
        return 0
    }

    #program_export
    sqlite3_bind_parameter_count :: (statement: *void) -> s32 {
        unused statement
        return 0
    }

    #program_export
    sqlite3_bind_int :: (statement: *void, index: s32, value: s32) -> s32 {
        unused statement
        unused index
        unused value
        return 0
    }

    #program_export
    sqlite3_bind_int64 :: (statement: *void, index: s32, value: s64) -> s32 {
        unused statement
        unused index
        unused value
        return 0
    }

    #program_export
    sqlite3_bind_text :: (statement: *void, index: s32, value: *u8, length: s32, destructor: *void) -> s32 {
        unused statement
        unused index
        unused value
        unused length
        unused destructor
        return 0
    }

    #program_export
    sqlite3_column_int :: (statement: *void, column: s32) -> s32 {
        unused statement
        unused column
        return 0
    }

    #program_export
    sqlite3_column_int64 :: (statement: *void, column: s32) -> s64 {
        unused statement
        unused column
        return 0
    }

    #program_export
    sqlite3_column_double :: (statement: *void, column: s32) -> float64 {
        unused statement
        unused column
        return 0.0
    }

    #program_export
    sqlite3_changes :: (database: *void) -> s32 {
        unused database
        return 0
    }

    #program_export
    sqlite3_db_cacheflush :: (database: *void) -> s32 {
        unused database
        return 0
    }

    #program_export
    sqlite3_get_autocommit :: (database: *void) -> s32 {
        unused database
        return 1
    }

    #program_export
    sqlite3_db_mutex :: (database: *void) -> *void {
        unused database
        return null
    }

    #program_export
    sqlite3_mutex_enter :: (mutex: *void) {
        unused mutex
    }

    #program_export
    sqlite3_mutex_leave :: (mutex: *void) {
        unused mutex
    }
}
