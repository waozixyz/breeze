// Plan 9 currently has no archive importer. Keep that capability unavailable
// while preserving the current Ziran string ABI and clearing inspection data.
#if #defined(PLAN9_BUILD) {
    Plan9ImportInfo :: struct {
        valid: s32
        has_sessions: s32
        has_habits: s32
        has_settings: s32
        session_count: s32
        habit_count: s32
        setting_count: s32
    }

    #program_export
    storage_export_zip :: (path: string) -> s32 {
        unused path
        return 0
    }

    #program_export
    storage_import_zip :: (path: string) -> s32 {
        unused path
        return 0
    }

    #program_export
    storage_import_zip_ex :: (path: string, mode: s32) -> s32 {
        unused path
        unused mode
        return 0
    }

    #program_export
    storage_inspect_import :: (path: string, info: *Plan9ImportInfo) -> s32 {
        unused path
        if info != null {
            info.valid = 0
            info.has_sessions = 0
            info.has_habits = 0
            info.has_settings = 0
            info.session_count = 0
            info.habit_count = 0
            info.setting_count = 0
        }
        return 0
    }
}
