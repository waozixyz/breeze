c :: #system_library "c";
#import, file "../../app/app_types.zi";


#import, file "../../app/app.zi";
#import "drawing_props"
#import "geometry"

#if false {
    #program_export
    Plan9Run :: () -> string {
        InitWindow(900, 720, "Inner Breeze")
        if !IsWindowReady() {
            return "window"
        }

        SetExitKey(0)
        InitDPI()
        SetTargetFPS(60)

        ChangeDirectory("/sys/src/breathing")
        app: InnerBreeze = InnerBreeze.{}
        app_init(*app)
        SetCurrentApp(*app)

        while !WindowShouldClose() {
            viewport := Rectangle.{0, 0,
                                    cast(float32)GetScreenWidth(),
                                    cast(float32)GetScreenHeight()
}
            BeginDrawing()
            ClearBackground(StyleTokenColor("canvas"))
            app_update_draw(*app, viewport)
            EndDrawing()
        }

        app_destroy(*app)
        SetCurrentApp(null)
        CloseWindow()
        return null
    }
}
