// The window, pointer, and screenshot ABI used by Inbe's platform layer.
#import "c_string"
#import "drawing_props"
#import "geometry"
#import, file "../../vendor/kryon/src/backend/raylib_runtime.zi";
#if #defined(PLATFORM_WEB) {
    #import, file "../../vendor/kryon/src/backend/canvas_runtime.zi";
}

raylib :: #system_library "raylib";

FLAG_WINDOW_RESIZABLE :: 4
FLAG_WINDOW_ALWAYS_RUN :: 256
KEY_SPACE :: 32
KEY_BACK :: 4
KEY_ESCAPE :: 256
KEY_ENTER :: 257
KEY_TAB :: 258
KEY_RIGHT :: 262
KEY_LEFT :: 263
KEY_KB_MENU :: 348
MOUSE_BUTTON_LEFT :: 0
MOUSE_BUTTON_RIGHT :: 1

RaylibImage :: struct {
    data: *void
    width: s32
    height: s32
    mipmaps: s32
    format: s32
}

HostInitWindow :: (width: s32, height: s32, title: *u8) #foreign raylib "InitWindow";
HostExportImage :: (image: RaylibImage, path: *u8) -> bool #foreign raylib "ExportImage";


InitWindow :: (width: s32, height: s32, title: string) {
    title_bytes: [256]u8
    if !CopyCString(title, title_bytes[:]) {
        return
    }
    HostInitWindow(width, height, *title_bytes[0])
}

ExportImage :: (image: RaylibImage, path: string) -> bool {
    path_bytes: [4096]u8
    if !CopyCString(path, path_bytes[:]) {
        return false
    }
    return HostExportImage(image, *path_bytes[0])
}
