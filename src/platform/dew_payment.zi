// Dew works in every edition: the balance, storage plans, practice unlocks
// and app rewards are paid in Dew. The direct and F-Droid editions top Dew up
// with Monero; the Google Play edition (the GOOGLE_PLAY define) sells Dew
// packs through Google Play (entity/dew_play) once Play Billing answers.
#import "entity/dew_play"

dew_play: DewPlay;

// Called once at start, before the first frame asks for Dew.
DewPaymentStart :: () {
    dew_play.enabled = DewPlayEdition()
}

DewAvailable :: () -> bool { return true }

DewTopUpAvailable :: () -> bool {
    if dew_play.enabled {
        return dew_play.available
    }
    return true
}
