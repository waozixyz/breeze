// Dew works in every build: the balance, storage plans, practice unlocks and
// app rewards are paid in Dew. Only topping Dew up with Monero is left out of
// the Play build, whose activity reports it.
#if #defined(ANDROID_BUILD) {
    #import "android_jni"
}

dew_channel_known: bool;
dew_channel_available: bool;

DewAvailable :: () -> bool { return true }

DewTopUpAvailable :: () -> bool {
    #if #defined(ANDROID_BUILD) {
        if !dew_channel_known {
            session: AndroidJniSession
            if AndroidJniAttachCurrent(*session) == 0 {
                return false
            }
            method := AndroidJniMethod(*session, "dewAvailable", "()Z")
            if method != null {
                dew_channel_available = session.env.functions.CallBooleanMethodA(
                    session.env, session.activity, method, null) != 0
                if session.env.functions.ExceptionCheck(session.env) != 0 {
                    dew_channel_available = false
                }
            }
            AndroidJniDetachCurrent(*session)
            dew_channel_known = true
        }
        return dew_channel_available
    }
    return true
}
