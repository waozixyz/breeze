// Audio selections use the same owned child-process picker as data files.
#import "file_picker"
#import "c_string"

#program_export
app_audio_pick_file :: (title: *u8, music: bool,
    output: *u8, capacity: s32) -> s32 {
    filter: [80]u8
    if music {
        if !CopyCString("Audio files | *.ogg *.wav *.qoa *.xm *.mod *.mp3 *.flac *.m4a *.opus", filter[:]) {
            return -1
        }
    } else {
        if !CopyCString("Sound files | *.ogg *.wav *.qoa", filter[:]) {
            return -1
        }
    }
    return PickPosixFile(title, *filter[0], null, false, output, capacity)
}
