// Optional command-line tools dispatch before ordinary application startup.
#import, file "../../apps/practice/practice_probe.zi";
#import, file "app_host.zi";
#import, file "raylib_host.zi";
#import, file "host_window.zi";
#import, file "../app/app_types.zi";

OpenProbeWindow :: (size: WindowSize, title: string) -> bool {
    #if #defined(DESKTOP_HOST) {
        return HostOpenWindow(size.width, size.height, title)
    } else {
        InitWindow(size.width, size.height, title)
        return true
    }
}

// A negative result means no tool accepted the command line.
TryRunStartupTool :: (app: *InnerBreeze, argc: s32, argv: **u8) -> s32 {
    mode := PracticeProbeMode(argc, argv)
    if mode == 0 {
        return -1
    }
    size: WindowSize
    if mode == 1 || mode == 4 {
        size = ifx mode == 4 then WindowSize.{480, 780}
        else WindowSize.{900, 720}
        if !OpenProbeWindow(size, "Practice component probe") {
            return 1
        }
    } else {
        Prepare(argc, argv)
        size = InitialWindowSize()
        ConfigureWindow()
        if !OpenProbeWindow(size, WindowTitle()) || FinishWindowSetup() == 0 {
            return 1
        }
    }
    return RunPracticeProbe(app, mode, size)
}
