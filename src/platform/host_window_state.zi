// The app's main window among the desktop's windows: focus, title, hiding to
// the tray, minimize, restore and the monitor it is on: on Kryon's desktop
// host its SDL window, in a browser the canvas's page. Focus is a question
// every host answers. Android's activity has no desktop window: hiding,
// minimizing and restoring leave it as it is.
#if #defined(DESKTOP_HOST) {
    Desktop :: #import "desktop_runtime";
    WindowState :: #import "desktop_window_state";
} else #if #defined(ANDROID_BUILD) {
    Runtime :: #import "android_runtime";
    #import, file "host_window.zi";
} else #if !#defined(PLATFORM_WEB) {
    #import, file "host_window.zi";
} else #if #defined(PLATFORM_WEB) {
    #import "c_string"
    CanvasWindow :: #import "canvas_window";
    // The canvas's FLAG_WINDOW_HIDDEN, and with FLAG_WINDOW_MINIMIZED.
    CANVAS_WINDOW_HIDDEN :: 128
    CANVAS_WINDOW_HIDDEN_MINIMIZED :: 640
}

// Whether the window has the keyboard focus.
HostWindowFocused :: () -> bool {
    #if #defined(DESKTOP_HOST) {
        return Desktop.WindowFocusedHost()
    } else #if #defined(ANDROID_BUILD) {
        return Runtime.AndroidHostFocused()
    } else #if #defined(PLATFORM_WEB) {
        return CanvasWindow.IsWindowFocused()
    } else {
        return false
    }
}

HostSetWindowTitle :: (title: string) {
    #if #defined(DESKTOP_HOST) {
        unused Desktop.DesktopSetTitle(title)
    } else #if !#defined(PLATFORM_WEB) {
        unused title
    } else {
        bytes: [256]u8
        if CopyCString(title, bytes[:]) {
            CanvasWindow.SetWindowTitle(*bytes[0])
        }
    }
}

// Shows a hidden window, as from the tray.
HostShowWindow :: () {
    #if #defined(DESKTOP_HOST) {
        Desktop.WindowSetVisibleHost(true)
    } else #if #defined(PLATFORM_WEB) {
        CanvasWindow.ClearWindowState(cast(u32)CANVAS_WINDOW_HIDDEN)
    }
}

// Hides the window while the app keeps running in the tray.
HostHideWindow :: () {
    #if #defined(DESKTOP_HOST) {
        Desktop.WindowSetVisibleHost(false)
    } else #if #defined(PLATFORM_WEB) {
        CanvasWindow.SetWindowState(cast(u32)CANVAS_WINDOW_HIDDEN)
    }
}

HostMinimizeWindow :: () {
    #if #defined(DESKTOP_HOST) {
        unused WindowState.DesktopMinimize()
    } else #if #defined(PLATFORM_WEB) {
        CanvasWindow.MinimizeWindow()
    }
}

// Brings a minimized or hidden-behind window back and gives it focus.
HostRestoreAndFocusWindow :: () {
    #if #defined(DESKTOP_HOST) {
        Desktop.WindowSetVisibleHost(true)
        unused WindowState.DesktopRestore()
        unused WindowState.DesktopRaise()
    } else #if #defined(PLATFORM_WEB) {
        CanvasWindow.ClearWindowState(cast(u32)CANVAS_WINDOW_HIDDEN_MINIMIZED)
        CanvasWindow.RestoreWindow()
        CanvasWindow.SetWindowFocused()
    }
}

// The monitor the window is on, in pixels: the screen itself on Android.
HostMonitorSize :: () -> (width: s32, height: s32) {
    #if #defined(DESKTOP_HOST) {
        bounds := WindowState.DesktopMonitorBounds()
        return cast(s32)bounds.width, cast(s32)bounds.height
    } else #if !#defined(PLATFORM_WEB) {
        return HostWindowWidth(), HostWindowHeight()
    } else {
        monitor := CanvasWindow.GetCurrentMonitor()
        return CanvasWindow.GetMonitorWidth(monitor), CanvasWindow.GetMonitorHeight(monitor)
    }
}
