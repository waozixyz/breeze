// Key and mouse button codes the app's input reads. Kryon's desktop keys,
// Android's normalized keys and the browser canvas share this numbering.
KEY_SPACE :: 32
KEY_BACK :: 4
KEY_ESCAPE :: 256
KEY_ENTER :: 257
KEY_TAB :: 258
KEY_RIGHT :: 262
KEY_LEFT :: 263
KEY_KB_MENU :: 348
MOUSE_BUTTON_LEFT :: 0
MOUSE_BUTTON_RIGHT :: 1
