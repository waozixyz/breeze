// Seconds on the host's frame clock: raylib's, counted from when its window
// opened, or on Kryon's desktop host the monotonic clock. Callers compare
// and subtract these values; neither clock is wall time.
#if #defined(DESKTOP_HOST) {
    host_clock_c :: #system_library "c";
    HostMonotonicSeconds :: () -> float64 #foreign host_clock_c "app_monotonic_seconds";
} else {
    host_clock_raylib :: #system_library "raylib";
    HostRaylibSeconds :: () -> float64 #foreign host_clock_raylib "GetTime";
}

HostSeconds :: () -> float64 {
    #if #defined(DESKTOP_HOST) {
        return HostMonotonicSeconds()
    } else {
        return HostRaylibSeconds()
    }
}
