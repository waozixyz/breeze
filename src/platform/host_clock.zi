// Seconds on the host's frame clock: the monotonic clock natively, or in a
// browser the canvas's clock from when its page opened. Callers compare and
// subtract these values; neither clock is wall time.
#if #defined(PLATFORM_WEB) {
    CanvasWindow :: #import "canvas_window";
} else {
    host_clock_c :: #system_library "c";
    HostMonotonicSeconds :: () -> float64 #foreign host_clock_c "app_monotonic_seconds";
    host_frame_started: float64;
    host_frame_seconds: float32;
    HostSleepMicroseconds :: (microseconds: u32) -> s32 #foreign host_clock_c "usleep";
}

HostSeconds :: () -> float64 {
    #if #defined(PLATFORM_WEB) {
        return CanvasWindow.GetTime()
    } else {
        return HostMonotonicSeconds()
    }
}

// Waits SECONDS without drawing.
HostWait :: (seconds: float64) {
    #if #defined(PLATFORM_WEB) {
        CanvasWindow.WaitTime(seconds)
    } else {
        if seconds > 0.0 {
            unused HostSleepMicroseconds(cast(u32)(seconds * 1000000.0))
        }
    }
}

// How long the last frame took, from its start to this one's, in seconds.
HostFrameSeconds :: () -> float32 {
    #if #defined(PLATFORM_WEB) {
        return CanvasWindow.GetFrameTime()
    } else {
        return host_frame_seconds
    }
}

#if !#defined(PLATFORM_WEB) {
    // The frame loop calls this as each frame begins.
    HostFrameStarted :: () {
        now := HostMonotonicSeconds()
        if host_frame_started > 0.0 {
            host_frame_seconds = cast(float32)(now - host_frame_started)
        }
        host_frame_started = now
    }
}
