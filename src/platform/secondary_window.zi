#import "c_string"
#import "drawing_props"
#import "geometry"
#import "session"
#import "tree"
#import "tree_draw"

#import, file "secondary_window_host.zi";

// A secondary window is owned by this process. The platform host accepts
// only handles it created and never acts on a window found on the display.
SecondaryWindow :: struct {
    handle: *void
}

#program_export
OpenSecondaryWindow :: (title: string, x: s32, y: s32, width: s32,
    height: s32, flags: s32, background: Color,
    scale: float32) -> SecondaryWindow {
    window: SecondaryWindow
    title_bytes: [128]u8
    if !CopyCString(title, title_bytes[:]) {
        return window
    }
    window.handle = app_secondary_window_open(*title_bytes[0], x, y, width,
        height, flags, background.r, background.g, background.b,
        background.a, scale)
    return window
}

#program_export
CloseSecondaryWindow :: (window: SecondaryWindow) {
    if window.handle != null {
        app_secondary_window_close(window.handle)
    }
}

#program_export
BeginSecondaryWindow :: (window: SecondaryWindow) -> bool {
    if window.handle == null {
        return false
    }
    return app_secondary_window_begin(window.handle)
}

#program_export
EndSecondaryWindow :: (window: SecondaryWindow) -> bool {
    if window.handle == null {
        return false
    }
    return app_secondary_window_end(window.handle)
}

#program_export
PumpSecondaryWindows :: () {
    app_secondary_window_pump()
}

#program_export
IsSecondaryWindowClicked :: (window: SecondaryWindow) -> bool {
    return window.handle != null && app_secondary_window_clicked(window.handle)
}

#program_export
IsSecondaryWindowRightClicked :: (window: SecondaryWindow) -> bool {
    return window.handle != null && app_secondary_window_right_clicked(window.handle)
}

#program_export
IsSecondaryWindowDragged :: (window: SecondaryWindow) -> bool {
    return window.handle != null && app_secondary_window_dragged(window.handle)
}

TakeSecondaryWindowClose :: (window: SecondaryWindow) -> bool {
    return window.handle != null && app_secondary_window_take_close(window.handle)
}

GetSecondaryWindowSize :: (window: SecondaryWindow, width: *s32, height: *s32) {
    app_secondary_window_size(window.handle, width, height)
}

#program_export
SetSecondaryWindowKeyboardGrab :: (window: SecondaryWindow,
    enabled: bool) -> bool {
    return window.handle != null &&
    app_secondary_window_keyboard_grab(window.handle, enabled)
}

#program_export
GetSecondaryWindowPosition :: (window: SecondaryWindow, x: *s32, y: *s32) {
    app_secondary_window_position(window.handle, x, y)
}

#program_export
GetSecondaryWindowClickPosition :: (window: SecondaryWindow,
    x: *s32, y: *s32) {
    app_secondary_window_click_position(window.handle, x, y)
}

#program_export
BeginSecondaryFrame :: (session: Session, width: s32, height: s32) -> bool {
    bounds := Rectangle.{0.0, 0.0, cast(float32)width, cast(float32)height}
    return cast(s32)BeginFrame(session, cast(u64)1, bounds) == 0
}

#program_export
EndSecondaryFrame :: (session: Session) {
    unused EndFrame(session)
}

#program_export
CloseSecondarySession :: (session: Session) {
    if SessionValid(session) {
        unused CloseSession(session)
    }
}
