#if #defined(DESKTOP_TRAY_ENABLED) && !#defined(_WIN32) && !#defined(KRYON_BACKEND_TERMI) && !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) {
    // GTK is loaded only when a desktop tray is requested. All GTK-owned objects
    // remain on the tray thread; this module only owns the resolved library table.
    #import "c_string"
    c :: #system_library "c";
    dl :: #system_library "dl";
    #scope_export
    GtkIdleCallback :: #type (*void) -> s32 #c_call;
    GtkOnceCallback :: #type () -> void #c_call;
    GtkDlOpen :: (path: *u8, flags: s32) -> *void #foreign dl "dlopen";
    GtkDlSymbol :: (handle: *void, name: *u8) -> *void #foreign dl "dlsym";
    GtkDlCopy :: (target: *void, source: *void, bytes: usize) -> *void #foreign c "memcpy";
    GtkOnce :: (state: *s32, routine: GtkOnceCallback) -> s32 #foreign c "pthread_once";

    gtk_load_once: s32;
    gtk_load_ready: s32;
    GtkFn_gtk_init_check :: #type (*void, *void) -> s32 #c_call;
    LoadedGtkInitCheck: GtkFn_gtk_init_check;
    GtkFn_gtk_menu_new :: #type () -> *void #c_call;
    LoadedGtkMenuNew: GtkFn_gtk_menu_new;
    GtkFn_gtk_menu_item_new_with_label :: #type (*u8) -> *void #c_call;
    LoadedGtkMenuItemNewWithLabel: GtkFn_gtk_menu_item_new_with_label;
    GtkFn_gtk_menu_item_set_submenu :: #type (*void, *void) -> void #c_call;
    LoadedGtkMenuItemSetSubmenu: GtkFn_gtk_menu_item_set_submenu;
    GtkFn_gtk_separator_menu_item_new :: #type () -> *void #c_call;
    LoadedGtkSeparatorMenuItemNew: GtkFn_gtk_separator_menu_item_new;
    GtkFn_gtk_menu_shell_append :: #type (*void, *void) -> void #c_call;
    LoadedGtkMenuShellAppend: GtkFn_gtk_menu_shell_append;
    GtkFn_gtk_widget_set_sensitive :: #type (*void, s32) -> void #c_call;
    LoadedGtkWidgetSetSensitive: GtkFn_gtk_widget_set_sensitive;
    GtkFn_gtk_widget_show_all :: #type (*void) -> void #c_call;
    LoadedGtkWidgetShowAll: GtkFn_gtk_widget_show_all;
    GtkFn_gtk_menu_popup :: #type (*void, *void, *void, *void, *void, u32, u32) -> void #c_call;
    LoadedGtkMenuPopup: GtkFn_gtk_menu_popup;
    GtkFn_gtk_status_icon_position_menu :: #type (*void, *s32, *s32, *s32, *void) -> void #c_call;
    LoadedGtkStatusIconPositionMenu: GtkFn_gtk_status_icon_position_menu;
    GtkFn_gtk_status_icon_new_from_file :: #type (*u8) -> *void #c_call;
    LoadedGtkStatusIconNewFromFile: GtkFn_gtk_status_icon_new_from_file;
    GtkFn_gtk_status_icon_new_from_icon_name :: #type (*u8) -> *void #c_call;
    LoadedGtkStatusIconNewFromIconName: GtkFn_gtk_status_icon_new_from_icon_name;
    GtkFn_gtk_status_icon_set_title :: #type (*void, *u8) -> void #c_call;
    LoadedGtkStatusIconSetTitle: GtkFn_gtk_status_icon_set_title;
    GtkFn_gtk_status_icon_set_tooltip_text :: #type (*void, *u8) -> void #c_call;
    LoadedGtkStatusIconSetTooltipText: GtkFn_gtk_status_icon_set_tooltip_text;
    GtkFn_gtk_status_icon_set_visible :: #type (*void, s32) -> void #c_call;
    LoadedGtkStatusIconSetVisible: GtkFn_gtk_status_icon_set_visible;
    GtkFn_gtk_status_icon_is_embedded :: #type (*void) -> s32 #c_call;
    LoadedGtkStatusIconIsEmbedded: GtkFn_gtk_status_icon_is_embedded;
    GtkFn_gtk_status_icon_set_from_file :: #type (*void, *u8) -> void #c_call;
    LoadedGtkStatusIconSetFromFile: GtkFn_gtk_status_icon_set_from_file;
    GtkFn_gtk_status_icon_set_from_icon_name :: #type (*void, *u8) -> void #c_call;
    LoadedGtkStatusIconSetFromIconName: GtkFn_gtk_status_icon_set_from_icon_name;
    GtkFn_gtk_main :: #type () -> void #c_call;
    LoadedGtkMain: GtkFn_gtk_main;
    GtkFn_gtk_main_quit :: #type () -> void #c_call;
    LoadedGtkMainQuit: GtkFn_gtk_main_quit;
    GtkFn_gtk_widget_destroy :: #type (*void) -> void #c_call;
    LoadedGtkWidgetDestroy: GtkFn_gtk_widget_destroy;
    GtkFn_g_idle_add :: #type (*void, *void) -> u32 #c_call;
    LoadedGIdleAdd: GtkFn_g_idle_add;
    GtkFn_g_signal_connect_data :: #type (*void, *u8, *void, *void, *void, s32) -> usize #c_call;
    LoadedGSignalConnectData: GtkFn_g_signal_connect_data;
    GtkFn_g_file_test :: #type (*u8, s32) -> s32 #c_call;
    LoadedGFileTest: GtkFn_g_file_test;
    GtkFn_g_canonicalize_filename :: #type (*u8, *u8) -> *u8 #c_call;
    LoadedGCanonicalizeFilename: GtkFn_g_canonicalize_filename;
    GtkFn_g_free :: #type (*void) -> void #c_call;
    LoadedGFree: GtkFn_g_free;
    GtkFn_g_get_monotonic_time :: #type () -> s64 #c_call;
    LoadedGGetMonotonicTime: GtkFn_g_get_monotonic_time;
    GtkFn_g_object_unref :: #type (*void) -> void #c_call;
    LoadedGObjectUnref: GtkFn_g_object_unref;

    GtkFn_app_indicator_new :: #type (*u8, *u8, s32) -> *void #c_call;
    LoadedAppIndicatorNew: GtkFn_app_indicator_new;
    GtkFn_app_indicator_set_status :: #type (*void, s32) -> void #c_call;
    LoadedAppIndicatorSetStatus: GtkFn_app_indicator_set_status;
    GtkFn_app_indicator_set_menu :: #type (*void, *void) -> void #c_call;
    LoadedAppIndicatorSetMenu: GtkFn_app_indicator_set_menu;
    GtkFn_app_indicator_set_title :: #type (*void, *u8) -> void #c_call;
    LoadedAppIndicatorSetTitle: GtkFn_app_indicator_set_title;
    GtkFn_app_indicator_set_icon_full :: #type (*void, *u8, *u8) -> void #c_call;
    LoadedAppIndicatorSetIconFull: GtkFn_app_indicator_set_icon_full;

    GtkResolve :: (handle: *void, slot: *void, name: string) {
        bytes: [128]u8
        if !CopyCString(name, bytes[:]) {
            gtk_load_ready = 0
            return
        }
        symbol := GtkDlSymbol(handle, *bytes[0])
        if symbol == null {
            gtk_load_ready = 0
        }
        GtkDlCopy(slot, cast(*void)*symbol, size_of(*void))
    }

    GtkOpen :: (name: string) -> *void {
        bytes: [96]u8
        if !CopyCString(name, bytes[:]) {
            return null
        }
        return GtkDlOpen(*bytes[0], 257)
    }

    GtkLoad :: () {
        handle := GtkOpen("libgtk-3.so.0")
        if handle == null {
            return
        }
        gtk_load_ready = 1
        GtkResolve(handle, cast(*void)*LoadedGtkInitCheck, "gtk_init_check")
        GtkResolve(handle, cast(*void)*LoadedGtkMenuNew, "gtk_menu_new")
        GtkResolve(handle, cast(*void)*LoadedGtkMenuItemNewWithLabel, "gtk_menu_item_new_with_label")
        GtkResolve(handle, cast(*void)*LoadedGtkMenuItemSetSubmenu, "gtk_menu_item_set_submenu")
        GtkResolve(handle, cast(*void)*LoadedGtkSeparatorMenuItemNew, "gtk_separator_menu_item_new")
        GtkResolve(handle, cast(*void)*LoadedGtkMenuShellAppend, "gtk_menu_shell_append")
        GtkResolve(handle, cast(*void)*LoadedGtkWidgetSetSensitive, "gtk_widget_set_sensitive")
        GtkResolve(handle, cast(*void)*LoadedGtkWidgetShowAll, "gtk_widget_show_all")
        GtkResolve(handle, cast(*void)*LoadedGtkMenuPopup, "gtk_menu_popup")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconPositionMenu, "gtk_status_icon_position_menu")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconNewFromFile, "gtk_status_icon_new_from_file")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconNewFromIconName, "gtk_status_icon_new_from_icon_name")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconSetTitle, "gtk_status_icon_set_title")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconSetTooltipText, "gtk_status_icon_set_tooltip_text")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconSetVisible, "gtk_status_icon_set_visible")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconIsEmbedded, "gtk_status_icon_is_embedded")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconSetFromFile, "gtk_status_icon_set_from_file")
        GtkResolve(handle, cast(*void)*LoadedGtkStatusIconSetFromIconName, "gtk_status_icon_set_from_icon_name")
        GtkResolve(handle, cast(*void)*LoadedGtkMain, "gtk_main")
        GtkResolve(handle, cast(*void)*LoadedGtkMainQuit, "gtk_main_quit")
        GtkResolve(handle, cast(*void)*LoadedGtkWidgetDestroy, "gtk_widget_destroy")
        GtkResolve(handle, cast(*void)*LoadedGIdleAdd, "g_idle_add")
        GtkResolve(handle, cast(*void)*LoadedGSignalConnectData, "g_signal_connect_data")
        GtkResolve(handle, cast(*void)*LoadedGFileTest, "g_file_test")
        GtkResolve(handle, cast(*void)*LoadedGCanonicalizeFilename, "g_canonicalize_filename")
        GtkResolve(handle, cast(*void)*LoadedGFree, "g_free")
        GtkResolve(handle, cast(*void)*LoadedGGetMonotonicTime, "g_get_monotonic_time")
        GtkResolve(handle, cast(*void)*LoadedGObjectUnref, "g_object_unref")
        #if #defined(DESKTOP_TRAY_AYATANA) || #defined(DESKTOP_TRAY_APPINDICATOR) {
            indicator: *void
            #if #defined(DESKTOP_TRAY_AYATANA) {
                indicator = GtkOpen("libayatana-appindicator3.so.1")
            }
            #if #defined(DESKTOP_TRAY_APPINDICATOR) {
                indicator = GtkOpen("libappindicator3.so.1")
            }
            if indicator == null {
                gtk_load_ready = 0
                return
            }
            GtkResolve(indicator, cast(*void)*LoadedAppIndicatorNew, "app_indicator_new")
            GtkResolve(indicator, cast(*void)*LoadedAppIndicatorSetStatus, "app_indicator_set_status")
            GtkResolve(indicator, cast(*void)*LoadedAppIndicatorSetMenu, "app_indicator_set_menu")
            GtkResolve(indicator, cast(*void)*LoadedAppIndicatorSetTitle, "app_indicator_set_title")
            GtkResolve(indicator, cast(*void)*LoadedAppIndicatorSetIconFull, "app_indicator_set_icon_full")
        }
    }

    DesktopTrayGtkEnsure :: () -> s32 {
        routine: GtkOnceCallback = GtkLoad
        if GtkOnce(*gtk_load_once, routine) != 0 {
            return 0
        }
        return gtk_load_ready
    }
}
