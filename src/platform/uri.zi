#import "c_string"

c :: #system_library "c";
native_open_uri :: (uri: *u8) -> s32 #foreign c "OpenURI";
native_can_open_uri :: (uri: *u8) -> s32 #foreign c "CanOpenURI";

UriCapacity :: 4096

#program_export
OpenUri :: (uri: string) -> bool {
    bytes: [UriCapacity]u8
    if uri.count == 0 || !CopyCString(uri, bytes[:]) {
        return false
    }
    return native_open_uri(*bytes[0]) != 0
}

#program_export
CanOpenUri :: (uri: string) -> bool {
    bytes: [UriCapacity]u8
    if uri.count == 0 || !CopyCString(uri, bytes[:]) {
        return false
    }
    return native_can_open_uri(*bytes[0]) != 0
}
