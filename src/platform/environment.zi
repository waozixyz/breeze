c :: #system_library "c";

native_desktop_platform :: () -> s32 #foreign c "app_desktop_platform";
native_web_platform :: () -> s32 #foreign c "app_web_platform";
native_android_platform :: () -> s32 #foreign c "app_android_platform";
native_windows_platform :: () -> s32 #foreign c "app_windows_platform";
native_plan9_platform :: () -> s32 #foreign c "app_plan9_platform";
native_preview_mode :: () -> s32 #foreign c "app_preview_mode";
native_web_extension_host :: () -> s32 #foreign c "app_web_extension_available";

#program_export
DesktopPlatform :: () -> s32 {
    return native_desktop_platform()
}

#program_export
WebPlatform :: () -> s32 {
    return native_web_platform()
}

#program_export
AndroidPlatform :: () -> s32 {
    return native_android_platform()
}

#program_export
WindowsPlatform :: () -> s32 {
    return native_windows_platform()
}

#program_export
Plan9Platform :: () -> s32 {
    return native_plan9_platform()
}

#program_export
PreviewMode :: () -> s32 {
    return native_preview_mode()
}

#program_export
WebExtensionHost :: () -> s32 {
    return native_web_extension_host()
}
