c :: #system_library "c";

web_storage_flush_host :: (log_success: s32) #foreign c "app_web_storage_flush";
web_storage_flush_critical_host :: (timeout_ms: s32, log_success: s32) -> s32 #foreign c "app_web_storage_flush_critical";
#if #defined(PLATFORM_WEB) {
    web_storage_schedule_host :: (delay_ms: s32,
        log_success: s32) #foreign c "browser_storage_schedule";
}

#program_export
schedule_web_storage_sync :: (delay_ms: s32, log_success: s32) {
    #if #defined(PLATFORM_WEB) {
        web_storage_schedule_host(delay_ms, log_success)
    }
    unused delay_ms
    unused log_success
}

#program_export
sync_web_storage :: () {
    web_storage_flush_host(1)
}

#program_export
sync_web_storage_critical :: () -> s32 {
    return web_storage_flush_critical_host(2000, 1)
}
