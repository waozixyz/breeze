// Desktop notification transport for Kryon's platform notification surface.
// The app owns scheduling and message content in app_notifications.zi.
#import "notification"
#import "c_string"

DESKTOP_NOTIFICATIONS :: #defined(PLATFORM_DESKTOP)
WINDOWS_NOTIFICATIONS :: #defined(_WIN32)

#if DESKTOP_NOTIFICATIONS && !WINDOWS_NOTIFICATIONS {
    c :: #system_library "c";
    raylib :: #system_library "raylib";
    HostNotificationAccess :: (path: *u8, mode: s32) -> s32 #foreign c "access";
    HostNotificationFork :: () -> s32 #foreign c "fork";
    HostNotificationWait :: (pid: s32, status: *s32,
        options: s32) -> s32 #foreign c "waitpid";
    HostNotificationExec :: (path: *u8, first: *u8,
        args: ..any) -> s32 #foreign c "execl";
    HostNotificationExit :: (status: s32) #foreign c "_exit";
    HostNotificationWindowFocused :: () -> bool #foreign raylib "IsWindowFocused";
}

notification_app_name: [128]u8;

#program_export
NotificationSetAppNameHost :: (name: string) {
    if !CopyCString(name, notification_app_name[:]) {
        notification_app_name[0] = cast(u8)0
    }
}

#program_export
NotificationSupportedHost :: () -> bool {
    #if DESKTOP_NOTIFICATIONS && !WINDOWS_NOTIFICATIONS {
        executable: [32]u8
        if !CopyCString("/usr/bin/notify-send", executable[:]) {
            return false
        }
        return HostNotificationAccess(*executable[0], 1) == 0
    }
    return false
}

#program_export
NotificationAllowedHost :: () -> bool {
    return NotificationSupportedHost()
}

#program_export
NotificationRequestHost :: () -> bool {
    return NotificationSupportedHost()
}

#program_export
NotificationWindowFocusedHost :: () -> bool {
    #if DESKTOP_NOTIFICATIONS && !WINDOWS_NOTIFICATIONS {
        return HostNotificationWindowFocused()
    }
    return false
}

#program_export
NotificationSendHost :: (props: NotificationProps) -> bool {
    #if DESKTOP_NOTIFICATIONS && !WINDOWS_NOTIFICATIONS {
        if !NotificationSupportedHost() {
            return false
        }
        executable: [32]u8
        app_flag: [4]u8
        title: [256]u8
        body: [2048]u8
        if !CopyCString("/usr/bin/notify-send", executable[:]) ||
            !CopyCString("-a", app_flag[:]) ||
            !CopyCString(props.title, title[:]) ||
            !CopyCString(props.body, body[:]) {
            return false
        }
        parent_pid: s32 = HostNotificationFork()
        if parent_pid < 0 {
            return false
        }
        if parent_pid == 0 {
            child_pid: s32 = HostNotificationFork()
            if child_pid == 0 {
                terminator: *u8 = null
                HostNotificationExec(*executable[0], *executable[0],
                    *app_flag[0], *notification_app_name[0],
                    *title[0], *body[0], terminator)
                HostNotificationExit(127)
            }
            if child_pid < 0 {
                HostNotificationExit(1)
            }
            HostNotificationExit(0)
        }
        status: s32 = 0
        return HostNotificationWait(parent_pid, *status, 0) == parent_pid &&
            status == 0
    }
    return false
}
