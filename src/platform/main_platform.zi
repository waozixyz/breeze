// Process setup and effects on the application's own window.
#import "c_string"
#import "byte_text_linux"
#import, file "app_trace.zi";
#import, file "host_clock.zi";
#import "device_host"
#import "asset_files"
#if #defined(DESKTOP_HOST) {
    Desktop :: #import "desktop_runtime";
    Cairo :: #import "Cairo";

    #if #defined(_WIN32) {
        // The Win32 handle of the SDL window, for the resource icon.
        main_platform_sdl :: #system_library "SDL2";
        SdlVersion :: (version: *u8) #foreign main_platform_sdl "SDL_GetVersion";
        SdlWindowInfo :: (window: *void, info: *SdlWindowManagerInfo) -> s32 #foreign main_platform_sdl "SDL_GetWindowWMInfo";
        SdlWindowManagerInfo :: struct { version: [3]u8; padding: u8; subsystem: s32; window: *void; context: *void; instance: *void; rest: [40]u8; }
        WindowHandle :: () -> *void {
            if Desktop.DesktopWindow() == null { return null }
            info: SdlWindowManagerInfo
            SdlVersion(*info.version[0])
            if SdlWindowInfo(Desktop.DesktopWindow(), *info) == 0 || info.subsystem != 1 { return null }
            return info.window
        }
    }
} else {
    #import "window_close"
}
#import, file "../app/assets.zi";

c :: #system_library "c";
ScreenshotEnvironmentBytes :: (name: *u8) -> *u8 #foreign c "getenv";
update_apply_at_exit :: () -> s32 #foreign c;
ChangeDirectory :: (path: *u8) -> s32 #foreign c "chdir";
FormatText :: (output: *u8, capacity: usize, format: *u8,
    arguments: ..any) -> s32 #foreign c "snprintf";
FindText :: (text: *u8, needle: *u8) -> *u8 #foreign c "strstr";

#if #defined(_WIN32) {
    SetEnvironmentBytes :: (name: *u8, value: *u8) -> s32 #foreign c "_putenv_s";
    ProcessId :: () -> s32 #foreign c "_getpid";
    kernel32 :: #system_library "kernel32";
    user32 :: #system_library "user32";
    ModuleHandle :: (name: *u16) -> *void #foreign kernel32 "GetModuleHandleW";
    LoadResourceImage :: (instance: *void, name: *u16, kind: u32,
        width: s32, height: s32, flags: u32) -> *void #foreign user32 "LoadImageW";
    SystemMetric :: (metric: s32) -> s32 #foreign user32 "GetSystemMetrics";
    SendWindowMessage :: (window: *void, message: u32,
        wparam: usize, lparam: isize) -> isize #foreign user32 "SendMessageW";
    ErrorMessage :: (owner: *void, text: *u8,
        title: *u8, flags: u32) -> s32 #foreign user32 "MessageBoxA";
} else {
    SetEnvironmentBytes :: (name: *u8, value: *u8,
        overwrite: s32) -> s32 #foreign c "setenv";
    EnvironmentBytes :: (name: *u8) -> *u8 #foreign c "getenv";
    ProcessId :: () -> s32 #foreign c "getpid";
}
#if #defined(__GLIBC__) {
    LimitAllocator :: (parameter: s32, value: s32) -> s32 #foreign c "mallopt";
}

MAIN_SDL :: #defined(DESKTOP_HOST) && !#defined(_WIN32)
DESKTOP_WINDOW :: #defined(DESKTOP_HOST)
#if MAIN_SDL {
    sdl :: #system_library "SDL2";
    GrabWindow :: (window: *void, grab: s32) #foreign sdl "SDL_SetWindowGrab";
    DisplaySleepOff :: () #foreign sdl "SDL_DisableScreenSaver";
    DisplaySleepOn :: () #foreign sdl "SDL_EnableScreenSaver";
}

#if #defined(ANDROID_BUILD) {
    #import "android_surface"
    #import "android_jni"
    #import "android_process"
    AndroidInsetsInit :: () #foreign c "android_insets_init";
    AndroidWakelockInit :: () #foreign c "android_wakelock_init";
    android_log :: #system_library "log";
    AndroidWrite :: (priority: s32, tag: *u8,
        message: *u8) -> s32 #foreign android_log "__android_log_write";
    last_viewport: AndroidViewport = .{-1, -1, -1, -1, .{-1, -1, -1, -1}, -1};
    #if #defined(ANDROID_DEBUG) {
        geometry_time: float64 = -1.0;
        geometry_sequence: s32;
        geometry_launch_width: s32;
        geometry_launch_height: s32;
        geometry_viewport: AndroidViewport;
    }
}

#if #defined(PLATFORM_WEB) {
    WebFrameCallback :: #type () -> void #c_call;
    WebMainLoop :: (callback: WebFrameCallback, fps: s32,
        simulate_infinite_loop: s32) #foreign c "emscripten_set_main_loop";
    DrawAppFrame :: (app: *void) #foreign c "app_frame";
    SetExternalFramePacing :: (enabled: bool) #foreign c;
    web_loop_app: *void;
}
#if !#defined(PLATFORM_WEB) {
    atomic :: #system_library "atomic";
    ShutdownStore :: (value: *s32, replacement: s32,
        order: s32) #foreign atomic "__atomic_store_4";
    ShutdownLoad :: (value: *s32, order: s32) -> s32 #foreign atomic "__atomic_load_4";
    SignalCallback :: #type (s32) -> void #c_call;
    InstallSignal :: (signal_number: s32,
        callback: SignalCallback) -> SignalCallback #foreign c "signal";
    shutdown_requested: s32;
}

SetProcessEnvironment :: (name: string, value: string) {
    name_bytes: [64]u8
    value_bytes: [512]u8
    if !CopyCString(name, name_bytes[:]) ||
    !CopyCString(value, value_bytes[:]) {
        return
    }
    #if #defined(_WIN32) {
        SetEnvironmentBytes(*name_bytes[0], *value_bytes[0])
    } else {
        SetEnvironmentBytes(*name_bytes[0], *value_bytes[0], 1)
    }
}

#program_export
native_apply_desktop_identity :: (app_id: *u8, display_name: *u8) {
    #if !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        if app_id == null || display_name == null {
            return
        }
        SetProcessEnvironment("SDL_APP_NAME", TextFromCString(display_name))
        #if !#defined(_WIN32) {
            SetProcessEnvironment("SDL_VIDEO_X11_WMCLASS", TextFromCString(app_id))
            SetProcessEnvironment("SDL_VIDEO_WAYLAND_WMCLASS", TextFromCString(app_id))
            SetProcessEnvironment("SDL_VIDEO_WAYLAND_APP_ID", TextFromCString(app_id))
        }
    }
    unused app_id
    unused display_name
}

SetDesktopWindowIcon :: (path: *u8) {
    #if #defined(_WIN32) && !#defined(ANDROID_BUILD) {
        window := WindowHandle()
        instance := ModuleHandle(null)
        resource := cast(*u16)cast(usize)101
        large := LoadResourceImage(instance, resource, 1,
            SystemMetric(11), SystemMetric(12), 0)
        small := LoadResourceImage(instance, resource, 1,
            SystemMetric(49), SystemMetric(50), 0)
        if window != null {
            if large != null {
                SendWindowMessage(window, 0x80, 1, cast(isize)large)
            }
            if small != null {
                SendWindowMessage(window, 0x80, 0, cast(isize)small)
            }
        }
    }
    #if #defined(DESKTOP_HOST) {
        if path == null || path[0] == 0 {
            return
        }
        asset := asset_lookup(path)
        if !asset.found || asset.data == null || asset.size == 0 ||
        asset.size > cast(usize)2147483647 {
            TraceLog(4, "APP: Missing window icon asset")
            return
        }
        data := TextFromBytes(BytesFromPointer(asset.data, cast(u64)asset.size))
        width: s32
        height: s32
        channels: s32
        upright: bool
        pixels := Cairo.ImagePreviewDecode(data, "webp", *width, *height, *channels, *upright)
        if pixels == null {
            TraceLog(4, "APP: Failed to decode window icon asset")
            return
        }
        defer { Cairo.ImagePreviewRelease(pixels) }
        if channels != 4 || !Desktop.DesktopSetIcon(width, height,
            BytesFromPointer(pixels, cast(u64)width * cast(u64)height * 4)) {
            TraceLog(4, "APP: Failed to apply window icon asset")
        }
    }
    unused path
}

StartupErrorMessage :: (detail: string, output: []u8) -> bool {
    actual := detail
    if actual.count == 0 {
        actual = "No detailed startup error was reported."
    }
    graphics_error := false
    index: s64 = 0
    while index < actual.count {
        if actual[index:actual.count].count >= 3 {
            remaining := actual[index:actual.count]
            if (remaining.count >= 6 && remaining[0:6] == "OpenGL") ||
            remaining[0:3] == "WGL" ||
            (remaining.count >= 4 && remaining[0:4] == "GLFW") {
                graphics_error = true
            }
        }
        index += 1
    }
    hint: string = ""
    if graphics_error {
        hint = "\nThis is usually a graphics driver or virtual GPU problem. Update the GPU driver, enable VM 3D acceleration, or install the VM guest graphics driver.\n"
    }
    parts: [5]string = .[
    "Inner Breeze could not create a window.\n\n", actual, hint,
    "\nA full log was written to inbe.log next to the executable.", ""]
    used: s64 = 0
    part: s32 = 0
    while part < 4 {
        index = 0
        while index < parts[part].count && used + 1 < output.count {
            output[used] = parts[part][index]
            used += 1
            index += 1
        }
        part += 1
    }
    if output.count == 0 {
        return false
    }
    output[used] = 0
    return true
}

#program_export
native_limit_allocators :: () {
    #if #defined(__GLIBC__) {
        LimitAllocator(-8, 4)
    }
}

#program_export
native_screenshot_data_root :: () {
    #if !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        environment_name: [64]u8
        unused CopyCString("INBE_SCREENSHOT_DATA_ROOT", environment_name[:])
        screenshot_root := ScreenshotEnvironmentBytes(*environment_name[0])
        if screenshot_root != null && screenshot_root[0] != 0 {
            SetProcessEnvironment("APP_DATA_ROOT", TextFromCString(screenshot_root))
            return
        }
        format: [64]u8
        output: [256]u8
        template := "/tmp/inbe-screenshot-%d"
        #if #defined(_WIN32) {
            template = "build/screenshot-data-%d"
        }
        if CopyCString(template, format[:]) &&
        FormatText(*output[0], 256, *format[0], ProcessId()) > 0 {
            SetProcessEnvironment("APP_DATA_ROOT", TextFromCString(*output[0]))
        }
    }
}

display_kept_awake: bool;

// The desktop may blank the display when idle, which also keeps its idle
// counter for break reminders; while a game is played full screen the
// display stays on, as games do.
#program_export
native_keep_display_awake :: (awake: bool) {
    #if MAIN_SDL {
        if awake == display_kept_awake { return }
        display_kept_awake = awake
        if awake { DisplaySleepOff() }
        if !awake { DisplaySleepOn() }
    }
}

#program_export
native_window_environment :: () {
    #if #defined(ANDROID_BUILD) {
        tag: [16]u8
        message: [32]u8
        if CopyCString("APP_MAIN", tag[:]) &&
        CopyCString("=== MAIN START ===", message[:]) {
            AndroidWrite(4, *tag[0], *message[0])
        }
    }
    #if !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD) {
        // Preserve the desktop idle counter used by break reminders.
        SetProcessEnvironment("SDL_VIDEO_ALLOW_SCREENSAVER", "1")
        #if #defined(_WIN32) {
            unused TraceToFile("inbe.log")
            TraceLog(3, "APP: Windows startup")
        }
    }
}

#program_export
native_before_window :: () {
    InstallAssetFiles()
    #if #defined(ANDROID_BUILD) {
        // Native package compilation needs TMPDIR in every build. A leftover
        // UI-test directory must activate a driver only when it is compiled
        // in; Kryon's driver-free build exits if its variable is set.
        AndroidTemporaryPrepare()
        #if #defined(KRYON_TEST_DRIVER) {
            AndroidTestDriverPrepare()
        }
        AndroidInsetsInit()
        SetAndroidViewportPolicy(AndroidViewportPolicyResizeForIme())
        AndroidWakelockInit()
        // The package's own files directory: the debug and Play builds use
        // other application IDs than the release path.
        files := AndroidInternalDataPath()
        if files == null || ChangeDirectory(files) != 0 {
            TraceLog(4, "APP: failed to switch to Android files directory")
        }
    }
}

// The window could not open: on Windows, where no console shows the log,
// the person sees why in a dialog.
#program_export
native_window_open_failed :: () {
    #if #defined(_WIN32) {
        dialog: [3072]u8
        title: [32]u8
        if StartupErrorMessage(TraceRecentErrors(), dialog[:]) &&
        CopyCString("Inner Breeze", title[:]) {
            ErrorMessage(null, *dialog[0], *title[0], 0x10)
        }
        TraceClose()
    }
}

#program_export
native_after_window :: (icon_path: *u8) -> s32 {
    // The window is open once HostOpenWindow returns, and the desktop host
    // intercepts its own window's close.
    #if MAIN_SDL {
        window := Desktop.DesktopWindow()
        if window != null {
            GrabWindow(window, 0)
            app_device_attach_window(window)
        }
    }
    SetDesktopWindowIcon(icon_path)
    return 1
}

#if #defined(PLATFORM_WEB) {
    WebFrame :: () {
        if web_loop_app != null {
            DrawAppFrame(web_loop_app)
        }
    }
    #program_export
    native_start_web_loop :: (app: *void) {
        web_loop_app = app
        SetExternalFramePacing(true)
        callback: WebFrameCallback = WebFrame
        WebMainLoop(callback, 0, 1)
    }
}

#if !#defined(PLATFORM_WEB) {
    RequestShutdown :: (signal_number: s32) {
        unused signal_number
        ShutdownStore(*shutdown_requested, 1, 0)
    }
    #program_export
    native_install_shutdown_handlers :: () {
        callback: SignalCallback = RequestShutdown
        InstallSignal(2, callback)
        InstallSignal(15, callback)
    }
    #program_export
    native_shutdown_requested :: () -> s32 {
        return ShutdownLoad(*shutdown_requested, 0)
    }
}

#program_export
native_platform_shutdown :: () {
    #if !DESKTOP_WINDOW {
        WindowCloseStop()
    }
    TraceClose()
}

#program_export
native_update_apply_at_exit :: () -> s32 {
    return update_apply_at_exit()
}

#if #defined(ANDROID_BUILD) {
    ViewportEqual :: (a: AndroidViewport, b: AndroidViewport) -> bool {
        return a.x == b.x && a.y == b.y && a.width == b.width &&
        a.height == b.height && a.insets.left == b.insets.left &&
        a.insets.top == b.insets.top && a.insets.right == b.insets.right &&
        a.insets.bottom == b.insets.bottom && a.ready == b.ready
    }
    #if #defined(ANDROID_DEBUG) {
        // Debug-only metadata goes directly to logcat. The ordinary Android
        // trace filter intentionally suppresses informational frame messages.
        #program_export
        native_android_report_geometry :: (viewport: AndroidViewport,
            layout_width: s32, layout_height: s32, render_scale: float32,
            practice: s32, paused: s32) {
            now := HostSeconds()
            if ViewportEqual(viewport, geometry_viewport) &&
            geometry_time >= 0.0 && now - geometry_time < 1.0 {
                return
            }
            geometry_time = now
            geometry_viewport = viewport
            geometry_sequence += 1
            transform: AndroidSurfaceTransform
            tag: [32]u8
            format: [512]u8
            message: [1024]u8
            if !CopyCString("InbeGeometry", tag[:]) {
                return
            }
            if !ReadAndroidSurfaceTransform(*transform) {
                if CopyCString("ANDROID_GEOMETRY: ready=0", message[:]) {
                    unused AndroidWrite(4, *tag[0], *message[0])
                }
                return
            }
            if geometry_launch_width == 0 {
                geometry_launch_width = transform.screen_width
                geometry_launch_height = transform.screen_height
            }
            if !CopyCString("ANDROID_GEOMETRY: ready=1 sample=%d launch=%dx%d screen=%dx%d render=%dx%d viewport=%d,%d,%dx%d offset=%d,%d scale=%.6f,%.6f projection=%.9f,%.9f layout=%dx%d render_scale=%.6f practice=%d paused=%d", format[:]) {
                return
            }
            if FormatText(*message[0], 1024, *format[0], geometry_sequence,
                geometry_launch_width, geometry_launch_height,
                transform.screen_width, transform.screen_height,
                transform.render_width, transform.render_height,
                viewport.x, viewport.y, viewport.width, viewport.height,
                transform.offset_x, transform.offset_y,
                cast(float64)transform.scale_x, cast(float64)transform.scale_y,
                cast(float64)transform.projection_x,
                cast(float64)transform.projection_y,
                layout_width, layout_height, cast(float64)render_scale,
                practice, paused) > 0 {
                unused AndroidWrite(4, *tag[0], *message[0])
            }
        }
    }
    #program_export
    native_android_frame_viewport :: (viewport: *AndroidViewport) -> s32 {
        if SyncAndroidViewport(viewport) == 0 {
            return 0
        }
        if !ViewportEqual(viewport.*, last_viewport) {
            width: s32
            height: s32
            GetAndroidSurfaceSize(*width, *height)
            format: [160]u8
            message: [256]u8
            if CopyCString("ANDROID_VIEWPORT: surface=%dx%d viewport=%d,%d %dx%d insets l=%d t=%d r=%d b=%d", format[:]) &&
            FormatText(*message[0], 256, *format[0], width, height, viewport.x,
                viewport.y, viewport.width, viewport.height,
                viewport.insets.left, viewport.insets.top,
                viewport.insets.right, viewport.insets.bottom) > 0 {
                TraceLog(3, TextFromCString(*message[0]))
            }
            last_viewport = viewport.*
        }
        return 1
    }
}
