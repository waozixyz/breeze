// Inbe's browser orientation setting and canvas resizing, on Kryon's
// browser_viewport.
#import "browser_viewport"

browser_orientation_mode: s32;
browser_resize: BrowserResize;

#if #defined(PLATFORM_WEB) {
    browser :: #system_library "browser";
    raylib :: #system_library "raylib";
    c :: #system_library "c";
    BrowserStorageBusy :: () -> s32 #foreign browser "browser_storage_busy";
    BrowserScreenWidth :: () -> s32 #foreign raylib "GetScreenWidth";
    BrowserScreenHeight :: () -> s32 #foreign raylib "GetScreenHeight";
    BrowserPointerDown :: (button: s32) -> bool #foreign raylib "IsMouseButtonDown";
    BrowserSetWindowSize :: (width: s32, height: s32) #foreign raylib "SetWindowSize";
    BrowserUpdateDPI :: (width: s32, height: s32) #foreign c "UpdateDPI";
}

SetBrowserOrientation :: (mode: s32) {
    browser_orientation_mode = ifx mode >= 0 && mode <= 2 then mode else 0
}

// Portrait or landscape keeps a 9:16 canvas inside a wider or taller page.
BrowserOrientationSize :: (size: BrowserViewport, mode: s32) -> BrowserViewport {
    result := size
    if mode == 1 && size.width > size.height {
        result.width = cast(s32)(cast(s64)size.height * 9 / 16)
        if result.width < 1 {
            result.width = size.height
        }
    }
    if mode == 2 && size.height > size.width {
        result.height = cast(s32)(cast(s64)size.width * 9 / 16)
        if result.height < 1 {
            result.height = size.width
        }
    }
    return result
}

BrowserViewportSize :: (fallback_width: s32,
    fallback_height: s32) -> BrowserViewport {
    measured := BrowserViewportMeasure(BrowserViewport.{fallback_width, fallback_height})
    return BrowserOrientationSize(measured, browser_orientation_mode)
}

ResizeBrowserWindow :: () -> bool {
    #if #defined(PLATFORM_WEB) {
        current := BrowserViewport.{BrowserScreenWidth(), BrowserScreenHeight()}
        // Resizing while storage syncs would interrupt the sync.
        if BrowserStorageBusy() != 0 {
            return false
        }
        measured := BrowserViewportSize(current.width, current.height)
        if BrowserResizeSettled(*browser_resize, current, measured, BrowserPointerDown(0)) {
            BrowserSetWindowSize(measured.width, measured.height)
            BrowserUpdateDPI(measured.width, measured.height)
            return true
        }
    }
    return false
}
