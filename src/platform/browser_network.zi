// The browser's event socket. HTTP requests use Kryon's http_transfer.
#import "byte_text_linux"

#if #defined(PLATFORM_WEB) {
    browser :: #system_library "browser";
    SocketOpen :: (url: *u8, url_length: s32, protocol: *u8,
        protocol_length: s32, authorization: *u8, authorization_length: s32,
        capacity: s32) -> s32 #foreign browser "browser_ws_open";
    SocketPoll :: (handle: s32, output: *u8, capacity: s32) -> s32 #foreign browser "browser_ws_poll";
    SocketClose :: (handle: s32) #foreign browser "browser_ws_close";
}

BrowserBytes :: (text: string) -> *u8 {
    if text.count == 0 {
        return null
    }
    descriptor := cast(*TextDescriptor)(*text)
    return descriptor.data
}

OpenBrowserSocket :: (url: string, protocol: string,
    authorization_protocol: string, capacity: s32) -> s32 {
    #if #defined(PLATFORM_WEB) {
        if url.count >= 2048 || protocol.count > 128 || authorization_protocol.count > 8192 {
            return 0
        }
        return SocketOpen(BrowserBytes(url), cast(s32)url.count,
            BrowserBytes(protocol), cast(s32)protocol.count,
            BrowserBytes(authorization_protocol), cast(s32)authorization_protocol.count,
            capacity)
    }
    unused url
    unused protocol
    unused authorization_protocol
    unused capacity
    return 0
}

PollBrowserSocket :: (handle: s32, output: []u8) -> s32 {
    #if #defined(PLATFORM_WEB) {
        if output.count < 2 || output.count > 65536 {
            return 0
        }
        return SocketPoll(handle, *output[0], cast(s32)output.count)
    }
    unused handle
    unused output
    return 0
}

CloseBrowserSocket :: (handle: s32) {
    #if #defined(PLATFORM_WEB) {
        SocketClose(handle)
    }
    unused handle
}
