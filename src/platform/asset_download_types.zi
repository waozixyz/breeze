// State visible to Inbe while its platform service downloads an asset.
// The service owns the connection and other platform resources.
AssetDownloadStatus :: enum {
    Idle :: 0
    Downloading
    Ready
    Error
}

AssetDownload :: struct {
    handle: u64
    status: AssetDownloadStatus
    http_status: s32
    bytes: u64
    total_bytes: u64
    maximum_bytes: u64
    temporary: [4096]u8
    destination: [4096]u8
    error: [256] u8
}
