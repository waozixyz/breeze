// Keep raylib's NativeActivity event processing while Kryon records direct
// touch samples, including taps that start and end between rendered frames.
#import "android_jni"
Touch :: #import "android_touch";
#import "input_protocol"

#if #defined(ANDROID_BUILD) {
    raylib :: #system_library "raylib";
    TouchHostAndroidApp :: () -> *NativeAndroidApp #foreign raylib "GetAndroidApp";
    touch_host_previous: AndroidInputHandler;

    TouchHostInput :: (app: *void, event: *void) -> s32 {
        handled := Touch.AndroidTouchInput(app, event)
        if touch_host_previous != null {
            previous := touch_host_previous(app, event)
            if previous != 0 { return previous }
        }
        return handled
    }

    TouchHostPointer :: () -> PointerFrame {
        app := TouchHostAndroidApp()
        handler: AndroidInputHandler = TouchHostInput
        if app != null && app.input_callback != handler {
            touch_host_previous = app.input_callback
            app.input_callback = handler
        }
        // Breeze applies its camera transform after this sample.
        Touch.AndroidTouchSetZoom(1.0)
        return Touch.AndroidPointerFrame()
    }

    TouchHostFrameEnd :: () { Touch.AndroidTouchFrameEnd() }
}
