#import, file "activity_jni.zi";

#program_export
health_connect_send_host :: (path: *u8) -> bool {
    #if #defined(ANDROID_BUILD) {
        session: ActivityJniSession
        if path == null || path[0] == 0 ||
            activity_jni_attach(*session) == 0 {
            return false
        }
        sent := JniCallVoid(*session, "healthConnectExport", path)
        activity_jni_detach(*session)
        return sent
    }
    unused path
    return false
}
