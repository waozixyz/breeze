#import "android_jni"

#program_export
health_connect_send_host :: (path: *u8) -> bool {
    #if #defined(ANDROID_BUILD) {
        session: AndroidJniSession
        if path == null || path[0] == 0 ||
            AndroidJniAttachCurrent(*session) == 0 {
            return false
        }
        sent := AndroidJniCallVoid(*session, "healthConnectExport", path)
        AndroidJniDetachCurrent(*session)
        return sent
    }
    unused path
    return false
}
