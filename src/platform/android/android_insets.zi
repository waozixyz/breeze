#import "android_jni"
#import, file "android_mutex.zi";
#import "android_device"
#import "android_text_editor"
#import "android_picker"
#import "file_download"
#import, file "android_wakelock_host.zi";
#import "c_string"

#if #defined(ANDROID_BUILD) {
    c :: #system_library "c";
    InsetsLifecycleReset :: () #foreign c "android_lifecycle_reset";
    InsetsSyncLifecycle :: (paused: s32, visible: s32) -> s32 #foreign c "android_sync_lifecycle";
    InsetsInvalidateGraphics :: () #foreign c "android_invalidate_graphics_resources";
    InsetsPracticeToStart :: (practice: s32) -> s32 #foreign c "android_practice_to_start";
    InsetsImportMusic :: (path: *u8, practice: s32) -> s32 #foreign c "android_debug_import_music_for_practice";
    InsetsStartMusicDownload :: () -> s32 #foreign c "android_debug_start_music_download";

    NativeVoidFn :: #type (*JniEnv, *void) -> void #c_call;
    NativeIntegerFn :: #type (*JniEnv, *void, s32) -> void #c_call;
    NativeInsetsFn :: #type (*JniEnv, *void, s32, s32, s32, s32,
        s32, s32, s32, s32, s32) -> void #c_call;
    NativeSizeFn :: #type (*JniEnv, *void, s32, s32) -> void #c_call;
    NativeDensityFn :: #type (*JniEnv, *void, float32) -> void #c_call;
    NativeLifecycleFn :: #type (*JniEnv, *void, u8, u8) -> s32 #c_call;
    NativeSelectedFn :: #type (*JniEnv, *void, s32, *void) -> void #c_call;
    NativeSucceededFn :: #type (*JniEnv, *void, s64, s64, s32) -> void #c_call;
    NativeProgressFn :: #type (*JniEnv, *void, s64, s64, s64) -> void #c_call;
    NativeFailedFn :: #type (*JniEnv, *void, s64, s32, *void) -> void #c_call;
    NativePracticeFn :: #type (*JniEnv, *void, s32) -> u8 #c_call;
    NativeImportMusicFn :: #type (*JniEnv, *void, *void, s32) -> u8 #c_call;
    NativeBooleanFn :: #type (*JniEnv, *void) -> u8 #c_call;
    NativeTextStateFn :: #type (*JniEnv, *void, s64, s64, *void, s32, s32) -> void #c_call;
    NativeProcedure :: union {
        nothing: NativeVoidFn
        integer: NativeIntegerFn
        insets: NativeInsetsFn
        size: NativeSizeFn
        density: NativeDensityFn
        lifecycle: NativeLifecycleFn
        selected: NativeSelectedFn
        succeeded: NativeSucceededFn
        progress: NativeProgressFn
        failed: NativeFailedFn
        practice: NativePracticeFn
        import_music: NativeImportMusicFn
        boolean: NativeBooleanFn
        text_state: NativeTextStateFn
    }
    NativeMethod :: struct {
        name: *u8
        signature: *u8
        procedure: NativeProcedure
    }
    insets_mutex: AndroidMutex;
    pending_practice_start: s32 = -1;

    NativeWakeLockReady :: (env: *JniEnv, activity: *void) {
        android_wakelock_set_activity(env, activity)
    }

    NativeSyncLifecycle :: (env: *JniEnv, activity: *void,
        paused: u8, visible: u8) -> s32 {
        unused env
        unused activity
        return InsetsSyncLifecycle(cast(s32)paused, cast(s32)visible)
    }

    NativeInvalidateGraphics :: (env: *JniEnv, activity: *void) {
        unused env
        unused activity
        InsetsInvalidateGraphics()
    }

    NativeStartPractice :: (env: *JniEnv, activity: *void,
        practice: s32) -> u8 {
        unused env
        unused activity
        AndroidMutexLock(*insets_mutex)
        selected := InsetsPracticeToStart(practice)
        if selected >= 0 {
            pending_practice_start = selected
        }
        AndroidMutexUnlock(*insets_mutex)
        if selected >= 0 {
            return 1
        }
        return 0
    }

    NativeImportMusic :: (env: *JniEnv, activity: *void,
        path: *void, practice: s32) -> u8 {
        unused activity
        if path == null {
            return 0
        }
        native_path := env.functions.GetStringUTFChars(env, path, null)
        if native_path == null {
            return 0
        }
        imported := InsetsImportMusic(native_path, practice)
        env.functions.ReleaseStringUTFChars(env, path, native_path)
        if imported != 0 {
            return 1
        }
        return 0
    }

    NativeStartMusicDownload :: (env: *JniEnv, activity: *void) -> u8 {
        unused env
        unused activity
        if InsetsStartMusicDownload() != 0 {
            return 1
        }
        return 0
    }

    #program_export
    JNI_OnLoad :: (vm: *JniVm, reserved: *void) -> s32 {
        unused reserved
        android_wakelock_set_jvm(vm)
        env: *JniEnv
        result := vm.functions.GetEnv(vm, *env, JniVersion)
        if result != 0 || env == null {
            return -1
        }
        class_name: [64]u8
        CopyCString("xyz/waozi/inbe/MainActivity", class_name[:])
        klass := env.functions.FindClass(env, *class_name[0])
        if klass == null {
            return -1
        }
        methods: [20]NativeMethod
        names: [20][64]u8
        signatures: [20][128]u8
        CopyCString("nativeSetInsets", names[0][:])
        CopyCString("(IIIIIIIII)V", signatures[0][:])
        methods[0].name = *names[0][0]
        methods[0].signature = *signatures[0][0]
        methods[0].procedure.insets = AndroidNativeSetInsets
        CopyCString("nativeSetDeviceDensity", names[1][:])
        CopyCString("(F)V", signatures[1][:])
        methods[1].name = *names[1][0]
        methods[1].signature = *signatures[1][0]
        methods[1].procedure.density = AndroidNativeSetDensity
        CopyCString("nativeWakeLockReady", names[2][:])
        CopyCString("()V", signatures[2][:])
        methods[2].name = *names[2][0]
        methods[2].signature = *signatures[2][0]
        methods[2].procedure.nothing = NativeWakeLockReady
        CopyCString("nativeSyncLifecycleState", names[3][:])
        CopyCString("(ZZ)I", signatures[3][:])
        methods[3].name = *names[3][0]
        methods[3].signature = *signatures[3][0]
        methods[3].procedure.lifecycle = NativeSyncLifecycle
        CopyCString("nativeSetSystemDark", names[4][:])
        CopyCString("(I)V", signatures[4][:])
        methods[4].name = *names[4][0]
        methods[4].signature = *signatures[4][0]
        methods[4].procedure.integer = AndroidNativeSetSystemDark
        CopyCString("nativeSetOrientation", names[5][:])
        CopyCString("(I)V", signatures[5][:])
        methods[5].name = *names[5][0]
        methods[5].signature = *signatures[5][0]
        methods[5].procedure.integer = AndroidNativeSetOrientation
        CopyCString("nativeImportSelectedFile", names[6][:])
        CopyCString("(ILjava/lang/String;)V", signatures[6][:])
        methods[6].name = *names[6][0]
        methods[6].signature = *signatures[6][0]
        methods[6].procedure.selected = AndroidNativePickerSelected
        CopyCString("nativeImportCancelled", names[7][:])
        CopyCString("(I)V", signatures[7][:])
        methods[7].name = *names[7][0]
        methods[7].signature = *signatures[7][0]
        methods[7].procedure.integer = AndroidNativePickerCancelled
        CopyCString("nativeRuntimeAssetDownloadSucceeded", names[8][:])
        CopyCString("(JJI)V", signatures[8][:])
        methods[8].name = *names[8][0]
        methods[8].signature = *signatures[8][0]
        methods[8].procedure.succeeded = FileDownloadNativeSucceeded
        CopyCString("nativeRuntimeAssetDownloadProgress", names[9][:])
        CopyCString("(JJJ)V", signatures[9][:])
        methods[9].name = *names[9][0]
        methods[9].signature = *signatures[9][0]
        methods[9].procedure.progress = FileDownloadNativeProgress
        CopyCString("nativeRuntimeAssetDownloadFailed", names[10][:])
        CopyCString("(JILjava/lang/String;)V", signatures[10][:])
        methods[10].name = *names[10][0]
        methods[10].signature = *signatures[10][0]
        methods[10].procedure.failed = FileDownloadNativeFailed
        CopyCString("nativeTextInputCommit", names[11][:])
        CopyCString("(I)V", signatures[11][:])
        methods[11].name = *names[11][0]
        methods[11].signature = *signatures[11][0]
        methods[11].procedure.integer = AndroidNativeTextCommit
        CopyCString("nativeTextInputBackspace", names[12][:])
        CopyCString("()V", signatures[12][:])
        methods[12].name = *names[12][0]
        methods[12].signature = *signatures[12][0]
        methods[12].procedure.nothing = AndroidNativeTextBackspace
        CopyCString("nativeTextInputEnter", names[13][:])
        CopyCString("()V", signatures[13][:])
        methods[13].name = *names[13][0]
        methods[13].signature = *signatures[13][0]
        methods[13].procedure.nothing = AndroidNativeTextEnter
        CopyCString("nativeInvalidateGraphicsResources", names[14][:])
        CopyCString("()V", signatures[14][:])
        methods[14].name = *names[14][0]
        methods[14].signature = *signatures[14][0]
        methods[14].procedure.nothing = NativeInvalidateGraphics
        CopyCString("nativeStartPractice", names[15][:])
        CopyCString("(I)Z", signatures[15][:])
        methods[15].name = *names[15][0]
        methods[15].signature = *signatures[15][0]
        methods[15].procedure.practice = NativeStartPractice
        CopyCString("nativeDebugImportMusicForPractice", names[16][:])
        CopyCString("(Ljava/lang/String;I)Z", signatures[16][:])
        methods[16].name = *names[16][0]
        methods[16].signature = *signatures[16][0]
        methods[16].procedure.import_music = NativeImportMusic
        CopyCString("nativeDebugStartMusicDownload", names[17][:])
        CopyCString("()Z", signatures[17][:])
        methods[17].name = *names[17][0]
        methods[17].signature = *signatures[17][0]
        methods[17].procedure.boolean = NativeStartMusicDownload
        CopyCString("nativeTextInputState", names[18][:])
        CopyCString("(JJ[BII)V", signatures[18][:])
        methods[18].name = *names[18][0]
        methods[18].signature = *signatures[18][0]
        methods[18].procedure.text_state = AndroidNativeTextInputState
        CopyCString("nativeSetWindowSize", names[19][:])
        CopyCString("(II)V", signatures[19][:])
        methods[19].name = *names[19][0]
        methods[19].signature = *signatures[19][0]
        methods[19].procedure.size = AndroidNativeSetWindowSize
        result = env.functions.RegisterNatives(env, klass,
            cast(*void)*methods[0], 20)
        env.functions.DeleteLocalRef(env, klass)
        if result != 0 {
            return result
        }
        return JniVersion
    }
}

#program_export
android_take_pending_practice_start :: () -> s32 {
    #if #defined(ANDROID_BUILD) {
        AndroidMutexLock(*insets_mutex)
        practice := pending_practice_start
        pending_practice_start = -1
        AndroidMutexUnlock(*insets_mutex)
        return practice
    }
    return -1
}

#program_export
android_insets_init :: () {
    #if #defined(ANDROID_BUILD) {
        InsetsLifecycleReset()
        AndroidMutexLock(*insets_mutex)
        pending_practice_start = -1
        AndroidMutexUnlock(*insets_mutex)
    }
}
