// The native host samples the monotonic clock. Ziran decides how much
// elapsed practice time a sample may advance.
TimerFrameMilliseconds :: 100
TimerMaximumElapsedMilliseconds :: 300000

#program_export
TimerElapsedMillis :: (previous_nanoseconds: s64,
    now_nanoseconds: s64) -> s32 {
    if previous_nanoseconds <= 0 || now_nanoseconds <= previous_nanoseconds {
        return TimerFrameMilliseconds
    }
    elapsed := (now_nanoseconds - previous_nanoseconds) / 1000000
    if elapsed <= 0 {
        return TimerFrameMilliseconds
    }
    if elapsed > TimerMaximumElapsedMilliseconds {
        return TimerMaximumElapsedMilliseconds
    }
    return cast(s32)elapsed
}
