// Android's bionic mutex and condition initializers are zero. The storage is
// aligned and large enough for both Android ABIs and the host-side tests.
// Other targets compile this file too, and Windows has no pthreads.
#if #defined(ANDROID_BUILD) {
    c :: #system_library "c";
    AndroidMutex :: struct {
        storage: [8]u64
    }
    AndroidMutexLockForeign :: (mutex: *AndroidMutex) -> s32 #foreign c "pthread_mutex_lock";
    AndroidMutexUnlockForeign :: (mutex: *AndroidMutex) -> s32 #foreign c "pthread_mutex_unlock";
    AndroidMutexTryLockForeign :: (mutex: *AndroidMutex) -> s32 #foreign c "pthread_mutex_trylock";

    AndroidMutexLock :: (mutex: *AndroidMutex) {
        AndroidMutexLockForeign(mutex)
    }
    AndroidMutexUnlock :: (mutex: *AndroidMutex) {
        AndroidMutexUnlockForeign(mutex)
    }
    // True when the mutex was free and is now held; false when another
    // thread holds it.
    AndroidMutexTryLock :: (mutex: *AndroidMutex) -> bool {
        return AndroidMutexTryLockForeign(mutex) == 0
    }
}
