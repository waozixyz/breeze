#import, file "../environment.zi";

c :: #system_library "c";

wakelock_acquire_host :: () -> bool #foreign c;
wakelock_release_host :: () -> bool #foreign c;
wakelock_update_notification_host :: (text: *u8) -> bool #foreign c;
wakelock_keep_screen_on_host :: () -> bool #foreign c;
wakelock_allow_screen_off_host :: () -> bool #foreign c;

// JNI belongs to the native host. The app decides which platform action to
// request, and the host safely ignores requests without a live activity.
#program_export
android_wakelock_init :: () { }

#program_export
android_wakelock_acquire :: () {
    if AndroidPlatform() != 0 {
        wakelock_acquire_host()
    }
}

#program_export
android_wakelock_release :: () {
    if AndroidPlatform() != 0 {
        wakelock_release_host()
    }
}

#program_export
android_wakelock_update_session_notification :: (text: *u8) {
    if AndroidPlatform() != 0 && text != null {
        wakelock_update_notification_host(text)
    }
}

#program_export
android_keep_screen_on :: () {
    if AndroidPlatform() != 0 {
        wakelock_keep_screen_on_host()
    }
}

#program_export
android_allow_screen_off :: () {
    if AndroidPlatform() != 0 {
        wakelock_allow_screen_off_host()
    }
}
