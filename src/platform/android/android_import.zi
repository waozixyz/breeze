// Inbe's numbered requests to Kryon's android_picker. A scanned QR code's
// text arrives as the answer instead of a path.
AndroidImportKind :: enum {
    ANDROID_IMPORT_KIND_DATA :: 0
    ANDROID_IMPORT_KIND_SYNC_KEY :: 1
    ANDROID_IMPORT_KIND_AUDIO_SOUND :: 2
    ANDROID_IMPORT_KIND_AUDIO_MUSIC :: 3
    ANDROID_IMPORT_KIND_DIARY_PHOTO :: 4
    ANDROID_IMPORT_KIND_QR_CODE :: 5
    // A photo for the media library, as picked: its own bytes and name.
    ANDROID_IMPORT_KIND_MEDIA :: 6
    ANDROID_EXPORT_KIND_SYNC_KEY :: 7
    ANDROID_EXPORT_KIND_DATA_KEY :: 8
}

using AndroidImportKind;
