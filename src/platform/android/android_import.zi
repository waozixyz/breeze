#import, file "../environment.zi";

c :: #system_library "c";

AndroidImportResult :: enum {
    ANDROID_IMPORT_RESULT_NONE :: 0
    ANDROID_IMPORT_RESULT_SELECTED :: 1
    ANDROID_IMPORT_RESULT_CANCELLED :: 2
}

AndroidImportKind :: enum {
    ANDROID_IMPORT_KIND_DATA :: 0
    ANDROID_IMPORT_KIND_SYNC_KEY :: 1
    ANDROID_IMPORT_KIND_AUDIO_SOUND :: 2
    ANDROID_IMPORT_KIND_AUDIO_MUSIC :: 3
}

using AndroidImportResult;
using AndroidImportKind;

import_open_picker_host :: (kind: s32, mime_types: *u8) -> bool #foreign c;
import_poll_result_host :: (kind: s32, path: *u8,
    capacity: s32) -> s32 #foreign c;

#program_export
android_import_open_picker_for :: (kind: s32,
    mime_types: *u8) -> s32 {
    if AndroidPlatform() == 0 {
        return 0
    }
    return ifx import_open_picker_host(kind, mime_types) then 1 else 0
}

#program_export
android_import_open_picker :: (mime_types: *u8) -> s32 {
    return android_import_open_picker_for(ANDROID_IMPORT_KIND_DATA, mime_types)
}

#program_export
android_import_poll_result_for :: (kind: s32, path: *u8,
    capacity: s32) -> s32 {
    if AndroidPlatform() == 0 {
        if path != null && capacity > 0 {
            path.* = cast(u8)0
        }
        return ANDROID_IMPORT_RESULT_NONE
    }
    return import_poll_result_host(kind, path, capacity)
}

#program_export
android_import_poll_result :: (path: *u8, capacity: s32) -> s32 {
    return android_import_poll_result_for(
        ANDROID_IMPORT_KIND_DATA, path, capacity)
}
