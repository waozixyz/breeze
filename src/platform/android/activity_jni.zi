// JNI uses a stable, indexed function table. These declarations mirror the
// Android NDK JNI 1.6 ABI; calls use the A variants with explicit jvalue arrays.
#import "c_string"

JniValue :: union {
    reference: *void
    integer: s32
    long_integer: s64
    boolean: u8
    floating: float64
}

JniEnv :: struct {
    functions: *JniFunctions
}
JniVm :: struct {
    functions: *JniVmFunctions
}

JniFindClassFn :: #type (*JniEnv, *u8) -> *void #c_call;
JniExceptionDescribeFn :: #type (*JniEnv) -> void #c_call;
JniExceptionClearFn :: #type (*JniEnv) -> void #c_call;
JniPushLocalFrameFn :: #type (*JniEnv, s32) -> s32 #c_call;
JniPopLocalFrameFn :: #type (*JniEnv, *void) -> *void #c_call;
JniNewGlobalRefFn :: #type (*JniEnv, *void) -> *void #c_call;
JniDeleteGlobalRefFn :: #type (*JniEnv, *void) -> void #c_call;
JniDeleteLocalRefFn :: #type (*JniEnv, *void) -> void #c_call;
JniGetObjectClassFn :: #type (*JniEnv, *void) -> *void #c_call;
JniGetMethodIDFn :: #type (*JniEnv, *void, *u8, *u8) -> *void #c_call;
JniCallObjectMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> *void #c_call;
JniCallBooleanMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> u8 #c_call;
JniCallIntMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> s32 #c_call;
JniCallVoidMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> void #c_call;
JniGetStaticMethodIDFn :: #type (*JniEnv, *void, *u8, *u8) -> *void #c_call;
JniCallStaticVoidMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> void #c_call;
JniNewStringUTFFn :: #type (*JniEnv, *u8) -> *void #c_call;
JniGetStringUTFCharsFn :: #type (*JniEnv, *void, *u8) -> *u8 #c_call;
JniReleaseStringUTFCharsFn :: #type (*JniEnv, *void, *u8) -> void #c_call;
JniGetArrayLengthFn :: #type (*JniEnv, *void) -> s32 #c_call;
JniGetObjectArrayElementFn :: #type (*JniEnv, *void, s32) -> *void #c_call;
JniNewByteArrayFn :: #type (*JniEnv, s32) -> *void #c_call;
JniGetByteArrayRegionFn :: #type (*JniEnv, *void, s32, s32, *u8) -> void #c_call;
JniSetByteArrayRegionFn :: #type (*JniEnv, *void, s32, s32, *u8) -> void #c_call;
JniRegisterNativesFn :: #type (*JniEnv, *void, *void, s32) -> s32 #c_call;
JniGetJavaVMFn :: #type (*JniEnv, **JniVm) -> s32 #c_call;
JniExceptionCheckFn :: #type (*JniEnv) -> u8 #c_call;

JniNewObjectAFn :: #type (*JniEnv, *void, *void, *JniValue) -> *void #c_call;

JniCallStaticObjectMethodAFn :: #type (*JniEnv, *void, *void, *JniValue) -> *void #c_call;

JniGetStaticFieldIDFn :: #type (*JniEnv, *void, *u8, *u8) -> *void #c_call;

JniGetStaticObjectFieldFn :: #type (*JniEnv, *void, *void) -> *void #c_call;

JniGetStaticIntFieldFn :: #type (*JniEnv, *void, *void) -> s32 #c_call;

JniFunctions :: struct {
    reserved_0: [6]*void
    FindClass: JniFindClassFn
    reserved_7: [9]*void
    ExceptionDescribe: JniExceptionDescribeFn
    ExceptionClear: JniExceptionClearFn
    reserved_18: [1]*void
    PushLocalFrame: JniPushLocalFrameFn
    PopLocalFrame: JniPopLocalFrameFn
    NewGlobalRef: JniNewGlobalRefFn
    DeleteGlobalRef: JniDeleteGlobalRefFn
    DeleteLocalRef: JniDeleteLocalRefFn
    reserved_24: [6]*void
    NewObjectA: JniNewObjectAFn
    GetObjectClass: JniGetObjectClassFn
    reserved_32: [1]*void
    GetMethodID: JniGetMethodIDFn
    reserved_34: [2]*void
    CallObjectMethodA: JniCallObjectMethodAFn
    reserved_37: [2]*void
    CallBooleanMethodA: JniCallBooleanMethodAFn
    reserved_40: [11]*void
    CallIntMethodA: JniCallIntMethodAFn
    reserved_52: [11]*void
    CallVoidMethodA: JniCallVoidMethodAFn
    reserved_64: [49]*void
    GetStaticMethodID: JniGetStaticMethodIDFn
    reserved_114: [2]*void
    CallStaticObjectMethodA: JniCallStaticObjectMethodAFn
    reserved_117: [26]*void
    CallStaticVoidMethodA: JniCallStaticVoidMethodAFn
    GetStaticFieldID: JniGetStaticFieldIDFn
    GetStaticObjectField: JniGetStaticObjectFieldFn
    reserved_146: [4]*void
    GetStaticIntField: JniGetStaticIntFieldFn
    reserved_151: [16]*void
    NewStringUTF: JniNewStringUTFFn
    reserved_168: [1]*void
    GetStringUTFChars: JniGetStringUTFCharsFn
    ReleaseStringUTFChars: JniReleaseStringUTFCharsFn
    GetArrayLength: JniGetArrayLengthFn
    reserved_172: [1]*void
    GetObjectArrayElement: JniGetObjectArrayElementFn
    reserved_174: [2]*void
    NewByteArray: JniNewByteArrayFn
    reserved_177: [23]*void
    GetByteArrayRegion: JniGetByteArrayRegionFn
    reserved_201: [7]*void
    SetByteArrayRegion: JniSetByteArrayRegionFn
    reserved_209: [6]*void
    RegisterNatives: JniRegisterNativesFn
    reserved_216: [3]*void
    GetJavaVM: JniGetJavaVMFn
    reserved_220: [8]*void
    ExceptionCheck: JniExceptionCheckFn
}

JniAttachFn :: #type (*JniVm, **JniEnv, *void) -> s32 #c_call;
JniDetachFn :: #type (*JniVm) -> s32 #c_call;
JniGetEnvFn :: #type (*JniVm, **JniEnv, s32) -> s32 #c_call;
JniVmFunctions :: struct {
    reserved: [4]*void
    AttachCurrentThread: JniAttachFn
    DetachCurrentThread: JniDetachFn
    GetEnv: JniGetEnvFn
}

NativeActivity :: struct {
    callbacks: *void
    vm: *JniVm
    env: *JniEnv
    activity: *void
    internal_data_path: *u8
    external_data_path: *u8
    sdk_version: s32
    instance: *void
    asset_manager: *void
}
NativeAndroidApp :: struct {
    userdata: *void
    command_callback: *void
    input_callback: *void
    activity: *NativeActivity
}

ActivityJniSession :: struct {
    vm: *JniVm
    env: *JniEnv
    activity: *void
    attached: s32
}

#if #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
    raylib :: #system_library "raylib";
    JniGetAndroidApp :: () -> *NativeAndroidApp #foreign raylib "GetAndroidApp";
}

JniVersion :: 0x00010006

JniAttach :: (session: *ActivityJniSession, vm: *JniVm,
    activity: *void) -> bool {
    if session == null || vm == null || activity == null {
        return false
    }
    session.vm = vm
    session.activity = activity
    session.env = null
    session.attached = 0
    result := vm.functions.GetEnv(vm, *session.env, JniVersion)
    if result == -2 {
        if vm.functions.AttachCurrentThread(vm, *session.env, null) != 0 ||
            session.env == null {
            return false
        }
        session.attached = 1
    } else if result != 0 || session.env == null {
        return false
    }
    if session.env.functions.PushLocalFrame(session.env, 32) != 0 {
        if session.env.functions.ExceptionCheck(session.env) != 0 {
            session.env.functions.ExceptionDescribe(session.env)
            session.env.functions.ExceptionClear(session.env)
        }
        if session.attached != 0 {
            vm.functions.DetachCurrentThread(vm)
        }
        session.vm = null
        session.env = null
        session.activity = null
        session.attached = 0
        return false
    }
    return true
}

#program_export
activity_jni_attach :: (session: *ActivityJniSession) -> s32 {
    if session == null {
        return 0
    }
    session.vm = null
    session.env = null
    session.activity = null
    session.attached = 0
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
        app := JniGetAndroidApp()
        if app == null || app.activity == null {
            return 0
        }
        if JniAttach(session, app.activity.vm, app.activity.activity) {
            return 1
        }
    }
    return 0
}

#program_export
activity_jni_detach :: (session: *ActivityJniSession) {
    if session == null || session.env == null {
        return
    }
    env := session.env
    if env.functions.ExceptionCheck(env) != 0 {
        env.functions.ExceptionDescribe(env)
        env.functions.ExceptionClear(env)
    }
    env.functions.PopLocalFrame(env, null)
    if session.attached != 0 {
        session.vm.functions.DetachCurrentThread(session.vm)
    }
    session.vm = null
    session.env = null
    session.activity = null
    session.attached = 0
}

JniMethod :: (session: *ActivityJniSession, name: string,
    signature: string) -> *void {
    env := session.env
    klass := env.functions.GetObjectClass(env, session.activity)
    if klass == null {
        return null
    }
    method_name: [96]u8
    method_signature: [192]u8
    if !CopyCString(name, method_name[:]) ||
        !CopyCString(signature, method_signature[:]) {
        return null
    }
    return env.functions.GetMethodID(env, klass, *method_name[0],
        *method_signature[0])
}

JniString :: (env: *JniEnv, value: *u8) -> *void {
    empty: [1]u8
    if value == null {
        value = *empty[0]
    }
    return env.functions.NewStringUTF(env, value)
}

JniCallVoid :: (session: *ActivityJniSession, name: string,
    text: *u8) -> bool {
    signature := "()V"
    if text != null {
        signature = "(Ljava/lang/String;)V"
    }
    method := JniMethod(session, name, signature)
    if method == null {
        return false
    }
    env := session.env
    arguments: [1]JniValue
    if text != null {
        arguments[0].reference = JniString(env, text)
        if arguments[0].reference == null {
            return false
        }
    }
    env.functions.CallVoidMethodA(env, session.activity, method,
        *arguments[0])
    return env.functions.ExceptionCheck(env) == 0
}

ActivityInternalDataPath :: () -> *u8 {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
        app := JniGetAndroidApp()
        if app != null && app.activity != null {
            return app.activity.internal_data_path
        }
    }
    return null
}
