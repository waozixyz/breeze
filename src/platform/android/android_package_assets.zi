// Portable packages are shared by every ABI in the APK. Keep each NDK asset
// open for the lifetime of its borrowed bytes, including Activity resets.
#import "android_jni"
#import "byte_text_linux"

#if #defined(ANDROID_BUILD) {
    android :: #system_library "android";
    raylib :: #system_library "raylib";
    PackageAndroidApp :: () -> *NativeAndroidApp #foreign raylib "GetAndroidApp";
    PackageAssetOpen :: (manager: *void, path: *u8,
        mode: s32) -> *void #foreign android "AAssetManager_open";
    PackageAssetBuffer :: (asset: *void) -> *u8 #foreign android "AAsset_getBuffer";
    PackageAssetLength :: (asset: *void) -> s64 #foreign android "AAsset_getLength64";
    PackageAssetClose :: (asset: *void) #foreign android "AAsset_close";
    PackageAsset :: struct {
        asset: *void
        data: *u8
        length: s64
    }
    package_assets: [2]PackageAsset;
}

AndroidPackageBytes :: (path: string) -> string {
    #if #defined(ANDROID_BUILD) {
        index: s32 = 0
        if path == "apps.zib" {
            index = 1
        } else if path != "inbe.zib" {
            return ""
        }
        cached := *package_assets[index]
        if cached.asset != null {
            return TextFromBytes(BytesFromPointer(cached.data, cast(u64)cached.length))
        }
        app := PackageAndroidApp()
        if app == null || app.activity == null || app.activity.asset_manager == null {
            return ""
        }
        name: [9]u8
        for offset: cast(s32)0..7 {
            name[offset] = path[offset]
        }
        asset := PackageAssetOpen(app.activity.asset_manager, *name[0], 3)
        if asset == null {
            return ""
        }
        length := PackageAssetLength(asset)
        data := PackageAssetBuffer(asset)
        if length <= 0 || data == null {
            PackageAssetClose(asset)
            return ""
        }
        cached.asset = asset
        // The open NDK asset owns these immutable bytes. Cache its raw native
        // buffer so opening another package does not mutate a text backing
        // store already borrowed by locales.
        cached.data = data
        cached.length = length
        return TextFromBytes(BytesFromPointer(data, cast(u64)length))
    }
    return ""
}
