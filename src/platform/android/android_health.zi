#import, file "../environment.zi";
#import, file "../../storage/data.zi";
#import, file "../../storage/storage_core.zi";
#import, file "../../app/text_buffers.zi";

c :: #system_library "c";

HealthExportPathCapacity :: 512

health_connect_send_host :: (path: *u8) -> bool #foreign c "health_connect_send_host";

// The Ziran storage layer writes the CSV; the host only sends its path to JNI.
#program_export
HealthConnectExport :: () -> bool {
    if AndroidPlatform() == 0 {
        return false
    }
    path: [HealthExportPathCapacity]u8
    if !AppCopyText(data_root(), path[:]) ||
        !AppAppendText("/health-connect-export.csv", path[:]) ||
        storage_export_health_connect_csv(
            AppTextFromCString(*path[0], HealthExportPathCapacity)) == 0 {
        return false
    }
    return health_connect_send_host(*path[0])
}
