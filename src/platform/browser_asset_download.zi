// The browser supplies bounded chunks; Zi owns files and download lifetime.
#import, file "asset_download_types.zi";
#import, file "web_storage.zi";
#import "c_string"
#import "byte_text_linux"

#if #defined(PLATFORM_WEB) {
    browser :: #system_library "browser";
    BrowserStreamOpen :: (url: *u8, length: s32, maximum: s32,
        timeout: s32) -> s32 #foreign browser "browser_stream_open";
    BrowserStreamPoll :: (handle: s32, output: *u8, capacity: s32,
        count: *s32, status: *s32, total: *s32) -> s32 #foreign browser "browser_stream_poll";
    BrowserStreamClose :: (handle: s32) #foreign browser "browser_stream_close";
    c :: #system_library "c";
    BrowserAssetOpenFile :: (path: *u8, mode: *u8) -> *void #foreign c "fopen";
    BrowserAssetWriteFile :: (data: *u8, size: usize, count: usize,
        file: *void) -> usize #foreign c "fwrite";
    BrowserAssetCloseFile :: (file: *void) -> s32 #foreign c "fclose";
    BrowserAssetRenameFile :: (source: *u8, destination: *u8) -> s32 #foreign c "rename";
    BrowserAssetRemoveFile :: (path: *u8) -> s32 #foreign c "remove";

    BrowserAssetSlot :: struct {
        owner: *AssetDownload
        stream: s32
        file: *void
        destination: [4096]u8
        temporary: [4096]u8
    }
    browser_asset_slots: [4]BrowserAssetSlot;
    browser_asset_chunk: [65536]u8;

    BrowserAssetFind :: (download: *AssetDownload) -> *BrowserAssetSlot {
        index: s32 = 0
        while index < 4 {
            slot := *browser_asset_slots[index]
            if slot.owner == download && cast(u64)slot.stream == download.handle {
                return slot
            }
            index += 1
        }
        return null
    }

    BrowserAssetDiscard :: (slot: *BrowserAssetSlot) {
        if slot == null {
            return
        }
        if slot.stream != 0 {
            BrowserStreamClose(slot.stream)
        }
        if slot.file != null {
            BrowserAssetCloseFile(slot.file)
        }
        if slot.temporary[0] != cast(u8)0 {
            if BrowserAssetRemoveFile(*slot.temporary[0]) == 0 {
                schedule_web_storage_sync(120, 0)
            }
        }
        slot.* = BrowserAssetSlot.{}
    }

    BrowserAssetFailure :: (download: *AssetDownload, slot: *BrowserAssetSlot,
        message: string) {
        BrowserAssetDiscard(slot)
        download.handle = cast(u64)0
        download.status = cast(AssetDownloadStatus)AssetDownloadStatus.Error
        unused CopyCString(message, download.error[:])
    }
}

BrowserAssetDownloadStart :: (download: *AssetDownload, url: string,
    destination: string) -> s32 {
    #if #defined(PLATFORM_WEB) {
        if download == null {
            return 0
        }
        slot_index: s32 = -1
        index: s32 = 0
        while index < 4 {
            candidate := *browser_asset_slots[index]
            if candidate.owner != null && TextFromCString(*candidate.destination[0]) == destination {
                BrowserAssetFailure(download, null, "download already in progress")
                return 0
            }
            if slot_index < 0 && candidate.owner == null {
                slot_index = index
            }
            index += 1
        }
        if slot_index < 0 {
            BrowserAssetFailure(download, null, "too many downloads")
            return 0
        }
        slot := *browser_asset_slots[slot_index]
        if destination.count == 0 || destination.count + 6 >= 4096 ||
            url.count == 0 || url.count >= 4096 ||
            !CopyCString(destination, browser_asset_slots[slot_index].destination[:]) ||
            !CopyCString(destination, browser_asset_slots[slot_index].temporary[:]) {
            BrowserAssetFailure(download, slot, "invalid download path")
            return 0
        }
        suffix := ".part"
        offset := cast(s64)destination.count
        index = 0
        while index < 5 {
            slot.temporary[offset + cast(s64)index] = suffix[index]
            index += 1
        }
        slot.temporary[offset + 5] = cast(u8)0
        mode: [4]u8
        unused CopyCString("wb", mode[:])
        slot.file = BrowserAssetOpenFile(*slot.temporary[0], *mode[0])
        if slot.file == null {
            BrowserAssetFailure(download, slot, "could not open download file")
            return 0
        }
        url_text := cast(*TextDescriptor)(*url)
        slot.stream = BrowserStreamOpen(url_text.data, cast(s32)url.count,
            536870912, 900000)
        if slot.stream == 0 {
            BrowserAssetFailure(download, slot, "invalid download URL")
            return 0
        }
        slot.owner = download
        download.handle = cast(u64)slot.stream
        download.status = cast(AssetDownloadStatus)AssetDownloadStatus.Downloading
        return 1
    }
    unused download
    unused url
    unused destination
    return 0
}

BrowserAssetDownloadPoll :: (download: *AssetDownload) -> AssetDownloadStatus {
    if download == null {
        return cast(AssetDownloadStatus)AssetDownloadStatus.Idle
    }
    #if #defined(PLATFORM_WEB) {
        if download.status != cast(AssetDownloadStatus)AssetDownloadStatus.Downloading {
            return download.status
        }
        slot := BrowserAssetFind(download)
        if slot == null {
            BrowserAssetFailure(download, null, "download handle expired")
            return download.status
        }
        count: s32 = 0
        status: s32 = 0
        total: s32 = 0
        state := BrowserStreamPoll(slot.stream, *browser_asset_chunk[0], 65536,
            *count, *status, *total)
        download.http_status = status
        download.total_bytes = cast(u64)total
        if state == 0 {
            message := "download failed"
            if status == 0 {
                message = "NETWORK_UNAVAILABLE"
            }
            BrowserAssetFailure(download, slot, message)
            return download.status
        }
        if status != 0 && (status < 200 || status >= 300) {
            BrowserAssetFailure(download, slot, "download failed")
            return download.status
        }
        if state < 0 {
            return download.status
        }
        if state == 1 {
            if count <= 0 || count > 65536 ||
                download.bytes + cast(u64)count > cast(u64)536870912 ||
                BrowserAssetWriteFile(*browser_asset_chunk[0], 1, cast(usize)count,
                    slot.file) != cast(usize)count {
                BrowserAssetFailure(download, slot, "could not write download file")
                return download.status
            }
            download.bytes += cast(u64)count
            return download.status
        }
        closed := BrowserAssetCloseFile(slot.file)
        slot.file = null
        if state != 2 || status < 200 || status >= 300 ||
            download.bytes == cast(u64)0 || closed != 0 ||
            BrowserAssetRenameFile(*slot.temporary[0], *slot.destination[0]) != 0 {
            BrowserAssetFailure(download, slot, "download failed")
            return download.status
        }
        BrowserAssetDiscard(slot)
        download.handle = cast(u64)0
        download.total_bytes = download.bytes
        download.status = cast(AssetDownloadStatus)AssetDownloadStatus.Ready
        schedule_web_storage_sync(120, 0)
    }
    return download.status
}

BrowserAssetDownloadRelease :: (download: *AssetDownload) {
    if download == null {
        return
    }
    #if #defined(PLATFORM_WEB) {
        BrowserAssetDiscard(BrowserAssetFind(download))
    }
    download.handle = cast(u64)0
    download.status = cast(AssetDownloadStatus)AssetDownloadStatus.Idle
}
