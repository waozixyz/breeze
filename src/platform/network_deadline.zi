#import "text"

// Model answers take longer than other requests. A spelling correction
// returns a whole diary entry, so it may take longest.
NetworkDeadline :: (url: string) -> s32 {
    if ContainsFoldASCII(url, "/api/v1/chat/spelling") {
        return 70000
    }
    if ContainsFoldASCII(url, "/chat/completions") {
        return 45000
    }
    return 20000
}
