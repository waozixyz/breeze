// The app's frames on the host the build targets. On Kryon's desktop host a
// frame polls the window's events, draws, presents and then waits as the
// host's frame clock paces it: 60 frames a second while pixels change and 15
// once they stay the same. On Android the app owns the NativeActivity loop:
// a frame drains the activity's events, draws into Pixmap on the borrowed
// surface and presents its damage, then waits for the next event or the
// frame target. The browser calls the frame procedure itself, and a build
// that selects no host runs it directly.
#import, file "host_clock.zi";
#import, file "host_window.zi";
#import, file "host_input.zi";

#if #defined(DESKTOP_HOST) {
    Desktop :: #import "desktop_runtime";
    Raster :: #import "Cairo";
} else #if #defined(ANDROID_BUILD) {
    #import, file "android/android_picture_window.zi";
    Runtime :: #import "android_runtime";
    Pictures :: #import "pixmap_assets_android";
    #if #defined(LUMI_ANDROID_FRAME_WATCH) {
        #import, file "lumi_frame_watch.zi";
        #import, file "../app/app_types.zi";
        #import, file "../core/types.zi";
    }
    host_frame_target_fps: s32 = 60;
    host_frame_keep_running: bool;
} else #if #defined(PLATFORM_WEB) {
    Canvas :: #import "kryon/canvas_host";
    CanvasWindow :: #import "canvas_window";
}

HostFrameProcedure :: #type (argument: *void) #c_call;

// Runs one frame of PROCEDURE. False when the frame could not run. A window
// the window system ended runs no frame, and HostWindowClosing then reports
// it.
HostRunFrame :: (procedure: HostFrameProcedure, argument: *void) -> bool {
    #if #defined(DESKTOP_HOST) {
        if !Desktop.PollDesktop() {
            HostMarkWindowEnded()
            return true
        }
        HostFrameStarted()
        Desktop.BeginDesktopFrame()
        procedure(argument)
        presented := Desktop.EndDesktopFrame()
        if presented {
            HostMarkWindowPresented()
        }
        Desktop.PauseDesktop()
        return presented
    } else #if #defined(ANDROID_BUILD) {
        wait_ms := HostAndroidWaitMilliseconds()
        #if #defined(LUMI_ANDROID_FRAME_WATCH) {
            app := cast(*InnerBreeze)argument
            if wait_ms >= 0 && app.breathing.screen == ScreenLumi &&
            !Runtime.AndroidHostPaused() && !HostWindowHidden() {
                LumiWatchBegin()
            }
        }
        if !Runtime.PollAndroidHost(wait_ms) {
            #if #defined(LUMI_ANDROID_FRAME_WATCH) {
                LumiWatchEnd()
            }
            HostMarkWindowEnded()
            return true
        }
        #if #defined(LUMI_ANDROID_FRAME_WATCH) {
            LumiWatchMark(LumiWatchFrameSetup)
        }
        HostFrameStarted()
        Runtime.SetAndroidPausedSurfaceVisible((AndroidPictureWindowState() & 2) != 0)
        Runtime.BeginAndroidFrame()
        procedure(argument)
        #if #defined(LUMI_ANDROID_FRAME_WATCH) {
            LumiWatchMark(LumiWatchPresent)
        }
        presented := Runtime.EndAndroidFrame()
        HostInputFrameEnd()
        if presented {
            HostMarkWindowPresented()
        }
        #if #defined(LUMI_ANDROID_FRAME_WATCH) {
            LumiWatchEnd()
        }
        return presented
    } else {
        procedure(argument)
        return true
    }
}

// The frames a second the app wants: 60 while something moves, fewer once
// its pixels stay the same. Kryon's desktop host paces its own frames.
HostSetFrameTarget :: (fps: s32) {
    #if #defined(ANDROID_BUILD) {
        host_frame_target_fps = ifx fps > 0 then fps else 60
    } else #if #defined(PLATFORM_WEB) {
        CanvasWindow.SetTargetFPS(fps)
    } else {
        unused fps
    }
}

#if #defined(ANDROID_BUILD) {
    // A practice in the floating window keeps its frames going while the
    // activity is paused, as the frame target says; otherwise a paused or
    // windowless activity waits for its next event.
    HostKeepRunning :: (running: bool) {
        host_frame_keep_running = running
    }

    // How long the next poll may wait for an event: the rest of this frame's
    // share of the frame target, or until an event when nothing draws.
    HostAndroidWaitMilliseconds :: () -> s32 {
        if (Runtime.AndroidHostPaused() || HostWindowHidden()) && !host_frame_keep_running {
            return -1
        }
        budget := 1.0 / cast(float64)host_frame_target_fps
        elapsed := HostSeconds() - host_frame_started
        if host_frame_started <= 0.0 || elapsed >= budget {
            return 0
        }
        return cast(s32)((budget - elapsed) * 1000.0)
    }
}

// Pictures whose files changed load again.
HostInvalidatePictures :: () {
    #if #defined(DESKTOP_HOST) {
        unused Raster.RasterInvalidateImages()
    } else #if #defined(ANDROID_BUILD) {
        unused Pictures.RasterInvalidateImages()
    } else #if #defined(PLATFORM_WEB) {
        Canvas.InvalidateCanvasAssets()
    }
}

HostInvalidatePicturesUnder :: (folder: string) {
    #if #defined(DESKTOP_HOST) {
        unused Raster.RasterInvalidateImagesIn(folder)
    } else #if #defined(ANDROID_BUILD) {
        unused Pictures.RasterInvalidateImagesIn(folder)
    } else #if #defined(PLATFORM_WEB) {
        Canvas.InvalidateCanvasAssetsUnder(folder)
    } else {
        unused folder
    }
}
