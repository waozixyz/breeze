app_request_desktop_close :: (app: *InnerBreeze) #foreign c;
app_switch_screen :: (app: *InnerBreeze, screen: s32) #foreign c;
app_breaks_set_mode :: (app: *InnerBreeze, mode: s32, duration_s: s32) #foreign c;
app_breaks_rest_break_now :: (app: *InnerBreeze) #foreign c;
whm_practice_start :: (app: *InnerBreeze) #foreign c;
meditation_practice_start :: (app: *InnerBreeze) #foreign c;
sun_salutation_practice_start :: (app: *InnerBreeze) #foreign c;
patterns_practice_start :: (app: *InnerBreeze) #foreign c;



AppTraySnapshot :: struct {
    window_visible: s32
    count: s32
    break_mode: s32
    break_reading_mode: s32
    status_label: [128] u8
    show_hide_label: [96] u8
    start_practice_label: [96] u8
    habits_label: [96] u8
    quit_label: [96] u8
    whm_label: [96] u8
    meditation_label: [96] u8
    sun_salutation_label: [96] u8
    patterns_label: [96] u8
    break_label: [96] u8
    break_rest_now_label: [96] u8
    break_mode_label: [96] u8
    break_mode_normal_label: [96] u8
    break_mode_quiet_label: [96] u8
    break_mode_suspended_label: [96] u8
    break_reading_label: [96] u8
    break_settings_label: [96] u8
    habit_labels: [HABIT_MAX] [128] u8
    habit_indices: [HABIT_MAX] s32
    habit_enabled: [HABIT_MAX] s32
}
app_tray_snapshot: AppTraySnapshot;
TrayReady: s32;
TrayNextStatusUpdateTime: float64;
TrayStatusUpdateInitialized: s32;
TrayLastWindowVisible: s32 = -1;
TrayLastStatusText: [128] u8;
TrayId: [5] u8;
TrayTitle: [13] u8;
TrayIconName: [5] u8;
TrayIconPath0: [9] u8;
TrayIconPath1: [34] u8;
TrayIconPath2: [33] u8;
TrayIconPath3: [26] u8;
TrayIconPaths: [5] *u8;
GetTrayHabitAction :: (index: s32) -> DesktopTrayAction {
    if index < 0 || index >= HABIT_MAX {
        return cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_NONE
    }
    return cast(DesktopTrayAction)(DESKTOP_TRAY_ACTION_MARK_HABIT_0 + index)
}
GetTrayHabitIndex :: (action: DesktopTrayAction) -> s32 {
    if cast(s32)action < cast(s32)DESKTOP_TRAY_ACTION_MARK_HABIT_0 ||
    cast(s32)action > cast(s32)DESKTOP_TRAY_ACTION_MARK_HABIT_9 {
        return -1
    }
    return cast(s32)action - cast(s32)DESKTOP_TRAY_ACTION_MARK_HABIT_0
}
GetTrayWindowLabelKey :: (visible: s32) -> string {
    return ifx (visible != 0) then ("tray_hide_inner_breeze") else ("tray_show_inner_breeze")
}
GetTrayWindowAction :: (visible: s32) -> DesktopTrayAction {
    if visible != 0 {
        return cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_HIDE
    }
    return cast(DesktopTrayAction)DESKTOP_TRAY_ACTION_SHOW
}
FillTraySnapshotLabels :: (snapshot: *AppTraySnapshot) {
    if snapshot == null {
        return
    }
    AppCopyText(LocaleText(GetTrayWindowLabelKey(snapshot.window_visible)), snapshot.show_hide_label[:])
    AppCopyText(LocaleText("tray_start_practice"), snapshot.start_practice_label[:])
    AppCopyText(LocaleText("tray_mark_complete"), snapshot.habits_label[:])
    AppCopyText(LocaleText("tray_quit_inner_breeze"), snapshot.quit_label[:])
    AppCopyText(LocaleText("exercise_wim_hof"), snapshot.whm_label[:])
    AppCopyText(LocaleText("exercise_meditation"), snapshot.meditation_label[:])
    AppCopyText(LocaleText("exercise_sun_salutation"), snapshot.sun_salutation_label[:])
    AppCopyText(LocaleText("exercise_patterns"), snapshot.patterns_label[:])
    AppCopyText(LocaleText("settings_tab_breaks"), snapshot.break_label[:])
    AppCopyText(LocaleText("settings_breaks_rest_now"), snapshot.break_rest_now_label[:])
    AppCopyText(LocaleText("settings_breaks_mode"), snapshot.break_mode_label[:])
    AppCopyText(LocaleText("settings_breaks_mode_normal"), snapshot.break_mode_normal_label[:])
    AppCopyText(LocaleText("settings_breaks_mode_quiet"), snapshot.break_mode_quiet_label[:])
    AppCopyText(LocaleText("settings_breaks_mode_suspended"), snapshot.break_mode_suspended_label[:])
    AppCopyText(LocaleText("settings_breaks_reading_mode"), snapshot.break_reading_label[:])
    AppCopyText(LocaleText("tray_break_settings"), snapshot.break_settings_label[:])
}
SeedTraySnapshot :: () {
    next: AppTraySnapshot
    app: *InnerBreeze = CurrentApp()
    next = AppTraySnapshot.{}
    next.window_visible = ifx (IsWindowHidden()) then (0) else (1)
    if app != null {
        next.break_mode = app.breaks.mode
        next.break_reading_mode = app.breaks.reading_mode
    }
    BuildTrayStatusText(app, next.status_label[:])
    FillTraySnapshotLabels(*next)
    app_tray_snapshot = next
}
BuildTrayMenu :: (snapshot: *AppTraySnapshot, items: *DesktopTrayMenuItem, item_count: s32, start_items: *DesktopTrayMenuItem, start_item_count: s32, habit_items: *DesktopTrayMenuItem, habit_item_count: s32, break_items: *DesktopTrayMenuItem, break_item_count: s32, break_mode_items: *DesktopTrayMenuItem, break_mode_item_count: s32) -> s32 {
    item_index: s32 = 0
    if snapshot == null || items == null || item_count < 7  || start_items == null || start_item_count < 4  || habit_items == null || habit_item_count < HABIT_MAX  || break_items == null || break_item_count < 4  || break_mode_items == null || break_mode_item_count < 3 {
        return 0
    }
    start_items[0] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.whm_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_START_WHM,
        .enabled = 1
    }
    start_items[1] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.meditation_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_START_MEDITATION,
        .enabled = 1
    }
    start_items[2] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.sun_salutation_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_START_SUN_SALUTATION,
        .enabled = 1
    }
    start_items[3] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.patterns_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_START_PATTERNS,
        .enabled = 1
    }
    {
        i: s32 = 0
        while i < snapshot.count && i < HABIT_MAX  && i < 10 {
            habit_items[i] = DesktopTrayMenuItem.{
                .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
                .label = *snapshot.habit_labels[i][0],
                .action = cast(s32)GetTrayHabitAction(i),
                .enabled = snapshot.habit_enabled[i]
            }
            i += 1
        }
    }
    break_mode_items[0] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_mode_normal_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_MODE_NORMAL,
        .enabled = ifx (snapshot.break_mode != BreakModeNormal) then (1) else (0)
    }
    break_mode_items[1] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_mode_quiet_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_MODE_QUIET,
        .enabled = ifx (snapshot.break_mode != BreakModeQuiet) then (1) else (0)
    }
    break_mode_items[2] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_mode_suspended_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_MODE_SUSPENDED,
        .enabled = ifx (snapshot.break_mode != BreakModeSuspended) then (1) else (0)
    }
    break_items[0] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_rest_now_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_REST_NOW,
        .enabled = 1
    }
    break_items[1] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
        .label = *snapshot.break_mode_label[0],
        .enabled = 1,
        .children = break_mode_items,
        .child_count = 3
    }
    break_items[2] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_reading_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_READING_TOGGLE,
        .enabled = 1
    }
    break_items[3] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.break_settings_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_BREAK_SETTINGS,
        .enabled = 1
    }
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.status_label[0],
        .enabled = 0
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SEPARATOR
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
        .label = *snapshot.start_practice_label[0],
        .enabled = 1,
        .children = start_items,
        .child_count = 4
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
        .label = *snapshot.habits_label[0],
        .enabled = ifx (snapshot.count > 0) then (1) else (0),
        .children = habit_items,
        .child_count = snapshot.count
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SUBMENU,
        .label = *snapshot.break_label[0],
        .enabled = 1,
        .children = break_items,
        .child_count = 4
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_SEPARATOR
    }
    item_index += 1
    items[item_index] = DesktopTrayMenuItem.{
        .kind = DESKTOP_TRAY_MENU_ITEM_ACTION,
        .label = *snapshot.quit_label[0],
        .action = cast(s32)DESKTOP_TRAY_ACTION_QUIT,
        .enabled = 1
    }
    return item_index + 1
}
ApplyTrayMenuSnapshot :: (snapshot: *AppTraySnapshot) {
    items: [7] DesktopTrayMenuItem
    start_items: [4] DesktopTrayMenuItem
    habit_items: [HABIT_MAX] DesktopTrayMenuItem
    break_items: [4] DesktopTrayMenuItem
    break_mode_items: [3] DesktopTrayMenuItem
    count: s32
    count = BuildTrayMenu(snapshot, *items[0], 7, *start_items[0], 4,
        *habit_items[0], HABIT_MAX,
        *break_items[0], 4, *break_mode_items[0], 3)
    DesktopTraySetMenu(*items[0], count)
    visible := ifx (snapshot != null) then (snapshot.window_visible) else (ifx (IsWindowHidden()) then (0) else (1))
    DesktopTraySetActivateAction(cast(s32)GetTrayWindowAction(visible))
}
#program_export
desktop_tray_init :: () -> s32 {
    spec: DesktopTraySpec
    items: [7] DesktopTrayMenuItem
    start_items: [4] DesktopTrayMenuItem
    habit_items: [HABIT_MAX] DesktopTrayMenuItem
    break_items: [4] DesktopTrayMenuItem
    break_mode_items: [3] DesktopTrayMenuItem
    item_count: s32
    // APP_NO_TRAY = 1 skips the tray entirely. With the lazy-GTK tray build
    // this also keeps libgtk-3 and its dependency chain out of the process;
    // closing or minimizing the window then quits instead of hiding.
    no_tray_name: [12]u8
    if !CopyCString("APP_NO_TRAY", no_tray_name[:]) {
        return 0
    }
    if tray_getenv(*no_tray_name[0]) != null {
        return 0
    }
    if !CopyCString("inbe", TrayId[:]) ||
    !CopyCString("Inner Breeze", TrayTitle[:]) ||
    !CopyCString("inbe", TrayIconName[:]) ||
    !CopyCString("inbe.png", TrayIconPath0[:]) ||
    !CopyCString("packaging/linux/appimage/inbe.png", TrayIconPath1[:]) ||
    !CopyCString("packaging/snap/snap/gui/inbe.png", TrayIconPath2[:]) ||
    !CopyCString("web-assets/icons/inbe.png", TrayIconPath3[:]) {
        return 0
    }
    TrayIconPaths[0] = *TrayIconPath0[0]
    TrayIconPaths[1] = *TrayIconPath1[0]
    TrayIconPaths[2] = *TrayIconPath2[0]
    TrayIconPaths[3] = *TrayIconPath3[0]
    TrayIconPaths[4] = null
    SeedTraySnapshot()
    item_count = BuildTrayMenu(*app_tray_snapshot, *items[0], 7, *start_items[0], 4,
        *habit_items[0], HABIT_MAX,
        *break_items[0], 4, *break_mode_items[0], 3)
    spec = DesktopTraySpec.{}
    spec.id = *TrayId[0]
    spec.title = *TrayTitle[0]
    spec.icon_name = *TrayIconName[0]
    spec.icon_paths = *TrayIconPaths[0]
    spec.close_action = cast(s32)DESKTOP_TRAY_ACTION_CLOSE_REQUEST
    spec.activate_action = cast(s32)GetTrayWindowAction(app_tray_snapshot.window_visible)
    spec.menu_items = *items[0]
    spec.menu_item_count = item_count
    TrayReady = DesktopTrayInit(*spec)
    return TrayReady
}
#program_export
desktop_tray_shutdown :: () {
    DesktopTrayShutdown()
    TrayReady = 0
}
#program_export
desktop_tray_poll_action :: () -> DesktopTrayAction {
    return cast(DesktopTrayAction)DesktopTrayPollAction()
}
#program_export
desktop_tray_ready :: () -> s32 {
    return ifx (TrayReady != 0 && DesktopTrayVisible() != 0) then (1) else (0)
}
RestoreTrayWindow :: () {
    ClearWindowState(FLAG_WINDOW_HIDDEN)
    RestoreWindow()
}
HideTrayWindow :: () {
    if desktop_tray_ready() == 0 {
        return
    }
    // The window vanishing with the process still running is the single
    // most confusing failure mode this app has; always say why it hid.
    message: [41]u8
    if CopyCString("APP: hiding main window (tray action)", message[:]) {
        TraceLog(3, *message[0])
    }
    SetWindowState(FLAG_WINDOW_HIDDEN)
}
#program_export
desktop_tray_keep_running :: () -> s32 {
    if desktop_tray_ready() == 0 {
        return 0
    }
    HideTrayWindow()
    return 1
}
StartTrayPractice :: (app: *InnerBreeze, practice_id: s32) {
    if app == null {
        return
    }
    app.exercise_type = practice_clamp_id(practice_id)
    app.main_tab = APP_MAIN_TAB_PRACTICE
    app.practice_tab = PRACTICE_TAB_PLAY
    if app.modal.active != 0 {
        app_close_modal(app)
    }
    RestoreTrayWindow()
    if app.exercise_type == EXERCISE_WIM_HOF {
        whm_practice_start(app)
    } else if app.exercise_type == EXERCISE_MEDITATION {
        meditation_practice_start(app)
    } else if app.exercise_type == EXERCISE_SUN_SALUTATION {
        sun_salutation_practice_start(app)
    } else if app.exercise_type == EXERCISE_PATTERNS {
        patterns_practice_start(app)
    }
}
MarkTrayHabit :: (app: *InnerBreeze, index: s32) {
    today: s32
    habit: *Habit
    if app == null || index < 0 || index >= app.habits.count  || index >= HABIT_MAX {
        return
    }
    today = habits_today_index()
    habit = *app.habits.items[index]
    if habit.counter_enabled != 0 {
        habit_set_day_count(*app.habits, index, today,
            HabitDayCount(habit, today) + 1)
    } else {
        habit_set_day(*app.habits, index, today, 1)
    }
}
UpdateTrayMenuSnapshot :: (app: *InnerBreeze) {
    next: AppTraySnapshot
    today: s32
    if app == null {
        return
    }
    next = AppTraySnapshot.{}
    next.window_visible = ifx (IsWindowHidden()) then (0) else (1)
    next.break_mode = app.breaks.mode
    next.break_reading_mode = app.breaks.reading_mode
    BuildTrayStatusText(app, next.status_label[:])
    FillTraySnapshotLabels(*next)
    today = habits_today_index()
    {
        i: s32 = 0
        while i < app.habits.count && i < HABIT_MAX  && next.count < HABIT_MAX {
            habit: *Habit = *app.habits.items[i]
            count: s32 = HabitDayCount(habit, today)
            if habit_completed_day(habit, today) != 0 || count > 0 {
                i += 1
                continue
            }
            AppCopyText(AppTextFromCString(*habit.name[0], size_of(type_of(habit.name))), next.habit_labels[next.count][:])
            next.habit_indices[next.count] = i
            next.habit_enabled[next.count] = 1
            next.count += 1
            i += 1
        }
    }
    if tray_memcmp(cast(*void)*app_tray_snapshot, cast(*void)*next, size_of(type_of(next))) != 0 {
        app_tray_snapshot = next
        ApplyTrayMenuSnapshot(*app_tray_snapshot)
    }
}
#program_export
desktop_tray_apply_action :: (app: *InnerBreeze, action: DesktopTrayAction, quit: *s32) {
    habit_index: s32 = GetTrayHabitIndex(action)
    if habit_index >= 0 {
        if habit_index < app_tray_snapshot.count {
            MarkTrayHabit(app, app_tray_snapshot.habit_indices[habit_index])
        }
        return
    }
    if action == {
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_SHOW;
        RestoreTrayWindow()

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_HIDE;
        HideTrayWindow()

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MINIMIZE;
        MinimizeWindow()

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_CLOSE_REQUEST;
        app_request_desktop_close(app)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_START_WHM;
        StartTrayPractice(app, EXERCISE_WIM_HOF)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_START_MEDITATION;
        StartTrayPractice(app, EXERCISE_MEDITATION)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_START_SUN_SALUTATION;
        StartTrayPractice(app, EXERCISE_SUN_SALUTATION)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_START_PATTERNS;
        StartTrayPractice(app, EXERCISE_PATTERNS)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_QUIT;
        if quit != null {
            quit.* = 1
        }

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_REST_NOW;
        if app.breaks_enabled != 0 {
            app_breaks_rest_break_now(app)
        }

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_MODE_NORMAL;
        app_breaks_set_mode(app, BreakModeNormal, 0)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_MODE_QUIET;
        app_breaks_set_mode(app, BreakModeQuiet, 0)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_MODE_SUSPENDED;
        app_breaks_set_mode(app, BreakModeSuspended, 0)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_READING_TOGGLE;
        app.breaks.reading_mode = ifx (app.breaks.reading_mode == 0) then (1) else (0)
        app.settings_dirty = 1

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_BREAK_SETTINGS;
        if app.modal.active != 0 {
            app_close_modal(app)
        }
        RestoreTrayWindow()
        app.settings_tab = SETTINGS_TAB_BREAKS
        app_switch_screen(app, ScreenSettings)

        case DesktopTrayAction.DESKTOP_TRAY_ACTION_NONE;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_0;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_1;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_2;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_3;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_4;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_5;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_6;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_7;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_8;
        return
        case DesktopTrayAction.DESKTOP_TRAY_ACTION_MARK_HABIT_9;
        return
    }
}
#program_export
desktop_tray_update_status :: (app: *InnerBreeze) {
    text: [128] u8
    now: float64
    window_visible: s32
    if app == null || TrayReady == 0 {
        return
    }
    now = GetTime()
    window_visible = ifx (IsWindowHidden()) then (0) else (1)
    if TrayStatusUpdateInitialized != 0 && window_visible == TrayLastWindowVisible  && now < TrayNextStatusUpdateTime {
        return
    }
    UpdateTrayMenuSnapshot(app)
    BuildTrayStatusText(app, text[:])
    if TrayStatusUpdateInitialized == 0 || tray_memcmp(cast(*void)*TrayLastStatusText[0], cast(*void)*text[0], size_of(type_of(text))) != 0 {
        DesktopTraySetStatus(*text[0])
    }
    TrayLastStatusText = text
    TrayStatusUpdateInitialized = 1
    TrayLastWindowVisible = window_visible
    TrayNextStatusUpdateTime = now + 1.0
}
