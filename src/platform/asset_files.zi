#import, file "../app/assets.zi";

// Embedded assets for the host's picture and font loaders. Kryon's desktop
// raster reads an embedded asset's bytes from memory and any other path from
// disk. On Android, Pixmap decodes a picture the first time it is drawn,
// from the app's bundles or else the APK's assets or the disk. The browser's
// canvas reads both through one load callback.
#if #defined(DESKTOP_HOST) {
    Assets :: #import "cairo_assets";
    #import "c_string"
    #import "byte_text_linux"

    // The bytes of an asset embedded in the executable; empty for other
    // paths, which the raster then reads from disk.
    ReadEmbeddedAsset :: (path: string) -> string {
        name: [4096]u8
        if !CopyCString(path, name[:]) {
            return ""
        }
        embedded := asset_lookup(*name[0])
        if !embedded.found || embedded.data == null || embedded.size == 0 {
            return ""
        }
        return TextFromBytes(BytesFromPointer(embedded.data, cast(u64)embedded.size))
    }

    InstallAssetFiles :: () {
        reader: Assets.RasterAssetRead = ReadEmbeddedAsset
        Assets.RasterUseAssets(reader)
    }
} else #if #defined(ANDROID_BUILD) {
    Pictures :: #import "pixmap_assets_android";
    PictureSource :: #import "pixmap_image_owner";
    // Kryon decodes WebP and AVIF in process only for apps that import the
    // codecs; without them every bundled picture is a Missing image box, and
    // Android's BitmapFactory cannot read AVIF before Android 12.
    #import "kryon/android_webp"
    #import "kryon/android_avif"
    #import "c_string"
    #import "byte_text_linux"

    #if #defined(ANDROID_DEBUG) {
        #import, file "host_clock.zi";
        #import, file "trace_log.zi";
    }

    // Lend encoded bundle bytes to the lazy picture cache. Header probes and
    // thumbnail draws use the same reader without eagerly decoding full size.
    ReadEmbeddedPicture :: (path: string) -> string {
        name: [4096]u8
        if CopyCString(path, name[:]) {
            embedded := asset_lookup(*name[0])
            if embedded.found && embedded.data != null && embedded.size > 0 {
                return TextFromBytes(BytesFromPointer(embedded.data, cast(u64)embedded.size))
            }
        }
        return ""
    }

    // Debug builds log picture header/source lookup time. Decoding is deferred
    // until the first draw knows the requested dimensions.
    LoadAssetPicture :: (path: string) -> bool {
        #if #defined(ANDROID_DEBUG) {
            started := HostSeconds()
            loaded := Pictures.AndroidPictureLoad(path)
            TraceLogPictureHeader(3, path, HostSeconds() - started, loaded)
            return loaded
        } else {
            return Pictures.AndroidPictureLoad(path)
        }
    }

    InstallAssetFiles :: () {
        reader: Pictures.AndroidPictureAssetRead = ReadEmbeddedPicture
        Pictures.AndroidPicturesUseAssets(reader)
        load: PictureSource.PixmapImageLoad = LoadAssetPicture
        unused PictureSource.PixmapImageSourceUse(load)
    }
} else #if !#defined(PLATFORM_WEB) {
    // A build that selects no host draws no pictures.
    InstallAssetFiles :: () {}
} else {
    asset_file_host :: #system_library "c";
    // The canvas's file loader takes the callback and frees each result.
    CanvasFiles :: #import "canvas_os";
    AssetFileCalloc :: (count: usize, size: usize) -> *u8 #foreign asset_file_host "calloc";
    AssetFileAllocate :: (size: u32) -> *u8 { return AssetFileCalloc(cast(usize)size, 1) }
    AssetFileFree :: (bytes: *u8) #foreign asset_file_host "free";
    AssetFileCopy :: (output: *u8, source: *u8,
        count: usize) -> *u8 #foreign asset_file_host "memcpy";
    AssetFileOpen :: (path: *u8, mode: *u8) -> *void #foreign asset_file_host "fopen";
    AssetFileRead :: (output: *u8, size: usize, count: usize,
        file: *void) -> usize #foreign asset_file_host "fread";
    AssetFileClose :: (file: *void) -> s32 #foreign asset_file_host "fclose";
    AssetFileLength :: (path: *u8) -> s32 { return CanvasFiles.GetFileLength(path) }

    // The canvas owns and frees the returned allocation. Embedded bytes remain
    // immutable, so each successful read returns a separate owned copy.
    ReadAssetFile :: (path: *u8, size: *s32) -> *u8 {
        if size == null {
            return null
        }
        size.* = 0
        if path == null || path[0] == 0 {
            return null
        }
        embedded := asset_lookup(path)
        if embedded.found {
            if embedded.data == null || embedded.size == 0 ||
                embedded.size > cast(usize)2147483647 {
                return null
            }
            bytes := AssetFileAllocate(cast(u32)embedded.size)
            if bytes == null {
                return null
            }
            AssetFileCopy(bytes, embedded.data, embedded.size)
            size.* = cast(s32)embedded.size
            return bytes
        }

        length := AssetFileLength(path)
        if length <= 0 {
            return null
        }
        mode: [3]u8
        mode[0] = #char "r"
        mode[1] = #char "b"
        file := AssetFileOpen(path, *mode[0])
        if file == null {
            return null
        }
        bytes := AssetFileAllocate(cast(u32)length)
        if bytes == null {
            AssetFileClose(file)
            return null
        }
        read := AssetFileRead(bytes, 1, cast(usize)length, file)
        AssetFileClose(file)
        if read != cast(usize)length {
            AssetFileFree(bytes)
            return null
        }
        size.* = length
        return bytes
    }

    InstallAssetFiles :: () {
        callback: CanvasFiles.CanvasLoadDataCallback = ReadAssetFile
        CanvasFiles.SetLoadFileDataCallback(callback)
    }
}
