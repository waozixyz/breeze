// Pass borrowed Ziran text to raylib without a C variadic adapter.
#import "byte_text_linux"
#import "c_string"

raylib_trace :: #system_library "raylib";
HostTraceLog :: (level: s32, format: *u8,
    args: ..any) #foreign raylib_trace "TraceLog";

TraceLog :: (level: s32, message: string) {
    if message.count > 2147483647 {
        return
    }
    format: [8]u8
    empty: [1]u8 = .[0]
    if !CopyCString("%.*s", format[:]) {
        return
    }
    data: *u8 = *empty[0]
    if message.count > 0 {
        descriptor := cast(*TextDescriptor)(*message)
        data = descriptor.data
    }
    HostTraceLog(level, *format[0], cast(s32)message.count, data)
}

TraceLogInit :: (level: s32, format_text: string,
    width: s32, height: s32, embedded: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    HostTraceLog(level, *format[0], width, height, embedded)
}

TraceLogScale :: (level: s32, format_text: string,
    scale: float32, width: s32, height: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    HostTraceLog(level, *format[0], cast(float64)scale, width, height)
}

TraceLogGeometry :: (level: s32, format_text: string,
    viewport_width: s32, viewport_height: s32,
    layout_width: s32, layout_height: s32, content_x: s32,
    content_width: s32, content_height: s32,
    scale: float32) {
    format: [160]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    HostTraceLog(level, *format[0], viewport_width, viewport_height,
        layout_width, layout_height, content_x, content_width,
        content_height, cast(float64)scale)
}

TraceLogResult :: (level: s32, format_text: string, result: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    HostTraceLog(level, *format[0], result)
}

TraceLogTwoInts :: (level: s32, format_text: string,
    first: s32, second: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    HostTraceLog(level, *format[0], first, second)
}
