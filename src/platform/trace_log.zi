// Inner Breeze's formatted log lines. On raylib hosts the format goes to
// raylib's TraceLog without a C variadic adapter; on Kryon's desktop host
// snprintf formats the line and app_trace logs it. Plain text goes through
// app_trace's TraceLog.
#import "c_string"
#import "byte_text_linux"
#import, file "app_trace.zi";
#if #defined(DESKTOP_HOST) {
    trace_log_c :: #system_library "c";
    TraceFormat :: (output: *u8, capacity: usize, format: *u8,
        args: ..any) -> s32 #foreign trace_log_c "snprintf";
} else {
    trace_log_raylib :: #system_library "raylib";
    HostTraceLog :: (level: s32, format: *u8,
        args: ..any) #foreign trace_log_raylib "TraceLog";
}

TraceLogInit :: (level: s32, format_text: string,
    width: s32, height: s32, embedded: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    #if #defined(DESKTOP_HOST) {
        line: [256]u8
        unused TraceFormat(*line[0], 256, *format[0], width, height, embedded)
        TraceLog(level, TextFromCString(*line[0]))
    } else {
        HostTraceLog(level, *format[0], width, height, embedded)
    }
}

TraceLogScale :: (level: s32, format_text: string,
    scale: float32, width: s32, height: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    #if #defined(DESKTOP_HOST) {
        line: [256]u8
        unused TraceFormat(*line[0], 256, *format[0], cast(float64)scale, width, height)
        TraceLog(level, TextFromCString(*line[0]))
    } else {
        HostTraceLog(level, *format[0], cast(float64)scale, width, height)
    }
}

TraceLogGeometry :: (level: s32, format_text: string,
    viewport_width: s32, viewport_height: s32,
    layout_width: s32, layout_height: s32, content_x: s32,
    content_width: s32, content_height: s32,
    scale: float32) {
    format: [160]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    #if #defined(DESKTOP_HOST) {
        line: [320]u8
        unused TraceFormat(*line[0], 320, *format[0], viewport_width, viewport_height,
            layout_width, layout_height, content_x, content_width,
            content_height, cast(float64)scale)
        TraceLog(level, TextFromCString(*line[0]))
    } else {
        HostTraceLog(level, *format[0], viewport_width, viewport_height,
            layout_width, layout_height, content_x, content_width,
            content_height, cast(float64)scale)
    }
}

TraceLogResult :: (level: s32, format_text: string, result: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    #if #defined(DESKTOP_HOST) {
        line: [256]u8
        unused TraceFormat(*line[0], 256, *format[0], result)
        TraceLog(level, TextFromCString(*line[0]))
    } else {
        HostTraceLog(level, *format[0], result)
    }
}

TraceLogTwoInts :: (level: s32, format_text: string,
    first: s32, second: s32) {
    format: [128]u8
    if !CopyCString(format_text, format[:]) {
        return
    }
    #if #defined(DESKTOP_HOST) {
        line: [256]u8
        unused TraceFormat(*line[0], 256, *format[0], first, second)
        TraceLog(level, TextFromCString(*line[0]))
    } else {
        HostTraceLog(level, *format[0], first, second)
    }
}
