c :: #system_library "c";

activity_idle_host :: () -> s64 #foreign c "app_idle_milliseconds";
activity_wayland_host :: () -> bool #foreign c "app_is_wayland";

// The desktop host asks its session idle service. No display window is
// inspected or controlled by this adapter.
#program_export
ActivityGetIdleMilliseconds :: () -> s64 { return activity_idle_host() }

#program_export
ActivityIsWayland :: () -> bool { return activity_wayland_host() }
