#import "async_client"
#if #defined(PLATFORM_WEB) {
    #import, file "browser_network.zi";
    NetworkTransfer :: struct {
        browser: BrowserTransfer
    }
}
#if #defined(ANDROID_BUILD) {
    #import, file "android/android_network.zi";
    NetworkTransfer :: struct {
        android: AndroidTransfer
    }
}
#if #defined(PLATFORM_WEB) == false && #defined(ANDROID_BUILD) == false {
    #import "net_http"
    NetworkTransfer :: struct {
        reserved: s32
    }

    // Native requests use SendCurl with caller-owned buffers
    // (daochi_native.zi), so this host declines net_http's blocking Send.
    // A Windows link resolves every host call, even unused ones.
    #program_export
    SendHost :: (request: HttpRequest) -> HttpResponse {
        unused request
        response: HttpResponse
        response.error = "blocking HTTP is not available on this host"
        return response
    }
}

NetworkTransport :: (transfer: *NetworkTransfer) -> AsyncTransport {
    #if #defined(PLATFORM_WEB) {
        return BrowserTransport(*transfer.browser)
    }
    #if #defined(ANDROID_BUILD) {
        return AndroidTransport(*transfer.android)
    }
    unused transfer
    transport: AsyncTransport
    return transport
}
