bottom_nav_route_image :: (route: s32) -> ImageProps {
    image: ImageProps
    image.alt_text = app_nav_route_label(route)
    if route == APP_NAV_ROUTE_LUMI {
        image.asset_path = "assets/lumi/sidebar.png"
        image.fit = ImageFit.ImageFitContain
        return image
    }
    image.asset_path = "icons/ui.png"
    x: s32 = 384
    y: s32 = 192
    if route == {
        case APP_NAV_ROUTE_DIARY;
        x = 64
        y = 448
        case APP_NAV_ROUTE_ELIST;
        x = 320
        y = 0
        case APP_NAV_ROUTE_HABITS;
        x = 128
        y = 448
        case APP_NAV_ROUTE_PRACTICE;
        x = 192
        y = 448
        case APP_NAV_ROUTE_SETTINGS;
        x = 256
        y = 448
        case APP_NAV_ROUTE_DATA;
        x = 256
        y = 256
        case APP_NAV_ROUTE_LEADERBOARD;
        x = 192
        y = 320
    }
    image.source = Rectangle.{cast(float32)x, cast(float32)y, 64.0, 64.0 }
    return image
}

// App navigation uses full-size outline marks, rather than scaling the
// padded atlas cells down to tiny glyphs in the compact dock.
app_nav_route_shape :: (route: s32) -> string {
    if route == APP_NAV_ROUTE_HABITS {
        return "S1.6rr:M5 19C2 10 10 5 20 4C19 14 12 21 5 19ZM5 19L16 8"
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return "S1.6rr:M12 21C7 14 7 8 12 3C17 8 17 14 12 21ZM11 21C5 20 2 15 3 8C9 9 12 14 11 21ZM13 21C19 20 22 15 21 8C15 9 12 14 13 21ZM6 21H18"
    }
    if route == APP_NAV_ROUTE_DIARY {
        return "S1.6rr:M12 6C9 4 6 4 3 5V20C6 19 9 19 12 21C15 19 18 19 21 20V5C18 4 15 4 12 6ZM12 6V21"
    }
    if route == APP_NAV_ROUTE_ELIST {
        return "S1.6rr:M8 6H21M8 12H21M8 18H21M3 6H3.1M3 12H3.1M3 18H3.1"
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return "S1.6rr:M12 12C15 12 17 10 17 7C17 4 15 2 12 2C9 2 7 4 7 7C7 10 9 12 12 12ZM3 22V20C3 15 7 14 12 14C17 14 21 15 21 20V22"
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return "S1.6rr:M10 3H14L15 6L18 6L21 10L19 12L21 15L18 19L15 18L14 21H10L9 18L6 19L3 15L5 12L3 10L6 6L9 6ZM16 12C16 17 8 17 8 12C8 7 16 7 16 12Z"
    }
    if route == APP_NAV_ROUTE_LUMI {
        return AssetRead("assets/lumi/sidebar.shape").data
    }
    return ""
}

bottom_nav_route_active :: (app: *InnerBreeze, route: s32) -> bool {
    if app == null {
        return false
    }
    if route == APP_NAV_ROUTE_LUMI {
        return app.breathing.screen == ScreenLumi
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return app.breathing.screen == ScreenProfile  && app.profile_view == PROFILE_VIEW_MAIN  && app.profile_tab == PROFILE_TAB_OVERVIEW
    }
    if route == APP_NAV_ROUTE_ACCOUNT {
        return app.breathing.screen == ScreenProfile  && app.profile_view == PROFILE_VIEW_MAIN  && app.profile_tab == PROFILE_TAB_SYNC
    }
    if route == APP_NAV_ROUTE_DATA {
        return app.breathing.screen == ScreenProfile  && (app.profile_view == PROFILE_VIEW_DATA  || app.profile_tab == PROFILE_TAB_DATA)
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return app.breathing.screen == ScreenProfile  && app.profile_tab == PROFILE_TAB_FRIENDS
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return app.breathing.screen == ScreenProfile  && app.profile_tab == PROFILE_TAB_LEADERBOARD
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app.breathing.screen == ScreenStart  && app.main_tab == APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app.breathing.screen == ScreenHabits  || app.breathing.screen == ScreenHabitEdit  || app.breathing.screen == ScreenHabitSessionEdit
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return app.breathing.screen == ScreenSettings
    }
    if route == APP_NAV_ROUTE_DIARY {
        return app.breathing.screen == ScreenDiary
    }
    return route == APP_NAV_ROUTE_ELIST  && app.breathing.screen == ScreenEList
}

// App routes and imagery remain in Inbe; Kryon owns dock composition,
// scrolling, button interaction, drag observations and anchored actions.
#program_export
app_draw_favorites_dock :: (app: *InnerBreeze) {
    desktop := app_nav_desktop_rail_enabled(app) != 0
    dock_width := app_nav_desktop_rail_width(app)
    props: NavigationBarProps
    props.key = KeyHash("inbe/apps/dock")
    props.id = 6600
    props.compact = true
    props.fit_items = true
    props.vertical = desktop
    props.scale = cast(float32)AppScale(100) / 100.0
    props.item_class_name = KssClassId(KssMakeName("launcher-dock"))
    props.class_name = props.item_class_name
    props.scroll_offset = app.launcher_dock_scroll
    props.draggable = true
    props.dragging = app.launcher_drag_moving
    props.drag_position = app.launcher_drag_pointer
    props.footer_count = 1
    height := app_dock_height(app)
    props.bounds = Rectangle.{0.0,
        cast(float32)(app.ui.view_height - height),
        cast(float32)app.ui.view_width, cast(float32)height}
    if app_navigation_placement(app) == NAVIGATION_TOP {
        props.bounds.y = -cast(float32)height
    }
    if desktop {
        x := -dock_width
        if app_navigation_placement(app) == NAVIGATION_RIGHT {
            x = app.ui.view_width
        }
        props.bounds = Rectangle.{cast(float32)x, 0.0,
            cast(float32)dock_width, cast(float32)app.ui.view_height}
    }
    routes: [LAUNCHER_APP_COUNT + 1]s32
    count: s32 = 0
    for index: cast(s32)0..app.launcher_favorite_count - 1 {
        route := app.launcher_favorites[index]
        if (app_nav_route_bit(route) & app.enabled_apps & CellsInstalledMask()) != 0 {
            routes[count] = route
            count += 1
        }
    }
    routes[count] = APP_NAV_ROUTE_APPS
    count += 1
    if desktop {
        PaintRoundedFill(app.ui.session, -1, props.bounds, 0.0, 4,
            StyleTokenColor("launcher-canvas"))
        // Keep Apps beside the favorites instead of across an empty rail.
        // Shrink crowded favorites together so every pin stays visible.
        layout := NavigationBarDockFitLayoutFor(props.bounds, true, count,
            props.footer_count, props.scale)
        extra_space := layout.scroll_bounds.height -
        cast(float32)layout.content_extent
        if extra_space > 0.0 {
            props.bounds.height -= extra_space
        }
    }
    items: [LAUNCHER_APP_COUNT + 1]NavigationBarItem
    for index: cast(s32)0..count - 1 {
        route := routes[index]
        items[index].key = cast(u64)(6600 + route)
        items[index].route = route
        items[index].label = app_nav_route_label(route)
        items[index].image = bottom_nav_route_image(route)
        items[index].icon_shape = app_nav_route_shape(route)
        items[index].active = !app.launcher_open && bottom_nav_route_active(app, route)
        items[index].disabled = app.modal.active != 0 ||
        app.blocked_input_frame == app.breathing.frame
        if route == APP_NAV_ROUTE_APPS {
            items[index].active = app.launcher_open
            items[index].image = ImageProps.{}
            items[index].icon_shape = "S1.6rr:M4 4H9V9H4ZM15 4H20V9H15ZM4 15H9V20H4ZM15 15H20V20H15Z"
        }
    }
    result := NavigationBar(app.ui.session, props, items[0:count])
    app.launcher_dock_scroll = result.scroll_offset
    app.launcher_dock_drop_index = result.drop_index
    if result.drag.started {
        app.launcher_drag_key = cast(u64)(6600 + result.drag_route)
        app.launcher_drag_route = result.drag_route
        app.launcher_drag_bounds = result.drag_bounds
        app.launcher_drag_origin = Vector2.{result.drag.x, result.drag.y}
        app.launcher_drag_grab = Vector2.{result.drag.grab_x, result.drag.grab_y}
        app.launcher_drag_vertical = true
        app.launcher_drag_moving = false
    }
    if result.drag.active || result.drag.ended {
        app_launcher_update_drag(app, Vector2.{result.drag.x, result.drag.y})
        app.launcher_drag_released = result.drag.ended
    }
    if result.clicked_route >= 0 && !app.launcher_drag_moving {
        if result.clicked_route == APP_NAV_ROUTE_APPS {
            app_launcher_toggle(app)
        } else {
            app_launcher_activate(app, result.clicked_route)
        }
    }
    if !app.launcher_open && app.launcher_drag_released {
        if app.launcher_drag_moving && result.drop_index >= 0 {
            app.launcher_favorite_count = LauncherPlaceFavorite(
                app.launcher_favorites[:], app.launcher_favorite_count,
                app.launcher_drag_route, result.drop_index)
            save_settings(app)
        }
        app.launcher_drag_key = 0
        app.launcher_drag_moving = false
        app.launcher_drag_released = false
    }
}

#program_export
app_draw_bottom_nav :: (app: *InnerBreeze) {
    if app == null || AppMiniMode() || app.host_feature != 0 ||
    app.launcher_open || app.file_dialog_active != 0 ||
    !SessionValid(app.ui.session) { return }
    if app_nav_desktop_rail_enabled(app) == 0 && app_navigation_height(app) == 0 { return }
    app_draw_favorites_dock(app)
}
