bottom_nav_route_image :: (route: s32) -> ImageProps {
    image: ImageProps
    image.alt_text = app_nav_route_label(route)
    if route == APP_NAV_ROUTE_LUMI {
        image.asset_path = "assets/lumi/sidebar.png"
        image.fit = ImageFit.ImageFitContain
        return image
    }
    image.asset_path = "icons/ui.png"
    x: s32 = 384
    y: s32 = 192
    if route == {
        case APP_NAV_ROUTE_DIARY;
        x = 64
        y = 448
        case APP_NAV_ROUTE_ELIST;
        x = 320
        y = 0
        case APP_NAV_ROUTE_HABITS;
        x = 128
        y = 448
        case APP_NAV_ROUTE_PRACTICE;
        x = 192
        y = 448
        case APP_NAV_ROUTE_SETTINGS;
        x = 256
        y = 448
        case APP_NAV_ROUTE_DATA;
        x = 256
        y = 256
        case APP_NAV_ROUTE_LEADERBOARD;
        x = 192
        y = 320
    }
    image.source = Rectangle.{cast(float32)x, cast(float32)y, 64.0, 64.0 }
    return image
}

// App navigation uses full-size outline marks, rather than scaling the
// padded atlas cells down to tiny glyphs in the compact dock.
app_nav_route_shape :: (route: s32) -> string {
    if route == APP_NAV_ROUTE_HABITS {
        return "S1.6rr:M5 19C2 10 10 5 20 4C19 14 12 21 5 19ZM5 19L16 8"
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return "S1.6rr:M12 21C7 14 7 8 12 3C17 8 17 14 12 21ZM11 21C5 20 2 15 3 8C9 9 12 14 11 21ZM13 21C19 20 22 15 21 8C15 9 12 14 13 21ZM6 21H18"
    }
    if route == APP_NAV_ROUTE_DIARY {
        return "S1.6rr:M12 6C9 4 6 4 3 5V20C6 19 9 19 12 21C15 19 18 19 21 20V5C18 4 15 4 12 6ZM12 6V21"
    }
    if route == APP_NAV_ROUTE_ELIST {
        return "S1.6rr:M8 6H21M8 12H21M8 18H21M3 6H3.1M3 12H3.1M3 18H3.1"
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return "S1.6rr:M12 12C15 12 17 10 17 7C17 4 15 2 12 2C9 2 7 4 7 7C7 10 9 12 12 12ZM3 22V20C3 15 7 14 12 14C17 14 21 15 21 20V22"
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return "S1.6rr:M10 3H14L15 6L18 6L21 10L19 12L21 15L18 19L15 18L14 21H10L9 18L6 19L3 15L5 12L3 10L6 6L9 6ZM16 12C16 17 8 17 8 12C8 7 16 7 16 12Z"
    }
    if route == APP_NAV_ROUTE_LUMI {
        return AssetRead("assets/lumi/sidebar.shape").data
    }
    return ""
}

bottom_nav_route_active :: (app: *InnerBreeze, route: s32) -> bool {
    if app == null {
        return false
    }
    if route == APP_NAV_ROUTE_LUMI {
        return app.breathing.screen == ScreenLumi
    }
    if route == APP_NAV_ROUTE_PROFILE {
        return app.breathing.screen == ScreenProfile  && app.profile_view == PROFILE_VIEW_MAIN  && app.profile_tab == PROFILE_TAB_OVERVIEW
    }
    if route == APP_NAV_ROUTE_ACCOUNT {
        return app.breathing.screen == ScreenProfile  && app.profile_view == PROFILE_VIEW_MAIN  && app.profile_tab == PROFILE_TAB_SYNC
    }
    if route == APP_NAV_ROUTE_DATA {
        return app.breathing.screen == ScreenProfile  && (app.profile_view == PROFILE_VIEW_DATA  || app.profile_tab == PROFILE_TAB_DATA)
    }
    if route == APP_NAV_ROUTE_FRIENDS {
        return app.breathing.screen == ScreenProfile  && app.profile_tab == PROFILE_TAB_FRIENDS
    }
    if route == APP_NAV_ROUTE_LEADERBOARD {
        return app.breathing.screen == ScreenProfile  && app.profile_tab == PROFILE_TAB_LEADERBOARD
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app.breathing.screen == ScreenStart  && app.main_tab == APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app.breathing.screen == ScreenHabits  || app.breathing.screen == ScreenHabitEdit  || app.breathing.screen == ScreenHabitSessionEdit
    }
    if route == APP_NAV_ROUTE_SETTINGS {
        return app.breathing.screen == ScreenSettings
    }
    if route == APP_NAV_ROUTE_DIARY {
        return app.breathing.screen == ScreenDiary
    }
    return route == APP_NAV_ROUTE_ELIST  && app.breathing.screen == ScreenEList
}

// Each dock shortcut keeps the ordinary button's hover, focus and press states.
app_draw_dock_route :: (app: *InnerBreeze, route: s32, bounds: Rectangle) -> bool {
    button: ButtonProps
    button.id = 6600 + route
    button.label = app_nav_route_label(route)
    button.bounds = bounds
    button.class_name = KssClassId(KssMakeName("launcher-dock"))
    button.icon_placement = cast(IconPlacement)IconPlacementAbove
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    button.selected = !app.launcher_open && bottom_nav_route_active(app, route)
    if route == APP_NAV_ROUTE_APPS {
        button.selected = app.launcher_open
        button.icon_shape = "S1.6rr:M4 4H9V9H4ZM15 4H20V9H15ZM4 15H9V20H4ZM15 15H20V20H15Z"
    } else {
        button.image = bottom_nav_route_image(route)
        button.icon_shape = app_nav_route_shape(route)
    }
    button.disabled = app.modal.active != 0 || app.blocked_input_frame == app.breathing.frame
    if Button(app.ui.session, button) == 0 { return false }
    if route == APP_NAV_ROUTE_APPS { app_launcher_toggle(app) }
    else { app_launcher_activate(app, route) }
    return true
}

// The same compact dock is composed inside the launcher overlay when open.
#program_export
app_draw_favorites_dock :: (app: *InnerBreeze) {
    desktop := app_nav_desktop_rail_enabled(app) != 0
    dock_width := app_nav_desktop_rail_width(app)
    x: s32 = 0
    y := app.ui.view_height - AppScale(84)
    if app_navigation_placement(app) == NAVIGATION_TOP { y = -AppScale(84) }
    if desktop {
        x = -dock_width - app.launcher_drawer_width
        if app_navigation_placement(app) == NAVIGATION_RIGHT {
            x = app.ui.view_width + app.launcher_drawer_width
        }
        PaintRoundedFill(app.ui.session, -1,
            Rectangle.{cast(float32)x, 0.0, cast(float32)dock_width,
                cast(float32)app.ui.view_height}, 0.0, 4,
            StyleTokenColor("launcher-canvas"))
        Text(app.ui.session, TextProps.{
                .text = "Inbe", .font = AppScale(18),
                .class_name = KssClassId(KssMakeName("launcher-heading")),
                .bounds = Rectangle.{cast(float32)x, 0.0,
                    cast(float32)dock_width, cast(float32)AppScale(88)},
                .align = cast(TextAlign)TextAlignCenter,
                .vertical_align = cast(TextAlign)TextAlignCenter})
    } else {
        PaintRoundedFill(app.ui.session, -1,
            Rectangle.{0.0, cast(float32)y, cast(float32)app.ui.view_width,
                cast(float32)AppScale(84)}, 0.0, 4,
            StyleTokenColor("launcher-canvas"))
    }
    routes: [LAUNCHER_APP_COUNT + 1]s32
    count: s32 = 0
    for index: cast(s32)0..app.launcher_favorite_count - 1 {
        route := app.launcher_favorites[index]
        if (app_nav_route_bit(route) & CellsInstalledMask()) != 0 {
            routes[count] = route
            count += 1
        }
    }
    routes[count] = APP_NAV_ROUTE_APPS
    count += 1
    gap := AppScale(8)
    item_width := (app.ui.view_width - AppScale(24) - gap * (count - 1)) / count
    if item_width > AppScale(144) { item_width = AppScale(144) }
    group_x := (app.ui.view_width - count * item_width - gap * (count - 1)) / 2
    // A larger dock scrolls its favorites while Apps and Profile stay reachable.
    if count > 3 {
        apps_bounds := Rectangle.{cast(float32)(app.ui.view_width - AppScale(100)),
            cast(float32)(y + AppScale(8)), cast(float32)AppScale(88),
            cast(float32)AppScale(68)}
        scroll: ScrollProps
        scroll.key = KeyHash("inbe/apps/dock")
        scroll.scroll_offset = app.launcher_dock_scroll
        scroll.horizontal = !desktop
        scroll.bounds = Rectangle.{cast(float32)AppScale(12), cast(float32)y,
            cast(float32)(app.ui.view_width - AppScale(120)), cast(float32)AppScale(84)}
        scroll.content_width = (count - 1) * AppScale(92) - gap
        if desktop {
            apps_y := AppScale(112 + (count - 1) * 84)
            if apps_y > app.ui.view_height - AppScale(188) {
                apps_y = app.ui.view_height - AppScale(188)
            }
            apps_bounds = Rectangle.{cast(float32)(x + AppScale(12)), cast(float32)apps_y,
                cast(float32)(dock_width - AppScale(24)), cast(float32)AppScale(72)}
            scroll.bounds = Rectangle.{cast(float32)x, cast(float32)AppScale(112),
                cast(float32)dock_width, cast(float32)(apps_y - AppScale(120))}
            scroll.content_height = (count - 1) * AppScale(84) - gap
        }
        scrolled := Scroll(app.ui.session, scroll)
        app.launcher_dock_scroll = scrolled.scroll_offset
        if scrolled.opened {
            activated := false
            for index: cast(s32)0..count - 2 {
                bounds := Rectangle.{scrolled.content.x + cast(float32)AppScale(index * 92),
                    cast(float32)(y + AppScale(8)), cast(float32)AppScale(84),
                    cast(float32)AppScale(68)}
                if desktop {
                    bounds = Rectangle.{cast(float32)(x + AppScale(12)),
                        scrolled.content.y + cast(float32)AppScale(index * 84),
                        cast(float32)(dock_width - AppScale(24)), cast(float32)AppScale(72)}
                }
                if app_draw_dock_route(app, routes[index], bounds) { activated = true }
            }
            TreePopScope(app.ui.session)
            if activated { return }
        }
        if app_draw_dock_route(app, APP_NAV_ROUTE_APPS, apps_bounds) { return }
    } else {
        for index: cast(s32)0..count - 1 {
            bounds := Rectangle.{cast(float32)(group_x + index * (item_width + gap)),
                cast(float32)(y + AppScale(8)), cast(float32)item_width,
                cast(float32)AppScale(68)}
            if desktop {
                bounds = Rectangle.{cast(float32)(x + AppScale(12)),
                    cast(float32)AppScale(112 + index * 84),
                    cast(float32)(dock_width - AppScale(24)), cast(float32)AppScale(72)}
            }
            if app_draw_dock_route(app, routes[index], bounds) { return }
        }
    }
    if desktop {
        profile: ButtonProps
        profile.id = 6690
        profile.label = app_nav_route_label(APP_NAV_ROUTE_PROFILE)
        profile.image = bottom_nav_route_image(APP_NAV_ROUTE_PROFILE)
        profile.icon_shape = app_nav_route_shape(APP_NAV_ROUTE_PROFILE)
        profile.icon_placement = cast(IconPlacement)IconPlacementAbove
        profile.class_name = KssClassId(KssMakeName("launcher-dock"))
        profile.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
        profile.selected = !app.launcher_open && app.breathing.screen == ScreenProfile
        profile.bounds = Rectangle.{cast(float32)(x + AppScale(12)),
            cast(float32)(app.ui.view_height - AppScale(88)),
            cast(float32)(dock_width - AppScale(24)), cast(float32)AppScale(72)}
        profile.disabled = app.modal.active != 0 || app.blocked_input_frame == app.breathing.frame
        if Button(app.ui.session, profile) != 0 {
            app_launcher_activate(app, APP_NAV_ROUTE_PROFILE)
        }
    }
}

#program_export
app_draw_bottom_nav :: (app: *InnerBreeze) {
    if app == null || AppMiniMode() || app.host_feature != 0 ||
    app.launcher_open || app.file_dialog_active != 0 ||
    !SessionValid(app.ui.session) { return }
    if app_nav_desktop_rail_enabled(app) == 0 && app_navigation_height(app) == 0 { return }
    app_draw_favorites_dock(app)
}
