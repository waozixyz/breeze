// The picture plane of the Tai Chi figures, as the course studio's
// FlatView (design/tai-chi/src/painted/layout.js): every joint is projected
// onto the plane of a camera that looks along a view yaw with a slight
// downward tilt. Units are metres; screen y points up.
#import "math"
#import, file "tai_chi_math.zi";

TaiChiFlatView :: struct {
    yaw: float64
    tilt: float64
    center: TaiChiVector3
    toward: TaiChiVector3
    flat_toward: TaiChiVector3
    right: TaiChiVector3
    up: TaiChiVector3
}

TaiChiCamera :: struct {
    yaw: float64
    tilt: float64
    center: TaiChiVector3
}

TaiChiFlatViewSet :: (view: *TaiChiFlatView, camera: TaiChiCamera) {
    view.yaw = camera.yaw
    view.tilt = camera.tilt
    view.center = TaiChiFlat3(camera.center)
    view.toward = TaiChiV3(Sin(camera.yaw) * Cos(camera.tilt), Sin(camera.tilt), Cos(camera.yaw) * Cos(camera.tilt))
    view.flat_toward = TaiChiV3(Sin(camera.yaw), 0.0, Cos(camera.yaw))
    view.right = TaiChiV3(Cos(camera.yaw), 0.0, -Sin(camera.yaw))
    view.up = TaiChiCross3(view.toward, view.right)
}

TaiChiProject :: (view: *TaiChiFlatView, point: TaiChiVector3) -> TaiChiVector2 {
    offset := TaiChiSub3(point, view.center)
    return TaiChiV2(TaiChiDot3(offset, view.right), TaiChiDot3(offset, view.up))
}

TaiChiProjectVector :: (view: *TaiChiFlatView, vector: TaiChiVector3) -> TaiChiVector2 {
    return TaiChiV2(TaiChiDot3(vector, view.right), TaiChiDot3(vector, view.up))
}

TaiChiDepth :: (view: *TaiChiFlatView, point: TaiChiVector3) -> float64 {
    return TaiChiDot3(TaiChiSub3(point, view.center), view.toward)
}
