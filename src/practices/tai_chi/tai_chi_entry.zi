using ExerciseType;
using ModalType;

// The audio player remains an Inbe host effect until its module is migrated.
meditation_music_start_session :: (app: *InnerBreeze) #foreign c;

tai_chi_course_generation: u64;
tai_chi_course_owned: bool;
tai_chi_unlock_requested: bool;
// Transient chooser state; character and course progress remain in settings.
tai_chi_selected_lesson: s32;
tai_chi_course_scroll: s32;
tai_chi_lesson_scroll: s32;
tai_chi_reveal_next: bool;
tai_chi_customize_scroll: s32;

// The course from the Practices package, read again when a new package
// replaces the assets.
#program_export
TaiChiCourseLoad :: () -> bool {
    generation := AssetGeneration()
    owned := UnlockOwned(UnlockTaiChi)
    if tai_chi_course.loaded && tai_chi_course_generation == generation && tai_chi_course_owned == owned {
        return true
    }
    tai_chi_course.loaded = false
    found, loaded := TaiChiCourseRead(
        ifx owned then TAI_CHI_COURSE_PATH else "assets/practices/taichi-preview/course.zip",
        generation, owned)
    if found {
        return loaded
    }
    // A new owner can keep using the preview while the full pack downloads.
    // Older installed packages can use their existing complete course; the
    // same item guard still applies before a timeline starts.
    fallback_found, fallback_loaded := TaiChiCourseRead(
        ifx owned then "assets/practices/taichi-preview/course.zip" else TAI_CHI_COURSE_PATH,
        generation, owned)
    return fallback_found && fallback_loaded
}

// Finish parsing one borrowed asset before another provider lookup can run.
TaiChiCourseRead :: (path: string, generation: u64,
    owned: bool) -> (found: bool, loaded: bool) {
    asset := AssetRead(path)
    if !asset.found {
        return false, false
    }
    tai_chi_course_generation = generation
    tai_chi_course_owned = owned
    return true, TaiChiCourseParseArchive(*tai_chi_course, asset.data)
}

// Starting, previewing and resuming all use the same item boundary.
TaiChiItemAllowed :: (item: s32) -> bool {
    if item < 0 || item >= tai_chi_course.item_count {
        return false
    }
    row := tai_chi_course.items[item]
    return row.source != TAI_CHI_SOURCE_LOCKED &&
    (TaiChiItemFree(TaiChiCourseString(row.id)) || UnlockOwned(UnlockTaiChi))
}

// Plays `item` of the course.
#program_export
tai_chi_practice_start_item :: (app: *InnerBreeze, item: s32) {
    if app == null || !ActivityStartAllowed() || !TaiChiCourseLoad() {
        return
    }
    if !TaiChiItemAllowed(item) {
        tai_chi_unlock_requested = true
        if app.modal.type != cast(ModalType)ModalTaiChiCourse {
            app_open_modal(app, cast(ModalType)ModalTaiChiCourse)
        }
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_TAI_CHI)
    tai_chi_reading_seconds = PracticeTaiChiReadingSeconds
    tai_chi_reading_enabled = app.voice_narration_enabled != 0
    PracticeNarrationStop()
    app.tai_chi = TaiChiNormalizeSettings(app.tai_chi)
    app.tai_chi = TaiChiStartItem(app.tai_chi, item)
    if app.tai_chi.built_item < 0 {
        return
    }
    PracticeFigurePrepare(app.tai_chi.character == 1)
    app.session_paused = 0
    app_close_modal(app)
    PracticeDraftBegin(EXERCISE_TAI_CHI)
    app_switch_screen(app, ScreenTaiChi)
    meditation_music_start_session(app)
}

// Start opens the gallery, including free Foundations and numbered lessons.
#program_export
tai_chi_practice_start :: (app: *InnerBreeze) {
    if app == null || !TaiChiCourseLoad() {
        return
    }
    tai_chi_unlock_requested = false
    tai_chi_selected_lesson = -1
    tai_chi_course_scroll = 0
    tai_chi_lesson_scroll = 0
    tai_chi_reveal_next = false
    // Tray and web shortcuts can enter from a different practice screen.
    // The chooser belongs over Tai Chi's home, just like Start there.
    route := app_current_route(app)
    route.screen = ScreenStart
    route.practice_tab = PRACTICE_TAB_PLAY
    app_switch_route(app, route)
    app_open_modal(app, cast(ModalType)ModalTaiChiCourse)
}

#program_export
tai_chi_customize_open :: (app: *InnerBreeze) {
    if app == null || !TaiChiCourseLoad() {
        return
    }
    tai_chi_customize_scroll = 0
    app_open_modal(app, cast(ModalType)ModalTaiChiCustomize)
}
