// Vectors and rotations for the Tai Chi figure, in double precision. The
// operations follow three.js, which the course studio is built on, so the
// app reproduces the studio's figure number for number.
#import "math"

TAI_CHI_PI :: 3.141592653589793
TAI_CHI_DEGREE :: 0.017453292519943295

TaiChiVector2 :: struct {
    x: float64
    y: float64
}

TaiChiVector3 :: struct {
    x: float64
    y: float64
    z: float64
}

TaiChiQuaternion :: struct {
    x: float64
    y: float64
    z: float64
    w: float64
}

// --- Two dimensions ------------------------------------------------------

TaiChiV2 :: (x: float64, y: float64) -> TaiChiVector2 {
    return TaiChiVector2.{.x = x, .y = y}
}

TaiChiAdd2 :: (a: TaiChiVector2, b: TaiChiVector2) -> TaiChiVector2 {
    return TaiChiV2(a.x + b.x, a.y + b.y)
}

TaiChiSub2 :: (a: TaiChiVector2, b: TaiChiVector2) -> TaiChiVector2 {
    return TaiChiV2(a.x - b.x, a.y - b.y)
}

TaiChiScale2 :: (a: TaiChiVector2, k: float64) -> TaiChiVector2 {
    return TaiChiV2(a.x * k, a.y * k)
}

TaiChiLength2 :: (a: TaiChiVector2) -> float64 {
    return Sqrt(a.x * a.x + a.y * a.y)
}

TaiChiUnit2 :: (a: TaiChiVector2, fallback: TaiChiVector2) -> TaiChiVector2 {
    size := TaiChiLength2(a)
    if size > 0.000001 {
        return TaiChiScale2(a, 1.0 / size)
    }
    return fallback
}

// --- Three dimensions ----------------------------------------------------

TaiChiV3 :: (x: float64, y: float64, z: float64) -> TaiChiVector3 {
    return TaiChiVector3.{.x = x, .y = y, .z = z}
}

TaiChiAdd3 :: (a: TaiChiVector3, b: TaiChiVector3) -> TaiChiVector3 {
    return TaiChiV3(a.x + b.x, a.y + b.y, a.z + b.z)
}

TaiChiSub3 :: (a: TaiChiVector3, b: TaiChiVector3) -> TaiChiVector3 {
    return TaiChiV3(a.x - b.x, a.y - b.y, a.z - b.z)
}

TaiChiScale3 :: (a: TaiChiVector3, k: float64) -> TaiChiVector3 {
    return TaiChiV3(a.x * k, a.y * k, a.z * k)
}

// a + b * k
TaiChiAddScaled3 :: (a: TaiChiVector3, b: TaiChiVector3, k: float64) -> TaiChiVector3 {
    return TaiChiV3(a.x + b.x * k, a.y + b.y * k, a.z + b.z * k)
}

TaiChiDot3 :: (a: TaiChiVector3, b: TaiChiVector3) -> float64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

TaiChiCross3 :: (a: TaiChiVector3, b: TaiChiVector3) -> TaiChiVector3 {
    return TaiChiV3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

TaiChiLengthSquared3 :: (a: TaiChiVector3) -> float64 {
    return a.x * a.x + a.y * a.y + a.z * a.z
}

TaiChiLength3 :: (a: TaiChiVector3) -> float64 {
    return Sqrt(TaiChiLengthSquared3(a))
}

TaiChiDistance3 :: (a: TaiChiVector3, b: TaiChiVector3) -> float64 {
    return TaiChiLength3(TaiChiSub3(a, b))
}

// Scaled to length one; a zero vector stays zero.
TaiChiNormalize3 :: (a: TaiChiVector3) -> TaiChiVector3 {
    size := TaiChiLength3(a)
    if size == 0.0 {
        return a
    }
    return TaiChiScale3(a, 1.0 / size)
}

TaiChiLerp3 :: (a: TaiChiVector3, b: TaiChiVector3, u: float64) -> TaiChiVector3 {
    return TaiChiV3(a.x + (b.x - a.x) * u, a.y + (b.y - a.y) * u, a.z + (b.z - a.z) * u)
}

TaiChiFlat3 :: (a: TaiChiVector3) -> TaiChiVector3 {
    return TaiChiV3(a.x, 0.0, a.z)
}

// --- Rotations -------------------------------------------------------------

TaiChiIdentity :: () -> TaiChiQuaternion {
    return TaiChiQuaternion.{.x = 0.0, .y = 0.0, .z = 0.0, .w = 1.0}
}

// The rotation by `angle` about the unit `axis`.
TaiChiAxisAngle :: (axis: TaiChiVector3, angle: float64) -> TaiChiQuaternion {
    half := angle / 2.0
    s := Sin(half)
    return TaiChiQuaternion.{.x = axis.x * s, .y = axis.y * s, .z = axis.z * s, .w = Cos(half)}
}

// a then b in the frame of a, as three.js `a.multiply(b)`.
TaiChiMultiply :: (a: TaiChiQuaternion, b: TaiChiQuaternion) -> TaiChiQuaternion {
    result: TaiChiQuaternion
    result.x = a.x * b.w + a.w * b.x + a.y * b.z - a.z * b.y
    result.y = a.y * b.w + a.w * b.y + a.z * b.x - a.x * b.z
    result.z = a.z * b.w + a.w * b.z + a.x * b.y - a.y * b.x
    result.w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    return result
}

TaiChiRotate :: (v: TaiChiVector3, q: TaiChiQuaternion) -> TaiChiVector3 {
    tx := 2.0 * (q.y * v.z - q.z * v.y)
    ty := 2.0 * (q.z * v.x - q.x * v.z)
    tz := 2.0 * (q.x * v.y - q.y * v.x)
    return TaiChiV3(v.x + q.w * tx + q.y * tz - q.z * ty,
        v.y + q.w * ty + q.z * tx - q.x * tz,
        v.z + q.w * tz + q.x * ty - q.y * tx)
}

// The local axis (x, y, z) of a frame turned by `q`.
TaiChiAxis :: (q: TaiChiQuaternion, x: float64, y: float64, z: float64) -> TaiChiVector3 {
    return TaiChiRotate(TaiChiV3(x, y, z), q)
}

TaiChiNormalizeQuaternion :: (q: TaiChiQuaternion) -> TaiChiQuaternion {
    size := Sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
    if size == 0.0 {
        return TaiChiIdentity()
    }
    return TaiChiQuaternion.{.x = q.x / size, .y = q.y / size, .z = q.z / size, .w = q.w / size}
}

// Spherical interpolation from a toward b, as three.js `a.slerp(b, t)`.
TaiChiSlerp :: (a: TaiChiQuaternion, b: TaiChiQuaternion, t: float64) -> TaiChiQuaternion {
    if t == 0.0 {
        return a
    }
    if t == 1.0 {
        return b
    }
    result := b
    cos_half := a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z
    if cos_half < 0.0 {
        result.x = -b.x
        result.y = -b.y
        result.z = -b.z
        result.w = -b.w
        cos_half = -cos_half
    }
    if cos_half >= 1.0 {
        return a
    }
    sin_squared := 1.0 - cos_half * cos_half
    if sin_squared <= 0.0000000000000002220446049250313 {
        s := 1.0 - t
        result.w = s * a.w + t * result.w
        result.x = s * a.x + t * result.x
        result.y = s * a.y + t * result.y
        result.z = s * a.z + t * result.z
        return TaiChiNormalizeQuaternion(result)
    }
    sin_half := Sqrt(sin_squared)
    half := Atan2(sin_half, cos_half)
    ratio_a := Sin((1.0 - t) * half) / sin_half
    ratio_b := Sin(t * half) / sin_half
    result.w = a.w * ratio_a + result.w * ratio_b
    result.x = a.x * ratio_a + result.x * ratio_b
    result.y = a.y * ratio_a + result.y * ratio_b
    result.z = a.z * ratio_a + result.z * ratio_b
    return result
}

// The rotation whose local axes are the columns x, y and z, as three.js
// `setFromRotationMatrix(makeBasis(x, y, z))`.
TaiChiFromBasis :: (x: TaiChiVector3, y: TaiChiVector3, z: TaiChiVector3) -> TaiChiQuaternion {
    m11 := x.x
    m12 := y.x
    m13 := z.x
    m21 := x.y
    m22 := y.y
    m23 := z.y
    m31 := x.z
    m32 := y.z
    m33 := z.z
    trace := m11 + m22 + m33
    q: TaiChiQuaternion
    if trace > 0.0 {
        s := 0.5 / Sqrt(trace + 1.0)
        q.w = 0.25 / s
        q.x = (m32 - m23) * s
        q.y = (m13 - m31) * s
        q.z = (m21 - m12) * s
    } else if m11 > m22 && m11 > m33 {
        s := 2.0 * Sqrt(1.0 + m11 - m22 - m33)
        q.w = (m32 - m23) / s
        q.x = 0.25 * s
        q.y = (m12 + m21) / s
        q.z = (m13 + m31) / s
    } else if m22 > m33 {
        s := 2.0 * Sqrt(1.0 + m22 - m11 - m33)
        q.w = (m13 - m31) / s
        q.x = (m12 + m21) / s
        q.y = 0.25 * s
        q.z = (m23 + m32) / s
    } else {
        s := 2.0 * Sqrt(1.0 + m33 - m11 - m22)
        q.w = (m21 - m12) / s
        q.x = (m13 + m31) / s
        q.y = (m23 + m32) / s
        q.z = 0.25 * s
    }
    return q
}

TaiChiClamp :: (value: float64, low: float64, high: float64) -> float64 {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

TaiChiAbs :: (value: float64) -> float64 {
    if value < 0.0 {
        return -value
    }
    return value
}

TaiChiMin :: (a: float64, b: float64) -> float64 {
    if a < b {
        return a
    }
    return b
}

TaiChiMax :: (a: float64, b: float64) -> float64 {
    if a > b {
        return a
    }
    return b
}

TaiChiSmoothstep :: (u: float64) -> float64 {
    return u * u * (3.0 - 2.0 * u)
}

// A smooth step from 0 at `from` to 1 at `to`.
TaiChiSmoothRamp :: (value: float64, from: float64, to: float64) -> float64 {
    u := TaiChiClamp((value - from) / (to - from), 0.0, 1.0)
    return u * u * (3.0 - 2.0 * u)
}

// The angle of a vector, as JavaScript's Math.hypot for two values.
TaiChiHypot :: (a: float64, b: float64) -> float64 {
    return Sqrt(a * a + b * b)
}
