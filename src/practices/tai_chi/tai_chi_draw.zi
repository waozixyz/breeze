// Draws the flat Tai Chi figure: the pose at the practice's time, solved and
// turned into paint operations as the course studio does (tai_chi_flat.zi),
// each filled shape and line drawn as a tinted mesh with Kryon's image mesh
// over flat-edge.png, one row of texels clear at both ends and opaque
// between. A shape is a fan from its middle out past its edge, a line a
// strip across it; with smooth scaling every edge gets a soft, even border.
// The image's middle columns are the shape's inside: textures repeat, so
// its two ends blend into each other and are only ever its outer edge.
#import "geometry"
Image :: #import "kryon/image";
Layout :: #import "kryon/layout";
#import "session"
#import, file "tai_chi_math.zi";
#import, file "../practice_figure_draw.zi";
#import, file "tai_chi_course.zi";
#import, file "tai_chi_timeline.zi";
#import, file "tai_chi_solve.zi";
#import, file "tai_chi_view.zi";
#import, file "tai_chi_flat.zi";
#import, file "tai_chi_flat_mesh.zi";
#import, file "tai_chi_rules.zi";
#import, file "tai_chi_entry.zi";
#import, file "../../app/assets.zi";

TAI_CHI_FLAT_EDGE_PATH :: "assets/practices/taichi/flat-edge.png"
// Half the soft border of a filled shape, in pixels.
TAI_CHI_FLAT_FEATHER :: 0.75
// The thinnest line drawn, in pixels.
TAI_CHI_FLAT_THINNEST :: 1.2
TAI_CHI_FLAT_MESH_CAPACITY :: 4 * (TAI_CHI_FLAT_SCRATCH * 2 + 1)

tai_chi_flat_frame: TaiChiFlatFrame;

// The frame is fixed for the piece. Foot keys are world-space positions,
// so the original steps determine the room needed on either side.
TaiChiStageFraming :: (timeline: *TaiChiTimeline, rig: *TaiChiRig, angle: s32, aspect: float64) -> TaiChiFraming {
    view := TaiChiViewSpecFor(angle)
    camera: TaiChiCameraState
    camera.yaw = view.yaw
    if !view.fixed {
        camera.yaw += timeline.keys[0].channels[TAI_CHI_FACING]
    }
    low := TaiChiV3(1000.0, 0.0, 1000.0)
    high := TaiChiV3(-1000.0, 0.0, -1000.0)
    for index: cast(s32)0..timeline.count - 1 {
        for side: cast(s32)0..1 {
            base := TaiChiFootBase(side)
            x := timeline.keys[index].channels[base + TAI_CHI_FOOT_X] * rig.scale
            z := timeline.keys[index].channels[base + TAI_CHI_FOOT_Z] * rig.scale
            low.x = TaiChiMin(low.x, x)
            high.x = TaiChiMax(high.x, x)
            low.z = TaiChiMin(low.z, z)
            high.z = TaiChiMax(high.z, z)
        }
    }
    camera.center = TaiChiLerp3(low, high, 0.5)
    framing := TaiChiFramingFor(camera, view)
    flat: TaiChiFlatView
    TaiChiFlatViewSet(*flat, framing.camera)
    width := 1.66 + (high.x - low.x) * TaiChiAbs(flat.right.x) + (high.z - low.z) * TaiChiAbs(flat.right.z)
    pitch_span := (high.x - low.x) * TaiChiAbs(flat.up.x) + (high.z - low.z) * TaiChiAbs(flat.up.z)
    framing.view_height = TaiChiMax(framing.view_height + pitch_span, width / aspect)
    return framing
}

TaiChiStageMan :: (character: s32) -> bool {
    return TaiChiFlatLookFor(character).male
}

TaiChiDrawFigure :: (session: Session, state: *TaiChiPracticeState, area: Rectangle, dt: float64, snap: bool,
    alt_text: string) {
    if state.built_item < 0 || area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    character := state.character
    if character < 0 || character >= TAI_CHI_CHARACTER_COUNT {
        character = 0
    }
    pose := TaiChiTimelineSample(*tai_chi_timeline, state.time)
    rig := TaiChiRigFor(character)
    solved := TaiChiSolvePose(*pose, *rig)
    framing := TaiChiStageFraming(*tai_chi_timeline, *rig, state.view, cast(float64)area.width / cast(float64)area.height)
    key := Layout.KeyHash("inbe/practices/tai_chi/figure")
    mirrored := TaiChiViewMirrored(state.view)
    digest := TaiChiDigest(cast(u64)state.built_item + 1, state.time)
    digest = TaiChiDigest(digest, cast(float64)state.view + 8.0 * cast(float64)character)
    if !PracticeFigureDrawModel(session, *solved, *rig, framing, TaiChiStageMan(character), mirrored,
        area, key, alt_text, state.time, digest, .{.tai_chi = true}) {
        TaiChiFlatPaint(*tai_chi_flat_frame, *solved, *rig, character, framing.camera)
        TaiChiPaintFlat(session, *tai_chi_flat_frame, framing, mirrored, area, key, alt_text)
    }
    unused dt
    unused snap
}

// Shared painting for the live player and the course thumbnails.
TaiChiPaintFlat :: (session: Session, frame: *TaiChiFlatFrame, framing: TaiChiFraming,
    mirrored: bool, area: Rectangle, key: u64, alt_text: string) {
    edge := "assets/practices/taichi-preview/flat-edge.png"
    if AssetRead(TAI_CHI_FLAT_EDGE_PATH).found {
        edge = TAI_CHI_FLAT_EDGE_PATH
    }
    TaiChiPaintFlatEdge(session, frame, framing, mirrored, area, key, alt_text, edge)
}

// A figure that holds still, such as a guide's pose chart or a paused
// practice, paints the same meshes every frame. Its caller names what the
// figure depends on with a digest. After the same digest comes twice in a
// row the meshes are kept, and later frames replay them instead of solving
// and meshing the figure again. A moving figure never repeats its digest,
// so it is never copied.
TAI_CHI_FLAT_CACHE_SLOTS :: 16
TAI_CHI_FLAT_CACHE_OPS :: 384
TAI_CHI_FLAT_CACHE_POINTS :: 24576

TaiChiFlatCachedOp :: struct {
    index: s32
    first: s32
    count: s32
    columns: s32
    tint: u32
    labelled: bool
}

// Points are kept relative to the area's corner, so a figure that only
// moves, as in a scrolling page, still replays.
TaiChiFlatCacheSlot :: struct {
    key: u64
    digest: u64
    width: float32
    height: float32
    stored: bool
    used: u64
    op_count: s32
    point_count: s32
    ops: [TAI_CHI_FLAT_CACHE_OPS]TaiChiFlatCachedOp
    points: [TAI_CHI_FLAT_CACHE_POINTS]Vector2
}

tai_chi_flat_cache: [TAI_CHI_FLAT_CACHE_SLOTS]TaiChiFlatCacheSlot;
tai_chi_flat_cache_clock: u64;

// This figure's slot at this size, or -1.
TaiChiFlatCacheFind :: (key: u64, area: Rectangle) -> s32 {
    for index: cast(s32)0..TAI_CHI_FLAT_CACHE_SLOTS - 1 {
        slot := *tai_chi_flat_cache[index]
        if slot.used != 0 && slot.key == key && slot.width == area.width &&
        slot.height == area.height {
            return index
        }
    }
    return -1
}

// Draws the kept meshes of this figure when they were kept for this digest.
TaiChiPaintFlatCached :: (session: Session, key: u64, digest: u64, area: Rectangle,
    alt_text: string, edge_path: string) -> bool {
    found := TaiChiFlatCacheFind(key, area)
    if digest == 0 || found < 0 {
        return false
    }
    slot := *tai_chi_flat_cache[found]
    if !slot.stored || slot.digest != digest {
        return false
    }
    tai_chi_flat_cache_clock += 1
    slot.used = tai_chi_flat_cache_clock
    screen: [TAI_CHI_FLAT_MESH_CAPACITY]Vector2
    for at: cast(s32)0..slot.op_count - 1 {
        op := slot.ops[at]
        for point: cast(s32)0..op.count - 1 {
            kept := slot.points[op.first + point]
            screen[point] = Vector2.{area.x + kept.x, area.y + kept.y}
        }
        picture: Image.Props
        picture.key = key + cast(u64)op.index
        picture.bounds = area
        picture.smooth = true
        picture.alt_text = ifx op.labelled then alt_text else ""
        picture.asset_path = edge_path
        picture.tint = op.tint
        picture.mesh.columns = op.columns
        picture.mesh.rows = op.count / op.columns
        picture.mesh.points = screen[:op.count]
        Image.Draw(session, picture)
    }
    return true
}

// The slot to fill while this figure paints, or -1. The first frame with a
// new digest only remembers it; the second one keeps the meshes.
TaiChiFlatCacheBegin :: (key: u64, digest: u64, area: Rectangle) -> s32 {
    if digest == 0 {
        return -1
    }
    found := TaiChiFlatCacheFind(key, area)
    tai_chi_flat_cache_clock += 1
    if found < 0 {
        found = 0
        for index: cast(s32)1..TAI_CHI_FLAT_CACHE_SLOTS - 1 {
            if tai_chi_flat_cache[index].used < tai_chi_flat_cache[found].used {
                found = index
            }
        }
        slot := *tai_chi_flat_cache[found]
        slot.key = key
        slot.width = area.width
        slot.height = area.height
        slot.digest = 0
    }
    slot := *tai_chi_flat_cache[found]
    slot.used = tai_chi_flat_cache_clock
    slot.op_count = 0
    slot.point_count = 0
    if slot.digest != digest {
        slot.digest = digest
        slot.stored = false
        return -1
    }
    return found
}

// Keeps one painted mesh; false when the slot is full and cannot keep this
// figure.
TaiChiFlatCacheKeep :: (slot: *TaiChiFlatCacheSlot, index: s32, mesh: []Vector2,
    columns: s32, tint: u32, labelled: bool, area: Rectangle) -> bool {
    count := cast(s32)mesh.count
    if slot.op_count >= TAI_CHI_FLAT_CACHE_OPS ||
    slot.point_count + count > TAI_CHI_FLAT_CACHE_POINTS {
        return false
    }
    slot.ops[slot.op_count] = TaiChiFlatCachedOp.{.index = index, .first = slot.point_count,
        .count = count, .columns = columns, .tint = tint, .labelled = labelled}
    for point: cast(s32)0..count - 1 {
        slot.points[slot.point_count + point] = Vector2.{mesh[point].x - area.x, mesh[point].y - area.y}
    }
    slot.op_count += 1
    slot.point_count += count
    return true
}

// The same painting with another practice's copy of the edge image. A
// non-zero digest offers the figure to the cache (TaiChiPaintFlatCached).
TaiChiPaintFlatEdge :: (session: Session, frame: *TaiChiFlatFrame, framing: TaiChiFraming,
    mirrored: bool, area: Rectangle, key: u64, alt_text: string, edge_path: string,
    digest: u64 = 0) {
    keeping := TaiChiFlatCacheBegin(key, digest, area)
    kept := keeping >= 0
    // Metres on the picture plane to pixels in the area: the view's height
    // fills the area's height, centred on its middle.
    pixels := cast(float64)area.height / framing.view_height
    middle_x := cast(float64)area.x + cast(float64)area.width / 2.0
    middle_y := cast(float64)area.y + cast(float64)area.height / 2.0
    mirror: float64 = 1.0
    if mirrored {
        mirror = -1.0
    }
    screen: [TAI_CHI_FLAT_MESH_CAPACITY]Vector2
    for index: cast(s32)0..frame.op_count - 1 {
        op := frame.ops[index]
        points := frame.points[op.first:op.first + op.count]
        count: s32 = 0
        columns: s32 = 0
        if op.kind == TAI_CHI_FLAT_FILL {
            count = TaiChiFlatFanMesh(points, TAI_CHI_FLAT_FEATHER / pixels, screen[:])
            columns = 4
        } else {
            width := TaiChiMax(op.width, TAI_CHI_FLAT_THINNEST / pixels)
            count = TaiChiFlatStripMesh(points, width * 0.75, screen[:])
            columns = 2
        }
        if count == 0 {
            continue
        }
        for point: cast(s32)0..count - 1 {
            screen[point].x = cast(float32)(middle_x + cast(float64)screen[point].x * pixels * mirror)
            screen[point].y = cast(float32)(middle_y - (cast(float64)screen[point].y - framing.view_center) * pixels)
        }
        alpha := cast(u32)(TaiChiClamp(op.alpha, 0.0, 1.0) * 255.0 + 0.5)
        if alpha == cast(u32)0 {
            continue
        }
        labelled := index == frame.op_count - 1
        tint := (op.color << cast(u32)8) | alpha
        picture: Image.Props
        picture.key = key + cast(u64)index
        picture.bounds = area
        picture.smooth = true
        picture.alt_text = ifx labelled then alt_text else ""
        picture.asset_path = edge_path
        picture.tint = tint
        picture.mesh.columns = columns
        picture.mesh.rows = count / columns
        picture.mesh.points = screen[:count]
        Image.Draw(session, picture)
        if kept {
            kept = TaiChiFlatCacheKeep(*tai_chi_flat_cache[keeping], index, screen[:count],
                columns, tint, labelled, area)
        }
    }
    if keeping >= 0 {
        tai_chi_flat_cache[keeping].stored = kept
    }
}

// Each thumbnail is a solved pose of its actual item, seen from the chosen
// angle. Building these uses a separate timeline, so opening a chooser
// cannot overwrite playback.
TaiChiPreview :: struct {
    generation: u64
    ready: bool
    view: s32
    solved: TaiChiSolved
    framing: TaiChiFraming
    half_width: float64
}

tai_chi_previews: [TAI_CHI_ITEM_CAPACITY * TAI_CHI_CHARACTER_COUNT]TaiChiPreview;
tai_chi_preview_timeline: TaiChiTimeline;

TaiChiDrawPreview :: (session: Session, item_index: s32, character: s32, angle: s32,
    area: Rectangle, key: u64, alt_text: string) {
    if item_index < 0 || item_index >= tai_chi_course.item_count ||
    character < 0 || character >= TAI_CHI_CHARACTER_COUNT {
        return
    }
    preview := *tai_chi_previews[item_index * TAI_CHI_CHARACTER_COUNT + character]
    item := tai_chi_course.items[item_index]
    rig := TaiChiRigFor(character)
    if !preview.ready || preview.generation != tai_chi_course_generation || preview.view != angle {
        if !TaiChiTimelineForItem(*tai_chi_preview_timeline, item) {
            return
        }
        pose := TaiChiTimelineSample(*tai_chi_preview_timeline,
            tai_chi_preview_timeline.duration * 0.45)
        preview.solved = TaiChiSolvePose(*pose, *rig)
        view := TaiChiViewSpecFor(angle)
        camera: TaiChiCameraState
        camera = TaiChiCameraUpdate(camera, view, preview.solved.pelvis,
            pose.channels[TAI_CHI_FACING], 0.0, true)
        preview.framing = TaiChiFramingFor(camera, view)
        TaiChiFlatPaint(*tai_chi_flat_frame, *preview.solved, *rig, character, preview.framing.camera)
        preview.half_width = 0.0
        low: float64 = 1000.0
        high: float64 = -1000.0
        for index: cast(s32)0..tai_chi_flat_frame.point_count - 1 {
            point := tai_chi_flat_frame.points[index]
            preview.half_width = TaiChiMax(preview.half_width, TaiChiAbs(point.x))
            low = TaiChiMin(low, point.y)
            high = TaiChiMax(high, point.y)
        }
        // The pose fills its card with a little room above and below.
        if high > low {
            preview.framing.view_center = (low + high) / 2.0
            preview.framing.view_height = (high - low) * 1.15
        }
        preview.generation = tai_chi_course_generation
        preview.view = angle
        preview.ready = true
    }
    // Fit the full pose horizontally as well as vertically on narrow
    // character cards, including outstretched hands.
    framing := preview.framing
    if area.width > 0.0 {
        width_height := preview.half_width * 2.1 * cast(float64)area.height / cast(float64)area.width
        framing.view_height = TaiChiMax(framing.view_height, width_height)
    }
    digest := TaiChiDigest(cast(u64)tai_chi_course_generation + 1, cast(float64)(item_index * 32 + character * 8 + angle))
    if !PracticeFigureDrawModel(session, *preview.solved, *rig, framing, TaiChiStageMan(character),
        TaiChiViewMirrored(angle), area, key, alt_text, -1.0, digest, .{.tai_chi = true}) {
        TaiChiFlatPaint(*tai_chi_flat_frame, *preview.solved, *rig, character, framing.camera)
        TaiChiPaintFlat(session, *tai_chi_flat_frame, framing, TaiChiViewMirrored(angle),
            area, key, alt_text)
    }
}
