// Draws the painted Tai Chi figure: the pose at the practice's time, solved
// and laid out as the course studio does, each painted piece warped onto
// its place with Kryon's image mesh.
#import "geometry"
#import "image_props"
#import "image_widget"
#import "layout"
#import "session"
#import, file "tai_chi_math.zi";
#import, file "tai_chi_course.zi";
#import, file "tai_chi_timeline.zi";
#import, file "tai_chi_solve.zi";
#import, file "tai_chi_layout.zi";
#import, file "tai_chi_rules.zi";
#import, file "tai_chi_entry.zi";

TAI_CHI_SHADOW_PATH :: "assets/practices/taichi/shadow.png"
// Rows along a bending strip and columns across a bending shoe.
TAI_CHI_STRIP_ROWS :: 20
TAI_CHI_SHOE_COLUMNS :: 8
TAI_CHI_MESH_CAPACITY :: 64

tai_chi_figure_images: [TAI_CHI_CHARACTER_COUNT]TaiChiFigureImages;
tai_chi_figure_images_ready: [TAI_CHI_CHARACTER_COUNT]bool;

TaiChiImagesFor :: (character: s32) -> TaiChiFigureImages {
    if !tai_chi_figure_images_ready[character] {
        tai_chi_figure_images[character] = TaiChiFigureImagesFor(character)
        tai_chi_figure_images_ready[character] = true
    }
    return tai_chi_figure_images[character]
}

TaiChiMeshGrid :: (piece: *TaiChiPiece) -> [2]s32 {
    grid: [2]s32
    grid[0] = 2
    grid[1] = 2
    if piece.kind == TAI_CHI_PIECE_LIMB || piece.kind == TAI_CHI_PIECE_STRIP_TORSO {
        grid[1] = TAI_CHI_STRIP_ROWS
    } else if piece.kind == TAI_CHI_PIECE_SHOE_SIDE {
        grid[0] = TAI_CHI_SHOE_COLUMNS
    }
    return grid
}

// Draws the figure at the practice's current time into `area`, following
// it with the camera. `dt` moves the camera; `snap` places it at once.
TaiChiDrawFigure :: (session: Session, state: *TaiChiPracticeState, area: Rectangle, dt: float64, snap: bool,
    alt_text: string) {
    if state.built_item < 0 || area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    character := state.character
    if character < 0 || character >= tai_chi_course.character_count {
        character = 0
    }
    images := TaiChiImagesFor(character)
    if !images.valid {
        return
    }
    item := tai_chi_course.items[state.built_item]
    view := TaiChiViewSpecFor(item.view)
    pose := TaiChiTimelineSample(*tai_chi_timeline, state.time)
    rig := TaiChiRigFor(character)
    solved := TaiChiSolvePose(*pose, *rig)
    state.camera = TaiChiCameraUpdate(state.camera, view, solved.pelvis, pose.channels[TAI_CHI_FACING], dt, snap)
    framing := TaiChiFramingFor(state.camera, view)
    frame := TaiChiLayout(*solved, *rig, *images, framing.camera, *state.memory)

    TaiChiPaintFrame(session, *frame, framing, item.mirror, area,
        KeyHash("inbe/practices/tai_chi/figure"), alt_text)
}

// Shared painting for the live player and cached course thumbnails.
TaiChiPaintFrame :: (session: Session, frame: *TaiChiFrame, framing: TaiChiFraming,
    mirrored: bool, area: Rectangle, key: u64, alt_text: string) {
    // Metres on the picture plane to pixels in the area: the view's height
    // fills the area's height, centred on its middle.
    pixels := cast(float64)area.height / framing.view_height
    middle_x := cast(float64)area.x + cast(float64)area.width / 2.0
    middle_y := cast(float64)area.y + cast(float64)area.height / 2.0
    mirror: float64 = 1.0
    if mirrored {
        mirror = -1.0
    }
    points: [TAI_CHI_MESH_CAPACITY]TaiChiVector2
    screen: [TAI_CHI_MESH_CAPACITY]Vector2
    for index: cast(s32)0..TAI_CHI_PIECE_COUNT - 1 {
        piece := frame.pieces[frame.order[index]]
        grid := TaiChiMeshGrid(*piece)
        count := grid[0] * grid[1]
        TaiChiPieceVertices(*piece, grid[0], grid[1], points[:count])
        for point: cast(s32)0..count - 1 {
            screen[point].x = cast(float32)(middle_x + points[point].x * pixels * mirror)
            screen[point].y = cast(float32)(middle_y - (points[point].y - framing.view_center) * pixels)
        }
        picture: ImageProps
        picture.key = key + cast(u64)index
        picture.bounds = area
        picture.smooth = true
        picture.alt_text = ifx index == TAI_CHI_PIECE_COUNT - 1 then alt_text else ""
        if piece.image < 0 {
            picture.asset_path = TAI_CHI_SHADOW_PATH
            alpha := cast(u32)(TaiChiClamp(piece.opacity, 0.0, 1.0) * 255.0)
            picture.tint = (cast(u32)0xffffff00) | alpha
            if alpha == cast(u32)0 {
                continue
            }
        } else {
            picture.asset_path = TaiChiCourseString(tai_chi_course.images[piece.image].path)
        }
        picture.mesh.columns = grid[0]
        picture.mesh.rows = grid[1]
        picture.mesh.points = screen[:count]
        Image(session, picture)
    }
}

// Each thumbnail is a solved frame of its actual item. Building these uses
// a separate timeline, so opening a chooser cannot overwrite playback.
TaiChiPreview :: struct {
    generation: u64
    ready: bool
    frame: TaiChiFrame
    framing: TaiChiFraming
    half_width: float64
    // The pose's lowest and highest points on the picture plane.
    low: float64
    high: float64
}

tai_chi_previews: [TAI_CHI_ITEM_CAPACITY * TAI_CHI_CHARACTER_COUNT]TaiChiPreview;
tai_chi_preview_timeline: TaiChiTimeline;

TaiChiDrawPreview :: (session: Session, item_index: s32, character: s32,
    area: Rectangle, key: u64, alt_text: string) {
    if item_index < 0 || item_index >= tai_chi_course.item_count ||
    character < 0 || character >= tai_chi_course.character_count {
        return
    }
    preview := *tai_chi_previews[item_index * TAI_CHI_CHARACTER_COUNT + character]
    item := tai_chi_course.items[item_index]
    if !preview.ready || preview.generation != tai_chi_course_generation {
        if !TaiChiTimelineForItem(*tai_chi_preview_timeline, item) {
            return
        }
        pose := TaiChiTimelineSample(*tai_chi_preview_timeline,
            tai_chi_preview_timeline.duration * 0.45)
        rig := TaiChiRigFor(character)
        solved := TaiChiSolvePose(*pose, *rig)
        view := TaiChiViewSpecFor(item.view)
        camera: TaiChiCameraState
        camera = TaiChiCameraUpdate(camera, view, solved.pelvis,
            pose.channels[TAI_CHI_FACING], 0.0, true)
        preview.framing = TaiChiFramingFor(camera, view)
        images := TaiChiImagesFor(character)
        memory: TaiChiLayoutMemory
        preview.frame = TaiChiLayout(*solved, *rig, *images,
            preview.framing.camera, *memory)
        preview.half_width = 0.0
        preview.low = 1000.0
        preview.high = -1000.0
        points: [TAI_CHI_MESH_CAPACITY]TaiChiVector2
        for index: cast(s32)0..TAI_CHI_PIECE_COUNT - 1 {
            piece := preview.frame.pieces[index]
            grid := TaiChiMeshGrid(*piece)
            count := grid[0] * grid[1]
            TaiChiPieceVertices(*piece, grid[0], grid[1], points[:count])
            for point: cast(s32)0..count - 1 {
                preview.half_width = TaiChiMax(preview.half_width, TaiChiAbs(points[point].x))
                preview.low = TaiChiMin(preview.low, points[point].y)
                preview.high = TaiChiMax(preview.high, points[point].y)
            }
        }
        // The pose fills its card with a little room above and below.
        if preview.high > preview.low {
            preview.framing.view_center = (preview.low + preview.high) / 2.0
            preview.framing.view_height = (preview.high - preview.low) * 1.15
        }
        preview.generation = tai_chi_course_generation
        preview.ready = true
    }
    // Fit the full pose horizontally as well as vertically on narrow
    // character cards, including outstretched hands and their shadow.
    framing := preview.framing
    if area.width > 0.0 {
        width_height := preview.half_width * 2.1 * cast(float64)area.height / cast(float64)area.width
        framing.view_height = TaiChiMax(framing.view_height, width_height)
    }
    TaiChiPaintFrame(session, *preview.frame, framing, item.mirror,
        area, key, alt_text)
}
