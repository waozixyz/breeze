// "1:05" for a duration in seconds.
TaiChiDurationText :: (app: *InnerBreeze, seconds: float64) -> string {
    whole := cast(s32)(seconds + 0.5)
    buffer: [16]u8
    args: [2]FormatArg = .[FormatArg.{.number = whole / 60}, FormatArg.{.number = whole % 60}]
    FormatTemplate("%d:%02d", args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 16))
}

TaiChiItemDetail :: (app: *InnerBreeze, item: TaiChiItem) -> string {
    duration := TaiChiDurationText(app, item.duration * 1.0)
    if item.version < 0 {
        return duration
    }
    buffer: [160]u8
    args: [2]FormatArg = .[
    FormatArg.{.text = LocaleText(TaiChiCourseString(item.version)), .is_text = true},
    FormatArg.{.text = duration, .is_text = true}
    ]
    FormatTemplate("%s · %s", args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 160))
}

TaiChiProgressLine :: (app: *InnerBreeze) -> string {
    buffer: [160]u8
    args: [2]FormatArg = .[
    FormatArg.{.number = TaiChiDoneCount(app.tai_chi)},
    FormatArg.{.number = tai_chi_course.item_count}
    ]
    FormatTemplate(LocaleText("tai_chi_progress"), args[:], buffer[:])
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 160))
}


using HostValueKind;
course_frame: PracticeCourseFrame;
course_frame_codec: WidgetPracticeCourseFrameCodec;
course_row_codec: WidgetPracticeCourseRowCodec;

TaiChiCourseCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*InnerBreeze)context
    if TextFromCString(module) != "course_view" {
        if PracticeFigureCall(module, function, arguments, count, result) != 0 {
            return 1
        }
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPracticeCourseHost" && count == 0 {
        result.* = WidgetEncodePracticeCourseFrame(course_frame, *course_frame_codec)
        return 1
    }
    if name == "WritePracticeCourseHost" && count == 1 && WidgetValidPracticeCourseFrame(arguments[0]) {
        observed := WidgetDecodePracticeCourseFrame(arguments[0], *course_frame_codec)
        course_frame.lesson = observed.lesson
        course_frame.lesson_scroll = observed.lesson_scroll
        course_frame.item_scroll = observed.item_scroll
        course_frame.reveal_next = observed.reveal_next
        course_frame.action = observed.action
        course_frame.value = observed.value
        return 1
    }
    if name == "ReadPracticeCourseRowHost" && count == 2 &&
    HostScalarValid(arguments[0], "bool", cast(s32)HostInteger) &&
    HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
        index := cast(s32)arguments[1].integer
        row: PracticeCourseRow
        if arguments[0].integer != 0 {
            if index >= 0 && index < tai_chi_course.lesson_count {
                lesson := tai_chi_course.lessons[index]
                row.title = LocaleText(TaiChiCourseString(lesson.title))
                row.subtitle = LocaleText(TaiChiCourseString(lesson.subtitle))
                row.summary = LocaleText(TaiChiCourseString(ifx lesson.summary < 0 then lesson.subtitle else lesson.summary))
                row.first = lesson.item_first
                row.count = lesson.item_count
            }
        } else if index >= 0 && index < tai_chi_course.item_count {
            item := tai_chi_course.items[index]
            row.title = LocaleText(TaiChiCourseString(item.title))
            row.detail = TaiChiItemDetail(app, item)
            row.done = app.tai_chi.done[index]
        }
        result.* = WidgetEncodePracticeCourseRow(row, *course_row_codec)
        return 1
    }
    if name == "CourseLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        key := TextFromBytes(BytesFromPointer(arguments[0].data, cast(u64)arguments[0].length))
        text := LocaleText(key)
        result.* = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"),
            .data = HostTextData(text), .length = cast(usize)text.count}
        return 1
    }
    return 0
}

TaiChiCourseFigure :: (app: *InnerBreeze, request: PracticeFigureRequest) {
    if request.preview && request.index >= 0 && request.index < tai_chi_course.item_count &&
    request.character >= 0 && request.character < tai_chi_course.character_count {
        TaiChiDrawPreview(app.ui.session, request.index, request.character, app.tai_chi.view,
            request.bounds, request.key, request.alt_text)
    }
}

#program_export
tai_chi_modal_draw :: (app: *InnerBreeze) {
    if app == null || !TaiChiCourseLoad() {
        return
    }
    app.tai_chi = TaiChiNormalizeSettings(app.tai_chi)
    if app.modal.type != cast(ModalType)ModalTaiChiCourse {
        if PracticeSettingsDraw(app, EXERCISE_TAI_CHI) != 0 {
            app_close_modal(app)
        }
        return
    }
    course_frame = PracticeCourseFrame.{.session = app.ui.session, .scale = MetricsScale(),
        .view_width = app.ui.view_width, .view_height = app.ui.view_height,
        .font = AppFontSize(), .small_font = AppSmallFontSize(), .muted_class = MutedTextClass(),
        .lesson_count = tai_chi_course.lesson_count, .lesson = tai_chi_selected_lesson,
        .lesson_scroll = tai_chi_lesson_scroll, .item_scroll = tai_chi_course_scroll,
        .reveal_next = tai_chi_reveal_next, .next_item = TaiChiItemToPlay(app.tai_chi),
        .character = app.tai_chi.character, .progress = TaiChiProgressLine(app)}
    PracticeFigureBegin(app, EXERCISE_TAI_CHI, TaiChiCourseFigure)
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(TaiChiCourseCall, cast(*void)app)
    drawn := PracticeRun(PracticeMessage.{.action = PRACTICE_COURSE_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    PracticeFigureEnd()
    if !drawn.succeeded {
        return
    }
    if course_frame.lesson >= 0 && course_frame.lesson < tai_chi_course.lesson_count {
        tai_chi_selected_lesson = course_frame.lesson
    }
    tai_chi_lesson_scroll = course_frame.lesson_scroll
    tai_chi_course_scroll = course_frame.item_scroll
    tai_chi_reveal_next = course_frame.reveal_next
    if course_frame.action == PRACTICE_COURSE_CLOSE {
        app_close_modal(app)
    } else if course_frame.action == PRACTICE_COURSE_PLAY && course_frame.value >= 0 &&
    course_frame.value < tai_chi_course.item_count {
        app.tai_chi.item = course_frame.value
        save_settings(app)
        tai_chi_practice_start_item(app, course_frame.value)
    }
}
