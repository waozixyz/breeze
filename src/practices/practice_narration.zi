// One local cue at a time, in the downloaded language the practice speaks.
#import "byte_text_linux"
#import, file "../app/assets.zi";
#import, file "../app/audio.zi";
#import, file "../app/audio_policy.zi";
#import, file "../app/app_types.zi";
#import, file "../app/ogg_length.zi";
#import, file "../app/text_buffers.zi";
#import, file "../platform/voice_audio.zi";
#import, file "../apps/package_files.zi";
#import, file "practice_downloads.zi";

practice_voice: bool;
practice_voice_key: [128]u8;
practice_voice_language: [16]u8;
practice_voice_choice_playing: [8]u8;
practice_voice_paused: bool;

// The clip's packed path; empty without a downloaded language. Files keep
// their .ogg name: recordings are Ogg Opus, or Ogg Vorbis in older packs.
PracticeNarrationPath :: (practice: string, key: string, path: []u8) -> string {
    language := PracticeNarrationLanguage(PracticeContentIndex(practice), PracticeVoiceChoice())
    if language.count == 0 {
        return ""
    }
    base := PackageText("assets/practices/", practice)
    // The voice chosen in Customize has its own folder in its own pack.
    voice := PackageText(base, ifx PracticeVoiceChoice() == "male" then "/voice-male/" else "/voice/")
    localized := PackageText(voice, language)
    directory := PackageText(localized, "/")
    line := PackageText(directory, key)
    full := PackageText(line, ".ogg")
    defer {
        PackageFree(base)
        PackageFree(voice)
        PackageFree(localized)
        PackageFree(directory)
        PackageFree(line)
        PackageFree(full)
    }
    if !AppCopyText(full, path) {
        return ""
    }
    return TextFromBytes(path[0:full.count])
}

PracticeNarrationClip :: (practice: string, key: string) -> AssetView {
    path: [256]u8
    found := PracticeNarrationPath(practice, key, path[:])
    if found.count == 0 {
        return AssetView.{}
    }
    return AssetRead(found)
}

PracticeNarrationStop :: () {
    if practice_voice {
        VoiceAudioStop(VoiceAudioPractice)
    }
    practice_voice = false
    practice_voice_key[0] = cast(u8)0
    practice_voice_paused = false
}

// How long a line takes to say, with a short pause after it; 0 without its clip.
PracticeNarrationSeconds :: (practice: string, key: string) -> float64 {
    clip := PracticeNarrationClip(practice, key)
    if !clip.found {
        return 0.0
    }
    return cast(float64)OggClipMilliseconds(clip.data) / 1000.0 + 0.2
}

PracticeTaiChiReadingSeconds :: (key: string) -> float64 {
    return PracticeNarrationSeconds("taichi", key)
}

PracticeNarrationUpdate :: (app: *InnerBreeze, practice: string, key: string) {
    if app.voice_narration_enabled == 0 || app.sound_volume <= 0 || key.count == 0 {
        PracticeNarrationStop()
        return
    }
    language := PracticeNarrationLanguage(PracticeContentIndex(practice), PracticeVoiceChoice())
    changed := !practice_voice || TextFromCString(*practice_voice_key[0]) != key ||
    TextFromCString(*practice_voice_language[0]) != language ||
    TextFromCString(*practice_voice_choice_playing[0]) != PracticeVoiceChoice()
    if changed {
        PracticeNarrationStop()
        unused AppCopyText(key, practice_voice_key[:])
        unused AppCopyText(language, practice_voice_language[:])
        unused AppCopyText(PracticeVoiceChoice(), practice_voice_choice_playing[:])
        path: [256]u8
        found := PracticeNarrationPath(practice, key, path[:])
        clip := ifx found.count > 0 then AssetRead(found) else AssetView.{}
        if clip.found && OggClipMilliseconds(clip.data) > 0 {
            app_audio_ensure_ready(app)
            if app.audio_ready != 0 {
                practice_voice = VoiceAudioStart(app, VoiceAudioPractice, found,
                    SoundVolumeFor(app.sound_volume, 1.0))
            }
        }
    }
    if !practice_voice {
        return
    }
    VoiceAudioGain(VoiceAudioPractice, SoundVolumeFor(app.sound_volume, 1.0))
    paused := app.session_paused != 0
    if paused != practice_voice_paused {
        if paused {
            VoiceAudioPause(VoiceAudioPractice)
        }
        else {
            VoiceAudioResume(VoiceAudioPractice)
        }
        practice_voice_paused = paused
    }
    if !paused {
        unused VoiceAudioActive(VoiceAudioPractice)
    }
}
