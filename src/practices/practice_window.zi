using TextAlign;
using Text.Wrap;

// Where a circle centered in the bounds sits when `share` places its radius
// between `smallest` (a fraction of the largest radius) and the largest
// radius that fits.
PracticeWindowCircleBounds :: (bounds: Rectangle, share: float32,
    smallest: float32) -> Rectangle {
    largest := bounds.width * 0.5
    if bounds.height < bounds.width {
        largest = bounds.height * 0.5
    }
    amount := share
    if amount < 0.0 {
        amount = 0.0
    }
    if amount > 1.0 {
        amount = 1.0
    }
    least := largest * smallest
    radius := least + (largest - least) * amount
    center := Vector2.{bounds.x + bounds.width * 0.5, bounds.y + bounds.height * 0.5}
    return Rectangle.{center.x - radius, center.y - radius, radius * 2.0, radius * 2.0}
}

// Draws a solid accent circle centered in the bounds, placed as
// PracticeWindowCircleBounds places it. A backdrop shows the largest size
// behind it. Returns the circle's bounds as drawn.


// The band just inside the circle's edge, as the breathing screen draws
// around its count, in the circle's contrast color.


// The practice's own reading inside its circle: the breath count, the time
// left or the phase, as large as the circle allows.


PracticeWindowCircle :: (session: Session, bounds: Rectangle, share: float32,
    smallest: float32, backdrop: Color) -> Rectangle  {
    return PracticeWindowCircleView(session, bounds, share, smallest, backdrop)
}

PracticeWindowBand :: (session: Session, circle: Rectangle, contrast: Color)  {
    PracticeWindowBandView(session, circle, contrast)
}

PracticeWindowLabel :: (app: *InnerBreeze, circle: Rectangle, text: string)  {
    PracticeWindowLabelView(app, circle, text)
}
