using ButtonEmphasis;

whm_config_preview_remainder: float64 = 0.0;
whm_start_speed_preview_remainder: float64 = 0.0;
WhmAnimationOptionCount :: 2

WhmConfigClamp :: (value: s32, minimum: s32, maximum: s32) -> s32 {
    if value < minimum {
        return minimum
    }
    if value > maximum {
        return maximum
    }
    return value
}

whm_preview_needs_reset :: (preview: *BreathSession, speed: s32, max_rounds: s32,
    max_breaths: s32, pause_seconds: s32,
    animation: s32) -> s32 {
    if preview == null {
        return 1
    }
    if preview.phase != BreathPhaseBreathe {
        return 1
    }
    if preview.speed_level != speed || preview.max_rounds != max_rounds  || BreathDigitsRead(preview.maxbreaths[:]) != max_breaths  || preview.pause_seconds != pause_seconds  || preview.breath_animation != animation  || preview.progressive_speed != 0 {
        return 1
    }
    return 0
}

whm_preview_reset :: (preview: *BreathSession, speed: s32, max_rounds: s32,
    max_breaths: s32, pause_seconds: s32,
    animation: s32, content_w: s32, content_h: s32,
    remainder: *float64) {
    if preview == null {
        return
    }
    preview.* = BreathSessionInit()
    preview.breath_animation = WhmConfigClamp(animation, BreathAnimationLinear,
        BreathAnimationCount - 1)
    apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
    preview.progressive_speed = 0
    update_preview_bounds(preview, content_w, content_h)
    session_reset_round_breathe(preview)
    if remainder != null {
        remainder.* = 0
    }
}

whm_preview_step_elapsed :: (preview: *BreathSession, remainder: *float64) {
    if preview == null {
        return
    }
    seconds := cast(float64)GetFrameTime()
    if seconds > 0.12 { seconds = 0.12 }
    fraction: float64 = 0.0
    if remainder != null { fraction = remainder.* }
    clock := BreathClockAdvance(seconds, fraction)
    if remainder != null { remainder.* = clock.remainder }

    {
        i: s32 = 0
        while i < clock.ticks {
            preview.* = BreathSessionStep(preview.*)
            if preview.phase != BreathPhaseBreathe {
                return
            }
            i += 1
        }
    }
}

// The preview's share of its range now: 0 at its smallest, 1 at its largest.
whm_preview_share :: (preview: *BreathSession, fraction: float32) -> float32 {
    span := preview.rmax - preview.rmin
    if span <= 0 {
        return 0.0
    }
    share := (BreathDrawRadiusAt(preview.*, fraction) - cast(float32)preview.rmin) /
    cast(float32)span
    if share < 0.0 {
        return 0.0
    }
    if share > 1.0 {
        return 1.0
    }
    return share
}

// Steps a preview breathing at these settings, starting it again when they
// changed or its round ended. Only the share of its range is drawn, so its
// room does not matter here.
whm_preview_advance :: (preview: *BreathSession, speed: s32, max_rounds: s32,
    max_breaths: s32, pause_seconds: s32, animation: s32, remainder: *float64,
    step: bool) -> float32 {
    room := AppScale(240)
    if whm_preview_needs_reset(preview, speed, max_rounds, max_breaths, pause_seconds,
        animation) != 0 {
        whm_preview_reset(preview, speed, max_rounds, max_breaths, pause_seconds,
            animation, room, room, remainder)
    }
    if step {
        whm_preview_step_elapsed(preview, remainder)
    }
    if preview.phase != BreathPhaseBreathe {
        whm_preview_reset(preview, speed, max_rounds, max_breaths, pause_seconds,
            animation, room, room, remainder)
    }
    return whm_preview_share(preview, cast(float32)remainder.*)
}

// The Customize page's frame: the settings, and the previews breathing.
whm_settings_frame :: (app: *InnerBreeze) -> PracticeSettingsFrame {
    frame := practice_settings_frame_for(app, EXERCISE_WIM_HOF)
    speed := app.breathing.speed_level
    max_rounds := app.breathing.max_rounds
    max_breaths := BreathDigitsRead(app.breathing.maxbreaths[:])
    pause_seconds := app.breathing.pause_seconds
    app.breathing.breath_animation = WhmConfigClamp(app.breathing.breath_animation,
        BreathAnimationLinear, BreathAnimationCount - 1)
    if app.breathing.progressive_speed != 0 {
        start := WhmConfigClamp(app.breathing.progressive_start_speed, SETTINGS_SPEED_MIN, speed)
        if start != app.breathing.progressive_start_speed {
            app.breathing.progressive_start_speed = start
            app.settings_preview.progressive_start_speed = start
            app.settings_dirty = 1
        }
    }
    editing := app.modal.active != 0 &&
    app.modal.type == cast(ModalType)ModalEditProgressiveStartSpeed
    // Customize itself may be a full-screen modal; any other modal covers
    // this page, and the preview holds still behind it.
    covered := app.modal.active != 0 && app.modal.type != cast(ModalType)ModalPracticeConfig
    frame.whm_preview = whm_preview_advance(*app.settings_preview, speed, max_rounds,
        max_breaths, pause_seconds, app.breathing.breath_animation,
        *whm_config_preview_remainder, !covered)
    if editing {
        start_speed := WhmConfigClamp(app.breathing.progressive_start_speed,
            SETTINGS_SPEED_MIN, speed)
        if app.start_speed_preview_speed != start_speed {
            app.start_speed_preview.phase = BreathPhaseStarting
            app.start_speed_preview_speed = start_speed
        }
        frame.whm_editor_preview = whm_preview_advance(*app.start_speed_preview, start_speed,
            max_rounds, max_breaths, pause_seconds, app.breathing.breath_animation,
            *whm_start_speed_preview_remainder, true)
    }
    frame.whm_animation = app.breathing.breath_animation
    frame.whm_speed = speed
    frame.whm_speed_min = SETTINGS_SPEED_MIN
    frame.whm_speed_max = SETTINGS_SPEED_MAX
    frame.whm_rounds = max_rounds
    frame.whm_rounds_max = MaxRounds
    frame.whm_breaths = max_breaths
    frame.whm_breaths_min = SETTINGS_BREATHS_MIN
    frame.whm_breaths_max = SETTINGS_BREATHS_MAX
    frame.whm_pause = pause_seconds
    frame.whm_pause_min = SETTINGS_PAUSE_MIN
    frame.whm_pause_max = SETTINGS_PAUSE_MAX
    frame.whm_progressive = app.breathing.progressive_speed != 0
    frame.whm_start_speed = WhmConfigClamp(app.breathing.progressive_start_speed,
        SETTINGS_SPEED_MIN, speed)
    frame.whm_double_tap = app.double_tap_to_breathe != 0
    frame.whm_controls = app.advanced_session_controls != 0
    frame.whm_reminder = app.hold_reminder_seconds
    frame.whm_editor = editing
    frame.surface_color = StyleTokenColor("surface")
    frame.border_color = StyleTokenColor("border")
    frame.link_color = StyleTokenColor("link")
    frame.text_color = StyleTokenColor("text")
    return frame
}

// Applies the round's settings to the session and its preview.
whm_settings_rounds :: (app: *InnerBreeze, speed: s32, max_rounds: s32, max_breaths: s32,
    pause_seconds: s32) {
    apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
    apply_settings(*app.settings_preview, speed, max_rounds, max_breaths, pause_seconds)
    app.settings_dirty = 1
}

// Does what Customize asked for; the music is Customize's own.
whm_settings_apply :: (app: *InnerBreeze, frame: PracticeSettingsFrame) {
    action := frame.action
    value := frame.value
    speed := app.breathing.speed_level
    max_rounds := app.breathing.max_rounds
    max_breaths := BreathDigitsRead(app.breathing.maxbreaths[:])
    pause_seconds := app.breathing.pause_seconds
    if action == PRACTICE_SETTINGS_WHM_ANIMATION {
        app.breathing.breath_animation = WhmConfigClamp(value, BreathAnimationLinear,
            BreathAnimationCount - 1)
        app.settings_preview.breath_animation = app.breathing.breath_animation
        app.settings_preview.progressive_speed = 0
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_SPEED {
        whm_settings_rounds(app, WhmConfigClamp(value, SETTINGS_SPEED_MIN, SETTINGS_SPEED_MAX),
            max_rounds, max_breaths, pause_seconds)
        app.settings_preview.progressive_speed = 0
    } else if action == PRACTICE_SETTINGS_WHM_PROGRESSIVE {
        app.breathing.progressive_speed = ifx value != 0 then 1 else 0
        app.settings_preview.progressive_speed = 0
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_START_EDITOR {
        app_open_modal(app, cast(ModalType)ModalEditProgressiveStartSpeed)
    } else if action == PRACTICE_SETTINGS_WHM_ROUNDS {
        whm_settings_rounds(app, speed, WhmConfigClamp(value, 1, MaxRounds), max_breaths,
            pause_seconds)
    } else if action == PRACTICE_SETTINGS_WHM_BREATHS {
        whm_settings_rounds(app, speed, max_rounds,
            WhmConfigClamp(value, SETTINGS_BREATHS_MIN, SETTINGS_BREATHS_MAX), pause_seconds)
    } else if action == PRACTICE_SETTINGS_WHM_PAUSE {
        whm_settings_rounds(app, speed, max_rounds, max_breaths,
            WhmConfigClamp(value, SETTINGS_PAUSE_MIN, SETTINGS_PAUSE_MAX))
    } else if action == PRACTICE_SETTINGS_WHM_DOUBLE_TAP {
        app.double_tap_to_breathe = ifx value != 0 then 1 else 0
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_CONTROLS {
        app.advanced_session_controls = ifx value != 0 then 1 else 0
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_REMINDER && (value == 0 || value == 30 || value == 60) {
        app.hold_reminder_seconds = value
        app.hold_reminder_last_bucket = 0
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_RESET {
        app.breathing.progressive_start_speed = DefaultProgressiveStartSpeed
        app.settings_preview.progressive_start_speed = DefaultProgressiveStartSpeed
        app.breathing.breath_animation = BreathAnimationLinear
        app.settings_preview.breath_animation = BreathAnimationLinear
        app.advanced_session_controls = 0
        app.double_tap_to_breathe = 0
        whm_settings_rounds(app, DefaultSpeedLevel, DefaultMaxRounds, DefaultMaxBreaths,
            DefaultPauseSeconds)
    } else if action == PRACTICE_SETTINGS_WHM_START_SPEED {
        app.breathing.progressive_start_speed = WhmConfigClamp(value, SETTINGS_SPEED_MIN, speed)
        app.settings_dirty = 1
    } else if action == PRACTICE_SETTINGS_WHM_EDITOR_CLOSE {
        app_close_modal(app)
    } else {
        practice_settings_apply(app, EXERCISE_WIM_HOF, frame)
    }
}

// Practices draws the page (apps/practice/settings_view.zi).
whm_config_screen_draw :: (app: *InnerBreeze) {
    if app == null || !SessionValid(app.ui.session) {
        return
    }
    frame := PracticeSettingsRun(app, whm_settings_frame(app))
    if frame.action == PRACTICE_SETTINGS_BACK {
        PracticeConfigLeave(app, cast(s32)ModalPracticeConfig)
        return
    }
    whm_settings_apply(app, frame)
}
