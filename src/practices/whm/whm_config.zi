whm_config_preview_remainder: s32 = 0;
whm_start_speed_preview_remainder: s32 = 0;
WhmAnimationOptionCount :: 2

WhmConfigClamp :: (value: s32, minimum: s32, maximum: s32) -> s32 {
    if value < minimum {
        return minimum
    }
    if value > maximum {
        return maximum
    }
    return value
}

whm_preview_needs_reset :: (preview: *BreathSession, speed: s32, max_rounds: s32,
    max_breaths: s32, pause_seconds: s32,
    animation: s32) -> s32 {
    if preview == null {
        return 1
    }
    if preview.phase != BreathPhaseBreathe {
        return 1
    }
    if preview.speed_level != speed || preview.max_rounds != max_rounds  || BreathDigitsRead(preview.maxbreaths[:]) != max_breaths  || preview.pause_seconds != pause_seconds  || preview.breath_animation != animation  || preview.progressive_speed != 0 {
        return 1
    }
    return 0
}

whm_preview_reset :: (preview: *BreathSession, speed: s32, max_rounds: s32,
    max_breaths: s32, pause_seconds: s32,
    animation: s32, content_w: s32, content_h: s32,
    remainder: *s32) {
    if preview == null {
        return
    }
    preview.* = BreathSessionInit()
    preview.breath_animation = WhmConfigClamp(animation, BreathAnimationLinear,
        BreathAnimationCount - 1)
    apply_settings(preview, speed, max_rounds, max_breaths, pause_seconds)
    preview.progressive_speed = 0
    update_preview_bounds(preview, content_w, content_h)
    session_reset_round_breathe(preview)
    if remainder != null {
        remainder.* = 0
    }
}

whm_preview_step_elapsed :: (preview: *BreathSession, remainder: *s32) {
    elapsed_ms := cast(s32)(GetFrameTime() * 1000.0f + 0.5f)
    total: s32
    frames: s32

    if preview == null {
        return
    }
    if elapsed_ms < 1 {
        elapsed_ms = 17
    }
    if elapsed_ms > 120 {
        elapsed_ms = 120
    }

    if remainder == null {
        preview.* = BreathSessionStep(preview.*)
        return
    }

    total = elapsed_ms * 60 + remainder.*
    frames = total / 1000
    remainder.* = total % 1000
    if frames < 1 {
        frames = 1
    }
    if frames > 8 {
        frames = 8
    }

    {
        i: s32 = 0
        while i < frames {
            preview.* = BreathSessionStep(preview.*)
            if preview.phase != BreathPhaseBreathe {
                return
            }
            i += 1
        }
    }
}

whm_draw_exact_speed_preview :: (preview: *BreathSession, preview_speed: *s32,
    speed: s32, max_rounds: s32, max_breaths: s32,
    pause_seconds: s32, animation: s32,
    content_w: s32, content_h: s32,
    center_x: s32, center_y: s32,
    remainder: *s32) {
    if preview == null || preview_speed == null {
        return
    }

    if whm_preview_needs_reset(preview, speed, max_rounds, max_breaths,
        pause_seconds, animation) != 0 || preview_speed.* != speed {
        whm_preview_reset(preview, speed, max_rounds, max_breaths,
            pause_seconds, animation, content_w, content_h,
            remainder)
        preview_speed.* = speed
    } else {
        update_preview_bounds(preview, content_w, content_h)
    }

    whm_preview_step_elapsed(preview, remainder)
    draw_breath_preview(preview, center_x, center_y)
}

whm_draw_progressive_start_speed_editor :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    max_speed := app.breathing.speed_level
    start_speed := WhmConfigClamp(app.breathing.progressive_start_speed,
        SETTINGS_SPEED_MIN, max_speed)
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
            .key = KeyHash("whm/start_speed"),
            .title = LocaleText("progressive_start_speed_editor_title"),
            .width = AppScale(340),
            .height = AppScale(360),
            .scale = MetricsScale(),
            .has_right_action = true,
            .right_label = LocaleText("close_button")
        })
    if frame.dismissed || frame.right_clicked {
        app_close_modal(app)
        return
    }
    if !frame.opened {
        return
    }
    content := frame.layout.content
    content_x := cast(s32)content.x
    content_y := cast(s32)content.y
    content_w := cast(s32)content.width
    whm_draw_exact_speed_preview(*app.start_speed_preview,
        *app.start_speed_preview_speed, start_speed,
        app.breathing.max_rounds,
        BreathDigitsRead(app.breathing.maxbreaths[:]),
        app.breathing.pause_seconds,
        app.breathing.breath_animation,
        content_w, AppScale(180),
        content_x + content_w / 2,
        content_y + AppScale(90),
        *whm_start_speed_preview_remainder)
    slider_y := content_y + AppScale(206)
    if commit_slider_row(app, 12, content_x, content_w,
        *slider_y, AppScale(56), LocaleText("progressive_start_speed_label"),
        SETTINGS_SPEED_MIN, max_speed, *start_speed, "", 0) != 0 {
        app.breathing.progressive_start_speed = start_speed
    }
    unused End(app.ui.session)
}

whm_config_draw_section_title :: (x: s32, y: *s32, title: string) {
    if y == null {
        return
    }

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(x), cast(float32)(y.*), 0, 0},
            .text = (title),
            .wrap = cast(TextWrap)TextWrapNone
        })
    y.* += AppScale(34)
}

whm_config_draw_card :: (x: s32, y: s32, w: s32, h: s32) {
    bounds := Rectangle.{cast(float32)x, cast(float32)y, cast(float32)w, cast(float32)h }

    DrawRectangleRounded(bounds, 0.08f, 10, StyleTokenColor("surface"))
    DrawRectangleRoundedLinesEx(bounds, 0.08f, 10, 1.0f, StyleTokenColor("border"))
}

whm_config_breath_card_height :: (app: *InnerBreeze) -> s32 {
    h := AppScale(88) + AppScale(154) + AppScale(78) +          AppScale(72)

    if app != null && app.breathing.progressive_speed != 0 {
        h += AppScale(66)
    }
    return h
}

whm_config_session_card_height :: () -> s32 {
    return AppScale(82) * 3 + AppScale(24)
}

whm_config_options_card_height :: () -> s32 {
    return AppScale(88) * 3
}

whm_config_draw_breath_card :: (app: *InnerBreeze, content_x: s32, content_w: s32,
    y: s32) -> s32 {
    animation_options: [WhmAnimationOptionCount]DropdownOption
    card_h := whm_config_breath_card_height(app)
    card_pad := AppScale(22)
    card_x := content_x
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad
    preview_h := AppScale(144)
    speed := app.breathing.speed_level
    max_rounds := app.breathing.max_rounds
    max_breaths := BreathDigitsRead(app.breathing.maxbreaths[:])
    pause_seconds := app.breathing.pause_seconds
    progressive_start_speed := app.breathing.progressive_start_speed
    progressive_speed := app.breathing.progressive_speed
    toggle_w := AppScale(92)
    toggle_h := AppScale(30)

    animation_options[0] = DropdownOption.{.label = LocaleText("breath_animation_linear")}
    animation_options[1] = DropdownOption.{.label = LocaleText("breath_animation_in_out")}
    app.breathing.breath_animation = WhmConfigClamp(app.breathing.breath_animation,
        BreathAnimationLinear,
        BreathAnimationCount - 1)

    whm_config_draw_card(card_x, y, content_w, card_h)

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), 0, 0},
            .text = (LocaleText("breath_animation_label")),
            .wrap = cast(TextWrap)TextWrapNone
        })
    animation_pick := Dropdown(CurrentApp().ui.session, DropdownProps.{.id = 104,
            .bounds = Rectangle.{cast(float32)inner_x,
                cast(float32)(inner_y + AppScale(26)),
                cast(float32)inner_w, cast(float32)AppScale(48)},
            .selected_index = app.breathing.breath_animation},
        animation_options[:])
    if animation_pick.changed {
        app.breathing.breath_animation = animation_pick.selected_index
        app.breathing.breath_animation = WhmConfigClamp(app.breathing.breath_animation,
            BreathAnimationLinear,
            BreathAnimationCount - 1)
        app.settings_preview.breath_animation = app.breathing.breath_animation
        app.settings_preview.progressive_speed = 0
        app.settings_dirty = 1
    }
    inner_y += AppScale(82)

    if whm_preview_needs_reset(*app.settings_preview, speed, max_rounds,
        max_breaths, pause_seconds,
        app.breathing.breath_animation) != 0 {
        whm_preview_reset(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds,
            app.breathing.breath_animation, inner_w,
            preview_h, *whm_config_preview_remainder)
    } else {
        update_preview_bounds(*app.settings_preview, inner_w, preview_h)
    }
    DrawCircleGradient(Vector2.{cast(float32)(inner_x + inner_w / 2),
            cast(float32)(inner_y + preview_h / 2)},
        cast(float32)AppScale(72),
        Fade(StyleTokenColor("link"), 0.16f),
        Fade(StyleTokenColor("canvas"), 0.0f))
    // The start-speed editor shows its own preview; this one holds still
    // behind it.
    start_speed_editor_open := app.modal.active != 0 &&
    app.modal.type == cast(ModalType)ModalEditProgressiveStartSpeed
    if !start_speed_editor_open {
        whm_preview_step_elapsed(*app.settings_preview,
            *whm_config_preview_remainder)
    }
    if app.settings_preview.phase != BreathPhaseBreathe {
        whm_preview_reset(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds,
            app.breathing.breath_animation, inner_w,
            preview_h, *whm_config_preview_remainder)
    }
    draw_breath_preview(*app.settings_preview,
        inner_x + inner_w / 2,
        inner_y + preview_h / 2)
    inner_y += preview_h + AppScale(20)

    if commit_slider_row(app, 1, inner_x, inner_w, *inner_y, AppScale(78),
        LocaleText("speed_label"), SETTINGS_SPEED_MIN, SETTINGS_SPEED_MAX,
        *speed, "", 0) != 0 {
        apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds)
        app.settings_preview.progressive_speed = 0
    }

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), 0, 0},
            .text = (LocaleText("progressive_speed_label")),
            .wrap = cast(TextWrap)TextWrapNone
        })
    progressive_toggle := Toggle(CurrentApp().ui.session,
        ToggleProps.{.id = 1101,
            .bounds = Rectangle.{cast(float32)(inner_x + inner_w - toggle_w),
                cast(float32)(inner_y + (AppScale(58) - toggle_h) / 2),
                cast(float32)toggle_w, cast(float32)toggle_h},
            .value = progressive_speed != 0,
            .off_label = LocaleText("toggle_off"),
            .on_label = LocaleText("toggle_on")})
    if progressive_toggle.changed {
        app.breathing.progressive_speed = ifx (progressive_toggle.value) then (1) else (0)
        app.settings_preview.progressive_speed = 0
        app.settings_dirty = 1
    }
    inner_y += AppScale(58)

    if app.breathing.progressive_speed != 0 {
        modify_w := AppTextWidth(LocaleText("modify_start_speed_button"),
            AppFontSize()) + AppScale(24)


        if modify_w > inner_w {
            modify_w = inner_w
        }
        if progressive_start_speed != WhmConfigClamp(progressive_start_speed,
            SETTINGS_SPEED_MIN, speed) {
            app.breathing.progressive_start_speed =
            WhmConfigClamp(progressive_start_speed, SETTINGS_SPEED_MIN, speed)
            app.settings_preview.progressive_start_speed =
            app.breathing.progressive_start_speed
            app.settings_dirty = 1
        }
        if Button(CurrentApp().ui.session, ButtonProps.{
                .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), cast(float32)(modify_w), cast(float32)(AppScale(48))},
                .label = LocaleText("modify_start_speed_button"),
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
                .disabled = false
            }) != 0 {
            app_open_modal(app, cast(ModalType)ModalEditProgressiveStartSpeed)
        }
    }

    return y + card_h + AppScale(16)
}

whm_config_draw_session_card :: (app: *InnerBreeze, content_x: s32, content_w: s32,
    y: s32) -> s32 {
    speed := app.breathing.speed_level
    max_rounds := app.breathing.max_rounds
    max_breaths := BreathDigitsRead(app.breathing.maxbreaths[:])
    pause_seconds := app.breathing.pause_seconds
    card_h := whm_config_session_card_height()
    card_pad := AppScale(22)
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad

    whm_config_draw_card(content_x, y, content_w, card_h)

    if commit_slider_row(app, 2, inner_x, inner_w, *inner_y, AppScale(82),
        LocaleText("max_rounds_label"), 1, MaxRounds,
        *max_rounds, "", 0) != 0 {
        apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds)
    }

    if commit_slider_row(app, 3, inner_x, inner_w, *inner_y, AppScale(82),
        LocaleText("max_breaths_label"), SETTINGS_BREATHS_MIN,
        SETTINGS_BREATHS_MAX, *max_breaths, "", 0) != 0 {
        apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds)
    }

    if commit_slider_row(app, 4, inner_x, inner_w, *inner_y, AppScale(56),
        LocaleText("pause_after_round_label"), SETTINGS_PAUSE_MIN,
        SETTINGS_PAUSE_MAX, *pause_seconds, "s", 0) != 0 {
        apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds)
    }

    return y + card_h + AppScale(16)
}

whm_config_draw_options_card :: (app: *InnerBreeze, content_x: s32, content_w: s32,
    y: s32) -> s32 {
    double_tap_to_breathe := app.double_tap_to_breathe
    advanced_session_controls := app.advanced_session_controls
    retention_marker_enabled := app.retention_marker_enabled
    card_h := whm_config_options_card_height()
    card_pad := AppScale(22)
    inner_x := content_x + card_pad
    inner_w := content_w - card_pad * 2
    inner_y := y + card_pad
    toggle_w := AppScale(92)
    toggle_h := AppScale(30)

    whm_config_draw_card(content_x, y, content_w, card_h)

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), 0, 0},
            .text = (LocaleText("double_tap_to_breathe_label")),
            .wrap = cast(TextWrap)TextWrapNone
        })
    double_tap_toggle := Toggle(CurrentApp().ui.session, ToggleProps.{.id = 1201,
            .bounds = Rectangle.{cast(float32)(inner_x + inner_w - toggle_w),
                cast(float32)(inner_y + (AppScale(60) - toggle_h) / 2),
                cast(float32)toggle_w, cast(float32)toggle_h},
            .value = double_tap_to_breathe != 0,
            .off_label = LocaleText("toggle_off"),
            .on_label = LocaleText("toggle_on")})
    if double_tap_toggle.changed {
        app.double_tap_to_breathe = ifx (double_tap_toggle.value) then (1) else (0)
        app.settings_dirty = 1
    }
    inner_y += AppScale(88)

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), 0, 0},
            .text = (LocaleText("advanced_session_controls_label")),
            .wrap = cast(TextWrap)TextWrapNone
        })
    controls_toggle := Toggle(CurrentApp().ui.session, ToggleProps.{.id = 1202,
            .bounds = Rectangle.{cast(float32)(inner_x + inner_w - toggle_w),
                cast(float32)(inner_y + (AppScale(60) - toggle_h) / 2),
                cast(float32)toggle_w, cast(float32)toggle_h},
            .value = advanced_session_controls != 0,
            .off_label = LocaleText("toggle_off"),
            .on_label = LocaleText("toggle_on")})
    if controls_toggle.changed {
        app.advanced_session_controls = ifx (controls_toggle.value) then (1) else (0)
        app.settings_dirty = 1
    }
    inner_y += AppScale(88)

    Text(CurrentApp().ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)(inner_x), cast(float32)(inner_y), 0, 0},
            .text = (LocaleText("retention_marker_label")),
            .wrap = cast(TextWrap)TextWrapNone
        })
    marker_toggle := Toggle(CurrentApp().ui.session, ToggleProps.{.id = 1203,
            .bounds = Rectangle.{cast(float32)(inner_x + inner_w - toggle_w),
                cast(float32)(inner_y + (AppScale(60) - toggle_h) / 2),
                cast(float32)toggle_w, cast(float32)toggle_h},
            .value = retention_marker_enabled != 0,
            .off_label = LocaleText("toggle_off"),
            .on_label = LocaleText("toggle_on")})
    if marker_toggle.changed {
        app.retention_marker_enabled = ifx (marker_toggle.value) then (1) else (0)
        app.retention_marker_last_bucket = 0
        app.settings_dirty = 1
    }

    return y + card_h + AppScale(16)
}

whm_config_draw_reset_button :: (app: *InnerBreeze, content_x: s32, content_w: s32,
    y: s32) -> s32 {
    speed := app.breathing.speed_level
    max_rounds := app.breathing.max_rounds
    max_breaths := BreathDigitsRead(app.breathing.maxbreaths[:])
    pause_seconds := app.breathing.pause_seconds
    reset_w := AppTextWidth(LocaleText("reset_to_defaults_label"),
        AppFontSize()) + AppScale(24)
    reset_h := AppScale(48)


    if reset_w > content_w {
        reset_w = content_w
    }
    if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = Rectangle.{cast(float32)(content_x + content_w - reset_w), cast(float32)(y), cast(float32)(reset_w), cast(float32)(reset_h)},
            .label = LocaleText("reset_to_defaults_label"),
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
            .disabled = false
        }) != 0 {
        speed = DefaultSpeedLevel
        max_rounds = DefaultMaxRounds
        max_breaths = DefaultMaxBreaths
        pause_seconds = DefaultPauseSeconds
        app.breathing.progressive_start_speed = DefaultProgressiveStartSpeed
        app.settings_preview.progressive_start_speed = DefaultProgressiveStartSpeed
        app.breathing.breath_animation = BreathAnimationLinear
        app.settings_preview.breath_animation = BreathAnimationLinear
        app.advanced_session_controls = 0
        app.double_tap_to_breathe = 0
        apply_settings(*app.breathing, speed, max_rounds, max_breaths, pause_seconds)
        apply_settings(*app.settings_preview, speed, max_rounds,
            max_breaths, pause_seconds)
        app.settings_dirty = 1
    }
    return y + reset_h + AppScale(24)
}

whm_config_draw_combined :: (app: *InnerBreeze, content_x: s32, content_w: s32,
    y: s32) -> s32 {
    y = whm_config_draw_breath_card(app, content_x, content_w, y)
    y = whm_config_draw_session_card(app, content_x, content_w, y)
    y = whm_config_draw_options_card(app, content_x, content_w, y)
    y += AppScale(24)

    meditation_music_draw_practice_settings(app, EXERCISE_WIM_HOF,
        content_x, content_w, *y, 0, 1)
    y += AppScale(12)
    y = whm_config_draw_reset_button(app, content_x, content_w, y)

    return y
}

whm_config_content_height :: (app: *InnerBreeze, content_w: s32) -> s32 {
    integrated := app.breathing.screen == ScreenStart &&
    app.modal.type != cast(ModalType)ModalPracticeConfig
    bottom_padding := (ifx (integrated) then (app_content_bottom_reserved(app)) else (0)) + AppScale(24)

    return whm_config_breath_card_height(app) + AppScale(16) +            whm_config_session_card_height() + AppScale(16) +            whm_config_options_card_height() + AppScale(40) +            meditation_music_measure_practice_settings(app, EXERCISE_WIM_HOF,
        content_w, 0, 1) +            AppScale(12) +            AppScale(48) + AppScale(24) +            bottom_padding
}

whm_config_screen_draw :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    layout := PracticeSubscreenLayout.{}
    side_padding := GetPageSidePadding()
    max_content_w := AppScale(CONTENT_MAX_W)
    content_x: s32 = 0
    content_w: s32 = 0
    if app.practice_config_tab < 0 || app.practice_config_tab > 1 {
        app.practice_config_tab = 0
    }

    PracticeConfigLayout(app, cast(s32)ModalPracticeConfig, 0, *layout)
    if PracticeConfigTitle(app, LocaleText("practice_configure_button"),
        cast(s32)ModalPracticeConfig, 0) != 0 {
        return
    }

    available_w := app.ui.view_width - side_padding * 2
    top_gap := AppScale(16)

    if max_content_w > available_w {
        max_content_w = available_w
    }
    if max_content_w < available_w && app.ui.view_width <= AppScale(520) {
        max_content_w = available_w
    }
    if max_content_w < AppScale(240) {
        max_content_w = available_w
    }
    GetCenteredColumn(max_content_w, side_padding, *content_x, *content_w)
    content_h := whm_config_content_height(app, content_w) + top_gap

    {
        scroll_1_bounds: Rectangle = Rectangle.{cast(float32)0, cast(float32)layout.scroll_y,
            cast(float32)app.ui.view_width, cast(float32)layout.scroll_h
        }
        scroll_1_key: u64 = KeyHash("inbe/practices/whm/whm_config/scroll/1")
        scroll_1_props: ScrollProps
        scroll_1_props.key = scroll_1_key
        scroll_1_props.bounds = scroll_1_bounds
        scroll_1_props.content_height = content_h
        scroll_1_props.scroll_offset = app.settings_scroll
        scroll_1_result: ScrollResult = Scroll(CurrentApp().ui.session, scroll_1_props)
        app.settings_scroll = scroll_1_result.scroll_offset
        page: Rectangle = scroll_1_result.content

        whm_config_draw_combined(app, content_x, content_w,
            cast(s32)page.y + top_gap)
        unused End(CurrentApp().ui.session)
    }

    if app.modal.active != 0 &&
    app.modal.type == cast(ModalType)ModalEditProgressiveStartSpeed {
        whm_draw_progressive_start_speed_editor(app)
    }
}
