#import, file "../../app/app_types.zi";
#import "layout"
#import "session"
#import, file "../../app/app.zi";
#import "layout_widget"
#import "tree"

results :: (app: *InnerBreeze) {
    if app == null || !SessionValid(app.ui.session) {
        return
    }
    root: ColumnProps
    root.key = KeyHash("results/root")
    unused Screen(app.ui.session, root)
    unused End(app.ui.session)
}
