#import, file "../../app/app_types.zi";
Layout :: #import "kryon/layout";
#import "session"
#import, file "../../app/app.zi";
#import "kryon/tree"

results :: (app: *InnerBreeze) {
    if app == null || !SessionValid(app.ui.session) {
        return
    }
    root: Layout.Props
    root.key = Layout.KeyHash("results/root")
    unused Layout.Screen(app.ui.session, root)
    unused End(app.ui.session)
}
