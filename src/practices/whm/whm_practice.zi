c :: #system_library "c";
#import, file "../../core/types.zi";
#import, file "../../app/app.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/exercise_types.zi";
#import, file "../../app/manual_seen_actions.zi";

using ExerciseType;

session_start :: (app: *InnerBreeze) #foreign c;

#program_export
whm_practice_start :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_WIM_HOF)
    session_start(app)
}

#program_export
whm_practice_leave_config :: (app: *InnerBreeze) {
    unused app
}
