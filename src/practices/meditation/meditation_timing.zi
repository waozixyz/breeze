// The meditation clock belongs to Inbe. Platform lifecycle code decides
// whether to call this function and resets the remainder while paused.
MeditationTimeStep :: struct {
    remaining_seconds: s32
    remainder_ms: s32
    elapsed_seconds: s32
    completed: bool
}

#program_export
AdvanceMeditationTime :: (remaining_seconds: s32, remainder_ms: s32,
    elapsed_ms: s32) -> MeditationTimeStep {
    step: MeditationTimeStep
    step.remaining_seconds = remaining_seconds
    step.remainder_ms = remainder_ms

    if elapsed_ms <= 0 {
        return step
    }

    total_ms: s64 = cast(s64)elapsed_ms + cast(s64)remainder_ms
    step.elapsed_seconds = cast(s32)(total_ms / 1000)
    step.remainder_ms = cast(s32)(total_ms % 1000)
    if step.elapsed_seconds <= 0 {
        return step
    }

    if step.elapsed_seconds >= remaining_seconds {
        step.remaining_seconds = 0
        step.completed = true
    } else {
        step.remaining_seconds = remaining_seconds - step.elapsed_seconds
    }
    return step
}

// Computes overtime seconds added by a step that reached or continued past 00:00.
MeditationOvertimeDelta :: (previous_remaining: s32, step_elapsed: s32,
    was_complete: bool, overtime_enabled: bool) -> s32 {
    if !overtime_enabled || step_elapsed <= 0 {
        return 0
    }
    if was_complete {
        return step_elapsed
    }
    if previous_remaining < 0 {
        previous_remaining = 0
    }
    if step_elapsed > previous_remaining {
        return step_elapsed - previous_remaining
    }
    return 0
}

MeditationIntervalBellIndex :: (elapsed_seconds: s32,
    interval_minutes: s32) -> s32 {
    if interval_minutes <= 0 || elapsed_seconds <= 0 {
        return 0
    }
    return elapsed_seconds / (interval_minutes * 60)
}
