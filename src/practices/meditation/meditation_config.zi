#import "toggle"
#import "layout"
save_settings :: (app: *InnerBreeze) #foreign c3 "save_settings";


using ModalType;
using ExerciseType;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

clampi :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    if value < min_value { return min_value }
    if value > max_value { return max_value }
    return value
}

meditation_config_preset_count :: () -> s32 {
    return 5
}

meditation_config_duration_height :: (content_w: s32) -> s32 {
    columns: s32 = ifx (content_w >= AppScale(520)) then (3) else (2)
    count: s32 = meditation_config_preset_count() + 1
    rows: s32 = (count + columns - 1) / columns

    return AppScale(30) + rows * AppScale(56) + (rows - 1) * AppScale(8) + AppScale(108) + AppScale(84) + AppScale(18) + AppScale(112)
}

meditation_config_content_height :: (app: *InnerBreeze, content_w: s32) -> s32 {
    bottom_padding: s32 = ifx (PracticeConfigIntegrated(app, ModalPracticeConfig) != 0) then (app_content_bottom_reserved(app)) else (0)
    bottom_padding += AppScale(24)

    return meditation_config_duration_height(content_w) +            meditation_music_measure_practice_settings(app, EXERCISE_MEDITATION,
                                                      content_w, 0, 1) +            bottom_padding
}

meditation_config_save :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.settings_dirty = 1
    save_settings(app)
}

meditation_config_draw_duration :: (app: *InnerBreeze, x: s32, w: s32, y: *s32) {
    labels: [6] string = .[LocaleText("duration_5m"), LocaleText("duration_15m"), LocaleText("duration_30m"), LocaleText("duration_1h"), LocaleText("duration_2h"), LocaleText("meditation_duration_custom")]
    adjust_labels: [4] string = .["-5", "-1", "+1", "+5"]
    adjust_values: [4] s32 = .[-5, -1, 1, 5]
    mode: s32 = 0
    columns: s32 = 0
    gap := AppScale(8)
    btn_h := AppScale(48)
    btn_w: s32 = 0
    row_y: s32 = 0
    custom_row_y: s32 = 0
    toggle_value: s32 = 0

    custom_text: [64] u8

    if app == null || y == null {
        return
    }

    mode = clampi(app.meditation.duration_mode, 0, meditation_config_preset_count())
    app.meditation.duration_mode = mode
    app.meditation.custom_minutes = clampi(app.meditation.custom_minutes, 1, 240)

    Text(CurrentApp().ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, 0.0f, 0.0f},
        .text=(LocaleText("meditation_duration_setting")),
        .wrap=cast(TextWrap)TextWrapNone
    })
    y.* += AppScale(30)

    columns = ifx (w >= AppScale(520)) then (3) else (2)
    btn_w = (w - gap * (columns - 1)) / columns
    {
        i: s32 = 0
        while i < meditation_config_preset_count() + 1 {

        col := i % columns
        row := i / columns
        bx := x + col * (btn_w + gap)
        by := y.* + row * (btn_h + gap)
        style := cast(ButtonTone)(ifx (i == mode) then (ButtonToneAccent) else (ButtonToneNeutral))

        if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = Rectangle.{cast(float32)(bx), cast(float32)(by), cast(float32)(btn_w), cast(float32)(btn_h)},
            .label = labels[i],
            .tone = style,
            .emphasis = cast(ButtonEmphasis)(ifx (style == cast(ButtonTone)ButtonToneAccent) then (cast(ButtonEmphasis)ButtonEmphasisFilled) else (cast(ButtonEmphasis)ButtonEmphasisSoft)),
            .disabled = false
        }) != 0 {
            app.meditation.duration_mode = i
            meditation_config_save(app)
        }
            i += 1
        }
        }

    row_y = y.* + ((meditation_config_preset_count() + 1 + columns - 1) / columns) *
                 (btn_h + gap)
    y.* = row_y + AppScale(8)

    custom_row_y = y.*
    custom_args: [2]FormatArg = .[
        FormatArg.{.text = LocaleText("meditation_custom_minutes"), .is_text = true},
        FormatArg.{.number = app.meditation.custom_minutes}
    ]
    FormatTemplate("%s: %d min", custom_args[:], custom_text[:])
    Text(CurrentApp().ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)(x), cast(float32)(custom_row_y), cast(float32)0, cast(float32)0},
        .text=AppTextFromCString(*custom_text[0], 96),
        .wrap=cast(TextWrap)TextWrapNone
    })

    adjust_w := AppScale(50)
    adjust_total := adjust_w * 4 + gap * 3
    adjust_x := x + (w - adjust_total) / 2
    adjust_y := custom_row_y + AppScale(34)

    {
        i: s32 = 0
        while i < 4 {
            if Button(CurrentApp().ui.session, ButtonProps.{
                .bounds = Rectangle.{cast(float32)(adjust_x + i * (adjust_w + gap)), cast(float32)(adjust_y), cast(float32)(adjust_w), cast(float32)(btn_h)},
                .label = adjust_labels[i],
                .tone = cast(ButtonTone)ButtonToneNeutral,
                .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft,
                .disabled = false
            }) != 0 {
                app.meditation.custom_minutes =
                    clampi(app.meditation.custom_minutes + adjust_values[i], 1, 240)
                app.meditation.duration_mode = meditation_config_preset_count()
                meditation_config_save(app)
            }
            i += 1
        }
    }
    y.* += AppScale(108)

    Text(CurrentApp().ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, 0.0f, 0.0f},
        .text=(LocaleText("meditation_extend_controls_label")),
        .wrap=cast(TextWrap)TextWrapNone
    })
    toggle_value = app.meditation.show_extend_controls
    toggle_result := Toggle(CurrentApp().ui.session, ToggleProps.{.id = 0,
        .bounds = Rectangle.{cast(float32)x, cast(float32)(y.* + AppScale(26)), cast(float32)AppScale(56), cast(float32)AppScale(30)},
        .value = toggle_value != 0, .off_label = LocaleText("toggle_off"),
        .on_label = LocaleText("toggle_on")})
    if toggle_result.changed {
        app.meditation.show_extend_controls = ifx (toggle_result.value) then (1) else (0)
        meditation_config_save(app)
    }
    y.* += AppScale(84)

    // interval bell: a soft bell every N minutes (0 = off)
    Text(CurrentApp().ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y.*, 0.0f, 0.0f},
        .text=(LocaleText("meditation_interval_bell_label")),
        .wrap=cast(TextWrap)TextWrapNone
    })
    bell_labels: [7] string = .[LocaleText("meditation_interval_bell_off"), "1", "2", "5", "10", "15", "30"]
    bell_values: [7] s32 = .[0, 1, 2, 5, 10, 15, 30]
    bell_selected: s32 = 0
    {
        i: s32 = 0
        while i < 7 {
            if app.meditation.interval_bell_minutes == bell_values[i] {
                bell_selected = i
            }
            i += 1
        }

    }
    bell_columns: s32 = ifx (w >= AppScale(460)) then (7) else (4)
    bell_w := (w - gap * (bell_columns - 1)) / bell_columns
    if bell_w > AppScale(72) {
        bell_w = AppScale(72)
    }
    {
        i: s32 = 0
        while i < 7 {

        bx := x + (i % bell_columns) * (bell_w + gap)
        by := y.* + AppScale(26) + (i / bell_columns) * (btn_h + gap)
        style := cast(ButtonTone)(ifx (i == bell_selected) then (cast(ButtonTone)ButtonToneAccent) else (cast(ButtonTone)ButtonToneNeutral))
        if Button(CurrentApp().ui.session, ButtonProps.{
            .bounds = Rectangle.{cast(float32)(bx), cast(float32)(by), cast(float32)(bell_w), cast(float32)(btn_h)},
            .label = bell_labels[i],
            .tone = style,
            .emphasis = cast(ButtonEmphasis)(ifx (style == cast(ButtonTone)ButtonToneAccent) then (cast(ButtonEmphasis)ButtonEmphasisFilled) else (cast(ButtonEmphasis)ButtonEmphasisSoft)),
            .disabled = false
        }) != 0 {
            app.meditation.interval_bell_minutes = bell_values[i]
            meditation_config_save(app)
        }

            i += 1
        }
        }
    bell_rows := (7 + bell_columns - 1) / bell_columns
    y.* += AppScale(26) + bell_rows * btn_h +           (bell_rows - 1) * gap + AppScale(12)
}

meditation_config_screen_draw :: (app: *InnerBreeze) {
    layout := PracticeSubscreenLayout.{0 }
    side_padding := PageSidePaddingFor(app.ui.view_width)
    max_content_w := AppScale(CONTENT_MAX_W)
    content_x: s32 = 0
    content_w: s32 = 0
    y: s32

    app.practice_config_tab = 0

    PracticeConfigLayout(app, ModalPracticeConfig, AppScale(18), *layout)
    PracticeConfigTitle(app, LocaleText("practice_configure_button"),
                                           cast(s32)ModalPracticeConfig, 1)

    if max_content_w > app.ui.view_width - PageSidePaddingFor(app.ui.view_width) * 2 {
        max_content_w = app.ui.view_width - PageSidePaddingFor(app.ui.view_width) * 2
    }
    if max_content_w < AppScale(320) {
        max_content_w = AppScale(320)
    }
    GetCenteredColumn(max_content_w, side_padding, *content_x, *content_w)
    content_h := meditation_config_content_height(app, content_w)

    {
        scroll_1_bounds: Rectangle = Rectangle.{cast(float32)0, cast(float32)layout.scroll_y,
                        cast(float32)app.ui.view_width, cast(float32)layout.scroll_h
}
        scroll_1_key: u64 = KeyHash("inbe/practices/meditation/meditation_config/scroll/1")
        scroll_1_props: ScrollProps
        scroll_1_props.key = scroll_1_key
        scroll_1_props.bounds = scroll_1_bounds
        scroll_1_props.content_height = content_h
        scroll_1_props.scroll_offset = app.settings_scroll
        scroll_1_result: ScrollResult = Scroll(CurrentApp().ui.session, scroll_1_props)
        app.settings_scroll = scroll_1_result.scroll_offset
        page: Rectangle = scroll_1_result.content
        y := cast(s32)page.y
        meditation_config_draw_duration(app, content_x, content_w, *y)
        meditation_music_draw_practice_settings(app, EXERCISE_MEDITATION,
                                                content_x, content_w,
                                                *y, 0, 1)
        unused End(CurrentApp().ui.session)
    }
}
