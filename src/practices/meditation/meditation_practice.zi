c :: #system_library "c";
#import, file "../../core/types.zi";
#import, file "../../app/app.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/exercise_types.zi";
#import, file "../../app/manual_seen_actions.zi";

using ExerciseType;

// These calls are implemented by the larger meditation modules. Keep their
// effects explicit while those modules finish strict Ziran migration.
meditation_music_init :: (app: *InnerBreeze) #foreign c;
meditation_music_unload :: (app: *InnerBreeze) #foreign c;
meditation_music_update :: (app: *InnerBreeze) #foreign c;
meditation_start_configured :: (app: *InnerBreeze) #foreign c;

#program_export
meditation_practice_init :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    meditation_music_init(app)
}

#program_export
meditation_practice_destroy :: (app: *InnerBreeze) {
    meditation_music_unload(app)
}

#program_export
meditation_practice_start :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    mark_exercise_manual_seen(app, EXERCISE_MEDITATION)
    meditation_start_configured(app)
}

#program_export
meditation_practice_update :: (app: *InnerBreeze) {
    meditation_music_update(app)
}

#program_export
meditation_practice_leave_config :: (app: *InnerBreeze) {
    meditation_music_unload(app)
}
