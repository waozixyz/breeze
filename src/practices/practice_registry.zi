    #import, file "../platform/android/android_wakelock.zi";
    #import, file "../platform/android/android_timer_host.zi";
    #import, file "../app/current_app.zi";

    android_background_session_started: s32 = 0;
}

PracticeVoidFn :: #type (app: *InnerBreeze) -> ();
PracticeCloseManualFn :: #type (app: *InnerBreeze, manual: s32) -> ();
PracticeDrawSessionFn :: #type (app: *InnerBreeze, x: s32, y: s32) -> ();
PracticeIsActiveFn :: #type (app: *InnerBreeze) -> s32;
PracticeAdvanceElapsedFn :: #type (app: *InnerBreeze, elapsed: s32) -> ();
// Draws the running practice's live picture into its small window and
// writes the line shown below it, such as the round or the time left.
PracticeDrawWindowFn :: #type (app: *InnerBreeze, picture: Rectangle, status: []u8) -> string;
// Draws the practice's exit prompt while it is open: 0 when it is not
// open, 1 while it asks or after it was cancelled, PRACTICE_EXIT_ENDED once
// the practice has ended.
PracticeExitPromptFn :: #type (app: *InnerBreeze) -> s32;
PRACTICE_EXIT_ENDED :: 2
// Whether the practice waits for the person to breathe, as a held breath
// does: 1 while its screen offers its Breath button or a double tap.
PracticeCanBreatheFn :: #type (app: *InnerBreeze) -> s32;
// Whether the practice has finished its time while its screen still waits,
// as a meditation waiting to be extended does: 1 and its results so far for
// the floating window, 0 while it runs.
PracticeWindowResultFn :: #type (app: *InnerBreeze, result: *SessionResult) -> s32;

// The kind of practice, which Practice lists under its own tab. Breathing
// practices count as meditation.
PRACTICE_KIND_NONE :: 0
PRACTICE_KIND_MEDITATION :: 1
PRACTICE_KIND_YOGA :: 2
PRACTICE_KIND_MARTIAL_ARTS :: 3
PRACTICE_KIND_WORKOUT :: 4

PracticeDefinition :: struct {
    id: ExerciseType
    label_key: string
    kind: s32
    init: PracticeVoidFn
    destroy: PracticeVoidFn
    start: PracticeVoidFn
    start_downloaded: PracticeVoidFn
    draw_manual: PracticeVoidFn
    close_manual: PracticeCloseManualFn
    draw_config: PracticeVoidFn
    // Start opens the configuration screen to choose what to practise, so
    // the practice home shows no separate settings button.
    config_on_start: bool
    leave_config: PracticeVoidFn
    update: PracticeVoidFn
    draw_setup_modal: PracticeVoidFn
    draw_active_session: PracticeDrawSessionFn
    request_exit: PracticeVoidFn
    exit_prompt: PracticeExitPromptFn
    // Ends the practice at once, keeping what its exit prompt's Save keeps.
    end: PracticeVoidFn
    is_active: PracticeIsActiveFn
    background_start: PracticeVoidFn
    background_stop: PracticeVoidFn
    advance_elapsed: PracticeAdvanceElapsedFn
    draw_window: PracticeDrawWindowFn
    can_breathe: PracticeCanBreatheFn
    breathe: PracticeVoidFn
    window_result: PracticeWindowResultFn
}

practices: [EXERCISE_COUNT]PracticeDefinition;
practices_initialized: bool;

practice_initialize_definitions :: () {
    if practices_initialized {
        return
    }

    whm: PracticeDefinition
    whm.id = cast(ExerciseType)EXERCISE_WIM_HOF
    whm.label_key = "exercise_wim_hof"
    whm.kind = PRACTICE_KIND_MEDITATION
    whm.start = whm_practice_start
    whm.draw_manual = whm_manual_draw
    whm.close_manual = whm_manual_close
    whm.draw_config = whm_config_screen_draw
    whm.leave_config = whm_practice_leave_config
    whm.is_active = practice_whm_is_active
    whm.background_start = session_background_start
    whm.advance_elapsed = session_advance_elapsed
    whm.request_exit = session_request_exit
    whm.exit_prompt = session_handle_exit_modal
    whm.end = session_end
    whm.draw_window = session_draw_window
    whm.can_breathe = session_can_breathe
    whm.breathe = session_breathe
    practices[0] = whm

    meditation: PracticeDefinition
    meditation.id = cast(ExerciseType)EXERCISE_MEDITATION
    meditation.label_key = "exercise_meditation"
    meditation.kind = PRACTICE_KIND_MEDITATION
    meditation.init = meditation_practice_init
    meditation.destroy = meditation_practice_destroy
    meditation.start = meditation_practice_start
    meditation.draw_manual = meditation_manual_draw
    meditation.close_manual = meditation_manual_close
    meditation.draw_config = meditation_config_screen_draw
    meditation.leave_config = meditation_practice_leave_config
    meditation.update = meditation_practice_update
    meditation.draw_setup_modal = meditation_draw_setup_modal
    meditation.draw_active_session = meditation_draw_screen
    meditation.request_exit = meditation_request_exit
    meditation.exit_prompt = meditation_handle_exit_modal
    meditation.end = meditation_end
    meditation.is_active = practice_meditation_is_active
    meditation.advance_elapsed = meditation_advance_elapsed
    meditation.draw_window = meditation_draw_window
    meditation.window_result = meditation_window_result
    practices[1] = meditation

    sun: PracticeDefinition
    sun.id = cast(ExerciseType)EXERCISE_SUN_SALUTATION
    sun.label_key = "exercise_sun_salutation"
    sun.kind = PRACTICE_KIND_YOGA
    sun.init = sun_salutation_practice_init
    sun.start = sun_salutation_practice_start
    sun.draw_manual = sun_manual_draw
    sun.close_manual = sun_manual_close
    sun.draw_config = sun_salutation_config_screen_draw
    sun.draw_active_session = sun_salutation_draw_screen
    sun.request_exit = sun_salutation_request_exit
    sun.exit_prompt = sun_salutation_handle_exit_modal
    sun.end = sun_salutation_end
    sun.is_active = practice_sun_salutation_is_active
    sun.advance_elapsed = sun_salutation_advance_elapsed
    sun.draw_window = sun_salutation_draw_window
    practices[2] = sun

    patterns: PracticeDefinition
    patterns.id = cast(ExerciseType)EXERCISE_PATTERNS
    patterns.label_key = "exercise_patterns"
    patterns.kind = PRACTICE_KIND_MEDITATION
    patterns.init = patterns_practice_init
    patterns.destroy = patterns_practice_destroy
    patterns.start = patterns_practice_start
    patterns.draw_manual = patterns_manual_draw
    patterns.close_manual = patterns_manual_close
    patterns.draw_config = patterns_config_screen_draw
    patterns.leave_config = patterns_practice_leave_config
    patterns.draw_active_session = patterns_draw_screen
    patterns.request_exit = patterns_request_exit
    patterns.exit_prompt = patterns_handle_exit_modal
    patterns.end = patterns_end
    patterns.is_active = practice_patterns_is_active
    patterns.advance_elapsed = patterns_advance_elapsed
    patterns.draw_window = patterns_draw_window
    practices[3] = patterns

    tai_chi: PracticeDefinition
    tai_chi.id = cast(ExerciseType)EXERCISE_TAI_CHI
    tai_chi.label_key = "exercise_tai_chi"
    tai_chi.kind = PRACTICE_KIND_MARTIAL_ARTS
    tai_chi.start = tai_chi_practice_start
    tai_chi.draw_config = tai_chi_modal_draw
    tai_chi.config_on_start = false
    tai_chi.draw_active_session = tai_chi_draw_screen
    tai_chi.request_exit = tai_chi_request_exit
    tai_chi.exit_prompt = tai_chi_handle_exit_modal
    tai_chi.end = TaiChiExitToStart
    tai_chi.is_active = practice_tai_chi_is_active
    tai_chi.advance_elapsed = tai_chi_advance_elapsed
    tai_chi.draw_window = tai_chi_draw_window
    practices[4] = tai_chi

    astral: PracticeDefinition
    astral.id = cast(ExerciseType)EXERCISE_ASTRAL_PROJECTION
    astral.label_key = "exercise_astral_projection"
    astral.kind = PRACTICE_KIND_MEDITATION
    astral.start = AstralStart
    astral.draw_manual = AstralManualDraw
    astral.close_manual = AstralManualClose
    astral.draw_config = AstralConfigDraw
    astral.update = AstralUpdate
    astral.draw_active_session = AstralDraw
    astral.request_exit = AstralRequestExit
    astral.exit_prompt = AstralExitPrompt
    astral.end = AstralEnd
    astral.is_active = AstralActive
    astral.advance_elapsed = AstralAdvanceElapsed
    astral.draw_window = AstralDrawWindow
    practices[5] = astral

    workout: PracticeDefinition
    workout.id = cast(ExerciseType)EXERCISE_WORKOUT
    workout.label_key = "exercise_workout"
    workout.kind = PRACTICE_KIND_WORKOUT
    workout.start = WorkoutStart
    workout.update = WorkoutUpdate
    workout.draw_active_session = WorkoutDraw
    workout.request_exit = WorkoutRequestExit
    workout.exit_prompt = WorkoutExitPrompt
    workout.end = WorkoutEnd
    workout.is_active = WorkoutActive
    workout.advance_elapsed = WorkoutAdvanceElapsed
    workout.draw_window = WorkoutDrawWindow
    practices[6] = workout

    for index: cast(s32)0..cast(s32)(EXERCISE_COUNT - 1) {
        practices[index].start_downloaded = practices[index].start
        practices[index].start = practice_start_downloaded
    }
    practices_initialized = true
}

practice_start_downloaded :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.pending_practice_start = 0
    id := practice_clamp_id(app.exercise_type)
    PracticeDownloadsPump(id, app.voice_narration_enabled != 0,
        app.guide_narration_enabled != 0, practice_active(app) == null)
    if !PracticeContentReady(id) {
        if PracticeInstalled(id) {
            app.pending_practice_start = id + 1
        }
        PracticeContentRequest(id)
        return
    }
    start := practices[id].start_downloaded
    if start != null {
        start(app)
    }
}

// An explicit Start survives asynchronous verification of installed content.
// Leaving its card, opening another view or starting another session cancels it.
practice_start_pending_update :: (app: *InnerBreeze) {
    if app == null || app.pending_practice_start == 0 {
        return
    }
    id := app.pending_practice_start - 1
    if id < 0 || id >= EXERCISE_COUNT || app.exercise_type != id ||
    app.breathing.screen != ScreenStart || app.launcher_open || app.modal.active != 0 ||
    practice_active(app) != null || !PracticeInstalled(id) {
        app.pending_practice_start = 0
        return
    }
    if !PracticeContentReady(id) {
        return
    }
    app.pending_practice_start = 0
    before := app_current_route(app)
    start := practice_get(id).start_downloaded
    if start != null {
        start(app)
    }
    app_observe_direct_route_change(app, before)
}

practice_whm_is_active :: (app: *InnerBreeze) -> s32 {
    if app_session_screen(app) == ScreenSession {
        return 1
    }
    return 0
}

practice_meditation_is_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app_session_screen(app) == ScreenMeditation) then (1) else (0)
}

practice_sun_salutation_is_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app_session_screen(app) == ScreenSunSalutation) then (1) else (0)
}

practice_tai_chi_is_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app_session_screen(app) == ScreenTaiChi) then (1) else (0)
}

practice_patterns_is_active :: (app: *InnerBreeze) -> s32 {
    return ifx (app_session_screen(app) == ScreenPatterns) then (1) else (0)
}

practice_get :: (id: s32) -> *PracticeDefinition {
    practice_initialize_definitions()
    id = practice_clamp_id(id)
    return *practices[id]
}

practice_label :: (id: s32) -> string {
    if id == EXERCISE_MEDITATION {
        return LocaleText("exercise_meditation")
    }
    if id == EXERCISE_SUN_SALUTATION {
        return LocaleText("exercise_sun_salutation")
    }
    if id == EXERCISE_PATTERNS {
        return LocaleText("exercise_patterns")
    }
    if id == EXERCISE_TAI_CHI {
        return LocaleText("exercise_tai_chi")
    }
    if id == EXERCISE_ASTRAL_PROJECTION {
        return LocaleText("exercise_astral_projection")
    }
    if id == EXERCISE_WORKOUT {
        return LocaleText("exercise_workout")
    }
    return LocaleText("exercise_wim_hof")
}

practice_active :: (app: *InnerBreeze) -> *PracticeDefinition {
    {
        i: s32 = 0
        while i < practice_count() {
            practice := practice_get(i)
            if practice.is_active != null && practice.is_active(app) != 0 {
                return practice
            }
            i += 1
        }
    }
    return null
}

practice_active_supports_background :: (app: *InnerBreeze) -> s32 {
    practice := practice_active(app)
    return ifx (practice != null && practice.advance_elapsed != null) then (1) else (0)
}

#program_export
practice_background_start :: (app: *InnerBreeze, id: s32) {
    practice: *PracticeDefinition = null

    if app == null {
        return
    }

    practice = practice_get(id)

    #if ANDROID {
        SetCurrentApp(app)
    }

    if practice == null || practice.advance_elapsed == null {
        return
    }

    if practice.background_start != null {
        practice.background_start(app)
    }

    #if ANDROID {
        if app.breathing.play_in_background != 0 {
            android_wakelock_acquire()
            android_timer_set_app(cast(*void)app)
            android_timer_start()
            android_background_session_started = 1
        }
    }
}

practice_active_background_start :: (app: *InnerBreeze) {
    practice := practice_active(app)

    if practice == null {
        return
    }
    practice_background_start(app, cast(s32)practice.id)
}

#program_export
practice_active_background_stop :: (app: *InnerBreeze) {
    practice := practice_active(app)

    if app == null {
        return
    }

    if practice != null && practice.background_stop != null {
        practice.background_stop(app)
    }

    #if ANDROID {
        if android_background_session_started != 0 {
            android_background_session_started = 0
            android_timer_deactivate()
            android_timer_stop()
            android_timer_set_app(null)
            android_wakelock_release()
        }
    }
}

#program_export
practice_active_advance_elapsed :: (app: *InnerBreeze, elapsed_ms: s32) {
    practice: *PracticeDefinition = null

    if app == null || elapsed_ms <= 0 || app.breathing.play_in_background == 0 {
        return
    }

    practice = practice_active(app)
    if practice == null || practice.advance_elapsed == null {
        return
    }

    practice.advance_elapsed(app, elapsed_ms)
    if practice.update != null && practice.is_active != null  && practice.is_active(app) != 0 {
        practice.update(app)
    }
}

practice_update_circle_bounds :: (app: *InnerBreeze, top_reserve: s32, bottom_reserve: s32) {
    if app != null {
        session_update_circle_bounds_for_view(app, *app.breathing,
            top_reserve, bottom_reserve)
    }
}

#program_export
practice_update_session_sounds :: (app: *InnerBreeze) {
    update_session_sounds(app)
}

practice_ensure_results_saved :: (app: *InnerBreeze) -> s32 {
    return session_ensure_results_saved(app)
}

practice_draw_start_preview :: (app: *InnerBreeze, center_x: s32, center_y: s32) -> s32 {
    return session_draw_start_preview(app, center_x, center_y)
}

practice_draw_active_breathing :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    session_draw_inbe(app, center_x, center_y)
}

practice_update_active_breathing :: (app: *InnerBreeze, center_x: s32, center_y: s32, hover: *s32) {
    session_update_screen(app, center_x, center_y, hover)
}
