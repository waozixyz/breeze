// Convert the same solved pose for the app and the figure developer tools.
#import "figure_math"
#import "figure_joints"
#import, file "tai_chi/tai_chi_solve.zi";
#import, file "tai_chi/tai_chi_math.zi";

PracticeFigureJoints :: (solved: *TaiChiSolved, rig: *TaiChiRig) -> FigureJoints {
    joints: FigureJoints
    joints.height = rig.height
    joints.pelvis = FigureV3(solved.pelvis.x, solved.pelvis.y, solved.pelvis.z)
    joints.spine = FigureV3(solved.spine1.x, solved.spine1.y, solved.spine1.z)
    joints.chest = FigureV3(solved.chest.x, solved.chest.y, solved.chest.z)
    joints.neck = FigureV3(solved.neck_base.x, solved.neck_base.y, solved.neck_base.z)
    joints.pelvis_turn = PracticeFigureQuat(solved.pelvis_quat)
    joints.chest_turn = PracticeFigureQuat(solved.chest_quat)
    joints.head_turn = PracticeFigureQuat(solved.head_quat)
    for side: 0..1 {
        joints.shoulders[side] = FigureV3(solved.shoulders[side].x, solved.shoulders[side].y, solved.shoulders[side].z)
        joints.elbows[side] = FigureV3(solved.elbows[side].x, solved.elbows[side].y, solved.elbows[side].z)
        joints.wrists[side] = FigureV3(solved.wrists[side].x, solved.wrists[side].y, solved.wrists[side].z)
        joints.hands[side] = PracticeFigureQuat(solved.hand_quats[side])
        joints.fist[side] = solved.hand_shapes[side][1]
        joints.hook[side] = solved.hand_shapes[side][2]
        joints.hips[side] = FigureV3(solved.hips[side].x, solved.hips[side].y, solved.hips[side].z)
        joints.knees[side] = FigureV3(solved.knees[side].x, solved.knees[side].y, solved.knees[side].z)
        joints.ankles[side] = FigureV3(solved.ankles[side].x, solved.ankles[side].y, solved.ankles[side].z)
        joints.toes[side] = FigureV3(solved.toes[side].x, solved.toes[side].y, solved.toes[side].z)
        joints.heels[side] = FigureV3(solved.heels[side].x, solved.heels[side].y, solved.heels[side].z)
        joints.balls[side] = FigureV3(solved.balls[side].x, solved.balls[side].y, solved.balls[side].z)
        joints.feet[side] = PracticeFigureQuat(solved.foot_quats[side])
    }
    return joints
}

#scope_file
PracticeFigureQuat :: (quat: TaiChiQuaternion) -> FigureQuat {
    return .{quat.x, quat.y, quat.z, quat.w}
}
