#scope_export
Patterns :: struct {
    preset: s32
    custom: [4] s32
    // inhale, hold-in, exhale, hold-out seconds
    duration_minutes: s32
    // 0 = open-ended
    active: s32
    paused: s32
    phase: s32
    phase_second: s32
    frame_ticks: s32
    second_accumulator: float64
    cycle: s32
    elapsed_seconds: s32
}
