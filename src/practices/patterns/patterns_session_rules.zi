#import, file "patterns_clock.zi";
#import, file "patterns_types.zi";
#import, file "../../app/app_types.zi";
#import, file "patterns_rules.zi";
#import, file "../../app/text_buffers.zi";
#import "byte_text_linux"

// The clock and phase decisions are app state, independent of the UI and
// native audio/storage boundaries.
PatternsSecond :: struct {
    cue: s32 // 0: none, 1: inhale, 2: exhale
    completed: bool
}

#program_export
pattern_ratio :: (app: *InnerBreeze, out: *s32) {
    if out == null {
        return
    }
    state: Patterns
    if app != null {
        state = app.patterns
    }
    index: s32 = 0
    while index < 4 {
        out[index] = patterns_ratio_part(state, index)
        index += 1
    }
}

#program_export
patterns_ratio_text :: (app: *InnerBreeze, out: *u8, out_size: s64) {
    if out == null || out_size <= 0 { return }
    ratio: [4]s32
    pattern_ratio(app, *ratio[0])
    args: [4]FormatArg = .[
    FormatArg.{.number = ratio[0]}, FormatArg.{.number = ratio[1]},
    FormatArg.{.number = ratio[2]}, FormatArg.{.number = ratio[3]}
    ]
    FormatTemplate("%d-%d-%d-%d", args[:],
        BytesFromPointer(out, cast(u64)out_size))
}

#program_export
patterns_phase_remaining_seconds :: (app: *InnerBreeze) -> s32 {
    state: Patterns
    if app != null {
        state = app.patterns
    }
    return patterns_phase_remaining(state)
}

#program_export
patterns_advance_second :: (state: *Patterns) -> PatternsSecond {
    result: PatternsSecond
    if state == null {
        return result
    }
    next := PatternsAdvance(state.*)
    state.* = next.state
    result.cue = next.cue
    result.completed = next.completed
    return result
}
