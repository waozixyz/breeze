c :: #system_library "c";
#import, file "../../app/app_modal_state.zi";
#import, file "../../app/app_route_state.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/exercise_types.zi";
#import, file "../../app/modal_rules.zi";
#import, file "../../core/types.zi";
#import, file "patterns_rules.zi";
#import, file "../../app/activity_start.zi";

using ExerciseType;
using ModalType;

// Background scheduling is still owned by the unmigrated practice registry.
practice_background_start :: (app: *InnerBreeze, id: s32) #foreign c;

#program_export
patterns_practice_init :: (app: *InnerBreeze) {
    if app == null { return }
    app.patterns.preset = PATTERNS_PRESET_BOX
    index: s32 = 0
    while index < 4 {
        app.patterns.custom[index] =
            patterns_preset_ratio(PATTERNS_PRESET_BOX, index)
        index += 1
    }
    app.patterns.duration_minutes = 5
}

#program_export
patterns_practice_destroy :: (app: *InnerBreeze) { unused app }

#program_export
patterns_practice_start :: (app: *InnerBreeze) {
    if app == null || !ActivityStartAllowed() { return }
    app.patterns.active = 1
    app.patterns.paused = 0
    app.patterns.phase = PATTERNS_PHASE_INHALE
    app.patterns.phase_second = 0
    app.patterns.frame_ticks = 0
    app.patterns.second_accumulator = 0.0
    app.patterns.cycle = 0
    app.patterns.elapsed_seconds = 0
    app_close_modal(app)
    app_switch_screen(app, ScreenPatterns)
    practice_background_start(app, EXERCISE_PATTERNS)
}

#program_export
patterns_practice_leave_config :: (app: *InnerBreeze) { unused app }

#program_export
patterns_request_exit :: (app: *InnerBreeze) {
    if app != null {
        app_open_modal(app, cast(ModalType)ModalConfirmExitSession)
    }
}
