PATTERNS_PRESET_BOX :: 0
PATTERNS_PRESET_478 :: 1
PATTERNS_PRESET_COHERENT :: 2
PATTERNS_PRESET_EXTENDED_EXHALE :: 3
PATTERNS_PRESET_CUSTOM :: 4
PATTERNS_PRESET_COUNT :: 5
PATTERNS_PHASE_INHALE :: 0
PATTERNS_PHASE_HOLD_IN :: 1
PATTERNS_PHASE_EXHALE :: 2
PATTERNS_PHASE_HOLD_OUT :: 3
PATTERNS_MAX_SECONDS :: 60

#program_export
patterns_preset_ratio :: (preset: s32, part: s32) -> s32 {
    if preset < 0 || preset >= PATTERNS_PRESET_COUNT {
        preset = PATTERNS_PRESET_BOX
    }
    if part < 0 || part >= 4 {
        return 0
    }
    if preset == PATTERNS_PRESET_CUSTOM {
        return 0
    }
    if preset == PATTERNS_PRESET_BOX {
        return 4
    }
    if preset == PATTERNS_PRESET_478 {
        if part == 0 {
            return 4
        }
        if part == 1 {
            return 7
        }
        if part == 2 {
            return 8
        }
        return 0
    }
    if preset == PATTERNS_PRESET_COHERENT {
        if part == 0 || part == 2 {
            return 5
        }
        return 0
    }
    if part == 0 {
        return 4
    }
    if part == 2 {
        return 6
    }
    return 0
}

#program_export
patterns_preset_label_key :: (preset: s32) -> string {
    if preset == PATTERNS_PRESET_478 {
        return "patterns_preset_478"
    }
    if preset == PATTERNS_PRESET_COHERENT {
        return "patterns_preset_coherent"
    }
    if preset == PATTERNS_PRESET_EXTENDED_EXHALE {
        return "patterns_preset_extended_exhale"
    }
    if preset == PATTERNS_PRESET_CUSTOM {
        return "patterns_preset_custom"
    }
    return "patterns_preset_box"
}

#program_export
patterns_preset_count :: () -> s32 {
    return PATTERNS_PRESET_COUNT
}

#program_export
patterns_phase_label_key :: (phase: s32) -> string {
    if phase == PATTERNS_PHASE_HOLD_IN {
        return "patterns_phase_hold_in"
    }
    if phase == PATTERNS_PHASE_EXHALE {
        return "patterns_phase_exhale"
    }
    if phase == PATTERNS_PHASE_HOLD_OUT {
        return "patterns_phase_hold_out"
    }
    return "patterns_phase_inhale"
}
