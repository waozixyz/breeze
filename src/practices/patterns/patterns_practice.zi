using SessionExitModalResult;
using ModalType;
using ExerciseType;
using TextWrap;
using ButtonTone;
using ButtonEmphasis;

// Timed-ratio breathing practice: preset patterns (box, 4-7-8, coherent,
// extended exhale) plus a fully custom in/hold/exhale/hold-out ratio. The
// session is a driven animation (circle grows on inhale, shrinks on exhale)
// with optional breath cues, saved as one session of its own activity kind.

finish_session :: (app: *InnerBreeze) {
    duration: s32 = app.patterns.elapsed_seconds
    result_path: [FS_PATH_MAX] u8
    ratio_text: [32] u8

    app.patterns.active = 0
    app.patterns.paused = 0
    if duration >= 60 {
        rounds: [1] s32 = .[0]
        rounds[0] = duration
        if data_save_session_path_for_activity(*rounds[0], 1, 0,
            EXERCISE_PATTERNS,
            *result_path[0],
            size_of(type_of(result_path))) != 0 {
            AchievementPatternSaved(AppTextFromCString(*result_path[0], FS_PATH_MAX), app.patterns.preset)
            sync_habits_for_activity(app, EXERCISE_PATTERNS)
            app_auto_sync(app)
        }
    }
    patterns_ratio_text(app, *ratio_text[0], size_of(type_of(ratio_text)))
    app_play_bell_cue(app, 1.0)
    app_prepare_session_results(app, EXERCISE_PATTERNS, duration,
        app.patterns.cycle, *ratio_text[0], null, 0,
        *result_path[0])
    app_switch_screen(app, cast(s32)ScreenResults)
}

patterns_handle_exit_modal :: (app: *InnerBreeze) -> s32 {
    result: SessionExitModalResult

    if app == null || app.modal.active == 0  || app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return 0
    }
    result = app_draw_session_exit_modal(app,
        ifx (app.patterns.elapsed_seconds >= 60) then (1) else (0),
        LocaleText("patterns_save_elapsed_message"),
        LocaleText("patterns_under_minute_exit_message")
        )
    if result == cast(SessionExitModalResult)SessionExitModalCancel {
        app_close_modal(app)
    } else if result == cast(SessionExitModalResult)SessionExitModalSave  || result == cast(SessionExitModalResult)SessionExitModalDiscard {
        if result == cast(SessionExitModalResult)SessionExitModalSave {
            patterns_save_elapsed(app)
        }
        patterns_exit_to_start(app)
        return 2
    }
    return 1
}

// Keeps a minute or more of the practice without showing its results.
patterns_save_elapsed :: (app: *InnerBreeze) {
    duration: s32 = app.patterns.elapsed_seconds
    rounds: [1] s32 = .[0]
    rounds[0] = duration
    result_path: [FS_PATH_MAX]u8
    if duration >= 60  && data_save_session_path_for_activity(*rounds[0], 1, 0,
        EXERCISE_PATTERNS,
        *result_path[0], FS_PATH_MAX) != 0 {
        AchievementPatternSaved(AppTextFromCString(*result_path[0], FS_PATH_MAX), app.patterns.preset)
        sync_habits_for_activity(app, EXERCISE_PATTERNS)
        app_auto_sync(app)
    }
}

patterns_exit_to_start :: (app: *InnerBreeze) {
    app.patterns.active = 0
    app.patterns.paused = 0
    app_close_modal(app)
    app_switch_screen(app, ScreenStart)
}

// Ends at once, keeping a minute or more as the exit prompt's Save does.
patterns_end :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    patterns_save_elapsed(app)
    patterns_exit_to_start(app)
}

advance_second :: (app: *InnerBreeze) {
    step := PracticeRun(PracticeStepFor(app, PRACTICE_PATTERNS_STEP))
    if !step.succeeded {
        app.request_quit = 1
        app.patterns.active = 0
        return
    }
    app.patterns = step.patterns
    if step.cue == 1 {
        app_play_breath_cue(app, 0)
    } else if step.cue == 2 {
        app_play_breath_cue(app, 1)
    }
    if step.completed {
        finish_session(app)
    }
}

patterns_advance_elapsed :: (app: *InnerBreeze, elapsed_ms: s32) {
    if app == null || elapsed_ms <= 0  || app_session_screen(app) != ScreenPatterns || app.patterns.paused != 0 {
        return
    }
    app.patterns.second_accumulator += cast(float64)elapsed_ms / 1000.0
    while app.patterns.second_accumulator >= 1.0 && app.patterns.active != 0 {
        app.patterns.second_accumulator -= 1.0
        advance_second(app)
    }
}

// Practices draws the page (practice_settings_host.zi).
patterns_config_screen_draw :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if PracticeSettingsDraw(app, EXERCISE_PATTERNS) != 0 {
        PracticeConfigLeave(app, cast(s32)ModalPracticeConfig)
    }
}

patterns_draw_session_title_bar :: (app: *InnerBreeze, title: string, height: s32) -> s32 {
    return ifx PracticeTitleBar(app, title, height) then 1 else 0
}

// How far the pattern's circle has grown along the current phase: 0.25 at
// its smallest and 1 at its largest.
patterns_circle_fraction :: (app: *InnerBreeze) -> float32 {
    ratio: [4] s32
    pattern_ratio(app, *ratio[0])
    phase_len := ratio[app.patterns.phase]
    if phase_len <= 0 {
        phase_len = 1
    }
    progress := (cast(float32)app.patterns.phase_second +
        cast(float32)app.patterns.second_accumulator) / cast(float32)phase_len
    if progress < 0.0 {
        progress = 0.0
    }
    if progress > 1.0 {
        progress = 1.0
    }
    if app.patterns.phase == {
        case PATTERNS_PHASE_INHALE;
        return 0.25 + progress * 0.75
        case PATTERNS_PHASE_EXHALE;
        return 1.0 - progress * 0.75
        case PATTERNS_PHASE_HOLD_IN;
        return 1.0
    }
    return 0.25
}

// The pattern's circle in the practice's small window with the phase on
// it, as on the practice's screen, and the cycle and time below it.
patterns_draw_window :: (app: *InnerBreeze, picture: Rectangle, status: []u8) -> string {
    // The screen's smallest circle is 38 percent of its largest.
    unused PracticeWindowCircle(CurrentApp().ui.session, picture,
        patterns_circle_fraction(app), 0.38, DarkenColor(StyleTokenColor("canvas"), 8))
    PracticeWindowLabel(app, picture, LocaleText(patterns_phase_label_key(app.patterns.phase)))
    seconds := app.patterns.elapsed_seconds
    if app.patterns.duration_minutes > 0 {
        seconds = app.patterns.duration_minutes * 60 - app.patterns.elapsed_seconds
    }
    if seconds < 0 {
        seconds = 0
    }
    parts: [4]FormatArg = .[
    FormatArg.{.text = LocaleText("patterns_cycle_label"), .is_text = true},
    FormatArg.{.number = app.patterns.cycle + 1},
    FormatArg.{.number = seconds / 60},
    FormatArg.{.number = seconds % 60}
    ]
    FormatTemplate("%s %d · %d:%02d", parts[:], status)
    return AppTextFromCString(*status[0], cast(s32)status.count)
}

// ---- The circle, phase, cycle and Pause, which Practices draws -------------

practice_patterns_frame: PracticePatternsFrame;
practice_patterns_frame_codec: WidgetPracticePatternsFrameCodec;

PracticePatternsCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "patterns_view" {
        return WidgetHostCall(context, module, function, arguments, count, result)
    }
    name := TextFromCString(function)
    if name == "ReadPracticePatternsHost" && count == 0 {
        result.* = WidgetEncodePracticePatternsFrame(practice_patterns_frame,
            *practice_patterns_frame_codec)
        return 1
    }
    if name == "WritePracticePatternsHost" && count == 1 &&
    WidgetValidPracticePatternsFrame(arguments[0]) {
        observed := WidgetDecodePracticePatternsFrame(arguments[0],
            *practice_patterns_frame_codec)
        practice_patterns_frame.action = observed.action
        return 1
    }
    return 0
}

// "Cycle 3  ·  4:05", counting down when the pattern has a duration.
patterns_status_text :: (app: *InnerBreeze, out: []u8) {
    cycle_text: [32]u8
    time_text: [32]u8
    cycle_args: [2]FormatArg = .[
    FormatArg.{.text = LocaleText("patterns_cycle_label"), .is_text = true},
    FormatArg.{.number = app.patterns.cycle + 1}
    ]
    FormatTemplate("%s %d", cycle_args[:], cycle_text[:])
    seconds := app.patterns.elapsed_seconds
    if app.patterns.duration_minutes > 0 {
        seconds = app.patterns.duration_minutes * 60 - app.patterns.elapsed_seconds
        if seconds < 0 {
            seconds = 0
        }
    }
    time_args: [2]FormatArg = .[FormatArg.{.number = seconds / 60}, FormatArg.{.number = seconds % 60}]
    FormatTemplate("%d:%02d", time_args[:], time_text[:])
    status_args: [2]FormatArg = .[
    FormatArg.{.text = AppTextFromCString(*cycle_text[0], cast(s32)cycle_text.count), .is_text = true},
    FormatArg.{.text = AppTextFromCString(*time_text[0], cast(s32)time_text.count), .is_text = true}
    ]
    FormatTemplate("%s  ·  %s", status_args[:], out)
}

// Has Practices draw the pattern's circle, phase, cycle and Pause; returns
// what was pressed there. The question asked on leaving shows the page
// without them.
patterns_draw_content :: (app: *InnerBreeze, center_x: s32, center_y: s32) -> PracticePatternsFrame {
    if app.modal.active != 0 &&
    app.modal.type == cast(ModalType)ModalConfirmExitSession {
        return PracticePatternsFrame.{}
    }
    max_radius := pattern_circle_max_radius()
    min_radius := max_radius * 38 / 100
    status: [72]u8
    patterns_status_text(app, status[:])
    practice_patterns_frame = PracticePatternsFrame.{.session = app.ui.session,
        .scale = MetricsScale(), .view_width = app.ui.view_width,
        .center_x = center_x, .center_y = center_y,
        .status_y = PracticeTitleBarHeight() + AppScale(26), .small_font = AppSmallFontSize(),
        .well_color = DarkenColor(StyleTokenColor("canvas"), 8),
        .accent_color = StyleTokenColor("accent"), .max_radius = max_radius,
        .radius = cast(s32)(cast(float32)min_radius +
            patterns_circle_fraction(app) * cast(float32)(max_radius - min_radius)),
        .phase_label = LocaleText(patterns_phase_label_key(app.patterns.phase)),
        .status = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*status[0], 72)),
        .paused = app.patterns.paused != 0,
        .pause_label = LocaleText("patterns_pause_button"),
        .resume_label = LocaleText("patterns_resume_button")}
    WidgetHostBegin(app.ui.session, HostedAssetAllowed)
    AppsUiBegin(PracticePatternsCall, cast(*void)app)
    drawn := PracticeRun(PracticeMessage.{.action = PRACTICE_PATTERNS_VIEW})
    AppsUiEnd()
    WidgetHostEnd()
    if !drawn.succeeded {
        return PracticePatternsFrame.{}
    }
    return practice_patterns_frame
}

patterns_draw_screen :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    if app == null {
        return
    }
    title_h := PracticeTitleBarHeight()
    session_top := title_h + AppScale(114)
    session_bottom := app.ui.view_height - AppScale(174)
    if session_bottom > session_top {
        center_y = (session_top + session_bottom) / 2 + AppScale(8)
    }
    // On a short screen the circle reaches under the title bar, so it comes
    // first.
    content := patterns_draw_content(app, center_x, center_y)
    if patterns_draw_session_title_bar(app, LocaleText("patterns_title"), title_h) != 0 {
        patterns_request_exit(app)
        return
    }
    if patterns_handle_exit_modal(app) != 0 {
        return
    }
    practice_draw_audio_controls(app)

    if app.patterns.paused != 0 {
        if content.action == PRACTICE_PATTERNS_RESUME {
            app.patterns.paused = 0
        }
        return
    }
    if IsKeyPressed(KEY_SPACE) || content.action == PRACTICE_PATTERNS_PAUSE {
        app.patterns.paused = 1
    }

    if app.backgrounded == 0 {
        dt := cast(float64)GetFrameTime()
        if dt < 0.0 {
            dt = 0.0
        }
        if dt > 0.25 {
            dt = 0.25
        }
        app.patterns.second_accumulator += dt
        while app.patterns.second_accumulator >= 1.0 && app.patterns.active != 0 {
            app.patterns.second_accumulator -= 1.0
            advance_second(app)
        }
    }
}

pattern_circle_max_radius :: () -> s32 {
    app := CurrentApp()
    max_r := app.ui.view_width * 30 / 100
    available_h := app.ui.view_height - GetTabBarHeight() - AppScale(300)
    limit_h := available_h / 2

    if max_r > limit_h {
        max_r = limit_h
    }
    if max_r > AppScale(136) {
        max_r = AppScale(136)
    }
    if max_r < AppScale(104) {
        max_r = AppScale(104)
    }
    return max_r
}

patterns :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("patterns/root")
    Screen(CurrentApp().ui.session, root)
    patterns_draw_screen(app, app.ui.view_width / 2, app.ui.view_height / 2)
    End(CurrentApp().ui.session)
}
