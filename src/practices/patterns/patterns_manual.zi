// The Patterns manual, which Practices draws (practice_manual_host.zi):
// closing it, and starting the practice from its last page.
#import, file "../../app/app_modal_state.zi";
#import, file "../../app/app_route_state.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/exercise_types.zi";
#import, file "../../app/manual_seen_actions.zi";
#import, file "../../app/modal_rules.zi";
#import, file "../../app/route_types.zi";
#import, file "../../apps/practice_types.zi";
#import, file "../../core/types.zi";
#import, file "../practice_manual_host.zi";
manual_host :: #system_library "c";
app_start_practice_from_ui :: (app: *InnerBreeze, id: s32) -> bool #foreign manual_host "practice_actions_app_start_practice_from_ui";

using ExerciseType;
using ModalType;

#program_export
patterns_manual_close :: (app: *InnerBreeze, mark_seen: s32) {
    if app == null { return }
    if mark_seen != 0 {
        mark_exercise_manual_seen(app, EXERCISE_PATTERNS)
    }
    if app.modal.active != 0  && app.modal.type == cast(ModalType)ModalPracticeManual {
        app_close_modal(app)
        return
    }
    app.tutorial_step = 0
    app.manual_scroll = 0
    app.practice_tab = PRACTICE_TAB_PLAY
    app_switch_screen(app, ScreenStart)
}

#program_export
patterns_manual_start :: (app: *InnerBreeze) {
    if app == null { return }
    mark_exercise_manual_seen(app, EXERCISE_PATTERNS)
    app.tutorial_step = 0
    app.manual_scroll = 0
    app.practice_tab = PRACTICE_TAB_PLAY
    unused app_start_practice_from_ui(app, EXERCISE_PATTERNS)
}

#program_export
patterns_manual_draw :: (app: *InnerBreeze) {
    action := PracticeManualDraw(app)
    if action == PRACTICE_MANUAL_CLOSE {
        patterns_manual_close(app, 0)
    } else if action == PRACTICE_MANUAL_START {
        patterns_manual_start(app)
    }
}
