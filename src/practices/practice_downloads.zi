// Content is authenticated by the catalog in the signed Practices package.
// Resource bundles are never instantiated. Download state is device-local.
#import "bundle_host"
#import "file_download"
#import "file_linux"
#import "json_scan"
#import "byte_text_linux"
#import "crypto"
#import "vec"
#import, file "../app/assets.zi";
#import, file "../app/locale.zi";
#import, file "../app/text_buffers.zi";
#import, file "../apps/package_files.zi";
#import, file "../apps/package_release.zi";
#import, file "../apps/asset_paths.zi";
#import, file "../apps/module_types.zi";
#import, file "../apps/catalog.zi";
#import, file "../platform/web_storage.zi";
#import, file "../storage/temporary_data.zi";
#import, file "../storage/paths.zi";

PRACTICE_CONTENT_THREADS :: !#defined(PLATFORM_WEB) && !#defined(_WIN32)
#if PRACTICE_CONTENT_THREADS {
    #import "std/thread_linux"
}

PracticePackCapacity :: 96
// Content names: the practices, then Lumi's narration-only guide.
PracticeGuide :: 7
PracticeContentCount :: 8
// Every practice's pictures sit under this folder; replacing a pack's
// content makes only these load again.
PRACTICE_ASSET_FOLDER :: "assets/practices/"

PracticePack :: struct {
    // A practice, or PracticeGuide.
    practice: s32
    language: [16]u8
    // A narration pack's voice: "" for the default voice, or "male".
    voice: [8]u8
    hash: [65]u8
    size: s64
    bundle: *void
    requested: bool
    // 0 not installed, 1 queued/downloading, 2 ready, 3 failed.
    status: s32
    checked: bool
    cache_checked: bool
    // Installed on this device: downloaded, or shipped with the app and not
    // removed. Read without opening the pack, for Practice's home.
    present: bool
    // Taken off Practice. A downloaded copy stays on this device, so adding
    // the practice back needs no download.
    removed: bool
    // A paid practice's packs name its unlock; the node serves them only
    // with a grant for it.
    product: [48]u8
    // Automatic retries of this download since it was asked for.
    attempts: s32
    // A narration language the person removed or stopped, so it does not
    // download by itself again.
    declined: bool
}

// The host supplies grants for paid packs: 1 with the grant written, 0 while
// it is requested, -1 when this account may not download the pack.
PracticeGrantFn :: #type (product: string, output: []u8) -> s32;
practice_grant: PracticeGrantFn;
// The host drops a grant the node turned down, so a retry asks for a new one.
PracticeGrantForgetFn :: #type () -> ();
practice_grant_forget: PracticeGrantForgetFn;
// The host's log; the grant never appears in a message.
PracticeLogFn :: #type (warning: bool, message: string) -> ();
practice_log: PracticeLogFn;
// A failed download tries again this many times before it reports failure.
PracticeDownloadRetries :: 2
// Paid practices are bought with Dew, which the Google Play build does not
// offer, so there they are neither listed nor downloaded.
practice_paid_allowed: bool = true;
// Whether the connected account owns a paid practice. A paid pack left on this
// device counts as installed only for an account that bought it.
PracticeOwnedFn :: #type (product: string) -> bool;
practice_owned: PracticeOwnedFn;

practice_packs: [PracticePackCapacity]PracticePack;
practice_pack_count: s32;
practice_catalog: string;
practice_catalog_generation: u64;
practice_transfer: FileDownload;
practice_transfer_index: s32 = -1;
practice_selected: s32 = -1;
// The languages the selected practice and Lumi's guide speak in now.
practice_narration_language: [16]u8;
practice_guide_language: [16]u8;
// Each practice's narration voice from Customize, and the selected one's now.
practice_voices: [PracticeContentCount][8]u8;
// Each practice's narration language from Customize; "" follows the app's.
practice_narration_choices: [PracticeContentCount][16]u8;
practice_voice_selected: [8]u8;
practice_narration_selected: bool;
practice_guide_narration_selected: bool;
practice_catalog_invalid: bool;
practice_content_clock: u64;
practice_content_used: [PracticePackCapacity]u64;
PracticeContentCacheBytes :: 64 * 1024 * 1024

// Keep recently shown content in memory. Moving between practices then needs
// neither another bundle open nor a global image-cache invalidation. The
// current practice and its voices are never evicted to meet this soft limit.
PracticeContentTrim :: () {
    cached: s64 = 0
    for pack: practice_packs[:practice_pack_count] {
        if pack.bundle != null {
            cached += pack.size
        }
    }
    while cached > PracticeContentCacheBytes {
        oldest: s32 = -1
        for index: cast(s32)0..practice_pack_count - 1 {
            pack := *practice_packs[index]
            if pack.bundle == null || PracticePackWanted(pack) {
                continue
            }
            if oldest < 0 || practice_content_used[index] < practice_content_used[oldest] {
                oldest = index
            }
        }
        if oldest < 0 {
            return
        }
        pack := *practice_packs[oldest]
        cached -= pack.size
        CloseBundle(pack.bundle)
        pack.bundle = null
        pack.checked = false
        AssetNotifyAvailable()
    }
}

// A worker owns its input path and catalog snapshot. It never reads the live
// catalog, touches a mounted bundle, or publishes assets from another thread.
PracticeContentWork :: struct {
    pack: PracticePack
    path: string
    fallback: string
    bundle: *void
    ready: bool
    next: *PracticeContentWork
    #if PRACTICE_CONTENT_THREADS {
        thread: Thread
    }
}
practice_transfer_work: *PracticeContentWork;
practice_load_work: [PracticePackCapacity]*PracticeContentWork;
practice_retired_work: *PracticeContentWork;
practice_content_jobs: s32;
practice_work_c :: #system_library "c";
PracticeWorkAllocate :: (size: usize) -> *void #foreign practice_work_c "malloc";
PracticeWorkRelease :: (memory: *void) #foreign practice_work_c "free";

PracticeContentWorkRun :: (argument: *void) {
    work := cast(*PracticeContentWork)argument
    bytes := PackageRead(work.path, PackageMaximumBytes)
    work.bundle = PracticePackValidate(work.pack, bytes)
    PackageFree(bytes)
    if work.bundle == null && work.fallback.count > 0 {
        work.bundle = PracticePackValidate(work.pack, work.fallback)
    }
}

PracticeContentWorkReady :: (work: *PracticeContentWork) -> bool {
    if work == null {
        return false
    }
    #if PRACTICE_CONTENT_THREADS {
        if !work.ready {
            work.ready = ThreadFinished(*work.thread)
        }
    }
    return work.ready
}

PracticeContentWorkFree :: (work: *PracticeContentWork) {
    CloseBundle(work.bundle)
    PackageFree(work.path)
    PackageFree(work.fallback)
    practice_content_jobs -= 1
    PracticeWorkRelease(cast(*void)work)
}

PracticeContentWorkRetire :: (work: *PracticeContentWork) {
    if work == null {
        return
    }
    work.next = practice_retired_work
    practice_retired_work = work
}

PracticeContentWorkCollect :: () {
    previous: *PracticeContentWork
    work := practice_retired_work
    while work != null {
        next := work.next
        if !PracticeContentWorkReady(work) {
            previous = work
            work = next
            continue
        }
        if previous == null {
            practice_retired_work = next
        } else {
            previous.next = next
        }
        PracticeContentWorkFree(work)
        work = next
    }
}

PracticeContentWorkStart :: (pack: PracticePack, path: string, fallback: string = "") -> *PracticeContentWork {
    work := cast(*PracticeContentWork)PracticeWorkAllocate(size_of(PracticeContentWork))
    if work == null {
        return null
    }
    work.* = PracticeContentWork.{}
    practice_content_jobs += 1
    work.pack = pack
    work.pack.bundle = null
    work.path = PackageText(path, "")
    work.fallback = PackageText(fallback, "")
    #if PRACTICE_CONTENT_THREADS {
        procedure: ThreadProcedure = PracticeContentWorkRun
        if !ThreadStart(*work.thread, procedure, cast(*void)work) {
            PracticeContentWorkFree(work)
            return null
        }
    } else {
        PracticeContentWorkRun(cast(*void)work)
        work.ready = true
    }
    return work
}

PracticeContentLoadStart :: (index: s32) -> bool {
    if practice_load_work[index] != null {
        return true
    }
    // Count canceled workers too, so rapid navigation cannot create a burst
    // of hashing jobs or payload allocations on a phone.
    if practice_content_jobs > 0 {
        return false
    }
    pack := practice_packs[index]
    path := PracticePackPath(index, false)
    fallback := ifx pack.present then PracticeShippedBytes(index) else ""
    practice_load_work[index] = PracticeContentWorkStart(pack, path, fallback)
    PackageFree(path)
    return practice_load_work[index] != null
}

PracticeContentName :: (practice: s32) -> string {
    names: [PracticeContentCount]string = .["whm", "meditation", "sunsalutation", "patterns", "taichi", "astral_projection", "workout", "guide"]
    if practice < 0 || practice >= PracticeContentCount {
        return ""
    }
    return names[practice]
}

PracticeContentIndex :: (name: string) -> s32 {
    for content: cast(s32)0..PracticeContentCount - 1 {
        if PracticeContentName(content) == name {
            return content
        }
    }
    return -1
}

PracticePackPath :: (index: s32, temporary: bool) -> string {
    return PracticePackFile(index, ifx temporary then ".download" else ".zx")
}

// Versions before the ZX format stored packs as .zib. Such a copy cannot
// run, but it shows the practice was installed, so it is updated in place.
PRACTICE_PACK_LEGACY_SUFFIX :: ".zib"

PracticePackLegacyRemove :: (index: s32) {
    path := PracticePackFile(index, PRACTICE_PACK_LEGACY_SUFFIX)
    defer {
        PackageFree(path)
    }
    if path.count > 0 {
        unused RemoveFile(path)
    }
}

// A narration language the person removed keeps this marker beside its slot.
PracticeNarrationDeclinedPath :: (index: s32) -> string {
    if index < 0 || index >= practice_pack_count || practice_packs[index].language[0] == cast(u8)0 {
        return ""
    }
    return PracticePackFile(index, ".removed")
}

PracticePackFile :: (index: s32, suffix: string) -> string {
    directory := PackageDirectory()
    defer {
        PackageFree(directory)
    }
    if directory.count == 0 || index < 0 || index >= practice_pack_count {
        return ""
    }
    prefix := PackageText(directory, "/practice-")
    name := PackageText(prefix, PracticeContentName(practice_packs[index].practice))
    defer {
        PackageFree(prefix)
        PackageFree(name)
    }
    language := TextFromCString(*practice_packs[index].language[0])
    if language.count == 0 {
        return PackageText(name, suffix)
    }
    separator := PackageText(name, ".")
    localized := PackageText(separator, language)
    voice := TextFromCString(*practice_packs[index].voice[0])
    voiced := PackageText(localized, ifx voice.count > 0 then "." else "")
    slot := PackageText(voiced, voice)
    defer {
        PackageFree(separator)
        PackageFree(localized)
        PackageFree(voiced)
        PackageFree(slot)
    }
    // One slot per practice, language and voice. A verified update replaces the old copy.
    return PackageText(slot, suffix)
}

// Small practices ship with the app: those in default/ are installed until
// removed, and those in shipped/ are added from the app without a download.
PracticeShippedFrom :: (index: s32, folder: string) -> string {
    if index < 0 || index >= practice_pack_count || practice_packs[index].language[0] != cast(u8)0 {
        return ""
    }
    directory := PackageText("assets/practices/", folder)
    prefix := PackageText(directory, PracticeContentName(practice_packs[index].practice))
    path := PackageText(prefix, ".zx")
    defer {
        PackageFree(directory)
        PackageFree(prefix)
        PackageFree(path)
    }
    view := AssetRead(path)
    return ifx view.found then view.data else ""
}

PracticeDefaultBytes :: (index: s32) -> string {
    return PracticeShippedFrom(index, "default/")
}

PracticeShippedBytes :: (index: s32) -> string {
    bytes := PracticeDefaultBytes(index)
    return ifx bytes.count > 0 then bytes else PracticeShippedFrom(index, "shipped/")
}

// The practice comes with the app, so adding it needs no network.
PracticeShipped :: (practice: s32) -> bool {
    PracticeCatalogLoad()
    return PracticeShippedBytes(PracticePackFind(practice, "")).count > 0
}

// A practice's markers beside its packs: ".removed" keeps it off Practice,
// and ".added" puts a practice that ships with the app on Practice without
// a copy of its own.
PracticeMarkerPath :: (practice: s32, suffix: string) -> string {
    directory := PackageDirectory()
    defer {
        PackageFree(directory)
    }
    if directory.count == 0 {
        return ""
    }
    prefix := PackageText(directory, "/practice-")
    name := PackageText(prefix, PracticeContentName(practice))
    defer {
        PackageFree(prefix)
        PackageFree(name)
    }
    return PackageText(name, suffix)
}

PracticeMarked :: (practice: s32, suffix: string) -> bool {
    path := PracticeMarkerPath(practice, suffix)
    defer {
        PackageFree(path)
    }
    return path.count > 0 && PathExists(path)
}

// Temporary data leaves the device's markers as they are.
PracticeMark :: (practice: s32, suffix: string, marked: bool) {
    if DataTemporary() {
        return
    }
    path := PracticeMarkerPath(practice, suffix)
    defer {
        PackageFree(path)
    }
    if path.count == 0 {
        return
    }
    if !marked {
        unused RemoveFile(path)
        return
    }
    directory := PackageDirectory()
    unused storage_ensure_dir(directory)
    PackageFree(directory)
    unused PackageWrite(path, "1")
}

// The practice's own copy on this device, downloaded or left by an older
// version.
PracticePackStored :: (index: s32) -> bool {
    path := PracticePackPath(index, false)
    legacy := PracticePackFile(index, PRACTICE_PACK_LEGACY_SUFFIX)
    defer {
        PackageFree(path)
        PackageFree(legacy)
    }
    return path.count > 0 && (PathExists(path) || PathExists(legacy))
}

PracticePackPresent :: (index: s32) -> bool {
    practice := practice_packs[index].practice
    base := practice_packs[index].language[0] == cast(u8)0
    // A practice that comes with the app is always on Practice.
    if base && PracticeShippedBytes(index).count > 0 {
        return true
    }
    if base && PracticeMarked(practice, ".removed") {
        return false
    }
    if PracticePackStored(index) {
        return true
    }
    if PracticeDefaultBytes(index).count > 0 {
        return true
    }
    return PracticeShippedBytes(index).count > 0 && PracticeMarked(practice, ".added")
}

PracticeCacheFileOwned :: (practice: s32, name: string) -> bool {
    content := PracticeContentName(practice)
    prefix := "practice-"
    if content.count == 0 || name.count <= prefix.count + content.count ||
    name[:prefix.count] != prefix ||
    name[prefix.count:prefix.count + content.count] != content {
        return false
    }
    rest := name[prefix.count + content.count:]
    if rest == ".zx" || rest == PRACTICE_PACK_LEGACY_SUFFIX || rest == ".download" {
        return true
    }
    if rest.count < 4 || rest[0] != cast(u8)46 ||
    rest[1] < cast(u8)97 || rest[1] > cast(u8)122 ||
    rest[2] < cast(u8)97 || rest[2] > cast(u8)122 {
        return false
    }
    tail := rest[3:]
    if tail.count > 5 && tail[:5] == ".male" {
        tail = tail[5:]
    }
    return tail == ".zx" || tail == PRACTICE_PACK_LEGACY_SUFFIX || tail == ".download" ||
    tail == ".removed"
}

PracticeCacheRemove :: (practice: s32) {
    directory := PackageDirectory()
    defer {
        PackageFree(directory)
    }
    if directory.count == 0 {
        return
    }
    cursor := OpenDirectory(directory)
    defer {
        unused CloseDirectory(*cursor)
    }
    while cursor.valid {
        entry := NextDirectoryEntry(*cursor)
        if !entry.valid {
            break
        }
        name := TextFromCString(*entry.name[0])
        if entry.kind == .Directory || !PracticeCacheFileOwned(practice, name) {
            continue
        }
        prefix := PackageText(directory, "/")
        path := PackageText(prefix, name)
        unused RemoveFile(path)
        PackageFree(prefix)
        PackageFree(path)
    }
}

PracticePackAcceptsPath :: (pack: PracticePack, path: string) -> bool {
    root := "assets/practices/"
    name := PracticeContentName(pack.practice)
    if !PackageResourceValid(path, MODULE_PRACTICE) || path.count <= root.count + name.count + 1 ||
    path[:root.count] != root || path[root.count:root.count + name.count] != name ||
    path[root.count + name.count] != cast(u8)47 {
        return false
    }
    rest := path[root.count + name.count + 1:]
    language := TextFromCString(*pack.language[0])
    if language.count == 0 {
        return (rest.count < 6 || rest[:6] != "voice/") && (rest.count < 11 || rest[:11] != "voice-male/")
    }
    directory := ifx TextFromCString(*pack.voice[0]) == "male" then "voice-male/" else "voice/"
    return rest.count > directory.count + language.count + 1 && rest[:directory.count] == directory &&
    rest[directory.count:directory.count + language.count] == language &&
    rest[directory.count + language.count] == cast(u8)47
}

// Pure validation also runs in the content worker. All strings used here
// belong to the supplied bytes or copied pack, never the current account.
PracticePackValidate :: (pack: PracticePack, bytes: string) -> *void {
    if bytes.count != pack.size || bytes.count < 8 {
        return null
    }
    descriptor := cast(*TextDescriptor)(*bytes)
    actual: [65]u8
    Sha256Hex(descriptor.data, bytes.count, *actual[0])
    if TextFromCString(*actual[0]) != TextFromCString(*pack.hash[0]) {
        return null
    }
    bundle := OpenBundleBytes(descriptor.data, cast(u64)bytes.count)
    if bundle == null {
        return null
    }
    count := BundleAssets(bundle)
    if BundleCapabilities(bundle) != cast(u64)0 || count == cast(u64)0 || count > cast(u64)10000 {
        CloseBundle(bundle)
        return null
    }
    previous: string = ""
    for asset: cast(u64)0..count - 1 {
        path := TextFromCString(BundleAssetPath(bundle, asset))
        if !PracticePackAcceptsPath(pack, path) ||
        (asset > cast(u64)0 && PackageCompare(previous, path) >= 0) {
            CloseBundle(bundle)
            return null
        }
        previous = path
    }
    return bundle
}

PracticeDownloadLog :: (index: s32, warning: bool, event: string, reason: string) {
    if practice_log == null || index < 0 || index >= practice_pack_count {
        return
    }
    pack := practice_packs[index]
    out: Vec(u8)
    BuilderPrint(*out, "PRACTICE: % pack %", event, PracticeContentName(pack.practice))
    if pack.language[0] != cast(u8)0 {
        BuilderPrint(*out, "/%", TextFromCString(*pack.language[0]))
    }
    if pack.voice[0] != cast(u8)0 {
        BuilderPrint(*out, "/%", TextFromCString(*pack.voice[0]))
    }
    if reason.count > 0 {
        BuilderPrint(*out, " after %", reason)
    }
    message := BuilderFinish(out)
    practice_log(warning, message)
    PackageFree(message)
}

// A failed grant or transfer is asked for again, with a fresh grant for a
// paid pack, before the manager shows the failure.
PracticeDownloadFailed :: (index: s32, reason: string) {
    if practice_packs[index].attempts < PracticeDownloadRetries {
        practice_packs[index].attempts += 1
        practice_packs[index].requested = true
        practice_packs[index].status = 1
        if practice_packs[index].product[0] != cast(u8)0 && practice_grant_forget != null {
            practice_grant_forget()
        }
        PracticeDownloadLog(index, true, "retrying", reason)
        return
    }
    practice_packs[index].status = 3
    PracticeDownloadLog(index, true, "failed", reason)
}

PracticeDownloadsCancel :: () {
    FileDownloadRelease(*practice_transfer)
    if practice_transfer_work != null {
        // Cancellation must not join a worker on the frame thread. Its path
        // and catalog bytes remain owned until a later nonblocking collect.
        PracticeContentWorkRetire(practice_transfer_work)
        practice_transfer_work = null
    }
    if practice_transfer_index >= 0 {
        path := PracticePackPath(practice_transfer_index, true)
        unused RemoveFile(path)
        PackageFree(path)
    }
    practice_transfer_index = -1
}

PracticeDownloadsClose :: () {
    PracticeDownloadsCancel()
    for index: cast(s32)0..practice_pack_count - 1 {
        PracticeContentWorkRetire(practice_load_work[index])
        practice_load_work[index] = null
        practice_content_used[index] = 0
        CloseBundle(practice_packs[index].bundle)
        practice_packs[index] = PracticePack.{}
    }
    practice_pack_count = 0
    PackageFree(practice_catalog)
    practice_catalog = ""
    practice_catalog_generation = 0
    practice_selected = -1
    practice_narration_selected = false
    practice_guide_narration_selected = false
    practice_catalog_invalid = false
    AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
}

PracticeCatalogParse :: (data: string, output: []PracticePack) -> s32 {
    if data.count == 0 {
        return 0
    }
    if data.count > 32768 || ValueEnd(data, 0, 0) < 0 ||
    Space(data, ValueEnd(data, 0, 0)) != cast(s32)data.count ||
    PackageNumber(data, 0, "schema") != 1 {
        return -1
    }
    packs := FieldAt(data, 0, "packs")
    count := ArrayCount(data, packs)
    if count < 5 || count > PracticePackCapacity || count > output.count {
        return -1
    }
    for index: cast(s32)0..count - 1 {
        at := ElementAt(data, packs, index)
        name_bytes: [32]u8
        name := PackageField(data, at, "practice", name_bytes[:])
        pack: PracticePack
        pack.practice = -1
        for practice: cast(s32)0..PracticeGuide - 1 {
            if name == PracticeContentName(practice) {
                pack.practice = practice
            }
        }
        language := PackageField(data, at, "language", pack.language[:])
        if language.count != 0 && !PracticeCatalogLanguage(language) {
            return -1
        }
        voice := PackageField(data, at, "voice", pack.voice[:])
        if voice.count != 0 && (voice != "male" || language.count == 0) {
            return -1
        }
        product := PackageField(data, at, "product", pack.product[:])
        // A paid pack never turns free because its product is unreadable.
        if FieldAt(data, at, "product") >= 0 && product.count == 0 {
            return -1
        }
        for byte: product {
            if !((byte >= cast(u8)97 && byte <= cast(u8)122) || byte == cast(u8)46 || byte == cast(u8)95) {
                return -1
            }
        }
        if pack.practice < 0 || !PracticeCatalogDigest(data, at, *pack) ||
        PracticeCatalogRepeats(output[:index], pack) {
            return -1
        }
        output[index] = pack
    }
    for practice: cast(s32)0..cast(s32)4 {
        found: bool = false
        for index: cast(s32)0..count - 1 {
            if output[index].practice == practice && output[index].language[0] == cast(u8)0 {
                found = true
            }
        }
        if !found {
            return -1
        }
    }
    // Lumi's guide lists one narration pack per language on its own, so
    // hosts that predate it read the practice list unchanged.
    guide := FieldAt(data, 0, "guide")
    if guide < 0 {
        return count
    }
    guide_count := ArrayCount(data, guide)
    if guide_count < 0 || count + guide_count > PracticePackCapacity || count + guide_count > output.count {
        return -1
    }
    for entry: cast(s32)0..guide_count - 1 {
        at := ElementAt(data, guide, entry)
        pack: PracticePack
        pack.practice = PracticeGuide
        language := PackageField(data, at, "language", pack.language[:])
        if !PracticeCatalogLanguage(language) || FieldAt(data, at, "voice") >= 0 ||
        FieldAt(data, at, "product") >= 0 || !PracticeCatalogDigest(data, at, *pack) ||
        PracticeCatalogRepeats(output[:count + entry], pack) {
            return -1
        }
        output[count + entry] = pack
    }
    return count + guide_count
}

PracticeCatalogLanguage :: (language: string) -> bool {
    return language.count == 2 && language[0] >= cast(u8)97 && language[0] <= cast(u8)122 &&
    language[1] >= cast(u8)97 && language[1] <= cast(u8)122
}

// Reads a pack's hash and size, which must name a bounded artifact.
PracticeCatalogDigest :: (data: string, at: s32, pack: *PracticePack) -> bool {
    hash := PackageField(data, at, "sha256", pack.hash[:])
    pack.size = PackageNumber(data, at, "size")
    if hash.count != 64 || pack.size < 8 || pack.size > PackageMaximumBytes {
        return false
    }
    for byte: hash {
        if !((byte >= cast(u8)48 && byte <= cast(u8)57) ||
            (byte >= cast(u8)97 && byte <= cast(u8)102)) {
            return false
        }
    }
    return true
}

PracticeCatalogRepeats :: (earlier: []PracticePack, pack: PracticePack) -> bool {
    for old: earlier {
        if old.practice == pack.practice &&
        TextFromCString(*old.language[0]) == TextFromCString(*pack.language[0]) &&
        TextFromCString(*old.voice[0]) == TextFromCString(*pack.voice[0]) {
            return true
        }
    }
    return false
}

PracticeCatalogValid :: (data: string) -> bool {
    packs: [PracticePackCapacity]PracticePack
    return PracticeCatalogParse(data, packs[:]) >= 0
}

PracticeCatalogLoad :: () {
    generation := AssetGeneration()
    if practice_catalog_generation == generation && practice_catalog.count > 0 {
        return
    }
    data := AssetRead("assets/practices/catalog.json").data
    if data == practice_catalog {
        practice_catalog_generation = generation
        return
    }
    packs: [PracticePackCapacity]PracticePack
    count := PracticeCatalogParse(data, packs[:])
    // Keep working resources when a replacement catalog is malformed.
    if count < 0 && practice_catalog.count > 0 && !practice_catalog_invalid {
        practice_catalog_generation = generation
        return
    }
    PracticeDownloadsClose()
    practice_catalog = PackageText(data, "")
    practice_catalog_invalid = count < 0
    if count >= 0 {
        practice_pack_count = count
        for index: cast(s32)0..count - 1 {
            practice_packs[index] = packs[index]
            practice_packs[index].present = PracticePackPresent(index)
            practice_packs[index].removed = practice_packs[index].language[0] == cast(u8)0 &&
            PracticeMarked(practice_packs[index].practice, ".removed") && !practice_packs[index].present
            declined := PracticeNarrationDeclinedPath(index)
            practice_packs[index].declined = declined.count > 0 && PathExists(declined)
            PackageFree(declined)
        }
    }
    practice_catalog_generation = AssetGeneration()
}

// The base pack for "", otherwise the language's pack in the practice's voice.
PracticePackFind :: (practice: s32, language: string) -> s32 {
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := practice_packs[index]
        if pack.practice == practice && PracticePackMatches(*pack, language, PracticeVoiceFor(practice)) {
            return index
        }
    }
    return -1
}

PracticePackMatches :: (pack: *PracticePack, language: string, voice: string) -> bool {
    return TextFromCString(*pack.language[0]) == language &&
    (language.count == 0 || TextFromCString(*pack.voice[0]) == voice)
}

// The selected practice's narration voice.
PracticeVoiceChoice :: () -> string {
    return PracticeVoiceFor(practice_selected)
}

PracticeVoiceFor :: (practice: s32) -> string {
    if practice < 0 || practice >= PracticeContentCount {
        return ""
    }
    return TextFromCString(*practice_voices[practice][0])
}

// Whether any language is recorded in this voice.
PracticeVoiceRecorded :: (practice: s32, voice: string) -> bool {
    PracticeCatalogLoad()
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := *practice_packs[index]
        if pack.practice == practice && pack.language[0] != cast(u8)0 &&
        TextFromCString(*pack.voice[0]) == voice {
            return true
        }
    }
    return false
}

// Customize picks a practice's narration voice: "" for the default voice, or "male".
PracticeVoiceSelect :: (practice: s32, voice: string) {
    if practice < 0 || practice >= PracticeContentCount {
        return
    }
    unused AppCopyText(ifx voice == "male" then voice else "", practice_voices[practice][:])
}

// Customize picks a practice's narration language; "" follows the app's.
PracticeNarrationPrefer :: (content: s32, language: string) {
    if content < 0 || content >= PracticeContentCount {
        return
    }
    unused AppCopyText(ifx PracticeCatalogLanguage(language) then language else "",
        practice_narration_choices[content][:])
}

// The language narration should speak: the one chosen in Customize, else the app's.
PracticeNarrationPreferred :: (content: s32) -> string {
    if content >= 0 && content < PracticeContentCount && practice_narration_choices[content][0] != cast(u8)0 {
        return TextFromCString(*practice_narration_choices[content][0])
    }
    return LocaleActiveCode()
}

// The narration pack of content in this language and voice, or -1.
PracticeNarrationPack :: (content: s32, language: string, voice: string) -> s32 {
    PracticeCatalogLoad()
    if language.count == 0 {
        return -1
    }
    for index: cast(s32)0..practice_pack_count - 1 {
        if practice_packs[index].practice == content &&
        PracticePackMatches(*practice_packs[index], language, voice) {
            return index
        }
    }
    return -1
}

// 0 not on this device, 1 downloading, 2 on this device, 3 failed.
PracticeNarrationState :: (index: s32) -> s32 {
    if index < 0 || index >= practice_pack_count {
        return 0
    }
    pack := *practice_packs[index]
    if pack.status == 1 || pack.status == 3 {
        return pack.status
    }
    return ifx pack.bundle != null || pack.status == 2 || pack.present then 2 else 0
}

// Narration speaks the language chosen for it when that one is on this
// device, then the app's, then another downloaded language in the app's
// language order; "" without any. Guides stay in the selected language.
PracticeNarrationLanguage :: (content: s32, voice: string) -> string {
    PracticeCatalogLoad()
    preferred := PracticeNarrationPreferred(content)
    app_language := LocaleActiveCode()
    best: s32 = -1
    best_rank: s32 = 0
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := *practice_packs[index]
        if pack.practice != content || pack.language[0] == cast(u8)0 ||
        PracticeNarrationState(index) != 2 || TextFromCString(*pack.voice[0]) != voice {
            continue
        }
        language := TextFromCString(*pack.language[0])
        if language == preferred {
            return language
        }
        rank := ifx language == app_language then -1 else PracticeLanguageRank(language)
        if best < 0 || rank < best_rank {
            best = index
            best_rank = rank
        }
    }
    if content == PracticeGuide {
        return ""
    }
    return ifx best < 0 then "" else TextFromCString(*practice_packs[best].language[0])
}

PracticeLanguageRank :: (code: string) -> s32 {
    count := LocaleLanguageCount()
    for rank: cast(s32)0..count - 1 {
        if LocaleLanguageAt(rank).code == code {
            return rank
        }
    }
    return count
}

// Downloads this narration language now and lets it download by itself again.
PracticeNarrationDownload :: (index: s32) {
    if index < 0 || index >= practice_pack_count {
        return
    }
    PracticeNarrationDeclined(index, false)
    state := PracticeNarrationState(index)
    if state == 1 || state == 2 {
        return
    }
    practice_packs[index].requested = true
    practice_packs[index].status = 1
    practice_packs[index].attempts = 0
}

// Stops or removes this narration language, which then stays off this
// device until it is downloaded again.
PracticeNarrationDecline :: (index: s32) {
    if index < 0 || index >= practice_pack_count {
        return
    }
    PracticePackRemove(index)
    PracticeNarrationDeclined(index, true)
}

PracticeNarrationDeclined :: (index: s32, declined: bool) {
    if practice_packs[index].declined == declined {
        return
    }
    practice_packs[index].declined = declined
    if DataTemporary() {
        return
    }
    path := PracticeNarrationDeclinedPath(index)
    if path.count > 0 && declined {
        directory := PackageDirectory()
        unused storage_ensure_dir(directory)
        PackageFree(directory)
        unused PackageWrite(path, "1")
    } else if path.count > 0 {
        unused RemoveFile(path)
    }
    PackageFree(path)
    sync_web_storage()
}

// The bytes of the narration that follows a practice: its pack in the language
// and voice it should speak, unless that language was removed.
PracticeNarrationFollowingBytes :: (content: s32) -> s64 {
    index := PracticeNarrationPack(content, PracticeNarrationPreferred(content), PracticeVoiceFor(content))
    return ifx index < 0 || practice_packs[index].declined then 0 else practice_packs[index].size
}

NarrationSummary :: struct {
    bytes: s64
    pending: s32
    failed: s32
}

// Available narration excludes locked practices, but can be prepared before
// adding an available practice. The download service owns catalog details.
PracticeNarrationAvailablePack :: (content: s32, language: string) -> s32 {
    if content != PracticeGuide {
        product := PracticeProduct(content)
        if product.count > 0 && (!practice_paid_allowed ||
            practice_owned == null || !practice_owned(product)) {
            return -1
        }
    }
    return PracticeNarrationPack(content, language, PracticeVoiceFor(content))
}

PracticeNarrationSummary :: (guide: bool, language: string) -> NarrationSummary {
    summary: NarrationSummary
    for content: cast(s32)0..PracticeContentCount - 1 {
        if (content == PracticeGuide) != guide {
            continue
        }
        index := PracticeNarrationAvailablePack(content, language)
        if index < 0 {
            continue
        }
        summary.bytes += practice_packs[index].size
        state := PracticeNarrationState(index)
        if state == 3 {
            summary.failed += 1
        } else if state != 2 {
            summary.pending += 1
        }
    }
    return summary
}

PracticeNarrationRequest :: (guide: bool, language: string) {
    for content: cast(s32)0..PracticeContentCount - 1 {
        if (content == PracticeGuide) != guide {
            continue
        }
        index := PracticeNarrationAvailablePack(content, language)
        if index >= 0 {
            PracticeNarrationDownload(index)
        }
    }
}

// Narration downloads by itself in the language it should speak, unless the
// person removed that language. A failed download waits for the next start.
PracticeNarrationEnsure :: (content: s32) {
    index := PracticeNarrationPack(content, PracticeNarrationPreferred(content), PracticeVoiceFor(content))
    if index < 0 {
        return
    }
    pack := *practice_packs[index]
    if pack.declined || pack.present || pack.bundle != null || pack.status != 0 {
        return
    }
    pack.requested = true
    pack.status = 1
    pack.attempts = 0
}

PracticePackCancel :: (index: s32) {
    if index < 0 || index >= practice_pack_count {
        return
    }
    if practice_transfer_index == index {
        PracticeDownloadsCancel()
    }
    PracticeContentWorkRetire(practice_load_work[index])
    practice_load_work[index] = null
    practice_packs[index].requested = false
    if practice_packs[index].status == 1 {
        practice_packs[index].status = 0
    }
}

PracticePackRemove :: (index: s32) {
    if index < 0 || index >= practice_pack_count {
        return
    }
    PracticePackCancel(index)
    CloseBundle(practice_packs[index].bundle)
    practice_packs[index].bundle = null
    practice_packs[index].status = 0
    practice_packs[index].checked = true
    practice_packs[index].cache_checked = true
    practice_packs[index].present = false
    if !DataTemporary() {
        path := PracticePackPath(index, false)
        if path.count > 0 {
            unused RemoveFile(path)
        }
        PackageFree(path)
        sync_web_storage()
    }
    AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
}

PracticeContentReady :: (practice: s32) -> bool {
    index := PracticePackFind(practice, "")
    // Older signed packages remain usable with their bundled assets.
    return !practice_catalog_invalid && (practice_catalog.count == 0 ||
        (index >= 0 && practice_packs[index].bundle != null &&
        PracticePackWanted(*practice_packs[index])))
}

PracticeProduct :: (practice: s32) -> string {
    PracticeCatalogLoad()
    index := PracticePackFind(practice, "")
    return ifx index < 0 then "" else TextFromCString(*practice_packs[index].product[0])
}

PracticeHidden :: (practice: s32) -> bool {
    return !practice_paid_allowed && PracticeProduct(practice).count > 0
}

// Practice's home offers only installed practices.
PracticeInstalled :: (practice: s32) -> bool {
    PracticeCatalogLoad()
    if practice_catalog_invalid || PracticeHidden(practice) {
        return false
    }
    // Older signed packages carry every practice's assets.
    if practice_catalog.count == 0 {
        return true
    }
    product := PracticeProduct(practice)
    if product.count > 0 && (practice_owned == null || !practice_owned(product)) {
        return false
    }
    index := PracticePackFind(practice, "")
    if index < 0 || practice_packs[index].removed {
        return false
    }
    return practice_packs[index].bundle != null || practice_packs[index].status == 2 ||
    practice_packs[index].present
}

PracticeContentStatus :: (practice: s32) -> s32 {
    if practice_catalog_invalid {
        return 3
    }
    index := PracticePackFind(practice, "")
    return ifx index < 0 then 0 else practice_packs[index].status
}

PracticeContentBytes :: (practice: s32) -> s64 {
    index := PracticePackFind(practice, "")
    return ifx index < 0 then 0 else practice_packs[index].size
}

// Downloads or adds a practice. Its narration follows on its own.
PracticeContentRequest :: (practice: s32) {
    base := PracticePackFind(practice, "")
    if base < 0 {
        return
    }
    pack := *practice_packs[base]
    // A copy on this device or in the app puts the practice back without a
    // download. The app's copy needs no copy of its own.
    if pack.removed || !pack.present {
        pack.removed = false
        PracticeMark(practice, ".removed", false)
        // Only a copy already verified on this device is kept; anything else
        // downloads again.
        stored := pack.status == 2 && PracticePackStored(base)
        shipped := PracticeShippedBytes(base).count > 0
        if stored || shipped {
            if !stored && PracticeDefaultBytes(base).count == 0 {
                PracticeMark(practice, ".added", true)
            }
            pack.present = true
            pack.status = 2
            pack.checked = false
            pack.cache_checked = true
            AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
        }
        if !DataTemporary() {
            sync_web_storage()
        }
    }
    if pack.bundle == null && pack.status != 1 && pack.status != 2 {
        pack.requested = true
        pack.status = 1
        pack.attempts = 0
    }
}

// Takes a practice off Practice. A downloaded copy and its narration stay on
// this device, so adding it back needs no download. A practice that comes
// with the app always stays.
PracticeContentHide :: (practice: s32) {
    base := PracticePackFind(practice, "")
    if base < 0 || PracticeShippedBytes(base).count > 0 {
        return
    }
    for index: cast(s32)0..practice_pack_count - 1 {
        if practice_packs[index].practice != practice {
            continue
        }
        PracticePackCancel(index)
        CloseBundle(practice_packs[index].bundle)
        practice_packs[index].bundle = null
    }
    pack := *practice_packs[base]
    pack.removed = true
    pack.present = false
    pack.checked = true
    pack.cache_checked = true
    PracticeMark(practice, ".removed", true)
    PracticeMark(practice, ".added", false)
    shipped := PracticeShippedBytes(base)
    if shipped.count > 0 && !DataTemporary() {
        // Older versions copied a practice that ships with the app when it
        // was added; the app's own copy is enough.
        path := PracticePackPath(base, false)
        stored := PackageRead(path, PackageMaximumBytes)
        if stored.count > 0 && stored == shipped {
            unused RemoveFile(path)
        }
        PackageFree(stored)
        PackageFree(path)
    }
    if shipped.count > 0 && !PracticePackStored(base) {
        pack.status = 0
    }
    if !DataTemporary() {
        sync_web_storage()
    }
    AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
}

// A copy that no longer opens, as one from before an update changed the
// pack, keeps its practice installed while the pack downloads again. A
// removed practice, a failed download or a temporary profile stays as it is.
PracticePackRefresh :: (index: s32) -> bool {
    pack := *practice_packs[index]
    if DataTemporary() || pack.removed || pack.status == 1 || pack.status == 3 ||
    !PracticePackStored(index) {
        return false
    }
    pack.requested = true
    pack.status = 1
    pack.attempts = 0
    pack.present = true
    PracticeDownloadLog(index, false, "updating", "")
    return true
}

// Review one cache slot without blocking the manager while it reads/hashes.
PracticeContentReviewNext :: () {
    PracticeContentWorkCollect()
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := *practice_packs[index]
        if pack.cache_checked || pack.status == 1 {
            continue
        }
        if pack.bundle != null {
            pack.cache_checked = true
            continue
        }
        if !PracticeContentLoadStart(index) || !PracticeContentWorkReady(practice_load_work[index]) {
            return
        }
        work := practice_load_work[index]
        bundle := work.bundle
        work.bundle = null
        PracticeContentWorkFree(work)
        practice_load_work[index] = null
        pack.cache_checked = true
        refreshed := bundle == null && PracticePackRefresh(index)
        if bundle != null {
            pack.status = 2
        } else if !refreshed && pack.status == 2 {
            pack.status = 0
        }
        // A removed practice's copy stays on this device but off Practice.
        if !refreshed {
            pack.present = bundle != null && !pack.removed
        }
        if bundle != null && !pack.removed {
            pack.bundle = bundle
            practice_content_clock += 1
            practice_content_used[index] = practice_content_clock
            if PracticePackWanted(pack) {
                AssetNotifyAvailable()
            }
        } else {
            CloseBundle(bundle)
        }
        PracticeContentTrim()
        return
    }
}

PracticePackReviewed :: (practice: s32, language: string) -> bool {
    index := PracticePackFind(practice, language)
    return index < 0 || practice_packs[index].cache_checked
}

PracticeContentCancel :: (practice: s32) {
    for index: cast(s32)0..practice_pack_count - 1 {
        if practice_packs[index].practice == practice {
            PracticePackCancel(index)
        }
    }
}

PracticeContentRemove :: (practice: s32) {
    for index: cast(s32)0..practice_pack_count - 1 {
        if practice_packs[index].practice != practice {
            continue
        }
        PracticePackCancel(index)
        CloseBundle(practice_packs[index].bundle)
        practice_packs[index].bundle = null
        practice_packs[index].requested = false
        practice_packs[index].status = 0
        practice_packs[index].checked = true
        practice_packs[index].cache_checked = true
        practice_packs[index].present = false
        practice_packs[index].removed = false
        // Adding the practice again brings its narration back by itself.
        practice_packs[index].declined = false
    }
    // Include languages retired from a newer catalog, without touching progress.
    if !DataTemporary() {
        PracticeCacheRemove(practice)
        base := PracticePackFind(practice, "")
        // A practice that comes with the app stays on Practice with the
        // app's own copy; others can download again.
        PracticeMark(practice, ".removed", false)
        PracticeMark(practice, ".added", false)
        if base >= 0 && PracticeShippedBytes(base).count > 0 {
            practice_packs[base].present = true
        }
        sync_web_storage()
    }
    AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
}

PracticeDownloadsAsset :: (path: string) -> AssetView {
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := practice_packs[index]
        if pack.bundle == null || !PracticePackWanted(*practice_packs[index]) ||
        !PracticePackAcceptsPath(pack, path) {
            continue
        }
        count := BundleAssets(pack.bundle)
        // The resource table is sorted; avoid scanning thousands of frames.
        low: u64 = 0
        high := count
        while low < high {
            middle := low + (high - low) / 2
            order := PackageCompare(path, TextFromCString(BundleAssetPath(pack.bundle, middle)))
            if order < 0 {
                high = middle
            } else if order > 0 {
                low = middle + 1
            } else {
                return AssetView.{.found = true, .data = TextFromBytes(BytesFromPointer(
                        BundleAssetBytes(pack.bundle, middle), BundleAssetLength(pack.bundle, middle)))}
            }
        }
    }
    return AssetView.{}
}

// Whether a pack is mounted now: the selected practice's base pack, the
// narration it speaks, and the narration Lumi's guide speaks.
PracticePackWanted :: (pack: *PracticePack) -> bool {
    if pack.language[0] == cast(u8)0 {
        return pack.practice == practice_selected
    }
    language := TextFromCString(*pack.language[0])
    voice := TextFromCString(*pack.voice[0])
    if pack.practice == PracticeGuide {
        return practice_guide_narration_selected && voice.count == 0 &&
        language == TextFromCString(*practice_guide_language[0])
    }
    if !practice_narration_selected {
        return false
    }
    return pack.practice == practice_selected && voice == TextFromCString(*practice_voice_selected[0]) &&
    language == TextFromCString(*practice_narration_language[0])
}

PracticeDownloadsPump :: (selected: s32, narration: bool, guide_narration: bool, idle: bool) {
    PracticeContentWorkCollect()
    // Never replace borrowed animation/course/audio data during a session.
    if !idle {
        // Voice packs contain no borrowed practice animation or course data.
        // Let their pending transfer finish after Start instead of leaving
        // the session silent until the person exits it.
        PracticeTransfersPump(true)
        return
    }
    PracticeCatalogLoad()
    if practice_catalog.count == 0 || practice_catalog_invalid {
        return
    }
    voice := PracticeVoiceFor(selected)
    spoken := PracticeNarrationLanguage(selected, voice)
    guide_spoken := PracticeNarrationLanguage(PracticeGuide, "")
    changed := selected != practice_selected || narration != practice_narration_selected ||
    guide_narration != practice_guide_narration_selected ||
    voice != TextFromCString(*practice_voice_selected[0]) ||
    spoken != TextFromCString(*practice_narration_language[0]) ||
    guide_spoken != TextFromCString(*practice_guide_language[0])
    if changed {
        practice_selected = selected
        practice_narration_selected = narration
        practice_guide_narration_selected = guide_narration
        unused AppCopyText(voice, practice_voice_selected[:])
        unused AppCopyText(spoken, practice_narration_language[:])
        unused AppCopyText(guide_spoken, practice_guide_language[:])
        // Recent content stays in memory within a budget. Temporary data
        // still keeps only the practice shown. A download continues regardless.
        for index: cast(s32)0..practice_pack_count - 1 {
            pack := *practice_packs[index]
            if PracticePackWanted(pack) {
                pack.checked = false
                practice_content_clock += 1
                practice_content_used[index] = practice_content_clock
                continue
            }
            PracticeContentWorkRetire(practice_load_work[index])
            practice_load_work[index] = null
            if DataTemporary() {
                if practice_transfer_index == index {
                    PracticeDownloadsCancel()
                }
                pack.requested = false
                if pack.status == 1 {
                    pack.status = 0
                }
            }
            if pack.bundle != null && DataTemporary() {
                CloseBundle(pack.bundle)
                pack.bundle = null
                pack.status = 0
                pack.cache_checked = false
                AssetNotifyAvailable()
            }
        }
    }
    // Narration follows each practice on this device; with temporary data
    // only the practice shown keeps what it downloads.
    if narration {
        for content: cast(s32)0..PracticeContentCount - 1 {
            if content != PracticeGuide && PracticeInstalled(content) &&
            (!DataTemporary() || content == selected) {
                PracticeNarrationEnsure(content)
            }
        }
    }
    if guide_narration {
        PracticeNarrationEnsure(PracticeGuide)
    }
    for index: cast(s32)0..practice_pack_count - 1 {
        pack := *practice_packs[index]
        if !PracticePackWanted(pack) || pack.checked {
            continue
        }
        // A removed practice is not mounted; the manager still reviews its copy.
        if pack.removed {
            continue
        }
        pack.cache_checked = true
        if pack.bundle != null {
            pack.checked = true
            continue
        }
        if !PracticeContentLoadStart(index) {
            continue
        }
        work := practice_load_work[index]
        if !PracticeContentWorkReady(work) {
            continue
        }
        pack.bundle = work.bundle
        work.bundle = null
        PracticeContentWorkFree(work)
        practice_load_work[index] = null
        pack.checked = true
        if pack.bundle != null {
            pack.status = 2
            AssetNotifyAvailable()
        } else if !PracticePackRefresh(index) && pack.status == 2 {
            pack.status = 0
        }
        if pack.status != 1 {
            pack.present = pack.bundle != null
        }
    }
    PracticeTransfersPump(false)
    PracticeContentTrim()
}

PracticeTransfersPump :: (narration_only: bool) {
    if narration_only && practice_transfer_index >= 0 &&
    practice_packs[practice_transfer_index].language[0] == cast(u8)0 {
        return
    }
    if practice_transfer_index < 0 {
        for index: cast(s32)0..practice_pack_count - 1 {
            if !practice_packs[index].requested {
                continue
            }
            if narration_only && practice_packs[index].language[0] == cast(u8)0 {
                continue
            }
            practice_packs[index].requested = false
            if practice_packs[index].bundle != null {
                practice_packs[index].status = 2
                continue
            }
            // A paid pack waits for its grant, which joins its path.
            grant: [512]u8
            product := TextFromCString(*practice_packs[index].product[0])
            if product.count > 0 {
                granted: s32 = -1
                if practice_paid_allowed && practice_grant != null {
                    granted = practice_grant(product, grant[:])
                }
                if granted == 0 {
                    practice_packs[index].requested = true
                    return
                }
                if granted < 0 {
                    PracticeDownloadFailed(index, "no grant")
                    continue
                }
            }
            practice_transfer_index = index
            directory := PackageDirectory()
            unused storage_ensure_dir(directory)
            PackageFree(directory)
            path := PracticePackPath(index, true)
            route := PackageText("https://api.waozi.xyz/api/v2/packages/inbe.practices/",
                TextFromCString(*practice_packs[index].hash[0]))
            file := PackageText(route, ".zx")
            separator := PackageText(file, ifx product.count > 0 then "/" else "")
            url := PackageText(separator, TextFromCString(*grant[0]))
            PackageFree(file)
            PackageFree(separator)
            practice_transfer = FileDownload.{}
            practice_transfer.maximum_bytes = cast(u64)practice_packs[index].size
            started := FileDownloadStart(*practice_transfer, url, path)
            PackageFree(path)
            PackageFree(route)
            PackageFree(url)
            if started {
                PracticeDownloadLog(index, false, "downloading", "")
            } else {
                PracticeDownloadsCancel()
                PracticeDownloadFailed(index, "no transfer")
            }
            return
        }
        return
    }
    state := FileDownloadPoll(*practice_transfer)
    if state != FileDownloadStatus.Ready && state != FileDownloadStatus.Error {
        return
    }
    index := practice_transfer_index
    temporary := PracticePackPath(index, true)
    destination := PracticePackPath(index, false)
    if state == FileDownloadStatus.Ready && practice_transfer_work == null {
        if practice_content_jobs > 0 {
            PackageFree(temporary)
            PackageFree(destination)
            return
        }
        practice_transfer_work = PracticeContentWorkStart(practice_packs[index], temporary)
        if practice_transfer_work != null {
            PackageFree(temporary)
            PackageFree(destination)
            return
        }
    }
    if practice_transfer_work != null && !PracticeContentWorkReady(practice_transfer_work) {
        PackageFree(temporary)
        PackageFree(destination)
        return
    }
    bundle: *void
    if practice_transfer_work != null {
        bundle = practice_transfer_work.bundle
        practice_transfer_work.bundle = null
        PracticeContentWorkFree(practice_transfer_work)
        practice_transfer_work = null
    }
    if bundle != null && (DataTemporary() || RenamePath(temporary, destination)) {
        CloseBundle(practice_packs[index].bundle)
        practice_packs[index].bundle = bundle
        practice_content_clock += 1
        practice_content_used[index] = practice_content_clock
        AssetNotifyChangedUnder(PRACTICE_ASSET_FOLDER)
        practice_packs[index].status = 2
        practice_packs[index].cache_checked = true
        practice_packs[index].present = true
        practice_packs[index].attempts = 0
        PracticeDownloadLog(index, false, "installed", "")
        if !DataTemporary() {
            PracticePackLegacyRemove(index)
            sync_web_storage()
        }
    } else {
        CloseBundle(bundle)
        PackageFree(temporary)
        PackageFree(destination)
        PracticeDownloadsCancel()
        PracticeDownloadFailed(index, ifx state == FileDownloadStatus.Ready then "an unverified file" else "a transfer error")
        return
    }
    PackageFree(temporary)
    PackageFree(destination)
    PracticeDownloadsCancel()
}
