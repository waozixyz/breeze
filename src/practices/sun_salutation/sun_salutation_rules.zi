
SUN_SALUTATION_STEP_COUNT :: 12
SUN_SALUTATION_POSE_COUNT :: SUN_SALUTATION_STEP_COUNT
// The woman (Jade bun) and the man (Indigo crop).
SUN_SALUTATION_CHARACTER_COUNT :: 2
SUN_SALUTATION_MAN :: 1
// The move into a pose fills most of the breath that carries it: three
// quarters of the breath, and at most this long.
SUN_SALUTATION_TRANSITION_SECONDS :: 6
// The tempo is the length of one breath, in or out.
SUN_SALUTATION_SECONDS_MIN :: 3
SUN_SALUTATION_SECONDS_MAX :: 12
SUN_SALUTATION_DEFAULT_REPETITIONS :: 3
SUN_SALUTATION_DEFAULT_START_SECONDS :: 8
SUN_SALUTATION_DEFAULT_END_SECONDS :: 6
SUN_SALUTATION_TEMPO_VERSION :: 2

// Breathing. Each pose of the classic sequence is reached on one breath,
// in and out in turn: out in Mountain pose, in to the upward salute, out to
// the fold, in to the lunge with one knee down, out to step back into plank
// and in while holding it, out to lower the knees, chest and chin, in to
// cobra, out to downward dog, in to the lunge with the other knee down, out
// to the fold, in to the upward salute and out back to Mountain pose.
// Only the first round starts in Mountain pose; the next rounds begin with
// the upward salute, so the breath never repeats in a row.
SUN_SALUTATION_BREATH_OUT :: 0
SUN_SALUTATION_BREATH_IN :: 1
SUN_SALUTATION_PLANK_STEP :: 4
SUN_SALUTATION_REPEAT_STEP :: 1

// The guide around the rounds: settling in before the first round, the
// rounds, a rest after the last one, and then the results.
SUN_SALUTATION_PHASE_INTRO :: 0
SUN_SALUTATION_PHASE_ROUNDS :: 1
SUN_SALUTATION_PHASE_CLOSING :: 2
SUN_SALUTATION_PHASE_DONE :: 3
// Settling in takes three breaths, in, out and in, so Mountain pose's
// out-breath follows; the rest after the last round takes two, in and out.
SUN_SALUTATION_INTRO_BREATHS :: 3
SUN_SALUTATION_CLOSING_BREATHS :: 2
// The first round never breathes faster than this, so every pose's spoken
// line plays in full while the movements are new.
SUN_SALUTATION_FIRST_ROUND_SECONDS :: 6
// Which leg is back in a lunge.
SUN_SALUTATION_SIDE_NONE :: 0
SUN_SALUTATION_SIDE_RIGHT :: 1
SUN_SALUTATION_SIDE_LEFT :: 2
SUN_SALUTATION_LUNGE_STEP :: 3
SUN_SALUTATION_RETURN_LUNGE_STEP :: 8

SalutationBreath :: struct {
    // SUN_SALUTATION_BREATH_IN or SUN_SALUTATION_BREATH_OUT.
    direction: s32
    // How far the breath has gone, 0 to 1000.
    progress: s32
}

SunSalutationPracticeState :: struct {
    character: s32
    step: s32
    repetition: s32
    repetitions: s32
    start_seconds: s32
    end_seconds: s32
    step_ticks: s32
    tick_fraction: float64
}

// The classic sequence switches legs each round: in every other round the
// other leg steps back first and the other knee goes down.
SalutationOtherSide :: (state: SunSalutationPracticeState) -> bool {
    return state.repetition % 2 == 1
}

SalutationStepResult :: struct {
    state: SunSalutationPracticeState
    completed: s32
}

SalutationClamp :: (value: s32, low: s32,
    high: s32) -> s32 {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}

#program_export
SalutationNormalizeSettings :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    state.character = SalutationClamp(state.character, 0,
        SUN_SALUTATION_CHARACTER_COUNT - 1)
    state.repetitions = SalutationClamp(state.repetitions, 2, 12)
    state.start_seconds = SalutationClamp(state.start_seconds,
        SUN_SALUTATION_SECONDS_MIN, SUN_SALUTATION_SECONDS_MAX)
    state.end_seconds = SalutationClamp(state.end_seconds,
        SUN_SALUTATION_SECONDS_MIN, SUN_SALUTATION_SECONDS_MAX)
    if state.start_seconds < state.end_seconds {
        state.end_seconds = state.start_seconds
    }
    return state
}

#program_export
SalutationInit :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    if state.repetitions < 2 || state.repetitions > 12 {
        state.repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if state.start_seconds < SUN_SALUTATION_SECONDS_MIN  || state.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if state.end_seconds < SUN_SALUTATION_SECONDS_MIN  || state.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    return SalutationNormalizeSettings(state)
}

// Move an unchanged earlier default to the gentler tempo once. Other saved
// choices, including a fast tempo selected after this update, remain intact.
#program_export
SalutationMigrateTempo :: (state: SunSalutationPracticeState,
    version: s32) -> SunSalutationPracticeState {
    legacy_default := version == 0 && state.start_seconds == 8 && state.end_seconds == 5
    previous_default := version < SUN_SALUTATION_TEMPO_VERSION &&
    state.start_seconds == 6 && state.end_seconds == 4
    if legacy_default || previous_default {
        state.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
        state.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    return state
}

#program_export
SalutationStart :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    state.character = SalutationClamp(state.character, 0,
        SUN_SALUTATION_CHARACTER_COUNT - 1)
    state.step = 0
    state.repetition = 0
    if state.repetitions < 2 || state.repetitions > 12 {
        state.repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if state.start_seconds < SUN_SALUTATION_SECONDS_MIN  || state.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if state.end_seconds < SUN_SALUTATION_SECONDS_MIN  || state.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if state.start_seconds < state.end_seconds {
        state.end_seconds = state.start_seconds
    }
    state.step_ticks = 0
    state.tick_fraction = 0.0
    return state
}

#program_export
SalutationReset :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    state.step = 0
    state.repetition = 0
    state.step_ticks = 0
    state.tick_fraction = 0.0
    return state
}

#program_export
SalutationNormalizeDraw :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    state.character = SalutationClamp(state.character, 0,
        SUN_SALUTATION_CHARACTER_COUNT - 1)
    if state.repetitions < 2 || state.repetitions > 12 {
        state.repetitions = SUN_SALUTATION_DEFAULT_REPETITIONS
    }
    if state.start_seconds < SUN_SALUTATION_SECONDS_MIN  || state.start_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if state.end_seconds < SUN_SALUTATION_SECONDS_MIN  || state.end_seconds > SUN_SALUTATION_SECONDS_MAX {
        state.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if state.start_seconds < state.end_seconds {
        state.end_seconds = state.start_seconds
    }
    state.step = SalutationClamp(state.step, 0,
        SUN_SALUTATION_STEP_COUNT - 1)
    state.repetition = SalutationClamp(state.repetition, 0,
        state.repetitions - 1)
    if state.repetition > 0 && state.step < SUN_SALUTATION_REPEAT_STEP {
        state.step = SUN_SALUTATION_REPEAT_STEP
    }
    return state
}

// How many breaths a step takes: plank has one to step back and one to
// hold it, every other pose one.
#program_export
SalutationStepBreaths :: (step: s32) -> s32 {
    if step == SUN_SALUTATION_PLANK_STEP {
        return 2
    }
    return 1
}

// Whether the `breath`th breath of `step` (from 0) breathes in or out.
#assert SUN_SALUTATION_STEP_COUNT == 12
#program_export
SalutationBreathDirection :: (step: s32, breath: s32) -> s32 {
    directions: [12]s32 = .[
    SUN_SALUTATION_BREATH_OUT, SUN_SALUTATION_BREATH_IN,
    SUN_SALUTATION_BREATH_OUT, SUN_SALUTATION_BREATH_IN,
    SUN_SALUTATION_BREATH_OUT, SUN_SALUTATION_BREATH_OUT,
    SUN_SALUTATION_BREATH_IN, SUN_SALUTATION_BREATH_OUT,
    SUN_SALUTATION_BREATH_IN, SUN_SALUTATION_BREATH_OUT,
    SUN_SALUTATION_BREATH_IN, SUN_SALUTATION_BREATH_OUT
    ]
    step = SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    if step == SUN_SALUTATION_PLANK_STEP && breath >= 1 {
        return SUN_SALUTATION_BREATH_IN
    }
    return directions[step]
}

// The man speaks with the male voice unless another is chosen: `voice` 0
// the default voice, 1 male, -1 the character's own.
SalutationMaleVoice :: (voice: s32, character: s32) -> bool {
    if voice >= 0 {
        return voice == 1
    }
    return character == SUN_SALUTATION_MAN
}

// The length of one breath in the current round: the start tempo in the
// first round, moving evenly to the end tempo in the last. The first round
// is never quicker than SUN_SALUTATION_FIRST_ROUND_SECONDS.
#program_export
SalutationBreathSeconds :: (state: SunSalutationPracticeState) -> s32 {
    start_seconds: s32 = state.start_seconds
    end_seconds: s32 = state.end_seconds
    repetitions: s32 = state.repetitions
    repetition: s32 = state.repetition
    if start_seconds < SUN_SALUTATION_SECONDS_MIN  || start_seconds > SUN_SALUTATION_SECONDS_MAX {
        start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    }
    if end_seconds < SUN_SALUTATION_SECONDS_MIN  || end_seconds > SUN_SALUTATION_SECONDS_MAX {
        end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    }
    if start_seconds < end_seconds {
        end_seconds = start_seconds
    }
    if repetition <= 0 && start_seconds < SUN_SALUTATION_FIRST_ROUND_SECONDS {
        return SUN_SALUTATION_FIRST_ROUND_SECONDS
    }
    if repetitions < 2 {
        return start_seconds
    }
    repetition = SalutationClamp(repetition, 0, repetitions - 1)
    return start_seconds + ((end_seconds - start_seconds) * repetition) /
    (repetitions - 1)
}

// How long the current step lasts: one breath, two for plank.
#program_export
SalutationStepSeconds :: (state: SunSalutationPracticeState) -> s32 {
    return SalutationBreathSeconds(state) * SalutationStepBreaths(state.step)
}

// Match actual playback: the first round has Mountain pose and thirteen
// breaths; later rounds start with the upward salute and have twelve.
#program_export
SalutationDurationSeconds :: (state: SunSalutationPracticeState) -> s32 {
    state = SalutationInit(state)
    total: s32 = 0
    for repetition: 0..state.repetitions - 1 {
        state.repetition = cast(s32)repetition
        first_step := ifx repetition == 0 then 0 else SUN_SALUTATION_REPEAT_STEP
        for step: first_step..SUN_SALUTATION_STEP_COUNT - 1 {
            state.step = cast(s32)step
            total += SalutationStepSeconds(state)
        }
    }
    return total
}

// The breath being taken `state.step_ticks` into the current step.
#program_export
SalutationBreathAt :: (state: SunSalutationPracticeState) -> SalutationBreath {
    result: SalutationBreath
    breath_ticks := SalutationBreathSeconds(state) * 60
    if breath_ticks < 1 {
        breath_ticks = 1
    }
    ticks := state.step_ticks
    if ticks < 0 {
        ticks = 0
    }
    breath := ticks / breath_ticks
    last := SalutationStepBreaths(state.step) - 1
    if breath > last {
        breath = last
    }
    result.direction = SalutationBreathDirection(state.step, breath)
    result.progress = ((ticks - breath * breath_ticks) * 1000) / breath_ticks
    if result.progress > 1000 {
        result.progress = 1000
    }
    return result
}

#program_export
SalutationForward :: (state: SunSalutationPracticeState) -> SalutationStepResult {
    result: SalutationStepResult
    result.state = state
    result.state.step_ticks = 0
    result.state.tick_fraction = 0.0
    if state.step >= SUN_SALUTATION_STEP_COUNT - 1 {
        if state.repetition >= state.repetitions - 1 {
            result.completed = 1
        } else {
            // The round ended in Mountain pose; the next one rises from it.
            result.state.repetition += 1
            result.state.step = SUN_SALUTATION_REPEAT_STEP
        }
    } else {
        result.state.step += 1
    }
    return result
}

#program_export
SalutationBack :: (state: SunSalutationPracticeState) -> SunSalutationPracticeState {
    state.step_ticks = 0
    state.tick_fraction = 0.0
    first_step: s32 = 0
    if state.repetition > 0 {
        first_step = SUN_SALUTATION_REPEAT_STEP
    }
    if state.step > first_step {
        state.step -= 1
    } else if state.repetition > 0 {
        state.repetition -= 1
        state.step = SUN_SALUTATION_STEP_COUNT - 1
    }
    return state
}

#program_export
SalutationAdvance :: (state: SunSalutationPracticeState,
    elapsed_seconds: float64) -> SalutationStepResult {
    result: SalutationStepResult
    result.state = state
    if !(elapsed_seconds > 0.0) {
        return result
    }
    // Even a full day away cannot exceed the longest possible session.
    maximum_seconds := SUN_SALUTATION_SECONDS_MAX * SUN_SALUTATION_STEP_COUNT * 12
    if elapsed_seconds > cast(float64)maximum_seconds {
        elapsed_seconds = cast(float64)maximum_seconds
    }
    ticks := state.tick_fraction + elapsed_seconds * 60.0
    // Retain sub-tick time at any display rate, including 90/120 Hz.
    remaining := cast(s32)(ticks + 0.000000001)
    fraction := ticks - cast(float64)remaining
    if fraction < 0.0 {
        fraction = 0.0
    }
    while remaining > 0 {
        needed := SalutationStepSeconds(result.state) * 60 - result.state.step_ticks
        if remaining < needed {
            result.state.step_ticks += remaining
            break
        }
        remaining -= needed
        result = SalutationForward(result.state)
        if result.completed != 0 {
            return result
        }
    }
    result.state.tick_fraction = fraction
    return result
}

// The frame to show `step_ticks` into a step whose first breath lasts
// `breath_ticks` and whose animation has `frame_count` frames: the move
// into the pose (`transition_frames`) over three quarters of that breath,
// then the first moments of the hold at `frames_per_second`, whose last
// frame stays. Frames count from the step's first one; -1 is the previous
// step's held pose.
#program_export
SalutationFrameAt :: (step_ticks: s32, breath_ticks: s32,
    frame_count: s32, transition_frames: s32,
    frames_per_second: s32) -> s32 {
    if frame_count <= 1 || transition_frames <= 0 {
        return 0
    }
    if transition_frames > frame_count {
        transition_frames = frame_count
    }
    transition_ticks: s32 = SUN_SALUTATION_TRANSITION_SECONDS * 60
    if transition_ticks > breath_ticks * 3 / 4 {
        transition_ticks = breath_ticks * 3 / 4
    }
    if transition_ticks < 1 {
        transition_ticks = 1
    }
    if step_ticks < 0 {
        step_ticks = 0
    }
    frame: s32 = step_ticks * transition_frames / transition_ticks - 1
    if step_ticks >= transition_ticks {
        frame = transition_frames - 1 +
        (step_ticks - transition_ticks) * frames_per_second / 60
    }
    if frame > frame_count - 1 {
        frame = frame_count - 1
    }
    return frame
}

SalutationGuide :: struct {
    // SUN_SALUTATION_PHASE_INTRO to SUN_SALUTATION_PHASE_DONE.
    phase: s32
    // Time into the intro or the rest.
    ticks: s32
    tick_fraction: float64
}

SalutationGuideStep :: struct {
    guide: SalutationGuide
    // Seconds left over after the intro ends, for the first round.
    remaining: float64
}

// The intro and the rest breathe at the first round's gentle tempo.
#program_export
SalutationGuideBreathSeconds :: (state: SunSalutationPracticeState) -> s32 {
    state.repetition = 0
    return SalutationBreathSeconds(state)
}

#program_export
SalutationGuideBreaths :: (phase: s32) -> s32 {
    if phase == SUN_SALUTATION_PHASE_INTRO {
        return SUN_SALUTATION_INTRO_BREATHS
    }
    if phase == SUN_SALUTATION_PHASE_CLOSING {
        return SUN_SALUTATION_CLOSING_BREATHS
    }
    return 0
}

// Which breath of the intro or the rest is taken now, from 0.
#program_export
SalutationGuideBreathIndex :: (guide: SalutationGuide,
    state: SunSalutationPracticeState) -> s32 {
    breath_ticks := SalutationGuideBreathSeconds(state) * 60
    if breath_ticks < 1 {
        breath_ticks = 1
    }
    ticks := guide.ticks
    if ticks < 0 {
        ticks = 0
    }
    breath := ticks / breath_ticks
    last := SalutationGuideBreaths(guide.phase) - 1
    if last < 0 {
        last = 0
    }
    if breath > last {
        breath = last
    }
    return breath
}

// The breath taken now in the intro or the rest: both start with a breath
// in and turn on every breath.
#program_export
SalutationGuideBreathAt :: (guide: SalutationGuide,
    state: SunSalutationPracticeState) -> SalutationBreath {
    result: SalutationBreath
    breath_ticks := SalutationGuideBreathSeconds(state) * 60
    if breath_ticks < 1 {
        breath_ticks = 1
    }
    ticks := guide.ticks
    if ticks < 0 {
        ticks = 0
    }
    breath := SalutationGuideBreathIndex(guide, state)
    result.direction = SUN_SALUTATION_BREATH_IN
    if breath % 2 == 1 {
        result.direction = SUN_SALUTATION_BREATH_OUT
    }
    result.progress = ((ticks - breath * breath_ticks) * 1000) / breath_ticks
    if result.progress > 1000 {
        result.progress = 1000
    }
    return result
}

// Keeps the guide in step with the rounds: only a session at its very
// start settles in, and the rest follows only the last round's Mountain
// pose, so a session entered any other way goes on with its rounds.
#program_export
SalutationGuideFor :: (guide: SalutationGuide,
    state: SunSalutationPracticeState) -> SalutationGuide {
    fresh := state.step == 0 && state.repetition == 0 && state.step_ticks == 0
    last := state.step == SUN_SALUTATION_STEP_COUNT - 1 &&
    state.repetition >= state.repetitions - 1
    if guide.phase == SUN_SALUTATION_PHASE_INTRO && !fresh {
        return SalutationGuide.{.phase = SUN_SALUTATION_PHASE_ROUNDS}
    }
    if (guide.phase == SUN_SALUTATION_PHASE_CLOSING ||
        guide.phase == SUN_SALUTATION_PHASE_DONE) && !last {
        return SalutationGuide.{.phase = SUN_SALUTATION_PHASE_ROUNDS}
    }
    if guide.phase < SUN_SALUTATION_PHASE_INTRO || guide.phase > SUN_SALUTATION_PHASE_DONE {
        return SalutationGuide.{.phase = SUN_SALUTATION_PHASE_ROUNDS}
    }
    return guide
}

// The phase after this one: the intro gives way to the rounds, the rounds
// to the rest and the rest to the results.
#program_export
SalutationGuideNext :: (guide: SalutationGuide) -> SalutationGuide {
    next: SalutationGuide
    next.phase = SUN_SALUTATION_PHASE_DONE
    if guide.phase == SUN_SALUTATION_PHASE_INTRO {
        next.phase = SUN_SALUTATION_PHASE_ROUNDS
    } else if guide.phase == SUN_SALUTATION_PHASE_ROUNDS {
        next.phase = SUN_SALUTATION_PHASE_CLOSING
    }
    return next
}

// Moves the intro or the rest on by `elapsed_seconds`. Time past the end of
// the intro is handed on to the first round; during the rounds all of it is.
#program_export
SalutationGuideAdvance :: (guide: SalutationGuide,
    state: SunSalutationPracticeState, elapsed_seconds: float64) -> SalutationGuideStep {
    result: SalutationGuideStep
    result.guide = guide
    if guide.phase != SUN_SALUTATION_PHASE_INTRO &&
    guide.phase != SUN_SALUTATION_PHASE_CLOSING {
        if guide.phase == SUN_SALUTATION_PHASE_ROUNDS && elapsed_seconds > 0.0 {
            result.remaining = elapsed_seconds
        }
        return result
    }
    if !(elapsed_seconds > 0.0) {
        return result
    }
    maximum_seconds := SUN_SALUTATION_SECONDS_MAX * SUN_SALUTATION_STEP_COUNT * 12
    if elapsed_seconds > cast(float64)maximum_seconds {
        elapsed_seconds = cast(float64)maximum_seconds
    }
    total := SalutationGuideBreaths(guide.phase) * SalutationGuideBreathSeconds(state) * 60
    ticks := guide.tick_fraction + elapsed_seconds * 60.0
    whole := cast(s32)(ticks + 0.000000001)
    fraction := ticks - cast(float64)whole
    if fraction < 0.0 {
        fraction = 0.0
    }
    if guide.ticks + whole < total {
        result.guide.ticks += whole
        result.guide.tick_fraction = fraction
        return result
    }
    result.guide = SalutationGuideNext(guide)
    if guide.phase == SUN_SALUTATION_PHASE_INTRO {
        result.remaining = (cast(float64)(guide.ticks + whole - total) + fraction) / 60.0
    }
    return result
}

// Which leg is back in this step: the first lunge steps one leg back and
// the return lunge brings that foot forward, leaving the other one back.
// The legs switch every other round, as the figure does.
#program_export
SalutationBackLeg :: (state: SunSalutationPracticeState) -> s32 {
    first_side := !SalutationOtherSide(state)
    if state.step == SUN_SALUTATION_LUNGE_STEP {
        return ifx first_side then SUN_SALUTATION_SIDE_RIGHT else SUN_SALUTATION_SIDE_LEFT
    }
    if state.step == SUN_SALUTATION_RETURN_LUNGE_STEP {
        return ifx first_side then SUN_SALUTATION_SIDE_LEFT else SUN_SALUTATION_SIDE_RIGHT
    }
    return SUN_SALUTATION_SIDE_NONE
}

// The step that comes after this moment, or -1 when the rest and the
// results follow: Mountain pose after the intro, the upward salute after a
// round that is not the last.
#program_export
SalutationGuideNextStep :: (guide: SalutationGuide,
    state: SunSalutationPracticeState) -> s32 {
    if guide.phase == SUN_SALUTATION_PHASE_INTRO {
        return 0
    }
    if guide.phase != SUN_SALUTATION_PHASE_ROUNDS {
        return -1
    }
    step := SalutationClamp(state.step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    if step < SUN_SALUTATION_STEP_COUNT - 1 {
        return step + 1
    }
    if state.repetition < state.repetitions - 1 {
        return SUN_SALUTATION_REPEAT_STEP
    }
    return -1
}

// Locale keys for each step's name and form cue, and for the leg that is
// back.
#assert SUN_SALUTATION_STEP_COUNT == 12
SalutationStepKey :: (step: s32) -> string {
    keys: [12]string = string.[
    "sun_salutation_step_1", "sun_salutation_step_2",
    "sun_salutation_step_3", "sun_salutation_step_4",
    "sun_salutation_step_5", "sun_salutation_step_6",
    "sun_salutation_step_7", "sun_salutation_step_8",
    "sun_salutation_step_9", "sun_salutation_step_10",
    "sun_salutation_step_11", "sun_salutation_step_12"
    ]
    return keys[SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)]
}

SalutationCueKey :: (step: s32) -> string {
    keys: [12]string = string.[
    "sun_salutation_cue_1", "sun_salutation_cue_2",
    "sun_salutation_cue_3", "sun_salutation_cue_4",
    "sun_salutation_cue_5", "sun_salutation_cue_6",
    "sun_salutation_cue_7", "sun_salutation_cue_8",
    "sun_salutation_cue_9", "sun_salutation_cue_10",
    "sun_salutation_cue_11", "sun_salutation_cue_12"
    ]
    return keys[SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)]
}

SalutationSideKey :: (side: s32) -> string {
    if side == SUN_SALUTATION_SIDE_RIGHT {
        return "sun_salutation_side_right"
    }
    if side == SUN_SALUTATION_SIDE_LEFT {
        return "sun_salutation_side_left"
    }
    return ""
}
