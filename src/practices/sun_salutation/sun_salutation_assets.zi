#import, file "sun_salutation_rules.zi";

#program_export
sun_salutation_pose_asset :: (figure: s32) -> string {
    if figure == SUN_SALUTATION_FIGURE_WOMAN {
        return "assets/practices/sunsalutation/poses_woman_sheet.png"
    }
    return "assets/practices/sunsalutation/poses_man_sheet.png"
}

#program_export
sun_salutation_transition_asset :: (figure: s32,
    transition: s32) -> string {
    if figure != SUN_SALUTATION_FIGURE_MAN { return "" }
    if transition == 0 {
        return "assets/practices/sunsalutation/transition_01_01_to_02_man_sheet.png"
    }
    if transition == 1 {
        return "assets/practices/sunsalutation/transition_02_02_to_03_man_sheet.png"
    }
    return ""
}
