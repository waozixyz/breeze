#import, file "sun_salutation_rules.zi";
#import, file "sun_salutation_frames.zi";
#import, file "sun_salutation_inventory.zi";
#import, file "../../app/text_buffers.zi";
#import, file "../../app/current_app.zi";
#import "geometry"
#import "image_props"

using ImageFit;

// Both flat characters share one transparent stage and pose timing. Each
// has two frame sets: the first round's, and the next one's, in which the
// other leg steps back first.

// The number of frames of `step`; the last one is its held pose.
SunSalutationFrameCount :: (step: s32) -> s32 {
    return sun_salutation_step_frames[SalutationClamp(step, 0,
        SUN_SALUTATION_STEP_COUNT - 1)]
}

// The asset of frame `index` of `step` in frame set `set`, both counted
// from 0, held for this frame of the app.
SunSalutationFramePath :: (set: s32, step: s32, index: s32) -> string {
    set = SalutationClamp(set, 0, SUN_SALUTATION_FRAME_SETS - 1)
    step = SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    index = SalutationClamp(index, 0, SunSalutationFrameCount(step) - 1)
    frames_per_character: s32 = 1 + (SUN_SALUTATION_STEP_COUNT - 1) * SUN_SALUTATION_MOVE_FRAMES
    timeline_frame := set * frames_per_character
    if step > 0 {
        timeline_frame += 1 + (step - 1) * SUN_SALUTATION_MOVE_FRAMES + index
    }
    stored := SunSalutationStoredFrame(timeline_frame)
    set = stored / frames_per_character
    stored %= frames_per_character
    step = 0
    index = 0
    if stored > 0 {
        step = 1 + (stored - 1) / SUN_SALUTATION_MOVE_FRAMES
        index = (stored - 1) % SUN_SALUTATION_MOVE_FRAMES
    }
    directory := sun_salutation_frame_directories[set]
    name: [96]u8
    if !AppAppendText(directory, name[:]) ||
    !AppAppendText("00-000.png", name[:]) {
        return ""
    }
    at := cast(s32)directory.count
    name[at] = cast(u8)(#char "0" + (step + 1) / 10)
    name[at + 1] = cast(u8)(#char "0" + (step + 1) % 10)
    name[at + 3] = cast(u8)(#char "0" + (index + 1) / 100)
    name[at + 4] = cast(u8)(#char "0" + ((index + 1) / 10) % 10)
    name[at + 5] = cast(u8)(#char "0" + (index + 1) % 10)
    return FrameTextHold(*CurrentApp().ui.frame_text,
        AppTextFromCString(*name[0], 96))
}

// Frame `index` of `step` in frame set `set` at its place on `stage`, -1
// being the previous step's held pose.
SunSalutationFrameImage :: (set: s32, step: s32, index: s32,
    stage: Rectangle) -> ImageProps {
    set = SalutationClamp(set, 0, SUN_SALUTATION_FRAME_SETS - 1)
    step = SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    if index < 0 && step > 0 {
        step -= 1
        index = SunSalutationFrameCount(step) - 1
    }
    index = SalutationClamp(index, 0, SunSalutationFrameCount(step) - 1)
    pose := set * SUN_SALUTATION_STEP_COUNT + step
    scale := stage.width / cast(float32)SUN_SALUTATION_STAGE_W
    picture: ImageProps
    picture.asset_path = SunSalutationFramePath(set, step, index)
    picture.bounds = Rectangle.{
        stage.x + cast(float32)sun_salutation_step_x[pose] * scale,
        stage.y + cast(float32)sun_salutation_step_y[pose] * scale,
        cast(float32)sun_salutation_step_w[pose] * scale,
        cast(float32)sun_salutation_step_h[pose] * scale}
    picture.fit = cast(ImageFit)ImageFitStretch
    // The flat shapes keep clean edges when the stage is scaled.
    picture.smooth = true
    return picture
}

// The pose held at `step` in the first round, as large as fits in
// `bounds` (thumbnails).
SunSalutationPoseImage :: (character: s32, step: s32,
    bounds: Rectangle) -> ImageProps {
    character = SalutationClamp(character, 0, SUN_SALUTATION_CHARACTER_COUNT - 1)
    step = SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    pose := character * SUN_SALUTATION_STEP_COUNT + step
    picture: ImageProps
    picture.asset_path = SunSalutationFramePath(character, step,
        SunSalutationFrameCount(step) - 1)
    picture.source = Rectangle.{cast(float32)sun_salutation_held_x[pose],
        cast(float32)sun_salutation_held_y[pose],
        cast(float32)sun_salutation_held_w[pose],
        cast(float32)sun_salutation_held_h[pose]}
    picture.bounds = bounds
    picture.fit = cast(ImageFit)ImageFitContain
    picture.smooth = true
    return picture
}
