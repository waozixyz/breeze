#import, file "../../app/locale.zi";
#import, file "sun_salutation_rules.zi";

// The labels belong to this practice, while the text comes from Inbe's
// selected locale. Keep the indexed key mapping in checked Ziran.
#assert SUN_SALUTATION_STEP_COUNT == 12
sun_salutation_step_keys: [12]string = string.[
    "sun_salutation_step_1", "sun_salutation_step_2",
    "sun_salutation_step_3", "sun_salutation_step_4",
    "sun_salutation_step_5", "sun_salutation_step_6",
    "sun_salutation_step_7", "sun_salutation_step_8",
    "sun_salutation_step_9", "sun_salutation_step_10",
    "sun_salutation_step_11", "sun_salutation_step_12"
];

// The name of the pose a step moves into, such as "Mountain pose".
SunSalutationPoseName :: (step: s32) -> string {
    index := SalutationClamp(step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    return LocaleText(sun_salutation_step_keys[index])
}

// The spoken line for each step's breath. Steps 3 and 10 share the fold;
// plank steps back on the out-breath and holds on the in-breath. The first
// round steps the right leg back into the lunge and brings the right foot
// forward again; every other round the left leg leads.
sun_salutation_voice_keys: [12]string = string.[
    "sun_salutation_voice_mountain_start", "sun_salutation_voice_salute",
    "sun_salutation_voice_fold", "sun_salutation_voice_lunge_right",
    "sun_salutation_voice_plank", "sun_salutation_voice_knees_chest_chin",
    "sun_salutation_voice_cobra", "sun_salutation_voice_downward_dog",
    "sun_salutation_voice_step_forward_right", "sun_salutation_voice_fold",
    "sun_salutation_voice_rise", "sun_salutation_voice_mountain_end"
];

SUN_SALUTATION_LUNGE_BACK_STEP :: 3
SUN_SALUTATION_LUNGE_FORWARD_STEP :: 8

SunSalutationVoiceKey :: (state: SunSalutationPracticeState) -> string {
    step := SalutationClamp(state.step, 0, SUN_SALUTATION_STEP_COUNT - 1)
    if step == SUN_SALUTATION_PLANK_STEP &&
    SalutationBreathAt(state).direction == SUN_SALUTATION_BREATH_IN {
        return "sun_salutation_voice_plank_hold"
    }
    if SalutationOtherSide(state) {
        if step == SUN_SALUTATION_LUNGE_BACK_STEP {
            return "sun_salutation_voice_lunge_left"
        }
        if step == SUN_SALUTATION_LUNGE_FORWARD_STEP {
            return "sun_salutation_voice_step_forward_left"
        }
    }
    return sun_salutation_voice_keys[step]
}

// Settling in before the first breath: the place on the mat, the arms,
// then the breath.
SUN_SALUTATION_INTRO_LINE_COUNT :: 3
sun_salutation_intro_voice_keys: [3]string = string.[
    "sun_salutation_voice_intro_1", "sun_salutation_voice_intro_2",
    "sun_salutation_voice_intro_3"
];

// The `index`th settling-in line, from 0, or "" past the last one.
SunSalutationIntroVoiceKey :: (index: s32) -> string {
    if index < 0 || index >= SUN_SALUTATION_INTRO_LINE_COUNT {
        return ""
    }
    return sun_salutation_intro_voice_keys[index]
}

// The line spoken once the last round ends.
SunSalutationClosingVoiceKey :: () -> string {
    return "sun_salutation_voice_closing"
}

// Only the breath, for a tempo too quick for the whole line.
SunSalutationBreathVoiceKey :: (state: SunSalutationPracticeState) -> string {
    if SalutationBreathAt(state).direction == SUN_SALUTATION_BREATH_IN {
        return "sun_salutation_voice_breathe_in"
    }
    return "sun_salutation_voice_breathe_out"
}
