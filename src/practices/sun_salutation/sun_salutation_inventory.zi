    if timeline_frame < 0 || timeline_frame >= 3964 {
        return 0
    }
    if timeline_frame < 512 {
        return cast(s32)sun_salutation_frame_sources_0[timeline_frame - 0]
    }
    if timeline_frame < 1024 {
        return cast(s32)sun_salutation_frame_sources_1[timeline_frame - 512]
    }
    if timeline_frame < 1536 {
        return cast(s32)sun_salutation_frame_sources_2[timeline_frame - 1024]
    }
    if timeline_frame < 2048 {
        return cast(s32)sun_salutation_frame_sources_3[timeline_frame - 1536]
    }
    if timeline_frame < 2560 {
        return cast(s32)sun_salutation_frame_sources_4[timeline_frame - 2048]
    }
    if timeline_frame < 3072 {
        return cast(s32)sun_salutation_frame_sources_5[timeline_frame - 2560]
    }
    if timeline_frame < 3584 {
        return cast(s32)sun_salutation_frame_sources_6[timeline_frame - 3072]
    }
    if timeline_frame < 3964 {
        return cast(s32)sun_salutation_frame_sources_7[timeline_frame - 3584]
    }
    return 0
}
