using ModalType;
using ExerciseType;
using TextWrap;
using ImageFit;
using ButtonTone;
using ButtonEmphasis;

exit_to_start :: (app: *InnerBreeze) {
    if app == null {
        return
    }

    PracticeNarrationStop()
    app.sun_salutation = SalutationReset(app.sun_salutation)
    app.session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_switch_screen(app, ScreenStart)
}

finish :: (app: *InnerBreeze) {
    repetitions: s32 = 0
    result_path: [FS_PATH_MAX] u8

    if app == null {
        return
    }
    result_path[0] = cast(u8)0
    PracticeNarrationStop()
    send_session_complete(app)

    repetitions = app.sun_salutation.repetitions
    if repetitions < 1 {
        repetitions = 1
    }
    details := SessionDetails.{.version = SessionDetailsVersion,
        .duration_seconds = SalutationDurationSeconds(app.sun_salutation),
        .repetitions = repetitions,
        .start_seconds = app.sun_salutation.start_seconds,
        .end_seconds = app.sun_salutation.end_seconds}
    if data_save_session_path_with_details(*repetitions, 1, 0,
        EXERCISE_SUN_SALUTATION, *details,
        *result_path[0], size_of(type_of(result_path))) != 0 {
        sync_habits_for_activity(app, EXERCISE_SUN_SALUTATION)
        app_auto_sync(app)
    }
    app.sun_salutation = SalutationReset(app.sun_salutation)
    app.session_paused = 0
    meditation_music_stop(app)
    app_close_modal(app)
    app_prepare_session_results(app, EXERCISE_SUN_SALUTATION, repetitions, 0,
        null, null, 0, *result_path[0])
    app_switch_screen(app, ScreenResults)
}

sun_salutation_handle_exit_modal :: (app: *InnerBreeze) -> s32 {
    if app == null || app.modal.active == 0 ||
    app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return 0
    }
    actions: [2] ActionModalAction = .[
    ActionModalAction.{.label = LocaleText("cancel_button"), .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ActionModalAction.{.label = LocaleText("exit_button"), .tone = cast(ButtonTone)ButtonToneDanger, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled},
    ]
    modal_result := ActionModal(app.ui.session, ActionModalProps.{.title = LocaleText("exit_session_title"), .message = LocaleText("all_progress_lost_message")}, actions[:2]).action
    if modal_result == 1 || modal_result == -1 {
        app_close_modal(app)
    } else if modal_result == 2 {
        exit_to_start(app)
        return 2
    }
    return 1
}

// Ends at once; like its exit prompt, it keeps nothing unfinished.
sun_salutation_end :: (app: *InnerBreeze) {
    exit_to_start(app)
}

sun_salutation_request_exit :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app_open_modal(app, cast(ModalType)ModalConfirmExitSession)
}

step_forward :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    next := SalutationForward(app.sun_salutation)
    app.sun_salutation = next.state
    if next.completed != 0 {
        finish(app)
    }
}

advance_seconds :: (app: *InnerBreeze, seconds: float64) {
    message := PracticeStepFor(app, PRACTICE_SALUTATION_STEP)
    message.elapsed = seconds
    next := PracticeRun(message)
    if !next.succeeded {
        app.request_quit = 1
        return
    }
    app.sun_salutation = next.salutation
    if next.completed {
        finish(app)
    }
}

update_timer :: (app: *InnerBreeze) {
    if app == null || app.breathing.screen != ScreenSunSalutation ||
    app.session_paused != 0 {
        return
    }
    advance_seconds(app, cast(float64)GetFrameTime())
}

// Speaks the line for the breath taken now, or only the breath when the
// line would run past it at this tempo.
sun_salutation_narrate :: (app: *InnerBreeze) {
    key := SunSalutationVoiceKey(app.sun_salutation)
    if PracticeNarrationSeconds("sunsalutation", key) >
    cast(float64)SalutationBreathSeconds(app.sun_salutation) {
        key = SunSalutationBreathVoiceKey(app.sun_salutation)
    }
    PracticeNarrationUpdate(app, "sunsalutation", key)
}

// Keeps the poses moving while the practice runs in its small window.
sun_salutation_advance_elapsed :: (app: *InnerBreeze, elapsed_ms: s32) {
    if app == null || app_session_screen(app) != ScreenSunSalutation ||
    app.session_paused != 0 {
        return
    }
    advance_seconds(app, cast(float64)elapsed_ms / 1000.0)
}

// How many ticks one breath of the current round lasts.
breath_ticks :: (app: *InnerBreeze) -> s32 {
    ticks := SalutationBreathSeconds(app.sun_salutation) * 60
    if ticks <= 0 {
        ticks = SUN_SALUTATION_DEFAULT_START_SECONDS * 60
    }
    return ticks
}

// The selected character moving into the current step's pose, then
// holding it, fitted into the area, on the round's side.
draw_pose :: (app: *InnerBreeze, area: Rectangle) {
    if app == null || area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    SunSalutationDrawState(app.ui.session, app.sun_salutation, area,
        KeyHash("sun-salutation/figure"), LocaleText("exercise_sun_salutation"))
}

// The moving figure in the practice's small window, with the breath and
// the pose's name below it.
sun_salutation_draw_window :: (app: *InnerBreeze, picture: Rectangle, status: []u8) -> string {
    app.sun_salutation = SalutationNormalizeDraw(app.sun_salutation)
    sun_salutation_narrate(app)
    draw_pose(app, picture)
    status[0] = 0
    parts: [2]FormatArg = .[
    FormatArg.{.text = breath_label(app), .is_text = true},
    FormatArg.{.text = SunSalutationPoseName(app.sun_salutation.step), .is_text = true}
    ]
    FormatTemplate("%s · %s", parts[:], status)
    return AppTextFromCString(*status[0], cast(s32)status.count)
}

// The words for the breath being taken now.
breath_label :: (app: *InnerBreeze) -> string {
    breath := SalutationBreathAt(app.sun_salutation)
    if breath.direction == SUN_SALUTATION_BREATH_IN {
        return LocaleText("sun_salutation_breathe_in")
    }
    return LocaleText("sun_salutation_breathe_out")
}

// "Step 1" and so on, for the title bar.
step_number :: (app: *InnerBreeze) -> string {
    buffer: [48]u8
    if !FormatNumberTemplate(LocaleText("sun_salutation_step_number"),
        app.sun_salutation.step + 1, buffer[:]) {
        return ""
    }
    return FrameTextHold(*app.ui.frame_text, AppTextFromCString(*buffer[0], 48))
}

SunSalutationFigure :: (app: *InnerBreeze, request: PracticeFigureRequest) {
    draw_pose(app, request.bounds)
}

sun_salutation_draw_screen :: (app: *InnerBreeze, center_x: s32, center_y: s32) {
    if app == null || sun_salutation_handle_exit_modal(app) != 0 {
        return
    }
    app.sun_salutation = SalutationNormalizeDraw(app.sun_salutation)
    title_h := PracticeTitleBarHeight()
    if PracticeTitleBar(app, step_number(app), title_h) {
        sun_salutation_request_exit(app)
        return
    }
    practice_draw_audio_controls(app)
    breath := SalutationBreathAt(app.sun_salutation)
    frame := PracticeMovementFrameFor(app, EXERCISE_SUN_SALUTATION, title_h)
    frame.heading = SunSalutationPoseName(app.sun_salutation.step)
    frame.cue = breath_label(app)
    frame.progress = ifx breath.direction == SUN_SALUTATION_BREATH_OUT then 1000 - breath.progress else breath.progress
    frame.can_back = app.sun_salutation.step > 0 || app.sun_salutation.repetition > 0
    frame = PracticeMovementRun(app, frame, SunSalutationFigure)
    if frame.action == PRACTICE_MOVEMENT_BACK && frame.can_back {
        PracticeNarrationStop()
        app.sun_salutation = SalutationBack(app.sun_salutation)
        return
    }
    if frame.action == PRACTICE_MOVEMENT_PAUSE {
        app.session_paused = ifx app.session_paused != 0 then 0 else 1
        return
    }
    if frame.action == PRACTICE_MOVEMENT_NEXT {
        PracticeNarrationStop()
        step_forward(app)
        return
    }
    sun_salutation_narrate(app)
    update_timer(app)
    unused center_x
    unused center_y
}

sun_salutation :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("sun_salutation/root")
    Screen(CurrentApp().ui.session, root)
    sun_salutation_draw_screen(app, app.ui.view_width / 2,
        app.ui.view_height / 2)
    End(CurrentApp().ui.session)
}
