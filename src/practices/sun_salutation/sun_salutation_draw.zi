#import "geometry"
#import "session"
#import, file "sun_salutation_pose.zi";
#import, file "sun_salutation_rules.zi";
#import, file "../../../apps/practice/workout_moves.zi";
#import, file "../../../apps/practice/sun_salutation_artwork.zi";
#import, file "../tai_chi/tai_chi_math.zi";
#import, file "../tai_chi/tai_chi_solve.zi";
#import, file "../tai_chi/tai_chi_flat.zi";
#import, file "../tai_chi/tai_chi_draw.zi";
#import, file "../tai_chi/tai_chi_rules.zi";
#import, file "../tai_chi/tai_chi_view.zi";

SUN_SALUTATION_EDGE_PATH :: "assets/practices/sunsalutation/flat-edge.png"
sun_salutation_figure: TaiChiFlatFrame;

SunSalutationDrawState :: (session: Session, state: SunSalutationPracticeState,
    area: Rectangle, key: u64, alt_text: string) {
    rig := WorkoutRig()
    pose := SunSalutationPoseAt(state, *rig)
    SunSalutationDrawPose(session, state.character, pose, SunSalutationViewAt(state),
        area, key, alt_text)
}

SunSalutationDrawHeld :: (session: Session, character: s32, step: s32,
    area: Rectangle, key: u64, alt_text: string) {
    SunSalutationDrawPose(session, character, SunSalutationPose(step, false),
        SunSalutationStepView(step), area, key, alt_text)
}

SunSalutationDrawPose :: (session: Session, character: s32, pose: WorkoutPose, view: SunSalutationView,
    area: Rectangle, key: u64, alt_text: string) {
    if area.width <= 0.0 || area.height <= 0.0 {
        return
    }
    // A held or paused pose replays its kept meshes instead of solving again.
    digest := WorkoutPoseDigest(*pose, cast(u64)14695981039346656037)
    digest = TaiChiDigest(digest, cast(float64)character)
    digest = TaiChiDigest(digest, view.yaw)
    digest = TaiChiDigest(digest, view.span)
    digest = TaiChiDigest(digest, view.center)
    if TaiChiPaintFlatCached(session, key, digest, area, alt_text, SUN_SALUTATION_EDGE_PATH) {
        return
    }
    framing := SunSalutationPaintPose(*sun_salutation_figure, character, pose, view,
        cast(float64)area.width, cast(float64)area.height)
    TaiChiPaintFlatEdge(session, *sun_salutation_figure, framing, false, area, key,
        alt_text, SUN_SALUTATION_EDGE_PATH, digest)
}
