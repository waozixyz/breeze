using ModalType;
using ExerciseType;
using TextWrap;
using ImageFit;
using NumericValueKind;

sun_salutation_practice_init :: (app: *InnerBreeze) {
    if app == null {
        return
    }

    app.sun_salutation = SalutationInit(app.sun_salutation)
}

draw_character_picker :: (app: *InnerBreeze, x: s32, y: s32, width: s32) {
    Text(app.ui.session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y, 0, 0},
            .text = LocaleText("sun_salutation_character_label"),
            .wrap = cast(TextWrap)TextWrapNone
        })
    options: [SUN_SALUTATION_CHARACTER_COUNT]DropdownOption
    options[0].label = LocaleText("sun_salutation_character_bun_woman")
    options[1].label = LocaleText("sun_salutation_character_short_hair_man")
    picker: DropdownProps
    picker.id = 613
    picker.bounds = Rectangle.{cast(float32)x, cast(float32)(y + AppScale(26)),
        cast(float32)width, cast(float32)AppScale(44)}
    picker.selected_index = app.sun_salutation.character
    sun_salutation_character_menu := Dropdown(app.ui.session, picker, options[:])
    if sun_salutation_character_menu.changed {
        app.sun_salutation.character = sun_salutation_character_menu.selected_index
        app.sun_salutation_voice = -1
        save_settings(app)
    }
}

config_content_height :: (app: *InnerBreeze, content_w: s32) -> s32 {
    bottom_padding: s32

    if app == null {
        return 0
    }

    bottom_padding = app_content_bottom_reserved(app) + AppScale(24)
    app.practice_config_tab = 0
    timing_hint_h := AppParagraphHeight(LocaleText("sun_salutation_tempo_preview_hint"),
        content_w, AppSmallFontSize(), AppScale(3))
    return AppScale(76 + 24 + 32 + 74 * 3 + 24 + 86 + 32 + 74) +
    timing_hint_h + meditation_music_measure_practice_settings(app,
        EXERCISE_SUN_SALUTATION,
        content_w, 0, 1) + AppScale(12) +
    PracticeNarrationSettingsHeight(app, EXERCISE_SUN_SALUTATION,
        SalutationMaleVoice(app.sun_salutation_voice, app.sun_salutation.character), content_w) +
    bottom_padding
}

sun_salutation_config_screen_draw :: (app: *InnerBreeze) {
    layout := PracticeSubscreenLayout.{0 }
    repetitions: s32
    start_seconds: s32
    end_seconds: s32
    side_padding := GetPageSidePadding()
    max_content_w := AppScale(CONTENT_MAX_W)
    content_x: s32 = 0
    content_w: s32 = 0
    y: s32

    if app == null {
        return
    }

    app.sun_salutation = SalutationNormalizeSettings(app.sun_salutation)
    app.practice_config_tab = 0

    PracticeConfigLayout(app, ModalPracticeConfig, AppScale(14),
        *layout)
    if PracticeConfigTitle(app,
        LocaleText("practice_configure_button"),
        cast(s32)ModalPracticeConfig, 0) != 0 {
        return
    }

    if max_content_w > app.ui.view_width - side_padding * 2 {
        max_content_w = app.ui.view_width - side_padding * 2
    }
    if max_content_w < AppScale(320) {
        max_content_w = AppScale(320)
    }
    GetCenteredColumn(max_content_w, side_padding, *content_x, *content_w)
    content_h := config_content_height(app, content_w)

    {
        scroll_1_bounds: Rectangle = Rectangle.{cast(float32)0, cast(float32)layout.scroll_y,
            cast(float32)app.ui.view_width, cast(float32)layout.scroll_h
        }
        scroll_1_key: u64 = KeyHash("inbe/practices/sun_salutation/sun_salutation_practice/scroll/1")
        scroll_1_props: ScrollProps
        scroll_1_props.key = scroll_1_key
        scroll_1_props.bounds = scroll_1_bounds
        scroll_1_props.content_height = content_h
        scroll_1_props.scroll_offset = app.settings_scroll
        scroll_1_result: ScrollResult = Scroll(CurrentApp().ui.session, scroll_1_props)
        app.settings_scroll = scroll_1_result.scroll_offset
        page: Rectangle = scroll_1_result.content

        y := cast(s32)page.y

        duration := SalutationDurationSeconds(app.sun_salutation)
        duration_text: [128]u8
        duration_args: [2]FormatArg = .[
        FormatArg.{.number = duration / 60},
        FormatArg.{.number = duration % 60}]
        unused FormatTemplate(LocaleText("sun_salutation_duration_value"),
            duration_args[:], duration_text[:])
        Box(app.ui.session, BoxProps.{
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y,
                    cast(float32)content_w, cast(float32)AppScale(76)},
                .fill = DarkenColor(StyleTokenColor("canvas"), 6)})
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)(content_x + AppScale(14)),
                    cast(float32)(y + AppScale(10)), 0, 0},
                .text = LocaleText("sun_salutation_duration_label"),
                .font = AppSmallFontSize(), .wrap = cast(TextWrap)TextWrapNone})
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)(content_x + AppScale(14)),
                    cast(float32)(y + AppScale(35)), 0, 0},
                .text = AppTextFromCString(*duration_text[0], 128),
                .font = AppFontSize() + AppScale(3), .wrap = cast(TextWrap)TextWrapNone})
        y += AppScale(100)
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y, 0, 0},
                .text = LocaleText("sun_salutation_timing_label"),
                .wrap = cast(TextWrap)TextWrapNone})
        y += AppScale(32)

        repetitions = app.sun_salutation.repetitions
        repetitions_text: [24]u8
        unused AppFormatS32(repetitions, repetitions_text[:])
        rep_step := DiscreteSlider(CurrentApp().ui.session, DiscreteSliderProps.{.id = 610,
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y, cast(float32)content_w, cast(float32)AppScale(56)},
                .label = LocaleText("sun_salutation_repetitions_label"),
                .value_text = AppTextFromCString(*repetitions_text[0], 24),
                .value = repetitions, .min = 2, .max = 12})
        if rep_step.changed {
            app.sun_salutation.repetitions = rep_step.value
            save_settings(app)
        }
        y += AppScale(74)

        start_seconds = app.sun_salutation.start_seconds
        start_text: [96]u8
        FormatLocaleCount(*start_text[0], 96, "sun_salutation_seconds_per_breath", start_seconds)
        start_step := DiscreteSlider(CurrentApp().ui.session, DiscreteSliderProps.{.id = 611,
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y, cast(float32)content_w, cast(float32)AppScale(56)},
                .label = LocaleText("sun_salutation_start_speed_label"),
                .value_text = AppTextFromCString(*start_text[0], 96),
                .value = start_seconds, .min = SUN_SALUTATION_SECONDS_MIN,
                .max = SUN_SALUTATION_SECONDS_MAX})
        if start_step.changed {
            app.sun_salutation.start_seconds = start_step.value
            app.sun_salutation = SalutationNormalizeSettings(app.sun_salutation)
            save_settings(app)
        }
        y += AppScale(74)

        end_seconds = app.sun_salutation.end_seconds
        end_text: [96]u8
        FormatLocaleCount(*end_text[0], 96, "sun_salutation_seconds_per_breath", end_seconds)
        end_step := DiscreteSlider(CurrentApp().ui.session, DiscreteSliderProps.{.id = 612,
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y, cast(float32)content_w, cast(float32)AppScale(56)},
                .label = LocaleText("sun_salutation_end_speed_label"),
                .value_text = AppTextFromCString(*end_text[0], 96),
                .value = end_seconds, .min = SUN_SALUTATION_SECONDS_MIN,
                .max = app.sun_salutation.start_seconds})
        if end_step.changed {
            app.sun_salutation.end_seconds = end_step.value
            app.sun_salutation = SalutationNormalizeSettings(app.sun_salutation)
            save_settings(app)
        }
        y += AppScale(74)

        timing_hint_h := AppParagraphHeight(LocaleText("sun_salutation_tempo_preview_hint"),
            content_w, AppSmallFontSize(), AppScale(3))
        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y,
                    cast(float32)content_w, cast(float32)timing_hint_h},
                .text = LocaleText("sun_salutation_tempo_preview_hint"),
                .font = AppSmallFontSize(), .wrap = cast(TextWrap)TextWrapAuto})
        y += timing_hint_h + AppScale(24)

        // The whole sequence is drawn in the guide, so the settings stay
        // to what can be changed.
        draw_character_picker(app, content_x, y, content_w)
        y += AppScale(86)

        Text(app.ui.session, TextProps.{
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y, 0, 0},
                .text = LocaleText("settings_tab_audio"),
                .wrap = cast(TextWrap)TextWrapNone})
        y += AppScale(32)
        volume_text: [24]u8
        volume_args: [1]FormatArg = .[FormatArg.{.number = app.music_volume}]
        unused FormatTemplate("%d%%", volume_args[:], volume_text[:])
        volume := DiscreteSlider(app.ui.session, DiscreteSliderProps.{
                .id = 614,
                .bounds = Rectangle.{cast(float32)content_x, cast(float32)y,
                    cast(float32)content_w, cast(float32)AppScale(56)},
                .label = LocaleText("music_volume_label"),
                .value_text = AppTextFromCString(*volume_text[0], 24),
                .value = app.music_volume, .min = 0, .max = 100})
        if volume.changed {
            app.music_volume = volume.value
            save_settings(app)
        }
        y += AppScale(74)

        meditation_music_draw_practice_settings(app, EXERCISE_SUN_SALUTATION,
            content_x, content_w,
            *y, 0, 1)
        y += AppScale(12)
        voice := PracticeNarrationSettings(app, EXERCISE_SUN_SALUTATION,
            SalutationMaleVoice(app.sun_salutation_voice, app.sun_salutation.character),
            app.sun_salutation_narration_language[:], content_x, content_w, *y)
        if voice >= 0 {
            app.sun_salutation_voice = voice
            save_settings(app)
        }
        End(CurrentApp().ui.session)
    }
}
