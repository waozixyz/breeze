#import, file "../practice_settings_host.zi";
#import, file "../../app/app_types.zi";
#import, file "../../app/exercise_types.zi";
#import, file "../../app/modal_rules.zi";
#import, file "../../screens/practice_screen_calls.zi";
#import, file "sun_salutation_rules.zi";
using ExerciseType;
using ModalType;

sun_salutation_practice_init :: (app: *InnerBreeze) {
    if app == null {
        return
    }

    app.sun_salutation = SalutationInit(app.sun_salutation)
}

// Practices owns this Customize page; the host applies validated changes.
sun_salutation_config_screen_draw :: (app: *InnerBreeze) {
    if PracticeSettingsDraw(app, EXERCISE_SUN_SALUTATION) != 0 {
        PracticeConfigLeave(app, cast(s32)ModalPracticeConfig)
    }
}
