CountSize :: 4
MaxRounds :: 12

Rshift :: 3
Runit :: (1 << Rshift)

DefaultSpeedLevel :: 6
DefaultMaxRounds :: 4
DefaultMaxBreaths :: 30
DefaultPauseSeconds :: 2
DefaultProgressiveStartSpeed :: 3

ScreenStart :: 0
ScreenSession :: 1
ScreenPracticeSession :: ScreenSession
ScreenMeditation :: 2
ScreenSunSalutation :: 3
ScreenPatterns :: 4
ScreenResults :: 5
ScreenSettings :: 6
ScreenPracticeConfig :: 7
ScreenLanguage :: 8
ScreenAppSelection :: 21
ScreenManual :: 9
ScreenProfile :: 10
ScreenHabits :: 11
ScreenCustomizeNav :: 12
ScreenHabitEdit :: 14
ScreenHabitSessionEdit :: 15
ScreenEList :: 16
ScreenBreak :: 17

BreathPhaseStarting :: 0
BreathPhaseBreathe :: 1
BreathPhaseHold :: 2
BreathPhaseRecover :: 3
BreathPhaseNext :: 4

BreathAnimation :: enum {
    BreathAnimationLinear :: 0
    BreathAnimationInOut :: 1
    BreathAnimationCount
}

BreathSession :: struct {
    screen: s32
    phase: s32
    round: s32

    r: s32
    rmin: s32
    rmax: s32
    dir: s32
    speed_level: s32
    breath_frame: s32
    breath_half_ticks: s32
    frame: s32

    breathtick: s32
    sectick: s32
    halftick: s32
    max_rounds: s32
    pause_seconds: s32
    play_in_background: s32
    progressive_speed: s32
    progressive_start_speed: s32
    breath_animation: s32

    count: [CountSize] u8
    maxbreaths: [CountSize] u8

    results: [MaxRounds][CountSize] u8
    completed: s32
}
