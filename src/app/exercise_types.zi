
using ExerciseType;
ExerciseType :: enum {
    EXERCISE_WIM_HOF :: 0
    EXERCISE_MEDITATION :: 1
    EXERCISE_SUN_SALUTATION :: 2
    EXERCISE_PATTERNS :: 3
    EXERCISE_TAI_CHI :: 4
    EXERCISE_ASTRAL_PROJECTION :: 5
    EXERCISE_WORKOUT :: 6
}

EXERCISE_COUNT :: 7

practice_count :: () -> s32 {
    return EXERCISE_COUNT
}

// The order a person dragged the practices into in Manage practices, used
// by Practice and everywhere practices are listed; the default order until
// one is saved.
practice_order_ids: [EXERCISE_COUNT]s32;
practice_order_custom: bool;

practice_ordered_id :: (index: s32) -> s32 {
    if index < 0 {
        index = 0
    }
    if index >= EXERCISE_COUNT {
        index = EXERCISE_COUNT - 1
    }
    if practice_order_custom {
        return practice_order_ids[index]
    }
    return practice_default_ordered_id(index)
}

// Settings keep the order as one number: 1 and then each practice's id,
// such as 103124.
practice_order_code :: () -> s32 {
    code: s32 = 1
    for index: cast(s32)0..cast(s32)EXERCISE_COUNT - 1 {
        code = code * 10 + practice_ordered_id(index)
    }
    return code
}

// Older orders keep their relative order, with newly added practices last.
practice_order_load :: (code: s32) {
    practice_order_custom = false
    ids: [EXERCISE_COUNT]s32
    seen: s32 = 0
    value := code
    count: s32 = 0
    while value > 1 && count < EXERCISE_COUNT {
        id := value % 10
        value = value / 10
        if id >= EXERCISE_COUNT || (seen & (cast(s32)1 << id)) != 0 {
            return
        }
        seen |= cast(s32)1 << id
        ids[count] = id
        count += 1
    }
    if value != 1 || count < 5 || (count == 5 && seen != 31) {
        return
    }
    for index: cast(s32)0..count - 1 {
        practice_order_ids[index] = ids[count - index - 1]
    }
    for index: cast(s32)0..EXERCISE_COUNT - 1 {
        id := practice_default_ordered_id(index)
        if (seen & (cast(s32)1 << id)) == 0 {
            practice_order_ids[count] = id
            count += 1
        }
    }
    practice_order_custom = true
}

// Moves a practice into another one's place: further down it goes after
// that practice, further up before it.
practice_order_move :: (practice: s32, target: s32) {
    ids: [EXERCISE_COUNT]s32
    from: s32 = -1
    to: s32 = -1
    for index: cast(s32)0..cast(s32)EXERCISE_COUNT - 1 {
        ids[index] = practice_ordered_id(index)
        if ids[index] == practice {
            from = index
        }
        if ids[index] == target {
            to = index
        }
    }
    if from < 0 || to < 0 || from == to {
        return
    }
    step: s32 = ifx from < to then 1 else -1
    index := from
    while index != to {
        ids[index] = ids[index + step]
        index += step
    }
    ids[to] = practice
    practice_order_ids = ids
    practice_order_custom = true
}

practice_default_ordered_id :: (index: s32) -> s32 {
    if index <= 0 {
        return EXERCISE_WIM_HOF
    }
    if index == 1 {
        return EXERCISE_PATTERNS
    }
    if index == 2 {
        return EXERCISE_MEDITATION
    }
    if index == 3 {
        return EXERCISE_SUN_SALUTATION
    }
    if index == 4 {
        return EXERCISE_TAI_CHI
    }
    if index == 5 {
        return EXERCISE_ASTRAL_PROJECTION
    }
    return EXERCISE_WORKOUT
}

practice_clamp_id :: (id: s32) -> s32 {
    if id < 0 || id >= EXERCISE_COUNT {
        return EXERCISE_WIM_HOF
    }
    return id
}

#program_export
habit_activity_mask_for :: (exercise: s32) -> s32 {
    if exercise < 0 || exercise >= EXERCISE_COUNT {
        return 0
    }
    return cast(s32)1 << exercise
}
