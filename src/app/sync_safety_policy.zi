#import, file "../core/types.zi";

SYNC_UI_QUIET_SECONDS :: 1.50

SyncSafetyState :: struct {
    modal_active: s32
    habit_edit_active: s32
    server_url_focused: s32
    alias_focused: s32
    friend_input_focused: s32
    screen: s32
    // The running practice, also while it shows in its small window.
    practice_screen: s32
    // Android and the web run sync on the frame thread, not a worker.
    frame_thread_transport: bool
}

SyncScreenBlocksRefresh :: (screen: s32) -> bool {
    return screen == ScreenPracticeSession || screen == ScreenMeditation ||
    screen == ScreenSunSalutation || screen == ScreenPatterns
}

SyncInputBlocksRefresh :: (state: SyncSafetyState) -> bool {
    return state.habit_edit_active != 0  || state.server_url_focused != 0  || state.alias_focused != 0  || state.friend_input_focused != 0
}

BackgroundSyncSafe :: (state: SyncSafetyState) -> bool {
    // A sync started on the frame thread stops every frame while it builds
    // and applies encrypted records, so a running practice waits until it
    // ends. A worker-thread transport may exchange records during a
    // practice; refreshing settings or the screen stays deferred.
    if state.frame_thread_transport && SyncScreenBlocksRefresh(state.practice_screen) {
        return false
    }
    return state.modal_active == 0 && !SyncInputBlocksRefresh(state)
}

BackgroundSyncSafeFields :: (modal_active: s32, habit_edit_active: s32,
    server_url_focused: s32, alias_focused: s32,
    friend_input_focused: s32, screen: s32, practice_screen: s32,
    frame_thread_transport: bool) -> bool {
    state: SyncSafetyState
    state.modal_active = modal_active
    state.habit_edit_active = habit_edit_active
    state.server_url_focused = server_url_focused
    state.alias_focused = alias_focused
    state.friend_input_focused = friend_input_focused
    state.screen = screen
    state.practice_screen = practice_screen
    state.frame_thread_transport = frame_thread_transport
    return BackgroundSyncSafe(state)
}

SyncUserIdle :: (now: float64, last_input_at: float64,
    input_active: bool) -> bool {
    return !input_active && now >= last_input_at + SYNC_UI_QUIET_SECONDS
}

SyncUiRefreshSafe :: (state: SyncSafetyState, now: float64,
    last_input_at: float64, input_active: bool) -> bool {
    return BackgroundSyncSafe(state) && !SyncScreenBlocksRefresh(state.screen) &&
    SyncUserIdle(now, last_input_at, input_active) && state.screen != ScreenStart
}
