// Borrow embedded app data. The generated asset table owns its bytes.
#import "byte_text_linux"
#if #defined(ANDROID_BUILD) {
    #import, file "../platform/android/android_package_assets.zi";
}

c :: #system_library "c";

AssetView :: struct {
    data: string
    mime: string
    found: bool
}

EmbeddedAssetEntry :: struct {
    path: *u8
    mime: *u8
    data: *u8
    size: usize
}

AssetBlobResult :: struct {
    data: *u8
    size: usize
    mime: *u8
    found: bool
}

AssetEntryAt :: (index: usize) -> *EmbeddedAssetEntry #foreign c "asset_entry_at";
AssetEntryTotal :: () -> usize #foreign c "asset_entry_total";

AssetCompare :: (path: string, entry: *u8) -> s32 {
    index: usize = 0
    while index < cast(usize)path.count && entry[index] != cast(u8)0 {
        left := path[index]
        right := entry[index]
        if left < right {
            return -1
        }
        if left > right {
            return 1
        }
        index += 1
    }
    if index < cast(usize)path.count {
        return 1
    }
    if entry[index] != cast(u8)0 {
        return -1
    }
    return 0
}

AssetFind :: (path: string) -> *EmbeddedAssetEntry {
    if path.count == 0 {
        return null
    }
    low: usize = 0
    high := AssetEntryTotal()
    while low < high {
        middle := low + (high - low) / 2
        entry := AssetEntryAt(middle)
        if entry == null {
            return null
        }
        order := AssetCompare(path, entry.path)
        if order < 0 {
            high = middle
        } else if order > 0 {
            low = middle + 1
        } else {
            return entry
        }
    }
    return null
}

AssetProvider :: #type (path: string) -> AssetView;
asset_provider: AssetProvider;
asset_provider_enabled: bool;
asset_generation: u64;

AssetBindProvider :: (provider: AssetProvider) {
    asset_provider = provider
    asset_provider_enabled = true
    asset_generation += 1
}

AssetUnbindProvider :: () {
    asset_provider_enabled = false
    asset_generation += 1
}

AssetGeneration :: () -> u64 { return asset_generation }

// Decoded images go stale only when the bytes at their path change. The
// frame loop takes what changed since it last looked: everything, or the
// folders listed here, and forgets just those images.
ASSET_CHANGED_FOLDERS :: 8
asset_changed_all: bool;
asset_changed_folders: [ASSET_CHANGED_FOLDERS]string;
asset_changed_folder_count: s32;

// Mounted content changes invalidate borrowed resource views and decoders.
AssetNotifyChanged :: () {
    asset_generation += 1
    asset_changed_all = true
}

// Content under one folder was replaced, such as a practice pack's images:
// readers look again, and only images under the folder load again.
AssetNotifyChangedUnder :: (folder: string) {
    asset_generation += 1
    for index: cast(s32)0..asset_changed_folder_count - 1 {
        if asset_changed_folders[index] == folder {
            return
        }
    }
    if asset_changed_folder_count >= ASSET_CHANGED_FOLDERS {
        asset_changed_all = true
        return
    }
    asset_changed_folders[asset_changed_folder_count] = folder
    asset_changed_folder_count += 1
}

// Assets that were missing became readable, or ones nothing reads went
// away (an app finished opening, a pack opened or was put away): readers
// look again, and every image already on screen stays. An image that
// could not load yet is read again on its own.
AssetNotifyAvailable :: () {
    asset_generation += 1
}

AssetChanges :: struct {
    all: bool
    folders: []string
}

// What changed since the last call; the frame loop forgets those images.
AssetTakeChanges :: () -> AssetChanges {
    changes := AssetChanges.{.all = asset_changed_all,
        .folders = asset_changed_folders[0:asset_changed_folder_count]}
    asset_changed_all = false
    asset_changed_folder_count = 0
    return changes
}

AssetViewFor :: (path: string) -> AssetView {
    if asset_provider_enabled {
        supplied := asset_provider(path)
        if supplied.found { return supplied }
    }
    #if #defined(ANDROID_BUILD) {
        if path == "inbe.zx" || path == "apps.zx" {
            package := AndroidPackageBytes(path)
            if package.count > 0 {
                return .{.data = package, .mime = "application/octet-stream", .found = true}
            }
        }
    }
    result: AssetView
    entry := AssetFind(path)
    if entry == null {
        return result
    }
    result.data = TextFromBytes(BytesFromPointer(entry.data,
        cast(u64)entry.size))
    result.mime = TextFromCString(entry.mime)
    result.found = true
    return result
}

#program_export
AssetRead :: (path: string) -> AssetView {
    return AssetViewFor(path)
}

#program_export
AssetReadBytes :: (path: []u8) -> AssetView {
    result: AssetView
    if path.count <= 0 || path.count > 4096 {
        return result
    }
    return AssetViewFor(TextFromBytes(path))
}

#program_export
asset_lookup_bytes :: (path: *u8, length: usize) -> AssetBlobResult {
    result: AssetBlobResult
    if path == null || length == 0 || length > cast(usize)9223372036854775807 {
        return result
    }
    view := AssetViewFor(TextFromBytes(BytesFromPointer(path, cast(u64)length)))
    if view.found {
        descriptor := cast(*TextDescriptor)(*view.data)
        result.data = descriptor.data
        result.size = cast(usize)view.data.count
        // The file decoder determines the format from its bytes.
        mime := view.mime
        mime_descriptor := cast(*TextDescriptor)(*mime)
        result.mime = mime_descriptor.data
        result.found = true
        return result
    }
    entry := AssetFind(TextFromBytes(BytesFromPointer(path,
        cast(u64)length)))
    if entry == null {
        return result
    }
    result.data = entry.data
    result.size = entry.size
    result.mime = entry.mime
    result.found = true
    return result
}

#program_export
asset_lookup :: (path: *u8) -> AssetBlobResult {
    if path == null {
        result: AssetBlobResult
        return result
    }
    return asset_lookup_bytes(path, cast(usize)TextFromCString(path).count)
}
