#import, file "app_types.zi";
#import, file "audio_policy.zi";
#import, file "exercise_types.zi";

#program_export
app_audio_music_count :: (app: *InnerBreeze) -> s32 {
    custom: s32 = 0
    if app != null { custom = app.audio_custom_music_count }
    return MusicCountFor(custom, AUDIO_BUILTIN_MUSIC_COUNT,
        AUDIO_CUSTOM_MUSIC_MAX)
}

#program_export
app_audio_music_sanitize_selection :: (app: *InnerBreeze) {
    if app == null { return }
    tracks: [EXERCISE_COUNT]s32
    for i: 0..(EXERCISE_COUNT - 1) {
        tracks[i] = app.meditation.music_practice_tracks[i]
    }
    selection := MusicSelectionFor(app.meditation.music_track,
        tracks[:], app_audio_music_count(app),
        AUDIO_MUSIC_NONE)
    for i: 0..(EXERCISE_COUNT - 1) {
        app.meditation.music_practice_tracks[i] = tracks[i]
    }
    app.meditation.music_track = selection.selected
    app.meditation.music_practice_mask = selection.mask
}
