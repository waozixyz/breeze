using Image.ImageFit;
using ButtonTone;
using ButtonEmphasis;
using Text.Wrap;

media_compression_owner: string;
media_compression_hash: string;
media_compression_quality: s32 = 35;
media_compression_generation: s32;
media_compression_revision: s64 = -1;
media_compression_files_revision: s64 = -1;
media_compression_statistics: MediaCompressionStatistics;
media_compression_work: *MediaCompressionWork;
media_compression_before: Texture2D;
media_compression_after: Texture2D;
media_compression_uploaded: bool;
media_compression_notice: string;
media_compression_due: float64;
media_compression_scroll: s32;
media_compression_toast: Toast.ToastState;
media_compression_text: FrameTextStore;

MediaCompressionScreen :: (app: *InnerBreeze) -> bool {
    return ImagePreview.ImageAVIFEncodingAvailable() &&
    (app.breathing.screen == ScreenDiary ||
        (app.breathing.screen == ScreenNodeApp && NodeAppName(app.node_app_slot) == "photos"))
}

MediaCompressionDropPreview :: (app: *InnerBreeze) {
    BitmapImageRelease(app.ui.session, media_compression_before)
    BitmapImageRelease(app.ui.session, media_compression_after)
    media_compression_before = Texture2D.{}
    media_compression_after = Texture2D.{}
    media_compression_uploaded = false
}

MediaCompressionInvalidate :: (app: *InnerBreeze) {
    media_compression_generation += 1
    MediaCompressionDropPreview(app)
    media_compression_due = HostSeconds() + 0.25
}

MediaCompressionRefresh :: () {
    revision := storage_data_revision()
    files_revision := MediaFilesRevision()
    if revision != media_compression_revision || files_revision != media_compression_files_revision {
        media_compression_statistics = MediaCompressionStats()
        media_compression_revision = revision
        media_compression_files_revision = files_revision
    }
}

#program_export
MediaCompressionOpen :: (app: *InnerBreeze) {
    if app == null || !MediaCompressionScreen(app) || app.modal.active != 0 ||
    app.file_dialog_active != 0 || app.host_feature != 0 {
        return
    }
    MediaCompressionInvalidate(app)
    PackageFree(media_compression_hash)
    media_compression_hash = MediaCompressionNext("")
    media_compression_quality = MediaCompressionQuality()
    media_compression_notice = ""
    media_compression_scroll = 0
    media_compression_statistics = MediaCompressionStats()
    app_open_modal(app, ModalType.ModalMediaCompression)
}

// Run even after dismissal to join and free cancelled jobs. Only one codec
// job exists; quality changes invalidate its generation immediately.
MediaCompressionPump :: (app: *InnerBreeze) {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if owner != media_compression_owner {
        MediaCompressionInvalidate(app)
        PackageFree(media_compression_owner)
        media_compression_owner = PackageText(owner, "")
        PackageFree(media_compression_hash)
        media_compression_hash = ""
        media_compression_revision = -1
        media_compression_files_revision = -1
        media_compression_toast = Toast.ToastState.{}
        if app.modal.active != 0 && app.modal.type == ModalType.ModalMediaCompression {
            app_close_modal(app)
        }
    }
    // Consume host/guest actions after account isolation and before a
    // running worker can yield this frame.
    if MediaCompressionTakeRequest() {
        MediaCompressionOpen(app)
    }
    opened := app.modal.active != 0 && app.modal.type == ModalType.ModalMediaCompression
    if opened && (!MediaCompressionScreen(app) || app.launcher_open) {
        app_close_modal(app)
        opened = false
    }
    if !opened && media_compression_hash.count > 0 {
        MediaCompressionInvalidate(app)
        PackageFree(media_compression_hash)
        media_compression_hash = ""
    }
    if opened {
        MediaCompressionRefresh()
    }
    if media_compression_work != null {
        work := media_compression_work
        if !MediaCompressionWorkReady(work) {
            AppRequestSmoothFrames(2)
            return
        }
        if !opened || !MediaCompressionWorkCurrent(work, owner,
            media_compression_hash, media_compression_generation) {
            MediaCompressionWorkFree(work)
            media_compression_work = null
        } else if !media_compression_uploaded {
            if MediaCompressionWorkSuccessful(work) {
                before := work.before
                after := work.after
                media_compression_before = BitmapImageCreate(app.ui.session, before.width, before.height,
                    BytesFromPointer(before.pixels, cast(u64)(before.stride * before.height)))
                media_compression_after = BitmapImageCreate(app.ui.session, after.width, after.height,
                    BytesFromPointer(after.pixels, cast(u64)(after.stride * after.height)))
                if media_compression_before.id == 0 || media_compression_after.id == 0 {
                    MediaCompressionDropPreview(app)
                    media_compression_notice = "media_compression_failed"
                } else if media_compression_notice == "app_loading_pictures" {
                    media_compression_notice = ""
                }
            } else {
                media_compression_notice = "media_compression_failed"
            }
            media_compression_uploaded = true
        }
    }
    if opened && media_compression_work == null && media_compression_hash.count > 0 &&
    media_compression_notice != "media_compression_failed" {
        AppRequestSmoothFrames(2)
        if HostSeconds() < media_compression_due {
            return
        }
        source := MediaCompressionSource(media_compression_hash)
        if source.count == 0 {
            if MediaCompressionSourcePending(media_compression_hash) {
                media_compression_notice = "app_loading_pictures"
                media_compression_due = HostSeconds() + 1.0
            } else {
                media_compression_notice = "media_compression_failed"
            }
            return
        }
        media_compression_work = MediaCompressionWorkStart(owner, media_compression_hash, source,
            media_compression_quality, media_compression_generation)
        PackageFree(source)
        if media_compression_work == null {
            media_compression_notice = "media_compression_failed"
        } else if media_compression_notice != "media_compression_applied" {
            media_compression_notice = "app_loading_pictures"
        }
    }
}

// Sync is convergent: disconnected devices may offer before receiving the
// account receipt. The wrench remains available independently of sync.




MediaCompressionCountText :: (key: string, value: s64, bytes: bool = false) -> string {
    out: Vec(u8)
    if bytes {
        BuilderPrint(*out, "%: % B", LocaleText(key), value)
    } else {
        BuilderPrint(*out, "%: %", LocaleText(key), value)
    }
    text := BuilderFinish(out)
    result := FrameTextHold(*media_compression_text, text)
    PackageFree(text)
    return result
}
