#import, file "../core/types.zi";

// Mini mode is Inbe reduced to its practices: the practice start page, the
// practices themselves, and their results. Navigation, habits, lists, the
// profile, settings, onboarding, and reminders are left out. A page embeds it
// with ?mini in the address; the desktop app starts it with --mini. Reading
// that request is Kryon's mini_embed, shared by every app with a mini view.

// Mini mode keeps the practice start page, the practices, and their results.
MiniModeAllowsScreen :: (screen: s32) -> bool {
    return screen == ScreenStart || screen == ScreenSession ||
    screen == ScreenMeditation || screen == ScreenSunSalutation ||
    screen == ScreenPatterns || screen == ScreenTaiChi || screen == ScreenAstralProjection || screen == ScreenWorkout ||
    screen == ScreenResults || screen == ScreenPracticeConfig
}
