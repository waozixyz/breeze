// Keep native flag widths when authored TSX views inspect existing state.
// TSX has no JavaScript-style 32-bit bitwise coercion.
FlagIntersection :: (value: $T, mask: T) -> T {
    return value & mask
}
FlagUnion :: (value: $T, mask: T) -> T {
    return value | mask
}
FlagDifference :: (value: $T, mask: T) -> T {
    return value ^ mask
}
FlagComplement :: (value: $T) -> T {
    return ~value
}
FlagShiftLeft :: (value: $T, count: $C) -> T {
    return value << count
}
FlagShiftRight :: (value: $T, count: $C) -> T {
    return value >> count
}

NativePresent :: (value: $T) -> bool {
    return value != null
}

NativeContext :: (value: *$T) -> *void {
    return cast(*void)value
}
