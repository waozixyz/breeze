#import "scroll_widget"
#import "session"
#import "text_props"
#import "text_widget"
#import "tree"

using ButtonTone;
using ButtonEmphasis;

donation_scroll: s32;
donation_notice: string;

donation_button_height :: () -> s32 { return AppScale(36) }

donation_coin_height :: (width: s32) -> s32 {
    stack := width < AppScale(330)
    buttons: s32 = ifx (stack) then (3) else (1)
    return AppScale(12) + AppScale(30) + AppScale(6) +
        AppScale(52) + AppScale(10) +
        buttons * donation_button_height() +
        (buttons - 1) * AppScale(8) + AppScale(12)
}

donation_label :: (app: *InnerBreeze, text: string,
    x: s32, y: s32, width: s32, height: s32) {
    Text(app.ui.session, TextProps.{
        .bounds = Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)width, cast(float32)height},
        .text = text})
}

donation_coin :: (app: *InnerBreeze, name: string, address: string,
    wallet_url: string, exchange_url: string, x: s32, y: s32,
    width: s32, id: s32) {
    donation_label(app, name, x, y, width, AppScale(30))
    y += AppScale(36)
    donation_label(app, address, x, y, width, AppScale(52))
    y += AppScale(62)
    stack := width < AppScale(330)
    gap := AppScale(8)
    button_width := ifx (stack) then (width) else ((width - gap * 2) / 3)
    button_height := donation_button_height()
    if Button(app.ui.session, ButtonProps.{
        .id = id,
        .bounds = Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)button_width, cast(float32)button_height},
        .label = LocaleText("copy_address_button"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        if TextInputWriteClipboard(address) {
            donation_notice = LocaleText("address_copied")
        }
    }
    if stack { y += button_height + gap }
    second_x := ifx (stack) then (x) else (x + button_width + gap)
    if Button(app.ui.session, ButtonProps.{
        .id = id + 1,
        .bounds = Rectangle.{cast(float32)second_x, cast(float32)y,
            cast(float32)button_width, cast(float32)button_height},
        .label = LocaleText("open_wallet_button"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        if !OpenUri(wallet_url) {
            donation_notice = LocaleText("wallet_not_installed_toast")
        }
    }
    if stack { y += button_height + gap }
    third_x := ifx (stack) then (x) else (x + (button_width + gap) * 2)
    if Button(app.ui.session, ButtonProps.{
        .id = id + 2,
        .bounds = Rectangle.{cast(float32)third_x, cast(float32)y,
            cast(float32)button_width, cast(float32)button_height},
        .label = LocaleText("trocador_button"),
        .tone = cast(ButtonTone)ButtonToneAccent,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled}) != 0 {
        unused OpenUri(exchange_url)
    }
}

#program_export
draw_about_donation_modal :: (app: *InnerBreeze) {
    if app == null { return }
    width := app.ui.view_width - AppScale(24)
    if width > AppScale(560) { width = AppScale(560) }
    if width < AppScale(240) { width = AppScale(240) }
    height := app.ui.view_height - AppScale(24)
    if height > AppScale(620) { height = AppScale(620) }
    if height < AppScale(260) { height = AppScale(260) }
    frame := ModalFrame(app.ui.session, ModalFrameProps.{
        .key = KeyHash("donation/about"),
        .title = LocaleText("donation_reminder_title"),
        .width = width, .height = height,
        .has_right_action = true,
        .right_label = LocaleText("close_button")})
    if frame.dismissed || frame.right_clicked {
        app_close_modal(app)
        return
    }
    if frame.panel_node < 0 || !TreePushScope(app.ui.session, frame.panel_node) {
        return
    }
    layout: ModalFrameLayout = frame.layout
    content: Rectangle = layout.content
    x := cast(s32)content.x
    y := cast(s32)content.y
    content_width := cast(s32)content.width
    content_height := cast(s32)content.height
    message := LocaleText("about_donation_message")
    message_height := AppParagraphHeight(message, content_width,
        AppSmallFontSize(), AppScale(4))
    coin_height := donation_coin_height(content_width)
    total_height := message_height + coin_height * 2 +
        AppScale(50) + AppScale(16)
    scroll_height := content_height - AppScale(50)
    if scroll_height < 1 { scroll_height = 1 }
    scroll_key := KeyHash("donation/about/scroll")
    bounds := Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)content_width, cast(float32)scroll_height}
    scroll: ScrollProps
    scroll.key = scroll_key
    scroll.bounds = bounds
    scroll.content_height = total_height
    scroll.scroll_offset = donation_scroll
    scroll.input = ScrollObservationFor(scroll_key, bounds)
    scrolled := Scroll(app.ui.session, scroll)
    donation_scroll = scrolled.scroll_offset
    CommitScroll(scroll_key, scrolled.frame)
    if scrolled.opened {
        row := cast(s32)scrolled.content.y
        donation_label(app, message, x, row,
            content_width, message_height)
        row += message_height + AppScale(16)
        donation_coin(app, "Bitcoin", app_bitcoin_donation_address(),
            app_bitcoin_wallet_url(), app_bitcoin_trocador_url(),
            x, row, content_width, 6101)
        row += coin_height
        donation_coin(app, "Monero", app_monero_donation_address(),
            app_monero_wallet_url(), app_monero_trocador_url(),
            x, row, content_width, 6111)
        unused End(app.ui.session)
    }
    if donation_notice != "" {
        donation_label(app, donation_notice, x,
            y + content_height - AppScale(48),
            content_width - AppScale(110), AppScale(40))
    }
    if Button(app.ui.session, ButtonProps.{
        .id = 6121,
        .bounds = Rectangle.{cast(float32)(x + content_width - AppScale(100)),
            cast(float32)(y + content_height - AppScale(44)),
            cast(float32)AppScale(100), cast(float32)AppScale(40)},
        .label = LocaleText("close_button"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft}) != 0 {
        donation_notice = ""
        app_close_modal(app)
    }
    unused End(app.ui.session)
}
