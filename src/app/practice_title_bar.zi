#import "practice_title_bar_ui"
Button :: #import "kryon/button";
Dropdown :: #import "kryon/dropdown";
Text :: #import "kryon/text";
TitleBar :: #import "kryon/title_bar";
#import "control_props"
#import "geometry"
#import "session"
#import "text_align"
#import, file "app_types.zi";
#import, file "locale.zi";
#import, file "metrics.zi";
#import, file "mini_mode.zi";
#import, file "mini_mode_expand.zi";
#import, file "session_screen.zi";
#import "drawing_props"

using Text.Wrap;
using ButtonTone;
using ButtonEmphasis;

#program_export
PracticeTitleBarHeight :: () -> s32 {
    minimum := AppScale(76)
    standard := AppTitleBarHeight()
    if standard > minimum {
        return standard
    }
    return minimum
}



PracticeTitleBarNewOptions :: () -> [1]Dropdown.Option {
    result: [1]Dropdown.Option
    return result
}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
PracticeTitleBar :: (app: *InnerBreeze, title: string,
    height: s32) -> bool {
    return PracticeTitleBarView(app, title, height)
}
