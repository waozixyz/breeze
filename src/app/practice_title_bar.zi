#import "button_props"
#import "button_widget"
#import "control_props"
#import "dropdown_props"
#import "geometry"
#import "image_props"
#import "session"
#import "text_align"
#import "text_props"
#import "text_widget"
#import "title_bar_props"
#import "title_bar_widget"
#import, file "app_types.zi";
#import, file "locale.zi";
#import, file "metrics.zi";
#import, file "mini_mode.zi";
#import, file "mini_mode_expand.zi";
#import "drawing_props"

using TextWrap;
using ButtonTone;
using ButtonEmphasis;

#program_export
PracticeTitleBarHeight :: () -> s32 {
    minimum := AppScale(76)
    standard := AppTitleBarHeight()
    if standard > minimum {
        return standard
    }
    return minimum
}

#program_export
PracticeTitleBar :: (app: *InnerBreeze, title: string,
    height: s32) -> bool {
    if app == null || app.ui.view_width <= 0  || !SessionValid(app.ui.session) {
        return false
    }
    if height < PracticeTitleBarHeight() {
        height = PracticeTitleBarHeight()
    }
    view_width := app.ui.view_width
    button_size := AppScale(24)
    padding := AppScale(10)
    button_total := button_size + padding * 2
    close_x := view_width - button_total - AppScale(12)
    close_y := (height - button_total) / 2
    if close_y < 0 {
        close_y = 0
    }
    // In mini mode the expand button takes the corner and close moves left.
    expand_x := close_x
    if AppMiniMode() {
        close_x -= button_total + AppScale(4)
    }

    side_reserved := view_width - close_x + AppScale(8)
    title_x := AppScale(112)
    title_width := view_width - title_x - side_reserved
    if title_width < 0 {
        title_width = 0
    }
    max_text_width := title_width - AppScale(24)
    if max_text_width < 0 {
        max_text_width = 0
    }
    font := AppScale(32)
    title_text_width := AppTextWidth(title, font)
    while font > AppFontSize() && title_text_width > max_text_width {
        font -= 1
        title_text_width = AppTextWidth(title, font)
    }
    if title_text_width > max_text_width {
        title_text_width = max_text_width
    }

    options: [1]DropdownOption
    bar: TitleBarProps
    bar.height = height
    bar.bounds = Rectangle.{0.0, 0.0,
        cast(float32)view_width, cast(float32)height
    }
    unused TitleBar(app.ui.session, bar, options[0:0])

    text_props: TextProps
    text_props.text = title
    text_props.font = font
    text_props.wrap = cast(TextWrap)TextWrapNone
    text_props.bounds = Rectangle.{
        cast(float32)(title_x + (title_width - title_text_width) / 2),
        cast(float32)((height - AppTextLineHeight(font)) / 2),
        cast(float32)title_text_width,
        cast(float32)AppTextLineHeight(font)
    }
    Text(app.ui.session, text_props)

    if app.modal.active != 0 {
        return false
    }
    close: ButtonProps
    close.id = 9102
    close.bounds = Rectangle.{cast(float32)close_x,
        cast(float32)close_y, cast(float32)button_total,
        cast(float32)button_total
    }
    close.label = LocaleText("close_button")
    close.image.asset_path = "icons/ui.png"
    close.image.alt_text = close.label
    close.image.source = Rectangle.{.x = 448.0, .y = 384.0, .width = 64.0, .height = 64.0}
    close.icon_only = true
    close.circle = true
    close.tone = cast(ButtonTone)ButtonToneNeutral
    close.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    if AppMiniMode() && AppMiniExpandButton(app, Rectangle.{
        cast(float32)expand_x, cast(float32)close_y,
        cast(float32)button_total, cast(float32)button_total}) {
        AppMiniModeExpand(app)
    }
    return Button(app.ui.session, close) != 0
}
