#import, file "text_buffers.zi";

// Decimal units describe the active .zib payload, including its own assets.
// Shared host assets and the user's saved data are not part of this count.
AppBundleSizeText :: (bytes: s64, output: []u8) -> bool {
    if output.count == 0 {
        return false
    }
    output[0] = cast(u8)0
    if bytes <= 0 || bytes > 67108864 {
        return false
    }
    if bytes < 1000 {
        return FormatNumberTemplate("%d B", cast(s32)bytes, output)
    }
    unit: s64 = 1000
    suffix := " kB"
    if bytes >= 999950 {
        unit = 1000000
        suffix = " MB"
    }
    tenths := cast(s32)((bytes * 10 + unit / 2) / unit)
    if !FormatTwoNumberTemplate("%d.%d", tenths / 10, tenths % 10, output) {
        return false
    }
    return AppAppendText(suffix, output)
}
