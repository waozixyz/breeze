#import, file "text_buffers.zi";

#program_export
ScreenshotArguments :: (argc: s32, argv: **u8, output: []string) -> s32 {
    if argc < 0 || argc > 128 || output.count < cast(s64)argc {
        return -1
    }
    if argc > 0 && argv == null {
        return -1
    }
    index: s32 = 0
    while index < argc {
        value: *u8 = argv[index]
        if value == null {
            return -1
        }
        length: s32 = 0
        while length < 2147483646 && value[length] != cast(u8)0 {
            length += 1
        }
        if value[length] != cast(u8)0 {
            return -1
        }
        output[index] = AppTextFromCString(value, length + 1)
        index += 1
    }
    return argc
}
