#import "profile_image_picker_ui"
Button :: #import "kryon/button";
Image :: #import "kryon/image";
Modal :: #import "kryon/modal";
Scroll :: #import "kryon/scroll";
#import "control_props"
#import "geometry"
#import "session"
#import "kryon/tree"
#import, file "locale.zi";
#import, file "metrics.zi";
#import, file "profile_picture_policy.zi";
#import "drawing_props"

using ButtonTone;
using ButtonEmphasis;
using Image.ImageFit;

ProfileImagePickerProps :: struct {
    title: string
    selected_icon_type: s32
    max_width: s32
    scroll_offset: s32
    view_width: s32
    view_height: s32
}

ProfileImagePickerResult :: struct {
    changed: bool
    closed: bool
    selected_index: s32
    selected_icon_type: s32
    scroll_offset: s32
}

ProfilePictureImage :: (icon_type: s32, label: string) -> Image.Props {
    image: Image.Props
    image.alt_text = label
    if icon_type == 50 {
        // The profile card needs more detail than the 64-pixel icon atlas.
        // Entity's copy in the root package is the same picture.
        image.asset_path = "assets/entity/flowers.webp"
        image.fit = cast(Image.ImageFit)ImageFitContain
        return image
    }
    index := icon_type - 41
    if icon_type >= 124 && icon_type <= 126 {
        index = 25 + icon_type - 124
    }
    if index < 0 || index >= 28 {
        index = 0
    }
    image.asset_path = "icons/pfp.webp"
    image.source = Rectangle.{cast(float32)((index % 5) * 64),
        cast(float32)((index / 5) * 64), 64.0, 64.0
    }
    return image
}



// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
ProfileImagePicker :: (session: Session,
    props: ProfileImagePickerProps) -> ProfileImagePickerResult {
    return ProfileImagePickerView(session, props)
}
