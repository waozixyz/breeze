#import "css_parser"
#import "css_sheet"
#import, file "assets.zi";
#import, file "mini_mode.zi";

using CssTokenKind;

// Persisted Inbe theme IDs retain their original Kryon catalog scopes.
ThemeCount :: 13
ThemeDefaultId :: 9
ThemeCobaltId :: 11

ThemeScopeFor :: (id: s32, dark: bool) -> string {
    if dark {
        if id == 0 { return "sky_dark" }
        if id == 1 { return "ocean_dark" }
        if id == 2 { return "forest_dark" }
        if id == 3 { return "sunset_dark" }
        if id == 4 { return "lavender_dark" }
        if id == 5 { return "cherry_dark" }
        if id == 6 { return "dawn_dark" }
        if id == 7 { return "sage_dark" }
        if id == 8 { return "ink_dark" }
        if id == 10 { return "mint_dark" }
        if id == 11 { return "cobalt_dark" }
        if id == 12 { return "sweet_dark" }
        return "default_dark"
    }
    if id == 0 { return "sky_light" }
    if id == 1 { return "ocean_light" }
    if id == 2 { return "forest_light" }
    if id == 3 { return "sunset_light" }
    if id == 4 { return "lavender_light" }
    if id == 5 { return "cherry_light" }
    if id == 6 { return "dawn_light" }
    if id == 7 { return "sage_light" }
    if id == 8 { return "ink_light" }
    if id == 10 { return "mint_light" }
    if id == 11 { return "cobalt_light" }
    if id == 12 { return "sweet_light" }
    return "default_light"
}

ThemeCatalog :: struct {
    complete: bool
    background: u32
    surface: u32
    text: u32
    circle: u32
    button: u32
    button_hover: u32
    button_ink: u32
    icon: u32
    link: u32
}

// The catalog is one sheet of custom properties with a media query per
// theme; parsing it into its own sheet leaves the installed style alone.
theme_catalog_sheet: CssSheet;

ThemeCatalogColor :: (name: string) -> CssTokenResult {
    token := CssSheetToken(*theme_catalog_sheet, name)
    if token.kind != cast(s32)CssTokenColor { token.found = false }
    return token
}

ThemeCatalogParse :: (source: string, id: s32, dark: bool) -> ThemeCatalog {
    result: ThemeCatalog
    if source.count == 0 { return result }
    CssSheetReset(*theme_catalog_sheet)
    if !CssSheetParse(*theme_catalog_sheet, source, "themes/catalog.css", CssNoImports) {
        return result
    }
    env := CssEnvironmentWithNames(CssDefaultEnvironment(),
        ThemeScopeFor(id, dark), "", "", "", "")
    if !CssSheetResolve(*theme_catalog_sheet, env, null) { return result }
    background := ThemeCatalogColor("background")
    surface := ThemeCatalogColor("surface")
    text := ThemeCatalogColor("text")
    circle := ThemeCatalogColor("circle")
    button := ThemeCatalogColor("button")
    button_hover := ThemeCatalogColor("button_hover")
    icon := ThemeCatalogColor("icon")
    link := ThemeCatalogColor("link")
    if !background.found || !surface.found || !text.found  || !circle.found || !button.found || !button_hover.found  || !icon.found || !link.found { return result }
    result.complete = true
    result.background = background.color
    result.surface = surface.color
    result.text = text.color
    result.circle = circle.color
    result.button = button.color
    result.button_hover = button_hover.color
    result.icon = icon.color
    result.link = link.color
    return result
}

ThemeCatalogLoad :: (id: s32, dark: bool) -> ThemeCatalog {
    if AppWaoziTheme() {
        return ThemeCatalog.{
            .complete = true,
            .background = 0xf7f3ebff,
            .surface = 0xfcfaf5ff,
            .text = 0x202c29ff,
            .circle = 0xdce2d4ff,
            .button = 0x315e48ff,
            .button_hover = 0x284e3cff,
            .icon = 0x315e48ff,
            .link = 0x315e48ff
        }
    }
    if id == ThemeDefaultId {
        return ThemeCatalog.{
            .complete = true,
            .background = ifx dark then 0x14202bff else 0xf5f8f6ff,
            .surface = ifx dark then 0x1d2c39ff else 0xeaf1edff,
            .text = ifx dark then 0xe6eff3ff else 0x20332bff,
            .circle = ifx dark then 0x99deb8ff else 0xbfe8ceff,
            .button = ifx dark then 0x99deb8ff else 0xbfe8ceff,
            .button_hover = ifx dark then 0xb1e8caff else 0xaed9bfff,
            .button_ink = 0x18352aff,
            .icon = ifx dark then 0xe6eff3ff else 0x20332bff,
            .link = ifx dark then 0x99deb8ff else 0x315e48ff
        }
    }
    path := ifx dark then "themes/catalog_dark.css" else "themes/catalog_light.css"
    asset := AssetRead(path)
    if !asset.found { return ThemeCatalog.{} }
    return ThemeCatalogParse(asset.data, id, dark)
}
