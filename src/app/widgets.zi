guide_layout: GuideLayout;

// Inbe's active modal and guide actions use the shared icon atlas.
ActionImage :: (icon: ActionIcon, label: string) -> ImageProps {
    image: ImageProps
    image.asset_path = "icons/ui.png"
    image.alt_text = label
    x: s32 = 0
    y: s32 = 0
    if icon == ActionIcon.IconBack {
        x = 128
    } else if icon == ActionIcon.IconCheck {
        x = 320
    } else if icon == ActionIcon.IconNext {
        x = 128
        y = 64
    } else if icon == ActionIcon.IconPause {
        x = 64
        y = 192
    } else if icon == ActionIcon.IconPlay {
        x = 256
        y = 192
    } else if icon == ActionIcon.IconClose {
        x = 448
        y = 384
    } else {
        image.asset_path = ""
        return image
    }
    image.source = Rectangle.{cast(float32)x, cast(float32)y,
        64.0, 64.0
    }
    return image
}

ActionLabel :: (icon: ActionIcon) -> string {
    if icon == ActionIcon.IconBack {
        return LocaleText("back_button")
    }
    if icon == ActionIcon.IconNext {
        return LocaleText("next_button")
    }
    if icon == ActionIcon.IconPause {
        return LocaleText("pause_button")
    }
    if icon == ActionIcon.IconPlay {
        return LocaleText("play_button")
    }
    if icon == ActionIcon.IconClose {
        return LocaleText("close_button")
    }
    return LocaleText("practice_start_button")
}

GuideFace :: (role: s32) -> StyleFrame {
    face: StyleData = ModalFrameDefaultFace(ModalPanelRole())
    if role == 19 {
        face = ModalFrameDefaultFace(ModalScrimRole())
    }
    facts := StyleControlRoleFacts(StyleKindGuide(), 0, 0, role,
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisSoft,
        cast(s32)ControlSizeMedium, cast(s32)ButtonStateNormal)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), face, facts,
        cast(s32)ButtonStateNormal)
    return frame
}

GuidePageLabel :: (app: *InnerBreeze, step: s32,
    count: s32) -> string {
    page: [96]u8
    if !FormatTwoNumberTemplate(LocaleText("tutorial_step_progress"),
        step + 1, count, page[:]) {
        return ""
    }
    return FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*page[0], 96))
}

GuideRoundedScrimCorners :: (session: Session, node: s32,
    scrim: GuideScrim, color: Color) {
    left := cast(s32)scrim.left.width
    right := cast(s32)scrim.right.x
    top := cast(s32)scrim.top.height
    bottom := cast(s32)scrim.bottom.y
    radius := AppScale(12)
    if radius > (right - left) / 2 {
        radius = (right - left) / 2
    }
    if radius > (bottom - top) / 2 {
        radius = (bottom - top) / 2
    }
    if radius <= 0 {
        return
    }
    row: s32 = 0
    while row < radius {
        dy := radius - row - 1
        inset: s32 = 0
        while inset < radius {
            dx := radius - inset - 1
            if dx * dx + dy * dy <= radius * radius {
                break
            }
            inset += 1
        }
        if inset > 0 {
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)left, cast(float32)(top + row),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)(right - inset),
                    cast(float32)(top + row), cast(float32)inset, 1.0},
                0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)left,
                    cast(float32)(bottom - row - 1),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)(right - inset),
                    cast(float32)(bottom - row - 1),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
        }
        row += 1
    }
}

GuideProgressDots :: (session: Session, node: s32,
    tip: Rectangle, controls_y: s32, button_size: s32,
    pad: s32, step: s32, count: s32, active: Color,
    muted: Color) {
    dot_size := AppScale(6)
    gap := AppScale(9)
    active_width := AppScale(18)
    x := cast(s32)tip.x + pad
    y := controls_y + (button_size - dot_size) / 2
    index: s32 = 0
    while index < count {
        width := dot_size
        color := muted
        if index == step {
            width = active_width
            color = active
        }
        PaintRoundedFill(session, node,
            Rectangle.{cast(float32)x, cast(float32)y,
                cast(float32)width, cast(float32)dot_size},
            cast(float32)dot_size / 2.0, 8, color)
        x += width + gap
        index += 1
    }
}

#program_export
GuideOverlay :: (guide: GuideOverlayProps) -> GuideOverlayResult {
    result: GuideOverlayResult
    app := CurrentApp()
    if app == null || !SessionValid(app.ui.session)  || guide.steps == null || guide.count <= 0 || guide.step == null {
        return result
    }
    session := app.ui.session
    width := guide.view_width
    height := guide.view_height
    if width <= 0 {
        width = app.ui.view_width
    }
    if height <= 0 {
        height = app.ui.view_height
    }
    step := GuideStepFor(guide.step.*, guide.count)
    anchor := guide.steps[step].anchor
    if anchor.width <= 0.0 || anchor.height <= 0.0 {
        return result
    }
    panel := GuideFace(2)
    metrics := GuideMetricsFor(MetricsScale(), panel,
        GuideFace(24), GuideFace(6), GuideFace(17),
        GuideFace(15))
    if metrics.button_size < AppScale(44) {
        metrics.button_size = AppScale(44)
    }
    if metrics.close_size < AppScale(44) {
        metrics.close_size = AppScale(44)
    }
    if metrics.pad < AppScale(16) {
        metrics.pad = AppScale(16)
    }
    if metrics.anchor_padding < AppScale(12) {
        metrics.anchor_padding = AppScale(12)
    }
    tip_width := GuideTipWidth(width, guide.max_width, metrics)
    maximum_height := GuideMaxTipHeight(height,
        guide.reserved_top, guide.reserved_bottom, metrics)
    font := GuideParagraphFontFor(guide.paragraph_font, 0,
        AppFontSize())
    text_width := tip_width - metrics.pad * 2
    text := guide.steps[step].text
    text_height := AppParagraphHeight(text, text_width, font,
        metrics.default_line_gap)
    while GuideShouldShrinkParagraphFont(text_height,
        GuideParagraphHeightLimit(maximum_height, metrics),
        font, AppSmallFontSize()) {
        font -= 1
        text_height = AppParagraphHeight(text, text_width, font,
            metrics.default_line_gap)
    }
    tip := GuideTipBounds(anchor, tip_width,
        GuideTipHeight(text_height, maximum_height, metrics),
        width, height, guide.reserved_top, guide.reserved_bottom,
        metrics)
    layout := GuideLayoutFor(tip, text_width, text_height,
        step, guide.count, metrics)
    guide_layout = layout
    overlay_props: DismissibleOverlayProps
    overlay_props.key = cast(u64)83100
    overlay_props.bounds = tip
    overlay_props.view_width = width
    overlay_props.view_height = height
    overlay := DismissibleOverlay(session, overlay_props)
    if overlay.closed {
        result.closed = 1
        result.step = step
        return result
    }
    if overlay.node < 0 || overlay.panel_node < 0 {
        return result
    }
    scrim := GuideScrimFor(width, height, anchor, metrics)
    scrim_face := GuideFace(19)
    scrim_color := ColorFromPacked(Opacity(
        scrim_face.value.background, scrim_face.value.opacity))
    PaintRoundedFill(session, overlay.node, scrim.top, 0.0, 4,
        scrim_color)
    PaintRoundedFill(session, overlay.node, scrim.bottom, 0.0, 4,
        scrim_color)
    PaintRoundedFill(session, overlay.node, scrim.left, 0.0, 4,
        scrim_color)
    PaintRoundedFill(session, overlay.node, scrim.right, 0.0, 4,
        scrim_color)
    GuideRoundedScrimCorners(session, overlay.node, scrim,
        scrim_color)
    focus := Rectangle.{scrim.left.width, scrim.top.height,
        scrim.right.x - scrim.left.width,
        scrim.bottom.y - scrim.top.height}
    focus_radius := cast(float32)AppScale(12)
    if focus_radius > focus.height / 2.0 {
        focus_radius = focus.height / 2.0
    }
    if focus_radius > focus.width / 2.0 {
        focus_radius = focus.width / 2.0
    }
    ink := ColorFromPacked(GuideFace(24).value.foreground)
    PaintRoundedOutline(session, overlay.node, focus,
        focus_radius, 12,
        cast(float32)metrics.anchor_stroke, ink)
    panel_color := ColorFromPacked(Opacity(panel.value.background,
        panel.value.opacity))
    panel_radius := panel.value.radius
    if panel_radius < cast(float32)AppScale(18) {
        panel_radius = cast(float32)AppScale(18)
    }
    PaintRoundedFill(session, overlay.panel_node, tip,
        panel_radius, 16, panel_color)
    if panel.value.border_width > 0.0 {
        PaintRoundedOutline(session, overlay.panel_node, tip,
            panel_radius, 16, panel.value.border_width,
            ColorFromPacked(panel.value.border))
    }
    if !TreePushScope(session, overlay.panel_node) {
        return result
    }
    title := GuidePageLabel(app, step, guide.count)
    title_width := tip.width -         cast(float32)(metrics.pad * 2 + metrics.close_size +         metrics.nav_gap)
    title_props: TextProps
    title_props.text = title
    title_props.bounds = Rectangle.{tip.x + cast(float32)metrics.pad,
        tip.y + cast(float32)metrics.pad, title_width,
        cast(float32)metrics.close_size
    }
    title_props.font = AppFitFontSize(title, cast(s32)title_width,
        AppScale(Text16), AppSmallFontSize())
    title_props.wrap = cast(TextWrap)TextWrapNone
    title_props.vertical_align = cast(TextAlign)TextAlignCenter
    title_props.style_kind = StyleKindGuide()
    Text(session, title_props)

    paragraph: TextProps
    paragraph.text = text
    paragraph.bounds = layout.text
    paragraph.font = font
    paragraph.wrap = cast(TextWrap)TextWrapAuto
    paragraph.style_kind = StyleKindGuide()
    Text(session, paragraph)

    GuideProgressDots(session, overlay.panel_node, tip,
        layout.controls_y, metrics.button_size, metrics.pad,
        step, guide.count, ink,
        ColorFromPacked(panel.value.border))

    previous := guide.previous_requested
    next := guide.next_requested
    close := guide.close_requested
    button: ButtonProps
    button.id = 83110
    button.bounds = layout.close_button
    button.label = LocaleText("close_button")
    button.image = ActionImage(ActionIcon.IconClose,
        button.label)
    button.icon_only = true
    button.circle = true
    button.tone = cast(ButtonTone)ButtonToneNeutral
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    if Button(session, button) != 0 {
        close = true
    }
    if step > 0 {
        button.id = 83111
        button.bounds = layout.back_button
        button.label = LocaleText("back_button")
        button.image.asset_path = ""
        button.arrow = true
        button.direction = cast(ArrowDirection)ArrowLeft
        button.tone = cast(ButtonTone)ButtonToneNeutral
        button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        if Button(session, button) != 0 {
            previous = true
        }
    }
    button.id = 83112
    button.bounds = layout.next_button
    button.label = LocaleText("next_button")
    button.image.asset_path = ""
    button.arrow = true
    button.direction = cast(ArrowDirection)ArrowRight
    button.tone = cast(ButtonTone)ButtonToneAccent
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    if layout.finish {
        button.label = LocaleText("practice_start_button")
        button.arrow = false
        button.image = ActionImage(ActionIcon.IconCheck,
            button.label)
    }
    if Button(session, button) != 0 {
        next = true
    }
    unused End(session)
    policy := GuidePolicyFor(step, guide.count, previous,
        next, close)
    guide.step.* = policy.step
    result.step = policy.step
    result.changed = ifx policy.changed then 1 else 0
    result.closed = ifx policy.closed then 1 else 0
    result.finished = ifx policy.finished then 1 else 0
    return result
}

#program_export
PracticeControlRow :: (row: IconRowRequest) -> IconRowResult {
    result: IconRowResult
    result.clicked_index = -1
    app := CurrentApp()
    if app == null || !SessionValid(app.ui.session)  || row.items == null || row.count <= 0 {
        return result
    }
    props: BottomIconRowProps
    props.center_x = row.center_x
    props.view_width = row.view_width
    props.view_height = row.view_height
    props.count = row.count
    layout := BottomIconRowLayoutFor(props, MetricsScale())
    result.y = layout.y
    result.button_width = layout.button_width
    index: s32 = 0
    while index < row.count {
        action := row.items[index]
        button: ButtonProps
        button.id = cast(s32)83000 + index
        button.bounds = BottomIconRowButtonBoundsFor(layout,
            index)
        button.label = ActionLabel(action.icon)
        button.image = ActionImage(action.icon,
            button.label)
        button.icon_only = true
        button.tone = cast(ButtonTone)ButtonToneNeutral
        button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        button.disabled = action.disabled
        if Button(app.ui.session, button) != 0 {
            result.clicked_index = index
        }
        index += 1
    }
    return result
}
