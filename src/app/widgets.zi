guide_layout: GuideLayout;

// Inbe's active modal and guide actions use the shared icon atlas.
ActionImage :: (icon: ActionIcon, label: string) -> Image.Props {
    image: Image.Props
    image.asset_path = "icons/ui.webp"
    image.alt_text = label
    x: s32 = 0
    y: s32 = 0
    if icon == ActionIcon.IconBack {
        x = 128
    } else if icon == ActionIcon.IconCheck {
        x = 320
    } else if icon == ActionIcon.IconNext {
        x = 128
        y = 64
    } else if icon == ActionIcon.IconPause {
        x = 64
        y = 192
    } else if icon == ActionIcon.IconPlay {
        x = 256
        y = 192
    } else if icon == ActionIcon.IconClose {
        x = 448
        y = 384
    } else {
        image.asset_path = ""
        return image
    }
    image.source = Rectangle.{cast(float32)x, cast(float32)y,
        64.0, 64.0
    }
    return image
}

ActionLabel :: (icon: ActionIcon) -> string {
    if icon == ActionIcon.IconBack {
        return LocaleText("back_button")
    }
    if icon == ActionIcon.IconNext {
        return LocaleText("next_button")
    }
    if icon == ActionIcon.IconPause {
        return LocaleText("pause_button")
    }
    if icon == ActionIcon.IconPlay {
        return LocaleText("play_button")
    }
    if icon == ActionIcon.IconClose {
        return LocaleText("close_button")
    }
    return LocaleText("practice_start_button")
}

GuideFace :: (role: s32) -> StyleFrame {
    face: StyleData = Modal.ModalFrameDefaultFace(Modal.ModalPanelRole())
    if role == 19 {
        face = Modal.ModalFrameDefaultFace(Modal.ModalScrimRole())
    }
    facts := StyleControlRoleFacts(StyleKindGuide(), 0, 0, role,
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisSoft,
        cast(s32)ControlSizeMedium, cast(s32)ButtonStateNormal)
    frame: StyleFrame
    frame.value = ResolveInstalledStyleRules(face, facts,
        cast(s32)ButtonStateNormal)
    return frame
}

GuidePageLabel :: (app: *InnerBreeze, step: s32,
    count: s32) -> string {
    page: [96]u8
    if !FormatTwoNumberTemplate(LocaleText("tutorial_step_progress"),
        step + 1, count, page[:]) {
        return ""
    }
    return FrameTextHold(*app.ui.frame_text,
        AppTextFromCString(*page[0], 96))
}

GuideRoundedScrimCorners :: (session: Session, node: s32,
    scrim: GuideScrim, color: Color) {
    left := cast(s32)scrim.left.width
    right := cast(s32)scrim.right.x
    top := cast(s32)scrim.top.height
    bottom := cast(s32)scrim.bottom.y
    radius := AppScale(12)
    if radius > (right - left) / 2 {
        radius = (right - left) / 2
    }
    if radius > (bottom - top) / 2 {
        radius = (bottom - top) / 2
    }
    if radius <= 0 {
        return
    }
    row: s32 = 0
    while row < radius {
        dy := radius - row - 1
        inset: s32 = 0
        while inset < radius {
            dx := radius - inset - 1
            if dx * dx + dy * dy <= radius * radius {
                break
            }
            inset += 1
        }
        if inset > 0 {
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)left, cast(float32)(top + row),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)(right - inset),
                    cast(float32)(top + row), cast(float32)inset, 1.0},
                0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)left,
                    cast(float32)(bottom - row - 1),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
            PaintRoundedFill(session, node,
                Rectangle.{cast(float32)(right - inset),
                    cast(float32)(bottom - row - 1),
                    cast(float32)inset, 1.0}, 0.0, 4, color)
        }
        row += 1
    }
}

GuideProgressDots :: (session: Session, node: s32,
    tip: Rectangle, controls_y: s32, button_size: s32,
    pad: s32, step: s32, count: s32, active: Color,
    muted: Color) {
    dot_size := AppScale(6)
    gap := AppScale(9)
    active_width := AppScale(18)
    x := cast(s32)tip.x + pad
    y := controls_y + (button_size - dot_size) / 2
    index: s32 = 0
    while index < count {
        width := dot_size
        color := muted
        if index == step {
            width = active_width
            color = active
        }
        PaintRoundedFill(session, node,
            Rectangle.{cast(float32)x, cast(float32)y,
                cast(float32)width, cast(float32)dot_size},
            cast(float32)dot_size / 2.0, 8, color)
        x += width + gap
        index += 1
    }
}

// A guide step whose text and Lumi's voice clip share one locale key.
#program_export
GuideOverlayStepFor :: (anchor: Rectangle, key: string) -> GuideOverlayStep {
    return GuideOverlayStep.{anchor, LocaleText(key), key}
}

GuideStepGeometry :: struct {
    place: GuideLumiPlacement
    font: s32
    text_width: s32
    text_height: s32
}

// A step's bubble, sized to its text, and Lumi's place beside it. The bubble
// leaves room at its side for Lumi.
GuideStepGeometryFor :: (guide: GuideOverlayProps, step: s32, width: s32,
    height: s32, metrics: GuideMetrics) -> GuideStepGeometry {
    geometry: GuideStepGeometry
    lumi_width := AppScale(LUMI_GUIDE_WIDTH)
    lumi_height := lumi_width * LUMI_SHEET_FRAME_HEIGHT / LUMI_SHEET_FRAME_WIDTH
    lumi_room := lumi_width - lumi_width / 4
    tip_width := GuideTipWidth(width - lumi_room, guide.max_width, metrics)
    maximum_height := GuideMaxTipHeight(height,
        guide.reserved_top, guide.reserved_bottom, metrics)
    font := GuideParagraphFontFor(guide.paragraph_font, 0,
        AppFontSize())
    text_width := tip_width - metrics.pad * 2
    text := guide.steps[step].text
    text_height := AppParagraphHeight(text, text_width, font,
        metrics.default_line_gap)
    while GuideShouldShrinkParagraphFont(text_height,
        GuideParagraphHeightLimit(maximum_height, metrics),
        font, AppSmallFontSize()) {
        font -= 1
        text_height = AppParagraphHeight(text, text_width, font,
            metrics.default_line_gap)
    }
    tip := GuideTipBounds(guide.steps[step].anchor, tip_width,
        GuideTipHeight(text_height, maximum_height, metrics),
        width, height, guide.reserved_top, guide.reserved_bottom,
        metrics)
    geometry.place = GuideLumiPlacementFor(tip, width, height, lumi_width,
        lumi_height, metrics.margin, metrics.pad + metrics.close_size / 2)
    geometry.font = font
    geometry.text_width = text_width
    geometry.text_height = text_height
    return geometry
}

// Where Lumi sets off when a guide appears: from her place at the step
// before, as if she had just been there, or for the first step from above
// the screen.
GuideLumiOrigin :: (guide: GuideOverlayProps, step: s32, width: s32,
    height: s32, metrics: GuideMetrics, current: GuideStepGeometry) -> Vector2 {
    if step > 0 && guide.steps[step - 1].anchor.width > 0.0 &&
    guide.steps[step - 1].anchor.height > 0.0 {
        previous := GuideStepGeometryFor(guide, step - 1, width, height,
            metrics)
        return Vector2.{previous.place.lumi.x, previous.place.lumi.y}
    }
    return Vector2.{current.place.lumi.x,
        0.0 - current.place.lumi.height * 1.5}
}





// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
GuideOverlay :: (guide: GuideOverlayProps) -> GuideOverlayResult {
    return GuideOverlayView(guide)
}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
PracticeControlRow :: (row: IconRowRequest) -> Toolbar.IconRowResult {
    return PracticeControlRowView(row)
}
