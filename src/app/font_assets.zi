FONT_LATIN :: "assets/fonts/subset/NotoSans-App-Regular.ttf"

FONT_SC :: "assets/fonts/subset/NotoSansSC-App-Regular.otf"

FONT_JP :: "assets/fonts/subset/NotoSansJP-App-Regular.otf"

FONT_KR :: "assets/fonts/subset/NotoSansKR-App-Regular.otf"

FONT_TC :: "assets/fonts/subset/NotoSansTC-App-Regular.otf"

#program_export
FontAssetForLocale :: (code: string) -> string {
    if code == "zh" {
        return FONT_SC
    }
    if code == "ja" {
        return FONT_JP
    }
    if code == "ko" {
        return FONT_KR
    }
    if code == "zh-TW" || code == "zh_Hant" {
        return FONT_TC
    }
    return FONT_LATIN
}
