// A compact graphical control returns an unpinned app to Apps. Reserve its
// target above the page so it never covers the app's own controls.
#import "geometry"
Button :: #import "kryon/button";
Image :: #import "kryon/image";
Layout :: #import "kryon/layout";
#import "control_props"
CompressionIcon :: #import "mingcute/mingcute_regular_tool";
#import, file "app_types.zi";
#import, file "../core/types.zi";
#import, file "route_types.zi";
#import, file "../habits/habit_types.zi";
#import, file "app_nav_state.zi";
#import, file "app_launcher_state.zi";
#import, file "app_modal_state.zi";
#import, file "launcher_policy.zi";
#import, file "route_list.zi";
#import, file "metrics.zi";
#import, file "locale.zi";
#import, file "mini_mode.zi";
#import, file "../apps/module_host.zi";
#import, file "../apps/node_apps.zi";
#import, file "../apps/media_compression_request.zi";
#import, file "../platform/environment.zi";

using AppNavRoute;
using ButtonTone;
using ButtonEmphasis;
using Image.ImageFit;

// The app on screen when Apps opened it and it has no visible pin.
#program_export
app_return_bar_route :: (app: *InnerBreeze) -> s32 {
    if app == null || AppMiniMode() || app.host_feature != 0 || PreviewMode() != 0 ||
    app.launcher_open {
        return APP_NAV_ROUTE_NONE
    }
    // Profile owns its title and Back stack, including Account and Activity.
    // An unpinned Profile uses that same bar to return to Apps.
    if app.breathing.screen == ScreenProfile {
        return APP_NAV_ROUTE_NONE
    }
    // Photos keeps an account-storage entry in the reserved host bar,
    // including when the app owns its own header or is pinned.
    if app.breathing.screen == ScreenNodeApp && NodeAppName(app.node_app_slot) == "photos" {
        return app_current_nav_route(app)
    }
    if app.breathing.screen == ScreenNodeApp && NodeAppOwnHeader(app.node_app_slot) {
        return APP_NAV_ROUTE_NONE
    }
    route := app_current_nav_route(app)
    apps := LauncherRoutes()
    if !RouteListContains(apps[:], cast(s32)apps.count, route) {
        return APP_NAV_ROUTE_NONE
    }
    if app.breathing.screen == ScreenNodeApp && NodeAppImmersive(app.node_app_slot) {
        return route
    }
    for index: cast(s32)0..app.launcher_favorite_count - 1 {
        if app.launcher_favorites[index] == route && app_nav_route_available(app, route) {
            return APP_NAV_ROUTE_NONE
        }
    }
    return route
}

#program_export
app_return_bar_height :: (app: *InnerBreeze) -> s32 {
    if app_return_bar_route(app) == APP_NAV_ROUTE_NONE {
        return 0
    }
    return AppTitleBarHeight()
}

app_return_to_apps :: (app: *InnerBreeze) {
    app_block_current_click(app)
    if !app.launcher_open {
        app_launcher_open(app)
    }
}

app_node_app_back :: (app: *InnerBreeze) -> bool {
    if app.breathing.screen != ScreenNodeApp || !NodeAppBack(app.node_app_slot) {
        return false
    }
    app_block_current_click(app)
    return true
}

// Back at an unpinned app's first page returns to Apps; inner pages keep
// their own Back.
app_return_bar_takes_back :: (app: *InnerBreeze) -> bool {
    route := app_return_bar_route(app)
    if route == APP_NAV_ROUTE_NONE {
        return false
    }
    if route == APP_NAV_ROUTE_HABITS {
        return app.habits.screen_mode != HABITS_SCREEN_HISTORY &&
        app.habits.screen_mode != HABITS_SCREEN_STATISTICS &&
        app.habits.screen_mode != HABITS_SCREEN_SHOP &&
        !(app.habits.tab == HABIT_TAB_EDIT && app.habit_edit.active != 0)
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return app.practice_tab == PRACTICE_TAB_PLAY
    }
    return true
}

#program_export
app_draw_return_bar :: (app: *InnerBreeze) {
    route := app_return_bar_route(app)
    if route == APP_NAV_ROUTE_NONE || app.file_dialog_active != 0 {
        return
    }
    height := cast(float32)app_return_bar_height(app)
    control := cast(float32)AppScale(44)
    inset := cast(float32)AppScale(8)
    y := -height + (height - control) / 2.0
    label := LocaleText(ifx app.breathing.screen == ScreenNodeApp then "back_button"
        else "return_to_apps")
    if Button.Draw(app.ui.session, Button.Props.{.key = Layout.KeyHash("inbe/return-to-apps"),
        .bounds = Rectangle.{inset, y, control, control}, .label = label,
        .image = Image.Props.{.asset_path = "assets/app/back-home.avif",
            .alt_text = label, .fit = cast(Image.ImageFit)ImageFitContain, .smooth = true},
        .icon_only = true, .circle = true, .disabled = app.modal.active != 0,
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 && !app_node_app_back(app) {
        app_return_to_apps(app)
    }
    photos := app.breathing.screen == ScreenNodeApp && NodeAppName(app.node_app_slot) == "photos"
    if photos {
        if Button.Draw(app.ui.session, Button.Props.{.key = Layout.KeyHash("media/compression/settings"),
            .bounds = Rectangle.{cast(float32)app.ui.view_width - inset - control, y, control, control},
            .label = LocaleText("media_compression_title"), .icon_shape = CompressionIcon.Shape,
            .icon_only = true, .disabled = app.modal.active != 0,
            .tone = cast(ButtonTone)ButtonToneNeutral,
            .emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost}) != 0 {
            app_block_current_click(app)
            MediaCompressionRequest()
        }
    }
}
