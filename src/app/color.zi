#import "drawing_props"

// The colour at an opacity from 0 (clear) to 1 (opaque). Its alpha becomes
// 255 times the opacity, clamped to that range and rounded down, as raylib's
// Fade sets it.
color_with_alpha :: (color: Color, opacity: float32) -> Color {
    if opacity < 0.0 {
        opacity = 0.0
    }
    if opacity > 1.0 {
        opacity = 1.0
    }
    color.a = cast(u8)(255.0 * opacity)
    return color
}
