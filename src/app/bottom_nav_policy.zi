#import, file "route_types.zi";
#import, file "route_list.zi";

using AppNavRoute;

BOTTOM_NAV_MAX_ROUTES :: 7

BottomNavDefaults :: (routes: []s32) -> s32 {
    if routes.count < 5 {
        return 0
    }
    routes[0] = APP_NAV_ROUTE_LUMI
    routes[1] = APP_NAV_ROUTE_ELIST
    routes[2] = APP_NAV_ROUTE_HABITS
    routes[3] = APP_NAV_ROUTE_PRACTICE
    routes[4] = APP_NAV_ROUTE_SETTINGS
    return 5
}

BottomNavSanitize :: (routes: []s32, count: s32,
    profile_allowed: bool) -> s32 {
    if routes.count < 5 {
        return 0
    }
    if count < 0 || count > BOTTOM_NAV_MAX_ROUTES {
        return BottomNavDefaults(routes)
    }
    allowed: [7]s32
    allowed[0] = APP_NAV_ROUTE_HABITS
    allowed[1] = APP_NAV_ROUTE_ELIST
    allowed[2] = APP_NAV_ROUTE_PRACTICE
    allowed[3] = APP_NAV_ROUTE_DIARY
    allowed[4] = APP_NAV_ROUTE_LUMI
    allowed_count: s32 = 5
    if profile_allowed {
        allowed[allowed_count] = APP_NAV_ROUTE_PROFILE
        allowed_count += 1
    }
    count = RouteListSanitize(routes, count, allowed[0:allowed_count])
    // Settings occupies the final fixed slot, outside the editable routes.
    if count >= BOTTOM_NAV_MAX_ROUTES {
        count = BOTTOM_NAV_MAX_ROUTES - 1
    }
    if count >= cast(s32)routes.count {
        count = cast(s32)routes.count - 1
    }
    routes[count] = APP_NAV_ROUTE_SETTINGS
    count += 1
    return count
}
