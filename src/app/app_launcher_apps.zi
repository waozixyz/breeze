using WidgetKind;
using AppNavRoute;

LauncherAppEntry :: struct {
    id: [128]u8
    route: s32
    offer: [25]u8
    package: s32
}

LauncherAppGroup :: struct {
    controller: Controller.AppController
    owner: *InnerBreeze
    index: s32
    account: [65]u8
    entries: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]LauncherAppEntry
    count: s32
    responses: [4]string
    response_count: s32
    pending: Rules.AppsRequest
    has_pending: bool
    sequence: s64
    status: string
}

launcher_app_groups: [2]LauncherAppGroup;
launcher_app_catalogs: [2]string;
// Each group's catalog without its revision, and that revision. The Apps
// controller keeps an unchanged catalog instead of parsing it every frame.
launcher_app_catalog_bodies: [2]string;
launcher_app_revisions: [2]s64;
launcher_app_button_codec: WidgetButtonPropsCodec;

LauncherAppPackage :: (route: s32) -> s32 {
    slot := AppNavNodeSlot(route)
    if slot >= 0 { return NodeAppIndex(slot) }
    bit := app_nav_route_bit(route)
    for index: cast(s32)1..PackageCount - 1 {
        if PackageBit(index) == bit { return index }
    }
    return -1
}

// A returned document stays valid until the controller's Run returns.
LauncherAppKeep :: (group: *LauncherAppGroup, text: string) -> string {
    if group.response_count >= group.responses.count {
        PackageFree(text)
        return ""
    }
    group.responses[group.response_count] = text
    group.response_count += 1
    return text
}

LauncherAppReply :: (group: *LauncherAppGroup, status: string) -> string {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"status\":\"%\",\"request\":%}", status, group.sequence)
    return LauncherAppKeep(group, BuilderFinish(bytes))
}

// The Apps controller reads at most 64 icon choices and shows none when
// offered more, so Properties offers the app's own and Inbe's first 63.
LAUNCHER_APP_ICON_LIMIT :: 63

// The icons Properties offers: the app's own, then Inbe's icon set.
LauncherAppIcons :: (group: *LauncherAppGroup, id: string) -> string {
    at := LauncherAppFind(group, id)
    if at < 0 || group.entries[at].route < 0 {
        return ""
    }
    own := app_nav_route_own_shape(group.entries[at].route)
    if own == "" {
        own = NODE_APP_GENERIC_ICON
    }
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"icons\":[{\"id\":\"\"")
    LauncherAppQuoted(*bytes, "shape", own)
    BuilderPrint(*bytes, "}")
    last: s32 = HABIT_ICON_COUNT
    if last > LAUNCHER_APP_ICON_LIMIT { last = LAUNCHER_APP_ICON_LIMIT }
    for icon: cast(s32)1..last {
        BuilderPrint(*bytes, ",{\"id\":")
        Rules.AppsWriteQuoted(*bytes, HabitIconName(icon))
        LauncherAppQuoted(*bytes, "shape", HabitIconShape(icon))
        BuilderPrint(*bytes, "}")
    }
    BuilderPrint(*bytes, "]}")
    return LauncherAppKeep(group, BuilderFinish(bytes))
}

LauncherAppFind :: (group: *LauncherAppGroup, id: string) -> s32 {
    for index: cast(s32)0..group.count - 1 {
        if TextUntilNul(group.entries[index].id[:]) == id { return index }
    }
    return -1
}

LauncherAppService :: (context: *void, text: string) -> string {
    group := cast(*LauncherAppGroup)context
    request: Rules.AppsRequest
    if !Rules.AppsReadRequest(text, *request) { return "" }
    if request.operation == Rules.APPS_CATALOG {
        if request.revision > 0 && request.revision == launcher_app_revisions[group.index] {
            return "{\"v\":1,\"unchanged\":true}"
        }
        return launcher_app_catalogs[group.index]
    }
    if request.operation == Rules.APPS_STATUS {
        if request.request != group.sequence { return "" }
        return LauncherAppReply(group, group.status)
    }
    if request.operation == Rules.APPS_ICONS {
        return LauncherAppIcons(group, TextUntilNul(request.id[:]))
    }
    if group.has_pending || TextUntilNul(group.account[:]) != NodeTreeAccount() ||
    LauncherAppFind(group, TextUntilNul(request.id[:])) < 0 {
        return LauncherAppReply(group, "rejected")
    }
    group.sequence += 1
    group.pending = request
    group.has_pending = true
    group.status = "queued"
    return LauncherAppReply(group, group.status)
}

LauncherAppWidgets :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    group := cast(*LauncherAppGroup)context
    called := WidgetHostCall(context, module, function, arguments, count, result)
    if called == 0 || TextFromCString(function) != "ButtonHostedHost" || count != 2 ||
    !WidgetValidButtonProps(arguments[1]) { return called }
    card := WidgetDecodeButtonProps(arguments[1], *launcher_app_button_codec)
    for index: cast(s32)0..group.count - 1 {
        entry := group.entries[index]
        if entry.route < 0 || card.key != Rules.AppCardKey(TextUntilNul(entry.id[:])) { continue }
        // Only the base card captures native drag. The menu/update buttons
        // retain their own keys and ordinary pointer behavior.
        unused app_launcher_drag_card(group.owner, card, entry.route, true)
        node := TreeSubmitted(group.owner.ui.session, TreeCurrentParent(group.owner.ui.session),
            card.key, WidgetKindButton)
        TreeSetDragCapture(group.owner.ui.session, node, !card.disabled)
        break
    }
    return called
}

LauncherAppAssetAllowed :: (path: string) -> bool {
    if path == "" { return true }
    return Rules.AppPreviewPathValid(path) && AssetRead(path).found
}

LauncherAppDrain :: (group: *LauncherAppGroup) {
    if !group.has_pending { return }
    group.has_pending = false
    request := group.pending
    at := LauncherAppFind(group, TextUntilNul(request.id[:]))
    if at < 0 || TextUntilNul(group.account[:]) != NodeTreeAccount() ||
    group.owner.blocked_input_frame == group.owner.breathing.frame {
        group.status = "rejected"
        return
    }
    entry := group.entries[at]
    app := group.owner
    route := entry.route
    if route < 0 {
        name := TextUntilNul(entry.offer[:])
        if request.operation != Rules.APPS_OPEN && request.operation != Rules.APPS_INSTALL {
            group.status = "rejected"
            return
        }
        slot := app_launcher_install_offer(app, name)
        if slot < 0 { group.status = "rejected"; return }
        if request.operation == Rules.APPS_OPEN { app_launcher_activate(app, AppNavNodeRoute(slot)) }
        group.status = "applied"
        return
    }
    if LauncherAppPackage(route) != entry.package ||
    PackageID(entry.package) != TextUntilNul(entry.id[:]) {
        group.status = "rejected"
        return
    }
    if request.operation == Rules.APPS_OPEN {
        if !app.launcher_drag_moving { app_launcher_activate(app, route) }
    } else if request.operation == Rules.APPS_INSTALL && AppNavNodeSlot(route) >= 0 &&
    !NodeAppInstalled(AppNavNodeSlot(route)) {
        // Its download symbol: the package downloads, and the card says so.
        unused app_nav_node_app_ready(app, AppNavNodeSlot(route))
        group.status = "queued"
        return
    } else if request.operation == Rules.APPS_INSTALL {
        if !app_launcher_install(app, route) { group.status = "rejected"; return }
    } else if request.operation == Rules.APPS_UNINSTALL {
        app_launcher_uninstall(app, route)
    } else if request.operation == Rules.APPS_PIN || request.operation == Rules.APPS_UNPIN {
        favorite := app_launcher_is_favorite(app, route)
        requested := request.operation == Rules.APPS_PIN
        if favorite != requested {
            if requested && !app_launcher_install(app, route) { group.status = "rejected"; return }
            app.launcher_favorite_count = LauncherToggleFavorite(app.launcher_favorites[:],
                app.launcher_favorite_count, route)
            app_launcher_pins_changed(app)
            app_block_current_click(app)
        }
    } else if request.operation == Rules.APPS_INSTALL_TO_LAUNCHER && LauncherShortcutSupported() {
        app_launcher_pin(app, route)
    } else if request.operation == Rules.APPS_UPDATE && PackageUpdateAvailable(entry.package) &&
    TextUntilNul(request.version[:]) == PackageAvailableVersion(entry.package) &&
    TextUntilNul(request.sha256[:]) == PackageAvailableDigest(entry.package) {
        // The transfer also binds the exact confirmed version/digest.
        if !PackageRequestVersion(entry.package, TextUntilNul(request.version[:]),
                TextUntilNul(request.sha256[:]), NodeTreeAccount()) { group.status = "rejected"; return }
        group.status = "queued"
        return
    } else if request.operation == Rules.APPS_ROLLBACK {
        if !PackageRollbackRequest(entry.package, TextUntilNul(request.version[:]),
                TextUntilNul(request.sha256[:]), NodeTreeAccount()) {
            group.status = "rejected"
            return
        }
        group.status = "queued"
        return
    } else if request.operation == Rules.APPS_PROPERTIES {
        if !AppPropertiesSave(LauncherRouteName(route), TextUntilNul(request.title[:]),
                TextUntilNul(request.icon[:])) {
            group.status = "rejected"
            return
        }
    } else if request.operation == Rules.APPS_SEEN && PackageUpdateAvailable(entry.package) &&
    TextUntilNul(request.version[:]) == PackageAvailableVersion(entry.package) &&
    TextUntilNul(request.sha256[:]) == PackageAvailableDigest(entry.package) {
        // Only the exact offer shown in the menu stops showing its dot.
        if !AppPropertiesSaveSeen(LauncherRouteName(route), PackageAvailableDigest(entry.package)) {
            group.status = "rejected"
            return
        }
    } else {
        group.status = "rejected"
        return
    }
    group.status = "applied"
}

LauncherAppQuoted :: (bytes: *Vec(u8), key: string, value: string) {
    BuilderPrint(bytes, ",\"%\":", key)
    Rules.AppsWriteQuoted(bytes, value)
}

LauncherAppCatalogEntry :: (group: *LauncherAppGroup, bytes: *Vec(u8), route: s32,
    offer: s32 = -1) {
    if group.count >= group.entries.count { return }
    entry: LauncherAppEntry
    entry.route = route
    entry.package = LauncherAppPackage(route)
    title := app_nav_route_label(route)
    shape := app_nav_route_shape(route)
    installed := route >= 0 && ((group.owner.enabled_apps & app_nav_route_bit(route)) != 0 ||
        AppNavNodeSlot(route) >= 0)
    // An app from the node is on this device once its package is; until
    // then its card shows the download symbol, and that it is downloading.
    node_slot := ifx route >= 0 then AppNavNodeSlot(route) else -1
    on_device := installed && (node_slot < 0 || NodeAppInstalled(node_slot))
    downloading := installed && !on_device && PackagePending(NodeAppIndex(node_slot))
    size: s64
    if route >= 0 {
        unused CopyCString(PackageID(entry.package), entry.id[:])
        if AppNavNodeSlot(route) >= 0 { size = NodeAppPackageSize(AppNavNodeSlot(route)) }
        else { size = CellsPackageSize(entry.package) }
    } else {
        name := NodeAppOfferName(offer)
        unused CopyCString(name, entry.offer[:])
        id := PackageText("inbe.", name)
        unused CopyCString(id, entry.id[:])
        PackageFree(id)
        title = NodeAppTitle(name)
        shape = NODE_APP_GENERIC_ICON
        size = NodeAppOfferSize(offer)
    }
    if group.count > 0 { BuilderPrint(bytes, ",") }
    group.entries[group.count] = entry
    group.count += 1
    BuilderPrint(bytes, "{\"id\":")
    Rules.AppsWriteQuoted(bytes, TextUntilNul(entry.id[:]))
    LauncherAppQuoted(bytes, "title", title)
    LauncherAppQuoted(bytes, "icon_shape", shape)
    // A picture is named only once it can be read: the host refuses a card
    // whose picture is missing, and with it the whole Apps screen. Lumi's
    // comes with its package, which opens after the first frame; until then
    // its card shows its symbol.
    if route >= 0 && AppNavNodeSlot(route) < 0 {
        if route == APP_NAV_ROUTE_LUMI {
            if LauncherAppAssetAllowed("assets/lumi/sidebar.png") {
                LauncherAppQuoted(bytes, "icon", "assets/lumi/sidebar.png")
            }
        } else {
            prefix := PackageText("assets/apps/icons/", PackageName(entry.package))
            image := PackageText(prefix, ".png")
            if LauncherAppAssetAllowed(image) { LauncherAppQuoted(bytes, "icon", image) }
            PackageFree(prefix)
            PackageFree(image)
        }
    }
    // Properties starts from what the person chose and can restore the app's own.
    app_name := ifx route >= 0 then LauncherRouteName(route) else ""
    if AppPropertiesTitle(app_name).count > 0 {
        LauncherAppQuoted(bytes, "original_title", app_nav_route_own_label(route))
    }
    if AppPropertiesIcon(app_name).count > 0 {
        LauncherAppQuoted(bytes, "icon_choice", AppPropertiesIcon(app_name))
    }
    favorite := route >= 0 && app_launcher_is_favorite(group.owner, route)
    selected := route >= 0 && bottom_nav_route_active(group.owner, route)
    // A blocked frame's actions are rejected in LauncherAppDrain. Marking the
    // cards disabled for that one frame changed the catalog twice whenever
    // Apps opened, and each change re-parses it in the Apps controller:
    // about 0.4 s on a slow phone.
    BuilderPrint(bytes, ",\"installed\":%,\"favorite\":%,\"selected\":%,\"bytes\":%,\"actions\":[\"open\"",
        ifx installed then "true" else "false", ifx favorite then "true" else "false",
        ifx selected then "true" else "false", size)
    if installed {
        BuilderPrint(bytes, ",\"uninstall\",\"%\"", ifx favorite then "unpin" else "pin")
        if LauncherShortcutSupported() { BuilderPrint(bytes, ",\"install_to_launcher\"") }
    }
    if !on_device { BuilderPrint(bytes, ",\"install\"") }
    update := installed && entry.package >= 0 && PackageUpdateAvailable(entry.package)
    if installed && entry.package >= 0 { PackageHistoryRequest(entry.package) }
    history_count := ifx installed then PackageHistoryCount(entry.package) else 0
    if update { BuilderPrint(bytes, ",\"update\"") }
    if history_count > 0 { BuilderPrint(bytes, ",\"rollback\"") }
    if route >= 0 {
        BuilderPrint(bytes, ",\"properties\"")
    }
    if update {
        BuilderPrint(bytes, ",\"seen\"")
    }
    BuilderPrint(bytes, "]")
    if !on_device {
        BuilderPrint(bytes, ",\"on_device\":false")
        if downloading { BuilderPrint(bytes, ",\"downloading\":true") }
    }
    if entry.package >= 0 {
        LauncherAppQuoted(bytes, "current_version", PackageVersion(entry.package))
        if update {
            BuilderPrint(bytes, ",\"update_available\":true")
            LauncherAppQuoted(bytes, "available_version", PackageAvailableVersion(entry.package))
            LauncherAppQuoted(bytes, "available_sha256", PackageAvailableDigest(entry.package))
            // Its dot stays until the person opens the app's options.
            if AppPropertiesSeen(app_name) == PackageAvailableDigest(entry.package) {
                BuilderPrint(bytes, ",\"update_seen\":true")
            }
        }
        if history_count > 0 {
            BuilderPrint(bytes, ",\"version_history\":[")
            for row: cast(s32)0..history_count - 1 {
                if row > 0 { BuilderPrint(bytes, ",") }
                BuilderPrint(bytes, "{\"version\":")
                Rules.AppsWriteQuoted(bytes, PackageHistoryVersion(entry.package, row))
                LauncherAppQuoted(bytes, "sha256", PackageHistoryDigest(entry.package, row))
                BuilderPrint(bytes, "}")
            }
            BuilderPrint(bytes, "]")
        }
    }
    BuilderPrint(bytes, "}")
}

app_launcher_shared_group :: (app: *InnerBreeze, section: s32, routes: []s32,
    offers: []s32, bounds: Rectangle, input: TextFieldInput) -> bool {
    group := *launcher_app_groups[section]
    group.index = section
    group.owner = app
    if group.controller.ready && TextUntilNul(group.account[:]) != NodeTreeAccount() {
        if !Controller.AppControllerClose(*group.controller) { return false }
    }
    unused CopyCString(NodeTreeAccount(), group.account[:])
    if !group.controller.ready {
        bytes := AssetRead("assets/apps/apps.zib")
        if !bytes.found || !Controller.AppControllerOpen(*group.controller, bytes.data, AppsControllerSha256,
            Controller.AppControllerPlatform.{.context = cast(*void)group,
                .service = LauncherAppService, .widgets = LauncherAppWidgets}) { return false }
    }
    group.count = 0
    document: Vec(u8)
    BuilderPrint(*document, "\"title\":\"\",\"locale\":")
    Rules.AppsWriteQuoted(*document, LocaleActiveCode())
    BuilderPrint(*document, ",\"presentation\":{\"mode\":\"icon\",\"tile_class\":%,\"action_class\":%,\"muted_class\":%},\"children\":[",
        KssClassId(KssMakeName("launcher-tile")), KssClassId(KssMakeName("launcher-action")), KssClassId(KssMakeName("launcher-muted")))
    for route: routes { LauncherAppCatalogEntry(group, *document, route) }
    for offer: offers { LauncherAppCatalogEntry(group, *document, -1, offer) }
    BuilderPrint(*document, "]}")
    body := BuilderFinish(document)
    if launcher_app_revisions[section] > 0 && body == launcher_app_catalog_bodies[section] {
        PackageFree(body)
    } else {
        PackageFree(launcher_app_catalog_bodies[section])
        launcher_app_catalog_bodies[section] = body
        launcher_app_revisions[section] += 1
        catalog: Vec(u8)
        BuilderPrint(*catalog, "{\"v\":1,\"revision\":%,%", launcher_app_revisions[section], body)
        PackageFree(launcher_app_catalogs[section])
        launcher_app_catalogs[section] = BuilderFinish(catalog)
    }
    group.controller.app.session = app.ui.session
    group.controller.app.bounds = bounds
    group.controller.app.dark = app.dark_mode != 0
    group.controller.app.scale = MetricsScale()
    group.controller.app.font = AppFontSize()
    // Typing reaches the field the person focused in Properties.
    group.controller.app.input = input
    WidgetHostBegin(app.ui.session, LauncherAppAssetAllowed, WidgetHostPackedPath)
    ok := Controller.AppControllerRun(*group.controller, APP_FRAME)
    WidgetHostEnd()
    group.controller.app.input = .{}
    LauncherAppDrain(group)
    for index: cast(s32)0..group.response_count - 1 { PackageFree(group.responses[index]) }
    group.response_count = 0
    return ok
}
