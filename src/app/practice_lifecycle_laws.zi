#import, file "practice_lifecycle.zi";

// Laws for practice lifecycle handling. `ziran check` proves them for every
// combination of the flags (each 0 or 1). An implementation edit may not
// change this file.

// Desktop: nothing the platform reports pauses, resumes, or moves a session
// into the background-timer path.
#law DesktopNeverPauses forall a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(0, a, p, b, s, u).pause_session == 0 && practice_lifecycle_decision(0, a, p, b, s, u).resume_session == 0;
#law DesktopKeepsBackgroundState forall a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(0, a, p, b, s, u).background_change == 0 && practice_lifecycle_decision(0, a, p, b, s, u).run_in_background == b && practice_lifecycle_decision(0, a, p, b, s, u).auto_paused_after == u;

// Mobile foreground: an active activity never pauses, and ends any pause the
// lifecycle itself made.
#law ForegroundNeverPauses forall p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(1, 0, p, b, s, u).pause_session == 0 && practice_lifecycle_decision(1, 0, p, b, s, u).run_in_background == 0;
#law ForegroundResumesOwnPause forall p: 0..1, b: 0..1, s: 0..1 => practice_lifecycle_decision(1, 0, p, b, s, 1).resume_session == 1 && practice_lifecycle_decision(1, 0, p, b, s, 1).auto_paused_after == 0;

// Mobile background (owner rule, 2026-10-08): with background play on, a
// session keeps running and is never paused, whatever happens to its
// notification. Only a user who turned background play off gets a pause.
#law BackgroundPlayKeepsRunning forall b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(1, 1, 1, b, s, u).run_in_background == 1 && practice_lifecycle_decision(1, 1, 1, b, s, u).pause_session == 0;
#law BackgroundPlayEndsLifecyclePause forall b: 0..1, s: 0..1 => practice_lifecycle_decision(1, 1, 1, b, s, 1).resume_session == 1 && practice_lifecycle_decision(1, 1, 1, b, s, 1).auto_paused_after == 0;
#law BackgroundPlayOffPauses forall b: 0..1 => practice_lifecycle_decision(1, 1, 0, b, 0, 0).pause_session == 1 && practice_lifecycle_decision(1, 1, 0, b, 0, 0).run_in_background == 0;

// Explicit user pause stays separate: a session the user paused is never
// paused again or resumed by the lifecycle unless the lifecycle paused it.
#law UserPauseIsNeverResumed forall a: 0..1, p: 0..1, b: 0..1 => practice_lifecycle_decision(1, a, p, b, 1, 0).pause_session == 0 && practice_lifecycle_decision(1, a, p, b, 1, 0).resume_session == 0 && practice_lifecycle_decision(1, a, p, b, 1, 0).auto_paused_after == 0;
#law ResumeOnlyOwnPause forall m: 0..1, a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(m, a, p, b, s, u).resume_session == 0 || u == 1;
#law NeverPauseAndResume forall m: 0..1, a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(m, a, p, b, s, u).pause_session == 0 || practice_lifecycle_decision(m, a, p, b, s, u).resume_session == 0;
#law PauseIsRemembered forall m: 0..1, a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => practice_lifecycle_decision(m, a, p, b, s, u).pause_session == 0 || practice_lifecycle_decision(m, a, p, b, s, u).auto_paused_after == 1;

// The background change flag reports exactly a change of state.
#law ChangeMatchesState forall m: 0..1, a: 0..1, p: 0..1, b: 0..1, s: 0..1, u: 0..1 => (practice_lifecycle_decision(m, a, p, b, s, u).background_change == 1) == (practice_lifecycle_decision(m, a, p, b, s, u).run_in_background != b);

#program_export
practice_lifecycle_laws_entry :: () -> s32 {
    return 0
}
