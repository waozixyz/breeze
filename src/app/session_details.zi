// Details captured when a practice ends. They belong to the session, not to
// a manual habit check-off or the practice's current settings.
SessionDetailsVersion :: 1

SessionDetails :: struct {
    version: s32
    duration_seconds: s32
    repetitions: s32
    start_seconds: s32
    end_seconds: s32
    cycles: s32
    item: [96]u8
    title: [160]u8
}
