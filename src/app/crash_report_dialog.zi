// Relaunch crash-report confirmation dialog. Pending crash diagnostics are
// never queued or sent until the person explicitly chooses Send.
Layout :: #import "kryon/layout";
Modal :: #import "kryon/modal";
#import "control_props"
#import "byte_text_linux"
#import "text_buffer"
#import "vec"
#import, file "app_types.zi";
#import, file "modal_rules.zi";
#import, file "app_modal_state.zi";
#import, file "app_toast.zi";
#import, file "settings_actions.zi";
#import, file "locale.zi";
#import, file "mini_mode.zi";
#import, file "smooth_frames.zi";
#import, file "telegram_account_flow.zi";
#import, file "text_buffers.zi";
#import, file "crash_report_store.zi";
#import, file "../storage/data.zi";
#import, file "../storage/temporary_data.zi";
#import, file "../storage/sync_state.zi";
#import, file "../storage/delegate_store.zi";
#import, file "../apps/lumi_connection.zi";
#import, file "../apps/lumi_online.zi";
#import, file "../apps/module_host.zi";
#import, file "../apps/package_files.zi";
#import, file "../practices/practice_registry.zi";
#import, file "../platform/crash_handler.zi";
#import, file "../platform/app_trace.zi";
#if #defined(ANDROID_BUILD) {
    #import "android_jni"
}

using ModalType;
using ButtonTone;
using ButtonEmphasis;

crash_report_pending: PendingCrashReport = .{.screen = -1, .practice = -1};
crash_report_prompted: bool;

CrashReportInit :: (app: *InnerBreeze) {
    unused app
    crash_report_pending = PendingCrashReport.{.screen = -1, .practice = -1}
    crash_report_prompted = false
    if AppMiniMode() || DataTemporary() {
        return
    }
    root := data_root()
    if root.count == 0 {
        return
    }
    primary: [1024]u8
    secondary: [1024]u8
    secondary[0] = cast(u8)0
    primary_ok := CrashHandlerPathForRoot(root, primary[:])
    #if #defined(ANDROID_BUILD) {
        internal := AndroidInternalDataPath()
        if internal != null && internal[0] != cast(u8)0 {
            unused CrashHandlerPathForRoot(AppTextFromCString(internal, 512), secondary[:])
        }
    }
    if primary_ok || secondary[0] != cast(u8)0 {
        if CrashReportLoadFromPaths(
            ifx primary_ok then TextUntilNul(primary[:]) else "",
            TextUntilNul(secondary[:]),
            *crash_report_pending) {
            TraceLog(3, "APP: loaded pending crash diagnostics from previous run")
        }
    }
    unused CrashHandlerInstall(root)
}

CrashReportCanPrompt :: (app: *InnerBreeze) -> bool {
    if app == null || !crash_report_pending.present || crash_report_prompted {
        return false
    }
    if AppMiniMode() || DataTemporary() || TelegramAccountFlowOwnsContext() {
        return false
    }
    if StoredAccountMode() == AccountModeDelegate {
        return false
    }
    if app.language_selected == 0 || app.apps_selected == 0 {
        return false
    }
    if app.modal.active != 0 || app.launcher_open || app.close_prompt_open != 0 ||
    app.file_dialog_active != 0 || app.host_feature != 0 {
        return false
    }
    if practice_active(app) != null {
        return false
    }
    return true
}

CrashReportPump :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    active_practice := practice_active(app)
    practice_id: s32 = ifx active_practice != null then cast(s32)active_practice.id else -1
    CrashHandlerUpdateState(app.breathing.screen, practice_id, app.session_window.system_visible)
    if crash_report_prompted && crash_report_pending.present &&
    !(app.modal.active != 0 && app.modal.type == ModalType.ModalCrashReport) {
        // Back dismisses the dialog without sending. If another modal took
        // priority, retain the report until the person can choose an action.
        if app.modal.active == 0 {
            CrashReportDiscard(*crash_report_pending)
        }
        crash_report_prompted = false
        return
    }
    if CrashReportCanPrompt(app) {
        crash_report_prompted = true
        app_open_modal(app, ModalType.ModalCrashReport)
        AppRequestSmoothFrames(2)
    }
}

CrashReportModalMessage :: (app: *InnerBreeze) -> string {
    summary := TextUntilNul(crash_report_pending.summary[:])
    body_out: Vec(u8)
    BuilderPrint(*body_out, "%", LocaleText("crash_report_message"))
    if summary.count > 0 {
        BuilderPrint(*body_out, "\n\n%: %", LocaleText("crash_report_summary_label"), summary)
    }
    body := BuilderFinish(body_out)
    message := FrameTextHold(*app.ui.frame_text, body)
    PackageFree(body)
    return message
}

CrashReportModalDraw :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if !crash_report_pending.present {
        app_close_modal(app)
        return
    }
    message := CrashReportModalMessage(app)

    actions: [2]Modal.ActionModalAction = .[
    Modal.ActionModalAction.{
        .label = LocaleText("crash_report_dismiss"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    },
    Modal.ActionModalAction.{
        .label = LocaleText("crash_report_send"),
        .tone = cast(ButtonTone)ButtonToneAccent,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    }
    ]
    props := Modal.ActionModalProps.{
        .key = Layout.KeyHash("inbe/crash-report"),
        .title = LocaleText("crash_report_title"),
        .message = message,
        .max_width = 460
    }
    choice := Modal.ActionModal(app.ui.session, props, actions[:]).action
    if choice == 1 || choice == -1 {
        CrashReportDiscard(*crash_report_pending)
        crash_report_prompted = false
        app_close_modal(app)
    } else if choice == 2 {
        queued := CrashReportApproveAndQueue(
            *crash_report_pending,
            app.breathing.screen,
            app.enabled_apps & AppsInstalledMask(),
            AppThemeName(app.theme_id),
            app.ui_scale_tenths)
        if queued {
            LumiFeedbackWake()
            crash_report_prompted = false
            app_close_modal(app)
            online_ready := storage_has_sync_account() != 0 && LumiNodeTrafficAllowed()
            AppToast(LocaleText(ifx online_ready then "crash_report_queued" else "crash_report_saved_offline"))
        } else {
            AppToast(LocaleText("crash_report_failed"))
        }
    }
}
