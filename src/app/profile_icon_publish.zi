// The profile picture chosen in Inner Breeze goes to the account's node, so
// friends see it in Lists and wherever the node shows people. It is sent in
// the background once per new choice; a failed attempt waits ten minutes,
// and nothing here ever holds up the app.
#import "text"
#import "vec"
#import "text_buffer"
#import "auth"
#import, file "../storage/sync_state.zi";
#import, file "../storage/delegate_store.zi";
#import, file "../storage/sync_async.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../platform/network_transport.zi";

profile_icon_operation: StoredOperation;
profile_icon_transfer: NetworkTransfer;
profile_icon_response: [1024]u8;
// The picture on its way, saved as sent once the node accepts it.
profile_icon_sending: s32;
profile_icon_retry_at: float64;

ProfileIconPublishPump :: (picture: s32, server: string, now: float64) {
    if profile_icon_operation.active {
        if !PollStoredOperation(*profile_icon_operation) {
            return
        }
        if profile_icon_operation.result == cast(s32)AuthResult.AUTH_OK {
            storage_set_setting_int("profile_icon_published", profile_icon_sending)
        } else {
            profile_icon_retry_at = now + 600.0
        }
        return
    }
    if picture <= 0 || now < profile_icon_retry_at || server.count == 0 {
        return
    }
    if storage_get_setting_int("profile_icon_published", 0) == picture {
        return
    }
    if storage_has_sync_account() == 0 || StoredAccountMode() == AccountModeDelegate {
        return
    }
    body: Vec(u8)
    BuilderPrint(*body, "{\"user_id_hash\":\"%\",\"profile_icon\":%}",
        storage_get_setting_text("sync_public_id"), picture)
    request := BuilderFinish(body)
    profile_icon_response = .{}
    if !BeginStoredRequest(*profile_icon_operation, server,
        NetworkTransport(*profile_icon_transfer), "POST", "/api/v1/account/profile-icon",
        request, profile_icon_response[:], true) {
        profile_icon_retry_at = now + 600.0
        return
    }
    profile_icon_sending = picture
}
