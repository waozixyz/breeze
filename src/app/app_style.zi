using KssStatus;

style_pack_id :: (index: s32) -> string {
    if index == 2 { return "classic" }
    if index == 3 { return "lightfield" }
    return "material"
}

style_pack_label :: (index: s32) -> string {
    if index == 2 { return "Classic" }
    if index == 3 { return "Lightfield" }
    return "Material"
}

style_pack_has_glow :: (index: s32) -> s32 {
    return ifx index == 3 then 1 else 0
}

StyleMixChannel :: (from: u32, to: u32, amount: float32) -> u32 {
    value := cast(float32)from +         (cast(float32)to - cast(float32)from) * amount
    if value < 0.0 { return 0 }
    if value > 255.0 { return 255 }
    return cast(u32)(value + 0.5)
}

StyleMixColor :: (from: u32, to: u32, amount: float32) -> u32 {
    if amount < 0.0 { amount = 0.0 }
    if amount > 1.0 { amount = 1.0 }
    red := StyleMixChannel((from >> cast(u32)24) & cast(u32)255,
        (to >> cast(u32)24) & cast(u32)255, amount)
    green := StyleMixChannel((from >> cast(u32)16) & cast(u32)255,
        (to >> cast(u32)16) & cast(u32)255, amount)
    blue := StyleMixChannel((from >> cast(u32)8) & cast(u32)255,
        (to >> cast(u32)8) & cast(u32)255, amount)
    alpha := StyleMixChannel(from & cast(u32)255,
        to & cast(u32)255, amount)
    return (red << cast(u32)24) | (green << cast(u32)16) |
    (blue << cast(u32)8) | alpha
}

StyleFade :: (color: u32, opacity: float32) -> u32 {
    if opacity < 0.0 { opacity = 0.0 }
    if opacity > 1.0 { opacity = 1.0 }
    alpha := cast(u32)(cast(float32)(color & cast(u32)255) * opacity + 0.5)
    return (color & ~cast(u32)255) | alpha
}

StyleLightfieldColor :: (index: s32, color: u32,
    opacity: float32) -> u32 {
    if index == 3 { return StyleFade(color, opacity) }
    return color
}

StyleColors :: struct {
    background: u32
    surface: u32
    surface_raised: u32
    surface_sunken: u32
    text: u32
    text_muted: u32
    border: u32
    border_strong: u32
    divider: u32
    focus: u32
    accent: u32
    accent_hover: u32
    accent_pressed: u32
    on_accent: u32
    danger: u32
    on_danger: u32
    link: u32
    icon: u32
    review_added: u32
    review_removed: u32
    review_changed: u32
}

StyleColorsFor :: (catalog: ThemeCatalog, dark: bool) -> StyleColors {
    colors: StyleColors
    scheme := SchemeFor(catalog.background, catalog.surface, catalog.text,
        catalog.circle, catalog.button, dark, cast(u8)128)
    colors.background = catalog.background
    colors.surface = catalog.surface
    colors.surface_raised = StyleMixColor(catalog.surface,
        catalog.background, ifx dark then 0.20 else 0.42)
    colors.surface_sunken = scheme.surface_container
    colors.text = catalog.text
    colors.text_muted = StyleMixColor(catalog.text, catalog.surface,
        ifx dark then 0.36 else 0.48)
    colors.border = StyleMixColor(catalog.text, catalog.surface,
        ifx dark then 0.70 else 0.80)
    colors.border_strong = scheme.outline
    colors.divider = colors.border
    colors.focus = catalog.button
    colors.accent = catalog.button
    colors.accent_hover = catalog.button_hover
    colors.accent_pressed = StyleMixColor(catalog.button,
        catalog.text, 0.12)
    colors.on_accent = OnColor(catalog.button)
    if catalog.button_ink != 0 { colors.on_accent = catalog.button_ink }
    colors.danger = scheme.error
    colors.on_danger = OnColor(scheme.error)
    colors.link = catalog.link
    colors.icon = catalog.icon
    dark_surface := OnColor(catalog.surface) == cast(u32)0xffffffff
    colors.review_added = ifx dark_surface then 0x86dca5ff else 0x17663aff
    colors.review_removed = ifx dark_surface then 0xffa3a3ff else 0xb3261eff
    colors.review_changed = ifx dark_surface then 0xffd477ff else 0x805000ff
    return colors
}

StyleOverrides :: (parser: KssParser, colors: StyleColors,
    index: s32) -> KssParser {
    parser = KssAddColorOverride(parser, "canvas", colors.background)
    parser = KssAddColorOverride(parser, "text", colors.text)
    parser = KssAddColorOverride(parser, "muted", colors.text_muted)
    parser = KssAddColorOverride(parser, "surface",
        StyleLightfieldColor(index, colors.surface, 0.87))
    parser = KssAddColorOverride(parser, "surface-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    parser = KssAddColorOverride(parser, "card",
        StyleLightfieldColor(index, colors.surface_raised, 0.87))
    parser = KssAddColorOverride(parser, "card-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    parser = KssAddColorOverride(parser, "panel", colors.surface_raised)
    parser = KssAddColorOverride(parser, "panel-hover", colors.surface)
    parser = KssAddColorOverride(parser, "panel-pressed", colors.surface_sunken)
    parser = KssAddColorOverride(parser, "button",
        StyleLightfieldColor(index, colors.surface_raised, 0.87))
    parser = KssAddColorOverride(parser, "button-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    parser = KssAddColorOverride(parser, "button-hover",
        StyleLightfieldColor(index, colors.surface, 0.93))
    parser = KssAddColorOverride(parser, "button-hover-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    parser = KssAddColorOverride(parser, "button-pressed",
        StyleLightfieldColor(index, colors.surface_sunken, 0.93))
    parser = KssAddColorOverride(parser, "button-pressed-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    parser = KssAddColorOverride(parser, "button-disabled", colors.surface)
    // Menus sit over other content, so they never take the glass translucency.
    parser = KssAddColorOverride(parser, "popup", colors.surface_raised)
    parser = KssAddColorOverride(parser, "dropdown-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    parser = KssAddColorOverride(parser, "border", colors.border)
    parser = KssAddColorOverride(parser, "border-soft", colors.divider)
    parser = KssAddColorOverride(parser, "border-hover", colors.border_strong)
    parser = KssAddColorOverride(parser, "border-hover-strong", colors.border_strong)
    parser = KssAddColorOverride(parser, "border-disabled", colors.divider)
    parser = KssAddColorOverride(parser, "card-border", colors.border)
    parser = KssAddColorOverride(parser, "outline-border", colors.border_strong)
    parser = KssAddColorOverride(parser, "focus", colors.focus)
    parser = KssAddColorOverride(parser, "accent", colors.accent)
    parser = KssAddColorOverride(parser, "accent-end", colors.accent_pressed)
    parser = KssAddColorOverride(parser, "accent-hover", colors.accent_hover)
    parser = KssAddColorOverride(parser, "accent-hover-end", colors.accent)
    parser = KssAddColorOverride(parser, "accent-border", colors.accent_pressed)
    parser = KssAddColorOverride(parser, "accent-ink", colors.on_accent)
    parser = KssAddColorOverride(parser, "danger", colors.danger)
    parser = KssAddColorOverride(parser, "danger-hover", colors.danger)
    parser = KssAddColorOverride(parser, "danger-ink", colors.on_danger)
    // Soft danger actions sit on the page as a light tint of the danger color.
    parser = KssAddColorOverride(parser, "danger-soft",
        StyleMixColor(colors.danger, colors.surface, 0.85))
    parser = KssAddColorOverride(parser, "danger-border", colors.danger)
    parser = KssAddColorOverride(parser, "row",
        StyleLightfieldColor(index, colors.surface, 0.67))
    // A switch knob stays white on every accent, as platform switches do;
    // on_accent is text ink and turns dark on pale accents.
    parser = KssAddColorOverride(parser, "thumb-ink", cast(u32)0xffffffff)
    parser = KssAddColorOverride(parser, "divider", colors.divider)
    parser = KssAddColorOverride(parser, "track", colors.surface_sunken)
    parser = KssAddColorOverride(parser, "track-hover", colors.surface_raised)
    parser = KssAddColorOverride(parser, "field", colors.surface_sunken)
    parser = KssAddColorOverride(parser, "field-border", colors.border)
    parser = KssAddColorOverride(parser, "scroll-thumb", colors.text_muted)
    parser = KssAddColorOverride(parser, "scroll-border", colors.border_strong)
    parser = KssAddColorOverride(parser, "link", colors.link)
    parser = KssAddColorOverride(parser, "icon", colors.icon)
    parser = KssAddColorOverride(parser, "review-added", colors.review_added)
    parser = KssAddColorOverride(parser, "review-removed", colors.review_removed)
    parser = KssAddColorOverride(parser, "review-changed", colors.review_changed)
    parser = KssAddColorOverride(parser, "launcher-canvas",
        colors.background)
    parser = KssAddColorOverride(parser, "launcher-panel",
        colors.surface)
    parser = KssAddColorOverride(parser, "launcher-hover",
        colors.surface_sunken)
    parser = KssAddColorOverride(parser, "launcher-text",
        colors.text)
    parser = KssAddColorOverride(parser, "launcher-muted",
        colors.text_muted)
    parser = KssAddColorOverride(parser, "launcher-selection",
        colors.accent)
    parser = KssAddColorOverride(parser, "launcher-ink", colors.on_accent)
    parser = KssAddColorOverride(parser, "launcher-selected-hover",
        StyleMixColor(colors.accent, OnColor(colors.on_accent), 0.08))
    parser = KssAddColorOverride(parser, "launcher-selected-pressed",
        StyleMixColor(colors.accent, OnColor(colors.on_accent), 0.16))
    parser = KssAddColorOverride(parser, "launcher-border",
        colors.border)
    return parser
}

StyleRootFor :: (index: s32) -> string {
    if index == 2 {
        return "@import <classic>; @import <inbe>;"
    }
    if index == 3 {
        return "@import <lightfield>; @import <inbe>;"
    }
    return "@import <material>; @import <inbe>;"
}

StyleImport :: (name: KssName) -> AssetView {
    if KssNameEquals(name, "classic") {
        return AssetRead("styles/classic.kss")
    }
    if KssNameEquals(name, "lightfield") {
        return AssetRead("styles/lightfield.kss")
    }
    if KssNameEquals(name, "material") {
        return AssetRead("styles/material.kss")
    }
    if KssNameEquals(name, "inbe") {
        return AssetRead("assets/styles/inbe.kss")
    }
    return AssetView.{}
}

// The installed style is fully determined by these inputs, and parsing it is
// far too expensive to repeat every frame.
style_installed: bool;
style_installed_theme: s32;
style_installed_dark: bool;
style_installed_index: s32;
style_installed_waozi: bool;
style_installed_revision: s32 = -1;
style_installed_scope: s32 = -1;
style_generation: s32;
style_parse_sources: [StyleRuleCapacity]StyleRuleSource;
style_parse_source_count: s32;
style_compile_tokens: [128]KssToken;
style_compile_token_count: s32;
style_inspection_rules: StyleRules;

StyleRecordRule :: (parsed: *StyleRulesParse) {
    index := parsed.rules.count - 1
    if index < 0 || index >= StyleRuleCapacity {
        return
    }
    origin := parsed.parser.origin
    span := parsed.parser.rule_span
    source := parsed.parser.cursor.source
    style_parse_sources[index] = StyleRuleSource.{}
    if span.selector_start >= 0 && span.selector_length > 0 &&
    span.selector_start + span.selector_length <= source.count {
        selector := source[span.selector_start:span.selector_start + span.selector_length]
        CopyTextToBuffer(*style_parse_sources[index].selector[0], 160, selector)
    }
    if origin.file >= 0 && origin.file < parsed.parser.file_count {
        file := parsed.parser.files[origin.file]
        CopyTextToBuffer(*style_parse_sources[index].path[0], 64,
            TextFromBytes(file.name[:file.length]))
    }
    style_parse_sources[index].line = origin.line
    style_parse_sources[index].column = origin.column
    style_parse_source_count = parsed.rules.count
}

StyleCompileSources :: (catalog: ThemeCatalog, dark: bool, style_index: s32,
    all_source: string, scoped_source: string,
    install: bool) -> bool {
    env := KssEnvironmentWithNames(KssDefaultEnvironment(),
        ifx dark then "dark" else "light", "", "", "", "", "")
    root := StyleRootFor(style_index)
    if all_source.count > 0 || scoped_source.count > 0 {
        if style_index == 2 {
            root = "@import <classic>; @import <inbe>; @import <user>; @import <scope>;"
        } else if style_index == 3 {
            root = "@import <lightfield>; @import <inbe>; @import <user>; @import <scope>;"
        } else {
            root = "@import <material>; @import <inbe>; @import <user>; @import <scope>;"
        }
    }
    parsed: StyleRulesParse
    for pass: cast(s32)0..cast(s32)1 {
        parsed = BeginStyleRules(root, "styles/inbe-root.kss", env)
        if !catalog.complete {
            parsed.parser = KssFail(parsed.parser, "Could not load the selected theme.")
            StyleParseError(*parsed)
            return false
        }
        parsed.parser = StyleOverrides(parsed.parser, StyleColorsFor(catalog, dark), style_index)
        if pass == 1 && style_compile_token_count > 0 {
            for index: cast(s32)0..style_compile_token_count - 1 {
                token := style_compile_tokens[index]
                if token.file >= 0 {
                    parsed.parser = KssAddTokenOverride(parsed.parser, token)
                }
            }
        }
        custom_file: s32 = -1
        scoped_file: s32 = -1
        style_parse_source_count = 0
        while !parsed.overflow &&
        parsed.parser.status != cast(s32)KssStatusDone &&
        parsed.parser.status != cast(s32)KssStatusError {
            // Keep the rule table in this frame. Passing the whole parse value to
            // StepStyleRules adds a second large table on small Android stacks.
            parsed.parser = KssStep(parsed.parser)
            if parsed.parser.status == cast(s32)KssStatusRule {
                if parsed.rules.count >= StyleRuleCapacity {
                    parsed.overflow = true
                } else {
                    parsed.rules.items[parsed.rules.count] = parsed.parser.rule
                    parsed.rules.count += 1
                }
            }
            if !parsed.overflow && parsed.parser.status == cast(s32)KssStatusRule {
                rule_index := parsed.rules.count - 1
                if parsed.parser.origin.file == custom_file {
                    parsed.rules.items[rule_index].layer += 100
                } else if parsed.parser.origin.file == scoped_file {
                    parsed.rules.items[rule_index].layer += 200
                }
                StyleRecordRule(*parsed)
            }
            if parsed.parser.status != cast(s32)KssStatusNeedImport {
                continue
            }
            name := parsed.parser.pending_import
            if parsed.parser.cursor.file != 0 {
                parsed.parser = KssFail(parsed.parser,
                    "Custom sheets cannot import files. Shared styles are supplied by the app.")
                break
            }
            if KssNameEquals(name, "user") {
                custom_file = parsed.parser.file_count
                parsed.parser.override_count = 0
                for index: cast(s32)0..parsed.parser.token_count - 1 {
                    parsed.parser.tokens[index].file = -1
                }
                parsed = ProvideStyleRulesImport(parsed, all_source, "appearance/all.kss")
            } else if KssNameEquals(name, "scope") {
                scoped_file = parsed.parser.file_count
                parsed = ProvideStyleRulesImport(parsed, scoped_source, "appearance/app.kss")
            } else {
                asset := StyleImport(name)
                if !asset.found {
                    parsed = FailStyleRulesImport(parsed)
                    break
                }
                path := ifx KssNameEquals(name, "inbe") then "assets/styles/inbe.kss" else style_pack_id(style_index)
                parsed = ProvideStyleRulesImport(parsed, asset.data, path)
            }
        }
        if pass == 0 && StyleCollectCustomTokens(*parsed) {
            continue
        }
        break
    }
    if parsed.overflow || parsed.parser.status != cast(s32)KssStatusDone {
        StyleParseError(*parsed)
        return false
    }
    if install {
        return StylePublish(*parsed)
    }
    style_inspection_rules.count = parsed.rules.count
    for index: cast(s32)0..parsed.rules.count - 1 {
        style_inspection_rules.items[index] = StyleRule.{
            .selector = parsed.rules.items[index].selector,
            .state = parsed.rules.items[index].state,
            .layer = parsed.rules.items[index].layer,
            .order = parsed.rules.items[index].order,
            .style = StyleWithoutTypeface(parsed.rules.items[index].style)}
    }
    return true
}

StyleCollectCustomTokens :: (parsed: *StyleRulesParse) -> bool {
    style_compile_token_count = 0
    if parsed.overflow || parsed.parser.status != cast(s32)KssStatusDone ||
    parsed.parser.file_count <= 3 {
        return false
    }
    for index: cast(s32)0..parsed.parser.token_count - 1 {
        if parsed.parser.tokens[index].file >= 0 {
            style_compile_tokens[style_compile_token_count] = parsed.parser.tokens[index]
            style_compile_token_count += 1
        }
    }
    return style_compile_token_count > 0
}

StyleParseError :: (parsed: *StyleRulesParse) {
    StyleClearError()
    if parsed.overflow {
        unused AppCopyText("The combined stylesheet exceeds 512 rules.", style_error[:])
    } else {
        unused AppCopyText(TextFromBytes(parsed.parser.diagnostic[:
            parsed.parser.diagnostic_length]), style_error[:])
    }
    style_error_line = parsed.parser.cursor.line
    style_error_column = parsed.parser.cursor.column
    file_index := parsed.parser.cursor.file
    if file_index >= 0 && file_index < parsed.parser.file_count {
        file := parsed.parser.files[file_index]
        CopyTextToBuffer(*style_error_path[0], 64, TextFromBytes(file.name[:file.length]))
    }
}

StylePublish :: (parsed: *StyleRulesParse) -> bool {
    if parsed.overflow || parsed.parser.status != cast(s32)KssStatusDone {
        StyleParseError(parsed)
        return false
    }
    if !InstallParsedStyleRules(parsed.*) {
        unused AppCopyText("Could not install the stylesheet.", style_error[:])
        return false
    }
    for index: cast(s32)0..style_parse_source_count - 1 {
        style_sources[index] = style_parse_sources[index]
    }
    style_source_count = style_parse_source_count
    style_generation += 1
    body: StyleData
    body.font_size = cast(float32)Text16
    AppMetricsConfigureFont(cast(s32)(TextStyleFor(TextStyleRequest.{}, body).font_size + 0.5))
    return true
}

#program_export
StyleInstall :: (theme_id: s32, dark: bool, style_index: s32) -> bool {
    if style_installed && style_installed_theme == theme_id &&
    style_installed_dark == dark && style_installed_index == style_index &&
    style_installed_waozi == AppWaoziTheme() &&
    style_installed_revision == style_revision && style_installed_scope == 0 {
        return true
    }
    style_installed = false
    catalog := ThemeCatalogLoad(theme_id, dark)
    if !StyleCompileSources(catalog, dark, style_index, StyleAppliedSource(0), "", true) {
        // A damaged stored preference must never leave startup without a UI.
        style_documents[0].applied[0] = cast(u8)0
        if !StyleCompileSources(catalog, dark, style_index, "", "", true) {
            return false
        }
    }
    style_installed = true
    style_installed_theme = theme_id
    style_installed_dark = dark
    style_installed_index = style_index
    style_installed_waozi = AppWaoziTheme()
    style_installed_revision = style_revision
    style_installed_scope = 0
    return true
}

#program_export
app_apply_style :: (app: *InnerBreeze) -> bool {
    if app == null { return false }
    scope := StyleActiveScope(app)
    // An app without its own sheet compiles to exactly the shared rules, so
    // opening it keeps them. Compiling every sheet again on the frame stalled
    // a minimized practice's window when an app such as Lumi opened.
    if scope == 0 || StyleAppliedSource(scope).count == 0 {
        return StyleInstall(app.theme_id, app.dark_mode != 0, app.style_index)
    }
    if style_installed && style_installed_theme == app.theme_id &&
    style_installed_dark == (app.dark_mode != 0) &&
    style_installed_index == app.style_index &&
    style_installed_waozi == AppWaoziTheme() &&
    style_installed_revision == style_revision && style_installed_scope == scope {
        return true
    }
    catalog := ThemeCatalogLoad(app.theme_id, app.dark_mode != 0)
    if !StyleCompileSources(catalog, app.dark_mode != 0, app.style_index,
        StyleAppliedSource(0), StyleAppliedSource(scope), true) {
        style_documents[scope].applied[0] = cast(u8)0
        if !StyleCompileSources(catalog, app.dark_mode != 0, app.style_index,
            StyleAppliedSource(0), "", true) {
            return false
        }
    }
    style_installed = true
    style_installed_theme = app.theme_id
    style_installed_dark = app.dark_mode != 0
    style_installed_index = app.style_index
    style_installed_waozi = AppWaoziTheme()
    style_installed_revision = style_revision
    style_installed_scope = scope
    return true
}

StyleActiveScope :: (app: *InnerBreeze) -> s32 {
    screen := app.breathing.screen
    if screen == ScreenSettings && app.settings_tab == SETTINGS_TAB_THEME && style_editor_open {
        return style_editor_scope
    }
    if screen == ScreenEList {
        return 1
    }
    if screen == ScreenHabits || screen == ScreenHabitEdit || screen == ScreenHabitSessionEdit {
        return 2
    }
    if screen == ScreenDiary {
        return 4
    }
    if screen == ScreenLumi {
        return 5
    }
    if screen == ScreenStart || screen == ScreenSession || screen == ScreenMeditation ||
    screen == ScreenSunSalutation || screen == ScreenPatterns || screen == ScreenResults ||
    screen == ScreenPracticeConfig {
        return 3
    }
    return 0
}
