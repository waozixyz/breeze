using CssStatus;
using CssTokenKind;

style_pack_id :: (index: s32) -> string {
    if index == 2 { return "classic" }
    if index == 3 { return "lightfield" }
    return "material"
}

style_pack_label :: (index: s32) -> string {
    if index == 2 { return "Classic" }
    if index == 3 { return "Lightfield" }
    return "Material"
}

style_pack_has_glow :: (index: s32) -> s32 {
    return ifx index == 3 then 1 else 0
}

StyleMixChannel :: (from: u32, to: u32, amount: float32) -> u32 {
    value := cast(float32)from +         (cast(float32)to - cast(float32)from) * amount
    if value < 0.0 { return 0 }
    if value > 255.0 { return 255 }
    return cast(u32)(value + 0.5)
}

StyleMixColor :: (from: u32, to: u32, amount: float32) -> u32 {
    if amount < 0.0 { amount = 0.0 }
    if amount > 1.0 { amount = 1.0 }
    red := StyleMixChannel((from >> cast(u32)24) & cast(u32)255,
        (to >> cast(u32)24) & cast(u32)255, amount)
    green := StyleMixChannel((from >> cast(u32)16) & cast(u32)255,
        (to >> cast(u32)16) & cast(u32)255, amount)
    blue := StyleMixChannel((from >> cast(u32)8) & cast(u32)255,
        (to >> cast(u32)8) & cast(u32)255, amount)
    alpha := StyleMixChannel(from & cast(u32)255,
        to & cast(u32)255, amount)
    return (red << cast(u32)24) | (green << cast(u32)16) |
    (blue << cast(u32)8) | alpha
}

StyleFade :: (color: u32, opacity: float32) -> u32 {
    if opacity < 0.0 { opacity = 0.0 }
    if opacity > 1.0 { opacity = 1.0 }
    alpha := cast(u32)(cast(float32)(color & cast(u32)255) * opacity + 0.5)
    return (color & ~cast(u32)255) | alpha
}

StyleLightfieldColor :: (index: s32, color: u32,
    opacity: float32) -> u32 {
    if index == 3 { return StyleFade(color, opacity) }
    return color
}

StyleColors :: struct {
    background: u32
    surface: u32
    surface_raised: u32
    surface_sunken: u32
    text: u32
    text_muted: u32
    border: u32
    border_strong: u32
    divider: u32
    focus: u32
    accent: u32
    accent_hover: u32
    accent_pressed: u32
    on_accent: u32
    progress: u32
    on_progress: u32
    danger: u32
    on_danger: u32
    link: u32
    icon: u32
    review_added: u32
    review_removed: u32
    review_changed: u32
}

StyleColorsFor :: (catalog: ThemeCatalog, dark: bool) -> StyleColors {
    colors: StyleColors
    scheme := SchemeFor(catalog.background, catalog.surface, catalog.text,
        catalog.circle, catalog.button, dark, cast(u8)128)
    colors.background = catalog.background
    colors.surface = catalog.surface
    colors.surface_raised = StyleMixColor(catalog.surface,
        catalog.background, ifx dark then 0.20 else 0.42)
    colors.surface_sunken = scheme.surface_container
    colors.text = catalog.text
    colors.text_muted = StyleMixColor(catalog.text, catalog.surface,
        ifx dark then 0.36 else 0.48)
    colors.border = StyleMixColor(catalog.text, catalog.surface,
        ifx dark then 0.70 else 0.80)
    colors.border_strong = scheme.outline
    colors.divider = colors.border
    colors.focus = catalog.button
    colors.accent = catalog.button
    colors.accent_hover = catalog.button_hover
    colors.accent_pressed = StyleMixColor(catalog.button,
        catalog.text, 0.12)
    colors.on_accent = OnColor(catalog.button)
    if catalog.button_ink != 0 { colors.on_accent = catalog.button_ink }
    // Many themes keep their button color close to their surfaces, so a
    // progress bar filled with it looks empty. Progress fills with the
    // breathing circle's color, which every theme sets apart.
    colors.progress = catalog.circle
    colors.on_progress = OnColor(catalog.circle)
    colors.danger = scheme.error
    colors.on_danger = OnColor(scheme.error)
    colors.link = catalog.link
    colors.icon = catalog.icon
    dark_surface := OnColor(catalog.surface) == cast(u32)0xffffffff
    colors.review_added = ifx dark_surface then 0x86dca5ff else 0x17663aff
    colors.review_removed = ifx dark_surface then 0xffa3a3ff else 0xb3261eff
    colors.review_changed = ifx dark_surface then 0xffd477ff else 0x805000ff
    return colors
}

// The theme's colors replace the custom properties of the same names in the
// style pack and the app sheet.
StyleOverrides :: (overrides: *CssOverrides, colors: StyleColors,
    index: s32) {
    CssOverrideColor(overrides, "canvas", colors.background)
    CssOverrideColor(overrides, "text", colors.text)
    CssOverrideColor(overrides, "muted", colors.text_muted)
    CssOverrideColor(overrides, "surface",
        StyleLightfieldColor(index, colors.surface, 0.87))
    CssOverrideColor(overrides, "surface-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    CssOverrideColor(overrides, "card",
        StyleLightfieldColor(index, colors.surface_raised, 0.87))
    CssOverrideColor(overrides, "card-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    CssOverrideColor(overrides, "panel", colors.surface_raised)
    CssOverrideColor(overrides, "panel-hover", colors.surface)
    CssOverrideColor(overrides, "panel-pressed", colors.surface_sunken)
    CssOverrideColor(overrides, "button",
        StyleLightfieldColor(index, colors.surface_raised, 0.87))
    CssOverrideColor(overrides, "button-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    CssOverrideColor(overrides, "button-hover",
        StyleLightfieldColor(index, colors.surface, 0.93))
    CssOverrideColor(overrides, "button-hover-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    CssOverrideColor(overrides, "button-pressed",
        StyleLightfieldColor(index, colors.surface_sunken, 0.93))
    CssOverrideColor(overrides, "button-pressed-end",
        StyleLightfieldColor(index, colors.surface, 0.93))
    CssOverrideColor(overrides, "button-disabled", colors.surface)
    // Menus sit over other content, so they never take the glass translucency.
    CssOverrideColor(overrides, "popup", colors.surface_raised)
    CssOverrideColor(overrides, "dropdown-end",
        StyleLightfieldColor(index, colors.surface_raised, 0.93))
    CssOverrideColor(overrides, "border", colors.border)
    CssOverrideColor(overrides, "border-soft", colors.divider)
    CssOverrideColor(overrides, "border-hover", colors.border_strong)
    CssOverrideColor(overrides, "border-hover-strong", colors.border_strong)
    CssOverrideColor(overrides, "border-disabled", colors.divider)
    CssOverrideColor(overrides, "card-border", colors.border)
    CssOverrideColor(overrides, "outline-border", colors.border_strong)
    CssOverrideColor(overrides, "focus", colors.focus)
    CssOverrideColor(overrides, "accent", colors.accent)
    CssOverrideColor(overrides, "accent-end", colors.accent_pressed)
    CssOverrideColor(overrides, "accent-hover", colors.accent_hover)
    CssOverrideColor(overrides, "accent-hover-end", colors.accent)
    CssOverrideColor(overrides, "accent-border", colors.accent_pressed)
    CssOverrideColor(overrides, "accent-ink", colors.on_accent)
    CssOverrideColor(overrides, "progress", colors.progress)
    CssOverrideColor(overrides, "progress-ink", colors.on_progress)
    CssOverrideColor(overrides, "danger", colors.danger)
    CssOverrideColor(overrides, "danger-hover", colors.danger)
    CssOverrideColor(overrides, "danger-ink", colors.on_danger)
    // Soft danger actions sit on the page as a light tint of the danger color.
    CssOverrideColor(overrides, "danger-soft",
        StyleMixColor(colors.danger, colors.surface, 0.85))
    CssOverrideColor(overrides, "danger-border", colors.danger)
    CssOverrideColor(overrides, "row",
        StyleLightfieldColor(index, colors.surface, 0.67))
    // A switch knob stays white on every accent, as platform switches do;
    // on_accent is text ink and turns dark on pale accents.
    CssOverrideColor(overrides, "thumb-ink", cast(u32)0xffffffff)
    CssOverrideColor(overrides, "divider", colors.divider)
    CssOverrideColor(overrides, "track", colors.surface_sunken)
    CssOverrideColor(overrides, "track-hover", colors.surface_raised)
    CssOverrideColor(overrides, "field", colors.surface_sunken)
    CssOverrideColor(overrides, "field-border", colors.border)
    CssOverrideColor(overrides, "scroll-thumb", colors.text_muted)
    CssOverrideColor(overrides, "scroll-border", colors.border_strong)
    CssOverrideColor(overrides, "link", colors.link)
    CssOverrideColor(overrides, "icon", colors.icon)
    CssOverrideColor(overrides, "review-added", colors.review_added)
    CssOverrideColor(overrides, "review-removed", colors.review_removed)
    CssOverrideColor(overrides, "review-changed", colors.review_changed)
    CssOverrideColor(overrides, "launcher-canvas",
        colors.background)
    CssOverrideColor(overrides, "launcher-panel",
        colors.surface)
    CssOverrideColor(overrides, "launcher-hover",
        colors.surface_sunken)
    CssOverrideColor(overrides, "launcher-text",
        colors.text)
    CssOverrideColor(overrides, "launcher-muted",
        colors.text_muted)
    CssOverrideColor(overrides, "launcher-selection",
        colors.accent)
    CssOverrideColor(overrides, "launcher-ink", colors.on_accent)
    CssOverrideColor(overrides, "launcher-selected-hover",
        StyleMixColor(colors.accent, OnColor(colors.on_accent), 0.08))
    CssOverrideColor(overrides, "launcher-selected-pressed",
        StyleMixColor(colors.accent, OnColor(colors.on_accent), 0.16))
    CssOverrideColor(overrides, "launcher-border",
        colors.border)
}

StylePackFile :: (index: s32) -> string {
    if index == 2 { return "classic.css" }
    if index == 3 { return "lightfield.css" }
    return "material.css"
}

StylePackCompiled :: (index: s32) -> CssCompiledSheet {
    if index == 2 { return StylePackClassic() }
    if index == 3 { return StylePackLightfield() }
    return StylePackMaterial()
}

// The shipped sheets as text, for the editor's source views.
StyleImport :: (name: string) -> AssetView {
    if name == "classic" {
        return AssetRead("styles/classic.css")
    }
    if name == "lightfield" {
        return AssetRead("styles/lightfield.css")
    }
    if name == "material" {
        return AssetRead("styles/material.css")
    }
    if name == "inbe" {
        return AssetRead("assets/styles/inbe.css")
    }
    return AssetView.{}
}

// The installed style is fully determined by these inputs, and parsing it is
// far too expensive to repeat every frame.
style_installed: bool;
style_installed_theme: s32;
style_installed_dark: bool;
style_installed_index: s32;
style_installed_waozi: bool;
style_installed_revision: s32 = -1;
style_installed_scope: s32 = -1;
style_generation: s32;
style_parse_sources: [StyleRuleCapacity]StyleRuleSource;
style_parse_source_count: s32;
style_inspection_rules: StyleRules;

// One sheet holds the style pack, the app sheet and the account's sheets.
// It and its parser are globals: both are far too large for an Android
// stack frame.
style_css_sheet: CssSheet;
style_css_parser: CssParser;
style_css_overrides: CssOverrides;

// Where each rule of the sheet came from, for the inspector. Rules loaded
// from a compiled pack have no source text, only their file.
StyleRuleOrigin :: struct {
    file: s32
    line: s32
    column: s32
    selector_start: s32
    selector_length: s32
}

style_rule_origins: [CssSheetRuleCapacity]StyleRuleOrigin;
style_compile_sources: [8]string;
style_compile_paths: [8]string;
style_compile_file_count: s32;

// User sheets outrank the app sheet and the pack whatever their layers or
// specificity, and an app's own sheet outranks the sheet for all apps.
StyleUserLayer :: 2000
StyleScopeLayer :: 4000

StyleCompileFile :: (source: string, path: string) -> s32 {
    file := style_compile_file_count
    style_compile_sources[file] = source
    style_compile_paths[file] = path
    style_compile_file_count += 1
    return file
}

StyleSetError :: (message: string, path: string, line: s32, column: s32) {
    StyleClearError()
    unused AppCopyText(message, style_error[:])
    CopyTextToBuffer(*style_error_path[0], 64, path)
    style_error_line = line
    style_error_column = column
}

// A diagnostic ends with " at FILE:LINE" or " at FILE:LINE:COLUMN"; the
// editor shows the position apart from the message.
StyleSetDiagnostic :: (message: string) {
    cut: s32 = -1
    for index: cast(s32)0..cast(s32)message.count - 4 {
        if message[index:index + 4] == " at " { cut = index }
    }
    if cut < 0 {
        StyleSetError(message, "", 0, 0)
        return
    }
    place := message[cut + 4:message.count]
    numbers: [2]s32
    found: s32 = 0
    end: s32 = cast(s32)place.count
    while found < 2 {
        colon: s32 = end - 1
        while colon >= 0 && place[colon] != #char ":" { colon -= 1 }
        if colon < 0 || colon + 1 >= end { break }
        value: s32 = 0
        digits := true
        at: s32 = colon + 1
        while at < end {
            digit := cast(s32)place[at] - 48
            if digit < 0 || digit > 9 { digits = false }
            else { value = value * 10 + digit }
            at += 1
        }
        if !digits { break }
        numbers[found] = value
        found += 1
        end = colon
    }
    if found == 0 {
        StyleSetError(message, "", 0, 0)
        return
    }
    line := ifx found == 2 then numbers[1] else numbers[0]
    column := ifx found == 2 then numbers[0] else 0
    StyleSetError(message[0:cut], place[0:end], line, column)
}

StyleSheetFailed :: () {
    text: [256]u8
    StyleSetDiagnostic(CssSheetDiagnostic(*style_css_sheet, text[:]))
}

// Parse one sheet into the shared sheet, keeping each rule's origin. Only
// the app supplies shared styles, so no sheet may import another.
StyleParseFile :: (source: string, path: string) -> bool {
    sheet := *style_css_sheet
    p := *style_css_parser
    file := StyleCompileFile(source, path)
    CssBegin(p, source, path)
    while true {
        status := CssStep(p)
        if status == cast(s32)CssStatusRule || status == cast(s32)CssStatusProperty {
            index := sheet.rule_count
            CssSheetTake(sheet, p)
            if sheet.failed {
                StyleSheetFailed()
                return false
            }
            if sheet.rule_count > index {
                style_rule_origins[index] = StyleRuleOrigin.{
                    .file = file, .line = p.origin.line, .column = p.origin.column,
                    .selector_start = p.rule_span.selector_start,
                    .selector_length = p.rule_span.selector_length}
            }
        } else if status == cast(s32)CssStatusDone {
            return true
        } else if status == cast(s32)CssStatusNeedImport || status == cast(s32)CssStatusError {
            if status == cast(s32)CssStatusNeedImport {
                CssFail(p, "Custom sheets cannot import files. Shared styles are supplied by the app.")
            }
            text: [256]u8
            StyleSetDiagnostic(CssDiagnostic(p, text[:]))
            return false
        }
    }
    return false
}

StyleLoadPack :: (style_index: s32, parse: bool) -> bool {
    if parse {
        asset := StyleImport(style_pack_id(style_index))
        if asset.found {
            return StyleParseFile(asset.data, StylePackFile(style_index))
        }
    }
    sheet := *style_css_sheet
    file := StyleCompileFile("", StylePackFile(style_index))
    first := sheet.rule_count
    if !CssSheetLoad(sheet, StylePackCompiled(style_index)) {
        StyleSheetFailed()
        return false
    }
    for index: first..sheet.rule_count - 1 {
        style_rule_origins[index] = StyleRuleOrigin.{.file = file}
    }
    return true
}

StyleRaiseLayers :: (first: s32, amount: s32) {
    for index: first..style_css_sheet.rule_count - 1 {
        style_css_sheet.rules[index].rule.layer += amount
    }
}

// A theme color replaces only a custom property that is a color (or names
// another one) for this environment; the classic pack's --icon is a length.
// And a custom property the account's sheets define wins over the theme.
StyleFilterOverrides :: (first_user_definition: s32, env: CssEnvironment) {
    sheet := *style_css_sheet
    overrides := *style_css_overrides
    index: s32 = 0
    while index < overrides.count {
        user := false
        kind: s32 = cast(s32)CssTokenUndefined
        for definition: cast(s32)0..sheet.definition_count - 1 {
            entry := sheet.definitions[definition]
            if CssNameSame(sheet.names[entry.name], overrides.tokens[index].name) &&
            CssSheetConditionHolds(sheet, entry.condition, env) {
                kind = ifx entry.alias >= 0 then cast(s32)CssTokenAlias else entry.kind
                if definition >= first_user_definition { user = true }
            }
        }
        other_kind := kind != cast(s32)CssTokenUndefined && kind != cast(s32)CssTokenAlias &&
        kind != overrides.tokens[index].kind
        if user || other_kind {
            overrides.tokens[index] = overrides.tokens[overrides.count - 1]
            overrides.count -= 1
        } else {
            index += 1
        }
    }
}

// The origins of the rules that apply for env, in installed order.
StyleCollectSources :: (env: CssEnvironment) {
    sheet := *style_css_sheet
    count: s32 = 0
    for index: cast(s32)0..sheet.rule_count - 1 {
        if !CssSheetConditionHolds(sheet, sheet.rules[index].condition, env) { continue }
        if count >= StyleRuleCapacity { break }
        origin := style_rule_origins[index]
        style_parse_sources[count] = StyleRuleSource.{}
        if origin.file >= 0 && origin.file < style_compile_file_count {
            source := style_compile_sources[origin.file]
            if origin.selector_length > 0 && origin.selector_start >= 0 &&
            origin.selector_start + origin.selector_length <= cast(s32)source.count {
                CopyTextToBuffer(*style_parse_sources[count].selector[0], 160,
                    source[origin.selector_start:origin.selector_start + origin.selector_length])
            }
            CopyTextToBuffer(*style_parse_sources[count].path[0], 64, style_compile_paths[origin.file])
        }
        style_parse_sources[count].line = origin.line
        style_parse_sources[count].column = origin.column
        count += 1
    }
    style_parse_source_count = count
}

StyleCompileSources :: (catalog: ThemeCatalog, dark: bool, style_index: s32,
    all_source: string, scoped_source: string,
    install: bool) -> bool {
    env := CssEnvironmentWithNames(CssDefaultEnvironment(),
        ifx dark then "dark" else "light", "", "", "", "")
    if !catalog.complete {
        StyleSetError("Could not load the selected theme.", "", 0, 0)
        return false
    }
    sheet := *style_css_sheet
    CssSheetReset(sheet)
    style_compile_file_count = 0
    style_parse_source_count = 0
    // Compiled packs install without parsing. The inspector needs each
    // rule's line, so the editor and the inspect tool parse the pack's text.
    if !StyleLoadPack(style_index, !install || style_editor_open) { return false }
    if !StyleParseFile(StyleImport("inbe").data, "assets/styles/inbe.css") { return false }
    first_user_definition := sheet.definition_count
    if all_source.count > 0 {
        first := sheet.rule_count
        if !StyleParseFile(all_source, "appearance/all.css") { return false }
        StyleRaiseLayers(first, StyleUserLayer)
    }
    if scoped_source.count > 0 {
        first := sheet.rule_count
        if !StyleParseFile(scoped_source, "appearance/app.css") { return false }
        StyleRaiseLayers(first, StyleScopeLayer)
    }
    style_css_overrides.count = 0
    StyleOverrides(*style_css_overrides, StyleColorsFor(catalog, dark), style_index)
    StyleFilterOverrides(first_user_definition, env)
    if install {
        if !CssSheetInstall(sheet, env, *style_css_overrides) {
            StyleSheetFailed()
            return false
        }
        StyleCollectSources(env)
        StylePublished()
        return true
    }
    if !CssSheetBuild(sheet, env, *style_css_overrides, *style_inspection_rules) {
        StyleSheetFailed()
        return false
    }
    for index: cast(s32)0..style_inspection_rules.count - 1 {
        style_inspection_rules.items[index].style =
            StyleWithoutTypeface(style_inspection_rules.items[index].style)
    }
    StyleCollectSources(env)
    return true
}

StylePublished :: () {
    for index: cast(s32)0..style_parse_source_count - 1 {
        style_sources[index] = style_parse_sources[index]
    }
    style_source_count = style_parse_source_count
    style_generation += 1
    body: StyleData
    body.font_size = cast(float32)Text16
    AppMetricsConfigureFont(cast(s32)(TextStyleFor(TextStyleRequest.{}, body).font_size + 0.5))
}

#program_export
StyleInstall :: (theme_id: s32, dark: bool, style_index: s32) -> bool {
    if style_installed && style_installed_theme == theme_id &&
    style_installed_dark == dark && style_installed_index == style_index &&
    style_installed_waozi == AppWaoziTheme() &&
    style_installed_revision == style_revision && style_installed_scope == 0 {
        return true
    }
    style_installed = false
    catalog := ThemeCatalogLoad(theme_id, dark)
    if !StyleCompileSources(catalog, dark, style_index, StyleAppliedSource(0), "", true) {
        // A damaged stored preference must never leave startup without a UI.
        style_documents[0].applied[0] = cast(u8)0
        if !StyleCompileSources(catalog, dark, style_index, "", "", true) {
            return false
        }
    }
    style_installed = true
    style_installed_theme = theme_id
    style_installed_dark = dark
    style_installed_index = style_index
    style_installed_waozi = AppWaoziTheme()
    style_installed_revision = style_revision
    style_installed_scope = 0
    return true
}

#program_export
app_apply_style :: (app: *InnerBreeze) -> bool {
    if app == null { return false }
    scope := StyleActiveScope(app)
    // An app without its own sheet compiles to exactly the shared rules, so
    // opening it keeps them. Compiling every sheet again on the frame stalled
    // a minimized practice's window when an app such as Lumi opened.
    if scope == 0 || StyleAppliedSource(scope).count == 0 {
        return StyleInstall(app.theme_id, app.dark_mode != 0, app.style_index)
    }
    if style_installed && style_installed_theme == app.theme_id &&
    style_installed_dark == (app.dark_mode != 0) &&
    style_installed_index == app.style_index &&
    style_installed_waozi == AppWaoziTheme() &&
    style_installed_revision == style_revision && style_installed_scope == scope {
        return true
    }
    catalog := ThemeCatalogLoad(app.theme_id, app.dark_mode != 0)
    if !StyleCompileSources(catalog, app.dark_mode != 0, app.style_index,
        StyleAppliedSource(0), StyleAppliedSource(scope), true) {
        style_documents[scope].applied[0] = cast(u8)0
        if !StyleCompileSources(catalog, app.dark_mode != 0, app.style_index,
            StyleAppliedSource(0), "", true) {
            return false
        }
    }
    style_installed = true
    style_installed_theme = app.theme_id
    style_installed_dark = app.dark_mode != 0
    style_installed_index = app.style_index
    style_installed_waozi = AppWaoziTheme()
    style_installed_revision = style_revision
    style_installed_scope = scope
    return true
}

StyleActiveScope :: (app: *InnerBreeze) -> s32 {
    screen := app.breathing.screen
    if screen == ScreenSettings && app.settings_tab == SETTINGS_TAB_THEME && style_editor_open {
        return style_editor_scope
    }
    if screen == ScreenEList {
        return 1
    }
    if screen == ScreenHabits || screen == ScreenHabitEdit || screen == ScreenHabitSessionEdit {
        return 2
    }
    if screen == ScreenDiary {
        return 4
    }
    if screen == ScreenLumi {
        return 5
    }
    if screen == ScreenStart || screen == ScreenSession || screen == ScreenMeditation ||
    screen == ScreenSunSalutation || screen == ScreenPatterns || screen == ScreenTaiChi || screen == ScreenAstralProjection || screen == ScreenWorkout ||
    screen == ScreenResults || screen == ScreenPracticeConfig {
        return 3
    }
    return 0
}
