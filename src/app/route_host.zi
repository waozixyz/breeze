#import, file "text_buffers.zi";

#scope_file
c :: #system_library "c";
WEB :: #defined(PLATFORM_WEB)
#if WEB {
    #import "web"
    GetRoutePath :: () -> *u8 #foreign c;
    GetRouteHash :: () -> *u8 #foreign c;
    GetRouteQuery :: () -> *u8 #foreign c;
    GetRouteVersion :: () -> s32 #foreign c;
    PushRoute :: (path: *u8) #foreign c;
    ReplaceRoute :: (path: *u8) #foreign c;
}

#scope_export
#program_export
app_route_text :: (text: *u8) -> string {
    if text == null {
        return ""
    }
    return AppTextFromCString(text, 2147483647)
}

#program_export
app_route_hash :: () -> string {
    #if WEB {
        return app_route_text(GetRouteHash())
    }
    return ""
}

// The page's query string, "?" included; empty when there is none.
#program_export
app_route_query :: () -> string {
    #if WEB {
        return app_route_text(GetRouteQuery())
    }
    return ""
}

// The page's full address, read into `buffer`; empty outside a page.
app_route_href :: (buffer: []u8) -> string {
    if buffer.count == 0 {
        return ""
    }
    buffer[0] = cast(u8)0
    #if WEB {
        scope: s32 = WebScope()
        location: s32 = WebGetObject(WebGlobal, WebName("location"))
        if location != 0 && !WebFailed() {
            value: WebValue = WebGet(location, WebName("href"))
            if value.tag == WebStringTag {
                unused WebCopyString(WebAsObject(value), buffer)
            }
        }
        WebEnd(scope)
    }
    return AppTextFromCString(*buffer[0], cast(s32)buffer.count)
}

#program_export
app_route_base :: () -> string {
    #if WEB {
        return app_route_text(GetRoutePath())
    }
    return ""
}

#program_export
app_route_version :: () -> s32 {
    #if WEB {
        return GetRouteVersion()
    }
    return 0
}

#program_export
app_route_write :: (url: []u8, length: s32, push: bool) -> bool {
    #if !WEB {
        return false
    }
    #if WEB {
    if length < 0 || length > cast(s32)url.count || length >= 2049 ||
        url.count == 0 || *url[0] == null {
        return false
    }
    path: [2049]u8
    index: s32 = 0
    while index < length {
        path[index] = url[index]
        index += 1
    }
    path[length] = cast(u8)0
    if push {
        PushRoute(*path[0])
    } else {
        ReplaceRoute(*path[0])
    }
    return true
    }
}
