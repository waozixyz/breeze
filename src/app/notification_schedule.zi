// Inbe owns the reminder schedule. The platform sends the notification.
#program_export
ReminderDue :: (enabled: bool, reminder_hour: s32, last_day: s32,
                day_key: s32, current_hour: s32) -> bool {
    if !enabled || day_key <= 0 || last_day == day_key { return false }
    return reminder_hour == current_hour
}
