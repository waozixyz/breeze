DONATION_REMINDER_PRACTICE_INTERVAL :: 20

#program_export
donation_next_threshold :: (last_prompt_count: s32, observed_count: s32) -> s32 {
    next := last_prompt_count + DONATION_REMINDER_PRACTICE_INTERVAL
    if next < DONATION_REMINDER_PRACTICE_INTERVAL {
        next = DONATION_REMINDER_PRACTICE_INTERVAL
    }
    while next <= observed_count {
        next += DONATION_REMINDER_PRACTICE_INTERVAL
    }
    return next
}
