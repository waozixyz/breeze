    g_sync_result: SyncWorkerResult;
    g_social_result: SocialWorkerResult;
    g_sync_events_running: s32 = 0;
}

sync_lock :: () {
    SyncLock()
}

sync_unlock :: () {
    SyncUnlock()
}

app_sync_record_result :: (result: s32) {
    SettingsStoreInt("sync_last_result", result)
    decision := sync_retry_decision(result,
        SettingsReadInt("sync_retry_attempt", 0))
    g_sync.retry_at = 0.0
    if decision.needs_action != 0 {
        return
    }
    SettingsStoreInt("sync_retry_attempt", decision.attempt)
    if decision.delay > 0 {
        g_sync.retry_at = GetTime() + cast(float64)decision.delay
    }
}

app_social_record_result :: (result: s32) {
    decision := sync_retry_decision(result, g_sync.social_retry_attempt)
    g_sync.social_retry_at = 0.0
    if decision.needs_action != 0 {
        g_sync.social_refresh_pending = 0
        return
    }
    g_sync.social_retry_attempt = decision.attempt
    if decision.delay > 0 {
        g_sync.social_retry_at = GetTime() + cast(float64)decision.delay
        g_sync.social_refresh_pending = 1
    }
}

app_sync_status_key :: () -> string {
    status: SyncStatus
    if storage_sync_enabled() == 0 {
        return SyncStatusKeyFor(false, false, 0, false, status)
    }
    if app_sync_loading() != 0 {
        return SyncStatusKeyFor(true, true, 0, false, status)
    }
    result: s32 = SettingsReadInt("sync_last_result", SYNC_OK)
    if result != SYNC_OK {
        return SyncStatusKeyFor(true, false, result, false, status)
    }
    has_status := SyncStatusRead(*status)
    return SyncStatusKeyFor(true, false, result, has_status, status)
}

app_sync_progress_text :: (out: *u8, out_size: s64) {
    status: SyncStatus

    if out == null || out_size == 0 {
        return
    }
    out[0] = cast(u8)0
    if app_sync_loading() != 0 {
        if SyncStatusRead(*status) {
            if status.queued_changes > 0 {
                FormatLocaleCount(out, out_size, "sync_progress_uploading",
                    cast(s32)status.queued_changes)
                return
            }
        }
        SyncCopyText(out, out_size, LocaleText("sync_progress_restoring"))
        return
    }
    if app_social_refresh_loading() != 0 {
        SyncCopyText(out, out_size, LocaleText("sync_progress_friends"))
        return
    }
    FormatLocaleText(out, out_size, app_sync_status_key())
}

app_clear_disconnected_sync_work :: () {
    #if !ASYNC {
        sync_lock()
    }
    g_sync.retry_at = 0.0
    g_sync.dirty_sync_at = 0.0
    g_sync.remote_sync_due = 0
    g_sync.social_retry_at = 0.0
    g_sync.social_retry_attempt = 0
    g_sync.social_refresh_pending = 0
    SocialQueueClear()
    #if !ASYNC {
        sync_unlock()
    }
    g_sync_events_url[0] = cast(u8)0
    #if ASYNC {
        CancelStoredOperation(*g_sync_operation)
        CancelSocialRefresh(*g_social_async)
        g_sync.sync_running = 0
        g_sync.social_refresh_running = 0
    }
    #if WEB {
        CloseRemoteEvents(*g_remote_events)
    }
}

app_queue_social_refresh :: () {
    g_sync.social_refresh_pending = 1
}

app_mark_used :: (app: *InnerBreeze) {
    if app == null {
        return
    }
}

app_social_push_action :: (action: string, value: string) -> s32 {
    if SocialQueueCount() >= SOCIAL_ACTION_QUEUE_MAX {
        SyncLog(LOG_WARNING, "SYNC: social action queue full")
        return 0
    }
    if !SocialQueuePush(action, value) { return 0 }
    g_sync.social_refresh_pending = 1
    return 1
}

#if !ASYNC {
app_social_fetch :: (url: string, practice: string, metric: string,
    action: string, action_value: string,
    requests_json: *u8, requests_size: s64,
    friends_json: *u8, friends_size: s64,
    leaderboard_json: *u8, leaderboard_size: s64) -> SyncResult {
    result: SyncResult = cast(SyncResult)SYNC_INVALID_URL
    friends_result: SyncResult = cast(SyncResult)SYNC_REQUEST_FAILED
    leaderboard_result: SyncResult = cast(SyncResult)SYNC_REQUEST_FAILED

    if requests_json != null && requests_size > 0 {
        SyncCopyText(requests_json, requests_size, "{\"incoming\":[],\"outgoing\":[]}")
    }
    if friends_json != null && friends_size > 0 {
        SyncCopyText(friends_json, friends_size, "{\"friends\":[]}")
    }
    if leaderboard_json != null && leaderboard_size > 0 {
        SyncCopyText(leaderboard_json, leaderboard_size, "{\"rows\":[]}")
    }
    if url.count == 0 {
        return cast(SyncResult)SYNC_INVALID_URL
    }

    if action.count > 0 && action == "send" {
        result = cast(SyncResult)SendFriendRequestStored(url, action_value)
        if result != cast(SyncResult)SYNC_OK {
            return result
        }
    } else if action.count > 0 && action == "accept" {
        result = cast(SyncResult)AcceptFriendRequestStored(url, action_value)
        if result != cast(SyncResult)SYNC_OK {
            return result
        }
    } else if action.count > 0 && action == "decline" {
        result = cast(SyncResult)DeclineFriendRequestStored(url, action_value)
        if result != cast(SyncResult)SYNC_OK {
            return result
        }
    } else if action.count > 0 && action == "remove" {
        result = cast(SyncResult)RemoveFriendStored(url, action_value)
        if result != cast(SyncResult)SYNC_OK {
            return result
        }
    }

    result = cast(SyncResult)FetchFriendRequests(url,
        BytesFromPointer(requests_json, cast(u64)requests_size))
    if result != cast(SyncResult)SYNC_OK {
        return result
    }
    friends_result = cast(SyncResult)FetchFriends(url,
        BytesFromPointer(friends_json, cast(u64)friends_size))
    if friends_result != cast(SyncResult)SYNC_OK {
        return friends_result
    }
    leaderboard_result = cast(SyncResult)FetchFriendStats(url, practice,
        metric, BytesFromPointer(leaderboard_json,
            cast(u64)leaderboard_size))
    if leaderboard_result != cast(SyncResult)SYNC_OK && leaderboard_size > 0 {
        leaderboard_json[0] = cast(u8)0
    }
    return cast(SyncResult)SYNC_OK
}

}

app_social_practice_id :: (practice: s32) -> string {
    if practice == EXERCISE_MEDITATION {
        return "meditation"
    }
    if practice == EXERCISE_SUN_SALUTATION {
        return "sun_salutation"
    }
    if practice == EXERCISE_PATTERNS {
        return "patterns"
    }
    return "whm"
}

app_social_metric_id :: (practice: s32, metric: s32) -> string {
    if metric != 1 {
        return "streak"
    }
    return ifx (practice == EXERCISE_MEDITATION) then ("avg_time") else ("avg_hold")
}

app_social_leaderboard_key :: (out: *u8, out_size: s64,
    practice: s32, metric: s32) {
    if out == null || out_size == 0 {
        return
    }
    SyncCopyText(out, out_size, "leaderboard.breathing.")
    SyncAppendText(out, out_size, app_social_practice_id(practice))
    SyncAppendText(out, out_size, ".")
    SyncAppendText(out, out_size, app_social_metric_id(practice, metric))
}

app_social_apply_result :: (app: *InnerBreeze, requests_json: string,
    friends_json: string,
    leaderboard_json: string,
    leaderboard_key: string,
    leaderboard_avg_json: string,
    leaderboard_avg_key: string) {
    storage_set_social_cache_json("friends.requests", requests_json)
    storage_set_social_cache_json("friends.list", friends_json)
    if leaderboard_key.count > 0  && leaderboard_json.count > 0 {
        storage_set_social_cache_json(leaderboard_key, leaderboard_json)
    }
    if leaderboard_avg_key.count > 0  && leaderboard_avg_json.count > 0 {
        storage_set_social_cache_json(leaderboard_avg_key, leaderboard_avg_json)
    }
    if app != null {
        AppCopyText(ifx (requests_json.count > 0) then (requests_json) else ("{\"incoming\":[],\"outgoing\":[]}"), app.profile_friend_requests_json[:])
        AppCopyText(ifx (friends_json.count > 0) then (friends_json) else ("{\"friends\":[]}"), app.profile_friends_json[:])
        if leaderboard_key.count > 0  && leaderboard_json.count > 0 {
            current_key: [96] u8
            app_social_leaderboard_key(*current_key[0], 96,
                app.profile_leaderboard_practice,
                app.profile_leaderboard_metric)
            if AppTextFromCString(*current_key[0], 96) == leaderboard_key {
                AppCopyText(ifx (leaderboard_json.count > 0) then (leaderboard_json) else ("{\"rows\":[]}"), app.profile_leaderboard_json[:])
            }
        }
        if leaderboard_avg_key.count > 0  && leaderboard_avg_json.count > 0 {
            current_avg_key: [96] u8
            app_social_leaderboard_key(*current_avg_key[0], 96,
                app.profile_leaderboard_practice, 1)
            if AppTextFromCString(*current_avg_key[0], 96) == leaderboard_avg_key {
                AppCopyText(ifx (leaderboard_avg_json.count > 0) then (leaderboard_avg_json) else ("{\"rows\":[]}"), app.profile_leaderboard_avg_json[:])
            }
        }
        app.profile_friends_loaded = 1
        app.profile_leaderboard_loaded = 1
        app_notifications_on_friends_synced(app)
    }
}

#if !ASYNC {
    app_sync_worker :: (userdata: *void) -> void {
        args := cast(*SyncWorkerArgs)userdata
        result: SyncResult
        changed: s32 = 0

        if args != null {
            result = cast(SyncResult)SyncStoredAccount(
                AppTextFromCString(*args.url[0], 256))
            if result == cast(SyncResult)SYNC_OK && storage_last_sync_changed() != 0 {
                changed = 1
            }
            SyncWorkerFree(cast(*void)args)
        }

        sync_lock()
        g_sync_result.result = cast(s32)result
        g_sync_result.changed = cast(s32)changed
        g_sync_result.finished = 1
        g_sync.sync_running = 0
        sync_unlock()
        return
    }

    app_social_worker :: (userdata: *void) -> void {
        args := cast(*SocialWorkerArgs)userdata
        result: SyncResult = cast(SyncResult)SYNC_INVALID_URL
        requests_json: [8192] u8
        friends_json: [8192] u8
        leaderboard_json: [8192] u8
        leaderboard_avg_json: [8192] u8
        leaderboard_avg_result: SyncResult = cast(SyncResult)SYNC_OK

        if args != null {
            result = app_social_fetch(AppTextFromCString(*args.url[0], 256), AppTextFromCString(*args.practice[0], 32), AppTextFromCString(*args.metric[0], 32),
                AppTextFromCString(*args.action[0], 16), AppTextFromCString(*args.action_value[0], 96),
                *requests_json[0], size_of(type_of(requests_json)),
                *friends_json[0], size_of(type_of(friends_json)),
                *leaderboard_json[0], size_of(type_of(leaderboard_json)))
            SyncCopyText(*leaderboard_avg_json[0], size_of(type_of(leaderboard_avg_json)), "{\"rows\":[]}")
            if result == cast(SyncResult)SYNC_OK && AppTextFromCString(*args.practice[0], 32) == "whm" {
                avg_metric: string = ifx (AppTextFromCString(*args.practice[0], 32) == "meditation") then ("avg_time") else ("avg_hold")
                leaderboard_avg_result = cast(SyncResult)FetchFriendStats(
                    AppTextFromCString(*args.url[0], 256),
                    AppTextFromCString(*args.practice[0], 32), avg_metric,
                    leaderboard_avg_json[:])
                if leaderboard_avg_result != cast(SyncResult)SYNC_OK {
                    leaderboard_avg_json[0] = cast(u8)0
                }
            }
        } else {
            SyncCopyText(*requests_json[0], size_of(type_of(requests_json)), "{\"incoming\":[],\"outgoing\":[]}")
            SyncCopyText(*friends_json[0], size_of(type_of(friends_json)), "{\"friends\":[]}")
            SyncCopyText(*leaderboard_json[0], size_of(type_of(leaderboard_json)), "{\"rows\":[]}")
            SyncCopyText(*leaderboard_avg_json[0], size_of(type_of(leaderboard_avg_json)), "{\"rows\":[]}")
        }

        sync_lock()
        g_social_result.result = cast(s32)result
        SyncCopyText(*g_social_result.friend_requests_json[0], 8192, AppTextFromCString(*requests_json[0], 8192))
        SyncCopyText(*g_social_result.friends_json[0], 8192, AppTextFromCString(*friends_json[0], 8192))
        SyncCopyText(*g_social_result.leaderboard_json[0], 8192, AppTextFromCString(*leaderboard_json[0], 8192))
        if args != null {
            AppCopyText(AppTextFromCString(*args.leaderboard_key[0], 96), g_social_result.leaderboard_key[:])
        } else {
            g_social_result.leaderboard_key[0] = cast(u8)0
        }
        SyncCopyText(*g_social_result.leaderboard_avg_json[0], 8192, AppTextFromCString(*leaderboard_avg_json[0], 8192))
        if args != null {
            AppCopyText(AppTextFromCString(*args.leaderboard_avg_key[0], 96), g_social_result.leaderboard_avg_key[:])
        }
        g_social_result.finished = 1
        g_sync.social_refresh_running = 0
        sync_unlock()
        SyncWorkerFree(cast(*void)args)
        return
    }

    app_sync_events_worker :: (userdata: *void) -> void {
        args := cast(*SyncWorkerArgs)userdata

        if args == null {
            return
        }
        while true {
            result: SyncResult

            sync_lock()
            if g_sync.sync_running != 0 {
                sync_unlock()
                SyncSleepSeconds(1)
                continue
            }
            sync_unlock()

            result = cast(SyncResult)WaitStoredRemoteEvent(AppTextFromCString(*args.url[0], 256))
            sync_lock()
            if result == cast(SyncResult)SYNC_OK {
                g_sync.remote_sync_due = 1
            }
            sync_unlock()
            if result != cast(SyncResult)SYNC_OK {
                SyncSleepSeconds(2)
            }
        }
    }
}

app_collect_finished_sync :: () {
    result: s32 = 0
    changed: s32 = 0
    #if !ASYNC {
        sync_lock()
        finished := g_sync_result.finished
        result = g_sync_result.result
        changed = g_sync_result.changed
        g_sync_result.finished = 0
        sync_unlock()
        if finished == 0 {
            return
        }
    }
    #if ASYNC {
        if g_sync.sync_running == 0 || !PollStoredOperation(*g_sync_operation) {
            return
        }
        result = g_sync_operation.result
        changed = g_sync_operation.changed
        g_sync.sync_running = 0
    }
    app_sync_record_result(result)
    if result == SYNC_OK {
        SyncLog(LOG_INFO, "SYNC: background sync complete")
        app_queue_social_refresh()
        if changed != 0 {
            g_sync.data_refresh_pending = 1
        }
    } else {
        SyncLog(LOG_WARNING, "SYNC: background sync failed")
    }
}

app_ensure_sync_events :: (url: string) {
    if url.count == 0 {
        return
    }
    #if !ASYNC {
        sync_lock()
        if g_sync_events_running != 0 {
            sync_unlock()
            return
        }
        g_sync_events_running = 1
        g_sync.remote_sync_due = 1
        AppCopyText(url, g_sync_events_url[:])
        sync_unlock()
        args := cast(*SyncWorkerArgs)SyncWorkerAlloc(cast(usize)size_of(SyncWorkerArgs))
        if args == null {
            sync_lock()
            g_sync_events_running = 0
            g_sync_events_url[0] = cast(u8)0
            sync_unlock()
            return
        }
        SyncCopyText(*args.url[0], 256, url)
        if SyncStart(app_sync_events_worker, cast(*void)args) == 0 {
            SyncWorkerFree(cast(*void)args)
            sync_lock()
            g_sync_events_running = 0
            g_sync_events_url[0] = cast(u8)0
            sync_unlock()
        }
    }
    #if WEB {
        now := GetTime()
        if AppTextFromCString(*g_sync_events_url[0], 512) != url {
            CloseRemoteEvents(*g_remote_events)
            g_sync_events_url[0] = cast(u8)0
        }
        if g_sync_events_url[0] == cast(u8)0 {
            if now < g_sync_events_retry_at {
                return
            }
            if !BeginRemoteEvents(*g_remote_events, url) {
                g_sync_events_retry_at = now + 2.0
                return
            }
            unused AppCopyText(url, g_sync_events_url[:])
            g_sync.remote_sync_due = 1
        }
        event := PollRemoteEvents(*g_remote_events)
        if event == 0 {
            g_sync_events_url[0] = cast(u8)0
            g_sync_events_retry_at = now + 2.0
        } else if event > 0 {
            g_sync.remote_sync_due = 1
        }
    }
    #if #defined(ANDROID_BUILD) {
        now := GetTime()
        if AppTextFromCString(*g_sync_events_url[0], 512) != url ||
            now >= g_sync_events_retry_at {
            unused AppCopyText(url, g_sync_events_url[:])
            g_sync.remote_sync_due = 1
            g_sync_events_retry_at = now + 30.0
        }
    }
}

app_modal_type_name :: (type: ModalType) -> string {
    if type == cast(ModalType)ModalNone {
        return "none"
    } else if type == cast(ModalType)ModalConfirmExitSession {
        return "confirm_exit_session"
    } else if type == cast(ModalType)ModalMeditationSetup {
        return "meditation_setup"
    } else if type == cast(ModalType)ModalConfirmDeleteData {
        return "confirm_delete_data"
    } else if type == cast(ModalType)ModalConfirmDeleteHabit {
        return "confirm_delete_habit"
    } else if type == cast(ModalType)ModalEditProgressiveStartSpeed {
        return "edit_progressive_start_speed"
    } else if type == cast(ModalType)ModalMeditationNetworkError {
        return "meditation_network_error"
    } else if type == cast(ModalType)ModalConfirmImportDataSettings {
        return "confirm_import_data_settings"
    } else if type == cast(ModalType)ModalSyncAccountBackup {
        return "sync_account_backup"
    } else if type == cast(ModalType)ModalConfirmDeleteSyncAccount {
        return "confirm_delete_sync_account"
    } else if type == cast(ModalType)ModalHabitPracticePicker {
        return "habit_link_practices"
    } else if type == cast(ModalType)ModalPracticeManual {
        return "practice_manual"
    } else if type == cast(ModalType)ModalPracticeConfig {
        return "practice_config"
    } else if type == cast(ModalType)ModalAppIconPicker {
        return "app_icon_picker"
    } else if type == cast(ModalType)ModalThemePicker {
        return "theme_picker"
    } else if type == cast(ModalType)ModalSyncReview {
        return "sync_review"
    } else if type == cast(ModalType)ModalSyncAlias {
        return "sync_alias"
    } else if type == cast(ModalType)ModalSyncPublicId {
        return "sync_public_id"
    } else if type == cast(ModalType)ModalConfirmRemoveFriend {
        return "confirm_remove_friend"
    } else if type == cast(ModalType)ModalConfirmSyncAccountSwitch {
        return "confirm_sync_account_switch"
    } else if type == cast(ModalType)ModalBottomNavConfig {
        return "bottom_nav_config"
    } else if type == cast(ModalType)ModalProfilePicturePicker {
        return "profile_picture_picker"
    } else if type == cast(ModalType)ModalDonationReminder {
        return "donation_reminder"
    }
    return ""
    return "unknown"
}

app_sync_record_input :: (app: *InnerBreeze, now: float64) {
    if app.ui.pointer_active {
        g_sync.last_input_at = now
    }
}

app_sync_user_idle :: (app: *InnerBreeze, now: float64) -> s32 {
    return ifx SyncUserIdle(now, g_sync.last_input_at,
        app.ui.pointer_active) then 1 else 0
}

app_sync_ui_update_safe :: (app: *InnerBreeze, now: float64) -> s32 {
    return ifx SyncUiUpdateSafe(app, now, g_sync.last_input_at,
        app.ui.pointer_active) then 1 else 0
}

app_apply_pending_sync_refresh :: (app: *InnerBreeze, now: float64) {
    if g_sync.data_refresh_pending == 0 || app_sync_ui_update_safe(app, now) == 0 {
        return
    }
    g_sync.data_refresh_pending = 0
    SyncLog(LOG_INFO, "SYNC: applying remote refresh")
    app_reload_after_import(app, 0)
}

// The sync pump runs every frame; the server URL and whether sync is on only
// change with the stored data, so they are read again only after it does.
sync_url_cache: [256] u8;
sync_url_cache_ok: s32;
sync_url_cache_revision: s64 = -1;

app_sync_url :: (url: *u8, url_size: s64) -> s32 {
    if url == null || url_size == 0 {
        return 0
    }
    url[0] = cast(u8)0
    revision := storage_data_revision()
    if revision != sync_url_cache_revision {
        sync_url_cache_revision = revision
        sync_url_cache_ok = 0
        sync_url_cache[0] = cast(u8)0
        if storage_sync_enabled() != 0 {
            saved_url := storage_get_setting_text(sync_server_url_key)
            if saved_url.count > 0 && NormalizeUrl(saved_url, sync_url_cache[:]) {
                sync_url_cache_ok = 1
            }
        }
    }
    if sync_url_cache_ok == 0 {
        return 0
    }
    if !AppCopyText(AppTextFromCString(*sync_url_cache[0],
        cast(s32)sync_url_cache.count), BytesFromPointer(url, cast(u64)url_size)) {
        return 0
    }
    return 1
}

app_apply_pending_social_refresh :: (app: *InnerBreeze) {
    url: [256] u8
    action: [16]u8
    action_value: [96]u8

    now := GetTime()

    if GetTime() < g_sync.social_retry_at {
        return
    }
    if g_sync.social_refresh_pending == 0 || app_background_sync_safe(app) == 0  || app_sync_user_idle(app, now) == 0 {
        return
    }
    if g_sync.dirty_sync_at > 0.0 {
        return
    }
    #if !ASYNC {
        args: *SocialWorkerArgs

        if app_sync_url(*url[0], size_of(type_of(url))) == 0 {
            app_clear_disconnected_sync_work()
            return
        }
        args = cast(*SocialWorkerArgs)SyncWorkerAlloc(cast(usize)size_of(SocialWorkerArgs))
        if args == null {
            return
        }
        sync_lock()
        if g_sync.sync_running != 0 || g_sync.social_refresh_running != 0 {
            sync_unlock()
            SyncWorkerFree(cast(*void)args)
            return
        }
        SocialQueuePeek(action[:], action_value[:])
        g_sync.social_refresh_pending = 0
        g_sync.social_refresh_running = 1
        sync_unlock()

        SyncCopyText(*args.url[0], 256, AppTextFromCString(*url[0], 256))
        SyncCopyText(*args.practice[0], 32, app_social_practice_id(app.profile_leaderboard_practice))
        SyncCopyText(*args.metric[0], 32, app_social_metric_id(app.profile_leaderboard_practice,
            app.profile_leaderboard_metric))
        app_social_leaderboard_key(*args.leaderboard_key[0],
            size_of(type_of(args.leaderboard_key)),
            app.profile_leaderboard_practice,
            PROFILE_LEADERBOARD_STREAK)
        app_social_leaderboard_key(*args.leaderboard_avg_key[0],
            size_of(type_of(args.leaderboard_avg_key)),
            app.profile_leaderboard_practice,
            PROFILE_LEADERBOARD_AVG_HOLD)
        SyncCopyText(*args.metric[0], 32, "streak")
        SyncCopyText(*args.action[0], 16, AppTextFromCString(*action[0], 16))
        SyncCopyText(*args.action_value[0], 96, AppTextFromCString(*action_value[0], 96))
        SyncLog(LOG_INFO, "SYNC: starting background social refresh")
        if SyncStart(app_social_worker, cast(*void)args) == 0 {
            SyncWorkerFree(cast(*void)args)
            sync_lock()
            g_sync.social_refresh_running = 0
            g_sync.social_refresh_pending = 1
            sync_unlock()
            SyncLog(LOG_WARNING, "SYNC: failed to start social refresh thread")
            return
        }
        sync_lock()
        SocialQueuePop(action[:], action_value[:])
        sync_unlock()
    }
    #if ASYNC {
        if g_sync.sync_running != 0 || g_sync.social_refresh_running != 0 {
            return
        }
        if app_sync_url(*url[0], size_of(type_of(url))) == 0 {
            app_clear_disconnected_sync_work()
            return
        }
        SocialQueuePeek(action[:], action_value[:])
        app_social_leaderboard_key(*g_social_streak_key[0], 96,
            app.profile_leaderboard_practice, PROFILE_LEADERBOARD_STREAK)
        app_social_leaderboard_key(*g_social_average_key[0], 96,
            app.profile_leaderboard_practice, PROFILE_LEADERBOARD_AVG_HOLD)
        if !BeginSocialRefresh(*g_social_async, AppTextFromCString(*url[0], 256),
            NetworkTransport(*g_social_transfer),
            app_social_practice_id(app.profile_leaderboard_practice),
            AppTextFromCString(*action[0], 16), AppTextFromCString(*action_value[0], 96)) {
            app_social_record_result(g_social_async.result)
            return
        }
        g_sync.social_refresh_running = 1
        g_sync.social_refresh_pending = 0
    }
}

app_collect_finished_social_refresh :: (app: *InnerBreeze) {
    #if !ASYNC {
        finished: s32
        result: s32
        requests_json: [8192] u8
        friends_json: [8192] u8
        leaderboard_json: [8192] u8
        leaderboard_key: [96] u8
        leaderboard_avg_json: [8192] u8
        leaderboard_avg_key: [96] u8

        sync_lock()
        finished = g_social_result.finished
        result = g_social_result.result
        if finished != 0 {
            SyncCopyText(*requests_json[0], size_of(type_of(requests_json)),
                AppTextFromCString(*g_social_result.friend_requests_json[0], 8192))
            SyncCopyText(*friends_json[0], size_of(type_of(friends_json)),
                AppTextFromCString(*g_social_result.friends_json[0], 8192))
            SyncCopyText(*leaderboard_json[0], size_of(type_of(leaderboard_json)),
                AppTextFromCString(*g_social_result.leaderboard_json[0], 8192))
            SyncCopyText(*leaderboard_key[0], size_of(type_of(leaderboard_key)),
                AppTextFromCString(*g_social_result.leaderboard_key[0], 96))
            SyncCopyText(*leaderboard_avg_json[0], size_of(type_of(leaderboard_avg_json)),
                AppTextFromCString(*g_social_result.leaderboard_avg_json[0], 8192))
            SyncCopyText(*leaderboard_avg_key[0], size_of(type_of(leaderboard_avg_key)),
                AppTextFromCString(*g_social_result.leaderboard_avg_key[0], 96))
            g_social_result.finished = 0
        }
        sync_unlock()

        if finished == 0 {
            return
        }
        app_social_record_result(result)
        if result != SYNC_OK {
            SyncLog(LOG_WARNING, "SYNC: social refresh failed")
            return
        }
        app_social_apply_result(app,
            AppTextFromCString(*requests_json[0], 8192),
            AppTextFromCString(*friends_json[0], 8192),
            AppTextFromCString(*leaderboard_json[0], 8192),
            AppTextFromCString(*leaderboard_key[0], 96),
            AppTextFromCString(*leaderboard_avg_json[0], 8192),
            AppTextFromCString(*leaderboard_avg_key[0], 96))
        sync_lock()
        if SocialQueueCount() > 0 {
            g_sync.social_refresh_pending = 1
        }
        sync_unlock()
        SyncLog(LOG_INFO, "SYNC: social cache refreshed")
    }
    #if ASYNC {
        if g_sync.social_refresh_running == 0 {
            return
        }
        finished := PollSocialRefresh(*g_social_async)
        if g_social_async.action_done {
            action: [16]u8
            value: [96]u8
            SocialQueuePop(action[:], value[:])
            g_social_async.action_done = false
        }
        if !finished {
            return
        }
        g_sync.social_refresh_running = 0
        app_social_record_result(g_social_async.result)
        if g_social_async.result == SYNC_OK {
            app_social_apply_result(app,
                AppTextFromCString(*g_social_async.requests[0], 8192),
                AppTextFromCString(*g_social_async.friends[0], 8192),
                AppTextFromCString(*g_social_async.streak[0], 8192),
                AppTextFromCString(*g_social_streak_key[0], 96),
                AppTextFromCString(*g_social_async.average[0], 8192),
                AppTextFromCString(*g_social_average_key[0], 96))
        }
        if SocialQueueCount() > 0 {
            g_sync.social_refresh_pending = 1
        }
    }
}

#program_export
app_request_social_refresh :: (app: *InnerBreeze) {
    app_mark_used(app)
    app_queue_social_refresh()
}

#program_export
app_social_refresh_loading :: () -> s32 {
    loading: s32 = 0
    #if !ASYNC {
        sync_lock()
        if g_sync.social_refresh_pending != 0 || g_sync.social_refresh_running != 0  || g_social_result.finished != 0 {
            loading = 1
        } else {
            loading = 0
        }
        sync_unlock()
    } else {
        if g_sync.social_refresh_pending != 0 || g_sync.social_refresh_running != 0 {
            loading = 1
        } else {
            loading = 0
        }
    }
    return loading
}

app_sync_loading :: () -> s32 {
    loading: s32 = 0
    #if !ASYNC {
        sync_lock()
        if g_sync.sync_running != 0 {
            loading = 1
        }
        sync_unlock()
    }
    #if ASYNC {
        loading = g_sync.sync_running
    }
    return loading
}

app_request_social_action :: (action: string, value: string) {
    url: [256] u8

    if action.count == 0 || value.count == 0  || action[0] == 0 || value[0] == 0 {
        return
    }
    if app_sync_url(*url[0], size_of(type_of(url))) == 0 {
        return
    }
    #if !ASYNC {
        sync_lock()
        app_social_push_action(action, value)
        sync_unlock()
    } else {
        app_social_push_action(action, value)
    }
}

#program_export
app_request_friend_send :: (app: *InnerBreeze, target: string) {
    app_mark_used(app)
    app_request_social_action("send", target)
}

#program_export
app_request_friend_accept :: (app: *InnerBreeze, request_id: string) {
    app_mark_used(app)
    app_request_social_action("accept", request_id)
}

#program_export
app_request_friend_decline :: (app: *InnerBreeze, request_id: string) {
    app_mark_used(app)
    app_request_social_action("decline", request_id)
}

#program_export
app_request_friend_remove :: (app: *InnerBreeze, friend_user_id: string) {
    app_mark_used(app)
    app_request_social_action("remove", friend_user_id)
}

app_sync_now :: (app: *InnerBreeze) -> s32 {
    url: [256] u8

    if app == null || app_sync_url(*url[0], size_of(type_of(url))) == 0 {
        return 0
    }
    #if !ASYNC {
        args: *SyncWorkerArgs

        sync_lock()
        if g_sync.sync_running != 0 {
            sync_unlock()
            return 0
        }
        g_sync.sync_running = 1
        sync_unlock()

        args = cast(*SyncWorkerArgs)SyncWorkerAlloc(cast(usize)size_of(SyncWorkerArgs))
        if args == null {
            sync_lock()
            g_sync.sync_running = 0
            sync_unlock()
            return 0
        }
        SyncCopyText(*args.url[0], 256, AppTextFromCString(*url[0], 256))
        SyncLog(LOG_INFO, "SYNC: starting background sync")
        if SyncStart(app_sync_worker, cast(*void)args) == 0 {
            SyncWorkerFree(cast(*void)args)
            sync_lock()
            g_sync.sync_running = 0
            sync_unlock()
            SyncLog(LOG_WARNING, "SYNC: failed to start background sync thread")
            return 0
        }
        return 1
    } else {
        if g_sync.sync_running != 0 {
            return 0
        }
        g_sync.sync_running = 1
        SyncLog(LOG_INFO, "SYNC: starting background sync")
        if !BeginStoredSync(*g_sync_operation, AppTextFromCString(*url[0], 256),
            NetworkTransport(*g_sync_transfer)) {
            g_sync.sync_running = 0
            SyncLog(LOG_WARNING, "SYNC: failed to start background sync")
            return 0
        }
        return 1
    }
}

#program_export
app_auto_sync :: (app: *InnerBreeze) -> s32 {
    due: float64
    now: float64
    url: [256] u8

    if app == null || PreviewMode() != 0 || DataTemporary() ||
        app_sync_url(*url[0], size_of(type_of(url))) == 0 {
        return 0
    }
    now = GetTime()
    g_sync.last_input_at = now
    due = now + sync_input_quiet_seconds
    if g_sync.dirty_sync_at <= 0.0 || due < g_sync.dirty_sync_at {
        g_sync.dirty_sync_at = due
    }
    SyncLog(LOG_INFO, "SYNC: automatic sync scheduled")
    return 1
}

sync_review_cache: s32;
sync_review_cache_revision: s64 = -1;

// Whether a sync review waits, read again only after stored data changes.
app_sync_review_pending :: () -> s32 {
    revision := storage_data_revision()
    if revision != sync_review_cache_revision {
        sync_review_cache_revision = revision
        sync_review_cache = storage_sync_review_pending()
    }
    return sync_review_cache
}

app_sync_pump :: (app: *InnerBreeze) {
    now: float64
    should_sync: s32 = 0
    dirty_due: s32 = 0
    repair_due: s32 = 0
    url: [256] u8
    sync_status: SyncStatus

    if app == null {
        return
    }
    if PreviewMode() != 0 {
        return
    }
    if app.ui.sync_requested != false {
        app.ui.sync_requested = false
        unused app_auto_sync(app)
    }
    now = GetTime()
    app_sync_record_input(app, now)
    app_collect_finished_sync()
    app_collect_finished_social_refresh(app)
    if app_sync_review_pending() != 0 && app_sync_ui_update_safe(app, now) != 0 {
        if storage_sync_review_clear_if_no_visible_diff() != 0 {
            app_reload_after_import(app, 0)
        } else {
            app_open_modal(app, cast(ModalType)ModalSyncReview)
        }
    }
    app_apply_pending_sync_refresh(app, now)
    app_apply_pending_social_refresh(app)
    if app_sync_url(*url[0], size_of(type_of(url))) == 0 {
        app_clear_disconnected_sync_work()
        return
    }
    last_result := SettingsReadInt("sync_last_result", SYNC_OK)
    if app_sync_failure_needs_action(last_result) != 0 {
        return
    }
    if last_result != SYNC_OK {
        if g_sync.retry_at <= 0.0 {
            g_sync.retry_at = now + app_sync_retry_delay(
                SettingsReadInt("sync_retry_attempt", 1))
        }
        if now < g_sync.retry_at {
            return
        }
        should_sync = 1
    }
    app_ensure_sync_events(AppTextFromCString(*url[0], 256))
    if g_sync.dirty_sync_at > 0.0 && now >= g_sync.dirty_sync_at {
        should_sync = 1
        dirty_due = 1
    }
    if SyncStatusRead(*sync_status)  && sync_status.has_account != 0  && sync_status.enabled != 0  && (sync_status.queued_changes > 0 || sync_status.full_upload_done == 0  || sync_status.repair_pending != 0)  && (g_sync.dirty_sync_at <= 0.0 || now >= g_sync.dirty_sync_at) {
        should_sync = 1
        if sync_status.repair_pending != 0 {
            repair_due = 1
        }
    }
    #if !ASYNC {
        sync_lock()
    }
    if g_sync.remote_sync_due != 0 {
        should_sync = 1
        g_sync.remote_sync_due = 0
    }
    #if !ASYNC {
        sync_unlock()
    }
    if should_sync == 0 {
        return
    }
    if now < g_sync.last_input_at + sync_input_quiet_seconds {
        if g_sync.dirty_sync_at <= 0.0 {
            g_sync.dirty_sync_at = g_sync.last_input_at + sync_input_quiet_seconds
        }
        return
    }
    if app_background_sync_safe(app) == 0 {
        SyncLog(LOG_INFO,
            "SYNC: delayed")
        if g_sync.dirty_sync_at <= 0.0 || repair_due != 0 {
            g_sync.dirty_sync_at = now + 1.0
        }
        return
    }
    if app_sync_now(app) != 0 {
        if dirty_due != 0 || repair_due != 0 {
            g_sync.dirty_sync_at = 0.0
        }
        SyncLog(LOG_INFO, "SYNC: dispatched")
    } else if dirty_due != 0 || repair_due != 0 {
        g_sync.dirty_sync_at = now + sync_input_quiet_seconds
    }
    app_apply_pending_sync_refresh(app, now)
}
