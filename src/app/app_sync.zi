    friends_json: [8192] u8
    leaderboard_json: [8192] u8
    leaderboard_key: [96] u8
    leaderboard_avg_json: [8192] u8
    leaderboard_avg_key: [96] u8
}

g_sync: SyncCoordinator = SyncCoordinator.{};
g_sync_events_url: [512]u8;
g_sync_events_retry_at: float64;
