    url: [256] u8
}

SocialWorkerArgs :: struct {
    url: [256] u8
    practice: [32] u8
    metric: [32] u8
    leaderboard_key: [96] u8
    leaderboard_avg_key: [96] u8
    action: [16] u8
    action_value: [96] u8
}

SyncWorkerResult :: struct {
    finished: s32
