SyncCoordinator :: struct {
    retry_at: float64
    dirty_sync_at: float64
    last_input_at: float64
    sync_running: s32
    data_refresh_pending: s32
    social_retry_at: float64
    social_retry_attempt: s32
    social_refresh_pending: s32
    social_refresh_running: s32
    remote_sync_due: s32
}

