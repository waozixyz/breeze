SyncCopyText :: (dst: *u8, capacity: s64, value: string) -> bool {
    if dst == null || capacity <= 0 { return false }
    output := BytesFromPointer(dst, cast(u64)capacity)
    if !AppCopyText(value, output) {
        output[0] = cast(u8)0
        return false
    }
    return true
}

SyncAppendText :: (dst: *u8, capacity: s64, value: string) -> bool {
    if dst == null || capacity <= 0 { return false }
    return AppAppendText(value, BytesFromPointer(dst, cast(u64)capacity))
}

