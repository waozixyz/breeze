#import, file "../core/types.zi";
#import "router"
#import "router_props"

RouteCount :: 16

FillRoutes :: (routes: []RouterRoute) {
    if routes.count < RouteCount { return }
    routes[0] = RouterRoute.{ScreenStart, -1, "start", "Start", "main" }
    routes[1] = RouterRoute.{ScreenSession, ScreenStart, "session", "Session", "practice" }
    routes[2] = RouterRoute.{ScreenMeditation, ScreenStart, "meditation", "Meditation", "practice" }
    routes[3] = RouterRoute.{ScreenSunSalutation, ScreenStart, "sun_salutation", "Sun Salutation", "practice" }
    routes[4] = RouterRoute.{ScreenPatterns, ScreenStart, "patterns", "Patterns", "practice" }
    routes[5] = RouterRoute.{ScreenResults, ScreenStart, "results", "Results", "practice" }
    routes[6] = RouterRoute.{ScreenSettings, -1, "settings", "Settings", "main" }
    routes[7] = RouterRoute.{ScreenLanguage, ScreenSettings, "language", "Language", "settings" }
    routes[8] = RouterRoute.{ScreenManual, ScreenStart, "manual", "Manual", "practice" }
    routes[9] = RouterRoute.{ScreenProfile, -1, "profile", "Profile", "main" }
    routes[10] = RouterRoute.{ScreenHabits, -1, "habits", "Habits", "main" }
    routes[11] = RouterRoute.{ScreenEList, -1, "elist", "Exercises", "main" }
    routes[12] = RouterRoute.{ScreenCustomizeNav, ScreenSettings, "customize_nav", "Customize Navigation", "settings" }
    routes[13] = RouterRoute.{ScreenHabitEdit, ScreenHabits, "habit_edit", "Habit Edit", "habits" }
    routes[14] = RouterRoute.{ScreenHabitSessionEdit, ScreenHabits, "habit_session_edit", "Habit Session Edit", "habits" }
    routes[15] = RouterRoute.{ScreenAppSelection, ScreenSettings, "apps", "Apps", "settings" }
}

ScreenForPath :: (path: string) -> s32 {
    routes: [RouteCount]RouterRoute
    FillRoutes(routes[:])
    index: s32 = RouterFindHash(routes[:], path)
    if index < 0 { return -1 }
    return routes[index].id
}
