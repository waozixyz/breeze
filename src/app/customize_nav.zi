#import, file "app_types.zi";
#import "geometry"
Layout :: #import "kryon/layout";
#import "session"
#import "kryon/tree"
#import, file "app.zi";
#import, file "app_nav.zi";

#program_export
customize_nav :: (app: *InnerBreeze) {
    root: Layout.Props
    root.key = Layout.KeyHash("customize_nav/root")
    unused Layout.Screen(app.ui.session, root)
    app_draw_customize_nav_page(app)
    End(app.ui.session)
}
