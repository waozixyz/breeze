#import, file "app_types.zi";
#import "geometry"
#import "layout"
#import "layout_props"
#import "layout_widget"
#import "session"
#import "tree"
#import, file "app.zi";
#import, file "app_nav.zi";

#program_export
customize_nav :: (app: *InnerBreeze) {
    root: ColumnProps
    root.key = KeyHash("customize_nav/root")
    Screen(app.ui.session, root)
    app_draw_customize_nav_page(app)
    End(app.ui.session)
}
