#import "drawing_props"
#import "frame_transition"
#import "geometry"
#import "session"
#import, file "app_types.zi";
#import, file "route_types.zi";

APP_ROUTE_TRANSITION_SECONDS :: 0.24;

// Releases the previous screen when this app owns its copy, and forgets it.
app_route_transition_forget :: (app: *InnerBreeze, context_lost: bool) {
    if !context_lost && app.ui.route_transition_surface_owned &&
    FrameSurfaceValid(app.ui.route_transition_surface) {
        unused FrameSurfaceRelease(app.ui.route_transition_surface)
    }
    app.ui.route_transition_surface = FrameSurface.{}
    app.ui.route_transition_surface_owned = false
}

#program_export
app_route_transition_cancel :: (app: *InnerBreeze, context_lost: bool = false) {
    if app == null { return }
    app_route_transition_forget(app, context_lost)
    app.ui.route_transition_active = false
    app.ui.route_transition_pending = false
}

#program_export
app_route_transition_request :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    // A new route replaces the old animation immediately.
    app_route_transition_cancel(app)
    app.ui.route_transition_pending = true
}

// Keeps the whole captured surface, so the fade draws it the way its host
// stored its rows.
#program_export
app_route_transition_capture :: (app: *InnerBreeze,
    surface: FrameSurface, now_seconds: float64, owns_surface: bool) {
    if app == null || !app.ui.route_transition_pending { return }
    app.ui.route_transition_pending = false
    app_route_transition_forget(app, false)
    app.ui.route_transition_surface = surface
    app.ui.route_transition_surface_owned = owns_surface
    app.ui.route_transition_active = FrameSurfaceValid(surface)
    app.ui.route_transition_started = now_seconds
}

#program_export
app_route_transition_advance :: (app: *InnerBreeze,
    now_seconds: float64) {
    if app == null || !app.ui.route_transition_active { return }
    if now_seconds - app.ui.route_transition_started <
    APP_ROUTE_TRANSITION_SECONDS { return }
    app_route_transition_forget(app, false)
    app.ui.route_transition_active = false
}

#program_export
app_route_transition_draw :: (app: *InnerBreeze, bounds: Rectangle,
    now_seconds: float64) {
    if app == null || !app.ui.route_transition_active { return }
    elapsed := cast(float32)(now_seconds -
        app.ui.route_transition_started)
    FrameTransition(app.ui.session, app.ui.route_transition_surface, bounds,
        elapsed, APP_ROUTE_TRANSITION_SECONDS)
}
