// Direct raylib draw calls used by translated screens. The signatures mirror
// raylib.h, and the Ziran names stay scoped to this module so they do not
// define a second copy of raylib's C symbols.
raylib :: #system_library "raylib";

#import "drawing_props"
#import "geometry"
#import, file "direct_draw_plan.zi";

DrawLineHost :: (start_x: s32, start_y: s32, end_x: s32, end_y: s32, color: Color) #foreign raylib "DrawLine";
DrawLineExHost :: (start: Vector2, end: Vector2, thickness: float32, color: Color) #foreign raylib "DrawLineEx";
DrawTriangleHost :: (v1: Vector2, v2: Vector2, v3: Vector2, color: Color) #foreign raylib "DrawTriangle";
DrawRectangleHost :: (x: s32, y: s32, width: s32, height: s32, color: Color) #foreign raylib "DrawRectangle";
DrawRectangleRecHost :: (rec: Rectangle, color: Color) #foreign raylib "DrawRectangleRec";
DrawRectangleLinesHost :: (x: s32, y: s32, width: s32, height: s32, color: Color) #foreign raylib "DrawRectangleLines";
DrawRectangleLinesExHost :: (rec: Rectangle, thick: float32, color: Color) #foreign raylib "DrawRectangleLinesEx";
DrawRectangleRoundedHost :: (rec: Rectangle, roundness: float32, segments: s32, color: Color) #foreign raylib "DrawRectangleRounded";
DrawRectangleRoundedLinesExHost :: (rec: Rectangle, roundness: float32, segments: s32, thick: float32, color: Color) #foreign raylib "DrawRectangleRoundedLinesEx";
DrawRectangleGradientVHost :: (x: s32, y: s32, width: s32, height: s32, top: Color, bottom: Color) #foreign raylib "DrawRectangleGradientV";
DrawCircleHost :: (center_x: s32, center_y: s32, radius: float32, color: Color) #foreign raylib "DrawCircle";
DrawCircleVHost :: (center: Vector2, radius: float32, color: Color) #foreign raylib "DrawCircleV";
DrawCircleGradientHost :: (center: Vector2, radius: float32, inner: Color, outer: Color) #foreign raylib "DrawCircleGradient";
DrawCircleLinesHost :: (center_x: s32, center_y: s32, radius: float32, color: Color) #foreign raylib "DrawCircleLines";
DrawRingHost :: (center: Vector2, inner_radius: float32, outer_radius: float32,
    start_angle: float32, end_angle: float32, segments: s32, color: Color) #foreign raylib "DrawRing";
FadeHost :: (color: Color, alpha: float32) -> Color #foreign raylib "Fade";
DrawCircleLinesExHost :: (center: Vector2, radius: float32, thickness: float32, color: Color) #foreign raylib "DrawCircleLinesEx";

DrawLine :: (start_x: s32, start_y: s32, end_x: s32, end_y: s32, color: Color) {
    DirectDrawRecordLine(start_x, start_y, end_x, end_y, color)
    DrawLineHost(start_x, start_y, end_x, end_y, color)
}

DrawLineEx :: (start: Vector2, end: Vector2, thickness: float32, color: Color) {
    DirectDrawRecordLineEx(start, end, thickness, color)
    DrawLineExHost(start, end, thickness, color)
}

DrawTriangle :: (v1: Vector2, v2: Vector2, v3: Vector2, color: Color) {
    DirectDrawRecordTriangle(v1, v2, v3, color)
    DrawTriangleHost(v1, v2, v3, color)
}

DrawRectangle :: (x: s32, y: s32, width: s32, height: s32, color: Color) {
    DirectDrawRecordRectangle(x, y, width, height, color)
    DrawRectangleHost(x, y, width, height, color)
}

DrawRectangleRec :: (rec: Rectangle, color: Color) {
    DirectDrawRecordRectangleRec(rec, color)
    DrawRectangleRecHost(rec, color)
}

DrawRectangleLines :: (x: s32, y: s32, width: s32, height: s32, color: Color) {
    DirectDrawRecordRectangleLines(x, y, width, height, color)
    DrawRectangleLinesHost(x, y, width, height, color)
}

DrawRectangleLinesEx :: (rec: Rectangle, thick: float32, color: Color) {
    DirectDrawRecordRectangleLinesEx(rec, thick, color)
    DrawRectangleLinesExHost(rec, thick, color)
}

DrawRectangleRounded :: (rec: Rectangle, roundness: float32, segments: s32, color: Color) {
    DirectDrawRecordRectangleRounded(rec, roundness, segments, color)
    DrawRectangleRoundedHost(rec, roundness, segments, color)
}

DrawRectangleRoundedLinesEx :: (rec: Rectangle, roundness: float32, segments: s32, thick: float32, color: Color) {
    DirectDrawRecordRectangleRoundedLinesEx(rec, roundness, segments, thick, color)
    DrawRectangleRoundedLinesExHost(rec, roundness, segments, thick, color)
}

DrawRectangleGradientV :: (x: s32, y: s32, width: s32, height: s32, top: Color, bottom: Color) {
    DirectDrawRecordRectangleGradient(x, y, width, height, top, bottom)
    DrawRectangleGradientVHost(x, y, width, height, top, bottom)
}

DrawCircle :: (center_x: s32, center_y: s32, radius: float32, color: Color) {
    DirectDrawRecordCircle(center_x, center_y, radius, color)
    DrawCircleHost(center_x, center_y, radius, color)
}

DrawCircleV :: (center: Vector2, radius: float32, color: Color) {
    DirectDrawRecordCircleV(center, radius, color)
    DrawCircleVHost(center, radius, color)
}

DrawCircleGradient :: (center: Vector2, radius: float32, inner: Color, outer: Color) {
    DirectDrawRecordCircleGradient(center, radius, inner, outer)
    DrawCircleGradientHost(center, radius, inner, outer)
}

DrawCircleLines :: (center_x: s32, center_y: s32, radius: float32, color: Color) {
    DirectDrawRecordCircleLines(center_x, center_y, radius, color)
    DrawCircleLinesHost(center_x, center_y, radius, color)
}

DrawRing :: (center: Vector2, inner_radius: float32, outer_radius: float32,
    start_angle: float32, end_angle: float32, segments: s32, color: Color) {
    DirectDrawRecordRing(center, inner_radius, outer_radius, start_angle, end_angle, segments, color)
    DrawRingHost(center, inner_radius, outer_radius, start_angle, end_angle, segments, color)
}

Fade :: (color: Color, alpha: float32) -> Color {
    return FadeHost(color, alpha)
}

DrawCircleLinesEx :: (center: Vector2, radius: float32, thickness: float32, color: Color) {
    DirectDrawRecordCircleLinesEx(center, radius, thickness, color)
    DrawCircleLinesExHost(center, radius, thickness, color)
}
