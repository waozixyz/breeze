// First-run voice guidance. The screen asks once; this module owns what each
// answer turns on and which narration it downloads.
#import, file "app_types.zi";
#import, file "app_route_state.zi";
#import, file "language_selection.zi";
#import, file "locale.zi";
#import, file "../core/types.zi";
#import, file "../practices/practice_downloads.zi";

// The guide's and every available practice's narration in this language.
AudioSetupBytes :: () -> s64 {
    language := LocaleActiveCode()
    return PracticeNarrationSummary(true, language).bytes +
        PracticeNarrationSummary(false, language).bytes
}

// Download turns on the guide and practice voices and fetches them in the
// background; Not now leaves both off. Either answer completes setup.
AudioSetupFinish :: (app: *InnerBreeze, download: bool) {
    enabled: s32 = ifx download then 1 else 0
    app.guide_narration_enabled = enabled
    app.voice_narration_enabled = enabled
    if download {
        PracticeNarrationRequest(true, LocaleActiveCode())
        PracticeNarrationRequest(false, LocaleActiveCode())
    }
    app_accept_language_selection(app)
    app_switch_screen(app, ScreenAppSelection)
}
