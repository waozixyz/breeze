#import, file "../core/types.zi";

using ModalType;

ModalType :: enum {
    ModalNone
    ModalConfirmExitSession
    ModalMeditationSetup
    ModalConfirmDeleteData
    ModalConfirmDeleteHabit
    ModalEditProgressiveStartSpeed
    ModalMeditationNetworkError
    ModalConfirmImportDataSettings
    ModalSyncAccountBackup
    ModalConfirmDeleteSyncAccount
    ModalHabitPracticePicker
    ModalPracticeManual
    ModalPracticeConfig
    ModalThemePicker
    ModalSyncReview
    ModalSyncAlias
    ModalSyncPublicId
    ModalConfirmRemoveFriend
    ModalConfirmSyncAccountSwitch
    ModalBottomNavConfig
    ModalProfilePicturePicker
    ModalAboutDonation
    ModalDonationReminder
    ModalAppIconPicker
    ModalHabitCount
}

#program_export
ModalValidOnScreen :: (modal_type: ModalType, screen: s32,
    habit_edit_tab: bool) -> bool {
    if modal_type == cast(ModalType)ModalConfirmExitSession {
        return screen == ScreenSession || screen == ScreenMeditation  || screen == ScreenSunSalutation || screen == ScreenPatterns
    }
    if modal_type == cast(ModalType)ModalMeditationSetup {
        return screen == ScreenStart
    }
    if modal_type == cast(ModalType)ModalConfirmDeleteHabit  || modal_type == cast(ModalType)ModalHabitPracticePicker {
        return screen == ScreenHabitEdit  || (screen == ScreenHabits && habit_edit_tab)
    }
    if modal_type == cast(ModalType)ModalBottomNavConfig {
        return screen == ScreenCustomizeNav
    }
    if modal_type == cast(ModalType)ModalHabitCount {
        return screen == ScreenHabits
    }
    return true
}
