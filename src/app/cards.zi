// Rounded cards the habit pages share: a card that groups what belongs
// together, and a figure card with a colour along its start. Labels beside
// what they describe are muted, titles and figures strong.
#import "box_props"
#import "box_widget"
#import "drawing_props"
#import "geometry"
#import "kss_parser"
#import "semantic"
#import "session"
#import "text_props"
#import "text_widget"
#import, file "color.zi";
#import, file "metrics.zi";

using SemanticKind;
using TextWrap;

CARD_RADIUS :: 12
CARD_PADDING :: 16
FIGURE_CARD_HEIGHT :: 74

// A card's face: a little lighter than the page, with a soft edge.
CardProps :: (bounds: Rectangle) -> BoxProps {
    props: BoxProps
    props.bounds = bounds
    props.fill = LightenColor(StyleTokenColor("canvas"), 2)
    props.border = color_with_alpha(StyleTokenColor("text"), 0.12)
    props.radius = cast(float32)AppScale(CARD_RADIUS)
    return props
}

// The whole text as one strong range.
StrongWhole :: (text: string) -> [1]TextRange {
    ranges: [1]TextRange
    ranges[0] = TextRange.{.start = 0, .end = cast(s32)text.count}
    return ranges
}

// Muted text, for labels and dates beside what they describe.
MutedTextClass :: () -> s32 {
    return KssClassId(KssMakeName("muted-detail"))
}

// A section's title above its cards: strong and a little larger than the
// text, wrapping onto more lines when it must.
SectionTitleFont :: () -> s32 {
    return AppFontSize() + AppScale(2)
}

SectionTitleHeight :: (title: string, width: s32) -> s32 {
    return AppParagraphHeight(title, width, SectionTitleFont(), AppScale(3))
}

SectionTitle :: (session: Session, title: string, x: s32, y: s32,
    width: s32) -> s32 {
    height := SectionTitleHeight(title, width)
    strong := StrongWhole(title)
    Text(session, TextProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)y,
                cast(float32)width, cast(float32)height},
            .text = title, .font = SectionTitleFont(), .strong = strong[:],
            .semantic_kind = cast(SemanticKind)SemanticHeading,
            .heading_level = 2,
            .wrap = cast(TextWrap)TextWrapAuto})
    return height
}

// A figure on a card: its label muted above it and the figure strong, with
// the accent along the card's start.
FigureCard :: (session: Session, bounds: Rectangle, label: string,
    value: string, accent: Color) {
    radius := cast(float32)AppScale(CARD_RADIUS)
    bar := cast(float32)AppScale(5)
    Box(session, BoxProps.{.bounds = bounds, .fill = accent,
            .radius = radius})
    face := CardProps(Rectangle.{bounds.x + bar, bounds.y,
            bounds.width - bar, bounds.height})
    face.border = Color.{}
    Box(session, face)
    edge := CardProps(bounds)
    edge.fill = Color.{}
    Box(session, edge)
    pad := cast(float32)AppScale(CARD_PADDING)
    inner := bounds.width - bar - pad * 2.0
    Text(session, TextProps.{
            .bounds = Rectangle.{bounds.x + bar + pad,
                bounds.y + cast(float32)AppScale(10), inner,
                cast(float32)AppScale(22)},
            .text = label, .font = AppSmallFontSize(),
            .class_name = MutedTextClass(),
            .wrap = cast(TextWrap)TextWrapEllipsis})
    value_font := AppFitFontSize(value, cast(s32)inner, AppScale(Text24),
        AppScale(Text16))
    strong := StrongWhole(value)
    Text(session, TextProps.{
            .bounds = Rectangle.{bounds.x + bar + pad,
                bounds.y + cast(float32)AppScale(34), inner,
                cast(float32)AppScale(32)},
            .text = value, .font = value_font, .strong = strong[:],
            .wrap = cast(TextWrap)TextWrapNone})
}
