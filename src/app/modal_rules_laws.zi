#import, file "modal_rules.zi";
#import, file "../core/types.zi";

// Laws for where each dialog may appear. They are checked for every dialog
// type and every screen number from -2 to 20 (beyond the 18 real screens), so
// an unknown screen cannot show a screen-specific dialog. An implementation
// edit may not change this file.

Valid :: (modal: ModalType, screen: s32, habits_tab: s32) -> bool {
    return ModalValidOnScreen(modal, screen, habits_tab == 1)
}

// Leaving a practice needs confirmation only while one is running.
#law ExitSessionOnlyOnPracticeScreens forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalConfirmExitSession, screen, tab) == (screen == ScreenSession || screen == ScreenMeditation || screen == ScreenSunSalutation || screen == ScreenPatterns);

// Meditation setup belongs to the start screen alone.
#law MeditationSetupOnlyOnStart forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalMeditationSetup, screen, tab) == (screen == ScreenStart);

// Habit dialogs need the habit editor: its own screen, or the editor tab of
// the habits screen.
#law DeleteHabitNeedsEditor forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalConfirmDeleteHabit, screen, tab) == (screen == ScreenHabitEdit || (screen == ScreenHabits && tab == 1));
#law PracticePickerNeedsEditor forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalHabitPracticePicker, screen, tab) == (screen == ScreenHabitEdit || (screen == ScreenHabits && tab == 1));

// Navigation customization is only offered on its own screen.
#law NavConfigOnlyOnCustomizeScreen forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalBottomNavConfig, screen, tab) == (screen == ScreenCustomizeNav);

// A habit's day count is edited over the habits screen that opened it, in
// either habits tab.
#law HabitCountOnlyOnHabits forall screen: -2..20, tab: 0..1 => Valid(ModalType.ModalHabitCount, screen, tab) == (screen == ScreenHabits);

// The remaining dialogs may appear anywhere, so a rule change cannot silently
// hide them.
#law OtherDialogsAppearAnywhere forall modal: ModalType, screen: -2..20, tab: 0..1 => Valid(modal, screen, tab) || modal == ModalType.ModalConfirmExitSession || modal == ModalType.ModalMeditationSetup || modal == ModalType.ModalConfirmDeleteHabit || modal == ModalType.ModalHabitPracticePicker || modal == ModalType.ModalBottomNavConfig || modal == ModalType.ModalHabitCount;

// No dialog type can appear on a screen that is not a habit editor unless its
// rule allows it: the habit tab flag alone never enables a dialog elsewhere.
#law HabitTabDoesNotLeak forall modal: ModalType, screen: -2..20 => Valid(modal, screen, 1) == Valid(modal, screen, 0) || (screen == ScreenHabits && (modal == ModalType.ModalConfirmDeleteHabit || modal == ModalType.ModalHabitPracticePicker));

#program_export
modal_rules_laws_entry :: () -> s32 {
    return 0
}
