#import, file "route_types.zi";
#import, file "../core/types.zi";

using AppMainTab;
using AppNavRoute;

#program_export
app_main_tab_route :: (main_tab: s32) -> s32 {
    if main_tab == APP_MAIN_TAB_HABITS {
        return APP_NAV_ROUTE_HABITS
    }
    if main_tab == APP_MAIN_TAB_PRACTICE {
        return APP_NAV_ROUTE_PRACTICE
    }
    if main_tab == APP_MAIN_TAB_ELIST {
        return APP_NAV_ROUTE_ELIST
    }
    if main_tab == APP_MAIN_TAB_DIARY {
        return APP_NAV_ROUTE_DIARY
    }
    if main_tab == APP_MAIN_TAB_LUMI {
        return APP_NAV_ROUTE_LUMI
    }
    return APP_NAV_ROUTE_NONE
}

#program_export
app_main_tab_for_route :: (route: s32) -> s32 {
    if route == APP_NAV_ROUTE_HABITS {
        return APP_MAIN_TAB_HABITS
    }
    if route == APP_NAV_ROUTE_PRACTICE {
        return APP_MAIN_TAB_PRACTICE
    }
    if route == APP_NAV_ROUTE_ELIST {
        return APP_MAIN_TAB_ELIST
    }
    if route == APP_NAV_ROUTE_DIARY {
        return APP_MAIN_TAB_DIARY
    }
    if route == APP_NAV_ROUTE_LUMI {
        return APP_MAIN_TAB_LUMI
    }
    return APP_MAIN_TAB_NONE
}

#program_export
app_screen_for_main_tab :: (main_tab: s32) -> s32 {
    if main_tab == APP_MAIN_TAB_HABITS {
        return ScreenHabits
    }
    if main_tab == APP_MAIN_TAB_ELIST {
        return ScreenEList
    }
    if main_tab == APP_MAIN_TAB_DIARY {
        return ScreenDiary
    }
    if main_tab == APP_MAIN_TAB_LUMI {
        return ScreenLumi
    }
    return ScreenStart
}

RouteUsesHabitState :: (screen: s32) -> bool {
    return screen == ScreenHabits || screen == ScreenHabitEdit  || screen == ScreenHabitSessionEdit
}

// Tabs show their destination immediately. Transitions are reserved for
// child views within the same tab, such as opening a habit's details.
RoutesNeedTransition :: (left: AppRoute, right: AppRoute) -> bool {
    if left.screen != right.screen {
        return false
    }
    if RouteUsesHabitState(left.screen) {
        return left.habits_tab == right.habits_tab
    }
    if left.screen == ScreenStart {
        return left.practice_tab == right.practice_tab &&
        left.practice_config_tab == right.practice_config_tab
    }
    if left.screen == ScreenSettings {
        return left.settings_tab == right.settings_tab
    }
    if left.screen == ScreenProfile {
        return left.profile_tab == right.profile_tab
    }
    return false
}

#program_export
RoutesEqual :: (left: AppRoute, right: AppRoute) -> bool {
    if left.screen != right.screen { return false }
    if RouteUsesHabitState(left.screen) {
        return left.habits_screen_mode == right.habits_screen_mode  && left.habits_tab == right.habits_tab
    }
    if left.screen == ScreenStart {
        return left.exercise_type == right.exercise_type  && left.practice_tab == right.practice_tab  && (left.practice_tab != PRACTICE_TAB_CONFIG  || left.practice_config_tab == right.practice_config_tab)
    }
    if left.screen == ScreenSettings {
        return left.settings_tab == right.settings_tab  && left.settings_overview == right.settings_overview
    }
    if left.screen == ScreenProfile {
        return left.profile_view == right.profile_view  && left.profile_tab == right.profile_tab
    }
    return true
}
