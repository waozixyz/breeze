using SyncAccountSaveResult;
using SyncAccountLocalDataChoice;
using AndroidImportKind;

c :: #system_library "c";
EntitySyncLoading :: () -> s32 #foreign c "app_sync_loading";
EntityRequestSync :: (app: *InnerBreeze) -> s32 #foreign c "app_request_sync";
EntitySyncStatusKey :: () -> string #foreign c "app_sync_status_key";
EntityReloadData :: (app: *InnerBreeze, settings: s32) #foreign c "app_reload_after_import";

entity_management: Provider.ManagementProvider;
entity_management_started: bool;
entity_management_picker: bool;
entity_management_picker_kind: s32;
entity_management_picker_abandoned: bool;
entity_management_scan: bool;
entity_management_delivered: bool;
entity_management_link_owner: [65]u8;
entity_management_selected: [4096]u8;
entity_management_signing: AccountKeys;
entity_management_server: [256]u8;
entity_management_client: [64]u8;
// The chosen profile picture reaches the node through Entity's publisher,
// as it does from every other app.
entity_picture: Publish.EntityPicturePublisher;
entity_picture_chosen: s32;
entity_picture_published: s32;
entity_picture_checked: s64;
// A picture chosen in another app comes back from the node; a choice made
// here meanwhile counts up the sequence and wins.
entity_picture_reader: Publish.EntityPictureReader;
entity_picture_sequence: s32;

// The picture a new account starts with, before anyone chooses one.
InbeStartingPicture :: (owner: string) -> s32 {
    state := Entity.EntityDefault()
    state.pictures &= ~((1 << 21) | (1 << 22) | (1 << 23))
    return Entity.EntityPictureIcon(0, Entity.EntityInitialPicture(owner, state.pictures), 0)
}

// A picture the person picked, kept apart from the starting picture.
InbeProfilePictureChosen :: (icon: s32) {
    storage_set_setting_int("profile_picture_chosen", icon)
    entity_picture_checked = 0
    entity_picture_sequence += 1
}

// The node's picture becomes this profile's, already published.
InbeProfilePictureAdopt :: (app: *InnerBreeze, icon: s32) {
    app.profile_picture_icon = icon
    storage_set_setting_int("profile_picture_icon", icon)
    storage_set_setting_int("profile_picture_chosen", icon)
    storage_set_setting_int("profile_icon_published", icon)
    storage_set_setting_text("profile_icon_published_owner", TextUntilNul(entity_picture_reader.owner[:]))
    entity_picture_chosen = icon
    entity_picture_published = icon
}

InbeChosenPicture :: () -> s32 {
    chosen := storage_get_setting_int("profile_picture_chosen", -1)
    if chosen >= 0 {
        return chosen
    }
    saved := storage_get_setting_int("profile_picture_icon", -1)
    owner: [65]u8
    unused CopyCString(storage_get_setting_text("sync_public_id"), owner[:])
    chosen = ProfilePictureEarlierChoice(saved, InbeStartingPicture(TextUntilNul(owner[:])))
    storage_set_setting_int("profile_picture_chosen", chosen)
    return chosen
}

InbePictureRefresh :: (now: s64) {
    entity_picture_checked = now + 5
    entity_picture_chosen = InbeChosenPicture()
    owner: [65]u8
    unused CopyCString(storage_get_setting_text("sync_public_id"), owner[:])
    entity_picture_published = 0
    if storage_get_setting_text("profile_icon_published_owner") == TextUntilNul(owner[:]) {
        entity_picture_published = storage_get_setting_int("profile_icon_published", 0)
    }
}

InbePicturePump :: (app: *InnerBreeze) {
    now := UnixNow()
    if !entity_picture.active && now >= entity_picture_checked {
        InbePictureRefresh(now)
    }
    node := Publish.EntityPictureReadPump(*entity_picture_reader, *entity_management, entity_picture_sequence, now)
    if node != 0 {
        if !entity_picture.active {
            InbePictureRefresh(now)
        }
        pending := entity_picture.active ||
        Publish.EntityPictureShouldPublish(entity_picture_chosen, entity_picture_published)
        icon := ProfilePictureFromNode(node, app.profile_picture_icon, pending)
        if icon != 0 {
            InbeProfilePictureAdopt(app, icon)
        }
    }
    accepted := Publish.EntityPicturePublishPump(*entity_picture, *entity_management,
        entity_picture_chosen, entity_picture_published, now)
    if accepted == 0 {
        return
    }
    storage_set_setting_int("profile_icon_published", accepted)
    storage_set_setting_text("profile_icon_published_owner", TextUntilNul(entity_picture.owner[:]))
    entity_picture_published = accepted
}

InbeEntityOwner :: (output: []u8) -> bool {
    account: AccountKeys
    defer { SecureWipe(*account.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE) }
    if sync_account_load(*account) != 0 && ValidateAccountKeys(*account) != 0 {
        return CopyCString(TextUntilNul(account.public_id[:]), output)
    }
    if StoredAccountMode() == AccountModeDelegate {
        return CopyCString(StoredDelegateIdentity(), output)
    }
    return CopyCString("", output)
}

InbeRecoveryPath :: (id: string, output: []u8) -> string {
    if !Native.NativeAccountId(id) {
        return ""
    }
    name: Vec(u8)
    // Preserve existing recovery metadata across the profile module rename.
    BuilderPrint(*name, "self-context.%.key", id)
    filename := BuilderFinish(name)
    defer { Entity.EntityFree(filename) }
    return Native.NativeJoin(output, data_root(), filename)
}

InbeRecoveryLoad :: (context: *void, output: *Recovery.Recovery) -> bool {
    if StoredAccountMode() == AccountModeDelegate || sync_account_load(*output.keys) == 0 || ValidateAccountKeys(*output.keys) == 0 {
        return false
    }
    path: [4096]u8
    unused Native.NativeRead(InbeRecoveryPath(TextUntilNul(output.keys.public_id[:]), path[:]), output.context[:])
    return true
}

InbeRecoveryApply :: (context: *void, incoming: *Recovery.Recovery, choice: s32) -> s32 {
    app := cast(*InnerBreeze)context
    if StoredAccountMode() == AccountModeDelegate || ValidateAccountKeys(*incoming.keys) == 0 {
        return 0
    }
    if incoming.context[0] != cast(u8)0 {
        path: [4096]u8
        if !Native.NativeWrite(InbeRecoveryPath(TextUntilNul(incoming.keys.public_id[:]), path[:]), TextUntilNul(incoming.context[:])) {
            return 0
        }
    }
    server: [256]u8
    normalized: [256]u8
    if !InbeManagementServer(context, server[:]) ||
    !SyncNodeAddress(TextUntilNul(server[:]), normalized[:]) {
        return 0
    }
    data_choice := cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK
    if choice == 1 {
        data_choice = cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_MERGE
    } else if choice == 2 {
        data_choice = cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_REPLACE
    }
    saved := sync_account_save(*incoming.keys, data_choice)
    if saved == cast(SyncAccountSaveResult)SYNC_ACCOUNT_SAVE_NEEDS_CLEAR {
        return 2
    }
    if saved != cast(SyncAccountSaveResult)SYNC_ACCOUNT_SAVE_OK {
        return 0
    }
    // Connecting the account is the person's consent to synchronize it.
    // Persist the node shown by Entity before scheduling the first request.
    if !InbeManagementConnect(context) {
        return 0
    }
    if TextUntilNul(entity_management.queue.request.operation[:]) == "create" {
        state := Entity.EntityDefault()
        state.pictures &= ~((1 << 21) | (1 << 22) | (1 << 23))
        state.picture = Entity.EntityInitialPicture(TextUntilNul(incoming.keys.public_id[:]), state.pictures)
        storage_set_setting_int("profile_picture_icon", InbeStartingPicture(TextUntilNul(incoming.keys.public_id[:])))
        state.owner_id = incoming.keys.public_id
        unused Native.SharedProfileSave(TextUntilNul(state.owner_id[:]), state)
    }
    EntityReloadData(app, 0)
    unused EntityRequestSync(app)
    return 1
}

InbeManagementServer :: (context: *void, output: []u8) -> bool {
    address := storage_get_setting_text("sync_server_url")
    if address == "" {
        address = Entity.ENTITY_DEFAULT_NODE
    }
    return CopyCString(address, output)
}

InbeManagementConnect :: (context: *void) -> bool {
    server: [256]u8
    normalized: [256]u8
    if !InbeManagementServer(context, server[:]) ||
    !SyncNodeAddress(TextUntilNul(server[:]), normalized[:]) {
        return false
    }
    if StoredAccountMode() != AccountModeDelegate &&
    (!SyncNodeAdd(TextUntilNul(normalized[:])) ||
        !SyncNodePrefer(TextUntilNul(normalized[:]))) {
        return false
    }
    storage_set_sync_enabled(1)
    return true
}

InbeManagementSnapshot :: (context: *void, output: *Manage.Management) {
    output.available = true
    unused InbeEntityOwner(output.public_id[:])
    output.account = output.public_id[0] != cast(u8)0
    output.enabled = storage_sync_enabled() != 0
    output.busy = EntitySyncLoading() != 0
    output.capabilities = Manage.ACCOUNT_SYNC | Manage.NODE_MEDIA
    if output.account {
        output.capabilities |= Manage.ACCOUNT_LOGOUT
    }
    if StoredAccountMode() != AccountModeDelegate {
        output.capabilities |= Manage.ACCOUNT_CREATE | Manage.ACCOUNT_IMPORT | Manage.ACCOUNT_SWITCH | Manage.ACCOUNT_LINK
        if output.account {
            output.capabilities |= Manage.ACCOUNT_BACKUP | Manage.ACCOUNT_ALIAS | Manage.ACCOUNT_CLEAR_REMOTE
        }
        if AndroidPlatform() != 0 {
            output.capabilities |= Manage.ACCOUNT_SCAN
        }
    }
    unused CopyCString(storage_get_setting_text("sync_account_alias"), output.alias[:])
    unused CopyCString(LocaleText(EntitySyncStatusKey()), output.status[:])
    status: SyncStatus
    if SyncStatusRead(*status) {
        output.queued = cast(s32)status.queued_changes
        if status.queued_changes > 2147483646 {
            output.queued = 2147483646
        }
    }
    output.node_count = SyncNodeCount()
    for index: cast(s32)0..output.node_count - 1 {
        address := SyncNodeAt(index)
        node := *output.nodes[index]
        unused CopyCString(address, node.address[:])
        node.active = address == storage_get_setting_text("sync_server_url")
        usage := SyncNodeStorageRead(address)
        node.known = usage.known
        node.used = usage.used_bytes
        node.limit = usage.limit_bytes
        node.full = usage.full
        node.media_supported = true
        node.media = SyncNodeMediaUpload(address)
        Entity.EntityFree(address)
    }
    output.link_stage = cast(s32)Pairing.device_link.stage
    unused CopyCString(Pairing.DeviceLinkCodeShown(), output.link_code[:])
    if output.link_stage == 2 || output.link_stage == 3 {
        text: Vec(u8)
        BuilderPrint(*text, "%: %", LocaleText("device_link_compare"), Pairing.device_link.confirmation)
        message := BuilderFinish(text)
        unused CopyCString(message, output.link_message[:])
        Entity.EntityFree(message)
    } else if output.link_stage == 4 {
        unused CopyCString(LocaleText("device_link_ask"), output.link_message[:])
    } else if output.link_stage == 7 {
        unused CopyCString(LocaleText(Pairing.device_link.error), output.link_message[:])
    }
}

InbeManagementChooseFile :: (context: *void, save: bool, output: []u8) -> s32 {
    if AndroidPlatform() != 0 {
        InbeManagementDiscardPicker()
        if entity_management_picker_abandoned { return -1 }
        if !entity_management_picker {
            entity_management_picker_kind = cast(s32)(ifx save then ANDROID_EXPORT_KIND_SYNC_KEY else ANDROID_IMPORT_KIND_SYNC_KEY)
            opened: bool
            if save {
                opened = AndroidSavePickerOpen(entity_management_picker_kind,
                    "entity-account.key", "application/octet-stream")
            } else {
                opened = AndroidPickerOpen(entity_management_picker_kind, "*/*")
            }
            if !opened {
                return -1
            }
            entity_management_picker = true
            return 2
        }
        result := AndroidPickerPoll(entity_management_picker_kind, output)
        if result == .AndroidPickerNone {
            return 2
        }
        entity_management_picker = false
        if result == .AndroidPickerCancelled {
            return 0
        }
        if output.count == 0 || output[0] == cast(u8)0 {
            return -1
        }
        unused CopyCString(TextUntilNul(output), entity_management_selected[:])
        return 1
    }
    picked := PickFile(FilePickerProps.{.title = LocaleText(ifx save then "sync_save_key_dialog_title" else "sync_import_key_dialog_title"),
            .filter = "Key files | *.key *.json", .suggested_name = ifx save then "entity-account.key" else "", .save = save}, output)
    if picked == 1 && WebPlatform() != 0 {
        unused CopyCString(TextUntilNul(output), entity_management_selected[:])
    }
    return picked
}

InbeManagementDeliver :: (context: *void, path: string) -> bool {
    if AndroidPlatform() != 0 {
        result := AndroidSavePickerCommit(path)
        unused RemoveFile(path)
        return result
    }
    if AndroidPlatform() == 0 && WebPlatform() == 0 {
        return true
    }
    result := ExportFile(path, "entity-account.key", "application/octet-stream", LocaleText("share_sheet_title"))
    unused RemoveFile(path)
    return result
}

InbeManagementClient :: (context: *void, output: *Client) -> bool {
    if !InbeManagementServer(context, entity_management_server[:]) ||
    sync_account_load(*entity_management_signing) == 0 ||
    !CopyCString(storage_sync_client_id(), entity_management_client[:]) {
        return false
    }
    return OpenAccountClient(TextUntilNul(entity_management_server[:]), *entity_management_signing,
        TextUntilNul(entity_management_client[:]), output)
}

InbeManagementAction :: (context: *void, request: *Manage.ManagementRequest) -> s32 {
    app := cast(*InnerBreeze)context
    operation := TextUntilNul(request.operation[:])
    if operation == "sync" {
        return EntityRequestSync(app)
    }
    if operation == "set_sync" {
        if request.choice == 1 {
            if !InbeManagementConnect(context) {
                return 0
            }
            unused EntityRequestSync(app)
        } else {
            storage_set_sync_enabled(0)
        }
        return 1
    }
    if operation == "media" {
        return ifx SyncNodeSetMediaUpload(TextUntilNul(request.target[:]), request.choice == 1) then 1 else 0
    }
    if operation == "logout" || operation == "remote_cleared" {
        storage_set_sync_enabled(0)
        Pairing.DeviceLinkCancel()
        return sync_account_clear()
    }
    if operation == "alias_saved" {
        storage_set_setting_text("sync_account_alias", TextUntilNul(request.value[:]))
        return 1
    }
    if operation == "alias_purchase_load" || operation == "alias_purchase_save" || operation == "alias_purchase_clear" {
        owner_buffer: [65]u8
        if !InbeEntityOwner(owner_buffer[:]) ||
        TextUntilNul(owner_buffer[:]) != TextUntilNul(request.owner_id[:]) {
            return 0
        }
        name: Vec(u8)
        BuilderPrint(*name, "username.%.purchase.json", TextUntilNul(owner_buffer[:]))
        file := BuilderFinish(name)
        defer {
            Entity.EntityFree(file)
        }
        path_buffer: [4096]u8
        path := Native.NativeJoin(path_buffer[:], data_root(), file)
        if operation == "alias_purchase_load" {
            count := Native.NativeRead(path, request.value[:])
            if count < 0 {
                return ifx PathExists(path) then 0 else 2
            }
            return ifx count > 2 then 1 else 2
        }
        document := ifx operation == "alias_purchase_clear" then "{}" else TextUntilNul(request.value[:])
        if !Native.NativeWrite(path, document) || sync_web_storage_critical() == 0 {
            return 0
        }
        return 1
    }
    if operation == "link_show" {
        unused InbeEntityOwner(entity_management_link_owner[:])
        entity_management_delivered = false
        return ifx Pairing.DeviceLinkShow() then 1 else 0
    }
    if operation == "link_join" {
        unused InbeEntityOwner(entity_management_link_owner[:])
        entity_management_delivered = false
        return ifx Pairing.DeviceLinkScan(TextUntilNul(request.value[:])) then 1 else 0
    }
    if operation == "link_confirm" {
        Pairing.DeviceLinkAccept()
        return 1
    }
    if operation == "link_cancel" {
        Pairing.DeviceLinkCancel()
        return 1
    }
    if operation == "link_scan" {
        unused InbeEntityOwner(entity_management_link_owner[:])
        entity_management_scan = AndroidScannerOpen(cast(s32)ANDROID_IMPORT_KIND_QR_CODE, LocaleText("device_link_scan_prompt"))
        return ifx entity_management_scan then 1 else 0
    }
    return 0
}

InbeManagementStart :: (app: *InnerBreeze) {
    if entity_management_started {
        entity_management.context = cast(*void)app
        return
    }
    entity_management = Provider.ManagementProvider.{.context = cast(*void)app,
        .snapshot = InbeManagementSnapshot, .load = InbeRecoveryLoad,
        .apply = InbeRecoveryApply, .action = InbeManagementAction,
        .client = InbeManagementClient, .choose_file = InbeManagementChooseFile,
        .deliver_file = InbeManagementDeliver}
    Pairing.pairing_context = cast(*void)app
    Pairing.pairing_load = InbeRecoveryLoad
    Pairing.pairing_server = InbeManagementServer
    entity_management_started = true
}

// A chooser can finish after the request's owner changes. Discard its
// copied document before another request is allowed to consume that result.
InbeManagementDiscardPicker :: () {
    if !entity_management_picker { return }
    if !entity_management.queue.pending { entity_management_picker_abandoned = true }
    if !entity_management_picker_abandoned { return }
    abandoned: [4096]u8
    result := AndroidPickerPoll(entity_management_picker_kind, abandoned[:])
    if result == .AndroidPickerNone { return }
    entity_management_picker = false
    entity_management_picker_abandoned = false
    entity_management.delegated = false
    if result == .AndroidPickerSelected && abandoned[0] != cast(u8)0 {
        unused RemoveFile(TextUntilNul(abandoned[:]))
    }
}

InbeManagementPump :: (app: *InnerBreeze) {
    InbeManagementStart(app)
    if entity_management_picker && entity_management.queue.pending {
        entity_management.delegated = false
    }
    Provider.ProviderPump(*entity_management)
    InbePicturePump(app)
    InbeManagementDiscardPicker()
    if !entity_management.queue.pending && entity_management_selected[0] != cast(u8)0 {
        unused RemoveFile(TextUntilNul(entity_management_selected[:]))
        entity_management_selected = .{}
    }
    if cast(s32)Pairing.device_link.stage != 0 || entity_management_scan {
        link_owner: [65]u8
        unused InbeEntityOwner(link_owner[:])
        if TextUntilNul(link_owner[:]) != TextUntilNul(entity_management_link_owner[:]) {
            Pairing.DeviceLinkCancel()
            entity_management_scan = false
        }
    }
    if !entity_management.asynchronous {
        SecureWipe(*entity_management_signing.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE)
    }
    Pairing.DeviceLinkPump()
    if entity_management_scan {
        scanned: [1024]u8
        result := AndroidPickerPoll(cast(s32)ANDROID_IMPORT_KIND_QR_CODE, scanned[:])
        if result != .AndroidPickerNone {
            entity_management_scan = false
            if result == .AndroidPickerSelected {
                entity_management_delivered = false
                unused Pairing.DeviceLinkScan(TextUntilNul(scanned[:]))
            }
        }
    }
    if cast(s32)Pairing.device_link.stage == 8 && !entity_management_delivered {
        entity_management.incoming.keys = Pairing.device_link_pending.account
        entity_management.incoming.context = Pairing.device_link_pending.context
        unused InbeEntityOwner(entity_management.incoming_owner[:])
        entity_management.has_incoming = true
        entity_management_delivered = true
        Provider.ProviderApplyIncoming(*entity_management, 0)
        Pairing.DeviceLinkImported()
    }
}
