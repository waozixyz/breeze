
FrameActivityState :: struct {
    mouse_ready: bool
    mouse_x: s32
    mouse_y: s32
    grace_frames: s32
}

FrameActivityResult :: struct {
    state: FrameActivityState
    active: bool
}

#program_export
FrameActivityStep :: (state: FrameActivityState, mouse_x: s32,
    mouse_y: s32, engaged: bool, count_mouse: bool,
    grace_frames: s32) -> FrameActivityResult {
    moved: bool = !state.mouse_ready || state.mouse_x != mouse_x  || state.mouse_y != mouse_y
    state.mouse_ready = true
    state.mouse_x = mouse_x
    state.mouse_y = mouse_y
    result: FrameActivityResult
    if engaged || (count_mouse && moved) {
        if grace_frames < 0 { grace_frames = 0 }
        state.grace_frames = grace_frames
        result.active = true
    } else if state.grace_frames > 0 {
        state.grace_frames -= 1
        result.active = true
    }
    result.state = state
    return result
}
