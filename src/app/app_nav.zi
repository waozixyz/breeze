using AppNavRoute;
using ButtonEmphasis;
using ButtonTone;

CustomizeNavTitle :: (app: *InnerBreeze, height: s32) -> bool {
    bar: TitleBarProps
    bar.id = 700
    bar.title = LocaleText("customize_nav_title")
    bar.height = height
    bar.bounds = Rectangle.{0.0, 0.0,
        cast(float32)app.ui.view_width, cast(float32)height
    }
    bar.has_leading_action = app.modal.active == 0
    bar.leading_label = LocaleText("back_button")
    options: [1]DropdownOption
    result := TitleBar(app.ui.session, bar, options[0:0])
    if !result.clicked_leading {
        return false
    }
    app_block_current_click(app)
    app_return_from_customize_nav(app)
    return true
}

CustomizeNavOptions :: (app: *InnerBreeze,
    options: []DropdownOption) -> s32 {
    count := app_nav_config_option_count(app)
    index: s32 = 0
    while index < count && index < cast(s32)options.count {
        route := app_nav_route_for_option(app, index)
        options[index].key = cast(u64)(740 + route)
        options[index].label = app_nav_route_label(route)
        index += 1
    }
    return index
}

CustomizeNavRemove :: (app: *InnerBreeze, index: s32) -> bool {
    count := app.bottom_nav_config_route_count
    if index < 0 || index >= count {
        return false
    }
    while index < count - 1 {
        app.bottom_nav_config_routes[index] =
        app.bottom_nav_config_routes[index + 1]
        index += 1
    }
    app.bottom_nav_config_route_count -= 1
    return true
}

CustomizeNavSet :: (app: *InnerBreeze, index: s32,
    route: s32) -> bool {
    count := app.bottom_nav_config_route_count
    if index < 0 || index >= count {
        return false
    }
    old_route := app.bottom_nav_config_routes[index]
    if route == old_route {
        return false
    }
    other: s32 = 0
    while other < count {
        if other != index  && app.bottom_nav_config_routes[other] == route {
            app.bottom_nav_config_routes[other] = old_route
            break
        }
        other += 1
    }
    app.bottom_nav_config_routes[index] = route
    return true
}

CustomizeNavTrashImage :: () -> ImageProps {
    image: ImageProps
    image.asset_path = "icons/ui.png"
    image.alt_text = LocaleText("remove_button")
    image.source = Rectangle.{.x = 0.0, .y = 384.0, .width = 64.0, .height = 64.0}
    return image
}

#program_export
app_draw_customize_nav_page :: (app: *InnerBreeze) -> s32 {
    if app == null || !SessionValid(app.ui.session) {
        return 0
    }
    if app.bottom_nav_config_route_count < 0  || app.bottom_nav_config_route_count >
    APP_BOTTOM_NAV_CONTENT_MAX {
        app_sanitize_bottom_nav_routes(app)
        app.bottom_nav_config_route_count =
        app.bottom_nav_route_count
        for i: 0..(cast(int)app.bottom_nav_route_count - 1) {
            app.bottom_nav_config_routes[i] =
            app.bottom_nav_routes[i]
        }
    }
    title_height := AppTitleBarHeight()
    if CustomizeNavTitle(app, title_height) {
        return 1
    }
    width := app.ui.view_width
    height := app.ui.view_height
    side_padding := AppScale(16)
    column := CenteredColumnFor(width,
        AppScale(CONTENT_MAX_W), side_padding)
    row_height := AppScale(64)
    button_height := AppScale(36)
    handle_width := AppScale(40)
    top_gap := AppScale(18)
    count := app.bottom_nav_config_route_count
    options: [APP_BOTTOM_NAV_CONFIGURABLE_COUNT]DropdownOption
    option_count := CustomizeNavOptions(app, options[:])
    content_height := count * row_height + AppScale(24)
    if count < option_count {
        content_height += button_height + AppScale(14)
    }
    viewport_height := height - title_height - top_gap -         app_content_bottom_reserved(app)
    if viewport_height < 0 {
        viewport_height = 0
    }

    scroll_key := KeyHash("inbe/customize_nav/scroll")
    viewport := Rectangle.{0.0,
        cast(float32)(title_height + top_gap),
        cast(float32)width, cast(float32)viewport_height
    }
    scroll_props: ScrollProps
    scroll_props.key = scroll_key
    scroll_props.bounds = viewport
    scroll_props.content_height = content_height
    scroll_props.scroll_offset = app.ui.config_scroll
    scrolled := Scroll(app.ui.session, scroll_props)
    app.ui.config_scroll = scrolled.scroll_offset
    if !scrolled.opened {
        return 0
    }

    list_y := cast(s32)scrolled.content.y
    reorder_items: [APP_BOTTOM_NAV_CONTENT_MAX]ReorderItem
    for i: 0..(cast(int)count - 1) {
        reorder_items[i].id = app.bottom_nav_config_routes[i]
        reorder_items[i].bounds = Rectangle.{
            cast(float32)column.x,
            cast(float32)(list_y + cast(s32)i * row_height),
            cast(float32)column.width,
            cast(float32)row_height
        }
    }
    list: ReorderList
    list.id = 701
    list.bounds = Rectangle.{cast(float32)column.x,
        cast(float32)list_y, cast(float32)column.width,
        cast(float32)(count * row_height)
    }
    list.handle_width = handle_width
    list.scroll_offset = app.ui.config_scroll
    list.max_scroll = scrolled.max_scroll
    list.viewport_top = cast(s32)viewport.y
    list.viewport_bottom = cast(s32)(viewport.y +         viewport.height)
    reorder := Reorder(app.ui.session, list,
        reorder_items[0:count])
    app.ui.config_scroll = reorder.scroll_offset

    action: s32 = APP_NAV_CONFIG_ACTION_NONE
    action_index: s32 = -1
    action_route: s32 = APP_NAV_ROUTE_NONE
    changed := false
    if reorder.committed != 0 {
        changed = app_move_bottom_nav_config_route(app,
            reorder.from_index, reorder.to_index) != 0
        action = APP_NAV_CONFIG_ACTION_MOVE
    }
    index: s32 = 0
    while index < count {
        row_y := list_y + index * row_height
        trash_x := column.x + column.width - AppScale(40)
        dropdown_x := column.x + handle_width
        dropdown_width := trash_x - dropdown_x - AppScale(8)
        if dropdown_width < AppScale(48) {
            dropdown_width = AppScale(48)
        }
        control_y := row_y +             (row_height - button_height) / 2
        menu: DropdownProps
        menu.id = cast(s32)740 + index
        menu.bounds = Rectangle.{
            cast(float32)dropdown_x,
            cast(float32)control_y,
            cast(float32)dropdown_width,
            cast(float32)button_height
        }
        menu.selected_index = app_nav_option_index(app,
            app.bottom_nav_config_routes[index])
        previous := app.ui.config_route_menus[index]
        menu.highlight_index = previous.highlight_index
        menu.scroll_offset = previous.scroll_offset
        menu.open = previous.open
        selection := Dropdown(app.ui.session, menu,
            options[0:option_count])
        app.ui.config_route_menus[index] = selection
        if selection.changed  && action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_SET
            action_index = index
            action_route = app_nav_route_for_option(app,
                selection.selected_index)
        }
        remove: ButtonProps
        remove.id = cast(s32)760 + index
        remove.bounds = Rectangle.{
            cast(float32)trash_x,
            cast(float32)control_y,
            cast(float32)AppScale(40),
            cast(float32)button_height
        }
        remove.label = LocaleText("remove_button")
        remove.image = CustomizeNavTrashImage()
        remove.icon_only = true
        remove.tone = cast(ButtonTone)ButtonToneNeutral
        remove.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        if Button(app.ui.session, remove) != 0  && action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_REMOVE
            action_index = index
        }
        index += 1
    }
    if count < option_count {
        add: ButtonProps
        add.id = 770
        add.bounds = Rectangle.{
            cast(float32)column.x,
            cast(float32)(list_y + count * row_height),
            cast(float32)column.width,
            cast(float32)button_height
        }
        add.label = LocaleText("customize_nav_add")
        add.tone = cast(ButtonTone)ButtonToneNeutral
        add.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        if Button(app.ui.session, add) != 0  && action == APP_NAV_CONFIG_ACTION_NONE {
            action = APP_NAV_CONFIG_ACTION_ADD
        }
    }
    unused End(app.ui.session)

    if action == APP_NAV_CONFIG_ACTION_REMOVE {
        changed = CustomizeNavRemove(app, action_index)
    } else if action == APP_NAV_CONFIG_ACTION_ADD {
        if count < option_count {
            app.bottom_nav_config_routes[count] =
            app_first_unused_bottom_nav_route(app)
            app.bottom_nav_config_route_count += 1
            changed = true
        }
    } else if action == APP_NAV_CONFIG_ACTION_SET {
        changed = CustomizeNavSet(app, action_index,
            action_route)
    }
    if changed {
        for i: 0..(APP_BOTTOM_NAV_CONTENT_MAX - 1) {
            app.ui.config_route_menus[i] = DropdownResult.{}
        }
        app_save_bottom_nav_config(app)
    }
    return 0
}
