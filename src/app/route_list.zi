RouteListContains :: (routes: []s32, count: s32, route: s32) -> bool {
    limit := count
    if limit < 0 {
        limit = 0
    }
    if limit > cast(s32)routes.count {
        limit = cast(s32)routes.count
    }
    for i: 0..(cast(int)limit - 1) {
        if routes[i] == route {
            return true
        }
    }
    return false
}

RouteListSanitize :: (routes: []s32, count: s32, allowed: []s32) -> s32 {
    limit := count
    if limit < 0 {
        limit = 0
    }
    if limit > cast(s32)routes.count {
        limit = cast(s32)routes.count
    }
    next: s32 = 0
    for i: 0..(cast(int)limit - 1) {
        route := routes[i]
        if !RouteListContains(allowed, cast(s32)allowed.count, route) {
            continue
        }
        if RouteListContains(routes, next, route) {
            continue
        }
        routes[next] = route
        next += 1
    }
    return next
}

RouteListMove :: (routes: []s32, count: s32, from_index: s32,
                 to_index: s32) -> bool {
    if count < 0 || count > cast(s32)routes.count || from_index < 0  || from_index >= count || to_index < 0 || to_index >= count  || from_index == to_index {
        return false
    }
    moving := routes[from_index]
    if from_index < to_index {
        for i: cast(int)from_index..(cast(int)to_index - 1) {
            routes[i] = routes[i + 1]
        }
    } else {
        for i: cast(int)to_index..(cast(int)from_index - 1) {
            target := cast(int)from_index + cast(int)to_index - i
            routes[target] = routes[target - 1]
        }
    }
    routes[to_index] = moving
    return true
}

RouteListFirstUnused :: (routes: []s32, count: s32,
                         allowed: []s32, fallback: s32) -> s32 {
    for i: 0..(cast(int)allowed.count - 1) {
        if !RouteListContains(routes, count, allowed[i]) {
            return allowed[i]
        }
    }
    return fallback
}
