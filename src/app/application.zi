// Theme colors are now accessed via theme accessor functions

#program_export
app_leave_practice_config :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if app.settings_dirty != 0 {
        save_settings(app)
    }
    {
        practice: *PracticeDefinition = practice_get(app.exercise_type)
        if practice.leave_config != null {
            practice.leave_config(app)
        }
    }
    app.settings_scroll = 0
}

#program_export
app_request_desktop_close :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    // Configured close behaviour overrides the ask prompt (desktop only).
    if app.desktop_close_action == CLOSE_QUIT {
        app.request_quit = 1
        return
    }
    #if #defined(DESKTOP_TRAY_ENABLED) {
        if desktop_tray_ready() == 0 {
            app.request_quit = 1
            return
        }
    }
    if app.desktop_close_action == CLOSE_KEEP_RUNNING {
        #if #defined(DESKTOP_TRAY_ENABLED) {
            if desktop_tray_keep_running() == 0 {
                app.request_quit = 1
            }
        } else {
            app.request_quit = 1
        }
        return
    }
    app.close_prompt_open = 1
    app_block_current_click(app)
    app.close_prompt_result = cast(AppClosePromptResult)AppClosePromptNone
}

//
// Desktop quit request from an explicit command such as Ctrl+Q. Window-close
// requests may still ask whether to keep running, but a quit command should
// always terminate the app.
//

#program_export
app_request_desktop_quit :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    app.request_quit = 1
}

#program_export
app_consume_close_prompt_result :: (app: *InnerBreeze) -> AppClosePromptResult {
    result: AppClosePromptResult
    if app == null {
        return cast(AppClosePromptResult)AppClosePromptNone
    }
    result = app.close_prompt_result
    app.close_prompt_result = cast(AppClosePromptResult)AppClosePromptNone
    return result
}

#program_export
app_draw_session_exit_modal :: (app: *InnerBreeze, can_save: s32, save_message: string, discard_message: string) -> SessionExitModalResult {
    modal_result: s32
    if can_save != 0 {
        actions: [3] ActionModalAction = .[
        ActionModalAction.{.label = LocaleText("cancel_button"), .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
        ActionModalAction.{.label = LocaleText("save_button"), .tone = cast(ButtonTone)ButtonToneAccent, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled},
        ActionModalAction.{.label = LocaleText("discard_button"), .tone = cast(ButtonTone)ButtonToneDanger, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
        ]
        modal_result = ActionModal(app.ui.session, ActionModalProps.{.title = LocaleText("exit_session_title"), .message = save_message}, actions[:3]).action
        if modal_result == 2 {
            return cast(SessionExitModalResult)SessionExitModalSave
        }
        if modal_result == 3 {
            return cast(SessionExitModalResult)SessionExitModalDiscard
        }
    } else {
        actions: [2] ActionModalAction = .[
        ActionModalAction.{.label = LocaleText("cancel_button"), .tone = cast(ButtonTone)ButtonToneNeutral, .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
        ActionModalAction.{.label = LocaleText("exit_button"), .tone = cast(ButtonTone)ButtonToneDanger, .emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled},
        ]
        modal_result = ActionModal(app.ui.session, ActionModalProps.{.title = LocaleText("exit_session_title"), .message = discard_message}, actions[:2]).action
        if modal_result == 2 {
            return cast(SessionExitModalResult)SessionExitModalDiscard
        }
    }
    return ifx (modal_result == 1) then (cast(SessionExitModalResult)SessionExitModalCancel) else (cast(SessionExitModalResult)SessionExitModalNone)
}

app_draw_close_prompt :: (app: *InnerBreeze) {
    modal_result: s32
    actions: [2] ActionModalAction = .[ActionModalAction.{}, ActionModalAction.{}]
    props: ActionModalProps = .{}
    if app == null || app.close_prompt_open == 0 {
        return
    }
    if app.blocked_input_frame == app.breathing.frame {
        return
    }
    actions[0].label = LocaleText("desktop_close_keep_running_button")
    actions[0].tone = cast(ButtonTone)ButtonToneAccent
    actions[0].emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    actions[1].label = LocaleText("desktop_close_quit_button")
    actions[1].tone = cast(ButtonTone)ButtonToneDanger
    actions[1].emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    props.title = LocaleText("desktop_close_prompt_title")
    props.message = LocaleText("desktop_close_prompt_message")
    props.max_width = 420
    modal_result = ActionModal(app.ui.session, props, actions[:2]).action
    if modal_result == -1 {
        app.close_prompt_open = 0
    } else if modal_result == 1 {
        app.close_prompt_open = 0
        app.close_prompt_result = cast(AppClosePromptResult)AppClosePromptKeepRunning
    } else if modal_result == 2 {
        app.close_prompt_open = 0
        app.close_prompt_result = cast(AppClosePromptResult)AppClosePromptQuit
    }
}

app_reload_graphics_resources :: (app: *InnerBreeze) {
    if app == null || app.graphics_reload_requested == 0 {
        return
    }
    app.graphics_reload_requested = 0
    if PreviewMode() != 0 {
        return
    }
    TraceLog(LOG_INFO, "ANDROID: Reloading graphics resources")
    if !LoadLocaleFont(app) {
        TraceLog(LOG_WARNING, "FONT: Failed to reload Noto UI font")
    }
}

#program_export
refresh_locale_dependent_text :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if config.title_custom == 0 {
        CopyCString(LocaleText("app_title"), config.title[:])
    }
    manual_screen_reset_layouts(app)
    app.language_index = LocaleActiveIndex()
    if app.language_index < 0 {
        app.language_index = 0
    }
}

load_config :: () {
    if config.loaded != 0 {
        return
    }
    if config.title[0] == #char "\0" {
        AppCopyText(LocaleText("app_title"), config.title[:])
        config.title_custom = 0
    }
    #if #defined(PLATFORM_WEB) {
        refresh_theme_colors(0, 1)
    } else {
        refresh_theme_colors(0, 0)
    }
    config.loaded = 1
}

#program_export
clampi :: (value: s32, min: s32, max: s32) -> s32 {
    if value < min {
        return min
    }
    if value > max {
        return max
    }
    return value
}

#program_export
app_reload_after_import :: (app: *InnerBreeze, reload_settings: s32) {
    detail_habit_id: [HABIT_ID_SIZE] u8 = .[0]
    detail_index: s32 = -1
    view_mode: s32 = HABIT_VIEW_CALENDAR
    habit_tab: s32 = HABIT_TAB_WEEKLY
    month_offset: s32 = 0
    scroll: s32 = 0
    weekly_days: s32 = 0
    hold_stats_range_days: s32 = 0
    i: s32
    if app == null {
        return
    }
    if reload_settings == 0 {
        if app.habit_detail_index >= 0 && app.habit_detail_index < app.habits.count {
            AppCopyText(AppTextFromCString(
                *app.habits.items[app.habit_detail_index].id[0],
                HABIT_ID_SIZE), detail_habit_id[:])
        }
        detail_index = app.habit_detail_index
        view_mode = app.habits.view_mode
        habit_tab = app.habits.tab
        month_offset = app.habits.month_offset
        scroll = app.habits.scroll
        weekly_days = app.habits.weekly_days
        hold_stats_range_days = app.habits.hold_stats_range_days
    }
    if reload_settings != 0 {
        settings_missing := app_load_settings(app)
        refresh_locale_dependent_text(app)
        app_device_preferences_init(app)
        if settings_missing != 0 {
            save_settings(app)
        }
        app_apply_style(app)
        reset_settings_preview(app)
        practice_update_session_sounds(app)
    }
    habits_init_with_defaults(*app.habits, app.language_selected)
    if reload_settings != 0 {
        app_restore_habits_view_settings(app)
    }
    if reload_settings == 0 {
        app.habits.selected = -1
        app.habit_detail_index = -1
        {
            i: s32 = 0
            while i < app.habits.count {
                if detail_habit_id[0] != cast(u8)0 &&
                    AppTextFromCString(*app.habits.items[i].id[0], HABIT_ID_SIZE) ==
                    AppTextFromCString(*detail_habit_id[0], HABIT_ID_SIZE) {
                    app.habit_detail_index = i
                    break
                }
                i += 1
            }
        }
        if app.habit_detail_index < 0 && detail_index >= 0 && detail_index < app.habits.count {
            app.habit_detail_index = detail_index
        }
        app.habits.view_mode = view_mode
        app.habits.tab = habit_tab
        app.habits.month_offset = month_offset
        app.habits.scroll = scroll
        app.habits.weekly_days = weekly_days
        app.habits.hold_stats_range_days = ifx (hold_stats_range_days == 31) then (31) else (7)
    }
    if app.habit_detail_index >= app.habits.count {
        app.habit_detail_index = -1
    }
    if app.habits.selected >= app.habits.count {
        app.habits.selected = -1
    }
    app.habit_session_edit.active = 0
    app.habit_edit.active = 0
}

