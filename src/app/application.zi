#if #defined(ANDROID_BUILD) {
    #import, file "../platform/android/android_insets.zi";
}

#if #defined(PLATFORM_WEB) || #defined(ANDROID_BUILD) {
    APP_DEFAULT_WIDTH :: 320
    APP_DEFAULT_HEIGHT :: 560
} else {
    APP_DEFAULT_WIDTH :: 900
    APP_DEFAULT_HEIGHT :: 720
}

config: AppConfig = AppConfig.{.width = APP_DEFAULT_WIDTH, .height = APP_DEFAULT_HEIGHT};

view_width: s32 = APP_DEFAULT_WIDTH;

view_height: s32 = APP_DEFAULT_HEIGHT;

app_full_view_width: s32 = APP_DEFAULT_WIDTH;

#program_export
app_leave_practice_config :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if app.settings_dirty != 0 {
        save_settings(app)
    }
    {
        practice: *PracticeDefinition = practice_get(app.exercise_type)
        if practice.leave_config != null {
            practice.leave_config(app)
        }
    }
    app.settings_scroll = 0
}

#program_export
clampi :: (value: s32, min: s32, max: s32) -> s32 {
    if value < min {
        return min
    }
    if value > max {
        return max
    }
    return value
}

#program_export
app_destroy :: (vapp: *void) {
    app: *InnerBreeze = cast(*InnerBreeze)vapp
    i: s32
    if app == null {
        return
    }
    if !AppsReady() {
        AppsClose()
        return
    }
    if TelegramAccountFlowOwnsContext() {
        // Closing preserves the protected delegate for an explicitly verified
        // Restore on the next launch; only Cancel or revocation clears it.
        TelegramFlowStopOperations(*telegram_account_flow)
        TelegramFlowWipeSecrets(*telegram_account_flow)
        telegram_account_flow.hosted = false
        ClearDelegate()
    }
    CloseBreakWindows()
    ClosePracticeWindow(app)
    FileDownloadRelease(*app.meditation.music_download)
    unused app_diary_save()
    PackageCancel()
    save_settings(app)
    settings_sync_account_cancel(app)
    DewCancel()
    LumiOnlineCancel()
    app_clear_disconnected_sync_work()
    AndroidTextInputClose(app.ui.session)
    SessionClose(app.ui.session)
    habits_flush_save(app)
    if PreviewMode() == 0 {
        ReleaseLocaleFont(app)
    }
    {
        i: s32 = 0
        while i < practice_count() {
            practice: *PracticeDefinition = practice_get(i)
            if practice.destroy != null {
                practice.destroy(app)
            }
            i += 1
        }
    }
    settings_audio_stop_preview(app)
    app_audio_shutdown(app)
    app_diary_reset()
    app_lumi_reset()
    app.* = InnerBreeze.{}
    AppsClose()
}

#program_export
app_should_use_tab_bar :: (app: *InnerBreeze) -> s32 {
    if app == null {
        return 0
    }
    return ifx (app.navigation_mode == NAV_MODE_TABBAR) then (1) else (0)
}
