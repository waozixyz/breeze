#import, file "../storage/sync_result.zi";
#import, file "../storage/sync_status.zi";

using SyncResult;

// Inbe owns the user-visible state and locale keys for its sync flow.
SyncStatusKeyFor :: (enabled: bool, loading: bool, result: s32,
    has_status: bool, status: SyncStatus) -> string {
    if !enabled { return "sync_connection_required" }
    if loading { return "sync_in_progress" }
    if result == cast(s32)SYNC_AUTH_FAILED { return "sync_auth_failed" }
    if result == cast(s32)SYNC_NO_ACCOUNT { return "sync_no_account" }
    if result == cast(s32)SYNC_INVALID_URL { return "sync_server_url_invalid" }
    if result == cast(s32)SYNC_SIGN_FAILED { return "sync_sign_failed" }
    if result == cast(s32)SYNC_PAYLOAD_FAILED { return "sync_failed" }
    if result != cast(s32)SYNC_OK { return "sync_retry_waiting" }
    if has_status {
        if status.review_pending != 0 { return "sync_status_review_pending" }
        if status.queued_changes > 0 || status.full_upload_done == 0 {
            return "sync_status_local_queued"
        }
    }
    return "sync_status_ready"
}
