screenshot_request: ScreenshotRequest;

#program_export
current_screenshot_request :: () -> *ScreenshotRequest {
    return *screenshot_request
}

#program_export
screenshot_warmup_frames :: (request: *ScreenshotRequest) -> s32 {
    if request == null {
        return 4
    }
    return ScreenshotWarmupFrames(request.*)
}

#program_export
screenshot_after_warmup :: (app: *InnerBreeze,
    request: *ScreenshotRequest) {
    if app == null || request == null {
        return
    }
    if AppTextFromCString(*request.scene[0], 64) == "tutorial_whm_step2" {
        app.tutorial_step = 2
    } else if AppTextFromCString(*request.scene[0], 64) == "tutorial_whm_step0"  || AppTextFromCString(*request.scene[0], 64) == "tutorial_meditation" {
        app.tutorial_step = 0
    }
}

ScreenshotOwned :: (product: string) -> bool {
    unused product
    return true
}

screenshot_day_index_offset :: (offset_days: s32) -> s32 {
    local := LocalNow()
    date := BreakDateFromLocal(local)
    remaining := offset_days
    while remaining > 0 && date != 0 {
        date = BreakPreviousDate(date)
        remaining -= 1
    }
    return date
}

screenshot_seed_habits_offsets: [18]s32 = .[0, 1, 2, 4, 5, 7, 8, 10, 12, 13,
15, 17, 18, 20, 21, 24, 25, 27];

screenshot_seed_habits_counts: [18]s32 = .[2, 1, 1, 3, 1, 1, 2, 1, 1, 2,
1, 1, 2, 1, 3, 1, 1, 2];

screenshot_seed_habits :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    if app.habits.count <= 0 {
        habits_add_default_set(*app.habits)
    }
    if app.habits.count <= 0 {
        return
    }
    // Deterministic preview fixtures, only in the isolated screenshot store.
    if app.habits.count == 2 {
        habits_add_custom(*app.habits, "Sit ups", Color.{.r = 180, .g = 130, .b = 220, .a = 255}, HABIT_SYNC_NONE, 0)
        habits_add_custom(*app.habits, "Push ups", Color.{.r = 100, .g = 190, .b = 155, .a = 255}, HABIT_SYNC_NONE, 0)
        habits_add_custom(*app.habits, "Cold Shower", Color.{.r = 75, .g = 170, .b = 155, .a = 255}, HABIT_SYNC_NONE, 0)
        habits_add_custom(*app.habits, "Jumping Rope", Color.{.r = 195, .g = 90, .b = 130, .a = 255}, HABIT_SYNC_NONE, 0)
    }
    app.habits.selected = -1
    app.habits.items[0].sync_mode = HABIT_SYNC_ACTIVITIES
    app.habits.items[0].sync_activity = habit_activity_mask_for(EXERCISE_WIM_HOF) |
    habit_activity_mask_for(EXERCISE_MEDITATION)
    app.habits.items[0].counter_enabled = 0
    // A counter fixture for UI tests only; never added to a normal install.
    if app.habits.count > 2 {
        app.habits.items[2].counter_enabled = 1
        AppCopyText("Counter test fixture", app.habits.items[2].description[:])
    }
    habits_clear_days(*app.habits)
    i: s32 = 0
    while i < cast(s32)(size_of(type_of(screenshot_seed_habits_offsets)) / size_of(type_of(screenshot_seed_habits_offsets[0]))) {
        habit_set_day_count(*app.habits, 0, screenshot_day_index_offset(screenshot_seed_habits_offsets[i]), screenshot_seed_habits_counts[i])
        i += 1
    }
    day: s32 = 6
    while day >= 0 {
        progress: s32 = 6 - day
        local_date: s32 = screenshot_day_index_offset(day)
        session_path: [FS_PATH_MAX] u8
        checkin: SessionMoodCheckin = .{}
        rounds: [3] s32 = .[32 + progress * 4, 37 + progress * 4, 41 + progress * 5]
        if storage_save_session_at_for_activity(local_date, 7, 15 + progress, 0,
            *rounds[0], 3, 0, EXERCISE_WIM_HOF,
            *session_path[0],
            size_of(type_of(session_path))) != 0 {
            checkin.mood_after = 3 + (progress % 3)
            storage_save_session_checkin(AppTextFromCString(*session_path[0], FS_PATH_MAX), *checkin)
        }
        day -= 1
    }
}

// The counter fixture habit with a full day, a partial day, and a count too
// wide for a small circle, for the count scenes.
screenshot_seed_habit_counts :: (app: *InnerBreeze) {
    if app == null || app.habits.count <= 2 { return }
    app.habits.items[2].counter_target = 3
    habit_set_day_count(*app.habits, 2, screenshot_day_index_offset(0), 3)
    habit_set_day_count(*app.habits, 2, screenshot_day_index_offset(1), 1)
    habit_set_day_count(*app.habits, 2, screenshot_day_index_offset(2), 12)
    habit_set_day_count(*app.habits, 2, screenshot_day_index_offset(4), 2)
}

// The habit entry scenes: "First meal" asks four questions with goals and
// most of the last two weeks have an entry, its first meal's goal moved
// from 08:30 to 08:00 a week ago and its plates judged against their
// average; "Fasting window" measures spans from evening to noon, at least
// 16 hours being good, and one runs.
screenshot_question_times: [14]s32 = .[-1, 430, 465, 485, -1, 415, 450, 440,
495, -1, 425, 460, 445, 470];
screenshot_question_meals: [3]string = .["Oatmeal", "Eggs", "Fruit"];
screenshot_fast_starts: [14]s32 = .[-1, 1200, 1230, 1190, 1260, -1, 1215, 1205,
1250, 1195, -1, 1220, 1240, 1210];
screenshot_fast_ends: [14]s32 = .[-1, 2160, 2100, 2190, 2040, -1, 2175, 2160,
2130, 2205, -1, 2145, 2080, 2170];

// Gives a habit the meal questions; with entries, most past days answer
// them.
screenshot_seed_habit_questions :: (app: *InnerBreeze, index: s32,
    with_entries: bool) {
    if app == null || index < 0 || index >= app.habits.count { return }
    habit := *app.habits.items[index]
    texts: [4]string = .["When did I start eating?", "Plates", "Ate fruit?",
    "What did I eat first?"]
    types: [4]s32 = .[HABIT_ANSWER_TIME, HABIT_ANSWER_NUMBER,
    HABIT_ANSWER_YES_NO, HABIT_ANSWER_TEXT]
    goals: [4]HabitGoal = .[
    HabitGoal.{.kind = HABIT_GOAL_AT_MOST, .high = 510},
    HabitGoal.{.kind = HABIT_GOAL_ABOVE_AVERAGE},
    HabitGoal.{.kind = HABIT_GOAL_YES},
    HabitGoal.{}]
    habit.question_count = 0
    question: s32 = 0
    while question < 4 && HabitQuestionAdd(habit.questions[:],
        *habit.question_count, 1782200000) {
        unused AppCopyText(texts[question], habit.questions[question].text[:])
        habit.questions[question].answer_type = types[question]
        habit.questions[question].goal = goals[question]
        question += 1
    }
    habits_save(*app.habits)
    if !with_entries {
        return
    }
    // The questions were set up a month ago, and a week ago the first meal
    // moved from 08:30 to 08:00.
    habit_id := AppTextFromCString(*habit.id[0], HABIT_ID_SIZE)
    month_ago := storage_unix_at(screenshot_day_index_offset(29), 600)
    storage_habit_changes_backdate(habit_id, month_ago, month_ago)
    habit.questions[0].goal.high = 480
    habits_save(*app.habits)
    storage_habit_changes_backdate(habit_id, month_ago,
        storage_unix_at(screenshot_day_index_offset(7), 720))
    none: [1]HabitAnswer
    offset: s32 = 1
    while offset < 14 {
        minutes := screenshot_question_times[offset]
        if minutes >= 0 {
            day := screenshot_day_index_offset(offset)
            answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
            count := HabitAnswersFor(habit, none[:], 0, answers[:])
            unused HabitAnswerTimeText(minutes, answers[0].value[:])
            plates: [4]u8
            unused AppFormatS32(1 + offset % 3, plates[:])
            unused AppCopyText(AppTextFromCString(*plates[0], 4), answers[1].value[:])
            unused AppCopyText(ifx offset % 2 == 0 then "yes" else "no",
                answers[2].value[:])
            unused AppCopyText(screenshot_question_meals[offset % 3],
                answers[3].value[:])
            at := storage_unix_at(day, minutes)
            unused habit_save_entry(app, index, day, "", at, at, answers[:], count)
        }
        offset += 1
    }
}

// Names habit 3 "First meal" with the meal questions and habit 4
// "Fasting window", which measures spans, with a span running since now.
screenshot_seed_entry_habits :: (app: *InnerBreeze) {
    if app == null || app.habits.count < 5 { return }
    unused AppCopyText("First meal", app.habits.items[3].name[:])
    fast := *app.habits.items[4]
    unused AppCopyText("Fasting window", fast.name[:])
    fast.span = 1
    fast.span_goal = HabitGoal.{.kind = HABIT_GOAL_AT_LEAST, .low = 16 * 60}
    fast.counter_enabled = 0
    habits_save(*app.habits)
    storage_habit_changes_backdate(AppTextFromCString(*fast.id[0], HABIT_ID_SIZE),
        0, storage_unix_at(screenshot_day_index_offset(29), 600))
    screenshot_seed_habit_questions(app, 3, true)
    none: [1]HabitAnswer
    offset: s32 = 1
    while offset < 14 {
        if screenshot_fast_starts[offset] >= 0 {
            day := screenshot_day_index_offset(offset)
            unused habit_save_entry(app, 4, day, "",
                storage_unix_at(day, screenshot_fast_starts[offset]),
                storage_unix_at(day, screenshot_fast_ends[offset]), none[:], 0)
        }
        offset += 1
    }
    unused habit_start_span(app, 4)
}

// The sun_salutation_pose scene: Upward salute, the second step, with the
// fourth painted character, held four seconds in so the move has finished.
screenshot_pose_character :: 3
screenshot_pose_step :: 1
screenshot_pose_ticks :: 4 * 60

// Realistic habit set for promotional captures. The fixtures above stay as
// they are because tests rely on them; only the promo_habits scene uses this.
screenshot_showcase_habit_days: [42]s32 = .[
0, 1, 2, 3, 4, 5, 6,
0, 1, 3, 4, 6, -1, -1,
1, 2, 3, 4, 5, 6, -1,
0, 1, 2, 3, 5, -1, -1,
0, 2, 4, 6, -1, -1, -1,
1, 2, 3, 5, 6, -1, -1];

screenshot_seed_showcase_habits :: (app: *InnerBreeze) {
    if app == null || app.habits.count < 6 {
        return
    }
    AppCopyText("Evening walk", app.habits.items[2].name[:])
    AppCopyText("Twenty minutes outside", app.habits.items[2].description[:])
    AppCopyText("Stretching", app.habits.items[3].name[:])
    AppCopyText("Morning mobility", app.habits.items[3].description[:])
    AppCopyText("Cold shower", app.habits.items[4].name[:])
    AppCopyText("Finish cold for thirty seconds", app.habits.items[4].description[:])
    AppCopyText("Journaling", app.habits.items[5].name[:])
    AppCopyText("Three lines before bed", app.habits.items[5].description[:])
    app.habits.items[2].counter_enabled = 0
    habit: s32 = 0
    while habit < 6 {
        day: s32 = 0
        while day < 7 {
            offset := screenshot_showcase_habit_days[habit * 7 + day]
            if offset >= 0 {
                habit_set_day_count(*app.habits, habit, screenshot_day_index_offset(offset), 1)
            }
            day += 1
        }
        habit += 1
    }
}

screenshot_apply_theme :: (app: *InnerBreeze, theme_id: s32, dark_mode: s32) {
    if app == null {
        return
    }
    if theme_id == SCREENSHOT_THEME_CURRENT {
        app.theme_source = APP_THEME_SOURCE_SYSTEM
        app.theme_mode = APP_THEME_SYSTEM
        app_refresh_theme(app)
        return
    }
    app.theme_source = APP_THEME_SOURCE_APP
    app.theme_id = theme_id
    if dark_mode != 0 {
        app.theme_mode = APP_THEME_DARK
    } else {
        app.theme_mode = APP_THEME_LIGHT
    }
    app.dark_mode = ifx dark_mode != 0 then 1 else 0
    app_refresh_theme(app)
}

screenshot_setup_result_scene :: (app: *InnerBreeze, activity: s32) {
    if app == null {
        return
    }
    app.main_tab = APP_MAIN_TAB_PRACTICE
    app.exercise_type = activity
    app.breathing.screen = ScreenResults
    if activity == EXERCISE_WIM_HOF {
        rounds: [4] s32 = .[48, 61, 74, 69]
        saved_path: [32]u8
        AppCopyText("db:screenshot-whm", saved_path[:])
        app_prepare_session_results(app, EXERCISE_WIM_HOF, 0, 0, null,
            *rounds[0], 4, *saved_path[0])
        app.session_result.mood = 4
    } else if activity == EXERCISE_MEDITATION {
        saved_path: [32]u8
        AppCopyText("db:screenshot-meditation", saved_path[:])
        app_prepare_session_results(app, EXERCISE_MEDITATION, 15 * 60, 0,
            null, null, 0,
            *saved_path[0])
        app.session_result.mood = 5
    } else if activity == EXERCISE_SUN_SALUTATION {
        saved_path: [40]u8
        AppCopyText("db:screenshot-sun-salutation", saved_path[:])
        app_prepare_session_results(app, EXERCISE_SUN_SALUTATION, 6, 0,
            null, null, 0,
            *saved_path[0])
        app.session_result.mood = 4
    } else if activity == EXERCISE_PATTERNS {
        saved_path: [32]u8
        detail: [8]u8
        AppCopyText("db:screenshot-patterns", saved_path[:])
        AppCopyText("4-7-8", detail[:])
        app_prepare_session_results(app, EXERCISE_PATTERNS, 8 * 60, 48,
            *detail[0], null, 0,
            *saved_path[0])
        app.session_result.mood = 5
    }
}

// A guide scene ending in _flight shows Lumi halfway through her flight to
// the step, one ending in _typing halfway through typing its text, and any
// other scene shows her settled beside the whole text.
screenshot_lumi_moment :: (scene: string) -> s32 {
    if scene.count >= 7 && scene[scene.count - 7:] == "_flight" {
        return LUMI_MOMENT_FLIGHT
    }
    if scene.count >= 7 && scene[scene.count - 7:] == "_typing" {
        return LUMI_MOMENT_TYPING
    }
    return LUMI_MOMENT_SETTLED
}

// Where "+guide" starts in a scene, or -1.
screenshot_screen_guide_marker :: (scene: string) -> s32 {
    index: s32 = 0
    while index + 6 <= cast(s32)scene.count {
        if scene[index:index + 6] == "+guide" {
            return index
        }
        index += 1
    }
    return -1
}

// The guide step a scene asks for after "+guide", or -1 for no guide.
screenshot_screen_guide_step :: (scene: string) -> s32 {
    marker := screenshot_screen_guide_marker(scene)
    if marker < 0 {
        return -1
    }
    step := ScreenshotParseInt(scene[marker + 6:], 0)
    if step < 0 || step >= SCREEN_GUIDE_MAX_STEPS {
        return 0
    }
    return step
}

#program_export
setup_screenshot_scene :: (app: *InnerBreeze, request: *ScreenshotRequest) {
    if app == null || request == null {
        return
    }
    scene_text: string = AppTextFromCString(*request.scene[0], 64)
    LumiGuidePin(screenshot_lumi_moment(scene_text))
    // A scene such as lists+guide1_flight is the lists scene with Lumi's
    // guide for that screen open at its second step.
    guide_step := screenshot_screen_guide_step(scene_text)
    if guide_step >= 0 {
        request.scene[screenshot_screen_guide_marker(scene_text)] = cast(u8)0
        scene_text = AppTextFromCString(*request.scene[0], 64)
    }
    app.language_selected = 1
    app_close_modal(app)
    app.settings_scroll = 0
    app.settings_overview = 0
    app.manual_scroll = 0
    app.tutorial_step = 0
    app.habits_guide_seen = 1
    app.tutorial_seen = 1
    app.launcher_guide_seen = 1
    ScreenGuidesSeenAll(app)
    // Screenshots never download packages or show the Apps question.
    PackageSetAutomatic(false)
    // Sync screenshots must show only data already present in their isolated
    // storage root. Seeding defaults here can turn a visual check into an
    // upload as soon as an account is connected.
    if scene_text.count < 5 || scene_text[:5] != "sync_" {
        storage_set_setting_int("lumi_online", 0)
        screenshot_seed_habits(app)
    }
    if scene_text == "promo_habits" {
        screenshot_seed_showcase_habits(app)
    }
    screenshot_apply_theme(app, request.theme_id, request.dark_mode)
    // Store screenshots render a phone or tablet layout at device density.
    if request.ui_scale_tenths != 0 {
        app.ui_scale_tenths = request.ui_scale_tenths
    }
    if (scene_text.count >= 8 && scene_text[:8] == "tai_chi_") ||
        scene_text == "practice_config_tai_chi" {
        // Screenshot fixtures supply the same verified device cache as users,
        // shown as a buyer sees it; nothing is charged or granted.
        practice_owned = ScreenshotOwned
        PracticeDownloadsPump(EXERCISE_TAI_CHI, app.voice_narration_enabled != 0, true)
    }
    if scene_text == "lumi_chat" || scene_text == "lumi_customize" ||
    scene_text == "lumi_customize_light" || scene_text == "diary" ||
    scene_text == "apps_library" {
        // Promotional data and real local Lumi actions stay inside the
        // screenshot-only profile created before application startup.
        app.enabled_apps = APP_ALL
        unused CellsSetEnabled(APP_ALL)
        app.launcher_open = false
        storage_set_setting_int("lumi_introduced", 1)
        if scene_text == "apps_library" {
            app.main_tab = APP_MAIN_TAB_PRACTICE
            app.breathing.screen = ScreenStart
            app.launcher_open = true
        } else if scene_text == "diary" {
            unused LumiSubmit(app, "write this to my diary: A little space for myself today.\nBreathing, a morning walk, and one kind thought.")
            app.main_tab = APP_MAIN_TAB_DIARY
            app.breathing.screen = ScreenDiary
        } else {
            if scene_text == "lumi_customize" || scene_text == "lumi_customize_light" {
                unused LumiSubmit(app, "theme forest")
                if scene_text == "lumi_customize" {
                    unused LumiSubmit(app, "/dark")
                }
            } else {
                unused LumiSubmit(app, "help")
            }
            app.main_tab = APP_MAIN_TAB_LUMI
            app.breathing.screen = ScreenLumi
        }
    } else if scene_text == "launcher" || scene_text == "launcher_edit" || scene_text == "launcher_empty" {
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.breathing.screen = ScreenStart
        app.practice_tab = PRACTICE_TAB_PLAY
        app.navigation_placement = NAVIGATION_AUTOMATIC
        app.launcher_open = true
        app.launcher_favorites[0] = APP_NAV_ROUTE_HABITS
        app.launcher_favorites[1] = APP_NAV_ROUTE_PRACTICE
        app.launcher_favorite_count = ifx scene_text == "launcher_empty" then 0 else 2
        app.enabled_apps = APP_ALL
        unused CellsSetEnabled(APP_ALL)
    } else if AppTextFromCString(*request.scene[0], 64) == "lists" || AppTextFromCString(*request.scene[0], 64) == "lists_completed" {
        list_id: [37] u8
        completed_id: [37] u8
        app.main_tab = APP_MAIN_TAB_ELIST
        app.breathing.screen = ScreenEList
        if storage_elist_create_list("Shopping", *list_id[0]) != 0 {
            storage_elist_create_item(AppTextFromCString(*list_id[0], 37), "Fresh fruit", "For breakfast", null)
            if storage_elist_create_item(AppTextFromCString(*list_id[0], 37), "Buy tea", "", *completed_id[0]) != 0 {
                storage_elist_update_item(AppTextFromCString(*completed_id[0], 37), "Buy tea", "", 1, 1)
            }
        }
        storage_elist_create_list("Home", null)
        storage_elist_create_list("Weekend", null)
        storage_elist_load(cast(*void)(*app.elist))
        i: s32 = 0
        while i < app.elist.list_count {
            if AppTextFromCString(*app.elist.lists[i].id[0], 37) ==
            AppTextFromCString(*list_id[0], 37) {
                app.elist.selected_list = i
            }
            i += 1
        }
        app.elist.loaded = 1
        if AppTextFromCString(*request.scene[0], 64) == "lists_completed" {
            app.elist.show_completed = 1
        } else {
            app.elist.show_completed = 0
        }
    } else if scene_text == "leaderboard" {
        // Friends' saved results, ranked without a network fetch.
        unused storage_set_social_cache_json("friends.list",
            "{\"friends\":[{\"user_id_hash\":\"river\",\"alias\":\"river\"},{\"user_id_hash\":\"cedar\",\"alias\":\"cedar\"}]}")
        unused storage_set_social_cache_json("leaderboard.breathing.whm.streak",
            "{\"rows\":[{\"user_id_hash\":\"river\",\"alias\":\"river\",\"value\":12,\"label\":\"12\"},{\"user_id_hash\":\"maple\",\"alias\":\"maple\",\"value\":30,\"label\":\"30\"}]}")
