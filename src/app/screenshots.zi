    } else if scene_text == "sync_review" || scene_text == "sync_review_no_changes" {
        // This path only runs in the screenshot mode's isolated data root.
        account: AccountKeys = .{}
        if sync_account_generate(*account) == 0 {
            return
        }
        if cast(s32)sync_account_save(*account, cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK) == 0 {
            return
        }
        screenshot_seed_habits(app)
        storage_enqueue_all_sync_state()
        payload := storage_build_sync_payload_json("review-fixture", "review-fixture")
        if payload == null {
            return
        }
        statement: *void = null
        social_records := "[]"
        if scene_text == "sync_review" {
            social_records = "[{\"kind\":\"friends.list\",\"json\":{\"friends\":[{\"user_id_hash\":\"fixture-a\",\"alias\":\"Alicia\"},{\"user_id_hash\":\"fixture-c\",\"alias\":\"Cara\"}]}},{\"kind\":\"friends.requests\",\"json\":{\"incoming\":[{\"id\":\"fixture-request-d\",\"requester_user_id_hash\":\"fixture-d\",\"requester_alias\":\"Dani\"}],\"outgoing\":[]}}]"
        }
        sql := "SELECT json_object('protocol_version',6,'server_version',24,'full_snapshot_required',json('true'),'changes',json_object('encrypted_records',json_extract(?1,'$.encrypted_records'),'social_cache',json(?2)))"
        if SqlitePrepareText(storage_db_handle(), sql, -1, *statement, null) == SQLITE_OK {
            bind_text(statement, 1, AppTextFromCString(payload, 2147483647))
            bind_text(statement, 2, social_records)
            if SqliteStep(statement) == SQLITE_ROW {
                storage_sync_review_write_json(AppTextFromCString(SqliteColumnText(statement, 0), 2147483647))
            }
            SqliteFinalize(statement)
        }
        storage_free_sync_payload_json(payload)
        if scene_text == "sync_review" {
            storage_clear_local_sync_data()
            exec_sql("INSERT INTO habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at) VALUES('local-review-walk',(SELECT id FROM users LIMIT 1),'Local walk',80,140,100,0,0,1,0,0,1782300000)")
            exec_sql("INSERT OR REPLACE INTO social_snapshots VALUES((SELECT id FROM users LIMIT 1),'friends.list','{\"friends\":[{\"user_id_hash\":\"fixture-a\",\"alias\":\"Alice\"},{\"user_id_hash\":\"fixture-b\",\"alias\":\"Bob\"}]}',0)")
            exec_sql("INSERT OR REPLACE INTO social_snapshots VALUES((SELECT id FROM users LIMIT 1),'friends.requests','{\"incoming\":[],\"outgoing\":[]}',0)")
        }
        storage_enqueue_all_sync_state()
        storage_set_sync_enabled(0)
        storage_set_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 1)
        app.profile_view = PROFILE_VIEW_MAIN
        app.profile_tab = PROFILE_TAB_DATA
        app.breathing.screen = ScreenProfile
        app_open_modal(app, cast(ModalType)ModalSyncReview)
    } else if AppTextFromCString(*request.scene[0], 64) == "sync_disconnected"  || AppTextFromCString(*request.scene[0], 64) == "sync_retry" {
        account: AccountKeys = .{}
        if sync_account_generate(*account) != 0 {
            sync_account_save(*account, cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK)
        }
        storage_set_setting_text("sync_server_url", "http://127.0.0.1:1")
        storage_set_sync_enabled(ifx AppTextFromCString(*request.scene[0], 64) == "sync_retry" then 1 else 0)
        if storage_sync_enabled() != 0 {
            app_sync_record_result(cast(s32)SYNC_REQUEST_FAILED)
        }
        app.profile_view = PROFILE_VIEW_MAIN
        if storage_sync_enabled() != 0 {
            app.profile_tab = PROFILE_TAB_SYNC
        } else {
            app.profile_tab = PROFILE_TAB_DATA
        }
        app.breathing.screen = ScreenProfile
    } else if AppTextFromCString(*request.scene[0], 64) == "sync_connected" {
        account: AccountKeys = .{}
        payload: *u8 = null
        if sync_account_generate(*account) != 0 {
            sync_account_save(*account, cast(SyncAccountLocalDataChoice)SYNC_ACCOUNT_LOCAL_DATA_ASK)
        }
        storage_set_setting_text("sync_account_alias", "waozi")
        storage_set_setting_text("sync_server_url", "https://api.waozi.xyz")
        storage_set_sync_enabled(1)
        screenshot_seed_habits(app)
        storage_set_social_cache_json(
            "friends.list",
            "{\"friends\":[{\"id\":\"friend-1\"},{\"id\":\"friend-2\"}]}")
        sync_pass: s32 = 0
        while sync_pass < 4 {
            payload = storage_build_sync_payload_json(
                AppTextFromCString(*account.public_id[0], ACCOUNT_PUBLIC_ID_HEX_SIZE),
                AppTextFromCString(*account.public_key_hex[0], ACCOUNT_PUBLIC_KEY_HEX_SIZE))
            storage_free_sync_payload_json(payload)
            storage_apply_sync_response_json(
                "{\"protocol_version\":6,\"server_version\":1,\"changes\":{\"encrypted_records\":[]}}")
            sync_pass += 1
        }
        app_sync_record_result(cast(s32)SYNC_OK)
        app.profile_view = PROFILE_VIEW_MAIN
        app.profile_tab = PROFILE_TAB_SYNC
        app.breathing.screen = ScreenProfile
    } else if AppTextFromCString(*request.scene[0], 64) == "configure_account"  || AppTextFromCString(*request.scene[0], 64) == "profile_sync_account" {
        app.profile_view = PROFILE_VIEW_MAIN
        app.profile_tab = PROFILE_TAB_OVERVIEW
        app.breathing.screen = ScreenProfile
    } else if AppTextFromCString(*request.scene[0], 64) == "cobalt_dark" {
        screenshot_apply_theme(app, ThemeCobaltId, 1)
        app.exercise_type = EXERCISE_PATTERNS
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.practice_tab = PRACTICE_TAB_PLAY
        app.breathing.screen = ScreenStart
    } else if AppTextFromCString(*request.scene[0], 64) == "patterns" {
        app.exercise_type = EXERCISE_PATTERNS
        app.main_tab = APP_MAIN_TAB_PRACTICE
        patterns_practice_start(app)
    } else if AppTextFromCString(*request.scene[0], 64) == "patterns_results" {
        screenshot_setup_result_scene(app, EXERCISE_PATTERNS)
    } else if AppTextFromCString(*request.scene[0], 64) == "patterns_config" {
        app.exercise_type = EXERCISE_PATTERNS
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.practice_tab = PRACTICE_TAB_CONFIG
        app.breathing.screen = ScreenStart
    } else if AppTextFromCString(*request.scene[0], 64) == "break_settings" {
        if DesktopPlatform() != 0 {
            app.main_tab = APP_MAIN_TAB_PRACTICE
            app.settings_tab = SETTINGS_TAB_BREAKS
            app.breaks_enabled = 1
            app.breathing.screen = ScreenSettings
        }
    } else if AppTextFromCString(*request.scene[0], 64) == "break_micro"  || AppTextFromCString(*request.scene[0], 64) == "break_rest"  || AppTextFromCString(*request.scene[0], 64) == "break_daily" {
        if DesktopPlatform() != 0 {
            t: s32 = BREAK_MICRO
            if AppTextFromCString(*request.scene[0], 64) == "break_rest" {
                t = BREAK_REST
            } else if AppTextFromCString(*request.scene[0], 64) == "break_daily" {
                t = BREAK_DAILY
            }
            app.breaks_enabled = 1
            app.break_block_mode = 0
            app.breaks.timers[t].active_s = app.breaks.timers[t].limit_s
            app.breaks.timers[t].state = BreakStateBreaking
            app.breaks.timers[t].idle_s = ifx (app.breaks.timers[t].duration_s > 0) then (app.breaks.timers[t].duration_s / 3) else (0)
            app.breathing.screen = ScreenBreak
        }
    } else if AppTextFromCString(*request.scene[0], 64) == "tutorial_whm_step0" {
        app.exercise_type = EXERCISE_WIM_HOF
        app.practice_tab = PRACTICE_TAB_MANUAL
        app.breathing.screen = ScreenStart
        app.tutorial_step = 0
    } else if AppTextFromCString(*request.scene[0], 64) == "tutorial_whm_step2" {
        app.exercise_type = EXERCISE_WIM_HOF
        app.practice_tab = PRACTICE_TAB_MANUAL
        app.breathing.screen = ScreenStart
        app.tutorial_step = 2
    } else if AppTextFromCString(*request.scene[0], 64) == "tutorial_meditation" {
        app.exercise_type = EXERCISE_MEDITATION
        app.practice_tab = PRACTICE_TAB_MANUAL
        app.breathing.screen = ScreenStart
        app.tutorial_step = 0
    } else {
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.exercise_type = EXERCISE_WIM_HOF
        app.practice_tab = PRACTICE_TAB_PLAY
        app.breathing.screen = ScreenStart
    }
    if guide_step >= 0 {
        // Settings on a phone opens on its list of sections.
        app.settings_overview = 1
        ScreenGuideShowForScreenshot(app, ScreenGuideFor(app), guide_step)
    }
}
