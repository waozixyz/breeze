#import, file "../platform/host_window_state.zi";
#import, file "app_types.zi";
#import, file "app_nav_state.zi";
#import, file "entity_host.zi";
#import, file "app_launcher_state.zi";
#import, file "launcher_policy.zi";
#import, file "app_route_state.zi";
#import, file "../apps/package_files.zi";
#import, file "../platform/launcher_shortcut.zi";
#import, file "../platform/launcher_icon.zi";
#import, file "../platform/environment.zi";
#import, file "../widgets/bottom_nav.zi";
#import, file "../core/types.zi";
#import, file "../storage/paths.zi";
#import "c_string"
#import, file "text_buffers.zi";
#import, file "route_types.zi";
#import, file "../platform/launcher_entry.zi";

launcher_pin_status: s32 = -1;
launcher_pending_name: [25]u8;
launcher_request_attempted: bool;
launcher_executable_followed: bool;

// Shortcut icons, and the executable the shortcuts open, beside the packages.
app_launcher_folder :: () -> string {
    packages := PackageDirectory()
    defer { PackageFree(packages) }
    if packages.count == 0 { return "" }
    return PackageText(packages, "/launcher")
}

app_launcher_icon :: (folder: string, name: string) -> string {
    stem := PackageText("/", name)
    defer { PackageFree(stem) }
    path := PackageText(folder, stem)
    defer { PackageFree(path) }
    return PackageText(path, ifx WindowsPlatform() != 0 then ".ico" else ".png")
}

app_launcher_record_executable :: (folder: string, executable: string) {
    record := PackageText(folder, "/executable")
    defer { PackageFree(record) }
    unused PackageWrite(record, executable)
}

app_launcher_pin :: (app: *InnerBreeze, route: s32) {
    launcher_pin_status = 0
    name := LauncherRouteName(route)
    if !LauncherAppNameValid(name) || !app_nav_route_available(app, route) { return }
    directory := app_launcher_folder()
    defer { PackageFree(directory) }
    if directory.count == 0 || storage_ensure_dir(directory) == 0 { return }
    icon := app_launcher_icon(directory, name)
    defer { PackageFree(icon) }
    if LauncherIconWrite(icon, app_nav_route_shape(route), WindowsPlatform() != 0) {
        launcher_pin_status = LauncherShortcutInstall(name, app_nav_route_label(route), icon)
    }
    executable_bytes: [4096]u8
    executable := LauncherExecutable(executable_bytes[:])
    if launcher_pin_status == 2 && executable.count > 0 {
        app_launcher_record_executable(directory, executable)
    }
}

// Shortcuts open the executable that wrote them. When another one runs, such
// as after an update renamed the program, the shortcuts still on this device
// are rewritten for it; ones the person removed stay removed.
app_launcher_follow_executable :: () {
    launcher_executable_followed = true
    executable_bytes: [4096]u8
    executable := LauncherExecutable(executable_bytes[:])
    directory := app_launcher_folder()
    defer { PackageFree(directory) }
    if executable.count == 0 || directory.count == 0 { return }
    record := PackageText(directory, "/executable")
    recorded := PackageRead(record, 4096)
    PackageFree(record)
    same := recorded == executable
    PackageFree(recorded)
    if same { return }
    routes := LauncherRoutes()
    for route: routes {
        name := LauncherRouteName(route)
        if !LauncherShortcutPresent(name) { continue }
        icon := app_launcher_icon(directory, name)
        if PackageFileSize(icon) >= 0 {
            unused LauncherShortcutInstall(name, app_nav_route_label(route), icon)
        }
        PackageFree(icon)
    }
    app_launcher_record_executable(directory, executable)
}

// Keep an unresolved cold launch while its already installed package loads.
// A launcher never silently reinstalls an app removed from this account.
app_launcher_request_app :: (name: string) {
    if LauncherAppNameValid(name) {
        unused CopyCString(name, launcher_pending_name[:])
        launcher_request_attempted = false
    }
}

app_launcher_pump_request :: (app: *InnerBreeze) {
    if !launcher_executable_followed && app.language_selected != 0 && app.apps_selected != 0 {
        app_launcher_follow_executable()
    }
    incoming := LauncherShortcutTakeApp()
    if incoming.count > 0 { app_launcher_request_app(incoming) }
    pending: [25]u8 = launcher_pending_name
    name := AppTextFromCString(*pending[0], 25)
    if name.count == 0 { return }
    if name == "inbe" {
        app.host_feature = 0
        launcher_pending_name[0] = 0
        return
    }
    if app.language_selected == 0 || app.apps_selected == 0 { return }
    // Older desktop shortcuts still open the leaderboard inside Profile.
    route := LauncherRouteForName(name)
    if name == "leaderboard" { route = cast(s32)AppNavRoute.APP_NAV_ROUTE_LEADERBOARD }
    if route == cast(s32)AppNavRoute.APP_NAV_ROUTE_NONE || !app_nav_route_available(app, route) { return }
    if app.modal.active != 0 { return }
    attempted := launcher_request_attempted
    if !attempted {
        app_launcher_close(app)
        app_apply_nav_route(app, route)
        launcher_request_attempted = true
    }
    current := app_current_nav_route(app)
    reached := current == route || (route == cast(s32)AppNavRoute.APP_NAV_ROUTE_LEADERBOARD &&
        current == cast(s32)AppNavRoute.APP_NAV_ROUTE_PROFILE && EntityHostLeaderboardPending())
    if !reached && attempted {
        // The person dismissed an unsaved-changes dialog and stayed here.
        launcher_pending_name[0] = 0
        return
    }
    if reached {
        // A shortcut to one of Inbe's own screens keeps the navigation; only
        // a node app hides the surrounding harness.
        if AppNavNodeSlot(route) >= 0 {
            app.host_feature = route
        } else {
            app.host_feature = 0
        }
        #if !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB) {
            HostSetWindowTitle(app_nav_route_label(route))
        }
        launcher_pending_name[0] = 0
    }
}
