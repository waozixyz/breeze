#import "vec"

SettingsEntry :: struct {
    key: [64]u8
    key_count: s32
    value: [256]u8
    value_count: s32
}

settings_entries: Vec(SettingsEntry);

SettingsCacheAdd :: (key: string, value: string) -> bool {
    if key.count == 0 { return false }
    entry: SettingsEntry
    entry.key_count = 63
    if key.count < 63 { entry.key_count = cast(s32)key.count }
    entry.value_count = 255
    if value.count < 255 { entry.value_count = cast(s32)value.count }
    for index: 0..(cast(int)entry.key_count - 1) {
        entry.key[index] = key[index]
    }
    for index: 0..(cast(int)entry.value_count - 1) {
        entry.value[index] = value[index]
    }
    return VecPush(settings_entries, entry)
}

SettingsCacheIndex :: (key: string) -> s32 {
    if key.count == 0 || key.count > 63 { return -1 }
    index: s32 = 0
    while index < cast(s32)settings_entries.count {
        entry: SettingsEntry = settings_entries[index]
        if entry.key_count == cast(s32)key.count {
            same: bool = true
            byte_index: s32 = 0
            while byte_index < entry.key_count {
                if entry.key[byte_index] != key[byte_index] {
                    same = false
                    break
                }
                byte_index += 1
            }
            if same { return index }
        }
        index += 1
    }
    return -1
}

SettingsCacheContains :: (key: string) -> bool {
    return SettingsCacheIndex(key) >= 0
}

SettingsCacheIndexBytes :: (key: []u8) -> s32 {
    if key.count == 0 || key.count > 63 { return -1 }
    index: s32 = 0
    while index < cast(s32)settings_entries.count {
        entry: SettingsEntry = settings_entries[index]
        if entry.key_count == cast(s32)key.count {
            same: bool = true
            byte_index: s32 = 0
            while byte_index < entry.key_count {
                if entry.key[byte_index] != key[byte_index] {
                    same = false
                    break
                }
                byte_index += 1
            }
            if same { return index }
        }
        index += 1
    }
    return -1
}

SettingsCacheIntAt :: (found: s32, fallback: s32) -> s32 {
    if found < 0 { return fallback }
    entry: SettingsEntry = settings_entries[found]
    if entry.value_count == 0 { return fallback }
    index: s32 = 0
    while index < entry.value_count  && (entry.value[index] == 9 || entry.value[index] == 10  || entry.value[index] == 11 || entry.value[index] == 12  || entry.value[index] == 13 || entry.value[index] == #char " ") {
        index += 1
    }
    negative: bool = false
    if index < entry.value_count && entry.value[index] == #char "-" {
        negative = true
        index += 1
    } else if index < entry.value_count && entry.value[index] == #char "+" {
        index += 1
    }
    value: s64 = 0
    digits: s32 = 0
    limit: s64 = 2147483647
    if negative { limit = 2147483648 }
    while index < entry.value_count && entry.value[index] >= #char "0"  && entry.value[index] <= #char "9" {
        digit: s64 = cast(s64)(entry.value[index] - 48)
        if value > (limit - digit) / 10 {
            value = limit
        } else {
            value = value * 10 + digit
        }
        digits += 1
        index += 1
    }
    if digits == 0 { return 0 }
    if negative { return cast(s32)(-value) }
    return cast(s32)value
}

SettingsCacheInt :: (key: string, fallback: s32) -> s32 {
    return SettingsCacheIntAt(SettingsCacheIndex(key), fallback)
}

SettingsCacheIntBytes :: (key: []u8, fallback: s32) -> s32 {
    return SettingsCacheIntAt(SettingsCacheIndexBytes(key), fallback)
}

SettingsCacheCopyTextAt :: (found: s32, output: []u8) -> bool {
    if output.count == 0 { return false }
    output[0] = 0
    if found < 0 { return false }
    entry: SettingsEntry = settings_entries[found]
    copied: s32 = entry.value_count
    if copied >= cast(s32)output.count {
        copied = cast(s32)output.count - 1
    }
    for index: 0..(cast(int)copied - 1) {
        output[index] = entry.value[index]
    }
    output[copied] = 0
    return true
}

SettingsCacheCopyText :: (key: string, output: []u8) -> bool {
    return SettingsCacheCopyTextAt(SettingsCacheIndex(key), output)
}

SettingsCacheCopyTextBytes :: (key: []u8, output: []u8) -> bool {
    return SettingsCacheCopyTextAt(SettingsCacheIndexBytes(key), output)
}

SettingsCacheFree :: () {
    VecFree(settings_entries)
}
