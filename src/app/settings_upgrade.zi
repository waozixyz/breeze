#import, file "settings_cache.zi";

// Before 1.8.5 the app theme was the only theme source, so settings last
// saved by those versions hold a theme but no source. A theme picked there,
// anything but the first one, stays the app theme after the upgrade.
#program_export
SettingsThemePickedBeforeSources :: () -> bool {
    if SettingsCacheContains("theme_source") {
        return false
    }
    return SettingsCacheInt("theme", 0) != 0
}
