#import, file "mini_mode_policy.zi";
#import, file "route_host.zi";
#import, file "../storage/temporary_data.zi";

// Whether Inbe runs in mini mode; see mini_mode_policy.zi. The expand button
// and the switch to the full app are in mini_mode_expand.zi.

#scope_file
WEB :: #defined(PLATFORM_WEB)

#scope_export
// A phone-shaped desktop window for mini mode.
MINI_WINDOW_WIDTH :: 400
MINI_WINDOW_HEIGHT :: 720

app_mini_mode: bool;

#program_export
AppMiniMode :: () -> bool {
    return app_mini_mode
}

// Starts mini mode when the page address has ?mini, or on the desktop when
// the command line has --mini.
AppMiniModeStart :: (args: []string) -> bool {
    #if WEB {
        app_mini_mode = MiniModeQuery(app_route_query())
    } else {
        app_mini_mode = MiniModeArgument(args)
    }
    // A mini session is temporary; see DataTemporary.
    DataSetTemporary(app_mini_mode)
    return app_mini_mode
}

AppMiniModeEnd :: () {
    app_mini_mode = false
    DataSetTemporary(false)
}
