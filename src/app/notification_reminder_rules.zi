// Breeze owns reminder eligibility. Kryon owns persistent OS scheduling.
#program_export
ReminderDue :: (enabled: bool, reminder_hour: s32, last_day: s32,
    day_key: s32, current_hour: s32) -> bool {
    if !enabled || day_key <= 0 || last_day == day_key {
        return false
    }
    if reminder_hour < 0 || reminder_hour > 23 ||
    current_hour < 0 || current_hour > 23 {
        return false
    }
    // A sleeping desktop or an inactive browser can miss the configured
    // hour. Deliver once when it resumes later on the same local day.
    return current_hour >= reminder_hour
}
