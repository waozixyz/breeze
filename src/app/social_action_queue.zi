SOCIAL_ACTION_QUEUE_MAX :: 8

SocialAction :: struct {
    action: [16]u8
    value: [96]u8
}

SocialActionQueue :: struct {
    items: [SOCIAL_ACTION_QUEUE_MAX]SocialAction
    head: s32
    count: s32
}

social_queue: SocialActionQueue;

#program_export
SocialQueueCount :: () -> s32 {
    return social_queue.count
}

#program_export
SocialQueueClear :: () {
    social_queue.head = 0
    social_queue.count = 0
}

#program_export
SocialQueuePush :: (action: string, value: string) -> bool {
    if social_queue.count >= SOCIAL_ACTION_QUEUE_MAX  || action.count == 0 || value.count == 0  || action[0] == 0 || value[0] == 0 { return false }
    index: s32 = (social_queue.head + social_queue.count) %
                 SOCIAL_ACTION_QUEUE_MAX
    action_count: s32 = 0
    while action_count < 15 && action_count < cast(s32)action.count  && action[action_count] != 0 {
        social_queue.items[index].action[action_count] = action[action_count]
        action_count += 1
    }
    social_queue.items[index].action[action_count] = 0
    value_count: s32 = 0
    while value_count < 95 && value_count < cast(s32)value.count  && value[value_count] != 0 {
        social_queue.items[index].value[value_count] = value[value_count]
        value_count += 1
    }
    social_queue.items[index].value[value_count] = 0
    social_queue.count += 1
    return true
}

SocialQueuePeek :: (action_out: []u8, value_out: []u8) -> bool {
    if action_out.count == 0 || value_out.count == 0 { return false }
    action_out[0] = 0
    value_out[0] = 0
    if social_queue.count <= 0 { return false }
    index: s32 = social_queue.head
    action_limit: s32 = cast(s32)action_out.count - 1
    if action_limit > 15 { action_limit = 15 }
    action_index: s32 = 0
    while action_index < action_limit  && social_queue.items[index].action[action_index] != 0 {
        action_out[action_index] = social_queue.items[index].action[action_index]
        action_index += 1
    }
    action_out[action_index] = 0
    value_limit: s32 = cast(s32)value_out.count - 1
    if value_limit > 95 { value_limit = 95 }
    value_index: s32 = 0
    while value_index < value_limit  && social_queue.items[index].value[value_index] != 0 {
        value_out[value_index] = social_queue.items[index].value[value_index]
        value_index += 1
    }
    value_out[value_index] = 0
    return true
}

SocialQueuePop :: (action_out: []u8, value_out: []u8) -> bool {
    if !SocialQueuePeek(action_out, value_out) { return false }
    index: s32 = social_queue.head
    social_queue.items[index].action[0] = 0
    social_queue.items[index].value[0] = 0
    social_queue.head = (social_queue.head + 1) % SOCIAL_ACTION_QUEUE_MAX
    social_queue.count -= 1
    return true
}
