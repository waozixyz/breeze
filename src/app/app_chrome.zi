#import "button_props"
#import "button_widget"
#import "control_props"
#import "dropdown_props"
#import "geometry"
#import "image_props"
#import "session"
#import "tab_bar_widget"
#import "title_bar_props"
#import "title_bar_widget"
#import, file "../core/types.zi";
#import, file "app_types.zi";
#import, file "metrics.zi";
#import "drawing_props"

using ButtonTone;
using ButtonEmphasis;

#program_export
app_draw_close_title_bar :: (app: *InnerBreeze, title: string,
    close_label: string, height: s32) -> s32 {
    if app == null || app.ui.view_width <= 0 || height <= 0 {
        return 0
    }

    button_size := AppScale(22)
    padding := AppScale(11)
    button_total := button_size + padding * 2
    x := app.ui.view_width - button_total - AppScale(8)
    y := (height - button_total) / 2
    if y < 0 {
        y = 0
    }

    options: [1]DropdownOption
    bar: TitleBarProps
    bar.title = title
    bar.height = height
    bar.bounds = Rectangle.{0.0, 0.0,
        cast(float32)app.ui.view_width, cast(float32)height
    }
    unused TitleBar(app.ui.session, bar, options[0:0])

    close: ButtonProps
    close.id = 9101
    close.label = close_label
    close.bounds = Rectangle.{cast(float32)x, cast(float32)y,
        cast(float32)button_total, cast(float32)button_total
    }
    close.image.asset_path = "icons/ui.png"
    close.image.alt_text = close_label
    close.image.source = Rectangle.{.x = 448.0, .y = 384.0, .width = 64.0, .height = 64.0}
    close.icon_only = true
    close.circle = true
    close.tone = cast(ButtonTone)ButtonToneNeutral
    close.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    if app.modal.active == 0 && Button(app.ui.session, close) != 0 {
        return 1
    }
    return 0
}

#program_export
app_toolbar_height :: () -> s32 {
    return AppScale(58)
}

#program_export
app_content_top_reserved :: (app: *InnerBreeze) -> s32 {
    if app != null && app.breathing.screen == ScreenStart {
        return GetTabBarHeight()
    }
    return app_toolbar_height()
}
