#import "app_chrome_ui"
Button :: #import "kryon/button";
Dropdown :: #import "kryon/dropdown";
TitleBar :: #import "kryon/title_bar";
TabBar :: #import "kryon/tab_bar";
#import "control_props"
#import "geometry"
#import "session"
#import, file "../core/types.zi";
#import, file "app_types.zi";
#import, file "metrics.zi";
#import "drawing_props"

using ButtonTone;
using ButtonEmphasis;



#program_export
app_toolbar_height :: () -> s32 {
    return AppScale(58)
}

#program_export
app_content_top_reserved :: (app: *InnerBreeze) -> s32 {
    if app != null && app.breathing.screen == ScreenStart {
        return TabBar.TabBarHeight()
    }
    return app_toolbar_height()
}

AppChromeNewOptions :: () -> [1]Dropdown.Option {
    result: [1]Dropdown.Option
    return result
}

// Preserve the package-facing native ABI; the view is authored in TSX.
#program_export
app_draw_close_title_bar :: (app: *InnerBreeze, title: string,
    close_label: string, height: s32) -> s32 {
    return app_draw_close_title_barView(app, title, close_label, height)
}
