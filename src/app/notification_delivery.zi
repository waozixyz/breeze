#import "notification"
#if #defined(KRYON_TEST_DRIVER) && #defined(DESKTOP_HOST) {
    #import "test_driver"
    #import, file "../platform/host_window_state.zi";
}

AppNotificationTestMode :: () -> bool {
    #if #defined(KRYON_TEST_DRIVER) && #defined(DESKTOP_HOST) {
        return TestDriverActive()
    } else {
        return false
    }
}

AppNotificationsAllowed :: () -> bool {
    return AppNotificationTestMode() || NotificationsAllowed()
}

AppRequestNotifications :: () -> bool {
    return AppNotificationTestMode() || RequestNotifications()
}

AppNotify :: (props: NotificationProps) -> bool {
    #if #defined(KRYON_TEST_DRIVER) && #defined(DESKTOP_HOST) {
        if AppNotificationTestMode() {
            // Keep the fixture's reminder bookkeeping independent of the
            // desktop notification service.
            return props.title.count > 0 && props.body.count > 0 &&
                (!props.suppress_when_focused || !HostWindowFocused())
        }
    }
    return Notify(props)
}
