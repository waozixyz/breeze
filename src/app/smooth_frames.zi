// Frames an app package asked to draw at the full rate while it animates,
// such as Lumi swirling when tapped. Frame pacing spends one per frame.
SMOOTH_FRAMES_MAX :: 600

smooth_frames_left: s32;

// Asks for at least this many smooth frames from now on.
#program_export
AppRequestSmoothFrames :: (frames: s32) {
    if frames > SMOOTH_FRAMES_MAX {
        frames = SMOOTH_FRAMES_MAX
    }
    if frames > smooth_frames_left {
        smooth_frames_left = frames
    }
}

// Whether an app package still animates on frames it asked for.
AppSmoothFramesActive :: () -> bool {
    return smooth_frames_left > 0
}

// Spends one requested frame. Returns whether one was left.
#program_export
AppSpendSmoothFrame :: () -> bool {
    if smooth_frames_left <= 0 {
        return false
    }
    smooth_frames_left -= 1
    return true
}
