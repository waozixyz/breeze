    web_test_practice_action_target :: (action: s32) -> Vector2 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenStart {
            return Vector2.{-1, -1}
        }
        bounds := app.practice_home_bounds_config
        if action == 0 {
            bounds = app.practice_home_bounds_manual
        }
        if !web_test_rect_valid(bounds) {
            return Vector2.{-1, -1}
        }
        return WorldToScreen(Vector2.{bounds.x + bounds.width / 2,
                bounds.y + bounds.height / 2}, app.camera)
    }
    #program_export
    app_web_test_practice_action_click_x :: (action: s32) -> s32 {
        return cast(s32)web_test_practice_action_target(action).x
    }
    #program_export
    app_web_test_practice_action_click_y :: (action: s32) -> s32 {
        return cast(s32)web_test_practice_action_target(action).y
    }
    web_test_sun_salutation_control_target :: (index: s32) -> Vector2 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenSunSalutation ||
        index < 0 || index > 2 {
            return Vector2.{-1, -1}
        }
        row: BottomIconRowProps
        row.center_x = app.ui.view_width / 2
        row.view_width = app.ui.view_width
        row.view_height = app.ui.view_height
        row.count = 3
        layout := BottomIconRowLayoutFor(row, MetricsScale())
        bounds := BottomIconRowButtonBoundsFor(layout, index)
        return WorldToScreen(Vector2.{bounds.x + bounds.width / 2,
                bounds.y + bounds.height / 2}, app.camera)
    }
    #program_export
    app_web_test_sun_salutation_control_x :: (index: s32) -> s32 {
        return cast(s32)web_test_sun_salutation_control_target(index).x
    }
    #program_export
    app_web_test_sun_salutation_control_y :: (index: s32) -> s32 {
        return cast(s32)web_test_sun_salutation_control_target(index).y
    }
    #program_export
    app_web_test_sun_salutation_step :: () -> s32 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenSunSalutation {
            return -1
        }
        return app.sun_salutation.step
    }
    #program_export
    app_web_test_sun_salutation_ticks :: () -> s32 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenSunSalutation {
            return -1
        }
        return app.sun_salutation.step_ticks
    }
    #program_export
    app_web_test_sun_salutation_character :: () -> s32 {
        app := CurrentApp()
        if app == null {
            return -1
        }
        return app.sun_salutation.character
    }
    #program_export
    app_web_test_sun_salutation_paused :: () -> s32 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenSunSalutation {
            return -1
        }
        return app.session_paused
    }
    #program_export
    app_web_test_show_appearance :: () {
        app := CurrentApp()
        if app == null {
            return
        }
        before := app_current_route(app)
        if app.modal.active != 0 {
            app_close_modal(app)
        }
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.settings_tab = SETTINGS_TAB_THEME
        app.settings_overview = 0
        app.settings_scroll = 0
        app.breathing.screen = ScreenSettings
        app.theme_source = APP_THEME_SOURCE_APP
        app.theme_id = 0
        app.theme_mode = APP_THEME_LIGHT
        app_refresh_theme(app)
        app_observe_direct_route_change(app, before)
    }
    // Browser tests supply a real WAV in the virtual filesystem. Playback
    // starts through the same visible controls a person uses.
    #program_export
    app_web_test_prepare_music :: () {
        app := CurrentApp()
        if app == null {
            return
        }
        // The smoke server supplies this explicit local fixture. Production
        // wrappers still contain only the recommended applications.
        if CellsUseFile("/tmp/inbe-navigation-lists.zib") &&
        CellsReloadFeatures(APP_LISTS | APP_HABITS | APP_PRACTICE) {
            app.enabled_apps = APP_LISTS | APP_HABITS | APP_PRACTICE
            app.apps_selected = 1
            app_update_app_navigation(app)
        }
        before := app_current_route(app)
        if app.modal.active != 0 {
            app_close_modal(app)
        }
        app.tutorial_seen = 1
        app.music_volume = 60
        app.audio_custom_music_count = 1
        AppCopyText("/tmp/inbe-navigation.wav", app.audio_custom_music[0].path[:])
        AppCopyText("Navigation test track", app.audio_custom_music[0].title[:])
        app.exercise_type = EXERCISE_MEDITATION
        app.meditation.music_track = AUDIO_BUILTIN_MUSIC_COUNT
        app.meditation.music_practice_tracks[EXERCISE_MEDITATION] = AUDIO_BUILTIN_MUSIC_COUNT
        app.practice_tab = PRACTICE_TAB_PLAY
        app.practice_config_tab = 0
        app.settings_tab = SETTINGS_TAB_AUDIO
        app.settings_overview = 0
        app.settings_scroll = 0
        app.breathing.screen = ScreenSettings
        app_observe_direct_route_change(app, before)
    }
    web_test_music_button_target :: (action: s32) -> Vector2 {
        app := CurrentApp()
        keys: [13]string = .{"", "meditation_music_test_button",
            "settings_tab_device", "settings_tab_audio",
            "settings_section_appearance", "settings_tab_about",
            "tab_habits", "tab_practice", "tab_elist", "tab_profile",
            "settings_title", "practice_configure_button", "back_button"}
        if app == null || action < 0 || action >= cast(s32)keys.count {
            return Vector2.{-1, -1}
        }
        label := LocaleText(keys[action])
        index: s32 = 0
        while index < TreeCount(app.ui.session) {
            node := TreeNodeAt(app.ui.session, index)
            if node.interactive && !node.disabled &&
            ((action == 0 && node.focus_id == 18400) ||
                (action != 0 && node.semantic_label == label)) {
                return WorldToScreen(Vector2.{node.bounds.x + node.bounds.width / 2,
                        node.bounds.y + node.bounds.height / 2}, app.camera)
            }
            index += 1
        }
        return Vector2.{-1, -1}
    }
    #program_export
    app_web_test_music_button_x :: (action: s32) -> s32 {
        return cast(s32)web_test_music_button_target(action).x
    }
    #program_export
    app_web_test_music_button_y :: (action: s32) -> s32 {
        return cast(s32)web_test_music_button_target(action).y
    }
    web_test_control_bounds :: (focus_id: s32) -> Rectangle {
        app := CurrentApp()
        if app == null {
            return Rectangle.{}
        }
        index: s32 = 0
        while index < TreeCount(app.ui.session) {
            node := TreeNodeAt(app.ui.session, index)
            if node.kind == WidgetKindDropdown && node.focus_id == focus_id {
                top := WorldToScreen(Vector2.{node.bounds.x, node.bounds.y}, app.camera)
                bottom := WorldToScreen(Vector2.{node.bounds.x + node.bounds.width,
                        node.bounds.y + node.bounds.height}, app.camera)
                return Rectangle.{top.x, top.y, bottom.x - top.x, bottom.y - top.y}
            }
            index += 1
        }
        return Rectangle.{}
    }
    #program_export
    app_web_test_control_x :: (focus_id: s32) -> s32 {
        return cast(s32)web_test_control_bounds(focus_id).x
    }
    #program_export
    app_web_test_control_y :: (focus_id: s32) -> s32 {
        return cast(s32)web_test_control_bounds(focus_id).y
    }
    #program_export
    app_web_test_control_width :: (focus_id: s32) -> s32 {
        return cast(s32)web_test_control_bounds(focus_id).width
    }
    #program_export
    app_web_test_control_height :: (focus_id: s32) -> s32 {
        return cast(s32)web_test_control_bounds(focus_id).height
    }
    #program_export
    app_web_test_enable_extension_breaks :: (limit_s: s32) {
        app: *InnerBreeze = CurrentApp()
        timer: *BreakTimer
        if app == null || app_web_extension_host() == 0 {
            return
        }
        app.breaks_enabled = 1
        timer = *app.breaks.timers[BREAK_REST]
        timer.enabled = 1
        timer.limit_s = ifx (limit_s > 0) then (limit_s) else (60)
        timer.duration_s = 60
        timer.postpone_s = 300
        timer.max_prompts = 1
        timer.show_skip = 1
        timer.show_postpone = 1
        save_settings(app)
    }
}
