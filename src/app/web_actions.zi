app_close_modal :: (app: *InnerBreeze) #foreign c;
app_switch_screen :: (app: *InnerBreeze, screen: s32) #foreign c;
app_current_route :: (app: *InnerBreeze) -> AppRoute #foreign c;
// Hooks that change the screen run between frames, so they report the change
// here; otherwise the next frame's URL sync would switch the screen back.
app_observe_direct_route_change :: (app: *InnerBreeze, before: AppRoute) #foreign c;
app_update_app_navigation :: (app: *InnerBreeze) #foreign c;

