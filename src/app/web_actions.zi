#if #defined(PLATFORM_WEB) {
    web_test_source_account: SyncAccount;
    web_test_public_key: [1312] u8;
    web_test_private_key: [2560] u8;
    web_test_sync_key_import_status: s32;
    web_test_completed_session: [FS_PATH_MAX] u8;
    web_test_completion_stage: s32;
    #program_export
    app_web_test_complete_practice :: () -> s32 {
        app: *InnerBreeze = CurrentApp()
        if app == null {
            return 0
        }
        web_test_completion_stage = 1
        app.meditation.duration_mode = 5
        app.meditation.custom_minutes = 1
        app.meditation.show_extend_controls = 0
        app.breathing.play_in_background = 1
        app_web_launch_practice(EXERCISE_MEDITATION)
        web_test_completion_stage = 2
        practice_active_advance_elapsed(app, 1000)
        app.session_paused = 1
        practice_active_advance_elapsed(app, 30000)
        if app.meditation.remaining_seconds != 59 {
            return 0
        }
        web_test_completion_stage = 3
        app.session_paused = 0
        practice_active_advance_elapsed(app, 59000)
        if app.session_result.active == 0 || app.session_result.saved == 0 {
            return 0
        }
        web_test_completion_stage = 4
        AppCopyText(AppTextFromCString(*app.session_result.path[0], FS_PATH_MAX),
            web_test_completed_session[:])
        storage_set_setting_text("test_completed_session",
            AppTextFromCString(*web_test_completed_session[0], FS_PATH_MAX))
        app.session_result.mood = 4
        session_result_done(app)
        web_test_completion_stage = ifx (app.session_result.active != 0) then (5) else (6)
        sync_web_storage_critical()
        return cast(s32)(app.session_result.active == 0)
    }
    #program_export
    app_web_test_completion_stage :: () -> s32 {
        return web_test_completion_stage
    }
    #program_export
    app_web_test_completed_practice_persisted :: () -> s32 {
        checkin: SessionMoodCheckin
        path: string = storage_get_setting_text("test_completed_session")
        return cast(s32)(path.count > 0 &&
            storage_load_session_checkin(path, *checkin) != 0 &&
            checkin.mood_after == 4)
    }
    web_test_make_sync_account :: (account: *SyncAccount) {
        if account == null {
            return
        }
        {
            i: s64 = 0
            while i < size_of(type_of(web_test_public_key)) {
                web_test_public_key[i] = cast(u8)(i * 31 + 7)
                i += 1
            }
        }
        {
            i: s64 = 0
            while i < size_of(type_of(web_test_private_key)) {
                web_test_private_key[i] = cast(u8)(i * 17 + 3)
                i += 1
            }
        }
        SyncCryptoSha256Hex(*web_test_public_key[0], size_of(type_of(web_test_public_key)),
            *account.public_id[0])
        unused SyncCryptoBytesToHex(*web_test_public_key[0], size_of(type_of(web_test_public_key)),
            *account.public_key_hex[0],
            size_of(type_of(account.public_key_hex)))
        unused SyncCryptoBytesToHex(*web_test_private_key[0], size_of(type_of(web_test_private_key)),
            *account.private_key_hex[0],
            size_of(type_of(account.private_key_hex)))
    }
    web_test_first_run_guide_expected :: (app: *InnerBreeze) -> bool {
        return app != null  && app.tutorial_seen == 0  && app.modal.active == 0  && app.exercise_type != EXERCISE_SUN_SALUTATION  && app.breathing.screen == ScreenStart  && app.main_tab != APP_MAIN_TAB_NONE
    }
    web_test_save_onboarding_settings :: (app: *InnerBreeze) {
        if app == null {
            return
        }
        storage_settings_begin_write()
        storage_set_setting_text("language",
            ifx (app.language_selected != 0 && app.language_system == 0  && app.language[0] != #char "\0") then (AppTextFromCString(*app.language[0], 16)) else (""))
        storage_set_setting_int("language_setup_done",
            ifx (app.language_selected != 0) then (1) else (0))
        storage_set_setting_int("tutorial_seen",
            ifx (app.tutorial_seen != 0) then (1) else (0))
        storage_set_setting_int("tutorial_step", app.tutorial_step)
        storage_set_setting_int("habits_guide_seen",
            ifx (app.habits_guide_seen != 0) then (1) else (0))
        storage_set_setting_int("main_tab", app.main_tab)
        storage_settings_end_write()
    }
    #program_export
    app_web_get_play_in_background :: () -> s32 {
        app: *InnerBreeze = CurrentApp()
        return cast(s32)(app != null && app.breathing.play_in_background != 0)
