        app.backgrounded = ifx (active != 0) then (1) else (0)
    }
    #program_export
    app_web_background_tick :: (elapsed_ms: s32) {
        app: *InnerBreeze = CurrentApp()
        if app == null || elapsed_ms <= 0 {
            return
        }
        app.backgrounded = 1
        practice_active_advance_elapsed(app, elapsed_ms)
    }
    #program_export
    app_web_launch_practice :: (practice_id: s32) {
        app: *InnerBreeze = CurrentApp()
        practice: *PracticeDefinition
        if app == null {
            return
        }
        before := app_current_route(app)
        app.exercise_type = practice_clamp_id(practice_id)
        app.main_tab = APP_MAIN_TAB_PRACTICE
        app.practice_tab = PRACTICE_TAB_PLAY
        if app.modal.active != 0 {
            app_close_modal(app)
        }
        practice = practice_get(app.exercise_type)
        if practice.start != null {
            practice.start(app)
        }
        app_observe_direct_route_change(app, before)
    }
