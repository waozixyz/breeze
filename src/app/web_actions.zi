    web_test_rect_valid :: (rect: Rectangle) -> bool {
        return rect.width > 0.0f && rect.height > 0.0f
    }
    web_test_first_run_guide_action_anchor_zero_rect: Rectangle;

    web_test_first_run_guide_action_anchor :: (app: *InnerBreeze) -> Rectangle {
        manual: Rectangle
        config: Rectangle
        anchor: Rectangle
        manual_valid: bool
        config_valid: bool
        right: float32
        bottom: float32
        config_right: float32
        config_bottom: float32
        if app == null {
            return web_test_first_run_guide_action_anchor_zero_rect
        }
        manual = app.practice_home_bounds_manual
        config = app.practice_home_bounds_config
        manual_valid = web_test_rect_valid(manual)
        config_valid = web_test_rect_valid(config)
        if !manual_valid {
            return ifx (config_valid) then (config) else (web_test_first_run_guide_action_anchor_zero_rect)
        }
        if !config_valid {
            return manual
        }
        anchor = manual
        if config.x < anchor.x {
            anchor.x = config.x
        }
        if config.y < anchor.y {
            anchor.y = config.y
        }
        right = manual.x + manual.width
        bottom = manual.y + manual.height
        config_right = config.x + config.width
        config_bottom = config.y + config.height
        if config_right > right {
            right = config_right
        }
        if config_bottom > bottom {
            bottom = config_bottom
        }
        anchor.width = right - anchor.x
        anchor.height = bottom - anchor.y
        return anchor
    }
    #program_export
    app_web_test_first_run_guide_anchor_x :: () -> s32 {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(CurrentApp())
        return cast(s32)anchor.x
    }
    #program_export
    app_web_test_first_run_guide_anchor_y :: () -> s32 {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(CurrentApp())
        return cast(s32)anchor.y
    }
    #program_export
    app_web_test_first_run_guide_anchor_w :: () -> s32 {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(CurrentApp())
        return cast(s32)anchor.width
    }
    #program_export
    app_web_test_first_run_guide_anchor_h :: () -> s32 {
        anchor: Rectangle = web_test_first_run_guide_action_anchor(CurrentApp())
        return cast(s32)anchor.height
    }
    #program_export
    app_web_test_sync_key_state :: () -> s32 {
        source: *SyncAccount = *web_test_source_account
        if web_test_sync_key_import_status != 1 {
            return web_test_sync_key_import_status
        }
        if ValidateSyncAccount(source) == 0 {
            return -10
        }
        return 1
    }
    #program_export
    app_web_test_import_sync_key :: () {
        source: *SyncAccount = *web_test_source_account
        web_test_sync_key_import_status = 0
        data_init()
        web_test_make_sync_account(source)
        if ValidateSyncAccount(source) == 0 {
            web_test_sync_key_import_status = -1
            return
        }
        storage_settings_begin_write()
        storage_set_setting_text("sync_public_id",
            AppTextFromCString(*source.public_id[0], SYNC_PUBLIC_ID_HEX_SIZE))
        storage_set_setting_text("sync_public_key",
            AppTextFromCString(*source.public_key_hex[0], SYNC_PUBLIC_KEY_HEX_SIZE))
        storage_set_setting_text("sync_private_key",
            AppTextFromCString(*source.private_key_hex[0], SYNC_PRIVATE_KEY_HEX_SIZE))
        storage_set_setting_text("sync_account_alias", "")
        storage_set_sync_enabled(0)
        storage_settings_end_write()
        web_test_sync_key_import_status = 1
    }
    web_test_habits_click_target :: () -> Vector2 {
        app := CurrentApp()
        if app == null || app.breathing.screen != ScreenHabits {
            return Vector2.{-1, -1 }
        }
        bounds := habits_first_day_bounds
        if !web_test_rect_valid(bounds) {
            return Vector2.{-1, -1 }
        }
        return WorldToScreen(Vector2.{bounds.x + bounds.width / 2,
                bounds.y + bounds.height / 2}, app.camera)
    }
    #program_export
    app_web_test_habits_click_x :: () -> s32 {
        target := web_test_habits_click_target()
        return cast(s32)target.x
    }
    #program_export
    app_web_test_habits_click_y :: () -> s32 {
        target := web_test_habits_click_target()
        return cast(s32)target.y
    }
