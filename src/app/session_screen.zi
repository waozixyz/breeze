#import, file "app_types.zi";
#import, file "../core/types.zi";

// Whether a screen shows a running practice.
app_is_session_screen :: (screen: s32) -> bool {
    return screen == ScreenSession || screen == ScreenMeditation ||
        screen == ScreenSunSalutation || screen == ScreenPatterns
}

// The running practice's screen: the current screen, or the practice that
// keeps running in its small window while another app is open.
app_session_screen :: (app: *InnerBreeze) -> s32 {
    if app == null {
        return ScreenStart
    }
    if app.session_window.screen != ScreenStart {
        return app.session_window.screen
    }
    return app.breathing.screen
}
