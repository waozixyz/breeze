    key == "profile_no_leaderboard_data" || key == "profile_updating_status" {
        return LocaleText(key)
    }
    if key == "achievements_title" || (key.count >= 12 && key[:12] == "achievement_") {
        return LocaleText(key)
    }
    if key == "entity.title" { return LocaleText("tab_profile") }
    if key == "entity.name_placeholder" { return LocaleText("profile_name_label") }
    if key == "entity.name" { return LocaleText("profile_name_label") }
    if key == "entity.intention" { return LocaleText("profile_intention_label") }
    if key == "entity.nodes" { return LocaleText("sync_nodes_title") }
    if key == "entity.node_address" { return LocaleText("sync_remote_label") }
    if key == "entity.add" { return LocaleText("sync_nodes_add") }
    if key == "entity.remove" { return LocaleText("launcher_uninstall") }
    if key == "entity.picture" { return LocaleText("profile_picture_title") }
    if key == "entity.change_picture" { return LocaleText("profile_change_picture") }
    if key == "entity.done" { return LocaleText("done_button") }
    if key == "entity.node_invalid" { return LocaleText("sync_server_url_invalid") }
    if key == "entity.node_limit" { return LocaleText("sync_nodes_limit") }
    if key == "entity.account" { return LocaleText("sync_account_title") }
    if key == "entity.manage_account" { return LocaleText("sync_account_title") }
    if key == "entity.connect_account" { return LocaleText("sync_connect_account_button") }
    if key == "entity.account_local" { return LocaleText("sync_no_account") }
    if key == "entity.public_id" { return LocaleText("sync_public_id_label") }
    if key == "entity.copy_id" { return LocaleText("sync_copy_id_button") }
    if key == "entity.copied" { return LocaleText("sync_public_id_copied") }
    if key == "entity.alias" { return LocaleText("sync_alias_title") }
    if key == "entity.save" { return LocaleText("save_button") }
    if key == "entity.sync" { return LocaleText("sync_status_title") }
    if key == "entity.sync_now" { return LocaleText("sync_now_button") }
    if key == "entity.backup_key" { return LocaleText("sync_backup_title") }
    if key == "entity.create_account" { return LocaleText("sync_create_account_button") }
    if key == "entity.import_key" { return LocaleText("sync_import_key_dialog_title") }
    if key == "entity.logout" { return LocaleText("sync_logout_button") }
    if key == "entity.clear_remote" { return LocaleText("sync_clear_remote_data_button") }
    if key == "entity.switch_account" { return LocaleText("sync_account_switch_title") }
    if key == "entity.merge" { return LocaleText("sync_account_switch_merge_button") }
    if key == "entity.replace" { return LocaleText("sync_account_switch_clear_button") }
    if key == "entity.cancel" { return LocaleText("cancel_button") }
    if key == "entity.back" { return LocaleText("back_button") }
    if key == "entity.choose_file" { return LocaleText("sync_import_key_button") }
    if key == "entity.passphrase" { return LocaleText("telegram_account_passphrase") }
    if key == "entity.logout_help" { return LocaleText("sync_logged_out_local_data_kept") }
    if key == "entity.clear_remote_help" { return LocaleText("sync_clear_remote_data_message") }
    if key == "entity.switch_help" { return LocaleText("sync_account_switch_message") }
    if key == "entity.key_file_help" { return LocaleText("sync_backup_warning") }
    if key == "entity.working" { return LocaleText("device_link_working") }
    if key == "entity.connect_device" { return LocaleText("device_link_title") }
    if key == "entity.connect" { return LocaleText("device_link_connect") }
    if key == "entity.scan_code" { return LocaleText("device_link_scan") }
    if key == "entity.show_code" { return LocaleText("device_link_show") }
    if key == "entity.confirm_device" { return LocaleText("device_link_connect") }
    if key == "entity.cancel_connection" { return LocaleText("cancel_button") }
    if key == "entity.active_node" { return LocaleText("profile_node_storage_active") }
    if key == "entity.storage_unknown" { return LocaleText("profile_node_storage_unknown") }
    if key == "entity.storage_used_of" { return LocaleText("profile_node_storage_used_of") }
    if key == "entity.storage_used_unlimited" { return LocaleText("profile_node_storage_used_unlimited") }
    if key == "entity.storage_full" { return LocaleText("profile_node_storage_full") }
    if key == "entity.node_media" { return LocaleText("profile_node_storage_media") }
    if key == "entity.manage_data" { return LocaleText("profile_manage_data") }
