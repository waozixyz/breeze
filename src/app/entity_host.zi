    if key == "profile_accept_friend" { return LocaleText("profile_friend_accept_button") }
    if key == "profile_decline_friend" { return LocaleText("profile_friend_decline_button") }
    if key == "profile_remove_friend" { return LocaleText("remove_button") }
    // The shared Dew card reads Inner Breeze's own Dew strings.
    if key.count > 12 && key[:12] == "profile_dew_" { return LocaleText(key) }
    return key
}

EntityHostCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    app := cast(*InnerBreeze)context
    name := TextFromCString(function)
    if name == "ClipboardCopyHost" && count == 2 {
        result.* = HostScalar("bool", ifx TextInputWriteClipboard(AppArgumentText(arguments[0])) then 1 else 0)
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == LEADERBOARD_SERVICE {
        result.* = EntityHostText(InbeLeaderboardSnapshot(app, AppArgumentText(arguments[1])))
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.referrals" {
        Referrals.EntityReferralsConnect(InbeReferralClient, context)
        result.* = EntityHostText(Referrals.EntityReferralsAnswer(AppArgumentText(arguments[1])))
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.friends" {
        result.* = EntityHostText(EntityFriendsAnswer(app, AppArgumentText(arguments[1])))
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.telegram" {
        result.* = EntityHostText(EntityTelegramAnswer(AppArgumentText(arguments[1])))
        return 1
    }
    if AchievementEntityCall(cast(*void)app, name, arguments, count, result) {
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.dew" && DewAvailable() {
        request := AppArgumentText(arguments[1])
        result.* = EntityHostText(ifx request == "" then InbeEntityDew() else ifx DewRequestRefresh(request) then "queued" else "rejected")
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.activity" {
        result.* = EntityHostText(InbeEntityActivity())
        return 1
    }
    if name == "AppServiceHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.management" {
        InbeManagementStart(app)
        request := AppArgumentText(arguments[1])
        if request == "" {
            Provider.ProviderRefresh(*entity_management)
            result.* = EntityHostText(entity_management.document)
        } else {
            result.* = EntityHostText(ifx Provider.ProviderEnqueue(*entity_management, request) then "queued" else "rejected")
        }
        return 1
    }
    if name == "AppLocaleHost" && count == 1 {
        result.* = EntityHostText(EntityHostLocale(AppArgumentText(arguments[0])))
        return 1
    }
    if name == "ClipboardCopyHost" && count == 2 {
        result.* = HostScalar("bool", ifx TextInputWriteClipboard(AppArgumentText(arguments[0])) then 1 else 0)
        return 1
    }
    if (name == "ReadStoreHost" || name == "WriteStoreHost") && count == 2 &&
    (AppArgumentText(arguments[0]) == "referral-pending.txt" || AppArgumentText(arguments[0]) == "referral-suggestion.txt") {
        path: [4096]u8
        file := Shared.NativeJoin(path[:], data_root(), AppArgumentText(arguments[0]))
        if name == "WriteStoreHost" {
            value := AppArgumentText(arguments[1])
            saved := (value == "-" || ReferralModel.ReferralToken(value)) && Shared.NativeWrite(file, value)
            result.* = HostScalar("bool", ifx saved then 1 else 0)
        } else {
            bytes: [129]u8
            read := Shared.NativeRead(file, bytes[:])
            if read < 0 { read = 0 }
            output := arguments[1]
            if output.kind != cast(s32)HostValueKind.HostSlice || output.elements == null || output.length <= cast(usize)read { return 0 }
            for index: 0..read {
                byte := ifx index < read then bytes[index] else cast(u8)0
                output.elements[index].bits = cast(u64)byte
                output.elements[index].integer = cast(s64)byte
            }
            result.* = HostScalar("s32", read)
        }
        return 1
    }
    if name == "ReadStoreHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.json" {
        document := InbeEntityRead(app)
        output := arguments[1]
        if output.kind != cast(s32)HostValueKind.HostSlice || output.elements == null || output.length <= cast(usize)document.count { return 0 }
        for index: 0..document.count {
            byte := ifx index < document.count then document[index] else cast(u8)0
            output.elements[index].bits = cast(u64)byte
            output.elements[index].integer = cast(s64)byte
        }
        result.* = HostScalar("s32", document.count)
        return 1
    }
    if name == "WriteStoreHost" && count == 2 && AppArgumentText(arguments[0]) == "entity.json" {
        result.* = HostScalar("bool", ifx InbeEntityWrite(app, AppArgumentText(arguments[1])) then 1 else 0)
        return 1
    }
    return 0
}

EntityHostAssetAllowed :: (path: string) -> bool {
    return path == "" || path == "assets/entity/pfp.webp" || path == "assets/entity/flowers.webp" ||
    path == "assets/entity/abstract-jade.webp" || path == "assets/entity/abstract-amber.webp" || path == "assets/entity/abstract-violet.webp"
}

EntityHostRoute :: (app: *InnerBreeze) -> bool {
    return app.profile_view == PROFILE_VIEW_SYNC_ACCOUNT ||
    (app.profile_view == PROFILE_VIEW_MAIN &&
        (app.profile_tab == PROFILE_TAB_OVERVIEW || app.profile_tab == PROFILE_TAB_SYNC))
}

// Keep owner checks and cancellation running even after Profile is closed.
EntityHostReferralPump :: (app: *InnerBreeze) {
    unused Referrals.EntityReferralsSource(ifx ReferralPayment.DewPlayEdition() then "play" else "direct", "breeze")
    Referrals.EntityReferralsConnect(InbeReferralClient, cast(*void)app)
    Referrals.EntityReferralsPump()
}

EntityHostFrame :: (app: *InnerBreeze, bounds: Rectangle) -> bool {
    if entity_inner_breeze { return false }
    if !entity_opened {
        bundle := AssetRead("assets/entity/bundles/entity.zx")
        if !bundle.found { return false }
        entity_context.expected_id = "entity"
        entity_context.context = cast(*void)app
        entity_context.allows = EntityHostAllows
        entity_context.services = EntityHostCall
        entity_context.widgets = WidgetHostCall
        if !AppContextOpen(*entity_context, bundle.data) { return false }
        entity_opened = true
    }
    InbeManagementPump(app)
    EntityHostReferralPump(app)
    typed: [1024]u8
    if entity_reload_after_route {
        entity_context.command = "reload"
        unused AppContextRun(*entity_context, Portable.APP_COMMAND)
        entity_reload_after_route = false
    }
    account_route := app.profile_view == PROFILE_VIEW_SYNC_ACCOUNT || app.profile_tab == PROFILE_TAB_SYNC
    if account_route && !entity_account_route {
        entity_context.command = "account"
        unused AppContextRun(*entity_context, Portable.APP_COMMAND)
    }
    entity_account_route = account_route
    if entity_leaderboard_route {
        entity_context.command = "leaderboard"
        unused AppContextRun(*entity_context, Portable.APP_COMMAND)
        entity_leaderboard_route = false
    }
    if entity_referral_route {
        out: Vec(u8)
        BuilderPrint(*out, "referrals:%", TextUntilNul(entity_referral_code[:]))
        next := BuilderFinish(out)
        entity_context.command = ""
        Entity.EntityFree(entity_referral_command)
        entity_referral_command = next
        entity_context.command = entity_referral_command
        unused AppContextRun(*entity_context, Portable.APP_COMMAND)
        entity_context.command = ""
        entity_referral_route = false
        entity_referral_code = .{}
    }
    entity_context.session = app.ui.session
    entity_context.bounds = bounds
    entity_context.dark = app.dark_mode != 0
    entity_context.scale = MetricsScale()
    entity_context.font = AppFontSize()
    entity_context.input = SampleTextFieldInput(true, typed[:])
    WidgetHostBegin(app.ui.session, EntityHostAssetAllowed)
    ran := AppContextRun(*entity_context, Portable.APP_FRAME)
    WidgetHostEnd()
    entity_context.input = .{}
    InbeManagementPump(app)
    EntityHostReferralPump(app)
    if !ran { return false }
    route := entity_context.reply
    // The Dew card's buttons open Inner Breeze's own windows over Profile.
    if route == "dew-topup" && DewTopUpAvailable() { ProfileTopUpOpen(app); return true }
    if route == "dew-plans" && DewAvailable() { ProfileStoragePlansOpen(app); return true }
    if route == "dew-data" { route = "data" }
    if route != "" { entity_reload_after_route = true }
    if route == "inbe" { entity_inner_breeze = true; app.profile_scroll = 0 }
    else if route == "account" { app.profile_tab = PROFILE_TAB_SYNC; app.profile_scroll = 0 }
    else if route == "data" { app.profile_tab = PROFILE_TAB_DATA; app.profile_scroll = 0 }
    else if route == "telegram" { app.profile_tab = PROFILE_TAB_TELEGRAM; app.profile_scroll = 0 }
    else if route == "dew" && DewAvailable() { app.profile_view = PROFILE_VIEW_DEW; app.profile_scroll = 0 }
    return true
}

// The shared page owns its internal navigation; ask for its current title
// after a frame instead of deriving it from Breeze's unchanged Profile tab.
entity_page_title: [256]u8;
EntityHostTitle :: (fallback: string) -> string {
    if !entity_opened || entity_inner_breeze { return fallback }
    entity_context.command = "page-title"
    if !AppContextRun(*entity_context, Portable.APP_COMMAND) ||
    entity_context.reply == "" || !CopyCString(entity_context.reply, entity_page_title[:]) {
        return fallback
    }
    return TextUntilNul(entity_page_title[:])
}

EntityHostBack :: (app: *InnerBreeze) -> bool {
    if app.profile_view == PROFILE_VIEW_DEW {
        app.profile_view = PROFILE_VIEW_MAIN
        app.profile_tab = PROFILE_TAB_OVERVIEW
        entity_reload_after_route = true
        return true
    }
    if entity_opened && !entity_inner_breeze && EntityHostRoute(app) {
        entity_context.command = "back"
        unused AppContextRun(*entity_context, Portable.APP_COMMAND)
        if entity_context.reply == "handled" {
            if entity_account_route {
                app.profile_view = PROFILE_VIEW_MAIN
                app.profile_tab = PROFILE_TAB_OVERVIEW
                entity_account_route = false
            }
            return true
        }
    }
    if !entity_inner_breeze || app.profile_view != PROFILE_VIEW_MAIN || app.profile_tab != PROFILE_TAB_OVERVIEW { return false }
    entity_inner_breeze = false
    return true
}

EntityHostSave :: (app: *InnerBreeze) -> bool {
    if !entity_opened || entity_inner_breeze || app.breathing.screen != ScreenProfile ||
    !EntityHostRoute(app) { return true }
    return AppContextRun(*entity_context, Portable.APP_SAVE)
}

EntityHostReset :: () {
    Referrals.EntityReferralsReset()
    entity_inner_breeze = false
    entity_account_route = false
    entity_reload_after_route = true
    entity_leaderboard_route = false
    entity_referral_route = false
    entity_referral_code = .{}
}

entity_referral_route: bool;
entity_referral_code: [129]u8;
entity_referral_command: string;

// A handoff only opens Entity's review UI. Entity owns acceptance and policy.
#program_export
EntityHostOpenReferrals :: (app: *InnerBreeze, invitation: string) -> bool {
    code: [129]u8
    if invitation.count > 0 && !ReferralModel.ReferralCodeFromLink(invitation, code[:]) { return false }
    entity_inner_breeze = false
    entity_account_route = false
    entity_referral_code = code
    entity_referral_route = true
    app.profile_view = PROFILE_VIEW_MAIN
    app.profile_tab = PROFILE_TAB_OVERVIEW
    app.profile_scroll = 0
    return true
}

#program_export
EntityHostOpenLeaderboard :: () {
    entity_leaderboard_route = true
}
