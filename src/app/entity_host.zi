// A profile reads the host's busy flag without importing the sync engine.
c :: #system_library "c";
EntitySyncLoading :: () -> s32 #foreign c "app_sync_loading";

entity_context: AppContext;
entity_opened: bool;
entity_document: string;
entity_inner_breeze: bool;
entity_reload_after_route: bool;
entity_account_route: bool;
entity_snapshot: string;
entity_leaderboard_route: bool;

InbeEntityRead :: (app: *InnerBreeze) -> string {
    Entity.EntityFree(entity_document)
    state := Entity.EntityDefault()
    // Name and Intention stay stored but Profile no longer edits them.
    state.controls = Entity.ENTITY_NODES
    state.pictures &= ~((1 << 21) | (1 << 22) | (1 << 23))
    state.name = app.profile_display_name
    state.intention = app.profile_intention
    icon := app.profile_picture_icon
    state.picture = ifx icon >= 124 && icon <= 126 then 25 + icon - 124 else icon - 41
    if state.picture < 0 || state.picture > 27 { state.picture = 0 }
    count := SyncNodeCount()
    if count > 0 {
        state.node_count = count
        preferred: [256]u8
        unused CopyCString(storage_get_setting_text("sync_preferred_node"), preferred[:])
        if preferred[0] == cast(u8)0 { unused CopyCString(storage_get_setting_text("sync_server_url"), preferred[:]) }
        for index: 0..count - 1 {
            address := SyncNodeAt(cast(s32)index)
            unused CopyCString(address, state.nodes[index][:])
            if address == TextUntilNul(preferred[:]) { state.preferred = cast(s32)index }
            Entity.EntityFree(address)
        }
    }
    owner: [65]u8
    unused InbeEntityOwner(owner[:])
    state.owner_id = owner
    if StoredAccountMode() != AccountModeDelegate {
        unused Shared.SharedProfileLoad(TextUntilNul(owner[:]), *state)
    }
    state.host_navigation = true
    Entity.EntityAddExtension(*state, "account", LocaleText("sync_account_title"))
    // The Dew card holds the balance, storage plans and data management;
    // builds without Dew keep Data as its own row.
    if !DewAvailable() { Entity.EntityAddExtension(*state, "data", LocaleText("profile_data")) }
    Entity.EntityAddExtension(*state, "friends", LocaleText("profile_friends_title"))
    Entity.EntityAddExtension(*state, "telegram", "Telegram")
    Entity.EntityAddExtension(*state, "achievements", LocaleText("achievements_title"))
    entity_document = Entity.EntityEncode(state)
    return entity_document
}

InbeEntityWrite :: (app: *InnerBreeze, document: string) -> bool {
    state: Entity.EntityState
    if !Entity.EntityDecode(document, *state) { return false }
    owner: [65]u8
    unused InbeEntityOwner(owner[:])
    if TextUntilNul(state.owner_id[:]) != TextUntilNul(owner[:]) { return false }
    picture := ifx state.picture >= 25 then 124 + state.picture - 25 else 41 + state.picture
    if !ProfilePictureValid(picture) { return false }
    for byte: state.name { if byte == cast(u8)10 || byte == cast(u8)13 { return false } }
    for byte: state.intention { if byte == cast(u8)10 || byte == cast(u8)13 { return false } }
    // Existing node operations retain per-node cursors and do not opt an
    // account into synchronization.
    for index: 0..state.node_count - 1 {
        if !SyncNodeAdd(TextUntilNul(state.nodes[index][:])) { return false }
    }
    preferred := TextUntilNul(state.nodes[state.preferred][:])
    current: [256]u8
    unused CopyCString(storage_get_setting_text("sync_server_url"), current[:])
    if preferred != TextUntilNul(current[:]) && !SyncNodePrefer(preferred) { return false }
    index := SyncNodeCount() - 1
    while index >= 0 {
        address := SyncNodeAt(index)
        retained := false
        for next: 0..state.node_count - 1 {
            if address == TextUntilNul(state.nodes[next][:]) { retained = true }
        }
        Entity.EntityFree(address)
        if !retained && !SyncNodeRemove(index) { return false }
        index -= 1
    }
    if StoredAccountMode() != AccountModeDelegate && !Shared.SharedProfileSave(TextUntilNul(owner[:]), state) {
        return false
    }
    app.profile_display_name = state.name
    app.profile_intention = state.intention
    app.profile_picture_icon = picture
    save_settings(app)
    return true
}

EntityHostAllows :: (context: *void, name: string) -> bool {
    return name == "ReadStoreHost" || name == "WriteStoreHost" ||
    name == "AppLocaleHost" || name == "ClipboardCopyHost" ||
    name == "AppServiceHost" || name == "entity.management" || name == "entity.text_height" ||
    name == "entity.achievements" || name == "entity.activity" || name == LEADERBOARD_SERVICE || (name == "entity.dew" && DewAvailable())
}

// The node-confirmed Dew account and Inner Breeze's own summaries for the
// shared balance card; its buttons come back as dew-* routes.
InbeEntityDew :: () -> string {
    DewContext()
    Entity.EntityFree(entity_snapshot)
    out: Vec(u8)
    BuilderPrint(*out, "{\"sequence\":%,\"busy\":%,\"available\":%,\"error\":%,\"host_actions\":true,\"manage_data\":true,\"top_up\":%,\"owner\":",
        cast(s64)dew_sequence, ifx DewBusy() then "true" else "false",
        ifx DewReady() then "true" else "false", ifx dew_notice != "" then "true" else "false",
        ifx DewTopUpAvailable() then "true" else "false")
    Entity.EntityQuote(*out, storage_get_setting_text("sync_public_id"))
    account := TextUntilNul(dew_account_json[:])
    if dew_account.known && account != "" {
        DewRatesRefresh()
        BuilderPrint(*out, ",\"account\":%", account)
        // Dew alone: money values show only where Dew is topped up.
        line: [256]u8
        size: [24]u8
        if ProfileDewCurrentSize() > 0 {
            ProfileDewSizeText(dew_account.limit_bytes, size[:])
            arguments: [2]FormatArg = .[FormatArg.{.text = TextUntilNul(size[:]), .is_text = true},
            FormatArg.{.number = ProfileDewDaysLeft()}]
            unused FormatTemplate(LocaleText("profile_dew_paid"), arguments[:], line[:])
        } else {
            free := ifx dew_account.free_bytes > 0 then dew_account.free_bytes else dew_account.limit_bytes
            if free > 0 {
                ProfileDewSizeText(free, size[:])
                arguments: [1]FormatArg = .[FormatArg.{.text = TextUntilNul(size[:]), .is_text = true}]
                unused FormatTemplate(LocaleText("profile_dew_free"), arguments[:], line[:])
            } else {
                unused AppCopyText(LocaleText("profile_dew_plan_free"), line[:])
            }
        }
        BuilderPrint(*out, ",\"plan_summary\":")
        Entity.EntityQuote(*out, TextUntilNul(line[:]))
        if dew_account.limit_bytes > 0 {
            used: [32]u8
            limit: [32]u8
            unused SyncStorageFormatBytes(dew_account.used_bytes, used[:])
            unused SyncStorageFormatBytes(dew_account.limit_bytes, limit[:])
            arguments: [2]FormatArg = .[FormatArg.{.text = TextUntilNul(used[:]), .is_text = true},
            FormatArg.{.text = TextUntilNul(limit[:]), .is_text = true}]
            line = .{}
            unused FormatTemplate(LocaleText("profile_node_storage_used_of"), arguments[:], line[:])
            BuilderPrint(*out, ",\"usage_summary\":")
            Entity.EntityQuote(*out, TextUntilNul(line[:]))
        }
    } else {
        BuilderPrint(*out, ",\"account\":null")
    }
    BuilderPrint(*out, "}")
    entity_snapshot = BuilderFinish(out)
    return entity_snapshot
}

// Today's habits and this week's practice, shown on Profile only in Inner Breeze.
InbeEntityActivity :: () -> string {
    today := habits_today_index()
    due: s32 = 0
    done: s32 = 0
    app := CurrentApp()
    if app != null {
        for index: 0..app.habits.count - 1 {
            if habit_scheduled_day(*app.habits.items[index], today) != 0 {
                due += 1
                if habit_completed_day(*app.habits.items[index], today) != 0 { done += 1 }
            }
        }
    }
    active_days: s32
    sessions: s32
    unused storage_profile_week_stats(today, *active_days, *sessions)
    loading := EntitySyncLoading() != 0
    values: [3][24]u8
    if loading {
        for index: 0..2 { unused AppCopyText("…", values[index][:]) }
    } else {
        unused FormatTwoNumberTemplate("%d/%d", done, due, values[0][:])
        unused AppFormatS32(active_days, values[1][:])
        unused AppFormatS32(sessions, values[2][:])
    }
    labels: [3]string = .["profile_today_short", "profile_active_days_short", "profile_sessions_short"]
    icons: [3]string = .["today", "days", "sessions"]
    Entity.EntityFree(entity_snapshot)
    out: Vec(u8)
    BuilderPrint(*out, "{\"stats\":[")
    for index: 0..2 {
        BuilderPrint(*out, "%{\"label\":", ifx index > 0 then "," else "")
        Entity.EntityQuote(*out, LocaleText(labels[index]))
        BuilderPrint(*out, ",\"value\":")
        Entity.EntityQuote(*out, TextUntilNul(values[index][:]))
        BuilderPrint(*out, ",\"icon\":\"%\"}", icons[index])
    }
    BuilderPrint(*out, "]}")
    entity_snapshot = BuilderFinish(out)
    return entity_snapshot
}

EntityHostText :: (text: string) -> HostValue {
    return HostValue.{.kind = cast(s32)HostValueKind.HostString, .type_name = HostTextData("string"),
        .data = HostTextData(text), .length = cast(usize)text.count}
}

EntityHostLocale :: (key: string) -> string {
