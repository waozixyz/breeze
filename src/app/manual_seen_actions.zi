#import, file "app_settings.zi";
#import, file "app_types.zi";
#import, file "manual_seen.zi";

#program_export
exercise_manual_seen :: (app: *InnerBreeze,
    exercise_type: s32) -> s32 {
    bit := exercise_manual_seen_bit(exercise_type)
    if app == null || bit == 0 { return 1 }
    return ifx (app.exercise_manual_seen_mask & bit) != 0 then 1 else 0
}

#program_export
mark_exercise_manual_seen :: (app: *InnerBreeze,
    exercise_type: s32) {
    bit := exercise_manual_seen_bit(exercise_type)
    if app == null || bit == 0 { return }
    if (app.exercise_manual_seen_mask & bit) == 0 {
        app.exercise_manual_seen_mask |= bit
        save_settings(app)
    }
}
