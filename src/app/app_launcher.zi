app_launcher_update_drag :: (app: *InnerBreeze, point: Vector2) {
    app.launcher_drag_pointer = point
    if !app.launcher_editing { return }
    dx := point.x - app.launcher_drag_origin.x
    dy := point.y - app.launcher_drag_origin.y
    threshold := cast(float32)AppScale(6)
    if dx * dx + dy * dy >= threshold * threshold {
        app.launcher_drag_moving = true
    }
}

// Only the explicit handle captures a drag. The card retains its ordinary
// click and scroll gestures, even after another app has been moved.
app_launcher_drag_handle :: (app: *InnerBreeze, card: ButtonProps,
    route: s32, vertical: bool) {
    if !app.launcher_editing { return }
    key := card.key
    previous := TreePrevious(app.ui.session, TreeCurrentParent(app.ui.session),
        key, WidgetKindButton)
    drag := TreeTakeDragAt(app.ui.session, previous)
    if drag.started {
        app.launcher_drag_key = key
        app.launcher_drag_route = route
        unused AppCopyText(LauncherLibraryName(route), app.launcher_drag_name[:])
        app.launcher_drag_moving = false
        app.launcher_drag_released = false
        app.launcher_drag_vertical = vertical
        app.launcher_drag_bounds = card.bounds
        app.launcher_drag_origin = Vector2.{drag.x, drag.y}
        app.launcher_drag_grab = Vector2.{drag.grab_x, drag.grab_y}
        row := TreePrevious(app.ui.session, TreeCurrentParent(app.ui.session), key - cast(u64)7, WidgetKindButton)
        if row >= 0 {
            app.launcher_drag_bounds = TreeNodeAt(app.ui.session, row).bounds
            app.launcher_drag_grab = Vector2.{drag.x - app.launcher_drag_bounds.x, drag.y - app.launcher_drag_bounds.y}
        }
    }
    if (drag.active || drag.ended) && app.launcher_drag_key == key {
        app_launcher_update_drag(app, Vector2.{drag.x, drag.y})
        app.launcher_drag_released = drag.ended
    }
}

// Negative items refer to offers, so moving an undownloaded app neither
// reserves an installed slot nor starts a download.
LauncherLibraryName :: (item: s32) -> string {
    return ifx item >= 0 then LauncherRouteName(item) else NodeAppOfferName(-item - 2)
}

LauncherLibraryRank :: (order: string, name: string) -> s32 {
    start: s64 = 0
    rank: s32 = 0
    while start < order.count {
        end := start
        while end < order.count && order[end] != cast(u8)44 { end += 1 }
        if order[start:end] == name { return rank }
        rank += 1
        start = end + 1
    }
    return 2147483647
}

LauncherLibrarySort :: (app: *InnerBreeze, items: []s32) {
    order := AppTextFromCString(*app.launcher_library_order[0], 4096)
    for index: cast(s32)1..cast(s32)items.count - 1 {
        item := items[index]
        rank := LauncherLibraryRank(order, LauncherLibraryName(item))
        at := index
        while at > 0 && LauncherLibraryRank(order, LauncherLibraryName(items[at - 1])) > rank {
            items[at] = items[at - 1]
            at -= 1
        }
        items[at] = item
    }
}

LauncherLibraryMove :: (app: *InnerBreeze, items: []s32, item: s32, target: s32) {
    ordered: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]s32
    count: s32 = 0
    for current: items {
        if current != item {
            ordered[count] = current
            count += 1
        }
    }
    if target < 0 { target = 0 }
    if target > count { target = count }
    at := count
    while at > target {
        ordered[at] = ordered[at - 1]
        at -= 1
    }
    ordered[target] = item
    count += 1
    text: Vec(u8)
    for index: cast(s32)0..count - 1 {
        if index > 0 { BuilderPrint(*text, ",") }
        BuilderPrint(*text, "%", LauncherLibraryName(ordered[index]))
    }
    value := BuilderFinish(text)
    unused AppCopyText(value, app.launcher_library_order[:])
    if !DataTemporary() { storage_set_setting_text("launcher_library_order", value) }
    PackageFree(value)
}

// The shared screen retains its widget state; account-owned values are
// copied in and out for the current Inbe profile each frame.
launcher_screen: SharedLauncher.AppLauncherState;
launcher_screen_routes: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]s32;

LauncherScreenCards :: (context: *void, indices: []s32, bounds: Rectangle,
    input: TextFieldInput, section_break: s32, columns: s32) -> bool {
    app := cast(*InnerBreeze)context
    routes: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]s32
    for index: cast(s32)0..cast(s32)indices.count - 1 {
        routes[index] = launcher_screen_routes[indices[index]]
    }
    quiet := app_launcher_cards_quiet(app, PointerSample(app.ui.session), bounds)
    return app_launcher_shared_group(app, 0, routes[:indices.count], bounds,
        input, section_break, columns, launcher_screen.grid, quiet)
}

// Whether the touch or click that is down began on the app cards.
launcher_press_on_cards: bool;

// Nothing reaches the app cards this frame and nothing animates them, so
// the Apps controller may show its last quiet frame again. A tap on the
// bottom bar or the search field stays clear of the cards; a menu or
// dialog the controller showed may cover more than the cards.
app_launcher_cards_quiet :: (app: *InnerBreeze, pointer: PointerFrame, cards: Rectangle) -> bool {
    on_cards := PointInBounds(pointer.x, pointer.y, cards)
    if pointer.pressed {
        launcher_press_on_cards = on_cards
    }
    pressed_on_cards := launcher_press_on_cards
    if !pointer.down && !pointer.pressed {
        launcher_press_on_cards = false
    }
    if app.ui.keyboard_active || app.ui.text_input_active || app.ui.wheel_active ||
    AppSmoothFramesActive() || app.ui.route_transition_pending || app.ui.route_transition_active ||
    app.launcher_drag_key != 0 || app_launcher_overlay_drawn(0) {
        return false
    }
    if !app.ui.pointer_active {
        return true
    }
    return !on_cards && !pressed_on_cards
}

#program_export
app_draw_launcher :: (app: *InnerBreeze, dock_drawn: bool) {
    app.launcher_panel_node = -1
    if !app.launcher_open || app.host_feature != 0 {
        return
    }
    if app.modal.active != 0 {
        app_launcher_close(app)
        return
    }
    app_launcher_open_pending(app)
    if !app.launcher_open {
        return
    }
    pointer := PointerSample(app.ui.session)
    if app.launcher_drag_key != 0 {
        if app.launcher_drag_route < 0 {
            found := false
            for offer: cast(s32)0..NodeAppOfferCount() - 1 {
                if NodeAppOfferName(offer) == AppTextFromCString(*app.launcher_drag_name[0], 25) {
                    app.launcher_drag_route = -offer - 2
                    found = true
                    break
                }
            }
            if !found {
                app.launcher_drag_key = 0
                app.launcher_drag_moving = false
            }
        }
        if !pointer.down && !pointer.released {
            app.launcher_drag_key = 0
            app.launcher_drag_moving = false
        } else {
            app_launcher_update_drag(app, Vector2.{pointer.x, pointer.y})
        }
    }
    desktop := app_nav_desktop_rail_enabled(app) != 0
    panel := Rectangle.{0.0, 0.0, cast(float32)app.ui.view_width,
        cast(float32)app.ui.view_height}
    overlay: DismissibleOverlayProps
    overlay.key = KeyHash("inbe/apps/overlay")
    overlay.bounds = TreeRootBounds(app.ui.session)
    overlay.dismiss_disabled = app.breathing.screen == ScreenAppSelection
    result := DismissibleOverlay(app.ui.session, overlay)
    if result.closed {
        app_launcher_close(app)
        return
    }
    if result.panel_node < 0 || !TreePushScope(app.ui.session, result.panel_node) { return }
    app.launcher_panel_node = result.panel_node
    PaintRoundedFill(app.ui.session, result.panel_node, panel, 0.0, 4,
        StyleTokenColor("launcher-canvas"))
    margin := AppScale(20)
    x := cast(s32)panel.x + margin
    width := cast(s32)panel.width - margin * 2
    title_y := AppScale(24)
    compact_header := width < AppScale(500)
    edit_w := AppScale(ifx compact_header then 44 else 96)
    profile_w := AppScale(ifx compact_header then 104 else 160)
    profile_x := x + width - AppScale(52) - profile_w
    edit_x := profile_x - AppScale(8) - edit_w
    Text(app.ui.session, TextProps.{.text = LocaleText("launcher_title"),
            .font = AppScale(28), .wrap = cast(TextWrap)TextWrapNone,
            .bounds = Rectangle.{cast(float32)x, cast(float32)title_y,
                cast(float32)(edit_x - x - AppScale(8)), cast(float32)AppScale(40)},
            .class_name = KssClassId(KssMakeName("launcher-title"))})
    edit: ButtonProps
    edit.key = KeyHash("inbe/apps/edit")
    edit.label = LocaleText(ifx app.launcher_editing then "done_button" else "launcher_edit_apps")
    edit.icon_shape = EditIcon.Shape
    edit.icon_only = compact_header
    edit.fit_content = true
    edit.selected = app.launcher_editing
    edit.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    edit.bounds = Rectangle.{cast(float32)edit_x,
        cast(float32)title_y, cast(float32)edit_w, cast(float32)AppScale(44)}
    if Button(app.ui.session, edit) != 0 {
        app.launcher_editing = !app.launcher_editing
        app.launcher_drag_key = 0
        app.launcher_drag_moving = false
        app_block_current_click(app)
    }
    identity: [128]u8
    subtitle: [128]u8
    app_nav_profile_identity(app, identity[:], identity.count, subtitle[:], subtitle.count)
    account: ButtonProps
    account.key = KeyHash("inbe/apps/profile")
    account.id = 6792
    account.label = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*identity[0], cast(s32)identity.count))
    account.icon_shape = app_nav_route_own_shape(APP_NAV_ROUTE_PROFILE)
    account.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    account.bounds = Rectangle.{cast(float32)profile_x, cast(float32)title_y,
        cast(float32)profile_w, cast(float32)AppScale(44)}
    if Button(app.ui.session, account) != 0 {
        app_launcher_activate(app, APP_NAV_ROUTE_PROFILE)
        unused End(app.ui.session)
        return
    }
    settings: ButtonProps
    settings.key = KeyHash("inbe/apps/settings")
    settings.label = LocaleText("settings_title")
    settings.icon_shape = app_nav_route_own_shape(APP_NAV_ROUTE_SETTINGS)
    settings.icon_only = true
    settings.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    settings.bounds = Rectangle.{cast(float32)(x + width - AppScale(44)),
        cast(float32)title_y, cast(float32)AppScale(44), cast(float32)AppScale(44)}
    if Button(app.ui.session, settings) != 0 {
        app_launcher_close(app)
        app_apply_nav_route(app, APP_NAV_ROUTE_SETTINGS)
        unused End(app.ui.session)
        return
    }
    search_y := title_y + AppScale(56)
    launcher_screen.query = app.launcher_search
    launcher_screen.cursor = app.launcher_search_cursor
    launcher_screen.anchor = app.launcher_search_anchor
    launcher_screen.scroll_x = app.launcher_search_scroll
    launcher_screen.focused = app.launcher_search_focused
    launcher_screen.grid = app.launcher_grid_view
    launcher_screen.scroll = app.launcher_scroll
    items: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]SharedLauncher.AppLauncherItem
    titles: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS][256]u8
    routes := LauncherRoutes()
    canonical: [6]string = .{"Diary", "Habits", "Lists", "Lumi", "Practice", "Leaderboard"}
    count: s32
    // Favorite order is account-owned. The shared module filters and groups
    // these entries, including native routes and undownloaded offers alike.
    for index: cast(s32)0..app.launcher_favorite_count - 1 {
        launcher_screen_routes[count] = app.launcher_favorites[index]
        count += 1
    }
    more_catalog: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]s32
    more_catalog_count: s32
    for route: routes {
        if app_launcher_is_favorite(app, route) ||
        (AppNavNodeSlot(route) >= 0 && !app_nav_route_available(app, route)) { continue }
        more_catalog[more_catalog_count] = route
        more_catalog_count += 1
    }
    for offer: cast(s32)0..NodeAppOfferCount() - 1 {
        name := NodeAppOfferName(offer)
        if NodeAppOfferShown(offer) && NodeAppSlotFor(name) < 0 {
            more_catalog[more_catalog_count] = -offer - 2
            more_catalog_count += 1
        }
    }
    LauncherLibrarySort(app, more_catalog[:more_catalog_count])
    for index: cast(s32)0..more_catalog_count - 1 {
        launcher_screen_routes[count] = more_catalog[index]
        count += 1
    }
    for index: cast(s32)0..count - 1 {
        route := launcher_screen_routes[index]
        title := ifx route >= 0 then app_nav_route_label(route) else NodeAppTitle(LauncherLibraryName(route))
        unused AppCopyText(title, titles[index][:])
        search := LauncherLibraryName(route)
        for at: cast(s32)0..5 { if routes[at] == route { search = canonical[at] } }
        items[index] = SharedLauncher.AppLauncherItem.{
            .title = AppTextFromCString(*titles[index][0], 256), .search = search,
            .favorite = route >= 0 && app_launcher_is_favorite(app, route)}
    }
    bottom_dock := app_content_bottom_reserved(app)
    status := ""
    if launcher_pin_status >= 0 {
        status_key := ifx launcher_pin_status == 2 then "launcher_pin_added" else "launcher_pin_requested"
        if launcher_pin_status == 0 { status_key = "launcher_pin_failed" }
        status = LocaleText(status_key)
    }
    typed: [1024]u8
    input := SampleTextFieldInput(true, typed[:])
    layout := SharedLauncher.AppLauncherScreen(app.ui.session, *launcher_screen,
        SharedLauncher.AppLauncherProps.{
            .bounds = Rectangle.{cast(float32)x, cast(float32)search_y, cast(float32)width,
                cast(float32)(app.ui.view_height - bottom_dock - AppScale(12) - search_y)},
            .scale = MetricsScale(), .locale = LocaleActiveCode(), .input = input,
            .search_class = KssClassId(KssMakeName("launcher-search")),
            .heading_class = KssClassId(KssMakeName("launcher-heading")),
            .muted_class = KssClassId(KssMakeName("launcher-muted")),
            .empty_favorites = true, .status = status, .context = cast(*void)app,
            .cards = LauncherScreenCards}, items[:count])
    app.launcher_search = launcher_screen.query
    app.launcher_search_cursor = launcher_screen.cursor
    app.launcher_search_anchor = launcher_screen.anchor
    app.launcher_search_scroll = launcher_screen.scroll_x
    app.launcher_search_focused = launcher_screen.focused
    app.launcher_scroll = launcher_screen.scroll
    if layout.clipboard_write {
        unused TextInputWriteClipboard(AppTextFromCString(*layout.clipboard_text[0], 128))
    }
    if layout.changed {
        app.launcher_grid_view = launcher_screen.grid
        app.launcher_drag_key = 0
        app.launcher_drag_moving = false
        save_settings(app)
        app_block_current_click(app)
    }
    pinned_count := launcher_screen.favorites
    more_count := launcher_screen.count - pinned_count
    pinned: [LAUNCHER_APP_COUNT]s32
    more: [LAUNCHER_APP_COUNT + NODE_APP_OFFERS]s32
    for index: cast(s32)0..pinned_count - 1 {
        pinned[index] = launcher_screen_routes[launcher_screen.visible[index]]
    }
    for index: cast(s32)0..more_count - 1 {
        more[index] = launcher_screen_routes[launcher_screen.visible[pinned_count + index]]
    }
    scrolled := layout.scrolled
    pinned_bounds := layout.favorites_bounds
    more_bounds := layout.library_bounds
    tile_height := layout.tile_height
    gap := layout.gap
    pinned_cells := MeasureGrid(GridProps.{.columns = layout.columns, .gap = gap,
            .bounds = Rectangle.{pinned_bounds.x, pinned_bounds.y + cast(float32)AppScale(36), pinned_bounds.width, 0.0}})
    more_cells := MeasureGrid(GridProps.{.columns = layout.columns, .gap = gap,
            .bounds = Rectangle.{more_bounds.x, more_bounds.y + cast(float32)AppScale(36), more_bounds.width, 0.0}})
    pinned_slots: [LAUNCHER_APP_COUNT]Rectangle
    for index: cast(s32)0..pinned_count - 1 { pinned_slots[index] = GridCellBounds(pinned_cells, index, tile_height) }
    query := AppTextFromCString(*app.launcher_search[0], 128)
    if !dock_drawn {
        app_draw_favorites_dock(app)
    }
    if app.launcher_drag_key != 0 && app.launcher_drag_moving {
        point := app.launcher_drag_pointer
        target := app.launcher_dock_drop_index
        if query.count == 0 && scrolled.opened &&
        PointInBounds(point.x, point.y, scrolled.viewport) &&
        PointInBounds(point.x, point.y, pinned_bounds) {
            target = GridIndexAt(pinned_cells, point.x, point.y, tile_height,
                app.launcher_favorite_count)
            highlight := pinned_bounds
            if target < pinned_count { highlight = pinned_slots[target] }
            highlight = RectangleIntersection(highlight, scrolled.viewport)
            PaintRoundedOutline(app.ui.session, -1, highlight,
                cast(float32)AppScale(12), 12, cast(float32)AppScale(2),
                StyleTokenColor("accent"))
        }
        if app.launcher_drag_released {
            if target >= 0 {
                if app.launcher_drag_route >= 0 && app_launcher_install(app, app.launcher_drag_route) {
                    app.launcher_favorite_count = LauncherPlaceFavorite(
                        app.launcher_favorites[:], app.launcher_favorite_count,
                        app.launcher_drag_route, target)
                    app_launcher_pins_changed(app)
                }
            } else if query.count == 0 && scrolled.opened &&
            PointInBounds(point.x, point.y, scrolled.viewport) &&
            PointInBounds(point.x, point.y, more_bounds) {
                if app.launcher_drag_route >= 0 && app_launcher_is_favorite(app, app.launcher_drag_route) {
                    app.launcher_favorite_count = LauncherToggleFavorite(
                        app.launcher_favorites[:], app.launcher_favorite_count,
                        app.launcher_drag_route)
                    app_launcher_pins_changed(app)
                }
                target = GridIndexAt(more_cells, point.x, point.y, tile_height, more_count)
                LauncherLibraryMove(app, more[:more_count], app.launcher_drag_route, target)
            }
            app.launcher_drag_key = 0
            app.launcher_drag_moving = false
            app_block_current_click(app)
        } else {
            if scrolled.opened && PointInBounds(point.x, point.y, scrolled.viewport) {
                margin := cast(float32)AppScale(32)
                if point.y < scrolled.viewport.y + margin {
                    app.launcher_scroll -= AppScale(8)
                } else if point.y > scrolled.viewport.y + scrolled.viewport.height - margin {
                    app.launcher_scroll += AppScale(8)
                }
                if app.launcher_scroll < 0 {
                    app.launcher_scroll = 0
                }
                if app.launcher_scroll > scrolled.max_scroll {
                    app.launcher_scroll = scrolled.max_scroll
                }
            }
            preview: ButtonProps
            preview.id = 7290
            if app.launcher_drag_route >= 0 {
                preview.label = app_nav_route_label(app.launcher_drag_route)
                preview.image = bottom_nav_route_image(app.launcher_drag_route)
                preview.icon_shape = app_nav_route_shape(app.launcher_drag_route)
            } else {
                preview.label = NodeAppTitle(LauncherLibraryName(app.launcher_drag_route))
                preview.icon_shape = NodeAppCatalogIcon(LauncherLibraryName(app.launcher_drag_route))
            }
            preview.bounds = app.launcher_drag_bounds
            preview.bounds.x = point.x - app.launcher_drag_grab.x
            preview.bounds.y = point.y - app.launcher_drag_grab.y
            preview.icon_placement = cast(IconPlacement)(ifx app.launcher_drag_vertical then IconPlacementAbove else IconPlacementLeading)
            preview.class_name = KssClassId(KssMakeName("launcher-tile"))
            preview.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            preview.selected = true
            preview.disabled = true
            PaintRoundedFill(app.ui.session, -1, preview.bounds,
                cast(float32)AppScale(12), 12, StyleTokenColor("launcher-canvas"))
            unused Button(app.ui.session, preview)
        }
    } else if app.launcher_drag_released {
        app.launcher_drag_key = 0
    }
    unused End(app.ui.session)
    if app.launcher_guide_seen == 0 {
        steps: [3]GuideOverlayStep
        steps[0] = GuideOverlayStepFor(layout.search_bounds, "launcher_guide_find")
        steps[1] = GuideOverlayStepFor(layout.scroll_bounds, "launcher_guide_manage")
        steps[2] = GuideOverlayStepFor(account.bounds, "launcher_guide_profile")
        guide: GuideOverlayProps
        guide.steps = *steps[0]
        guide.count = 3
        guide.step = *app.launcher_guide_step
        guide.view_width = app.ui.view_width
        guide.view_height = app.ui.view_height
        guide.reserved_bottom = bottom_dock
        guide.max_width = AppScale(320)
        guide.paragraph_font = AppFontSize()
        guide.previous_requested = app.ui.manual_previous
        guide.next_requested = app.ui.manual_next
        guide.close_requested = app.ui.manual_close
        result := GuideOverlay(guide)
        if result.finished != 0 || result.closed != 0 {
            app.launcher_guide_seen = 1
            save_settings(app)
            app_block_current_click(app)
        }
    } else {
        app_launcher_ask_package_updates(app)
    }
}

// Apps is where packages are chosen and installed, so it asks once whether
// they may update by themselves. Both answers are one equal tap; closing the
// question without an answer asks again on a later start.
launcher_package_updates_closed: bool;

app_launcher_ask_package_updates :: (app: *InnerBreeze) {
    if launcher_package_updates_closed || !PackageAutomaticUnasked() {
        return
    }
    actions: [2]ActionModalAction = .[
    ActionModalAction.{.label = LocaleText("package_updates_decline"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ActionModalAction.{.label = LocaleText("package_updates_allow"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ]
    props: ActionModalProps = .{}
    props.key = KeyHash("inbe/apps/package-updates")
    props.title = LocaleText("package_updates_title")
    props.message = LocaleText("package_updates_message")
    props.max_width = 420
    answer := ActionModal(app.ui.session, props, actions[:2]).action
    if answer == 0 {
        return
    }
    if answer == 1 {
        PackageSetAutomatic(false)
    } else if answer == 2 {
        PackageSetAutomatic(true)
    } else {
        launcher_package_updates_closed = true
    }
    app_block_current_click(app)
}
