app_launcher_update_drag :: (app: *InnerBreeze, point: Vector2) {
    app.launcher_drag_pointer = point
    dx := point.x - app.launcher_drag_origin.x
    dy := point.y - app.launcher_drag_origin.y
    threshold := cast(float32)AppScale(6)
    if dx * dx + dy * dy >= threshold * threshold {
        app.launcher_drag_moving = true
    }
}

// Keep the ordinary Button face and click behavior, while its retained press
// can move to another favorite slot without becoming a content scroll.
app_launcher_drag_card :: (app: *InnerBreeze, card: ButtonProps,
    route: s32, vertical: bool) -> bool {
    key := cast(u64)card.id
    previous := TreePrevious(app.ui.session, TreeCurrentParent(app.ui.session),
        key, WidgetKindButton)
    drag := TreeTakeDragAt(app.ui.session, previous)
    if drag.started {
        app.launcher_drag_key = key
        app.launcher_drag_route = route
        app.launcher_drag_moving = false
        app.launcher_drag_released = false
        app.launcher_drag_vertical = vertical
        app.launcher_drag_bounds = card.bounds
        app.launcher_drag_origin = Vector2.{drag.x, drag.y}
        app.launcher_drag_grab = Vector2.{drag.grab_x, drag.grab_y}
    }
    if (drag.active || drag.ended) && app.launcher_drag_key == key {
        app_launcher_update_drag(app, Vector2.{drag.x, drag.y})
        app.launcher_drag_released = drag.ended
        return drag.ended && !app.launcher_drag_moving &&
        TreeHoveredAt(app.ui.session, previous)
    }
    return false
}

// Every app card has the same click and drag behavior in both sections.
app_launcher_draw_card :: (app: *InnerBreeze, route: s32,
    bounds: Rectangle, vertical: bool) {
    full_bounds := bounds
    if LauncherShortcutSupported() { bounds.height -= cast(float32)AppScale(44) }
    blocked := app.blocked_input_frame == app.breathing.frame
    card: ButtonProps
    card.id = 6900 + route
    card.bounds = bounds
    card.label = app_nav_route_label(route)
    card.image = bottom_nav_route_image(route)
    card.icon_shape = app_nav_route_shape(route)
    if vertical { card.icon_placement = cast(IconPlacement)IconPlacementAbove }
    else { card.content_alignment = cast(ContentAlignment)ContentAlignmentStart }
    card.class_name = KssClassId(KssMakeName("launcher-tile"))
    card.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    card.selected = bottom_nav_route_active(app, route)
    if card.selected {
        card.tone = cast(ButtonTone)ButtonToneAccent
        card.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    }
    card.disabled = blocked
    card.fit_content = true
    // An app the node offers has a card only while it is installed.
    installed := (app.enabled_apps & app_nav_route_bit(route)) != 0 || AppNavNodeSlot(route) >= 0
    tapped := !card.disabled && app_launcher_drag_card(app, card, route, vertical)
    activated := Button(app.ui.session, card) != 0 || tapped
    node := TreeSubmitted(app.ui.session, TreeCurrentParent(app.ui.session),
        cast(u64)card.id, WidgetKindButton)
    TreeSetDragCapture(app.ui.session, node, true)
    // An installed app shows the size of its package, bundled or from the node.
    bytes: s64 = 0
    if AppNavNodeSlot(route) >= 0 {
        bytes = NodeAppPackageSize(AppNavNodeSlot(route))
    } else {
        bit := app_nav_route_bit(route)
        for index: cast(s32)1..PackageCount - 1 {
            if PackageBit(index) == bit {
                bytes = CellsPackageSize(index)
                break
            }
        }
    }
    size_text: [32]u8
    if AppBundleSizeText(bytes, size_text[:]) {
        size_bounds := card.bounds
        size_bounds.x += cast(float32)AppScale(ifx vertical then 8 else 48)
        size_bounds.y += bounds.height - cast(float32)AppScale(16)
        size_bounds.width -= cast(float32)AppScale(ifx vertical then 16 else 56)
        size_bounds.height = cast(float32)AppScale(12)
        Text(app.ui.session, TextProps.{
                .text = FrameTextHold(*app.ui.frame_text,
                AppTextFromCString(*size_text[0], 32)),
                .font = AppScale(11), .wrap = cast(TextWrap)TextWrapNone,
                .align = cast(TextAlign)(ifx vertical then TextAlignCenter else TextAlignStart),
                .bounds = size_bounds,
                .class_name = KssClassId(KssMakeName("launcher-muted"))})
    }
    if activated && !app.launcher_drag_moving {
        app_launcher_activate(app, route)
    }
    if installed && LauncherShortcutSupported() {
        pin: ButtonProps
        pin.id = 7600 + route
        pin.bounds = Rectangle.{full_bounds.x, full_bounds.y + bounds.height + cast(float32)AppScale(4),
            full_bounds.width, cast(float32)AppScale(40)}
        pin.label = LocaleText("launcher_pin_system")
        pin.fit_content = true
        pin.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        pin.disabled = blocked
        if Button(app.ui.session, pin) != 0 {
            app_launcher_pin(app, route)
        }
    }
    // The install or remove symbol sits inside the card's top-right corner.
    // It is submitted after the card, so a tap on it reaches only the action.
    action_size := AppScale(36)
    action_inset := AppScale(4)
    action: ButtonProps
    action.id = 7300 + route
    action.bounds = Rectangle.{
        bounds.x + bounds.width - cast(float32)(action_size + action_inset),
        bounds.y + cast(float32)action_inset,
        cast(float32)action_size, cast(float32)action_size}
    action.label = LocaleText(ifx installed then "launcher_uninstall" else "launcher_install")
    action.icon_only = true
    if installed {
        action.icon_shape = "S1.6rr:M3 6H21M9 6V3H15V6M5 6L6 21H18L19 6M10 10V17M14 10V17"
    } else {
        action.icon_shape = "S1.6rr:M12 3V15M7 10L12 15L17 10M5 20H19"
    }
    action.class_name = KssClassId(KssMakeName("launcher-action"))
    action.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    if card.selected {
        action.tone = cast(ButtonTone)ButtonToneAccent
    }
    action.fit_content = true
    action.disabled = blocked
    if Button(app.ui.session, action) != 0 {
        if installed { app_launcher_uninstall(app, route) }
        else { unused app_launcher_install(app, route) }
    }
}

// An app the node offers that is not installed: a tap or its download symbol
// installs it and its card opens it from then on.
app_launcher_draw_offer :: (app: *InnerBreeze, offer: s32, bounds: Rectangle) {
    blocked := app.blocked_input_frame == app.breathing.frame
    name := NodeAppOfferName(offer)
    card: ButtonProps
    card.id = 7400 + offer
    card.bounds = bounds
    card.label = NodeAppTitle(name)
    card.icon_shape = NODE_APP_GENERIC_ICON
    card.icon_placement = cast(IconPlacement)IconPlacementAbove
    card.class_name = KssClassId(KssMakeName("launcher-tile"))
    card.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
    card.disabled = blocked
    card.fit_content = true
    if Button(app.ui.session, card) != 0 {
        slot := app_launcher_install_offer(app, name)
        if slot >= 0 {
            app_launcher_activate(app, AppNavNodeRoute(slot))
        }
    }
    size_text: [32]u8
    if AppBundleSizeText(NodeAppOfferSize(offer), size_text[:]) {
        Text(app.ui.session, TextProps.{
            .text = FrameTextHold(*app.ui.frame_text, AppTextFromCString(*size_text[0], 32)),
            .font = AppScale(11), .wrap = cast(TextWrap)TextWrapNone,
            .align = cast(TextAlign)TextAlignCenter,
            .bounds = Rectangle.{bounds.x + cast(float32)AppScale(8),
                bounds.y + bounds.height - cast(float32)AppScale(16),
                bounds.width - cast(float32)AppScale(16), cast(float32)AppScale(12)},
            .class_name = KssClassId(KssMakeName("launcher-muted"))})
    }
    action_size := AppScale(36)
    action_inset := AppScale(4)
    action: ButtonProps
    action.id = 7450 + offer
    action.bounds = Rectangle.{
        bounds.x + bounds.width - cast(float32)(action_size + action_inset),
        bounds.y + cast(float32)action_inset,
        cast(float32)action_size, cast(float32)action_size}
    action.label = LocaleText("launcher_install")
    action.icon_only = true
    action.icon_shape = "S1.6rr:M12 3V15M7 10L12 15L17 10M5 20H19"
    action.class_name = KssClassId(KssMakeName("launcher-action"))
    action.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    action.fit_content = true
    action.disabled = blocked
    if Button(app.ui.session, action) != 0 {
        unused app_launcher_install_offer(app, name)
    }
}

#program_export
app_draw_launcher :: (app: *InnerBreeze) {
    app.launcher_panel_node = -1
    if !app.launcher_open || app.host_feature != 0 { return }
    if app.modal.active != 0 {
        app_launcher_close(app)
        return
    }
    pointer := PointerSample(app.ui.session)
    if app.launcher_drag_key != 0 {
        if !pointer.down && !pointer.released {
            app.launcher_drag_key = 0
            app.launcher_drag_moving = false
        } else {
            app_launcher_update_drag(app, Vector2.{pointer.x, pointer.y})
        }
    }
    desktop := app_nav_desktop_rail_enabled(app) != 0
    panel := Rectangle.{0.0, 0.0, cast(float32)app.ui.view_width,
        cast(float32)app.ui.view_height}
    overlay: DismissibleOverlayProps
    overlay.key = KeyHash("inbe/apps/overlay")
    overlay.bounds = TreeRootBounds(app.ui.session)
    overlay.dismiss_disabled = app.breathing.screen == ScreenAppSelection
    result := DismissibleOverlay(app.ui.session, overlay)
    if result.closed {
        app_launcher_close(app)
        return
    }
    if result.panel_node < 0 || !TreePushScope(app.ui.session, result.panel_node) { return }
    app.launcher_panel_node = result.panel_node
    PaintRoundedFill(app.ui.session, result.panel_node, panel, 0.0, 4,
        StyleTokenColor("launcher-canvas"))
    margin := AppScale(20)
    x := cast(s32)panel.x + margin
    width := cast(s32)panel.width - margin * 2
    title_y := AppScale(24)
    Text(app.ui.session, TextProps.{.text = LocaleText("launcher_title"),
            .font = AppScale(28), .wrap = cast(TextWrap)TextWrapNone,
            .bounds = Rectangle.{cast(float32)x, cast(float32)title_y,
                cast(float32)width, cast(float32)AppScale(40)},
            .class_name = KssClassId(KssMakeName("launcher-title"))})
    search_y := title_y + AppScale(56)
    typed: [128]u8
    field: TextFieldProps
    field.focus_id = 6791
    field.value = AppTextFromCString(*app.launcher_search[0], 128)
    field.placeholder = LocaleText("launcher_search")
    field.label = LocaleText("launcher_search")
    field.cursor = app.launcher_search_cursor
    field.anchor = app.launcher_search_anchor
    field.scroll_x = app.launcher_search_scroll
    field.focused = app.launcher_search_focused
    field.max_bytes = 127
    field.max_codepoints = 80
    field.class_name = KssClassId(KssMakeName("launcher-search"))
    field.bounds = Rectangle.{cast(float32)x, cast(float32)search_y,
        cast(float32)width, cast(float32)AppScale(48)}
    field.input = SampleTextFieldInput(app.launcher_search_focused, typed[:])
    searched := TextField(app.ui.session, field)
    if searched.edit.changed {
        unused AppReplaceText(app.launcher_search[:], searched.edit.start,
            searched.edit.end, searched.edit.replacement)
        app.launcher_scroll = 0
    }
    app.launcher_search_cursor = searched.cursor
    app.launcher_search_anchor = searched.anchor
    app.launcher_search_scroll = searched.scroll_x
    app.launcher_search_focused = searched.focused
    if searched.clipboard_write { unused TextInputWriteClipboard(searched.clipboard_text) }
    query := AppTextFromCString(*app.launcher_search[0], 128)
    routes := LauncherRoutes()
    canonical: [LAUNCHER_APP_COUNT]string = .{"Diary", "Habits", "Lists", "Lumi", "Practice", "Leaderboard",
        "", "", "", "", "", "", "", ""}
    matches: [LAUNCHER_APP_COUNT]s32
    match_count: s32 = 0
    for index: cast(s32)0..LAUNCHER_APP_COUNT - 1 {
        // A slot without an installed app the node offers has no card.
        if AppNavNodeSlot(routes[index]) >= 0 && !app_nav_route_available(app, routes[index]) {
            continue
        }
        if LauncherMatches(app_nav_route_label(routes[index]), query) ||
        LauncherMatches(canonical[index], query) {
            matches[match_count] = routes[index]
            match_count += 1
        }
    }
    pinned: [LAUNCHER_APP_COUNT]s32
    more: [LAUNCHER_APP_COUNT]s32
    pinned_count: s32 = 0
    more_count: s32 = 0
    for index: cast(s32)0..app.launcher_favorite_count - 1 {
        route := app.launcher_favorites[index]
        for match: cast(s32)0..match_count - 1 {
            if matches[match] == route {
                pinned[pinned_count] = route
                pinned_count += 1
            }
        }
    }
    for index: cast(s32)0..match_count - 1 {
        if !app_launcher_is_favorite(app, matches[index]) {
            more[more_count] = matches[index]
            more_count += 1
        }
    }
    offers: [NODE_APP_OFFERS]s32
    offer_count: s32 = 0
    for offer: cast(s32)0..NodeAppOfferCount() - 1 {
        name := NodeAppOfferName(offer)
        if NodeAppOfferShown(offer) && NodeAppSlotFor(name) < 0 && LauncherMatches(NodeAppTitle(name), query) {
            offers[offer_count] = offer
            offer_count += 1
        }
    }
    tile_height := AppScale(ifx LauncherShortcutSupported() then 132 else 88)
    gap := AppScale(12)
    // The tiles reflow into as many columns as the panel's width allows.
    columns := MeasureGrid(GridProps.{.bounds = Rectangle.{cast(float32)x, 0.0, cast(float32)width, 0.0},
            .min_item_width = AppScale(140), .max_columns = 6, .gap = gap}).columns
    cells := MeasureGrid(GridProps.{.columns = columns, .gap = gap,
            .bounds = Rectangle.{cast(float32)x, 0.0, cast(float32)width, 0.0}})
    pinned_rows := GridRowCount(cells, pinned_count)
    more_rows := GridRowCount(cells, more_count + offer_count)
    pinned_height := AppScale(36) + pinned_rows * (tile_height + gap)
    more_height := AppScale(36) + more_rows * (tile_height + gap)
    if more_count + offer_count == 0 { more_height += AppScale(64) }
    content_height := pinned_height + more_height
    if match_count + offer_count == 0 { content_height += AppScale(64) }
    bottom_dock := app_content_bottom_reserved(app)
    footer_y := app.ui.view_height - bottom_dock - AppScale(72)
    body_y := search_y + AppScale(68)
    if launcher_pin_status >= 0 {
        status_key := ifx launcher_pin_status == 2 then "launcher_pin_added" else "launcher_pin_requested"
        if launcher_pin_status == 0 { status_key = "launcher_pin_failed" }
        Text(app.ui.session, TextProps.{.text = LocaleText(status_key),
            .bounds = Rectangle.{cast(float32)x, cast(float32)body_y,
                cast(float32)width, cast(float32)AppScale(44)}, .font = AppSmallFontSize()})
        body_y += AppScale(48)
    }
    scroll: ScrollProps
    scroll.key = KeyHash("inbe/apps/library")
    scroll.bounds = Rectangle.{cast(float32)x, cast(float32)body_y,
        cast(float32)width, cast(float32)(footer_y - body_y - AppScale(8))}
    scroll.content_height = content_height
    scroll.scroll_offset = app.launcher_scroll
    scrolled := Scroll(app.ui.session, scroll)
    app.launcher_scroll = scrolled.scroll_offset
    pinned_bounds: Rectangle
    pinned_cells: GridMetrics
    more_bounds: Rectangle
    pinned_slots: [LAUNCHER_APP_COUNT]Rectangle
    if scrolled.opened {
        width = cast(s32)scrolled.content.width
        y := cast(s32)scrolled.content.y
        pinned_bounds = Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)width, cast(float32)pinned_height}
        for section: cast(s32)0..cast(s32)1 {
            count := ifx section == 0 then pinned_count else more_count
            Text(app.ui.session, TextProps.{
                    .text = LocaleText(ifx section == 0 then "launcher_favorites" else "launcher_all_apps"),
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y,
                        cast(float32)width, cast(float32)AppScale(28)},
                    .class_name = KssClassId(KssMakeName("launcher-heading"))})
            if section == 1 {
                more_bounds = Rectangle.{cast(float32)x, cast(float32)y,
                    cast(float32)width, cast(float32)more_height}
            }
            y += AppScale(36)
            // The scroll's content may be narrower than the panel; the column
            // count chosen for the panel keeps the content height exact.
            section_cells := MeasureGrid(GridProps.{.columns = columns, .gap = gap,
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y, cast(float32)width, 0.0}})
            if section == 0 { pinned_cells = section_cells }
            for index: cast(s32)0..count - 1 {
                route := ifx section == 0 then pinned[index] else more[index]
                bounds := GridCellBounds(section_cells, index, tile_height)
                if section == 0 { pinned_slots[index] = bounds }
                app_launcher_draw_card(app, route, bounds, true)
            }
            if section == 1 {
                for offer: cast(s32)0..offer_count - 1 {
                    bounds := GridCellBounds(section_cells, count + offer, tile_height)
                    app_launcher_draw_offer(app, offers[offer], bounds)
                }
                count += offer_count
            }
            y += GridRowCount(section_cells, count) * (tile_height + gap)
        }
        if match_count + offer_count == 0 {
            Text(app.ui.session, TextProps.{.text = LocaleText("launcher_no_results"),
                    .bounds = Rectangle.{cast(float32)x, cast(float32)y,
                        cast(float32)width, cast(float32)AppScale(56)},
                    .class_name = KssClassId(KssMakeName("launcher-muted"))})
        }
        unused End(app.ui.session)
    }
    footer_routes: [2]s32 = .{APP_NAV_ROUTE_PROFILE, APP_NAV_ROUTE_SETTINGS}
    footer_count := cast(s32)footer_routes.count
    footer_width := (width - gap * (footer_count - 1)) / footer_count
    for index: cast(s32)0..footer_count - 1 {
        route := footer_routes[index]
        footer: ButtonProps
        footer.id = 7200 + route
        footer.label = app_nav_route_label(route)
        if desktop { footer.content_alignment = cast(ContentAlignment)ContentAlignmentStart }
        footer.image = bottom_nav_route_image(route)
        footer.icon_shape = app_nav_route_shape(route)
        footer.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        footer.class_name = KssClassId(KssMakeName("launcher-tile"))
        footer.bounds = Rectangle.{cast(float32)(x + index * (footer_width + gap)),
            cast(float32)(footer_y + AppScale(12)), cast(float32)footer_width, cast(float32)AppScale(48)}
        if Button(app.ui.session, footer) != 0 { app_launcher_activate(app, route) }
    }
    app_draw_favorites_dock(app)
    if app.launcher_drag_key != 0 && app.launcher_drag_moving {
        point := app.launcher_drag_pointer
        target := app.launcher_dock_drop_index
        if query.count == 0 && scrolled.opened &&
        PointInBounds(point.x, point.y, scrolled.viewport) &&
        PointInBounds(point.x, point.y, pinned_bounds) {
            target = GridIndexAt(pinned_cells, point.x, point.y, tile_height,
                app.launcher_favorite_count)
            highlight := pinned_bounds
            if target < pinned_count { highlight = pinned_slots[target] }
            highlight = RectangleIntersection(highlight, scrolled.viewport)
            PaintRoundedOutline(app.ui.session, -1, highlight,
                cast(float32)AppScale(12), 12, cast(float32)AppScale(2),
                StyleTokenColor("accent"))
        }
        if app.launcher_drag_released {
            if target >= 0 {
                if app_launcher_install(app, app.launcher_drag_route) {
                    app.launcher_favorite_count = LauncherPlaceFavorite(
                        app.launcher_favorites[:], app.launcher_favorite_count,
                        app.launcher_drag_route, target)
                    app_launcher_pins_changed(app)
                }
            } else if query.count == 0 && scrolled.opened &&
            PointInBounds(point.x, point.y, scrolled.viewport) &&
            PointInBounds(point.x, point.y, more_bounds) &&
            app_launcher_is_favorite(app, app.launcher_drag_route) {
                app.launcher_favorite_count = LauncherToggleFavorite(
                    app.launcher_favorites[:], app.launcher_favorite_count,
                    app.launcher_drag_route)
                app_launcher_pins_changed(app)
            }
            app.launcher_drag_key = 0
            app.launcher_drag_moving = false
            app_block_current_click(app)
        } else {
            if scrolled.opened && PointInBounds(point.x, point.y, scrolled.viewport) {
                margin := cast(float32)AppScale(32)
                if point.y < scrolled.viewport.y + margin {
                    app.launcher_scroll -= AppScale(8)
                } else if point.y > scrolled.viewport.y + scrolled.viewport.height - margin {
                    app.launcher_scroll += AppScale(8)
                }
                if app.launcher_scroll < 0 {
                    app.launcher_scroll = 0
                }
                if app.launcher_scroll > scrolled.max_scroll {
                    app.launcher_scroll = scrolled.max_scroll
                }
            }
            preview: ButtonProps
            preview.id = 7290
            preview.label = app_nav_route_label(app.launcher_drag_route)
            preview.image = bottom_nav_route_image(app.launcher_drag_route)
            preview.icon_shape = app_nav_route_shape(app.launcher_drag_route)
            preview.bounds = app.launcher_drag_bounds
            preview.bounds.x = point.x - app.launcher_drag_grab.x
            preview.bounds.y = point.y - app.launcher_drag_grab.y
            preview.icon_placement = cast(IconPlacement)(ifx app.launcher_drag_vertical then IconPlacementAbove else IconPlacementLeading)
            preview.class_name = KssClassId(KssMakeName("launcher-tile"))
            preview.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
            preview.selected = true
            preview.disabled = true
            PaintRoundedFill(app.ui.session, -1, preview.bounds,
                cast(float32)AppScale(12), 12, StyleTokenColor("launcher-canvas"))
            unused Button(app.ui.session, preview)
        }
    } else if app.launcher_drag_released {
        app.launcher_drag_key = 0
    }
    unused End(app.ui.session)
    if app.launcher_guide_seen == 0 {
        steps: [3]GuideOverlayStep
        steps[0] = GuideOverlayStepFor(field.bounds, "launcher_guide_find")
        steps[1] = GuideOverlayStepFor(scroll.bounds, "launcher_guide_manage")
        steps[2] = GuideOverlayStepFor(Rectangle.{cast(float32)x,
            cast(float32)footer_y, cast(float32)width,
            cast(float32)AppScale(72)}, "launcher_guide_profile")
        guide: GuideOverlayProps
        guide.steps = *steps[0]
        guide.count = 3
        guide.step = *app.launcher_guide_step
        guide.view_width = app.ui.view_width
        guide.view_height = app.ui.view_height
        guide.reserved_bottom = bottom_dock
        guide.max_width = AppScale(320)
        guide.paragraph_font = AppFontSize()
        guide.previous_requested = app.ui.manual_previous
        guide.next_requested = app.ui.manual_next
        guide.close_requested = app.ui.manual_close
        result := GuideOverlay(guide)
        if result.finished != 0 || result.closed != 0 {
            app.launcher_guide_seen = 1
            save_settings(app)
            app_block_current_click(app)
        }
    } else {
        app_launcher_ask_package_updates(app)
    }
}

// Apps is where packages are chosen and installed, so it asks once whether
// they may update by themselves. Both answers are one equal tap; closing the
// question without an answer asks again on a later start.
launcher_package_updates_closed: bool;

app_launcher_ask_package_updates :: (app: *InnerBreeze) {
    if launcher_package_updates_closed || !PackageAutomaticUnasked() {
        return
    }
    actions: [2]ActionModalAction = .[
    ActionModalAction.{.label = LocaleText("package_updates_decline"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ActionModalAction.{.label = LocaleText("package_updates_allow"),
        .tone = cast(ButtonTone)ButtonToneNeutral,
        .emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft},
    ]
    props: ActionModalProps = .{}
    props.key = KeyHash("inbe/apps/package-updates")
    props.title = LocaleText("package_updates_title")
    props.message = LocaleText("package_updates_message")
    props.max_width = 420
    answer := ActionModal(app.ui.session, props, actions[:2]).action
    if answer == 0 {
        return
    }
    if answer == 1 {
        PackageSetAutomatic(false)
    } else if answer == 2 {
        PackageSetAutomatic(true)
    } else {
        launcher_package_updates_closed = true
    }
    app_block_current_click(app)
}
