#import "drawing_props"
Dropdown :: #import "kryon/dropdown";
#import "geometry"
#import "locale_policy"
#import "session"
#import, file "locale.zi";
#import, file "fonts.zi";

#program_export
LocaleDropdown :: (session: Session, props: Dropdown.Props) -> Dropdown.Result {
    RegisterLanguagePickerFonts()
    options: [64]Dropdown.Option
    count := LocaleLanguageCount()
    if count > 64 {
        count = 64
    }
    if count <= 0 {
        options[0].label = LocaleText("language_system_label")
        count = 1
    } else {
        index: s32 = 0
        while index < count {
            options[index].label = LocaleLanguageAt(index).label
            index += 1
        }
    }
    resolved := props
    if resolved.selected_index < 0 || resolved.selected_index >= count {
        resolved.selected_index = 0
    }
    return Dropdown.Draw(session, resolved, options[0:count])
}
