#import "drawing_props"
#import "dropdown"
#import "dropdown_props"
#import "dropdown_widget"
#import "geometry"
#import "image_props"
#import "locale_policy"
#import "session"
#import, file "locale.zi";
#import, file "fonts.zi";

#program_export
LocaleDropdown :: (session: Session, props: DropdownProps) -> DropdownResult {
    RegisterLanguagePickerFonts()
    options: [64]DropdownOption
    count := LocaleLanguageCount()
    if count > 64 {
        count = 64
    }
    if count <= 0 {
        options[0].label = LocaleText("language_system_label")
        count = 1
    } else {
        index: s32 = 0
        while index < count {
            options[index].label = LocaleLanguageAt(index).label
            index += 1
        }
    }
    resolved := props
    if resolved.selected_index < 0 || resolved.selected_index >= count {
        resolved.selected_index = 0
    }
    if resolved.highlight_index < 0 || resolved.highlight_index >= count {
        resolved.highlight_index = resolved.selected_index
    }
    if resolved.scroll_offset < 0 {
        resolved.scroll_offset = 0
    }
    return Dropdown(session, resolved, options[0:count])
}
