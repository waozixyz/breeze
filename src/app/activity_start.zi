#import, file "../../apps/practice/recovery.zi";

// The account controller installs this check in a connected application.
// Offline practice hosts have no remote session and keep the normal start path.
ActivityStartCheck :: #type () -> bool;
activity_start_check: ActivityStartCheck;
PracticeRecoveryCheck :: #type (draft: *PracticeRecoveryDraft) -> bool;
activity_recovery_check: PracticeRecoveryCheck;

ActivityStartAllowed :: () -> bool {
    if activity_start_check != null && !activity_start_check() {
        return false
    }
    draft: PracticeRecoveryDraft
    if !PracticeDraftPending(*draft) {
        return true
    }
    if activity_recovery_check == null || activity_recovery_check(*draft) {
        return false
    }
    // Keep unreadable and summary-only drafts before reusing the active slot.
    return PracticeDraftCancel(false)
}
