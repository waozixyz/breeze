#import "drawing_props"
#import "geometry"
#import "vec"

DirectDrawKind :: enum {
    DirectDrawContext :: 1
    DirectDrawTransform :: 2
    DirectDrawLine :: 3
    DirectDrawLineEx :: 4
    DirectDrawTriangle :: 5
    DirectDrawRectangle :: 6
    DirectDrawRectangleRec :: 7
    DirectDrawRectangleLines :: 8
    DirectDrawRectangleLinesEx :: 9
    DirectDrawRectangleRounded :: 10
    DirectDrawRectangleRoundedLinesEx :: 11
    DirectDrawRectangleGradient :: 12
    DirectDrawCircle :: 13
    DirectDrawCircleV :: 14
    DirectDrawCircleGradient :: 15
    DirectDrawCircleLines :: 16
    DirectDrawRing :: 17
    DirectDrawCircleLinesEx :: 18
}
using DirectDrawKind;

DirectDrawCommand :: struct {
    kind: s32
    a: s32
    b: s32
    c: s32
    d: s32
    values: [12] float32
    color: Color
    end_color: Color
}

direct_draw_current: Vec(DirectDrawCommand);
direct_draw_previous: Vec(DirectDrawCommand);
direct_draw_active: bool;
direct_draw_valid: bool;
direct_draw_unchanged: bool;

DirectDrawStore :: (command: DirectDrawCommand) {
    if !direct_draw_active { return }
    if !VecPush(direct_draw_current, command) {
        direct_draw_valid = false
        direct_draw_unchanged = false
    }
}

DirectDrawCommandsEqual :: (left: DirectDrawCommand,
    right: DirectDrawCommand) -> bool {
    if left.kind != right.kind || left.a != right.a || left.b != right.b ||
    left.c != right.c || left.d != right.d { return false }
    if left.color.r != right.color.r || left.color.g != right.color.g ||
    left.color.b != right.color.b || left.color.a != right.color.a { return false }
    if left.end_color.r != right.end_color.r ||
    left.end_color.g != right.end_color.g ||
    left.end_color.b != right.end_color.b ||
    left.end_color.a != right.end_color.a { return false }
    index: s32 = 0
    while index < 12 {
        if left.values[index] != right.values[index] { return false }
        index += 1
    }
    return true
}

#program_export
DirectDrawFrameBegin :: (viewport: Rectangle) {
    VecClear(direct_draw_current)
    direct_draw_active = true
    direct_draw_valid = true
    direct_draw_unchanged = false
    context: DirectDrawCommand
    context.kind = cast(s32)DirectDrawContext
    context.values[0] = viewport.x
    context.values[1] = viewport.y
    context.values[2] = viewport.width
    context.values[3] = viewport.height
    DirectDrawStore(context)
}

#program_export
DirectDrawTransform :: (camera: Camera) {
    transform: DirectDrawCommand
    transform.kind = cast(s32)DirectDrawTransform
    transform.values[0] = camera.offset.x
    transform.values[1] = camera.offset.y
    transform.values[2] = camera.target.x
    transform.values[3] = camera.target.y
    transform.values[4] = camera.rotation
    transform.values[5] = camera.zoom
    DirectDrawStore(transform)
}

DirectDrawRecordLine :: (start_x: s32, start_y: s32, end_x: s32,
    end_y: s32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawLine
    command.a = start_x
    command.b = start_y
    command.c = end_x
    command.d = end_y
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordLineEx :: (start: Vector2, end: Vector2,
    thickness: float32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawLineEx
    command.values[0] = start.x
    command.values[1] = start.y
    command.values[2] = end.x
    command.values[3] = end.y
    command.values[4] = thickness
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordTriangle :: (v1: Vector2, v2: Vector2, v3: Vector2,
