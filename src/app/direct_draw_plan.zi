    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawCircleV
    command.values[0] = center.x
    command.values[1] = center.y
    command.values[2] = radius
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordCircleGradient :: (center: Vector2, radius: float32,
    inner: Color, outer: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawCircleGradient
    command.values[0] = center.x
    command.values[1] = center.y
    command.values[2] = radius
    command.color = inner
    command.end_color = outer
    DirectDrawStore(command)
}

DirectDrawRecordCircleLines :: (center_x: s32, center_y: s32,
    radius: float32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawCircleLines
    command.a = center_x
    command.b = center_y
    command.values[0] = radius
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordRing :: (center: Vector2, inner_radius: float32,
    outer_radius: float32, start_angle: float32, end_angle: float32,
    segments: s32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawRing
    command.values[0] = center.x
    command.values[1] = center.y
    command.values[2] = inner_radius
    command.values[3] = outer_radius
    command.values[4] = start_angle
    command.values[5] = end_angle
    command.a = segments
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordCircleLinesEx :: (center: Vector2, radius: float32,
    thickness: float32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawCircleLinesEx
    command.values[0] = center.x
    command.values[1] = center.y
    command.values[2] = radius
    command.values[3] = thickness
    command.color = color
    DirectDrawStore(command)
}

#program_export
DirectDrawFrameFinish :: () -> bool {
    if !direct_draw_active { return false }
    direct_draw_active = false
    unchanged: bool = direct_draw_valid &&
    direct_draw_current.count == direct_draw_previous.count
    index: s32 = 0
    while unchanged && cast(s64)index < direct_draw_current.count {
        if !DirectDrawCommandsEqual(direct_draw_current[index],
            direct_draw_previous[index]) { unchanged = false }
        index += 1
    }
    VecClear(direct_draw_previous)
    if direct_draw_valid {
        index = 0
        while cast(s64)index < direct_draw_current.count {
            if !VecPush(direct_draw_previous, direct_draw_current[index]) {
                direct_draw_valid = false
                unchanged = false
            }
            index += 1
        }
    }
    direct_draw_unchanged = unchanged
    return unchanged
}

#program_export
DirectDrawFrameUnchanged :: () -> bool {
    return direct_draw_unchanged
}
