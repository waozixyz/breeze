DirectDrawRecordRectangleRounded :: (bounds: Rectangle, roundness: float32,
    segments: s32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawRectangleRounded
    command.values[0] = bounds.x
    command.values[1] = bounds.y
    command.values[2] = bounds.width
    command.values[3] = bounds.height
    command.values[4] = roundness
    command.a = segments
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordRectangleRoundedLinesEx :: (bounds: Rectangle,
    roundness: float32, segments: s32, thick: float32, color: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawRectangleRoundedLinesEx
    command.values[0] = bounds.x
    command.values[1] = bounds.y
    command.values[2] = bounds.width
    command.values[3] = bounds.height
    command.values[4] = roundness
    command.values[5] = thick
    command.a = segments
    command.color = color
    DirectDrawStore(command)
}

DirectDrawRecordRectangleGradient :: (x: s32, y: s32, width: s32,
    height: s32, top: Color, bottom: Color) {
    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawRectangleGradient
    command.a = x
    command.b = y
    command.c = width
    command.d = height
    command.color = top
    command.end_color = bottom
    DirectDrawStore(command)
}

DirectDrawRecordCircle :: (center_x: s32, center_y: s32, radius: float32,
