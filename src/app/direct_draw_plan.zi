    command: DirectDrawCommand
    command.kind = cast(s32)DirectDrawTriangle
    command.values[0] = v1.x
    command.values[1] = v1.y
    command.values[2] = v2.x
    command.values[3] = v2.y
    command.values[4] = v3.x
    command.values[5] = v3.y
    command.color = color
    DirectDrawStore(command)
}

