    APP_NAV_ROUTE_PROFILE :: 0
    APP_NAV_ROUTE_HABITS :: 1
    APP_NAV_ROUTE_PRACTICE :: 2
    APP_NAV_ROUTE_ELIST :: 3
    APP_NAV_ROUTE_SETTINGS :: 4
    APP_NAV_ROUTE_ACCOUNT :: 6
    APP_NAV_ROUTE_DATA :: 7
