#import, file "route_types.zi";
#import, file "route_list.zi";
#import, file "../apps/catalog.zi";
#import "std/utf8"

using AppNavRoute;

// Storage follows the app catalog; there is no separate favorites quota.
// The bundled apps, then one route for each slot of an app the node offers.
LAUNCHER_APP_COUNT :: 14

LauncherRoutes :: () -> [LAUNCHER_APP_COUNT]s32 {
    // Leaderboard comes last of the bundled apps, so adding it moved none.
    return .{APP_NAV_ROUTE_DIARY, APP_NAV_ROUTE_HABITS,
        APP_NAV_ROUTE_ELIST, APP_NAV_ROUTE_LUMI, APP_NAV_ROUTE_PRACTICE,
        APP_NAV_ROUTE_LEADERBOARD, AppNavNodeRoute(0), AppNavNodeRoute(1),
        AppNavNodeRoute(2), AppNavNodeRoute(3), AppNavNodeRoute(4),
        AppNavNodeRoute(5), AppNavNodeRoute(6), AppNavNodeRoute(7)}
}

// A new profile pins Lumi, Habits and Practice in this order. Lists and
// Leaderboard are also preinstalled and appear below the pinned section.
LauncherDefaults :: (routes: []s32) -> s32 {
    defaults: [3]s32 = .{APP_NAV_ROUTE_LUMI,
        APP_NAV_ROUTE_HABITS, APP_NAV_ROUTE_PRACTICE}
    count := cast(s32)defaults.count
    if routes.count < count { return 0 }
    for index: cast(s32)0..count - 1 {
        routes[index] = defaults[index]
    }
    return count
}

// The pinned order syncs between an account's devices as package names, the
// names in src/apps/catalog.zi, so it means the same apps on every version.
LAUNCHER_ORDER_TEXT_MAX :: LAUNCHER_APP_COUNT * 25

LauncherRouteName :: (route: s32) -> string {
    if route == APP_NAV_ROUTE_DIARY { return "diary" }
    if route == APP_NAV_ROUTE_HABITS { return "habits" }
    if route == APP_NAV_ROUTE_ELIST { return "lists" }
    if route == APP_NAV_ROUTE_LUMI { return "lumi" }
    if route == APP_NAV_ROUTE_PRACTICE { return "practices" }
    if route == APP_NAV_ROUTE_LEADERBOARD { return "leaderboard" }
    if route == APP_NAV_ROUTE_PROFILE { return "profile" }
    if route == APP_NAV_ROUTE_SETTINGS { return "settings" }
    // An app the node offers goes by its own name, such as "chess".
    if AppNavNodeSlot(route) >= 0 { return PackageNodeAppName(AppNavNodeSlot(route)) }
    return ""
}

LauncherRouteForName :: (name: string) -> s32 {
    if name.count == 0 { return APP_NAV_ROUTE_NONE }
    routes := LauncherRoutes()
    for index: cast(s32)0..cast(s32)routes.count - 1 {
        if LauncherRouteName(routes[index]) == name { return routes[index] }
    }
    return APP_NAV_ROUTE_NONE
}

// Writes the pinned apps as names separated by commas and returns the
// length. The output always ends with a zero byte.
LauncherOrderText :: (routes: []s32, count: s32, output: []u8) -> s32 {
    if output.count == 0 { return 0 }
    length: s32 = 0
    limit := count
    if limit > cast(s32)routes.count { limit = cast(s32)routes.count }
    for index: cast(s32)0..limit - 1 {
        name := LauncherRouteName(routes[index])
        if name.count == 0 { continue }
        needed := cast(s32)name.count
        if length > 0 { needed += 1 }
        if length + needed >= cast(s32)output.count { break }
        if length > 0 {
            output[length] = cast(u8)44
            length += 1
        }
        for byte: name {
            output[length] = byte
            length += 1
        }
    }
    output[length] = cast(u8)0
    return length
}

// Reads an order written by any version. Apps this version doesn't have
// are left out, and the others keep their order.
LauncherOrderRoutes :: (text: string, routes: []s32) -> s32 {
    count: s32 = 0
    start: s64 = 0
    while start <= text.count {
        end := start
        while end < text.count && text[end] != cast(u8)44 { end += 1 }
        route := LauncherRouteForName(text[start:end])
        if route != APP_NAV_ROUTE_NONE && count < cast(s32)routes.count &&
        !RouteListContains(routes, count, route) {
            routes[count] = route
            count += 1
        }
        start = end + 1
    }
    return count
}

LauncherSanitizeFavorites :: (routes: []s32, count: s32) -> s32 {
    allowed := LauncherRoutes()
    return RouteListSanitize(routes, count, allowed[:])
}

LauncherToggleFavorite :: (routes: []s32, count: s32, route: s32) -> s32 {
    count = LauncherSanitizeFavorites(routes, count)
    allowed := LauncherRoutes()
    if !RouteListContains(allowed[:], cast(s32)allowed.count, route) { return count }
    for index: cast(s32)0..count - 1 {
        if routes[index] == route {
            for next: index..count - 2 { routes[next] = routes[next + 1] }
            return count - 1
        }
    }
    if count < routes.count {
        routes[count] = route
        count += 1
    }
    return count
}

// Dropping an app into Favorites inserts it or moves its existing shortcut.
// It never removes another app, changes availability, or duplicates a pin.
LauncherPlaceFavorite :: (routes: []s32, count: s32, route: s32, target: s32) -> s32 {
    count = LauncherSanitizeFavorites(routes, count)
    allowed := LauncherRoutes()
    if target < 0 || target > count ||
    !RouteListContains(allowed[:], cast(s32)allowed.count, route) {
        return count
    }
    source: s32 = -1
    for index: cast(s32)0..count - 1 {
        if routes[index] == route {
            source = index
            break
        }
    }
    if source < 0 {
        if count >= routes.count {
            return count
        }
        source = count
        routes[count] = route
        count += 1
    }
    if target >= count {
        target = count - 1
    }
    unused RouteListMove(routes, count, source, target)
    return count
}

// The app's supported Latin and Cyrillic alphabets, with UTF-8 boundaries
// retained for Japanese, Chinese and Korean names.
LauncherFold :: (value: u32) -> u32 {
    if (value >= 65 && value <= 90) ||
    (value >= 192 && value <= 222 && value != 215) ||
    (value >= 1040 && value <= 1071) { return value + cast(u32)32 }
    if value >= 1024 && value <= 1039 { return value + cast(u32)80 }
    if ((value >= 256 && value <= 311) || (value >= 330 && value <= 375)) &&
    value % cast(u32)2 == 0 { return value + cast(u32)1 }
    if value >= 313 && value <= 328 && value % cast(u32)2 == 1 {
        return value + cast(u32)1
    }
    if value == 376 { return cast(u32)255 }
    return value
}

LauncherMatches :: (name: string, query: string) -> bool {
    if query.count == 0 { return true }
    start: s32 = 0
    while start < name.count {
        left := start
        right: s32 = 0
        while left < name.count && right < query.count {
            a := Decode(name, left)
            b := Decode(query, right)
            if LauncherFold(a.value) != LauncherFold(b.value) { break }
            left = a.after
            right = b.after
        }
        if right == query.count { return true }
        start = Decode(name, start).after
    }
    return false
}
