using AppNavRoute;

app_launcher_is_favorite :: (app: *InnerBreeze, route: s32) -> bool {
    return RouteListContains(app.launcher_favorites[:],
        app.launcher_favorite_count, route)
}

// The owner pinned, moved or unpinned an app. The pins and their order go
// to the account's other devices with the next sync.
app_launcher_pins_changed :: (app: *InnerBreeze) {
    app_save_app_order(app)
    save_settings(app)
}

app_launcher_uninstall :: (app: *InnerBreeze, route: s32) {
    slot := AppNavNodeSlot(route)
    if slot >= 0 {
        pinned := app_launcher_is_favorite(app, route)
        if pinned {
            app.launcher_favorite_count = LauncherToggleFavorite(
                app.launcher_favorites[:], app.launcher_favorite_count, route)
        }
        if app.breathing.screen == ScreenNodeApp && app.node_app_slot == slot {
            app_apply_nav_route(app, APP_NAV_ROUTE_LUMI)
        }
        NodeAppUninstall(slot)
        app.launcher_drag_key = 0
        app.launcher_drag_moving = false
        if pinned {
            app_launcher_pins_changed(app)
        } else {
            save_settings(app)
        }
        app_block_current_click(app)
        return
    }
    bit := app_nav_route_bit(route)
    if bit == 0 { return }
    mask := app.enabled_apps & ~bit
    if !CellsSetEnabled(mask) { return }
    app.enabled_apps = mask
    pinned := app_launcher_is_favorite(app, route)
    if pinned {
        app.launcher_favorite_count = LauncherToggleFavorite(
            app.launcher_favorites[:], app.launcher_favorite_count, route)
    }
    app.launcher_drag_key = 0
    app.launcher_drag_moving = false
    app_update_app_navigation(app)
    if pinned {
        app_launcher_pins_changed(app)
    } else {
        save_settings(app)
    }
    app_block_current_click(app)
}

app_launcher_close :: (app: *InnerBreeze) {
    if app.launcher_open && app.launcher_guide_seen == 0 {
        app.launcher_guide_seen = 1
        save_settings(app)
    }
    app.launcher_editing = false
    app.launcher_open = false
    app.launcher_pending_node = 0
    app.launcher_search_focused = false
    app.launcher_drag_key = 0
    app.launcher_drag_moving = false
    app.launcher_drag_released = false
    app_block_current_click(app)
}

app_launcher_open :: (app: *InnerBreeze) {
    if app.launcher_open { return }
    app.launcher_editing = false
    app.launcher_open = true
    app.launcher_scroll = 0
    app.launcher_search[0] = 0
    app.launcher_search_cursor = 0
    app.launcher_search_anchor = 0
    app.launcher_search_scroll = 0
    app.launcher_search_focused = false
    app.launcher_drag_key = 0
    app.launcher_drag_moving = false
    app.launcher_drag_released = false
    app_route_transition_cancel(app)
    app_block_current_click(app)
}

// A tapped app that was still downloading opens by itself once it is
// installed, as long as Apps stays open; tapping another app or leaving
// Apps forgets it.
app_launcher_open_pending :: (app: *InnerBreeze) {
    if app.launcher_pending_node == 0 {
        return
    }
    slot := app.launcher_pending_node - 1
    if !app.launcher_open {
        app.launcher_pending_node = 0
        return
    }
    if NodeAppInstalled(slot) {
        app_launcher_activate(app, AppNavNodeRoute(slot))
    }
}

// Installs an app the node offers; its card then opens it.
app_launcher_install_offer :: (app: *InnerBreeze, name: string) -> s32 {
    slot := NodeAppInstall(name)
    app_block_current_click(app)
    return slot
}

app_launcher_install :: (app: *InnerBreeze, route: s32) -> bool {
    if AppNavNodeSlot(route) >= 0 {
        return app_nav_route_available(app, route)
    }
    bit := app_nav_route_bit(route)
    if bit != 0 && (app.enabled_apps & bit) == 0 {
        if !CellsSetEnabled(app.enabled_apps | bit) { return false }
        app.enabled_apps |= bit
        app.apps_selected = 1
        app_update_app_navigation(app)
        save_settings(app)
    }
    if bit != 0 && (CellsInstalledMask() & bit) == 0 {
        for index: cast(s32)1..PackageCount - 1 {
            if PackageBit(index) == bit { PackageRequest(index) }
        }
        return false
    }
    return app_nav_route_available(app, route)
}

app_launcher_activate :: (app: *InnerBreeze, route: s32) {
    if !app_launcher_install(app, route) { return }
    // An app the node offers that is not on this device yet stays closed,
    // and Apps stays open.
    slot := AppNavNodeSlot(route)
    if slot >= 0 && !app_nav_node_app_ready(app, slot) {
        app.launcher_pending_node = slot + 1
        return
    }
    app.launcher_pending_node = 0
    if app.apps_selected == 0 {
        app.apps_selected = 1
        save_settings(app)
    }
    app_launcher_close(app)
    if app_session_window_route(app, route) { return }
    app_apply_nav_route(app, route)
    if route == APP_NAV_ROUTE_PROFILE { app.profile_return_to_settings = 0 }
}
