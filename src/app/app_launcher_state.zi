#import, file "../cells/module_host.zi";
#import, file "../cells/catalog.zi";
#import, file "../cells/package_manager.zi";

using AppNavRoute;

app_launcher_is_favorite :: (app: *InnerBreeze, route: s32) -> bool {
    return RouteListContains(app.launcher_favorites[:],
        app.launcher_favorite_count, route)
}

app_launcher_close :: (app: *InnerBreeze) {
    app.launcher_open = false
    app.launcher_search_focused = false
    app.launcher_drag_key = 0
    app.launcher_drag_moving = false
    app.launcher_drag_released = false
    app_block_current_click(app)
}

app_launcher_toggle :: (app: *InnerBreeze) {
    if app.launcher_open {
        if app.breathing.screen == ScreenAppSelection {
            return
        }
        app_launcher_close(app)
        return
    }
    app.launcher_open = true
    app.launcher_scroll = 0
    app.launcher_search[0] = 0
    app.launcher_search_cursor = 0
    app.launcher_search_anchor = 0
    app.launcher_search_scroll = 0
    app.launcher_search_focused = false
    app.launcher_drag_key = 0
    app.launcher_drag_moving = false
    app.launcher_drag_released = false
    app_route_transition_cancel(app)
    app_block_current_click(app)
}

app_launcher_activate :: (app: *InnerBreeze, route: s32) {
    bit := app_nav_route_bit(route)
    if bit != 0 && (app.enabled_apps & bit) == 0 {
        if !CellsSetEnabled(app.enabled_apps | bit) { return }
        app.enabled_apps |= bit
        app.apps_selected = 1
        app_update_app_navigation(app)
        save_settings(app)
    }
    if bit != 0 && (CellsInstalledMask() & bit) == 0 {
        for index: cast(s32)1..PackageCount - 1 {
            if PackageBit(index) == bit { PackageRequest(index) }
        }
        return
    }
    if !app_nav_route_available(app, route) { return }
    if app.apps_selected == 0 {
        app.apps_selected = 1
        save_settings(app)
    }
    app_launcher_close(app)
    app_apply_nav_route(app, route)
    if route == APP_NAV_ROUTE_PROFILE { app.profile_return_to_settings = 0 }
}
