#import, file "app_types.zi";
#import, file "../core/types.zi";
#import, file "sync_safety_policy.zi";

#program_export
app_background_sync_safe :: (app: *InnerBreeze) -> s32 {
    if app == null { return 0 }
    return ifx BackgroundSyncSafeFields(
        app.modal.active, app.habit_edit.active,
        app.sync_server_url_focused, app.sync_alias_focused,
        app.profile_friend_input_focused, app.breathing.screen) then 1 else 0
}

SyncUiUpdateSafe :: (app: *InnerBreeze, now: float64,
                     last_input_at: float64, input_active: bool) -> bool {
    if app == null { return false }
    return app_background_sync_safe(app) != 0  && SyncUserIdle(now, last_input_at, input_active)  && app.breathing.screen != ScreenStart
}
