#import "theme"
#import, file "app_types.zi";

using AppThemeMode;
using AppThemeSource;
using AppOrientationMode;

WindowSizeDecision :: struct {
    width: s32
    height: s32
    change: bool
}

#program_export
ThemeModeForSource :: (mode: AppThemeMode,
    source: AppThemeSource) -> AppThemeMode {
    if source == cast(AppThemeSource)APP_THEME_SOURCE_SYSTEM {
        return cast(AppThemeMode)APP_THEME_SYSTEM
    }
    return mode
}

#program_export
ThemeDarkFor :: (mode: AppThemeMode, system_dark: bool) -> bool {
    return ResolveDark(cast(ThemePolicy)mode, system_dark)
}

#program_export
WindowSizeForOrientation :: (mode: AppOrientationMode,
    width: s32, height: s32) -> WindowSizeDecision {
    decision: WindowSizeDecision
    decision.width = width
    decision.height = height
    if width <= 0 || height <= 0 { return decision }
    if (mode == cast(AppOrientationMode)APP_ORIENTATION_PORTRAIT  && width > height)  || (mode == cast(AppOrientationMode)APP_ORIENTATION_LANDSCAPE  && height > width) {
        decision.width = height
        decision.height = width
        decision.change = true
    }
    return decision
}
