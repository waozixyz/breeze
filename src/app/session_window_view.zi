#import "widget_kind"

c :: #system_library "c";
GetTime :: () -> float64 #foreign c;

using ButtonEmphasis;
using ModalType;
using ExerciseType;
using TextAlign;
using TextWrap;
using WidgetKind;

SESSION_WINDOW_CARD_ID :: 7480
SESSION_WINDOW_CLOSE_ID :: 7481
SESSION_WINDOW_MAXIMIZE_ID :: 7482
SESSION_WINDOW_RESIZE_ID :: 7483
SESSION_WINDOW_DETACH_ID :: 7484
// Units: the window's starting and smallest sizes, its inner margin, the
// row holding its buttons, the lines below the picture and the corner that
// resizes it.
SESSION_WINDOW_WIDTH :: 200
SESSION_WINDOW_HEIGHT :: 248
SESSION_WINDOW_MIN_WIDTH :: 160
SESSION_WINDOW_MIN_HEIGHT :: 196
SESSION_WINDOW_PADDING :: 8
SESSION_WINDOW_BUTTON_ROW :: 40
SESSION_WINDOW_TEXT_HEIGHT :: 46
SESSION_WINDOW_GRIP :: 32

session_window_practice :: (screen: s32) -> s32 {
    if screen == ScreenMeditation {
        return cast(s32)EXERCISE_MEDITATION
    }
    if screen == ScreenSunSalutation {
        return cast(s32)EXERCISE_SUN_SALUTATION
    }
    if screen == ScreenPatterns {
        return cast(s32)EXERCISE_PATTERNS
    }
    return cast(s32)EXERCISE_WIM_HOF
}

// Ends the practice from its small window the way leaving its screen does,
// over the page that is open: it asks first, with the practice's own
// choices for the time so far.
app_session_window_close :: (app: *InnerBreeze) {
    if app == null || app.session_window.screen == ScreenStart {
        return
    }
    practice := practice_get(session_window_practice(app.session_window.screen))
    if practice == null || practice.request_exit == null {
        return
    }
    route := app_current_route(app)
    practice.request_exit(app)
    // A paused practice ends without asking; the open page stays.
    if app.modal.active == 0 {
        app.session_window.screen = ScreenStart
        app_switch_route(app, route)
    }
}

// Draws the running practice's exit prompt over the open page.
session_window_exit_prompt :: (app: *InnerBreeze) -> bool {
    if app.modal.active == 0 || app.modal.type != cast(ModalType)ModalConfirmExitSession {
        return false
    }
    practice := practice_get(session_window_practice(app.session_window.screen))
    if practice == null || practice.exit_prompt == null {
        return false
    }
    route := app_current_route(app)
    // Ending the practice closes its window and keeps the open page.
    if practice.exit_prompt(app) == PRACTICE_EXIT_ENDED {
        app.session_window.screen = ScreenStart
        app_switch_route(app, route)
    }
    return true
}

// Advances the practice in its small window by the time since the last
// frame. In the background the platform timer advances it instead.
app_session_window_tick :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    // Native window input arrives between frames. Apply its practice actions
    // inside the main frame, alongside the app's own card controls.
    if app.session_window.restore_requested {
        app.session_window.restore_requested = false
        unused app_session_window_restore(app)
    }
    if app.session_window.close_requested {
        app.session_window.close_requested = false
        app_session_window_close(app)
    }
    app_session_window_take_minimize(app)
    app_session_window_note_page(app)
    if app == null || app.session_window.screen == ScreenStart {
        return
    }
    now := GetTime()
    elapsed := now - app.session_window.last_tick
    app.session_window.last_tick = now
    // A finished practice shows its results; a practice shown again by any
    // other way leaves its window.
    if app.breathing.screen == ScreenResults ||
    app.breathing.screen == app.session_window.screen {
        app.session_window.screen = ScreenStart
        return
    }
    if app.backgrounded != 0 || elapsed <= 0.0 {
        return
    }
    practice := practice_get(session_window_practice(app.session_window.screen))
    if practice == null || practice.advance_elapsed == null {
        return
    }
    // Whole milliseconds advance the practice; the rest carries to the next
    // frame, so the practice keeps the real clock's pace.
    total := elapsed * 1000.0 + app.session_window.elapsed_carry
    milliseconds := cast(s32)total
    app.session_window.elapsed_carry = total - cast(float64)milliseconds
    practice.advance_elapsed(app, milliseconds)
    if app.breathing.screen == ScreenResults {
        app.session_window.screen = ScreenStart
    }
}

// Minutes and seconds, as practices show their time.
session_window_clock :: (seconds: s32, output: []u8) -> string {
    value := seconds
    if value < 0 {
        value = 0
    }
    minutes := value / 60
    rest := value % 60
    digits: [12]u8 = .[48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48]
    count: s32 = 0
    if minutes >= 100 {
        digits[count] = cast(u8)(48 + minutes / 100 % 10)
        count += 1
    }
    if minutes >= 10 {
        digits[count] = cast(u8)(48 + minutes / 10 % 10)
        count += 1
    }
    digits[count] = cast(u8)(48 + minutes % 10)
    digits[count + 1] = cast(u8)58
    digits[count + 2] = cast(u8)(48 + rest / 10)
    digits[count + 3] = cast(u8)(48 + rest % 10)
    count += 4
    index: s32 = 0
    while index < count && index < cast(s32)output.count - 1 {
        output[index] = digits[index]
        index += 1
    }
    output[index] = 0
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// The bottom edge the window stays above: the message fields and actions
// along the bottom of the open page.
session_window_floor :: (app: *InnerBreeze) -> float32 {
    return cast(float32)(app.ui.view_height - app_content_bottom_reserved(app))
}

// Keeps the window's size between its smallest size and the page.
session_window_fit_size :: (app: *InnerBreeze) {
    margin := cast(float32)AppScale(8)
    window := *app.session_window
    widest := cast(float32)app.ui.view_width - margin * 2.0
    tallest := session_window_floor(app) - margin * 2.0
    narrowest := cast(float32)AppScale(SESSION_WINDOW_MIN_WIDTH)
    shortest := cast(float32)AppScale(SESSION_WINDOW_MIN_HEIGHT)
    if window.size.x > widest {
        window.size.x = widest
    }
    if window.size.y > tallest {
        window.size.y = tallest
    }
    if window.size.x < narrowest {
        window.size.x = narrowest
    }
    if window.size.y < shortest {
        window.size.y = shortest
    }
}

// Keeps the whole window on the page.
session_window_clamp :: (app: *InnerBreeze) {
    margin := cast(float32)AppScale(8)
    window := *app.session_window
    right := cast(float32)app.ui.view_width - window.size.x - margin
    bottom := session_window_floor(app) - window.size.y - margin
    if window.position.x > right {
        window.position.x = right
    }
    if window.position.y > bottom {
        window.position.y = bottom
    }
    if window.position.x < margin {
        window.position.x = margin
    }
    if window.position.y < margin {
        window.position.y = margin
    }
}

// The corner handle resizes the window from its bottom right while the top
// left stays in place.
session_window_resize :: (app: *InnerBreeze, bounds: Rectangle) {
    session := app.ui.session
    window := *app.session_window
    grip_size := cast(float32)AppScale(SESSION_WINDOW_GRIP)
    grip: ButtonProps
    grip.id = SESSION_WINDOW_RESIZE_ID
    grip.bounds = Rectangle.{bounds.x + bounds.width - grip_size,
        bounds.y + bounds.height - grip_size, grip_size, grip_size}
    grip.label = LocaleText("session_resize_button")
    grip.icon_only = true
    grip.icon_shape = "S1.6rr:M19 13L13 19M19 7L7 19"
    grip.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    grip.class_name = KssClassId(KssMakeName("launcher-muted"))
    key := cast(u64)grip.id
    previous := TreePrevious(session, TreeCurrentParent(session), key, WidgetKindButton)
    drag := TreeTakeDragAt(session, previous)
    if drag.started {
        window.resize_origin = Vector2.{drag.x, drag.y}
        window.resize_start = window.size
    }
    if drag.active || drag.ended {
        window.size = Vector2.{window.resize_start.x + drag.x - window.resize_origin.x,
            window.resize_start.y + drag.y - window.resize_origin.y}
        session_window_fit_size(app)
        session_window_clamp(app)
    }
    unused Button(session, grip)
    node := TreeSubmitted(session, TreeCurrentParent(session), key, WidgetKindButton)
    TreeSetDragCapture(session, node, true)
}

// The running practice's small window: tap or maximize to return, drag to
// move, and the X asks to end the practice over the open page.
app_session_window_draw :: (app: *InnerBreeze) {
    if app == null || app.session_window.screen == ScreenStart ||
    app.launcher_open || app_is_session_screen(app.breathing.screen) ||
    !SessionValid(app.ui.session) {
        return
    }
    if app.session_window.detached {
        unused session_window_exit_prompt(app)
        return
    }
    window := *app.session_window
    // It starts at the top right, clear of page titles and of the message
    // fields and actions along the bottom, and stays where it is dragged
    // and at the size it is given.
    if !window.placed {
        window.size = Vector2.{cast(float32)AppScale(SESSION_WINDOW_WIDTH),
            cast(float32)AppScale(SESSION_WINDOW_HEIGHT)}
        window.position = Vector2.{cast(float32)app.ui.view_width - window.size.x,
            cast(float32)AppScale(72)}
        window.placed = true
    }
    session_window_fit_size(app)
    session_window_clamp(app)
    width := window.size.x
    height := window.size.y
    bounds := Rectangle.{window.position.x, window.position.y, width, height}
    session := app.ui.session
    radius := cast(float32)AppScale(18)
    // The window floats above the page it covers.
    shadow := Rectangle.{bounds.x + cast(float32)AppScale(2), bounds.y + cast(float32)AppScale(6),
        width, height}
    PaintRoundedFill(session, -1, shadow, radius, 14, Color.{0, 0, 0, 64})
    Box(session, BoxProps.{.key = KeyHash("inbe/session-window/card"),
            .bounds = bounds, .fill = StyleTokenColor("surface"),
            .border = Fade(StyleTokenColor("accent"), 0.35f), .radius = radius})

    app_session_window_picture(app, window.screen, bounds,
        cast(float32)AppScale(SESSION_WINDOW_BUTTON_ROW))
    name := practice_label(session_window_practice(window.screen))

    // The whole card returns to the practice and drags the window; the
    // buttons and the corner handle are submitted after it so their taps
    // stay their own.
    card: ButtonProps
    card.id = SESSION_WINDOW_CARD_ID
    card.bounds = bounds
    card.invisible = true
    card.label = name
    key := cast(u64)card.id
    previous := TreePrevious(session, TreeCurrentParent(session), key, WidgetKindButton)
    drag := TreeTakeDragAt(session, previous)
    if drag.started {
        window.drag_moved = false
        window.drag_origin = Vector2.{drag.x, drag.y}
        window.drag_start = window.position
    }
    if drag.active || drag.ended {
        dx := drag.x - window.drag_origin.x
        dy := drag.y - window.drag_origin.y
        threshold := cast(float32)AppScale(6)
        if dx * dx + dy * dy >= threshold * threshold {
            window.drag_moved = true
        }
        if window.drag_moved {
            window.position = Vector2.{window.drag_start.x + dx, window.drag_start.y + dy}
            session_window_clamp(app)
        }
    }
    tapped := drag.ended && !window.drag_moved && TreeHoveredAt(session, previous)
    activated := Button(session, card) != 0 || tapped
    node := TreeSubmitted(session, TreeCurrentParent(session), key, WidgetKindButton)
    TreeSetDragCapture(session, node, true)
    session_window_resize(app, bounds)

    button_size := cast(float32)AppScale(36)
    if app.session_window.system_available {
        detach: ButtonProps
        detach.id = SESSION_WINDOW_DETACH_ID
        detach.bounds = Rectangle.{bounds.x + width - cast(float32)AppScale(114),
            bounds.y + cast(float32)AppScale(2), button_size, button_size}
        detach.label = LocaleText("session_detach_button")
        detach.icon_only = true
        detach.icon_shape = "S1.8rr:M13 4H20V11M20 4L11 13M10 5H4V20H19V14"
        detach.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
        detach.class_name = KssClassId(KssMakeName("launcher-action"))
        if Button(session, detach) != 0 {
            window.detach_requested = true
            return
        }
    }

    // Maximize returns to the practice; the X asks to end it right here.
    maximize: ButtonProps
    maximize.id = SESSION_WINDOW_MAXIMIZE_ID
    maximize.bounds = Rectangle.{bounds.x + width - cast(float32)AppScale(78),
        bounds.y + cast(float32)AppScale(2), button_size, button_size}
    maximize.label = LocaleText("session_maximize_button")
    maximize.icon_only = true
    maximize.icon_shape = "S1.8rr:M14 5H19V10M10 19H5V14M19 5L13 11M5 19L11 13"
    maximize.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    maximize.class_name = KssClassId(KssMakeName("launcher-action"))
    close: ButtonProps
    close.id = SESSION_WINDOW_CLOSE_ID
    close.bounds = Rectangle.{bounds.x + width - cast(float32)AppScale(42),
        bounds.y + cast(float32)AppScale(2), button_size, button_size}
    close.label = LocaleText("close_button")
    close.icon_only = true
    close.icon_shape = "S1.8rr:M6 6L18 18M18 6L6 18"
    close.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    close.class_name = KssClassId(KssMakeName("launcher-action"))
    if Button(session, maximize) != 0 {
        unused app_session_window_restore(app)
        return
    }
    if Button(session, close) != 0 {
        app_session_window_close(app)
        return
    }
    if session_window_exit_prompt(app) {
        return
    }
    if activated && !window.drag_moved {
        unused app_session_window_restore(app)
    }
}

// Shared content for the in-app card, detached desktop window and Android PiP.
app_session_window_picture :: (app: *InnerBreeze, screen: s32,
    bounds: Rectangle, button_row: float32) {
    session := app.ui.session
    width := bounds.width
    height := bounds.height
    padding := cast(float32)AppScale(SESSION_WINDOW_PADDING)
    text_height := cast(float32)AppScale(SESSION_WINDOW_TEXT_HEIGHT)
    picture := Rectangle.{bounds.x + padding, bounds.y + button_row,
        width - padding * 2.0, height - button_row - text_height - padding}
    practice := practice_get(session_window_practice(screen))
    status_text: [64]u8
    status_text[0] = 0
    status: string
    if practice != null && practice.draw_window != null {
        status = practice.draw_window(app, picture, status_text[:])
    }
    name := practice_label(session_window_practice(screen))
    text_y := picture.y + picture.height + cast(float32)AppScale(4)
    Text(session, TextProps.{.key = KeyHash("inbe/session-window/name"),
            .bounds = Rectangle.{bounds.x + padding, text_y, width - padding * 2.0,
                cast(float32)AppScale(20)},
            .text = FrameTextHold(*app.ui.frame_text, name), .font = AppScale(15),
            .wrap = cast(TextWrap)TextWrapNone,
            .align = cast(TextAlign)TextAlignCenter})
    if status.count > 0 {
        Text(session, TextProps.{.key = KeyHash("inbe/session-window/status"),
                .bounds = Rectangle.{bounds.x + padding, text_y + cast(float32)AppScale(20),
                    width - padding * 2.0, cast(float32)AppScale(18)},
                .text = FrameTextHold(*app.ui.frame_text, status), .font = AppScale(13),
                .wrap = cast(TextWrap)TextWrapNone,
                .align = cast(TextAlign)TextAlignCenter,
                .class_name = KssClassId(KssMakeName("launcher-muted"))})
    }

}
