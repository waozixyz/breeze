#import, file "../storage/sync_result.zi";

// Sync retry policy. Its behavior is fixed by the laws in sync_retry_laws.zi,
// which `ziran check` proves for every result code and retry state.

RetryDecision :: struct {
    attempt: s32
    delay: s32
    needs_action: s32
}

retry_attempt_index :: (attempt: s32) -> s32 {
    if attempt < 0 { return 0 }
    if attempt > 4 { return 4 }
    return attempt
}

// Seconds to wait before the next automatic try, by saved retry state.
retry_delay_seconds :: (attempt: s32) -> s32 {
    attempt = retry_attempt_index(attempt)
    if attempt <= 1 { return 5 }
    if attempt == 2 { return 15 }
    if attempt == 3 { return 30 }
    return 60
}

retry_is_temporary :: (result: s32) -> bool {
    return result == cast(s32) SyncResult.SYNC_CHALLENGE_FAILED ||
        result == cast(s32) SyncResult.SYNC_REQUEST_FAILED
}

#program_export
sync_retry_decision :: (result: s32, attempt: s32) -> RetryDecision {
    attempt = retry_attempt_index(attempt)
    if result == cast(s32) SyncResult.SYNC_OK {
        return RetryDecision.{0, 0, 0}
    }
    if retry_is_temporary(result) {
        next := retry_attempt_index(attempt + 1)
        return RetryDecision.{next, retry_delay_seconds(next), 0}
    }
    // Unknown and actionable results stop automatic retry.
    return RetryDecision.{attempt, 0, 1}
}

#program_export
app_sync_failure_needs_action :: (result: s32) -> s32 {
    decision: RetryDecision = sync_retry_decision(result, 0)
    return decision.needs_action
}

#program_export
app_sync_retry_delay :: (attempt: s32) -> float64 {
    return cast(float64) retry_delay_seconds(attempt)
}
