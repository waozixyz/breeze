#import, file "assets.zi";

PngDimension :: (path: string, offset: s32) -> s32 {
    asset := AssetRead(path)
    if !asset.found || asset.mime != "image/png"  || asset.data.count < 24  || asset.data[0] != 137  || asset.data[1:4] != "PNG"  || asset.data[4] != 13  || asset.data[5] != 10  || asset.data[6] != 26  || asset.data[7] != 10  || asset.data[8] != 0 || asset.data[9] != 0  || asset.data[10] != 0 || asset.data[11] != 13  || asset.data[12:16] != "IHDR" {
        return 0
    }

    value := (cast(u32)asset.data[offset] << 24) |
        (cast(u32)asset.data[offset + 1] << 16) |
        (cast(u32)asset.data[offset + 2] << 8) |
        cast(u32)asset.data[offset + 3]
    if value == 0 || value > 2147483647 {
        return 0
    }
    return cast(s32)value
}

ImageWidth :: (path: string) -> s32 {
    return PngDimension(path, 16)
}

ImageHeight :: (path: string) -> s32 {
    return PngDimension(path, 20)
}
