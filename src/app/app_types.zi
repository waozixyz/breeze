GuideOverlayStep :: struct {
    anchor: Rectangle
    text: string
}

GuideOverlayProps :: struct {
    steps: *GuideOverlayStep
    count: s32
    step: *s32
    view_width: s32
    view_height: s32
    reserved_top: s32
    reserved_bottom: s32
    max_width: s32
    line_gap: s32
    paragraph_font: s32
    previous_requested: bool
    next_requested: bool
    close_requested: bool
}

GuideOverlayResult :: struct {
    closed: s32
    finished: s32
    changed: s32
    step: s32
}

ActionIcon :: enum {
    IconBack :: 1
    IconNext :: 2
    IconCheck :: 3
    IconPause :: 4
    IconPlay :: 5
    IconClose :: 6
}

IconRowAction :: struct {
    icon: ActionIcon
    disabled: bool
}

IconRowRequest :: struct {
    center_x: s32
    view_width: s32
    view_height: s32
    count: s32
    items: *IconRowAction
}

// Inbe owns the profile picker props and result in profile_image_picker.zi.

SETTINGS_SPEED_MIN :: 1
SETTINGS_SPEED_MAX :: 8
SETTINGS_BREATHS_MIN :: 15
SETTINGS_BREATHS_MAX :: 80
SETTINGS_PAUSE_MIN :: 0
SETTINGS_PAUSE_MAX :: 30
SETTINGS_VOLUME_MIN :: 0
SETTINGS_VOLUME_MAX :: 100
SETTINGS_TITLE_H :: 50
SETTINGS_CONTENT_H :: 400
CONTENT_MAX_W :: 440
CONTENT_SIDE_PAD :: 16
CIRCLE_SIDE_PAD :: 32
FS_PATH_MAX :: 512

APP_ICON_SIZE_SMALL :: 22
APP_ICON_SIZE_MEDIUM :: 26
APP_ICON_SIZE_LARGE :: 30
APP_ICON_SIZE_SMALL_MIN :: 20
APP_ICON_SIZE_SMALL_MAX :: 36
APP_ICON_SIZE_MEDIUM_MIN :: 24
APP_ICON_SIZE_MEDIUM_MAX :: 40
APP_ICON_SIZE_LARGE_MIN :: 28
APP_ICON_SIZE_LARGE_MAX :: 44

SETTINGS_TAB_DEVICE :: 0
SETTINGS_TAB_AUDIO :: 1
SETTINGS_TAB_BREAKS :: 2
SETTINGS_TAB_NOTIFICATIONS :: 3
SETTINGS_TAB_THEME :: 4
SETTINGS_TAB_ABOUT :: 5
// Settings slot 6 is retired; keep Telegram at its persisted ID.
SETTINGS_TAB_TELEGRAM :: 7
SETTINGS_TAB_COUNT :: 8

AUDIO_CUE_BREATH_IN :: 0
AUDIO_CUE_BREATH_OUT :: 1
AUDIO_CUE_BELL :: 2
AUDIO_CUE_COUNT :: 3

STARTUP_SHOW :: 0
STARTUP_HIDDEN :: 1
STARTUP_COUNT :: 2

CLOSE_ASK :: 0
CLOSE_KEEP_RUNNING :: 1
CLOSE_QUIT :: 2
CLOSE_COUNT :: 3

AUDIO_BUILTIN_MUSIC_COUNT :: 3
AUDIO_CUSTOM_SOUND_MAX :: 8
AUDIO_CUSTOM_MUSIC_MAX :: 16
AUDIO_LABEL_SIZE :: 64
AUDIO_MUSIC_COUNT_MAX :: AUDIO_BUILTIN_MUSIC_COUNT + AUDIO_CUSTOM_MUSIC_MAX
// Sentinel for no music selected on a per-practice track slot.
AUDIO_MUSIC_NONE :: -1

PROFILE_VIEW_MAIN :: 0
PROFILE_VIEW_DATA :: 1
PROFILE_VIEW_SYNC_ACCOUNT :: 2
PROFILE_VIEW_HABITS :: 3
PROFILE_VIEW_PRACTICES :: 4

PROFILE_TAB_OVERVIEW :: 0
PROFILE_TAB_SYNC :: 1
PROFILE_TAB_DATA :: 2
PROFILE_TAB_FRIENDS :: 3
PROFILE_TAB_LEADERBOARD :: 4
PROFILE_TAB_COUNT :: 5

PRACTICE_CATEGORY_MIND :: 0
PRACTICE_CATEGORY_YOGA :: 1
PRACTICE_CATEGORY_FITNESS :: 2
PRACTICE_CATEGORY_COUNT :: 3

PendingSyncAccountAction :: enum {
    PendingSyncAccountNone :: 0
    PendingSyncAccountCreate
    PendingSyncAccountImport
}

SessionExitModalResult :: enum {
    SessionExitModalNone :: 0
    SessionExitModalCancel
    SessionExitModalSave
    SessionExitModalDiscard
}

AppClosePromptResult :: enum {
    AppClosePromptNone :: 0
    AppClosePromptKeepRunning
    AppClosePromptQuit
}

AppModal :: struct {
    active: s32
    type: ModalType
}

AppConfig :: struct {
    title: [64] u8
    width: s32
    height: s32
    loaded: s32
    title_custom: s32
}

AudioLibraryItem :: struct {
    title: [AUDIO_LABEL_SIZE] u8
    path: [FS_PATH_MAX] u8
}

AppThemeMode :: enum {
    APP_THEME_SYSTEM :: 0
    APP_THEME_LIGHT :: 1
    APP_THEME_DARK :: 2
}

AppThemeSource :: enum {
    APP_THEME_SOURCE_APP :: 0
    APP_THEME_SOURCE_SYSTEM :: 1
}

AppOrientationMode :: enum {
    APP_ORIENTATION_SYSTEM :: 0
    APP_ORIENTATION_PORTRAIT :: 1
    APP_ORIENTATION_LANDSCAPE :: 2
    APP_ORIENTATION_SENSOR :: 3
}

NavigationMode :: enum {
    NAV_MODE_TABBAR :: 0
    NAV_MODE_DROPDOWN :: 1
}

NavigationPlacement :: enum {
    NAVIGATION_AUTOMATIC :: 0
    NAVIGATION_LEFT
    NAVIGATION_BOTTOM
    NAVIGATION_RIGHT
    NAVIGATION_TOP
}

AppDeviceOrientation :: enum {
    APP_DEVICE_ORIENTATION_UNKNOWN :: 0
    APP_DEVICE_ORIENTATION_PORTRAIT :: 1
    APP_DEVICE_ORIENTATION_LANDSCAPE :: 2
}

APP_BOTTOM_NAV_CONTENT_MAX :: 7

APP_REMINDER_MAX :: 16
APP_REMINDER_PRACTICE_COUNT :: 4
APP_PUSH_DISTRIBUTOR_MAX :: 4

AppReminder :: struct {
    practice: s32
    hour: s32
    enabled: s32
    last_day: s32
}

MeditationPracticeState :: struct {
    duration_seconds: s32
    remaining_seconds: s32
    frame_ticks: s32
    complete_waiting: s32
    duration_mode: s32
    custom_minutes: s32
    show_extend_controls: s32
    interval_bell_minutes: s32
    // 0 = off; bell every N minutes
    music_track: s32
    music_practice_mask: s32
    music_practice_tracks: [EXERCISE_COUNT] s32
    music_loaded: s32
    music_playing: s32
    music_test_playing: s32
    music_fade_out_ticks: s32
    music_fade_out_total_ticks: s32
    music_archive_extracted: s32
    music_network_error_notified: s32
    music: MusicHandle
    music_download: AssetDownload
    music_cache_dir: [FS_PATH_MAX] u8
    music_status: [128] u8
}

HabitSessionEditState :: struct {
    scroll: s32
    active: s32
    kind: s32
    round: s32
    cursor: s32
    path: [FS_PATH_MAX] u8
    text: [16] u8
}

