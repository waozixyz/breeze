AUDIO_IMPORT_SUCCESS :: 1
AUDIO_IMPORT_ERROR_INVALID_PATH :: -1
AUDIO_IMPORT_ERROR_INVALID_FORMAT :: -2
AUDIO_IMPORT_ERROR_FILE_NOT_FOUND :: -3
AUDIO_IMPORT_ERROR_COPY_FAILED :: -4
AUDIO_IMPORT_ERROR_UNKNOWN :: -5
