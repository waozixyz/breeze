SessionResult :: struct {
    active: s32
    activity: s32
    primary_value: s32
    secondary_value: s32
    saved: s32
    write_failed: s32
    mood: s32
    round_count: s32
    round_values: [MaxRounds] s32
    detail: [96] u8
    path: [FS_PATH_MAX] u8
}

AppUiState :: struct {
    session: Session
    route_router: RouterState
    view_width: s32
    view_height: s32
    desktop_mode: s32
    config_scroll: s32
    pointer_active: bool
    mouse_x: s32
    mouse_y: s32
    keyboard_active: bool
    manual_previous: bool
    manual_next: bool
    manual_finish: bool
    manual_close: bool
    manual_swipe_owner: bool
    manual_swipe_frame: SwipeFrame
    text_input_active: bool
    frame_target_fps: s32
    frame_target_changed: bool
    retained_target_active: bool
    retained_frame_unchanged: bool
    route_transition_pending: bool
    route_transition_active: bool
    route_transition_started: float64
    route_transition_texture: Texture2D
    route_transition_texture_owned: bool
    frame_text: FrameTextStore
    rest_break_requested: bool
    sync_requested: bool
}

// A practice that keeps running in a small window while another app is
// open, and how far the navigation has slid onto the screen.
SessionWindow :: struct {
    // The running practice's session screen while another app is shown.
    screen: s32
    minimize_requested: bool
    detach_requested: bool
    restore_requested: bool
    close_requested: bool
    detached: bool
    system_available: bool
    system_visible: bool
    system_screen: s32
    system_generation: s32
    // Flips with Android each time the floating window opens back into the
    // app.
    system_returned: bool
    system_last_tick: float64
    system_elapsed_carry: float64
    last_tick: float64
    elapsed_carry: float64
    // The app page shown before the practice started; minimizing returns
    // there.
    origin_route: s32
    origin_known: bool
    placed: bool
    position: Vector2
    size: Vector2
    drag_moved: bool
    drag_origin: Vector2
    drag_start: Vector2
    resize_origin: Vector2
    resize_start: Vector2
    // Navigation on screen: 0 is hidden, 1 is fully shown.
    nav_shown: float32
    nav_frame_time: float64
    nav_started: bool
}

