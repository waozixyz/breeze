#import "dpi"
#import "geometry"
#import, file "../platform/environment.zi";
#import, file "../platform/raylib_host.zi";
#if #defined(PLATFORM_WEB) == false {
    #import, file "../../build/packages/kryon/src/backend/raylib_runtime.zi";
}
raylib :: #system_library "raylib";
IsWindowReady :: () -> bool #foreign raylib;
GetWindowScaleDPI :: () -> Vector2 #foreign raylib;

using DPIPlatform;

// raylib's SDL2 backend has no window scale: GetWindowScaleDPI returns 1.0
// and logs a warning on every call, once per frame here. The display
// density of an SDL2 window comes from the device host instead.
DPI_SDL2_WINDOW :: #defined(NATIVE_WINDOW_HAVE_SDL) && !#defined(ANDROID_BUILD) && !#defined(PLATFORM_WEB)

c :: #system_library "c";
device_density :: () -> float32 #foreign c "app_device_density";

dpi_state: DPIState;
dpi_user_zoom: float32 = 1.0;
last_density: float32;
last_window_scale: Vector2;

#program_export
InitDPI :: () {
    dpi_state = InitialDPI()
    last_density = 0.0
    last_window_scale = Vector2.{1.0, 1.0}
}

#program_export
CurrentDPIPlatform :: () -> DPIPlatform {
    if AndroidPlatform() != 0 {
        return cast(DPIPlatform)DPIPlatformAndroid
    }
    if WebPlatform() != 0 {
        return cast(DPIPlatform)DPIPlatformWeb
    }
    return cast(DPIPlatform)DPIPlatformDesktop
}

#program_export
UpdateDPI :: (view_width: s32, view_height: s32) {
    platform: DPIPlatform = CurrentDPIPlatform()
    window_scale := Vector2.{1.0, 1.0}
    #if !DPI_SDL2_WINDOW {
        if platform == cast(DPIPlatform)DPIPlatformDesktop && IsWindowReady() {
            window_scale = GetWindowScaleDPI()
        }
    }
    density := device_density()
    if dpi_state.base_height == 0 {
        dpi_state = InitialDPI()
    }
    if density != last_density || window_scale.x != last_window_scale.x ||
        window_scale.y != last_window_scale.y {
        dpi_state = InvalidateDPI(dpi_state)
    }
    last_density = density
    last_window_scale = window_scale
    dpi_state = ResolveDPI(dpi_state, view_width, view_height, platform,
        density, window_scale.x, window_scale.y)
    // The user's zoom scales everything drawn and narrows or widens the
    // layout; the text is baked at the size it ends up on screen.
    dpi_state = ZoomDPI(dpi_state, dpi_user_zoom)
    #if #defined(PLATFORM_WEB) == false {
        RaylibSetZoom(dpi_state.render_scale)
    }
}

// The zoom for the next UpdateDPI, 1.0 for 100%.
#program_export
SetDPIZoom :: (zoom: float32) {
    if zoom > 0.0 {
        dpi_user_zoom = zoom
    }
}

#program_export
GetDPIScale :: () -> float32 { return dpi_state.ui_scale_clamped }

#program_export
GetLayoutWidth :: () -> s32 { return dpi_state.layout_width }

#program_export
GetLayoutHeight :: () -> s32 { return dpi_state.layout_height }

#program_export
GetRenderScale :: () -> float32 { return dpi_state.render_scale }
