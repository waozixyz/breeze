#import "dpi"
#import "drawing_props"
#import "geometry"
#import, file "../platform/environment.zi";

using DPIPlatform;

c :: #system_library "c";
device_density :: () -> float32 #foreign c "app_device_density";

dpi_state: DPIState;
dpi_user_zoom: float32 = 1.0;
last_density: float32;

#if #defined(PLATFORM_WEB) {
    browser :: #system_library "browser";
    BrowserUsesViewportScale :: () -> s32 #foreign browser "browser_uses_viewport_scale";
    browser_viewport_scaled: bool;
}

#program_export
InitDPI :: () {
    dpi_state = InitialDPI()
    last_density = 0.0
    #if #defined(PLATFORM_WEB) {
        browser_viewport_scaled = BrowserUsesViewportScale() != 0
    }
}

#program_export
CurrentDPIPlatform :: () -> DPIPlatform {
    if AndroidPlatform() != 0 {
        return cast(DPIPlatform)DPIPlatformAndroid
    }
    if WebPlatform() != 0 {
        return cast(DPIPlatform)DPIPlatformWeb
    }
    return cast(DPIPlatform)DPIPlatformDesktop
}

#program_export
UpdateDPI :: (view_width: s32, view_height: s32) {
    if dpi_state.base_height == 0 {
        InitDPI()
    }
    platform: DPIPlatform = CurrentDPIPlatform()
    density := device_density()
    #if #defined(PLATFORM_WEB) {
        // Desktop browser viewports are already in CSS pixels. Use a
        // fixed base scale while the canvas handles backing pixel density.
        if !browser_viewport_scaled {
            platform = cast(DPIPlatform)DPIPlatformDesktop
            density = 1.0
        }
    }
    if density != last_density {
        dpi_state = InvalidateDPI(dpi_state)
    }
    last_density = density
    dpi_state = ResolveDPI(dpi_state, view_width, view_height, platform,
        // Every host takes its density from the device; no window reports
        // a scale of its own.
        density, 1.0, 1.0)
    // The user's zoom scales everything drawn and narrows or widens the
    // layout; the text is baked at the size it ends up on screen.
    dpi_state = ZoomDPI(dpi_state, dpi_user_zoom)
    // The camera draws at render_scale, so vector icons rasterize at it too
    // (the web canvas adds its devicePixelRatio itself). The desktop and
    // Android rasters take it with the frame's camera transform.
    #if #defined(PLATFORM_WEB) {
        SetPaintPixelScale(dpi_state.render_scale)
    }
}

// The zoom for the next UpdateDPI, 1.0 for 100%.
#program_export
SetDPIZoom :: (zoom: float32) {
    if zoom > 0.0 {
        dpi_user_zoom = zoom
    }
}

#program_export
GetDPIScale :: () -> float32 { return dpi_state.ui_scale_clamped }

#program_export
GetLayoutWidth :: () -> s32 { return dpi_state.layout_width }

#program_export
GetLayoutHeight :: () -> s32 { return dpi_state.layout_height }

#program_export
GetRenderScale :: () -> float32 { return dpi_state.render_scale }
