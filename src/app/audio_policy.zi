MusicSelection :: struct {
    selected: s32
    mask: s32
}

SoundVolumeFor :: (volume_percent: s32, scale: float32) -> float32 {
    if volume_percent <= 0 { return 0.0 }
    volume := (cast(float32)volume_percent / 100.0) * scale
    if volume < 0.0 { return 0.0 }
    if volume > 1.0 { return 1.0 }
    return volume
}

BreathCuePitchFor :: (default_ticks: s32, current_ticks: s32,
    speed_ticks: s32) -> float32 {
    if current_ticks <= 0 { current_ticks = speed_ticks }
    if current_ticks <= 0 { current_ticks = default_ticks }
    if default_ticks <= 0 { return 1.0 }
    return cast(float32)default_ticks / cast(float32)current_ticks
}

MeterLevelFor :: (peak_milli: s32, previous: float32) -> float32 {
    latest := cast(float32)peak_milli / 1000.0
    level := previous * 0.86
    if latest > previous { level = latest }
    if level < 0.01 { return 0.0 }
    if level > 1.0 { return 1.0 }
    return level
}

#program_export
MusicCountFor :: (custom: s32, builtins: s32, maximum_custom: s32) -> s32 {
    if custom < 0 { custom = 0 }
    if custom > maximum_custom { custom = maximum_custom }
    return builtins + custom
}

#program_export
MusicSelectionFor :: (selected: s32, tracks: []s32,
    count: s32, none: s32) -> MusicSelection {
    result: MusicSelection
    if count <= 0 { count = 1 }
    result.selected = selected
    if selected < 0 || selected >= count { result.selected = 0 }
    limit: s32 = cast(s32)tracks.count
    if limit > 31 { limit = 31 }
    for i: 0..(cast(int)limit - 1) {
        track: s32 = tracks[i]
        if track != none && (track < 0 || track >= count) {
            tracks[i] = none
        }
        if tracks[i] != none {
            result.mask = result.mask | (cast(s32)1 << cast(s32)i)
        }
    }
    return result
}
