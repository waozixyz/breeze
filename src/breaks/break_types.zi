BreakTicksPerSecond :: 60
BreakPreludeRepeatS :: 30
BreakPromotionWindowS :: 30

BREAK_MICRO :: 0
BREAK_REST :: 1
BREAK_DAILY :: 2
BREAK_TYPE_COUNT :: 3

BreakStateRunning :: 0
BreakStatePrompting :: 1
BreakStateSnoozed :: 2
BreakStateBreaking :: 3

BreakModeNormal :: 0
BreakModeQuiet :: 1
BreakModeSuspended :: 2

BreakEventNone :: 0
BreakEventModeExpired :: 1
BreakEventPrompt :: 2
BreakEventNatural :: 3
BreakEventPostponed :: 4
BreakEventSkipped :: 5
BreakEventTaken :: 6
BreakEventStart :: 7

BreakDayStats :: struct {
    prompts: s32
    repeated_prompts: s32
    taken: s32
    natural: s32
    skipped: s32
    postponed: s32
    overdue_s: s32
}

BreakTimer :: struct {
    enabled: s32
    limit_s: s32
    duration_s: s32
    postpone_s: s32
    max_prompts: s32
    show_skip: s32
    show_postpone: s32

    active_s: s32
    idle_s: s32
    idle_latched: s32
    snooze_s: s32
    prompt_s: s32
    prompt_count: s32
    lock_buttons_s: s32
    skipped_today: s32
    state: s32
}

BreakEngine :: struct {
    timers: [BREAK_TYPE_COUNT] BreakTimer
    stats: [BREAK_TYPE_COUNT] BreakDayStats

    usage_today_s: s32
    mode: s32
    mode_until_s: s32
    reading_mode: s32
    reading_active: s32
    micro_counts_as_activity: s32
    day_key: s32

    sectick: s32
    event: s32
    event_break: s32
}

