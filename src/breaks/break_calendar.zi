#import "date_time"

BreakDayResetHour :: 4

BreakMonthDays :: (year: s32, month: s32) -> s32 {
    if month == 2 {
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) {
            return 29
        }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    if month >= 1 && month <= 12 {
        return 31
    }
    return 0
}

#program_export
BreakDateValid :: (date: s32) -> bool {
    year := date / 10000
    month := (date / 100) % 100
    day := date % 100
    return year >= 1 && year <= 9999 && day >= 1  && day <= BreakMonthDays(year, month)
}

#program_export
BreakDateFromLocal :: (local: LocalDateTime) -> s32 {
    if !local.valid {
        return 0
    }
    date := local.year * 10000 + local.month * 100 + local.day
    if !BreakDateValid(date) {
        return 0
    }
    return date
}

#program_export
BreakPreviousDate :: (date: s32) -> s32 {
    if !BreakDateValid(date) {
        return 0
    }
    year := date / 10000
    month := (date / 100) % 100
    day := date % 100
    if day > 1 {
        day -= 1
    } else {
        month -= 1
        if month == 0 {
            if year == 1 {
                return 0
            }
            year -= 1
            month = 12
        }
        day = BreakMonthDays(year, month)
    }
    return year * 10000 + month * 100 + day
}

// The break day turns over at 04:00 local time, including at New Year.
#program_export
BreakServiceDate :: (local: LocalDateTime) -> s32 {
    date := BreakDateFromLocal(local)
    if date == 0 || local.hour < 0 || local.hour > 23 {
        return 0
    }
    if local.hour < BreakDayResetHour {
        return BreakPreviousDate(date)
    }
    return date
}

// Older settings stored year * 366 + zero-based day of year. On common years,
// the reserved final slot was used for January 1 before 04:00; it belongs to
// December 31 of the previous year.
#program_export
BreakDayFromStoredKey :: (key: s32) -> s32 {
    if key >= 10000000 && BreakDateValid(key) {
        return key
    }
    if key <= 0 {
        return 0
    }
    year: s32 = key / 366
    day_index: s32 = key % 366
    if year < 1 || year > 9999 {
        return 0
    }
    year_days: s32 = 365
    if BreakMonthDays(year, 2) == 29 {
        year_days = 366
    }
    if day_index >= year_days {
        day_index = year_days - 1
    }
    month: s32 = 1
    while month <= 12 {
        month_days: s32 = BreakMonthDays(year, month)
        if day_index < month_days {
            return year * 10000 + month * 100 + day_index + 1
        }
        day_index -= month_days
        month += 1
    }
    return 0
}

// A request for seven days includes today and the previous six civil dates.
#program_export
BreakHistoryCutoff :: (today: s32, days: s32) -> s32 {
    if !BreakDateValid(today) || days < 0 || days > 3650 {
        return 0
    }
    cutoff := today
    remaining := days - 1
    while remaining > 0 {
        cutoff = BreakPreviousDate(cutoff)
        if cutoff == 0 {
            return 0
        }
        remaining -= 1
    }
    return cutoff
}
