#import "geometry"

#scope_export
BreakReminderLayoutResult :: struct {
    text: Rectangle
    bar: Rectangle
    height: s32
}

#scope_export
BreakReminderLayout :: (bounds: Rectangle, text_height: s32,
    scale: float32) -> BreakReminderLayoutResult {
    if !(scale > 0.0) {
        scale = 1.0
    }
    if text_height < 0 {
        text_height = 0
    }

    gap: s32 = cast(s32)(4.0 * scale + 0.5)
    bar_height: s32 = cast(s32)(3.0 * scale + 0.5)
    if gap < 1 {
        gap = 1
    }
    if bar_height < 1 {
        bar_height = 1
    }

    result: BreakReminderLayoutResult
    result.text = Rectangle.{bounds.x, bounds.y, bounds.width,
        cast(float32)text_height}
    result.bar = Rectangle.{bounds.x,
        bounds.y + cast(float32)(text_height + gap), bounds.width,
        cast(float32)bar_height}
    result.height = text_height + gap + bar_height
    return result
}
