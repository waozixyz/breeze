BreakActivityThresholdMs :: 1000
BreakFallbackInputTicks :: 90
BreakActivityUnknown :: -1

BreakActivityInput :: struct {
    idle_ms: s64
    frame: s32
    focused: bool
    key_pressed: bool
    pointer_active: bool
}

BreakActivitySample :: struct {
    active: s32
    last_input_frame: s32
}

BreakAbsenceClock :: struct {
    initialized: bool
    elapsed_seconds: float64
    frame_seconds: float64
    idle_seconds: float64
    reading_idle_ms: s64
}

BreakAbsenceSample :: struct {
    clock: BreakAbsenceClock
    idle_seconds: s32
    known_away: bool
}

// The session counter proves awake idle time. The difference between the
// two clocks covers suspend even if returning input reset the session counter.
BreakObserveAbsence :: (clock: BreakAbsenceClock, elapsed_seconds: float64,
    frame_seconds: float64, idle_ms: s64, active: s32,
    backgrounded: bool, reading: bool) -> BreakAbsenceSample {
    result: BreakAbsenceSample
    result.clock = clock
    gap: float64 = 0.0
    suspended: float64 = 0.0
    if clock.initialized && elapsed_seconds >= clock.elapsed_seconds &&
        frame_seconds >= clock.frame_seconds {
        gap = elapsed_seconds - clock.elapsed_seconds
        frame_gap := frame_seconds - clock.frame_seconds
        if gap > frame_gap + 2.0 {
            suspended = gap - frame_gap
        }
    }
    result.known_away = suspended > 0.0 || backgrounded
    observed := suspended
    if active == 1 || (idle_ms >= 0 && idle_ms < clock.reading_idle_ms) {
        result.clock.reading_idle_ms = 0
    }
    if backgrounded {
        observed = clock.idle_seconds + gap
    } else if reading && !result.known_away {
        if idle_ms >= 0 {
            result.clock.reading_idle_ms = idle_ms
        }
    } else if idle_ms >= result.clock.reading_idle_ms {
        os_idle := cast(float64)(idle_ms - result.clock.reading_idle_ms) / 1000.0
        if os_idle > observed {
            observed = os_idle
        }
    }
    if observed > 2147483647.0 {
        observed = 2147483647.0
    }
    result.idle_seconds = cast(s32)observed
    result.clock.idle_seconds = ifx backgrounded then observed else 0.0
    result.clock.elapsed_seconds = elapsed_seconds
    result.clock.frame_seconds = frame_seconds
    result.clock.initialized = elapsed_seconds >= 0.0
    return result
}

// One activity decision feeds the engine used by the floating bars and overlay.
// Session idle time includes input in other applications, irrespective of focus.
BreakSampleActivity :: (input: BreakActivityInput,
    last_input_frame: s32) -> BreakActivitySample {
    sample: BreakActivitySample
    sample.last_input_frame = last_input_frame
    if input.idle_ms >= 0 {
        sample.active = ifx input.idle_ms < BreakActivityThresholdMs then 1 else 0
        return sample
    }
    sample.active = BreakActivityUnknown
    if !input.focused {
        sample.last_input_frame = 0
        return sample
    }
    // Store frame + 1 so that zero means no observed local input at startup.
    frame := input.frame + 1
    if input.key_pressed || input.pointer_active {
        sample.last_input_frame = frame
    }
    if sample.last_input_frame > 0 && frame >= sample.last_input_frame &&
        frame - sample.last_input_frame < BreakFallbackInputTicks {
        sample.active = 1
    }
    return sample
}
