BreakActivityThresholdMs :: 1000
BreakFallbackInputTicks :: 90

BreakActivityInput :: struct {
    idle_ms: s64
    frame: s32
    focused: bool
    key_pressed: bool
    pointer_active: bool
}

BreakActivitySample :: struct {
    active: s32
    last_input_frame: s32
}

// One activity decision feeds the engine used by the floating bars and overlay.
// Session idle time includes input in other applications, irrespective of focus.
BreakSampleActivity :: (input: BreakActivityInput,
    last_input_frame: s32) -> BreakActivitySample {
    sample: BreakActivitySample
    sample.last_input_frame = last_input_frame
    if input.idle_ms >= 0 {
        sample.active = ifx input.idle_ms < BreakActivityThresholdMs then 1 else 0
        return sample
    }
    if !input.focused {
        return sample
    }
    if input.key_pressed || input.pointer_active {
        sample.last_input_frame = input.frame
    }
    sample.active = ifx input.frame - sample.last_input_frame < BreakFallbackInputTicks then 1 else 0
    return sample
}
