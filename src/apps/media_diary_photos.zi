// Photos move to the account's entity data (entity_photos.zi), so each is
// kept once for the account, whichever app shows it:
//
// - A photo a released version's library keeps, cell.media.<sha256>,
//   without an entity record moves once its bytes are on this device (its
//   old copy downloads for it, diary_blobs.zi): its entity record takes
//   that record's name, day, Trash and the time it was added
//   (MediaAddBytes).
// - A photo an older version attached to a Diary entry is a Diary file
//   (diary_records.zi). Each Diary file that a day's entry still includes,
//   by a row of its "photos" list or a diary: embed in its text, moves the
//   same way, named as the entry names it and, without a camera date,
//   under the entry's day. Its library file is a link to the Diary file
//   where the platform allows. The entry keeps its diary: embed and is
//   never rewritten; Diary draws the photo by its hash (diary_photos.zi).
// - Once the sync node confirmed the photo's entity record and chunks and
//   this device downloaded them back whole (diary_blobs.zi), the photo's
//   old records name it, {"photo": "<sha256>"}, keeping every field for
//   released versions, which read them through 2027-10-24. Then its Diary
//   file leaves this device, its hex chunks from before copies shrink to
//   one byte each, and the media pass deletes its old copies from the
//   account's nodes.
//
// A Diary file no entry includes stays as it is, and so does every old copy
// whose photo is not confirmed yet. A delegate (Telegram) device moves
// nothing.
//
// A check is due at start, for another account, after each good sync and
// whenever a photo's file arrives or comes back whole. It reads the day
// entries only when the photos that have not moved, or the entries,
// changed since the last check, and moves a few photos at a time.
#import "file_linux"
#import "vec"
#import "text"
#import "byte_text_linux"
#import "text_buffer"
#import "json_scan"
#import, file "diary_records.zi";
#import, file "diary_store.zi";
#import, file "entity_photos.zi";
#import, file "media_store.zi";
#import, file "package_files.zi";
#import, file "../storage/bundled_app_records.zi";
#import, file "../storage/entity_records.zi";
#import, file "../storage/media_records.zi";
#import, file "../storage/storage_core.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../storage/sqlite.zi";
#import, file "../storage/db.zi";
#import, file "../storage/state.zi";
#import, file "../storage/sync_nodes.zi";
#import, file "../storage/temporary_data.zi";
#import, file "../storage/paths.zi";
#import, file "../app/text_buffers.zi";
DiaryMarkdown :: #import, file "../../apps/diary/diary_markdown.zi";

MEDIA_DIARY_PHOTOS_MAX :: 1024
// Photos one step moves; each one makes a preview.
MEDIA_DIARY_PHOTOS_PER_STEP :: 4

MediaDiaryPhoto :: struct {
    file: [201]u8
    hash: [65]u8
    // This device has its bytes: its file, or its chunks from before copies.
    local: bool
    // The first entry that includes it gives its day and its name.
    named: bool
    day: [11]u8
    name: [MEDIA_NAME_MAX + 1]u8
}

// Diary files that have not moved, from the last look.
media_diary_photos: [MEDIA_DIARY_PHOTOS_MAX]MediaDiaryPhoto;
media_diary_photo_count: s32;
// Library photos of a released version that have not moved and whose
// bytes are here.
media_library_photos: [MEDIA_DIARY_PHOTOS_MAX][65]u8;
media_library_photo_count: s32;
media_diary_due: bool = true;
media_diary_owner: [72]u8;
media_diary_generation: s64 = -1;
// What the last finished check saw, so an unchanged account is not read
// again.
media_diary_seen: u64;
media_diary_seen_valid: bool;
// A check is moving its photos, from media_diary_next and
// media_library_next on.
media_diary_adding: bool;
media_diary_next: s32;
media_library_next: s32;

MediaDiaryPhotosSQL :: #string SQL_END
SELECT substr(d.key,17),d.value FROM settings d
WHERE d.user_id=?1 AND d.key GLOB 'cell.diary.file.*' AND d.key NOT GLOB '*.json'
  AND json_valid(d.value) AND json_type(d.value,'$.photo') IS NULL
  AND NOT EXISTS (SELECT 1 FROM settings e WHERE e.user_id=?1
    AND e.key='entity.photos.'||json_extract(d.value,'$.hash'))
ORDER BY d.key
SQL_END;

MediaLibraryPhotosSQL :: #string SQL_END
SELECT substr(l.key,12),json_extract(l.value,'$.size') FROM settings l
WHERE l.user_id=?1 AND l.key GLOB 'cell.media.*' AND length(l.key)=75
  AND substr(l.key,12) NOT GLOB '*[^0-9a-f]*' AND json_valid(l.value)
  AND json_type(l.value,'$.photo') IS NULL
  AND NOT EXISTS (SELECT 1 FROM settings e WHERE e.user_id=?1 AND e.key='entity.photos.'||substr(l.key,12))
ORDER BY l.key
SQL_END;

MediaDiaryEntriesSQL :: #string SQL_END
SELECT key,value FROM settings
WHERE user_id=?1 AND key GLOB 'cell.diary.file.????-??-??.json'
ORDER BY key
SQL_END;

// The old records of moved photos that do not name their entity record
// yet: each with the photo's hash.
MediaOldRecordsSQL :: #string SQL_END
SELECT o.key,o.value,
  CASE WHEN o.key GLOB 'cell.diary.file.*' THEN json_extract(o.value,'$.hash') ELSE substr(o.key,length(o.key)-63) END
FROM settings o
WHERE o.user_id=?1 AND json_valid(o.value) AND json_type(o.value,'$.photo') IS NULL
  AND ((o.key GLOB 'cell.diary.file.*' AND o.key NOT GLOB '*.json')
    OR (o.key GLOB 'cell.media.*' AND (length(o.key)=75 OR length(o.key)=83)))
  AND EXISTS (SELECT 1 FROM settings e WHERE e.user_id=?1 AND e.key='entity.photos.'||
    CASE WHEN o.key GLOB 'cell.diary.file.*' THEN json_extract(o.value,'$.hash') ELSE substr(o.key,length(o.key)-63) END)
ORDER BY o.key
SQL_END;

// Asks for a check, such as after a sync brought entries.
MediaDiaryPhotosDue :: () {
    media_diary_due = true
}

// Whether this device may move photos: not a delegate's.
MediaMovesAllowed :: () -> bool {
    return storage_delegate_mode == null || storage_delegate_mode() != 2
}

// An FNV-1a style checksum step, with a separator after the text.
MediaDiaryMix :: (checksum: u64, text: string) -> u64 {
    value := checksum
    for byte: text {
        value = (value ^ cast(u64)byte) * 1099511628211
    }
    return (value ^ cast(u64)255) * 1099511628211
}

MediaDiaryBytesMatch :: (data: string, hash: string) -> bool {
    if data.count == 0 {
        return false
    }
    descriptor := cast(*TextDescriptor)(*data)
    actual: [65]u8
    storage_sha256_hex(descriptor.data, data.count, *actual[0])
    return TextFromCString(*actual[0]) == hash
}

// A Diary file's entry as a photo to look at, or false for one that is not.
MediaDiaryPhotoRead :: (file: string, entry: string, photo: *MediaDiaryPhoto) -> bool {
    if !DiaryStoreNameValid(file) || !AppCopyText(file, photo.file[:]) {
        return false
    }
    media := DiaryMediaParse(entry)
    if media.valid {
        photo.hash = media.hash
        path := DiaryStorePath(file)
        photo.local = PackageFileSize(path) == media.size
        PackageFree(path)
        return true
    }
    // A photo from before copies, kept as chunks.
    if FieldAt(entry, 0, "count") < 0 ||
    ReadStringText(entry, FieldAt(entry, 0, "hash"), photo.hash[:]) != 64 ||
    !DiaryHex64(TextFromBytes(photo.hash[:64])) {
        return false
    }
    photo.local = true
    return true
}

// Lists the photos that have not moved and answers a checksum of what
// decides the check: those photos, whether their bytes are here, the old
// records of moved photos and, when there are Diary files, every day entry.
MediaDiaryPhotosCollect :: () -> u64 {
    media_diary_photo_count = 0
    media_library_photo_count = 0
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    checksum := MediaDiaryMix(1469598103934665603, owner)
    statement: *void
    if SqlitePrepareText(storage_db_handle(), MediaDiaryPhotosSQL, -1, *statement, null) != SQLITE_OK {
        return checksum
    }
    unused bind_text(statement, 1, owner)
    while SqliteStep(statement) == SQLITE_ROW {
        file := AppTextFromCString(SqliteColumnText(statement, 0), 201)
        entry := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
        photo := MediaDiaryPhoto.{}
        if !MediaDiaryPhotoRead(file, entry, *photo) {
            continue
        }
        checksum = MediaDiaryMix(checksum, file)
        checksum = MediaDiaryMix(checksum, TextUntilNul(photo.hash[:]))
        checksum = MediaDiaryMix(checksum, ifx photo.local then "1" else "0")
        if media_diary_photo_count < MEDIA_DIARY_PHOTOS_MAX {
            media_diary_photos[media_diary_photo_count] = photo
            media_diary_photo_count += 1
        }
    }
    SqliteFinalize(statement)
    if SqlitePrepareText(storage_db_handle(), MediaLibraryPhotosSQL, -1, *statement, null) == SQLITE_OK {
        unused bind_text(statement, 1, owner)
        while SqliteStep(statement) == SQLITE_ROW {
            hash := AppTextFromCString(SqliteColumnText(statement, 0), 65)
            path := MediaPath(hash, false)
            local := PackageFileSize(path) == SqliteColumnInt64(statement, 1)
            PackageFree(path)
            checksum = MediaDiaryMix(checksum, hash)
            checksum = MediaDiaryMix(checksum, ifx local then "1" else "0")
            if local && media_library_photo_count < MEDIA_DIARY_PHOTOS_MAX {
                unused AppCopyText(hash, media_library_photos[media_library_photo_count][:])
                media_library_photo_count += 1
            }
        }
        SqliteFinalize(statement)
    }
    if SqlitePrepareText(storage_db_handle(), MediaOldRecordsSQL, -1, *statement, null) == SQLITE_OK {
        unused bind_text(statement, 1, owner)
        while SqliteStep(statement) == SQLITE_ROW {
            checksum = MediaDiaryMix(checksum, AppTextFromCString(SqliteColumnText(statement, 0), 181))
        }
        SqliteFinalize(statement)
    }
    if media_diary_photo_count == 0 {
        return checksum
    }
    // An entry's record names the hash of its document, so any change to
    // an entry changes it.
    if SqlitePrepareText(storage_db_handle(), MediaDiaryEntriesSQL, -1, *statement, null) != SQLITE_OK {
        return checksum
    }
    unused bind_text(statement, 1, owner)
    while SqliteStep(statement) == SQLITE_ROW {
        checksum = MediaDiaryMix(checksum, AppTextFromCString(SqliteColumnText(statement, 0), 181))
        checksum = MediaDiaryMix(checksum, AppTextFromCString(SqliteColumnText(statement, 1), 65536))
    }
    SqliteFinalize(statement)
    return checksum
}

// The JSON string at `at`, to free with PackageFree, or "".
MediaDiaryDecode :: (document: string, at: s32) -> string {
    if at < 0 {
        return ""
    }
    bytes: Vec(u8)
    for index: 0..document.count {
        if !VecPush(bytes, cast(u8)0) {
            VecFree(bytes)
            return ""
        }
    }
    count := ReadStringText(document, at, VecSlice(bytes, 0, bytes.count))
    if count <= 0 {
        VecFree(bytes)
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "%", TextFromBytes(VecSlice(bytes, 0, count)))
    VecFree(bytes)
    return BuilderFinish(out)
}

// The first entry, in day order, that includes a Diary file gives the
// photo its day and name.
MediaDiaryNamed :: (file: string, name: string, day: string) {
    for index: cast(s32)0..media_diary_photo_count - 1 {
        photo := *media_diary_photos[index]
        if photo.named || TextUntilNul(photo.file[:]) != file {
            continue
        }
        photo.named = true
        unused AppCopyText(day, photo.day[:])
        if !AppCopyText(MediaNameCut(name), photo.name[:]) {
            photo.name[0] = cast(u8)0
        }
    }
}

// Marks the photos one day's entry includes, as Diary shows them: its
// "photos" rows, then the diary: embeds in its text. A document Diary
// cannot open, which it shows without photos, includes none.
MediaDiaryEntryRead :: (name: string) {
    day := name[:10]
    document := DiaryRecordRead(name)
    defer { PackageFree(document) }
    if document.count == 0 || !MediaDayValid(day) {
        return
    }
    version := ReadNumber(document, FieldAt(document, 0, "version"))
    date: [11]u8
    text := FieldAt(document, 0, "text")
    rows := FieldAt(document, 0, "photos")
    count := ArrayCount(document, rows)
    if !version.valid || version.value != 1.0 ||
    ReadStringText(document, FieldAt(document, 0, "date"), date[:]) != 10 ||
    TextFromBytes(date[:10]) != day || text < 0 || document[text] != cast(u8)34 || count < 0 ||
    cast(s64)Space(document, ValueEnd(document, 0, 0)) != document.count {
        return
    }
    for index: cast(s32)0..count - 1 {
        row := ElementAt(document, rows, index)
        file := FieldAt(document, row, "file")
        label := FieldAt(document, row, "name")
        if file < 0 || document[file] != cast(u8)34 || label < 0 || document[label] != cast(u8)34 {
            return
        }
    }
    for index: cast(s32)0..count - 1 {
        row := ElementAt(document, rows, index)
        file := MediaDiaryDecode(document, FieldAt(document, row, "file"))
        label := MediaDiaryDecode(document, FieldAt(document, row, "name"))
        MediaDiaryNamed(file, label, day)
        PackageFree(file)
        PackageFree(label)
    }
    body := MediaDiaryDecode(document, text)
    defer { PackageFree(body) }
    embed := DiaryMarkdown.DiaryEmbedNext(body, 0)
    while embed.valid {
        if !embed.library {
            MediaDiaryNamed(DiaryMarkdown.DiaryEmbedTarget(body, embed),
                DiaryMarkdown.DiaryEmbedAlt(body, embed), day)
        }
        embed = DiaryMarkdown.DiaryEmbedNext(body, embed.end)
    }
}

MediaDiaryEntriesRead :: () {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), MediaDiaryEntriesSQL, -1, *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    while SqliteStep(statement) == SQLITE_ROW {
        key: [181]u8
        if !AppCopyText(AppTextFromCString(SqliteColumnText(statement, 0), 181), key[:]) {
            continue
        }
        MediaDiaryEntryRead(TextUntilNul(key[:])[16:])
    }
}

// Moves one photo an entry includes, unless it moved already.
MediaDiaryPhotoAdd :: (photo: *MediaDiaryPhoto) -> bool {
    hash := TextUntilNul(photo.hash[:])
    record := MediaEntityRecord(hash)
    present := record.count > 0
    PackageFree(record)
    if present {
        return false
    }
    file := TextUntilNul(photo.file[:])
    path := DiaryStorePath(file)
    defer { PackageFree(path) }
    data := PackageRead(path, DIARY_FILE_LIMIT)
    source := path
    if !MediaDiaryBytesMatch(data, hash) {
        // A photo from before copies: its chunks, checked by their hash.
        PackageFree(data)
        data = DiaryRecordRead(file)
        source = ""
    }
    defer { PackageFree(data) }
    if !MediaDiaryBytesMatch(data, hash) {
        return false
    }
    addition := MediaAddition.{.name = TextUntilNul(photo.name[:]), .day = TextUntilNul(photo.day[:]),
        .source = source}
    return MediaAddBytes(data, addition).succeeded
}

// Moves one photo of a released version's library whose bytes are here.
MediaLibraryPhotoAdd :: (hash: string) -> bool {
    path := MediaPath(hash, false)
    data := PackageRead(path, DIARY_FILE_LIMIT)
    defer {
        PackageFree(path)
        PackageFree(data)
    }
    if !MediaDiaryBytesMatch(data, hash) {
        return false
    }
    return MediaAddBytes(data, MediaAddition.{.source = path}).succeeded
}

// Fields a released version's library record has and the photo's entity
// record lacks, as when another app moved the photo first: the entity
// record takes them, so nothing the old record knew is lost. True when the
// entity record changed; it goes out again before the old record may name
// it.
MediaEntityAddMissing :: (hash: string, legacy: string) -> bool {
    item := MediaParseLegacy(legacy)
    key := EntityPhotoKey(hash)
    record := MediaRecordRead(key)
    defer {
        PackageFree(key)
        PackageFree(record)
    }
    if !item.valid || record.count == 0 {
        return false
    }
    names: [3]string = .["name", "day", "taken"]
    values: [3]string = .[TextUntilNul(item.name[:]), TextUntilNul(item.day[:]), TextUntilNul(item.taken[:])]
    updated := PackageText(record, "")
    changed := false
    for index: 0..2 {
        if FieldAt(updated, 0, names[index]) >= 0 || values[index].count == 0 {
            continue
        }
        quoted: Vec(u8)
        MediaJson(*quoted, values[index])
        value := BuilderFinish(quoted)
        next := MediaRecordWith(updated, names[index], value)
        PackageFree(value)
        if next.count > 0 {
            PackageFree(updated)
            updated = next
            changed = true
        }
    }
    if FieldAt(updated, 0, "trashed") < 0 {
        next := MediaRecordWith(updated, "trashed", ifx item.trashed then "true" else "false")
        if next.count > 0 {
            PackageFree(updated)
            updated = next
            changed = true
        }
    }
    if FieldAt(updated, 0, "added_at") < 0 && item.added > 0 {
        number: Vec(u8)
        BuilderPrint(*number, "%", item.added)
        value := BuilderFinish(number)
        next := MediaRecordWith(updated, "added_at", value)
        PackageFree(value)
        if next.count > 0 {
            PackageFree(updated)
            updated = next
            changed = true
        }
    }
    written := changed && MediaRecordWrite(key, updated)
    PackageFree(updated)
    return written
}

// The record with "photo" naming its entity record, keeping every field.
MediaPointed :: (record: string, hash: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "\"%\"", hash)
    quoted := BuilderFinish(out)
    defer { PackageFree(quoted) }
    return MediaRecordWith(record, "photo", quoted)
}

// A photo from before copies frees its chunks once it moved: each becomes
// one byte, so its room on the node shrinks with it.
MediaShrinkChunks :: (entry: string, hash: string) {
    count := ReadNumber(entry, FieldAt(entry, 0, "count"))
    if !count.valid || count.value < 1.0 || count.value > 16384.0 {
        return
    }
    storage_settings_begin_write()
    defer { storage_settings_end_write() }
    for index: cast(s32)0..cast(s32)count.value - 1 {
        chunk := DiaryChunkKey(hash, index)
        unused BundledAppRecordWrite(chunk, "-")
        PackageFree(chunk)
    }
}

// The Diary file of a moved photo leaves this device once its library file
// holds the same bytes; one that is the only copy here becomes the
// library's file first.
MediaDiaryFileMoved :: (name: string, hash: string, size: s64) {
    diary_path := DiaryStorePath(name)
    library_path := MediaPath(hash, false)
    defer {
        PackageFree(diary_path)
        PackageFree(library_path)
    }
    if !PathExists(diary_path) {
        return
    }
    library := PackageRead(library_path, DIARY_FILE_LIMIT)
    if library.count != size || !MediaDiaryBytesMatch(library, hash) {
        PackageFree(library)
        diary := PackageRead(diary_path, DIARY_FILE_LIMIT)
        directory := MediaDirectory()
        placed := MediaDiaryBytesMatch(diary, hash) && directory.count > 0 && storage_ensure_dir(directory) != 0 &&
        MediaPlaceFile(library_path, diary, diary_path)
        PackageFree(directory)
        PackageFree(diary)
        library = PackageRead(library_path, DIARY_FILE_LIMIT)
        if !placed {
            PackageFree(library)
            return
        }
    }
    same := library.count == size && MediaDiaryBytesMatch(library, hash)
    PackageFree(library)
    if same {
        unused RemoveFile(diary_path)
        diary_blob_generation += 1
    }
}

// Diary files of photos whose entries name their entity record, on this
// device still, as when another device moved them.
MediaPointedFilesSQL :: #string SQL_END
SELECT substr(key,17),json_extract(value,'$.hash'),json_extract(value,'$.size') FROM settings
WHERE user_id=?1 AND key GLOB 'cell.diary.file.*' AND key NOT GLOB '*.json' AND json_valid(value)
  AND json_extract(value,'$.photo')=json_extract(value,'$.hash') AND json_type(value,'$.count') IS NULL
  AND EXISTS (SELECT 1 FROM settings e WHERE e.user_id=?1 AND e.key='entity.photos.'||json_extract(value,'$.hash'))
ORDER BY key
SQL_END;

// The Diary files of moved photos leave this device, a few per step.
MediaPointedFilesMove :: () {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), MediaPointedFilesSQL, -1, *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    moved: s32 = 0
    while moved < MEDIA_DIARY_PHOTOS_PER_STEP && SqliteStep(statement) == SQLITE_ROW {
        name := PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 201), "")
        hash := PackageText(AppTextFromCString(SqliteColumnText(statement, 1), 65), "")
        path := DiaryStorePath(name)
        if DiaryStoreNameValid(name) && MediaHashValid(hash) && PathExists(path) {
            MediaDiaryFileMoved(name, hash, SqliteColumnInt64(statement, 2))
            moved += 1
        }
        PackageFree(path)
        PackageFree(name)
        PackageFree(hash)
    }
}

// Old records of moved photos name the entity record once the sync node
// confirmed the photo and this device downloaded it back whole; then the
// photo's old copies on this device go. A few records per step.
MediaOldRecordsPoint :: () -> bool {
    sync_node: [256]u8
    if !SyncNodeAddress(storage_get_setting_text("sync_server_url"), sync_node[:]) {
        return false
    }
    node := TextUntilNul(sync_node[:])
    statement: *void
    if SqlitePrepareText(storage_db_handle(), MediaOldRecordsSQL, -1, *statement, null) != SQLITE_OK {
        return false
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    pointed: s32 = 0
    while pointed < MEDIA_DIARY_PHOTOS_PER_STEP && SqliteStep(statement) == SQLITE_ROW {
        key := PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 181), "")
        entry := PackageText(AppTextFromCString(SqliteColumnText(statement, 1), 65536), "")
        hash := PackageText(AppTextFromCString(SqliteColumnText(statement, 2), 65), "")
        defer {
            PackageFree(key)
            PackageFree(entry)
            PackageFree(hash)
        }
        record := MediaEntityRecord(hash)
        ready := MediaHashValid(hash) && EntityPhotoConfirmed(hash, record, node) && EntityPhotoVerified(record, node)
        PackageFree(record)
        if !ready {
            continue
        }
        if MediaItemKeyHash(key).count == 64 && MediaEntityAddMissing(hash, entry) {
            continue
        }
        named := MediaPointed(entry, hash)
        defer { PackageFree(named) }
        diary_name := ifx key.count > 16 && key[:16] == "cell.diary.file." then key[16:] else ""
        written := false
        if diary_name.count > 0 {
            written = named.count > 0 && BundledAppRecordWrite(key, named)
        } else {
            written = named.count > 0 && MediaRecordWrite(key, named)
        }
        if !written {
            continue
        }
        pointed += 1
        if diary_name.count == 0 {
            continue
        }
        if FieldAt(entry, 0, "count") >= 0 {
            MediaShrinkChunks(entry, hash)
        } else {
            size := ReadNumber(entry, FieldAt(entry, 0, "size"))
            if size.valid {
                MediaDiaryFileMoved(diary_name, hash, cast(s64)size.value)
            }
        }
    }
    return pointed > 0
}

// Does a little of the work while a check is due or moving photos; true
// while more is waiting.
MediaDiaryPhotosStep :: () -> bool {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if TextUntilNul(media_diary_owner[:]) != owner {
        unused AppCopyText(owner, media_diary_owner[:])
        media_diary_seen_valid = false
        media_diary_adding = false
        media_diary_due = true
    }
    if media_diary_generation != diary_blob_generation {
        media_diary_generation = diary_blob_generation
        media_diary_due = true
    }
    if owner.count == 0 || DataTemporary() || storage_db_handle() == null || !MediaMovesAllowed() {
        media_diary_adding = false
        return false
    }
    if media_diary_adding {
        added: s32 = 0
        while media_diary_next < media_diary_photo_count && added < MEDIA_DIARY_PHOTOS_PER_STEP {
            photo := *media_diary_photos[media_diary_next]
            media_diary_next += 1
            if photo.named && photo.local {
                unused MediaDiaryPhotoAdd(photo)
                added += 1
            }
        }
        while media_library_next < media_library_photo_count && added < MEDIA_DIARY_PHOTOS_PER_STEP {
            hash := TextUntilNul(media_library_photos[media_library_next][:])
            media_library_next += 1
            unused MediaLibraryPhotoAdd(hash)
            added += 1
        }
        if media_diary_next < media_diary_photo_count || media_library_next < media_library_photo_count {
            return true
        }
        if MediaOldRecordsPoint() {
            return true
        }
        // What is left waits for a change: its bytes, an entry naming it,
        // or the node confirming a moved photo.
        media_diary_adding = false
        media_diary_seen = MediaDiaryPhotosCollect()
        media_diary_seen_valid = true
        return false
    }
    if !media_diary_due {
        return false
    }
    media_diary_due = false
    MediaPointedFilesMove()
    seen := MediaDiaryPhotosCollect()
    if media_diary_seen_valid && seen == media_diary_seen {
        // Nothing new to move. Moved photos the node confirmed since may
        // name their old records now, and those records go out.
        if MediaOldRecordsPoint() {
            media_diary_due = true
        }
        return false
    }
    media_diary_seen = seen
    media_diary_seen_valid = true
    if media_diary_photo_count > 0 {
        MediaDiaryEntriesRead()
    }
    media_diary_adding = true
    media_diary_next = 0
    media_library_next = 0
    return true
}
