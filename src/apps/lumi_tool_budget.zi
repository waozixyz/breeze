// Leave room for read, inspect, preview, verify and save in one conversation.
// The call and round limits also bound repeated or unproductive model actions.
LumiToolRoundAllowed :: (round: s32, calls: s32, used: s32) -> bool {
    return round >= 0 && round < 6 && calls > 0 && calls <= 4 &&
    used >= 0 && used + calls <= 12
}
