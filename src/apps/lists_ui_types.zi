#import "session"
#import "text_input_props"

ListsUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    input: TextFieldInput
    value: string
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    scroll: s32
    clipboard_write: bool
    clipboard_text: string
    tab_scroll: s32
    panel: s32
    sharing_status: s32
    sharing_busy: bool
    sharing_pending: bool
    connected: bool
    public_id: string
    friend_count: s32
    invitation_count: s32
    pending_count_text: string
    next_id: string
    // This account's profile picture, an icon number; 0 when none is set.
    profile_icon: s32
}

ListsUiRow :: struct {
    id: string
    parent_id: string
    title: string
    comment: string
    done: s32
    sort_order: s32
    shared: bool
    owner: bool
    // The account that owns the list, so a friend who owns it is never offered an invitation.
    owner_id: string
    owner_alias: string
    read_only: bool
    revision: s64
    incomplete: bool
    // Names, comma separated: who shared a list this account does not own,
    // or the friends who joined a list it owns.
    people: string
    // Friends invited to a list this account owns who have not answered.
    invited: string
}

ListsUiPerson :: struct {
    id: string
    alias: string
    owner: string
    target: string
    list_id: string
    title: string
    status: string
    target_alias: string
    access: string
    // The profile picture of the friend, or of the invited person or the
    // list's owner; 0 when it is not known.
    profile_icon: s32
}

ListsUiRequest :: struct {
    action: s32
    index: s32
    editing_item: s32
    selected_list: s32
    done: s32
    value: string
    next_id: string
    target: string
    access: string
    invitation: string
    list_id: string
    item_id: string
    comment: string
}
