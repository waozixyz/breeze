// Stable native runtime storage shared by the loader and Apps provider.
#import "hosted_app"
#import "kryon/app_context_host"
Nested :: #import "apps/host";
#import, file "package_release.zi";

NodeAppRunner :: struct {
    app: HostedApp
    nested: *Nested.AppHost
    portable: AppContext
    generic: bool
    release_hash: [65]u8
    // Bind a trusted-root fallback to its own publisher, never stale metadata
    // from a downloaded release that failed current-descriptor validation.
    embedded_release: PackageRelease
    // Last package generation reviewed at the host's safe reload boundary.
    checked_revision: s32
    // Keep a verified replacement pending when the live app cannot save yet.
    reload_pending: bool
    bundle_bytes: s64
    received: bool
    has_read: bool
    has_write: bool
}
