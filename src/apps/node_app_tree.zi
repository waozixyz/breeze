using HostValueKind;

// Set by the build from the reviewed shared controller, never from the
// container being opened. Empty means collection support is unavailable.
// Runtime storage is native-owned and stable; validating a replacement has
// its own instance and never overwrites a live slot or persists its handles.
node_tree_hosts: [NodeAppSlots * 2]AppHost;
node_tree_validating: bool;
node_tree_widget_node: *AppNode;
NodeTreeImage :: struct {
    path: string
    packed: string
    digest: [65]u8
    // Borrowed from the runtime until frame collection. Back can free its
    // AppNode before then, so rendering must never resolve through that node.
    data: string
}
node_tree_images: Vec(NodeTreeImage);
node_tree_person_codec: Codec.WidgetAppPersonCodec;
node_tree_shared_codec: Codec.WidgetAppSharedCodec;
node_tree_item_codec: Codec.WidgetAppSharedItemCodec;
node_tree_invitation_codec: Codec.WidgetAppInvitationCodec;
node_tree_record: string;
node_tree_owner: [25]u8;

NodeTreeAccount :: () -> string {
    return AppTextFromCString(storage_user_id_buffer(), 64)
}

// The signed release a slot's collection runs as: the installed one, or the
// download being checked before it is installed. A collection's first
// install has no installed release, so checking it used to always fail.
NodeTreeRelease :: (slot: s32) -> PackageRelease {
    index := NodeAppIndex(slot)
    if node_tree_validating && package_index == index && package_release.valid {
        return package_release
    }
    return package_cached_releases[index]
}

NodeTreeAuthority :: (runner: *NodeAppRunner, output: []u8) -> bool {
    slot := NodeAppSlotOf(runner)
    if slot < 0 {
        return false
    }
    // Local fixtures have a separate trust domain and cannot impersonate a
    // publisher or silently acquire that publisher's historical save namespace.
    if NodeAppLocal(NodeAppName(slot)) {
        return CopyCString("local-development", output)
    }
    release := NodeTreeRelease(slot)
    if !release.valid {
        return false
    }
    metadata: Vec(u8)
    BuilderPrint(*metadata, "{\"key_id\":\"%\"}", TextUntilNul(release.key_id[:]))
    text := BuilderFinish(metadata)
    defer { PackageFree(text) }
    return PackageTrustedKeyFor(text, PackageID(NodeAppIndex(slot)), output)
}

// The old record name is retained only for a canonical legacy app carried
// by the same verified publisher that was allowed to offer that app before.
NodeTreeLegacyOwner :: (runner: *NodeAppRunner, node: *AppNode) -> string {
    slot := NodeAppSlotOf(runner)
    if slot < 0 {
        return ""
    }
    name := TextUntilNul(node.entry.expected_id[:])
    if !NodeAppNameValid(name) {
        return ""
    }
    expected := PackageText("inbe.", name)
    defer { PackageFree(expected) }
    if TextUntilNul(node.identity.id[:]) != expected {
        return ""
    }
    release := NodeTreeRelease(slot)
    if !release.valid {
        return ""
    }
    metadata: Vec(u8)
    BuilderPrint(*metadata, "{\"key_id\":\"%\"}", TextUntilNul(release.key_id[:]))
    text := BuilderFinish(metadata)
    defer { PackageFree(text) }
    authority: [65]u8
    if !PackageTrustedKeyFor(text, expected, authority[:]) ||
    TextUntilNul(authority[:]) != TextUntilNul(node.identity.authority[:]) {
        return ""
    }
    unused CopyCString(name, node_tree_owner[:])
    return TextUntilNul(node_tree_owner[:])
}

NodeTreeRecordKey :: (runner: *NodeAppRunner, node: *AppNode, record: string) -> string {
    legacy := NodeTreeLegacyOwner(runner, node)
    if legacy != "" {
        return NodeAppRecordKey(legacy, record)
    }
    key := AppIdentityRecordKey(TextUntilNul(node.identity.authority[:]),
        TextUntilNul(node.identity.id[:]), record)
    if !NodeAppRecordIsLocal(record) { return key }
    local_key := PackageText("local.", key)
    PackageFree(key)
    return local_key
}

NodeTreeAllows :: (context: *void, node: *AppNode, name: string) -> bool {
    runner := cast(*NodeAppRunner)context
    if runner.nested == null || NodeTreeAccount() != TextUntilNul(runner.nested.tree.account[:]) {
        return false
    }
    if name == "AppServiceHost" || name == "entity.records" || name == "entity.dew" || name == PublicationsService || name == "leaderboard" ||
    name == "arcade.navigation" || name == "tile_map.sampling" { return true }
    if name == "AppRecordHost" || name == "SaveAppRecordHost" || name == "AppLocaleHost" ||
    name == "SmoothFramesHost" || name == "ClipboardCopyHost" || name == "ReadStoreHost" ||
    name == "WriteStoreHost" || name == "AppNowHost" || name == "AppLocalOffsetHost" ||
    name == "AppFriendHost" || name == "AppSharedHost" || name == "AppSharedItemHost" ||
    name == "AppInvitationHost" || name == "SendAppSharedHost" || name == "RefreshAppSharedHost" {
        return true
    }
    // Shared lists and media grants keep their historical names only for
    // identities bound to that legacy publisher. Other guests get no grant.
    owner := NodeTreeLegacyOwner(runner, node)
    if owner == "" {
        return false
    }
    if NodeAppMediaCapability(name) {
        return NodeAppMediaGranted(owner)
    }
    return NodeAppCapability(name)
}

NodeTreeCall :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    runner := cast(*NodeAppRunner)context
    name := TextFromCString(function)
    if !NodeTreeAllows(context, node, name) {
        return 0
    }
    if name == "AppServiceHost" && count == 2 && HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        if AppArgumentText(arguments[0]) == "arcade.navigation" && AppArgumentText(arguments[1]) == "back" &&
        !node_tree_validating && !node_snapshot_scanning && runner.nested != null {
            // Queue the parent transition until the guest frame returns.
            // Calling Back inside this callback would re-enter the running VM.
            reply := AppTreeQueue(*runner.nested.tree, runner.nested.tree.running,
                AppsRequest.{.operation = APPS_BACK})
            result.* = NodeAppString(ifx reply.status == APPS_QUEUED then "queued" else "unavailable")
            return 1
        }
        // A game's own score for the friends leaderboard, such as
        // "levels 12", kept under its verified identity.
        if AppArgumentText(arguments[0]) == "entity.records" && !node_tree_validating && !node_snapshot_scanning {
            result.* = NodeAppString(EntityServiceAnswer(AppArgumentText(arguments[1])))
            return 1
        }
        // The account's Dew, and rewards a game claims from the node.
        if AppArgumentText(arguments[0]) == "entity.dew" && !node_tree_validating && !node_snapshot_scanning {
            result.* = NodeAppString(DewGameAnswer(AppArgumentText(arguments[1])))
            return 1
        }
        if AppArgumentText(arguments[0]) == "leaderboard" && !node_tree_validating && !node_snapshot_scanning {
            saved := GameScoreReport(NodeAppName(NodeAppSlotOf(runner)), TextUntilNul(node.identity.id[:]),
                TextUntilNul(node.entry.title[:]), AppArgumentText(arguments[1]))
            result.* = NodeAppString(ifx saved then "{\"status\":\"saved\"}" else "{\"status\":\"rejected\"}")
            return 1
        }
        if AppArgumentText(arguments[0]) != PublicationsService || node_tree_validating || node_snapshot_scanning {
            result.* = NodeAppString("{\"status\":\"unavailable\"}")
            return 1
        }
        // Answers belong to the app that asked, by its verified identity.
        authority := PackageText(TextUntilNul(node.identity.authority[:]), "/")
        app := PackageText(authority, TextUntilNul(node.identity.id[:]))
        PackageFree(authority)
        defer { PackageFree(app) }
        result.* = NodeAppString(PublicationsCall(app, AppArgumentText(arguments[1])))
        return 1
    }
    if (name == "AppRecordHost" && count == 1) || (name == "ReadStoreHost" && count == 2) {
        return NodeTreeRead(runner, node, name, arguments, count, result)
    }
    if (name == "SaveAppRecordHost" || name == "WriteStoreHost") && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        record := AppArgumentText(arguments[0])
        text := AppArgumentText(arguments[1])
        saved := false
        if !node_tree_validating && !node_snapshot_scanning && NodeAppRecordNameValid(record) && text.count < Node.APP_RECORD_TEXT_MAX {
            key := NodeTreeRecordKey(runner, node, record)
            storage_set_setting_text(key, text)
            saved = storage_setting_text_equals(key, text) != 0
            PackageFree(key)
        }
        result.* = HostScalar("bool", ifx saved then 1 else 0)
        return 1
    }
    if name == "AppLocaleHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        result.* = NodeAppString(LocaleText(AppArgumentText(arguments[0])))
        return 1
    }
    if name == "SmoothFramesHost" && count == 1 &&
    HostScalarValid(arguments[0], "s32", cast(s32)HostInteger) {
        AppRequestSmoothFrames(cast(s32)arguments[0].integer)
        result.* = HostScalar("bool", 1)
        return 1
    }
    if name == "AppNowHost" && count == 0 {
        result.* = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float64"),
            .real = cast(float64)UnixMilliseconds() / 1000.0}
        return 1
    }
    if name == "AppLocalOffsetHost" && count == 0 {
        now := UnixNow()
        date := LocalAt(now)
        seconds := DaysFromCivil(date.year, date.month, date.day) * 86400 +
        cast(s64)(date.hour * 3600 + date.minute * 60 + date.second)
        result.* = HostScalar("s32", seconds - now)
        return 1
    }
    owner := NodeTreeLegacyOwner(runner, node)
    if owner != "" {
        return NodeAppCallFor(runner, owner, module, function, arguments, count, result)
    }
    if name == "AppFriendHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppPerson(Node.AppPerson.{}, *node_tree_person_codec)
        return 1
    }
    if name == "AppSharedHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppShared(Node.AppShared.{}, *node_tree_shared_codec)
        return 1
    }
    if name == "AppSharedItemHost" && count == 2 {
        result.* = Codec.WidgetEncodeAppSharedItem(Node.AppSharedItem.{}, *node_tree_item_codec)
        return 1
    }
    if name == "AppInvitationHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppInvitation(Node.AppInvitation.{}, *node_tree_invitation_codec)
        return 1
    }
    if (name == "RefreshAppSharedHost" && count == 0) || (name == "SendAppSharedHost" && count == 2) {
        result.* = HostScalar("bool", 0)
        return 1
    }
    if name == "ClipboardCopyHost" && node_ui_active && node_ui_call != null {
        return node_ui_call(node_ui_context, module, function, arguments, count, result)
    }
    return 0
}

NodeTreeWidgets :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    runner := cast(*NodeAppRunner)context
    if runner.nested == null || NodeTreeAccount() != TextUntilNul(runner.nested.tree.account[:]) {
        return 0
    }
    node_tree_widget_node = node
    if node_ui_active && node_ui_call != null {
        return node_ui_call(node_ui_context, module, function, arguments, count, result)
    }
    return 0
}

NodeTreeSave :: (context: *void, node: *AppNode) -> bool {
    runner := cast(*NodeAppRunner)context
    return runner.nested != null && NodeTreeAccount() == TextUntilNul(runner.nested.tree.account[:]) &&
    storage_db_handle() != null && NodeTreeFlush(storage_db_handle()) == 0
}

c :: #system_library "c";
NodeTreeFlush :: (database: *void) -> s32 #foreign c "sqlite3_db_cacheflush";

NodeTreeRead :: (runner: *NodeAppRunner, node: *AppNode, name: string,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if !HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        return 0
    }
    record := AppArgumentText(arguments[0])
    if !NodeAppRecordNameValid(record) {
        return 0
    }
    key := NodeTreeRecordKey(runner, node, record)
    defer { PackageFree(key) }
    PackageFree(node_tree_record)
    node_tree_record = NodeAppRecordRead(key)
    if name == "AppRecordHost" {
        result.* = NodeAppString(node_tree_record)
        return 1
    }
    if count != 2 || arguments[1].kind != cast(s32)HostSlice || arguments[1].elements == null {
        return 0
    }
    used: s64 = -1
    if node_tree_record.count > 0 && cast(usize)node_tree_record.count < arguments[1].length {
        for index: 0..node_tree_record.count {
            byte := ifx index < node_tree_record.count then node_tree_record[index] else cast(u8)0
            arguments[1].elements[index].bits = cast(u64)byte
            arguments[1].elements[index].integer = cast(s64)byte
        }
        used = node_tree_record.count
    }
    result.* = HostScalar("s32", used)
    return 1
}

// Control state has its own authority domain. A guest's chosen record name
// cannot reach install marks, favorites or their verified locators.
NodeTreeStateKey :: (identity: *AppIdentity, record: string) -> string {
    authority := PackageText("host:", TextUntilNul(identity.authority[:]))
    defer { PackageFree(authority) }
    return AppIdentityRecordKey(authority, TextUntilNul(identity.id[:]), record)
}

NodeTreeState :: (context: *void, account: string, identity: *AppIdentity, state: *AppState) -> bool {
    if account != NodeTreeAccount() {
        return false
    }
    key := NodeTreeStateKey(identity, "state")
    defer { PackageFree(key) }
    text := NodeAppRecordRead(key)
    defer { PackageFree(text) }
    state.* = AppState.{}
    if text == "" {
        return true
    }
    fields: [3]string = .["v", "installed", "favorite"]
    if !AppsObjectValid(text, 0, fields[:]) || Space(text, ValueEnd(text, 0, 0)) != text.count ||
    ReadNumber(text, FieldAt(text, 0, "v")).value != 1.0 {
        return false
    }
    installed := ReadNumber(text, FieldAt(text, 0, "installed"))
    favorite := ReadNumber(text, FieldAt(text, 0, "favorite"))
    if !installed.valid || !favorite.valid ||
    (installed.value != 0.0 && installed.value != 1.0) ||
    (favorite.value != 0.0 && favorite.value != 1.0) ||
    (favorite.value == 1.0 && installed.value != 1.0) {
        return false
    }
    state.installed = installed.value == 1.0
    state.favorite = favorite.value == 1.0
    return true
}

NodeTreeEffect :: (context: *void, account: string, locator: *AppLocator,
    operation: s32, reply: *AppsReply) -> bool {
    runner := cast(*NodeAppRunner)context
    if runner.nested == null || account != NodeTreeAccount() ||
    account != TextUntilNul(runner.nested.tree.account[:]) || !AppLocationValid(locator) {
        return false
    }
    // The tree opened and verified this temporary child before invoking us.
    candidate: *AppNode
    host := cast(*AppHost)runner.nested
    for at: cast(s64)0..host.tree.nodes.count - 1 {
        saved: AppSlot = host.tree.nodes[at]
        if saved.node != null && AppIdentityEqual(*saved.node.identity, *locator.identity) {
            found: AppLocator
            located := AppTreeLocate(*host.tree, AppHandle.{at, saved.node.generation}, *found)
            matches := located && AppLocationEqual(*found, locator)
            AppLocatorClear(*found)
            if matches {
                candidate = saved.node
                break
            }
        }
    }
    if candidate == null { return false }
    state: AppState
    if !NodeTreeState(context, account, *locator.identity, *state) {
        return false
    }
    if operation == APPS_INSTALL { state.installed = true }
    else if operation == APPS_UNINSTALL { state.installed = false; state.favorite = false }
    else if operation == APPS_PIN && state.installed { state.favorite = true }
    else if operation == APPS_UNPIN { state.favorite = false }
    else { return false }
    location := AppLocationWrite(locator)
    defer { PackageFree(location) }
    location_key := NodeTreeStateKey(*locator.identity, "locator")
    state_key := NodeTreeStateKey(*locator.identity, "state")
    defer { PackageFree(location_key); PackageFree(state_key) }
    value: Vec(u8)
    BuilderPrint(*value, "{\"v\":1,\"installed\":%,\"favorite\":%}",
        ifx state.installed then 1 else 0, ifx state.favorite then 1 else 0)
    text := BuilderFinish(value)
    defer { PackageFree(text) }
    if state.installed && !NodeInstalledCapture(NodeAppSlotOf(runner), candidate) { return false }
    if state.installed { NodeInstalledSave(NodeAppSlotOf(runner)) }
    storage_set_setting_text(location_key, location)
    if storage_setting_text_equals(location_key, location) == 0 {
        return false
    }
    storage_set_setting_text(state_key, text)
    if storage_setting_text_equals(state_key, text) == 0 || !NodeTreeSave(context, null) {
        return false
    }
    reply.status = APPS_APPLIED
    return true
}

// Breeze's own reviewed Apps controller, for a collection such as Arcade
// that does not pack one. The Apps host accepts it only by its digest.
NodeTreeController :: (context: *void) -> HostedAsset {
    unused context
    bytes := AssetRead("apps.zx")
    return HostedAsset.{.found = bytes.found, .data = bytes.data}
}

// verified is the digest the package manager just checked these bytes
// against, or empty to hash them here; either way the Apps host does not
// hash the whole bundle again.
NodeTreeStart :: (runner: *NodeAppRunner, bytes: string, verified: string,
    preparation: *AppPreparation = null) -> bool {
    authority: [256]u8
    if runner.nested != null || !NodeTreeAuthority(runner, authority[:]) {
        return false
    }
    slot := NodeAppSlotOf(runner)
    if slot < 0 {
        return false
    }
    index := slot + ifx node_tree_validating then NodeAppSlots else 0
    host := *node_tree_hosts[index]
    runner.nested = host
    digest: [65]u8
    if preparation == null && (verified.count != 64 || !CopyCString(verified, digest[:])) {
        payload := cast(*TextDescriptor)(*bytes)
        Sha256Hex(payload.data, bytes.count, *digest[0])
    }
    unused AppHostTrustHarness(host, AppsControllerBeforeSharedRecords)
    unused AppHostTrustHarness(host, AppsControllerBeforeAddons)
    unused AppHostTrustHarness(host, AppsControllerBeforeCoverGrid)
    unused AppHostTrustHarness(host, AppsControllerBeforeSmallCovers)
    unused AppHostTrustHarness(host, AppsControllerBeforeDownload)
    unused AppHostTrustHarness(host, AppsControllerBeforeSeparateDownloads)
    platform := AppPlatform.{.context = cast(*void)runner, .allows = NodeTreeAllows, .call = NodeTreeCall,
        .widgets = NodeTreeWidgets, .save = NodeTreeSave, .state = NodeTreeState,
        .effect = NodeTreeEffect, .bundle = NodeChildBundle,
        .download = NodeChildDownload, .fetch = NodeChildFetch, .controller = NodeTreeController}
    ready := false
    if preparation != null {
        ready = AppHostStartPrepared(host, preparation, TextUntilNul(authority[:]), PackageID(NodeAppIndex(slot)),
            NodeAppName(slot), NodeTreeAccount(), platform, AppsControllerSha256,
            LocaleActiveCode(), APPS_CONTEXT_PROTOCOL)
    } else {
        ready = AppHostStart(host, bytes, TextUntilNul(authority[:]), PackageID(NodeAppIndex(slot)),
            NodeAppName(slot), TextUntilNul(digest[:]), NodeTreeAccount(), platform,
            AppsControllerSha256, LocaleActiveCode(), APPS_CONTEXT_PROTOCOL, true)
    }
    if !ready {
        TraceLog(4, ifx preparation != null then "NODE: the Apps host refused the prepared collection" else
            "NODE: the Apps host refused the collection")
        runner.nested = null
        return false
    }
    runner.bundle_bytes = bytes.count
    return true
}

NodeTreeRuntime :: (slot: s32) -> *AppRuntime {
    if slot < 0 || slot >= NodeAppSlots || node_runners[slot].nested == null {
        return null
    }
    return AppHostActiveRuntime(node_runners[slot].nested)
}

NodeTreeRunMessage :: (slot: s32, message: Legacy.AppMessage) -> Legacy.AppMessage {
    message.succeeded = false
    host := node_runners[slot].nested
    if host == null || NodeTreeAccount() != TextUntilNul(host.tree.account[:]) {
        return message
    }
    if message.action == Node.APP_ROUTE {
        message.succeeded = AppHostRoute(host)
        return message
    }
    if message.action == Node.APP_BACK {
        // A failed save consumes outer Back so the current page is preserved.
        message.succeeded = AppHostBack(host) != 0
        return message
    }
    runtime := AppHostActiveRuntime(host)
    if runtime == null {
        return message
    }
    owner := NodeTreeLegacyOwner(*node_runners[slot], runtime.node)
    if runtime.protocol == APPS_NODE_PROTOCOL {
        runtime.legacy.message.locale = message.locale
        runtime.legacy.message.screen = message.screen
        runtime.legacy.message.account = message.account
        runtime.legacy.message.signed_in = owner != "" && message.signed_in
        runtime.legacy.message.friend_count = ifx owner != "" then message.friend_count else 0
        runtime.legacy.message.shared_count = ifx owner != "" then NodeAppSharedCount(owner) else 0
        runtime.legacy.message.invitation_count = ifx owner != "" then NodeAppInvitationCount(owner) else 0
        runtime.legacy.message.shared_revision = message.shared_revision
        runtime.legacy.message.shared_status = ifx owner != "" then message.shared_status else Node.APP_SHARED_UNAVAILABLE
        runtime.legacy.message.time = message.time
    }
    message.succeeded = AppHostRun(host, Portable.APP_FRAME)
    return message
}

NodeTreeFrame :: (slot: s32, frame: Legacy.AppUiFrame, key: s32, modifiers: s32, input: TextFieldInput) {
    runtime := NodeTreeRuntime(slot)
    if runtime == null {
        return
    }
    runtime.app.session = frame.session
    runtime.app.bounds = Rectangle.{0.0, cast(float32)frame.top, cast(float32)frame.width,
        cast(float32)(frame.height - frame.top - frame.bottom)}
    runtime.app.dark = frame.dark
    runtime.app.scale = frame.scale
    runtime.app.font = frame.font
    runtime.app.key = key
    runtime.app.modifiers = modifiers
    runtime.app.input = input
    if runtime.protocol == APPS_NODE_PROTOCOL {
        runtime.legacy.frame.session = frame.session
        runtime.legacy.frame.width = frame.width
        runtime.legacy.frame.height = frame.height
        runtime.legacy.frame.bottom = frame.bottom
        runtime.legacy.frame.top = frame.top
        runtime.legacy.frame.scale = frame.scale
        runtime.legacy.frame.font = frame.font
        runtime.legacy.frame.now = frame.now
        runtime.legacy.frame.dark = frame.dark
    }
}

NodeTreeAssetAllowed :: (path: string) -> bool {
    return path == "" || (node_tree_widget_node != null && (AppHostAsset(node_tree_widget_node, path).found ||
        AppHostAssetPending(node_tree_widget_node, path)))
}

NodeTreeAssetPath :: (packed: string) -> string {
    if packed == "" || node_tree_widget_node == null {
        return ""
    }
    for index: cast(s64)0..node_tree_images.count - 1 {
        image := *node_tree_images[index]
        if TextUntilNul(image.digest[:]) == TextUntilNul(node_tree_widget_node.entry.sha256[:]) && image.packed == packed {
            return image.path
        }
    }
    asset := AppHostAsset(node_tree_widget_node, packed)
    if !asset.found {
        return ""
    }
    // Asset lookup can update downloaded art, so borrow the node's image key
    // only after that mutable lookup has finished.
    digest := TextUntilNul(node_tree_widget_node.entry.sha256[:])
    out: Vec(u8)
    BuilderPrint(*out, "apps/%/%", digest, packed)
    path := BuilderFinish(out)
    bytes: Vec(u8)
    BuilderPrint(*bytes, "%", packed)
    owned := BuilderFinish(bytes)
    image := NodeTreeImage.{.path = path, .packed = owned,
        .digest = node_tree_widget_node.entry.sha256, .data = asset.data}
    if !VecPush(node_tree_images, image) {
        PackageFree(path)
        PackageFree(owned)
        return ""
    }
    return path
}

NodeTreeAsset :: (path: string) -> AssetView {
    for entry: node_tree_images {
        if entry.path != path {
            continue
        }
        mime := "image/png"
        if path.count > 4 && path[path.count - 4:] == ".jpg" { mime = "image/jpeg" }
        else if path.count > 5 && path[path.count - 5:] == ".jpeg" { mime = "image/jpeg" }
        else if path.count > 5 && path[path.count - 5:] == ".webp" { mime = "image/webp" }
        return AssetView.{.found = true, .mime = mime, .data = entry.data}
    }
    return AssetView.{}
}

NodeTreeCollect :: () {
    // Painting must finish before retired runtimes and borrowed assets go away.
    for slot: cast(s32)0..NodeAppSlots - 1 {
        if node_runners[slot].nested != null {
            AppHostCollect(node_runners[slot].nested)
        }
    }
    for entry: node_tree_images {
        PackageFree(entry.path)
        PackageFree(entry.packed)
    }
    while node_tree_images.count > 0 { unused VecPop(node_tree_images) }
    node_tree_widget_node = null
}

NodeTreeClose :: (runner: *NodeAppRunner) -> bool {
    if runner.nested == null {
        return true
    }
    if !AppHostStop(runner.nested) {
        return false
    }
    runner.nested = null
    NodeChildClose(NodeAppSlotOf(runner))
    return true
}
