// What an app hosted by Inbe receives from the keyboard and the display.

// A frame passes the app the first fresh key press; without one, a key the
// system repeats while it is held, so a held arrow keeps a game moving.
NodeAppKeyFor :: (pressed: s32, repeated: s32) -> s32 {
    return ifx pressed != 0 then pressed else repeated
}

// The display stays on only while a game is played full screen; anywhere
// else the desktop may blank it when idle.
NodeAppDisplayAwakeFor :: (on_app_screen: bool, launcher_open: bool, immersive: bool) -> bool {
    return on_app_screen && !launcher_open && immersive
}
