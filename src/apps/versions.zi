// Generated from apps/versions.json; module releases are independent.
PackageBundledVersion :: (index: s32) -> string {
    if index < 0 || index >= 7 {
        return ""
    }
    versions: [7]string = .["2.1.62", "1.1.28", "1.3.15", "1.6.9", "1.3.25", "1.5.27", "1.0.29"]
    return versions[index]
}

PackageBundledSequence :: (index: s32) -> s32 {
    if index < 0 || index >= 7 {
        return 0
    }
    sequences: [7]s32 = .[59, 36, 38, 38, 42, 45, 30]
    return sequences[index]
}

// The oldest host interface a package of each app may be built for. An
// app whose screens moved into its package needs a package that draws
// them; an older one gives way to the bundled copy.
PackageHostAPIOldestFor :: (index: s32) -> s32 {
    if index < 0 || index >= 7 {
        return 12
    }
    oldest: [7]s32 = .[12, 12, 30, 31, 12, 12, 40]
    return oldest[index]
}
