#import "json_scan"
#import "byte_text_linux"

LUMI_REQUEST_MESSAGE_LIMIT :: 20

// Leave the current user message and its entire tool exchange together. The
// node limits every request, including follow-ups, to twenty messages.
LumiRequestHistoryStart :: (document: string) -> s32 {
    end := ValueEnd(document, 0, 0)
    count := ArrayCount(document, 0)
    if end < 0 || Space(document, end) != document.count || count <= 0 {
        return -1
    }
    first := count - LUMI_REQUEST_MESSAGE_LIMIT
    if first < 0 {
        first = 0
    }
    last_user: s32 = -1
    for index: cast(s32)0..count - 1 {
        at := ElementAt(document, 0, index)
        role := ReadString(document, FieldAt(document, at, "role"))
        if SpanEqualsASCII(document, role, "user") {
            last_user = index
        }
    }
    if first > last_user {
        return -1
    }
    return ElementAt(document, 0, first)
}

LumiResponseMessageAt :: (document: string) -> s32 {
    end := ValueEnd(document, 0, 0)
    if end < 0 || Space(document, end) != document.count {
        return -1
    }
    return FieldAt(document, 0, "message")
}

// HTTP success alone is not a feedback receipt. Daochi acknowledges the exact
// report ID as a JSON string, optionally followed by JSON whitespace.
LumiFeedbackReceiptMatches :: (document: string, id: string) -> bool {
    if id.count != 64 {
        return false
    }
    end := ValueEnd(document, 0, 0)
    if end < 0 || Space(document, end) != document.count {
        return false
    }
    bytes: [65]u8
    count := ReadStringText(document, Space(document, 0), bytes[:])
    return count == 64 && TextFromBytes(bytes[:count]) == id
}

// An OpenAI-compatible answer holds its message in its first choice.
LumiProviderMessageAt :: (document: string) -> s32 {
    end := ValueEnd(document, 0, 0)
    if end < 0 || Space(document, end) != document.count {
        return -1
    }
    choices := FieldAt(document, 0, "choices")
    if ArrayCount(document, choices) < 1 {
        return -1
    }
    return FieldAt(document, ElementAt(document, choices, 0), "message")
}
