#import, file "module_types.zi";
#import, file "../core/types.zi";
#import, file "../practices/patterns/patterns_types.zi";
#import, file "../practices/sun_salutation/sun_salutation_rules.zi";
PRACTICE_BREATH_STEP :: 1
PRACTICE_MEDITATION_STEP :: 2
PRACTICE_SALUTATION_STEP :: 3
PRACTICE_PATTERNS_STEP :: 4
PRACTICE_ROUTE :: 5

PracticeMessage :: struct {
    abi: s32
    action: s32
    breathing: BreathSession
    salutation: SunSalutationPracticeState
    patterns: Patterns
    remaining_seconds: s32
    remainder_ms: s32
    elapsed_ms: s32
    elapsed_seconds: s32
    elapsed: float64
    paused: bool
    completed: bool
    cue: s32
    succeeded: bool
    screen: s32
}

// Draws Practice's home (apps/practice/practice_home_view.zi).
PRACTICE_HOME_VIEW :: 6
// What Practice's home asks for: start the practice, open its manual or
// settings, press the button in place of Start, go to the next or previous
// practice (value 1 or -1), pick the one at a place under the tab (value),
// or choose a tab (value).
PRACTICE_HOME_NONE :: 0
PRACTICE_HOME_START :: 1
PRACTICE_HOME_MANUAL :: 2
PRACTICE_HOME_CONFIG :: 3
PRACTICE_HOME_OFFER :: 4
PRACTICE_HOME_STEP :: 5
PRACTICE_HOME_PICK :: 6
PRACTICE_HOME_TAB :: 7
// What a practice that is not ready offers in place of Start: nothing once
// it is ready, Install, Unlock for a paid one, or Cancel while it downloads.
PRACTICE_OFFER_NONE :: 0
PRACTICE_OFFER_INSTALL :: 1
PRACTICE_OFFER_BUY :: 2
PRACTICE_OFFER_CANCEL :: 3

// Draws a practice's manual (apps/practice/manual_view.zi).
PRACTICE_MANUAL_VIEW :: 7
// What a manual asks for: nothing, closing it, or starting the practice.
PRACTICE_MANUAL_NONE :: 0
PRACTICE_MANUAL_CLOSE :: 1
PRACTICE_MANUAL_START :: 2

// Draws a practice's Customize page (apps/practice/settings_view.zi).
PRACTICE_SETTINGS_VIEW :: 8
// What Customize asks for: going back, a Meditation duration preset or
// custom minutes changed by value, the extend controls on or off (value),
// the interval bell's minutes, a music track (0 none), testing or
// downloading it, narration on or off, its voice (1 male), its language,
// or downloading, stopping or removing a language (value its index).
PRACTICE_SETTINGS_NONE :: 0
PRACTICE_SETTINGS_BACK :: 1
PRACTICE_SETTINGS_DURATION :: 2
PRACTICE_SETTINGS_CUSTOM :: 3
PRACTICE_SETTINGS_EXTEND :: 4
PRACTICE_SETTINGS_BELL :: 5
PRACTICE_SETTINGS_MUSIC :: 6
PRACTICE_SETTINGS_MUSIC_TEST :: 7
PRACTICE_SETTINGS_MUSIC_DOWNLOAD :: 8
PRACTICE_SETTINGS_NARRATION :: 9
PRACTICE_SETTINGS_VOICE :: 10
PRACTICE_SETTINGS_LANGUAGE :: 11
PRACTICE_SETTINGS_LANGUAGE_ACTION :: 12
// Breathing patterns: a pattern (value), five seconds less or more for a
// phase of the custom pattern (value the phase), and the minutes (value).
PRACTICE_SETTINGS_PATTERN :: 13
PRACTICE_SETTINGS_PATTERN_LESS :: 14
PRACTICE_SETTINGS_PATTERN_MORE :: 15
PRACTICE_SETTINGS_PATTERN_MINUTES :: 16
// Wim Hof: the breath animation, speed, speeding up on or off, opening the
// start speed's editor, rounds, breaths, pause, double tap on or off, the
// session controls on or off, the hold reminder's seconds, the defaults,
// the start speed, and closing its editor.
PRACTICE_SETTINGS_WHM_ANIMATION :: 17
PRACTICE_SETTINGS_WHM_SPEED :: 18
PRACTICE_SETTINGS_WHM_PROGRESSIVE :: 19
PRACTICE_SETTINGS_WHM_START_EDITOR :: 20
PRACTICE_SETTINGS_WHM_ROUNDS :: 21
PRACTICE_SETTINGS_WHM_BREATHS :: 22
PRACTICE_SETTINGS_WHM_PAUSE :: 23
PRACTICE_SETTINGS_WHM_DOUBLE_TAP :: 24
PRACTICE_SETTINGS_WHM_CONTROLS :: 25
PRACTICE_SETTINGS_WHM_REMINDER :: 26
PRACTICE_SETTINGS_WHM_RESET :: 27
PRACTICE_SETTINGS_WHM_START_SPEED :: 28
PRACTICE_SETTINGS_WHM_EDITOR_CLOSE :: 29
PRACTICE_SETTINGS_SUN_REPETITIONS :: 30
PRACTICE_SETTINGS_SUN_START :: 31
PRACTICE_SETTINGS_SUN_END :: 32
PRACTICE_SETTINGS_SUN_CHARACTER :: 33
PRACTICE_SETTINGS_MUSIC_VOLUME :: 34
PRACTICE_SETTINGS_CUE_VOLUME :: 35
PRACTICE_SETTINGS_TAI_CHARACTER :: 36

// Draws a finished practice's results (apps/practice/results_view.zi).
PRACTICE_RESULTS_VIEW :: 9
// What the results ask for: nothing, a mood (value 1 to 5), Discard or Done.
PRACTICE_RESULTS_NONE :: 0
PRACTICE_RESULTS_MOOD :: 1
PRACTICE_RESULTS_DISCARD :: 2
PRACTICE_RESULTS_DONE :: 3

// Draws a running Meditation's circle, time and extend controls
// (apps/practice/meditation_view.zi).
PRACTICE_MEDITATION_VIEW :: 10
// What a running Meditation asks for: nothing, more time (value seconds),
// or finishing once the time is up.
PRACTICE_MEDITATION_NONE :: 0
PRACTICE_MEDITATION_EXTEND :: 1
PRACTICE_MEDITATION_FINISH :: 2

// Draws a running breathing pattern's circle, phase, cycle and time with
// Pause or Resume (apps/practice/patterns_view.zi).
PRACTICE_PATTERNS_VIEW :: 11
// What a running pattern asks for: nothing, Pause or Resume.
PRACTICE_PATTERNS_NONE :: 0
PRACTICE_PATTERNS_PAUSE :: 1
PRACTICE_PATTERNS_RESUME :: 2

// Draws a running Wim Hof round's circle with its band and count, and the
// Breath button or double-tap hint while the breath is held
// (apps/practice/whm_view.zi).
PRACTICE_WHM_VIEW :: 12
// What a running round asks for: nothing, or Breath to end the hold.
PRACTICE_WHM_NONE :: 0
PRACTICE_WHM_BREATH :: 1

PRACTICE_MOVEMENT_VIEW :: 13
PRACTICE_MOVEMENT_NONE :: 0
PRACTICE_MOVEMENT_BACK :: 1
PRACTICE_MOVEMENT_PAUSE :: 2
PRACTICE_MOVEMENT_NEXT :: 3
PRACTICE_MOVEMENT_VIEWPOINT :: 4

PRACTICE_COURSE_VIEW :: 14
PRACTICE_COURSE_NONE :: 0
PRACTICE_COURSE_CLOSE :: 1
PRACTICE_COURSE_PLAY :: 2
