#import "session"
#import "drawing_props"
#import "geometry"
#import "swipe_props"

// Practice's home, from the host: the chosen practice with its banner, title
// and what its card offers, the tabs of the kinds listed, and the pointer for
// swipes. The package draws it and gives back what the person did, with
// where Start and the other buttons were for Lumi's guide.
PracticeHomeFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    // The room the app keeps above, below and beside the page.
    top: s32
    bottom: s32
    left: s32
    font: s32
    small_font: s32
    canvas_color: Color
    surface_color: Color
    accent_color: Color
    modal_active: bool
    // Swipes and the arrow keys choose another practice, except under
    // Lumi's guide, whose steps they move through instead.
    choosing: bool
    key_left: bool
    key_right: bool
    swipe: SwipeGesture
    swipe_frame: SwipeFrame
    practice: s32
    title: string
    subtitle: string
    // The banner's asset path, or empty for a plain surface.
    banner: string
    // A tab for each kind with a practice listed, the chosen practice's
    // tab, and how far the tabs are scrolled. The chosen tab is brought into
    // view once each time another kind is chosen.
    tab_count: s32
    tab_selected: s32
    tab_scroll: s32
    tab_focus: bool
    // The practices listed under the chosen tab, and the chosen one's place.
    listed: s32
    index: s32
    // Ready to start, with a manual and settings to open.
    ready: bool
    has_manual: bool
    has_config: bool
    // A practice that is not ready offers a button in place of Start: one
    // of PRACTICE_OFFER_*, its label and whether it can be pressed now.
    offer: s32
    offer_label: string
    offer_disabled: bool
    // Lines under the title: how the download is going, a paid practice's
    // price, with its regular price and discount during an offer and what
    // the price is worth, and why it cannot be unlocked yet.
    status: string
    priced: bool
    regular_price: string
    discount: string
    worth: string
    note: string
    // What was done, one of PRACTICE_HOME_*, and its value.
    action: s32
    value: s32
    card: Rectangle
    start: Rectangle
    manual: Rectangle
    config: Rectangle
    // The swipe's pointer ownership and whether this frame's click is its.
    claim_pointer: bool
    release_pointer: bool
    block_click: bool
}

// A tab: its kind's name and the kind's place among all kinds, which keys it.
PracticeHomeTab :: struct {
    label: string
    slot: s32
}

// A practice's manual, from the host: its pages, the theme's guide colours,
// the settings its pages show, and the pointer and keys that turn pages.
// The package draws the page, and gives back the page it turned to, its
// scrolling, a changed setting, and whether the manual closes or the
// practice starts.
PracticeManualFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    font: s32
    small_font: s32
    // The title bar's height, 0 beside the desktop rail, which has none;
    // and the room the app keeps below an integrated manual.
    title_height: s32
    bottom: s32
    guide_background: Color
    guide_foreground: Color
    guide_border: Color
    practice: s32
    dark: bool
    page: s32
    scroll: s32
    swipe: SwipeGesture
    swipe_frame: SwipeFrame
    // The keys: the previous or next page, Start, and closing.
    previous: bool
    next: bool
    finish: bool
    close: bool
    // Wim Hof: the breathing speed with its range, the size of the preview
    // breath, and how far the hold preview's bar is, of 60.
    speed: s32
    speed_min: s32
    speed_max: s32
    breath_radius: s32
    hold_progress: s32
    // Patterns: the chosen preset, a custom pattern's seconds and the
    // session's length in minutes, 0 for open.
    preset: s32
    inhale: s32
    hold_in: s32
    exhale: s32
    hold_out: s32
    duration_minutes: s32
    sun_character: s32
    sun_repetitions: s32
    sun_start_seconds: s32
    sun_end_seconds: s32
    // What was done: one of PRACTICE_MANUAL_*.
    action: s32
    speed_changed: bool
    claim_pointer: bool
    release_pointer: bool
    block_click: bool
}

// A practice's Customize page, from the host: its layout, the practice's
// settings, its background music with the track's download, and its voice
// narration with the languages it is recorded in. The package draws the
// page and gives back the one change asked for.
PracticeSettingsFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    font: s32
    small_font: s32
    // The title bar's height, and where the page scrolls below it.
    title_height: s32
    scroll_y: s32
    scroll_height: s32
    // The room kept below the page's end when it sits in the app.
    bottom: s32
    canvas_color: Color
    accent_color: Color
    practice: s32
    scroll: s32
    // Meditation: the duration preset, or custom minutes, the extend
    // controls during a session, and the interval bell's minutes, 0 for off.
    duration_mode: s32
    custom_minutes: s32
    extend_controls: bool
    bell_minutes: s32
    // Breathing patterns: the pattern chosen, the custom pattern's seconds
    // in, held in, out and held out, and the minutes, 0 for open-ended.
    pattern: s32
    pattern_inhale: s32
    pattern_hold_in: s32
    pattern_exhale: s32
    pattern_hold_out: s32
    pattern_minutes: s32
    // Wim Hof: the breath animation (0 steady, 1 easing in and out), the
    // speed, rounds, breaths a round and pause after one with their ranges,
    // speeding up from a slower start speed, double tap to breathe, the
    // session controls, and the hold reminder's seconds (0, 30 or 60). The
    // preview breathes at this share of its range now, and so does the start
    // speed's preview while its editor is open.
    whm_animation: s32
    whm_speed: s32
    whm_speed_min: s32
    whm_speed_max: s32
    whm_rounds: s32
    whm_rounds_max: s32
    whm_breaths: s32
    whm_breaths_min: s32
    whm_breaths_max: s32
    whm_pause: s32
    whm_pause_min: s32
    whm_pause_max: s32
    whm_progressive: bool
    whm_start_speed: s32
    whm_double_tap: bool
    whm_controls: bool
    whm_reminder: s32
    whm_preview: float32
    whm_editor: bool
    whm_editor_preview: float32
    surface_color: Color
    border_color: Color
    link_color: Color
    text_color: Color
    sun_character: s32
    sun_repetitions: s32
    sun_start_seconds: s32
    sun_end_seconds: s32
    sun_duration: s32
    sun_seconds_min: s32
    sun_seconds_max: s32
    music_volume: s32
    cue_volume: s32
    tai_character: s32
    tai_character_count: s32
    tai_preview_item: s32
    // Background music: the track chosen, 0 for none and n for the nth of
    // the tracks; whether it is on this device, built in, playing as a test,
    // and how its download goes, with the line that says so.
    music: bool
    music_selection: s32
    music_count: s32
    music_installed: bool
    music_built_in: bool
    music_playing: bool
    music_redownload: bool
    music_show_status: bool
    music_downloading: bool
    music_bytes: s64
    music_total: s64
    music_status: string
    // Voice narration: on or off, whether it is recorded in a second voice
    // and that voice is chosen, its languages with the one that plays, and
    // a line while one downloads or failed.
    narration: bool
    narration_enabled: bool
    narration_voices: bool
    narration_male: bool
    narration_count: s32
    narration_selected: s32
    narration_status: string
    // What was asked, one of PRACTICE_SETTINGS_*, and its value.
    action: s32
    value: s32
}

PracticeMusicTrack :: struct {
    label: string
}

// A language narration is recorded in: its name, whether it is downloading
// (1), on this device (2) or not, and its place in the app's languages.
PracticeNarrationChoice :: struct {
    label: string
    state: s32
    rank: s32
}

PracticeCharacterChoice :: struct {
    label: string
}

// A finished practice's results, from the host: the theme, the practice and
// its numbers, whether the session was saved, and the mood picked. The
// package draws them and gives back the mood picked, Discard or Done.
PracticeResultsFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    canvas_color: Color
    surface_color: Color
    border_color: Color
    link_color: Color
    text_color: Color
    // The middle of the practice's screen, which the glow is centred on.
    center_x: s32
    // Results the device does not keep show no save status and no mood.
    temporary: bool
    activity: s32
    name: string
    // Minutes or seconds practised, repetitions, or Wim Hof's rounds; a
    // breathing pattern's name and its cycles.
    primary: s32
    secondary: s32
    detail: string
    saved: bool
    write_failed: bool
    mood: s32
    round_count: s32
    scroll: s32
    // What was asked, one of PRACTICE_RESULTS_*, and the mood picked.
    action: s32
    value: s32
    // The practice's first session, with no habit linked to it yet, offers
    // one: PRACTICE_HABIT_OFFER_*.
    habit_offer: s32
}

PracticeResultRound :: struct {
    seconds: s32
}

// A running Meditation, from the host: the circle with the time left in it
// and, when the time can be extended, +1, +5 and +10 minutes, with Finish
// once the time is up. The package draws it under the app's title bar and
// gives back what was pressed.
PracticeMeditationFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    center_x: s32
    center_y: s32
    accent_color: Color
    ink_class: s32
    time_text: string
    extend: bool
    complete: bool
    finish_label: string
    // What was asked, one of PRACTICE_MEDITATION_*, and its value.
    action: s32
    value: s32
}

// A running breathing pattern, from the host: the circle growing and
// shrinking inside its well, the phase to breathe, the cycle with the time,
// and Pause, or Resume while paused. The package draws it under the app's
// title bar and gives back what was pressed.
PracticePatternsFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    center_x: s32
    center_y: s32
    // The cycle and time sit this far down, under the title bar.
    status_y: s32
    small_font: s32
    well_color: Color
    accent_color: Color
    // The well's radius and the circle's radius now.
    max_radius: s32
    radius: s32
    phase_label: string
    status: string
    paused: bool
    pause_label: string
    resume_label: string
    // What was asked, one of PRACTICE_PATTERNS_*.
    action: s32
    value: s32
}

// A running Wim Hof round, from the host: the breathing circle at its radius
// with the band showing the round's progress in ticks, counting down while
// waiting and recovering, the count inside, and while the breath is held the
// Breath button or the double-tap hint. The package draws it under the app's
// title bar and gives back what was pressed.
PracticeWhmFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    center_x: s32
    center_y: s32
    font: s32
    accent_color: Color
    ink_class: s32
    radius: float32
    // The circle's smallest and largest radius.
    rmin: s32
    rmax: s32
    ticks: s32
    progress: float32
    countdown: bool
    count: string
    // While the breath is held: a hint to tap twice, or the Breath button,
    // which stays above this line.
    hold: bool
    double_tap: bool
    hint: string
    breath_label: string
    breath_max_y: s32
    // What was asked, one of PRACTICE_WHM_*.
    action: s32
    value: s32
}

// Movement layouts belong to Practices. The host supplies the running
// session's values and renders a complete figure for a requested rectangle.
PracticeMovementFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    top: s32
    font: s32
    small_font: s32
    muted_class: s32
    practice: s32
    paused: bool
    can_back: bool
    heading: string
    subtitle: string
    cue: string
    time: string
    progress: s32
    view: s32
    scroll: s32
    // Workout's position within its twelve exercises and the current step.
    exercise: s32
    phase: s32
    elapsed_ms: s32
    length_ms: s32
    seconds_left: s32
    accent_color: Color
    text_color: Color
    action: s32
    value: s32
}

PracticeFigureRequest :: struct {
    practice: s32
    // 0 running figure, 1 held pose or course thumbnail.
    preview: bool
    index: s32
    character: s32
    bounds: Rectangle
    key: u64
    alt_text: string
}

PracticeCourseFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    font: s32
    small_font: s32
    muted_class: s32
    lesson_count: s32
    lesson: s32
    lesson_scroll: s32
    item_scroll: s32
    reveal_next: bool
    next_item: s32
    character: s32
    progress: string
    action: s32
    value: s32
}

PracticeCourseRow :: struct {
    title: string
    subtitle: string
    summary: string
    detail: string
    first: s32
    count: s32
    done: bool
}
