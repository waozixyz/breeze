lumi_telegram_operation: StoredOperation;
using AppNavRoute;
c :: #system_library "c";
#if #defined(_WIN32) {
    TelegramNow :: (out: *s64) -> s64 #foreign c "_time64";
} else {
    TelegramNow :: (out: *s64) -> s64 #foreign c "time";
}

// Telegram messages reach the app within this interval while Inbe is open.
LUMI_TELEGRAM_POLL_SECONDS :: 2
LUMI_TELEGRAM_RETRY_SECONDS :: 5

lumi_telegram_session: Session;
lumi_telegram_transfer: NetworkTransfer;
lumi_telegram_response: [65536]u8;
lumi_telegram_connection: TelegramConnection;
lumi_telegram_current: *InnerBreeze;

LumiTelegramLink :: () {
    lumi_telegram_connection.error = false
    lumi_telegram_connection.link_requested = true
}

LumiTelegramDisconnect :: () {
    lumi_telegram_connection.error = false
    LumiAuthorizationRevokeThenDisconnect()
}

// Inbe chooses its bot; Entity owns URI validation and connection behavior.
LumiTelegramOpen :: (start: string = "") -> bool {
    return TelegramOpenBot("inlumi_bot", start)
}

LumiTelegramBusy :: () -> bool {
    return LumiAuthorizationBusy() || lumi_telegram_connection.link_requested || lumi_telegram_connection.disconnect_requested ||
    (lumi_telegram_operation.active && (lumi_telegram_connection.stage == 1 || lumi_telegram_connection.stage == 5))
}

LumiTelegramStatusKey :: () -> string {
    if storage_has_sync_account() == 0 {
        return "lumi_telegram_account"
    }
    if !LumiNodeTrafficAllowed() {
        return "lumi_telegram_offline"
    }
    if lumi_telegram_connection.error {
        return "lumi_telegram_error"
    }
    if LumiTelegramBusy() || lumi_telegram_connection.waiting {
        return "lumi_telegram_waiting"
    }
    return ifx lumi_telegram_connection.linked then "lumi_telegram_connected" else "lumi_telegram_body"
}

LumiTelegramRequest :: (method: string, path: string, body: string) -> bool {
    if BeginStoredRequest(*lumi_telegram_operation, "https://api.waozi.xyz",
        NetworkTransport(*lumi_telegram_transfer), method, path, body,
        lumi_telegram_response[:], false, *lumi_telegram_session) {
        unused AppCopyText(AppTextFromCString(storage_user_id_buffer(), 64), lumi_telegram_connection.owner[:])
        return true
    }
    print("LUMI: telegram_request_start_failed result=%\n", lumi_telegram_operation.result)
    return false
}

// Telegram cannot show an Inner Breeze screen, so the commands that open
// Lists or Habits answer with their current content instead.
LumiTelegramOverview :: (app: *InnerBreeze, command: string) -> string {
    out: Vec(u8)
    if command == "/lists" {
        if !app_nav_route_available(app, APP_NAV_ROUTE_ELIST) ||
        storage_elist_load(cast(*void)*lumi_tasks) == 0 {
            return ""
        }
        for list_index: cast(s32)0..lumi_tasks.list_count - 1 {
            list := *lumi_tasks.lists[list_index]
            list_id := AppTextFromCString(*list.id[0], 37)
            if out.count > 0 {
                BuilderPrint(*out, "\n\n")
            }
            BuilderPrint(*out, "%", AppTextFromCString(*list.title[0], ELIST_TITLE_SIZE))
            open: s32 = 0
            for item_index: cast(s32)0..lumi_tasks.item_count - 1 {
                item := *lumi_tasks.items[item_index]
                if item.done != 0 || AppTextFromCString(*item.list_id[0], 37) != list_id {
                    continue
                }
                BuilderPrint(*out, "\n- %", AppTextFromCString(*item.title[0], ELIST_TITLE_SIZE))
                open += 1
            }
            if open == 0 {
                BuilderPrint(*out, "\n%", LocaleText("lumi_list_nothing_open"))
            }
        }
        if out.count == 0 {
            BuilderPrint(*out, "%", LocaleText("lumi_lists_empty"))
        }
        return BuilderFinish(out)
    }
    if command == "/habits" {
        if !app_nav_route_available(app, APP_NAV_ROUTE_HABITS) {
            return ""
        }
        for done: cast(s32)0..1 {
            heading := false
            for index: cast(s32)0..LumiHabitCount(app) - 1 {
                habit := LumiHabitAt(app, index)
                if habit.title.count == 0 || habit.done != (done == 1) {
                    continue
                }
                if !heading {
                    if out.count > 0 {
                        BuilderPrint(*out, "\n\n")
                    }
                    BuilderPrint(*out, "%", LocaleText(ifx done == 1 then "lumi_habits_done" else "lumi_habits_open"))
                    heading = true
                }
                BuilderPrint(*out, "\n- %", habit.title)
            }
        }
        if out.count == 0 {
            BuilderPrint(*out, "%", LocaleText("lumi_habits_empty"))
        }
        return BuilderFinish(out)
    }
    return ""
}

LumiTelegramApply :: (app: *InnerBreeze, document: string) {
    linked_at := FieldAt(document, 0, "linked")
    linked_end := ValueEnd(document, linked_at, 0)
    lumi_telegram_connection.linked = linked_at >= 0 && linked_end > linked_at && document[linked_at:linked_end] == "true"
    linked_time := ReadNumber(document, FieldAt(document, 0, "linked_at"))
    lumi_telegram_connection.linked_at = ifx linked_time.valid then cast(s64)linked_time.value else 0
    if lumi_telegram_connection.linked {
        lumi_telegram_connection.waiting = false
    }
    at := FieldAt(document, 0, "update")
    number := ReadNumber(document, FieldAt(document, at, "id"))
    if !number.valid || number.value == 0 || LumiOnlineWaiting() { return }
    id := cast(s64)number.value
    out: Vec(u8)
    BuilderPrint(*out, "telegram.update.%", id)
    key := BuilderFinish(out)
    defer { PackageFree(key) }
    lumi_telegram_connection.ack = id
    if storage_get_setting_int(key, 0) != 0 { return }
    // Persist the execution claim first. A crash cannot silently repeat tools.
    storage_set_setting_int(key, 1)
    if storage_get_setting_int(key, 0) != 1 {
        lumi_telegram_connection.ack = 0
        return
    }
    kind: [32]u8
    input: [8192]u8
    kind_length := ReadStringText(document, FieldAt(document, at, "kind"), kind[:])
    input_length := ReadStringText(document, FieldAt(document, at, "text"), input[:])
    if kind_length <= 0 || input_length <= 0 { return }
    type := TextFromBytes(kind[:kind_length])
    text := TextFromBytes(input[:input_length])
    message_id: Vec(u8)
    BuilderPrint(*message_id, "telegram-%", id)
    stable_id := BuilderFinish(message_id)
    defer { PackageFree(stable_id) }
    lumi_next_message_id = stable_id
    if type == "feedback" {
        title: [161]u8
        report: [4097]u8
        title_length := ReadStringText(text, FieldAt(text, 0, "title"), title[:])
        report_length := ReadStringText(text, FieldAt(text, 0, "message"), report[:])
        if title_length > 0 && report_length > 0 {
            value: Vec(u8)
            BuilderPrint(*value, "%\n%\n%", LocaleText("lumi_owner_feedback"),
                TextFromBytes(title[:title_length]), TextFromBytes(report[:report_length]))
            content := BuilderFinish(value)
            LumiOnlineAppend(content)
            PackageFree(content)
        }
    } else if type == "confirmation" {
        choice := ReadNumber(document, FieldAt(document, at, "choice"))
        // The confirmation card is the whole exchange; its buttons show the choice.
        if choice.valid {
            unused FeedbackChoice(text, cast(s32)choice.value)
        }
    } else if type == "message" && text.count < LUMI_INPUT_MAX {
        // A remote message never moves this device's screen to Lumi.
        overview := LumiTelegramOverview(app, text)
        if overview.count > 0 {
            LumiStoreAppend(text, true)
            LumiOnlineAppend(overview)
            PackageFree(overview)
        } else {
            unused LumiSubmit(app, text)
        }
    }
    lumi_next_message_id = ""
    unused LumiStoreSave()
    app.ui.sync_requested = true
}

LumiTelegramPump :: (app: *InnerBreeze) {
    lumi_telegram_current = app
    defer { lumi_telegram_current = null }
    LumiAuthorizationPump()
    if lumi_authorization_intent == 2 {
        lumi_authorization_intent = 0
        start: [38]u8
        writer: Writer = .{start[:], 0, true}
        writer = WriteText(writer, "auth_")
        writer = WriteText(writer, TextUntilNul(lumi_authorization_pending.request_id[:]))
        if !writer.valid || !LumiTelegramOpen(TextUntilNul(start[:])) {
            lumi_authorization_state = 5
        }
    }
    if lumi_authorization_disconnect_ready {
        lumi_authorization_disconnect_ready = false
        lumi_telegram_connection.disconnect_requested = true
    }
    client := storage_get_setting_text("lumi_telegram_client")
    if storage_has_sync_account() != 0 && client.count != 64 {
        bytes: [65]u8
        if !NativeNonce(null, bytes[:]) { return }
        storage_set_setting_text("lumi_telegram_client", TextFromCString(*bytes[0]))
        client = storage_get_setting_text("lumi_telegram_client")
    }
    client_bytes: [65]u8
    if !CopyCString(client, client_bytes[:]) { return }
    TelegramConnectionPump(*lumi_telegram_connection,
        TelegramBot.{.name = "inlumi_bot", .relay = "/api/v1/lumi/telegram"},
        TelegramTransport.{.start = LumiTelegramRequest, .poll = LumiTelegramPoll,
            .cancel = LumiTelegramCancel, .receive = LumiTelegramReceive},
        AppTextFromCString(storage_user_id_buffer(), 64), storage_has_sync_account() != 0,
        LumiNodeTrafficAllowed(), LumiOnlineWaiting(), TextUntilNul(client_bytes[:]), TelegramNow(null))
}

LumiTelegramPoll :: (output: []u8) -> s32 {
    if !PollStoredOperation(*lumi_telegram_operation) { return 0 }
    lumi_telegram_session = lumi_telegram_operation.session
    if lumi_telegram_operation.result != cast(s32)AuthResult.AUTH_OK { return -1 }
    return ifx CopyCString(TextUntilNul(lumi_telegram_response[:]), output) then 1 else -1
}
LumiTelegramCancel :: () {
    CancelStoredOperation(*lumi_telegram_operation)
    lumi_telegram_session = Session.{}
}
LumiTelegramReceive :: (document: string) {
    if lumi_telegram_current != null { LumiTelegramApply(lumi_telegram_current, document) }
}
