// Durable account conversation. Older messages load as the chat scrolls up;
// every message remains archived and travels through encrypted account sync.
#import "json_scan"
#import "byte_text_linux"
#import "text"
#import "vec"
#import, file "lumi_types.zi";
#import, file "lumi_ui_types.zi";
#import, file "lumi_chart.zi";
#import, file "package_files.zi";
#import, file "../storage/sqlite.zi";
#import, file "../storage/state.zi";
#import, file "../storage/storage_core.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../storage/bundled_app_records.zi";
#import, file "../storage/daochi_account.zi";
#import, file "../storage/db.zi";
#import, file "../app/text_buffers.zi";

lumi_rows: Vec(LumiChatRow);
// Each loaded message's record key, in the same order, for deleting it.
lumi_keys: Vec(string);
lumi_count: s32;
lumi_owner: [64]u8;
lumi_store_loaded: bool;
lumi_store_error: bool;
lumi_store_revision: u64;

LumiStoreReset :: () {
    lumi_store_revision += 1
    for index: cast(s32)0..lumi_count - 1 {
        PackageFree(lumi_rows[index].text)
        PackageFree(lumi_rows[index].payload)
        PackageFree(lumi_rows[index].quote)
        lumi_rows[index] = LumiChatRow.{}
    }
    VecFree(lumi_rows)
    for index: cast(s32)0..cast(s32)lumi_keys.count - 1 {
        PackageFree(lumi_keys[index])
        lumi_keys[index] = ""
    }
    VecFree(lumi_keys)
    lumi_count = 0
    lumi_owner[0] = cast(u8)0
    lumi_store_loaded = false
    lumi_store_error = false
}

lumi_storage_revision: s64 = -1;
lumi_history_limit: s32 = LUMI_HISTORY_PAGE;
lumi_has_older: bool;
lumi_next_message_id: string;

// Before 2.1.36 a developer's reply was saved as Lumi's words under a
// "Developer reply:" line in the app's language. These are the lines those
// versions wrote, so their saved replies are still recognized after the
// translations change. Returns the length of the line, or 0.
LumiLegacyReplyLabel :: (text: string) -> s64 {
    labels: [12]string = .["Developer reply:\n\n", "Odpověď vývojáře:\n\n",
        "Antwort vom Entwickler:\n\n", "Respuesta del desarrollador:\n\n",
        "Réponse du développeur :\n\n", "Balasan pengembang:\n\n",
        "Risposta dello sviluppatore:\n\n", "開発者からの返信：\n\n", "개발자 답변:\n\n",
        "Resposta do desenvolvedor:\n\n", "Ответ разработчика:\n\n", "开发者回复：\n\n"]
    for label: labels {
        if text.count > label.count && text[:label.count] == label {
            return label.count
        }
    }
    return 0
}

LumiReplyCopy :: struct {
    key: string
    time: s64
    text: string
    quote: string
    legacy: bool
}

// Two saved replies are one reply when their words match and they quote the
// same feedback, or one of them quotes nothing.
LumiSameReply :: (left: LumiReplyCopy, right: LumiReplyCopy) -> bool {
    return left.text == right.text &&
    (left.quote == right.quote || left.quote.count == 0 || right.quote.count == 0)
}

// Each developer reply shows once, as the developer's. Older versions saved
// it as Lumi's words, and every device that fetched it saved its own copy.
// A copy saved the older way becomes the developer's reply, and every other
// copy of a reply is deleted, which sync carries to the other devices. The
// first copy that quotes its feedback is the one kept.
LumiStoreRepairReplies :: (owner: string) {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT key,value FROM (SELECT key,value,json_extract(value,'$.text') AS t FROM settings WHERE user_id=?1 AND key LIKE 'cell.lumi.message.%' AND json_extract(value,'$.deleted') IS NULL AND COALESCE(json_extract(value,'$.kind'),0)=0 AND COALESCE(json_extract(value,'$.user'),0)=0) WHERE json_extract(value,'$.from')='developer' OR (instr(t,char(10)||char(10))>1 AND substr(t,instr(t,char(10)||char(10))-1,1) IN (':','：')) ORDER BY CAST(json_extract(value,'$.time') AS INTEGER),key", -1, *statement, null) != SQLITE_OK {
        return
    }
    bind_text(statement, 1, owner)
    copies: Vec(LumiReplyCopy)
    while SqliteStep(statement) == SQLITE_ROW {
        document := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
        bytes: [1024]u8
        length := ReadStringText(document, FieldAt(document, 0, "text"), bytes[:])
        time := ReadNumber(document, FieldAt(document, 0, "time"))
        if length <= 0 || !time.valid {
            continue
        }
        words := TextFromBytes(bytes[:length])
        from_bytes: [16]u8
        from_length := ReadStringText(document, FieldAt(document, 0, "from"), from_bytes[:])
        developer := from_length > 0 && TextFromBytes(from_bytes[:from_length]) == "developer"
        label: s64 = 0
        if !developer {
            label = LumiLegacyReplyLabel(words)
            if label == 0 {
                continue
            }
        }
        quote_bytes: [LUMI_QUOTE_MAX]u8
        quote_length: s32 = 0
        if developer {
            quote_length = ReadStringText(document, FieldAt(document, 0, "quote"), quote_bytes[:])
            if quote_length < 0 {
                quote_length = 0
            }
        }
        saved := LumiReplyCopy.{.key = PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 256), ""),
            .time = cast(s64)time.value, .text = PackageText(words[label:], ""),
            .quote = PackageText(TextFromBytes(quote_bytes[:quote_length]), ""), .legacy = !developer}
        if !VecPush(copies, saved) {
            PackageFree(saved.key)
            PackageFree(saved.text)
            PackageFree(saved.quote)
            break
        }
    }
    SqliteFinalize(statement)
    for index: cast(s32)0..cast(s32)copies.count - 1 {
        kept: s32 = -1
        for other: cast(s32)0..cast(s32)copies.count - 1 {
            if LumiSameReply(copies[index], copies[other]) &&
            (kept < 0 || (copies[kept].quote.count == 0 && copies[other].quote.count > 0)) {
                kept = other
            }
        }
        reply := copies[index]
        if kept == index && !reply.legacy {
            continue
        }
        out: Vec(u8)
        if kept != index {
            BuilderPrint(*out, "{\"time\":%,\"user\":0,\"kind\":0,\"text\":\"\\u2014\",\"payload\":\"\",\"deleted\":true}",
                reply.time)
        } else {
            BuilderPrint(*out, "{\"time\":%,\"user\":0,\"kind\":0,\"text\":", reply.time)
            LumiJsonString(*out, reply.text)
            BuilderPrint(*out, ",\"payload\":\"\",\"from\":\"developer\",\"quote\":\"\"}")
        }
        value := BuilderFinish(out)
        unused BundledAppRecordWrite(reply.key, value)
        PackageFree(value)
    }
    for index: cast(s32)0..cast(s32)copies.count - 1 {
        PackageFree(copies[index].key)
        PackageFree(copies[index].text)
        PackageFree(copies[index].quote)
    }
    VecFree(copies)
}

LumiStoreLoad :: () {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    revision := storage_data_revision()
    if lumi_store_loaded && owner == AppTextFromCString(*lumi_owner[0], 64) && revision == lumi_storage_revision {
        return
    }
    if owner != AppTextFromCString(*lumi_owner[0], 64) {
        lumi_history_limit = LUMI_HISTORY_PAGE
    }
    LumiStoreReset()
    unused AppCopyText(owner, lumi_owner[:])
    lumi_store_loaded = true
    // Migrate the original bounded history once, without dropping any rows.
    if storage_get_setting_int("lumi_archive_migrated", 0) == 0 {
        statement: *void
        if SqlitePrepareText(storage_db_handle(), "SELECT value FROM settings WHERE user_id=?1 AND key='lumi_chat'", -1, *statement, null) == SQLITE_OK {
            bind_text(statement, 1, owner)
            if SqliteStep(statement) == SQLITE_ROW {
                document := PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 524288), "")
                defer { PackageFree(document) }
                count := ArrayCount(document, 0)
                if count < 0 || count > LUMI_CHAT_MAX {
                    lumi_store_error = true
                } else {
                    for index: cast(s32)0..count - 1 {
                        at := ElementAt(document, 0, index)
                        end := ValueEnd(document, at, 0)
                        if at < 0 || end < 0 {
                            lumi_store_error = true
                            break
                        }
                        hash: [65]u8
                        row := document[at:end]
                        descriptor := cast(*TextDescriptor)(*row)
                        storage_sha256_hex(descriptor.data, row.count, *hash[0])
                        key_out: Vec(u8)
                        BuilderPrint(*key_out, "cell.lumi.message.legacy-%-%", TextFromCString(*hash[0]), index)
                        key := BuilderFinish(key_out)
                        value_out: Vec(u8)
                        BuilderPrint(*value_out, "{\"time\":%,%", index, row[1:])
                        value := BuilderFinish(value_out)
                        if !BundledAppRecordWrite(key, value) { lumi_store_error = true }
                        PackageFree(key)
                        PackageFree(value)
                    }
                }
            }
            SqliteFinalize(statement)
        } else {
            lumi_store_error = true
        }
        if !lumi_store_error { storage_set_setting_int("lumi_archive_migrated", 1) }
    }
    LumiStoreRepairReplies(owner)
    // Deleted messages and the retired donation cards stay out of the chat.
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT value,key FROM (SELECT value,key FROM settings WHERE user_id=?1 AND key LIKE 'cell.lumi.message.%' AND json_extract(value,'$.deleted') IS NULL AND COALESCE(json_extract(value,'$.kind'),0)!=2 ORDER BY CAST(json_extract(value,'$.time') AS INTEGER) DESC,key DESC LIMIT ?2) ORDER BY CAST(json_extract(value,'$.time') AS INTEGER),key", -1, *statement, null) != SQLITE_OK {
        lumi_store_error = true
        return
    }
    defer { SqliteFinalize(statement) }
    bind_text(statement, 1, owner)
    SqliteBindInt(statement, 2, lumi_history_limit)
    while SqliteStep(statement) == SQLITE_ROW {
        document := AppTextFromCString(SqliteColumnText(statement, 0), 65536)
        element: s32 = 0
        bytes: [1024]u8
        length := ReadStringText(document, FieldAt(document, element, "text"), bytes[:])
        user := ReadNumber(document, FieldAt(document, element, "user"))
        kind: s32 = LUMI_CHAT_TEXT
        kind_at := FieldAt(document, element, "kind")
        payload_bytes: [4096]u8
        payload: string
        rich_valid := true
        if kind_at >= 0 {
            number := ReadNumber(document, kind_at)
            rich_valid = number.valid && number.value >= 0 && number.value <= 3 &&
            number.value == cast(float64)cast(s32)number.value
            if rich_valid {
                kind = cast(s32)number.value
            }
            if kind == LUMI_CHAT_PROGRESS || kind == LUMI_CHAT_FEEDBACK {
                payload_length := ReadStringText(document, FieldAt(document, element, "payload"), payload_bytes[:])
                rich_valid = rich_valid && payload_length > 0 && payload_length < LUMI_PAYLOAD_MAX
                if rich_valid {
                    payload = TextFromBytes(payload_bytes[:payload_length])
                    rich_valid = ifx kind == LUMI_CHAT_PROGRESS then LumiChartRead(payload).valid else payload.count == 32
                }
            } else if kind == LUMI_CHAT_TEXT && user.value == 1.0 {
                source_bytes: [16]u8
                payload_length := ReadStringText(document, FieldAt(document, element, "payload"), source_bytes[:])
                if payload_length > 0 {
                    source := TextFromBytes(source_bytes[:payload_length])
                    rich_valid = source == "telegram"
                    if rich_valid { payload = "telegram" }
                }
            }
            rich_valid = rich_valid && (kind == LUMI_CHAT_TEXT || user.value == 0.0)
        }
        if length <= 0 || length >= LUMI_INPUT_MAX || !user.valid ||
        (user.value != 0.0 && user.value != 1.0) || !rich_valid {
            LumiStoreReset()
            unused AppCopyText(owner, lumi_owner[:])
            lumi_store_loaded = true
            lumi_store_error = true
            return
        }
        // A developer's reply names its author and quotes the feedback it
        // answers. Older versions ignore both fields and show its words.
        developer := false
        quote_bytes: [LUMI_QUOTE_MAX]u8
        quote_length: s32 = 0
        if kind == LUMI_CHAT_TEXT && user.value == 0.0 {
            from_bytes: [16]u8
            from_length := ReadStringText(document, FieldAt(document, element, "from"), from_bytes[:])
            developer = from_length > 0 && TextFromBytes(from_bytes[:from_length]) == "developer"
        }
        if developer {
            quote_length = ReadStringText(document, FieldAt(document, element, "quote"), quote_bytes[:])
            if quote_length < 0 {
                quote_length = 0
            }
        }
        row := LumiChatRow.{.text = PackageText(TextFromBytes(bytes[0:length]), ""),
            .user = user.value == 1.0, .kind = kind, .payload = PackageText(payload, ""),
            .developer = developer, .quote = PackageText(TextFromBytes(quote_bytes[:quote_length]), "")}
        if !VecPush(lumi_rows, row) {
            PackageFree(row.text)
            PackageFree(row.payload)
            PackageFree(row.quote)
            lumi_store_error = true
            return
        }
        row_key := PackageText(AppTextFromCString(SqliteColumnText(statement, 1), 256), "")
        if !VecPush(lumi_keys, row_key) {
            PackageFree(row_key)
            lumi_store_error = true
            return
        }
        lumi_count += 1
    }
    total: *void
    lumi_has_older = false
    if SqlitePrepareText(storage_db_handle(), "SELECT COUNT(*) FROM settings WHERE user_id=?1 AND key LIKE 'cell.lumi.message.%' AND json_extract(value,'$.deleted') IS NULL", -1, *total, null) == SQLITE_OK {
        bind_text(total, 1, owner)
        lumi_has_older = SqliteStep(total) == SQLITE_ROW && SqliteColumnInt64(total, 0) > lumi_count
        SqliteFinalize(total)
    }
    lumi_storage_revision = storage_data_revision()
}

// Back to the newest page, as when the chat is opened again.
LumiStoreShowNewest :: () {
    if lumi_history_limit != LUMI_HISTORY_PAGE {
        lumi_history_limit = LUMI_HISTORY_PAGE
        lumi_storage_revision = -1
    }
}

LumiStoreLoadOlder :: () -> bool {
    LumiStoreLoad()
    if !lumi_has_older || lumi_store_error {
        return false
    }
    previous := lumi_count
    lumi_history_limit += LUMI_HISTORY_PAGE
    lumi_storage_revision = -1
    LumiStoreLoad()
    return !lumi_store_error && lumi_count > previous
}

LumiJsonString :: (out: *Vec(u8), value: string) {
    BuilderPrint(out, "\"")
    for byte: value {
        if byte == cast(u8)34 {
            BuilderPrint(out, "\\\"")
        } else if byte == cast(u8)92 {
            BuilderPrint(out, "\\\\")
        } else if byte == cast(u8)10 {
            BuilderPrint(out, "\\n")
        } else if byte == cast(u8)13 {
            BuilderPrint(out, "\\r")
        } else if byte == cast(u8)9 {
            BuilderPrint(out, "\\t")
        } else if byte >= cast(u8)32 {
            unused VecPush(out.*, byte)
        }
    }
    BuilderPrint(out, "\"")
}

LumiStoreSave :: () -> bool {
    return !lumi_store_error
}

LumiStoreAppend :: (text: string, user: bool) {
    source := LumiTelegramMessageSource(lumi_next_message_id)
    unused LumiStoreAppendCard(text, user, LUMI_CHAT_TEXT, source)
}

LumiStoreAppendCard :: (text: string, user: bool, kind: s32, payload: string) -> bool {
    return LumiStoreAppendRow(LumiChatRow.{.text = text, .user = user, .kind = kind, .payload = payload})
}

// Saves a message and shows it. Only the developer's text replies quote.
LumiStoreAppendRow :: (message: LumiChatRow) -> bool {
    text := message.text
    user := message.user
    kind := message.kind
    payload := message.payload
    if text.count == 0 || text.count >= LUMI_INPUT_MAX {
        return false
    }
    telegram_source := user && kind == LUMI_CHAT_TEXT && payload == "telegram"
    if kind < LUMI_CHAT_TEXT || kind > LUMI_CHAT_FEEDBACK || kind == LUMI_CHAT_RETIRED ||
    (kind != LUMI_CHAT_TEXT && user) ||
    (kind == LUMI_CHAT_PROGRESS && !LumiChartRead(payload).valid) ||
    (kind == LUMI_CHAT_FEEDBACK && payload.count != 32) ||
    (!telegram_source && kind != LUMI_CHAT_PROGRESS && kind != LUMI_CHAT_FEEDBACK && payload.count != 0) {
        return false
    }
    if (message.developer && (user || kind != LUMI_CHAT_TEXT)) ||
    (!message.developer && message.quote.count != 0) ||
    message.quote.count >= LUMI_QUOTE_MAX {
        return false
    }
    LumiStoreLoad()
    if lumi_store_error { return false }
    nonce: [65]u8
    if !NativeNonce(null, nonce[:]) { return false }
    key: string
    if lumi_next_message_id.count > 0 {
        key = PackageText("cell.lumi.message.", lumi_next_message_id)
    } else {
        key = PackageText("cell.lumi.message.", TextFromCString(*nonce[0]))
    }
    defer { PackageFree(key) }
    out: Vec(u8)
    BuilderPrint(*out, "{\"time\":%,\"user\":%,\"kind\":%,\"text\":", BundledAppRecordClock(), ifx user then 1 else 0, kind)
    LumiJsonString(*out, text)
    BuilderPrint(*out, ",\"payload\":")
    LumiJsonString(*out, payload)
    if message.developer {
        BuilderPrint(*out, ",\"from\":\"developer\",\"quote\":")
        LumiJsonString(*out, message.quote)
    }
    BuilderPrint(*out, "}")
    value := BuilderFinish(out)
    defer { PackageFree(value) }
    if !BundledAppRecordWrite(key, value) { return false }
    lumi_next_message_id = ""
    lumi_storage_revision = storage_data_revision()
    // Keep the messages already loaded while new replies arrive. Once older
    // history is expanded, appending never discards the reading position.
    if lumi_count == lumi_history_limit {
        lumi_history_limit += 1
    }
    row := LumiChatRow.{.text = PackageText(text, ""), .user = user,
        .kind = kind, .payload = PackageText(payload, ""),
        .developer = message.developer, .quote = PackageText(message.quote, "")}
    if !VecPush(lumi_rows, row) {
        PackageFree(row.text)
        PackageFree(row.payload)
        PackageFree(row.quote)
        lumi_storage_revision = -1
        return false
    }
    row_key := PackageText(key, "")
    if !VecPush(lumi_keys, row_key) {
        PackageFree(row_key)
        lumi_storage_revision = -1
        return false
    }
    lumi_count += 1
    lumi_store_revision += 1
    return true
}

// Deleting keeps a small record under the same key, so other devices learn of
// it through sync and keep the message's place. Inner Breeze 2.1.28 and older
// do not know deleted messages and show it as a dash instead of failing.
LumiStoreDelete :: (index: s32) -> bool {
    LumiStoreLoad()
    if lumi_store_error || index < 0 || index >= lumi_count || index >= cast(s32)lumi_keys.count {
        return false
    }
    key := lumi_keys[index]
    existing := BundledAppRecordRead(key)
    defer { PackageFree(existing) }
    time := ReadNumber(existing, FieldAt(existing, 0, "time"))
    if !time.valid {
        return false
    }
    out: Vec(u8)
    BuilderPrint(*out, "{\"time\":%,\"user\":0,\"kind\":0,\"text\":\"\\u2014\",\"payload\":\"\",\"deleted\":true}",
        cast(s64)time.value)
    value := BuilderFinish(out)
    defer { PackageFree(value) }
    if !BundledAppRecordWrite(key, value) {
        return false
    }
    lumi_storage_revision = -1
    return true
}

LumiStoreRevision :: () -> u64 {
    return lumi_store_revision
}

LumiStoreCount :: () -> s32 {
    LumiStoreLoad()
    return lumi_count
}

LumiStoreRow :: (index: s32) -> LumiChatRow {
    if index < 0 || index >= lumi_count {
        return LumiChatRow.{}
    }
    return lumi_rows[index]
}
