// Called only by the host after a verified Photos leaf successfully resolves
// its original photo. Thumbnail rendering and other apps never reach this hook.
#import "std/text_buffer"
#import "std/vec"
#import "std/text"
#import, file "../storage/achievements.zi";
#import, file "package_files.zi";

AchievementPhotoOpened :: (hash: string) {
    if hash.count != 64 { return }
    for byte: hash {
        if !((byte >= #char "0" && byte <= #char "9") || (byte >= #char "a" && byte <= #char "f")) { return }
    }
    day := AchievementToday()
    if day == 0 { return }
    bytes: Vec(u8)
    BuilderPrint(*bytes, "%.%", hash, day)
    source := BuilderFinish(bytes)
    defer { PackageFree(source) }
    unused AchievementRecord("photo.open", source, day, 1, "", hash)
}
