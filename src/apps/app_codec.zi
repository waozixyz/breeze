WidgetHabitsEditQuestionCodec :: struct {
    fields: [8]HostField
}

WidgetEncodeHabitsEditQuestion :: (data: HabitsEditQuestion, codec: *WidgetHabitsEditQuestionCodec) -> HostValue {
    value := HostRecordValue("HabitsEditQuestion", codec.fields[:])
    codec.fields[0] = HostField.{.name = HostTextData("id"), .value = HostScalar("s64", cast(s64)data.id)}
    codec.fields[1] = HostField.{.name = HostTextData("answer_type"), .value = HostScalar("s32", cast(s64)data.answer_type)}
    codec.fields[2] = HostField.{.name = HostTextData("text"), .value = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(data.text), .length = cast(usize)data.text.count}}
    codec.fields[3] = HostField.{.name = HostTextData("goal_kind"), .value = HostScalar("s32", cast(s64)data.goal_kind)}
    codec.fields[4] = HostField.{.name = HostTextData("goal_low"), .value = HostScalar("s32", cast(s64)data.goal_low)}
    codec.fields[5] = HostField.{.name = HostTextData("goal_high"), .value = HostScalar("s32", cast(s64)data.goal_high)}
    codec.fields[6] = HostField.{.name = HostTextData("low_text"), .value = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(data.low_text), .length = cast(usize)data.low_text.count}}
    codec.fields[7] = HostField.{.name = HostTextData("high_text"), .value = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(data.high_text), .length = cast(usize)data.high_text.count}}
    return value
}

