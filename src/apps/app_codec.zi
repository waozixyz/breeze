    data: HabitsEditQuestion
    unused codec
    zero: HostValue
    data.id = cast(s64)HostFieldValue(*value, 0, "id", *zero).integer
    data.answer_type = cast(s32)HostFieldValue(*value, 1, "answer_type", *zero).integer
    data.text = HostValueText(HostFieldValue(*value, 2, "text", *zero).*)
    data.goal_kind = cast(s32)HostFieldValue(*value, 3, "goal_kind", *zero).integer
    data.goal_low = cast(s32)HostFieldValue(*value, 4, "goal_low", *zero).integer
    data.goal_high = cast(s32)HostFieldValue(*value, 5, "goal_high", *zero).integer
    data.low_text = HostValueText(HostFieldValue(*value, 6, "low_text", *zero).*)
    data.high_text = HostValueText(HostFieldValue(*value, 7, "high_text", *zero).*)
