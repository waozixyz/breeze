    codec.fields[6] = HostField.{.name = HostTextData("done"), .value = HostScalar("bool", ifx data.done then 1 else 0)}
    return value
}

WidgetDecodePracticeCourseRow :: (value: HostValue, codec: *WidgetPracticeCourseRowCodec) -> PracticeCourseRow {
    data: PracticeCourseRow
    unused codec
    zero: HostValue
    data.title = HostValueText(HostFieldValue(*value, 0, "title", *zero).*)
    data.subtitle = HostValueText(HostFieldValue(*value, 1, "subtitle", *zero).*)
    data.summary = HostValueText(HostFieldValue(*value, 2, "summary", *zero).*)
    data.detail = HostValueText(HostFieldValue(*value, 3, "detail", *zero).*)
    data.first = cast(s32)HostFieldValue(*value, 4, "first", *zero).integer
    data.count = cast(s32)HostFieldValue(*value, 5, "count", *zero).integer
    data.done = HostFieldValue(*value, 6, "done", *zero).integer != 0
    return data
}

WidgetValidPracticeCourseRow :: (value: HostValue) -> bool {
    if !HostRecordValid(*value, "PracticeCourseRow") { return false }
    if !HostFieldScalarValid(*value, 0, "title", "string", cast(s32)HostString) { return false }
    if !HostFieldScalarValid(*value, 1, "subtitle", "string", cast(s32)HostString) { return false }
    if !HostFieldScalarValid(*value, 2, "summary", "string", cast(s32)HostString) { return false }
    if !HostFieldScalarValid(*value, 3, "detail", "string", cast(s32)HostString) { return false }
    if !HostFieldScalarValid(*value, 4, "first", "s32", cast(s32)HostInteger) { return false }
    if !HostFieldScalarValid(*value, 5, "count", "s32", cast(s32)HostInteger) { return false }
    if !HostFieldScalarValid(*value, 6, "done", "bool", cast(s32)HostInteger) { return false }
    return true
}
