    codec.fields[7].value = WidgetEncodeColor(data.text_color, *codec.text_color)
    codec.fields[8].name = HostTextData("canvas_color")
    codec.fields[8].value = WidgetEncodeColor(data.canvas_color, *codec.canvas_color)
    codec.fields[9].name = HostTextData("card_fill")
    codec.fields[9].value = WidgetEncodeColor(data.card_fill, *codec.card_fill)
