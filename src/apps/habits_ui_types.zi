#import "session"
#import "drawing_props"
#import "geometry"
#import "text_input_props"

// What a counting habit's day shows in its count dialog, from the host, and
// what the dialog asks the host to do once the frame is drawn.
HabitsUiFrame :: struct {
    session: Session
    scale: float32
    // The app's small text size, already scaled.
    small_font: s32
    // The theme's text colour, for the minus and plus bars.
    text_color: Color
    name: string
    // The day as YYYYMMDD, and whether it is today.
    day: s32
    today: bool
    count: s32
    target: s32
    // Practice sessions linked to the day; the count never goes below them.
    linked_count: s32
    // Whether the habit asks questions, kept as the day's entries.
    asks: bool
    action: s32
}

// A reward in the habit shop as Habits draws and changes it: its id, empty
// for a new one, its name, its price in coins and its symbol, one of the
// habit icons.
HabitsShopReward :: struct {
    id: string
    name: string
    price: s32
    icon: s32
}

// A line of the shop's Activity: a done day's coins or a reward bought.
HabitsShopActivity :: struct {
    name: string
    icon: s32
    // Half coins: earned above 0, spent below.
    halves: s64
    // Today, or a short weekday and the day of the month.
    day: string
}

// The habit shop's page, which Habits draws: the coins and rewards the host
// keeps, the form's state and the person's typing, and what the page asks
// the host to do once it is drawn. The form's state comes back changed.
HabitsShopFrame :: struct {
    session: Session
    scale: float32
    // The page's bounds, and the window's width for its dialog.
    bounds: Rectangle
    view_width: s32
    // The app's text sizes, already scaled.
    font: s32
    small_font: s32
    // The theme's text colour, its muted text class and its cards.
    text_color: Color
    muted_class: s32
    card_fill: Color
    card_border: Color
    card_radius: s32
    // Another dialog is open, so the page takes no input.
    modal_active: bool
    // What was typed for the focused field.
    input: TextFieldInput
    // The coins to spend, in half coins.
    halves: s64
    // The whole coins the shop lends once the balance is spent, or 0 when
    // buying stays within the balance.
    borrow_limit: s32
    reward_count: s32
    activity_count: s32
    scroll: s32
    // The reward the form changes, or empty while it adds one.
    editing: string
    name: string
    name_cursor: s32
    name_anchor: s32
    name_scroll_x: s32
    name_focused: bool
    price: s32
    // The price as typed; it follows price while unfocused.
    price_text: string
    price_cursor: s32
    price_anchor: s32
    price_scroll_x: s32
    price_focused: bool
    // The borrow limit as typed; it follows borrow_limit while unfocused.
    borrow_text: string
    borrow_cursor: s32
    borrow_anchor: s32
    borrow_scroll_x: s32
    borrow_focused: bool
    // The form's symbol, and whether the grid of symbols is open.
    icon: s32
    icon_open: bool
    clipboard_write: bool
    clipboard_text: string
    action: s32
    // The reward Buy asks about.
    buying: HabitsShopReward
}

// The habit list and a habit's own page, which Habits draws: the page's
// bounds, the theme and the state the host keeps, and then each habit and
// its days on request. The state comes back changed, with what the page
// asks the host to do once it is drawn.
HabitsListFrame :: struct {
    session: Session
    scale: float32
    bounds: Rectangle
    // The app's text sizes, already scaled.
    font: s32
    small_font: s32
    // The theme's colours, its muted text class and its cards.
    text_color: Color
    surface_color: Color
    accent_color: Color
    card_fill: Color
    card_border: Color
    muted_class: s32
    // Text classes in black and in white, for letters and counts on a
    // habit's colour.
    ink_dark_class: s32
    ink_light_class: s32
    // Another dialog is open, so the page takes no input.
    modal_active: bool
    // On a touch screen a row is lifted only once held; a mouse drags it
    // at once.
    touch: bool
    // The app's clock in seconds, which times holds and the dragged row's
    // scrolling.
    now: float64
    // Today as YYYYMMDD.
    today: s32
    habit_count: s32
    // The most habits there may be; Add is off at that many.
    habit_limit: s32
    // The coins to spend, in half coins.
    halves: s64
    // HABITS_SCREEN_OVERVIEW for the list, HABITS_SCREEN_HISTORY for the
    // selected habit's page, which shows HABIT_VIEW_WEEKLY or
    // HABIT_VIEW_CALENDAR.
    screen_mode: s32
    view_mode: s32
    selected: s32
    scroll: s32
    // The name column's width in design units, or 0 for its default.
    name_width: s32
    show_deactivated: bool
    // A habit just opened: the list scrolls it into view once.
    reveal_selected: bool
    // The days the week list shows, and the calendar's month from this one.
    weekly_days: s32
    month_offset: s32
    // A row dragged to another place, kept from frame to frame.
    dragging: bool
    drag_habit: s32
    drag_lifted: bool
    drag_moving: bool
    // Where the press started.
    drag_origin: Vector2
    drag_at_edge: bool
    drag_edge_since: float64
    drag_scroll_at: float64
    drag_scroll_carry: float32
    drag_pointer: Vector2
    drag_grab: Vector2
    drag_bounds: Rectangle
    // The name column's border dragged to resize it.
    name_resizing: bool
    name_resize_origin: float32
    name_resize_start: float32
    // What the page asks for (HABITS_LIST_), the habit and day it concerns,
    // and for a move the place the habit takes.
    action: s32
    action_habit: s32
    action_day: s32
    action_target: s32
    // A day was tapped with the secondary button, which counts it down.
    action_decrement: bool
    // The page's settings changed and should be saved.
    save: bool
    // Where the first-run guide points: today's progress, the coins, the
    // first row, the open habit's history, statistics and editor buttons,
    // and the first day of a habit's own page.
    anchor_progress: Rectangle
    anchor_coins: Rectangle
    anchor_table: Rectangle
    anchor_history: Rectangle
    anchor_statistics: Rectangle
    anchor_edit: Rectangle
    anchor_day: Rectangle
    // The first habit's today circle, which the web smoke test taps.
    first_day: Rectangle
}

// A habit as the list shows it.
HabitsListRow :: struct {
    name: string
    description: string
    color: Color
    // Its icon (habit_icons.zi), or 0 for its name's first letter.
    icon: s32
    deactivated: bool
    // A counting habit shows each day's count, and its target.
    counting: bool
    target: s32
    // Planned days done in a row up to today, and this week's done and
    // planned days.
    streak: s32
    week_done: s32
    week_planned: s32
}

// A day of a habit: whether it was planned, done, how often it was
// counted, and whether a span started on it is still running.
HabitsListDay :: struct {
    day: s32
    planned: bool
    complete: bool
    count: s32
    running: bool
}

// A habit's day screen, which Habits draws: its title bar, the day's
// entries, the practice sessions linked to it with each round of a
// breathing session, and a counting habit's count. The host gives the
// day's facts and keeps the round being changed; the page returns what the
// person asked for.
HabitsDayFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    // The room the app keeps at the bottom for its navigation.
    bottom: s32
    font: s32
    small_font: s32
    text_color: Color
    surface_color: Color
    canvas_color: Color
    card_fill: Color
    card_border: Color
    muted_class: s32
    modal_active: bool
    // The day as YYYY-MM-DD, the screen's title.
    title: string
    // The habit keeps entries: it asks questions or measures spans.
    keeps_entries: bool
    span: bool
    counting: bool
    // A counting habit's count of the day, which its linked sessions keep
    // from going below minimum_count.
    count: s32
    minimum_count: s32
    entry_count: s32
    session_count: s32
    scroll: s32
    // A round being changed: its session and round, the seconds typed and
    // the cursor among them; the number pad shows while keyboard is set.
    editing: bool
    edit_session: s32
    edit_round: s32
    edit_text: string
    edit_cursor: s32
    keyboard: bool
    // What was typed while a round is changed.
    input: TextFieldInput
    // What the page asks for (HABITS_DAY_SCREEN_), the entry or session
    // and round it concerns, and a count's step.
    action: s32
    action_index: s32
    action_round: s32
    action_step: s32
}

// An entry of the day: its time, or a span's start, end and length, its
// answers as a line for each question and then one for its value, and
// whether its span is still running.
HabitsDayEntry :: struct {
    id: string
    when: string
    summary: string
    running: bool
}

// A practice session linked to the day: the practice and its name, its
// time as HH:MM, what it did (rounds, repetitions or a length) and a line
// of its details; a breathing session's rounds are changed one by one,
// and other practices have none.
HabitsDaySession :: struct {
    activity: s32
    title: string
    time: string
    summary: string
    details: string
    rounds: s32
}

// The entry dialog, which Habits draws over the habit list or a day's
// screen: a new entry of a day, or one being changed.
HabitsEntryFrame :: struct {
    session: Session
    scale: float32
    view_height: s32
    font: s32
    small_font: s32
    muted_class: s32
    modal_active: bool
    // The habit's name, the dialog's title, and the day as YYYYMMDD.
    name: string
    day: s32
    today: s32
    // An entry that exists is saved again or deleted; a new one is done,
    // or skipped without answers.
    existing: bool
    span: bool
    // The time, or a span's start, and a span's end in minutes after
    // midnight; -1 while none is picked. A span without an end keeps
    // running.
    start: s32
    end: s32
    // The answers a span's start and end questions take, or -1.
    start_answer: s32
    end_answer: s32
    answer_count: s32
    // Now in minutes after midnight.
    now: s32
    // The answer typed in, or -1, with its cursor and scrolling.
    focus: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    scroll: s32
    input: TextFieldInput
    clipboard_write: bool
    clipboard_text: string
    // What the dialog asks for (HABITS_ENTRY_).
    action: s32
}

// An answer of the dialog's entry: its question's words and answer type,
// its value, and a time answer's minutes after midnight or -1.
HabitsAnswer :: struct {
    question: string
    answer_type: s32
    value: string
    time: s32
}

// The habit editor, which Habits draws: the habit being added or changed as
// the host keeps it, its fields' cursors and what was typed. The state
// comes back changed, with what the editor asks the host to do; its
// questions are read and changed one by one.
HabitsEditFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    font: s32
    small_font: s32
    text_color: Color
    canvas_color: Color
    card_fill: Color
    card_border: Color
    muted_class: s32
    // Text classes in black and in white, for a planned day on the habit's
    // colour.
    ink_dark_class: s32
    ink_light_class: s32
    // The practice picker is open; the editor draws it alone.
    picking_practices: bool
    // Today as YYYYMMDD, and now in minutes after midnight.
    today: s32
    now: s32
    is_new: bool
    name: string
    name_cursor: s32
    name_anchor: s32
    name_scroll_x: s32
    name_focused: bool
    // 1 while the name is empty, 2 while another habit has it.
    name_error: s32
    description: string
    description_cursor: s32
    description_anchor: s32
    description_scroll_y: s32
    description_focused: bool
    color: Color
    more_colors: bool
    icon: s32
    more_icons: bool
    // The schedule the habit takes from today on (HabitSchedule).
    repeat: s32
    every: s32
    start: s32
    weekdays: s32
    month_days: s32
    last_day: bool
    week_of_month: s32
    formula: string
    formula_cursor: s32
    formula_anchor: s32
    formula_scroll_x: s32
    formula_focused: bool
    // The hour it reminds, or -1.
    reminder_hour: s32
    difficulty: s32
    custom_coins: bool
    coin_halves: s32
    coin_text: string
    coin_cursor: s32
    coin_anchor: s32
    coin_scroll_x: s32
    coin_focused: bool
    counter_enabled: bool
    counter_target: s32
    // The daily target as typed; it follows counter_target while unfocused.
    counter_text: string
    counter_cursor: s32
    counter_anchor: s32
    counter_scroll_x: s32
    counter_focused: bool
    // Whether the habit measures spans, and which are good (HabitGoal); the
    // goal's lengths as typed in hours and minutes.
    span: bool
    span_kind: s32
    span_low: s32
    span_high: s32
    span_low_hours: string
    span_low_minutes: string
    span_high_hours: string
    span_high_minutes: string
    // The practices linked to the habit, a bit for each.
    sync_activity: s32
    practice_count: s32
    question_count: s32
    // 1 + the question typed in, or 0, and its field's cursor.
    question_focused: s32
    question_cursor: s32
    question_anchor: s32
    question_scroll_x: s32
    // 1 + the goal field typed in, or 0, and its cursor.
    goal_focused: s32
    goal_cursor: s32
    goal_anchor: s32
    goal_scroll_x: s32
    scroll: s32
    // What was typed for the focused field.
    input: TextFieldInput
    area_input: TextAreaInput
    clipboard_write: bool
    clipboard_text: string
    // What the editor asks for (HABITS_EDIT_), and the question it concerns.
    action: s32
    action_index: s32
}

// A question of the habit being edited: its id, answer type and words, its
// goal (HabitGoal), and a number goal's bounds as typed.
HabitsEditQuestion :: struct {
    id: s64
    answer_type: s32
    text: string
    goal_kind: s32
    goal_low: s32
    goal_high: s32
    low_text: string
    high_text: string
}

// A practice the habit can link, in the order Practice shows them: its name
// and its bit among the habit's linked practices.
HabitsEditPractice :: struct {
    label: string
    mask: s32
}

// A habit's statistics, which Habits draws: the page's look, the figures
// the host counts over the habit's days, and how many of each kind of row
// it reads on request. The chart of a span habit's lengths is chart 0 and
// each question's is its index + 1.
HabitsStatsFrame :: struct {
    session: Session
    scale: float32
    view_width: s32
    view_height: s32
    // The room the app keeps at the bottom for its navigation.
    bottom: s32
    font: s32
    small_font: s32
    text_color: Color
    canvas_color: Color
    card_fill: Color
    card_border: Color
    muted_class: s32
    modal_active: bool
    name: string
    color: Color
    scroll: s32
    // Planned days done in a row up to today, the longest run of the last
    // year, and the days done of the last 30.
    current_streak: s32
    best_streak: s32
    last_30_done: s32
    // Days done of the last 8 weeks, by weekday from Sunday.
    sunday: s32
    monday: s32
    tuesday: s32
    wednesday: s32
    thursday: s32
    friday: s32
    saturday: s32
    // Sessions linked to the habit, with the best and the total time.
    linked: bool
    best_time: string
    total_time: string
    // Mood check-ins after its practices: how many, their average, and how
    // many of each mood from 1 to 5.
    mood_total: s32
    mood_average: float32
    mood_1: s32
    mood_2: s32
    mood_3: s32
    mood_4: s32
    mood_5: s32
    // Wim Hof rounds of the last 31 days, and the days their graph shows,
    // 7 or 31, or 0 when the habit has no Wim Hof rounds at all.
    hold_count: s32
    hold_days: s32
    span: bool
    // A span habit's spans: when they started and ended on average, in
    // hundredths of minutes after midnight, or -1 without spans.
    span_start_average: s64
    span_end_average: s64
    question_count: s32
    change_count: s32
    // HABITS_STATS_BACK when Back was pressed.
    action: s32
}

// What a chart's values add up to: its title and answer type, whether it
// shows (a span's start and end questions do not), and its figures.
HabitsStatsChart :: struct {
    title: string
    answer_type: s32
    shown: bool
    point_count: s32
    lowest: s32
    highest: s32
    sum: s64
    // The average in hundredths, or -1 without values.
    average: s64
    days: s32
    answered: s32
    yes: s32
    judged: s32
    good: s32
    recent_count: s32
}

// A chart's value on a day slot of the last 30: whether its goal found it
// good (1), not (0) or did not judge it (-1), the label it shows, and the
// goal it had then, with the average an average goal compared it to in
// hundredths, or -1.
HabitsStatsPoint :: struct {
    slot: s32
    value: s32
    good: s32
    label: string
    goal_kind: s32
    goal_low: s32
    goal_high: s32
    benchmark: s64
}

// One of a written question's latest answers, with its day.
HabitsStatsRecent :: struct {
    day: s32
    text: string
}

// A Wim Hof round of the last 31 days: how many days before today, when in
// that day (seconds), its place in its session, and how long the breath was
// held in seconds.
HabitsStatsHold :: struct {
    days_ago: s32
    time: s32
    round: s32
    seconds: s32
}

// A change of the habit's settings, newest first: when, and in words.
HabitsStatsChange :: struct {
    when: string
    line: string
}
