// Verified installed leaf metadata outlives the VM that supplied it. These
// account-local, owned copies are never serialized as handles or synced data.
#import "apps/tree"
#import "apps/host"
#import "kryon/hosted_app"
#import, file "catalog.zi";
#import "apps/catalog"
#import "apps/protocol"
#import "std/vec"
#import "std/option"
#import "std/c_string"
#import "std/text_buffer"
#import, file "node_apps.zi";
#import, file "node_app_runner.zi";
#import, file "node_app_tree.zi";
#import, file "package_files.zi";
#import, file "package_manager.zi";
#import, file "package_release.zi";
#import, file "../storage/temporary_data.zi";
#import "std/byte_text_linux"
#import, file "../app/assets.zi";
#import, file "../storage/achievements.zi";

NodeInstalledLeaf :: struct {
    identity: AppIdentity
    root: [25]u8
    owner: [25]u8
    nested: bool
    assets: [13]string
}
NodeSnapshotStep :: struct { handle: AppHandle; next: s64 }
NodeSnapshotScan :: struct {
    stack: Vec(NodeSnapshotStep)
    account: [65]u8
}
node_snapshot_scans: [NodeAppSlots]NodeSnapshotScan;
node_installed_leaves: Vec(NodeInstalledLeaf);
node_installed_account: [65]u8;
node_snapshot_scanning: bool;
node_installed_revision: u64 = 1;
node_installed_visibility: u64;
node_installed_observed_account: [65]u8;
// The release whose saved leaves each slot holds for the current account.
node_installed_releases: [NodeAppSlots][65]u8;

NodeInstalledClear :: () {
    for entry: node_installed_leaves {
        for text: entry.assets { PackageFree(text) }
    }
    while node_installed_leaves.count > 0 { unused VecPop(node_installed_leaves) }
    node_installed_account[0] = 0
    for slot: cast(s32)0..NodeAppSlots - 1 { node_installed_releases[slot][0] = 0 }
    node_installed_revision += 1
}

// Whether the slot's leaves for this release are already held, so opening
// it needs no scan of every child it contains.
NodeInstalledCurrent :: (slot: s32, hash: string) -> bool {
    return slot >= 0 && slot < NodeAppSlots && hash.count == 64 &&
    TextUntilNul(node_installed_releases[slot][:]) == hash &&
    TextUntilNul(node_installed_account[:]) == NodeTreeAccount()
}

NodeInstalledPath :: (owner: string, index: s32) -> string {
    if index == 0 { return NodeAppAssetPath(owner, "achievements.json") }
    languages: [12]string = .["cs", "de", "en", "es", "fr", "id", "it", "ja", "ko", "pt", "ru", "zh"]
    if index < 1 || index > 12 { return "" }
    out: Vec(u8)
    BuilderPrint(*out, "assets/%/achievement-locales/%.json", owner, languages[index - 1])
    return BuilderFinish(out)
}

NodeInstalledCapture :: (slot: s32, node: *AppNode) -> bool {
    account := NodeTreeAccount()
    if account != TextUntilNul(node_installed_account[:]) {
        NodeInstalledClear()
        unused CopyCString(account, node_installed_account[:])
    }
    runner := *node_runners[slot]
    owner := ifx node != null then NodeTreeLegacyOwner(runner, node) else NodeAppVerifiedLeafName(slot)
    if owner == "" { return true }
    entry: NodeInstalledLeaf
    unused CopyCString(owner, entry.owner[:])
    unused CopyCString(NodeAppName(slot), entry.root[:])
    entry.nested = node != null
    if node != null { entry.identity = node.identity }
    else {
        if !NodeTreeAuthority(runner, entry.identity.authority[:]) { return false }
        unused CopyCString(PackageID(NodeAppIndex(slot)), entry.identity.id[:])
    }
    canonical := TextUntilNul(entry.identity.id[:])
    for index: cast(s32)0..12 {
        path := NodeInstalledPath(TextUntilNul(entry.owner[:]), index)
        asset := ifx node != null then AppHostAsset(node, path) else HostedAppAsset(*runner.app, path)
        PackageFree(path)
        if !asset.found { continue }
        if asset.data.count > 262144 || (index == 0 && !AchievementCatalog(asset.data, canonical, false)) {
            for text: entry.assets { PackageFree(text) }
            return false
        }
        bytes: Vec(u8)
        BuilderPrint(*bytes, "%", asset.data)
        entry.assets[index] = BuilderFinish(bytes)
    }
    for index: cast(s64)0..node_installed_leaves.count - 1 {
        saved := *node_installed_leaves[index]
        if AppIdentityEqual(*saved.identity, *entry.identity) &&
        TextUntilNul(saved.root[:]) == TextUntilNul(entry.root[:]) {
            for text: saved.assets { PackageFree(text) }
            saved.* = entry
            node_installed_revision += 1
            return true
        }
    }
    if node_installed_leaves.count >= 64 || !VecPush(node_installed_leaves, entry) {
        for text: entry.assets { PackageFree(text) }
        return false
    }
    node_installed_revision += 1
    return true
}

// Scan-owned children are distinct from the active app's navigation path.
// Retire them before closing or replacing the root that owns their assets.
NodeInstalledScanCancel :: (slot: s32) {
    scan := *node_snapshot_scans[slot]
    host := node_runners[slot].nested
    if host != null {
        AppHostCancelChild(host)
    }
    while scan.stack.count > 0 {
        step := VecPop(scan.stack)
        if host != null && step.has_value && step.value.handle.slot != 0 {
            AppTreeDrop(*host.tree, step.value.handle)
        }
    }
    VecFree(scan.stack)
    scan.account[0] = 0
    if host != null { AppHostCollect(host) }
}

// A root opens immediately. Discover its installed leaves on later frames,
// rather than hashing and opening an entire collection in the input thread.
NodeInstalledScanStart :: (slot: s32) -> bool {
    host := node_runners[slot].nested
    if host == null {
        if !NodeInstalledCapture(slot, null) { return false }
        NodeInstalledSave(slot)
        return true
    }
    scan := *node_snapshot_scans[slot]
    if !CopyCString(NodeTreeAccount(), scan.account[:]) ||
    !VecPush(scan.stack, NodeSnapshotStep.{AppHandle.{0, 1}, 0}) { return false }
    return true
}

// At most one child opens per frame, across all roots. Every step returns to
// the event loop, and gestures/practices can defer the next step entirely.
NodeInstalledScanPump :: () -> bool {
    for slot: cast(s32)0..NodeAppSlots - 1 {
        scan := *node_snapshot_scans[slot]
        if scan.stack.count == 0 { continue }
        host := node_runners[slot].nested
        if host == null || TextUntilNul(scan.account[:]) != NodeTreeAccount() {
            NodeInstalledScanCancel(slot)
            return true
        }
        if host.tree.busy || host.tree.draining { return false }
        if !NodeInstalledScanStep(slot) {
            NodeInstalledScanCancel(slot)
            unused NodeAppClose(slot)
            NodeAppLocalFailed(slot)
        }
        return true
    }
    return false
}

NodeInstalledScanStep :: (slot: s32) -> bool {
    host := node_runners[slot].nested
    scan := *node_snapshot_scans[slot]
    previous := node_snapshot_scanning
    node_snapshot_scanning = true
    defer { node_snapshot_scanning = previous }
    step := *scan.stack[scan.stack.count - 1]
    node := AppTreeNode(*host.tree, step.handle)
    if node == null { return false }
    if !node.collection || step.next >= node.catalog.count {
        if !node.collection {
            state: AppState
            if !NodeTreeState(cast(*void)(*node_runners[slot]), NodeTreeAccount(), *node.identity, *state) ||
            (state.installed && !NodeInstalledCapture(slot, node)) { return false }
        }
        handle := step.handle
        unused VecPop(scan.stack)
        if handle.slot != 0 { AppTreeDrop(*host.tree, handle) }
        AppHostCollect(host)
        if scan.stack.count == 0 {
            VecFree(scan.stack)
            scan.account[0] = 0
            NodeInstalledSave(slot)
        }
        return true
    }
    entry := AppCatalogAt(*node.catalog, step.next)
    // A catalog may declare games downloaded only when requested. Missing
    // bytes are not a broken collection, and discovery must not fetch them.
    // Let an already requested transfer finish before inspecting its leaves.
    download := AppDownload.{.progress = -1}
    if host.platform.download != null && host.platform.download(host.platform.context,
        node, entry, *download) {
        if !download.downloading {
            step.next += 1
        }
        return true
    }
    handle: AppHandle
    opened := AppHostOpenChild(host, step.handle, TextUntilNul(entry.id[:]), *handle)
    if opened == 0 {
        return true
    }
    if opened < 0 {
        return false
    }
    step.next += 1
    if !VecPush(scan.stack, NodeSnapshotStep.{handle, 0}) {
        AppTreeDrop(*host.tree, handle)
        return false
    }
    return true
}

// A root's verified leaves are also saved beside its package, for its
// release and account, so a launch knows an installed collection's games
// and their achievements without opening it: opening Arcade's five bundles
// before anything else froze a phone for seconds.
NODE_SNAPSHOT_FORMAT :: "inbe-leaves-1"

NodeSnapshotCursor :: struct {
    at: s64
    ok: bool
}

NodeSnapshotField :: (out: *Vec(u8), text: string) {
    BuilderPrint(out, "%:%", text.count, text)
}

NodeSnapshotNext :: (text: string, cursor: *NodeSnapshotCursor) -> string {
    length: s64 = 0
    digits: s32 = 0
    while cursor.at < text.count && digits < 9 &&
    text[cursor.at] >= cast(u8)48 && text[cursor.at] <= cast(u8)57 {
        length = length * 10 + cast(s64)text[cursor.at] - 48
        cursor.at += 1
        digits += 1
    }
    if !cursor.ok || digits == 0 || cursor.at >= text.count ||
    text[cursor.at] != cast(u8)58 || length > text.count - cursor.at - 1 {
        cursor.ok = false
        return ""
    }
    start := cursor.at + 1
    cursor.at = start + length
    return text[start:start + length]
}

NodeInstalledSave :: (slot: s32) {
    if slot < 0 || slot >= NodeAppSlots || node_snapshot_scans[slot].stack.count > 0 { return }
    root := NodeAppName(slot)
    if root.count == 0 || NodeAppLocal(root) || !NodeAppRunning(slot) || node_tree_validating { return }
    hash := TextFromCString(*package_cached_releases[NodeAppIndex(slot)].hash[0])
    if hash.count != 64 { return }
    // Leaves are kept for the account they were found under; a root with
    // none installed is saved for the current account.
    account := NodeTreeAccount()
    captured := account == TextUntilNul(node_installed_account[:])
    out: Vec(u8)
    NodeSnapshotField(*out, NODE_SNAPSHOT_FORMAT)
    NodeSnapshotField(*out, hash)
    NodeSnapshotField(*out, account)
    for at: cast(s64)0..node_installed_leaves.count - 1 {
        entry := *node_installed_leaves[at]
        if !captured || TextUntilNul(entry.root[:]) != root { continue }
        NodeSnapshotField(*out, TextUntilNul(entry.identity.authority[:]))
        NodeSnapshotField(*out, TextUntilNul(entry.identity.id[:]))
        NodeSnapshotField(*out, TextUntilNul(entry.owner[:]))
        NodeSnapshotField(*out, ifx entry.nested then "1" else "0")
        for text: entry.assets { NodeSnapshotField(*out, text) }
    }
    text := BuilderFinish(out)
    path := PackagePath(NodeAppIndex(slot), ".leaves")
    if PackageWrite(path, text) && captured { unused CopyCString(hash, node_installed_releases[slot][:]) }
    PackageFree(path)
    PackageFree(text)
}

// Takes the saved leaves of a root that is not open, when they belong to
// its installed release and this account. False when there are none and
// the root must open to find them.
NodeInstalledLoad :: (slot: s32) -> bool {
    root := NodeAppName(slot)
    if root.count == 0 || NodeAppLocal(root) || DataTemporary() { return false }
    path := PackagePath(NodeAppIndex(slot), ".leaves")
    text := PackageRead(path, 16777216)
    defer { PackageFree(path); PackageFree(text) }
    cursor := NodeSnapshotCursor.{.ok = true}
    if NodeSnapshotNext(text, *cursor) != NODE_SNAPSHOT_FORMAT { return false }
    hash := NodeSnapshotNext(text, *cursor)
    account := NodeSnapshotNext(text, *cursor)
    if !cursor.ok || account != NodeTreeAccount() || !PackageInstalledMatches(NodeAppIndex(slot), hash) {
        return false
    }
    // Check the whole file before taking any of it.
    probe := cursor
    count: s32 = 0
    while probe.ok && probe.at < text.count {
        check: NodeInstalledLeaf
        authority := NodeSnapshotNext(text, *probe)
        id := NodeSnapshotNext(text, *probe)
        owner := NodeSnapshotNext(text, *probe)
        unused NodeSnapshotNext(text, *probe)
        probe.ok = probe.ok && CopyCString(authority, check.identity.authority[:]) &&
        CopyCString(id, check.identity.id[:]) && CopyCString(owner, check.owner[:]) &&
        CopyCString(root, check.root[:])
        for index: cast(s32)0..12 {
            asset := NodeSnapshotNext(text, *probe)
            if probe.ok && asset.count > 0 &&
            (asset.count > 262144 || (index == 0 && !AchievementCatalog(asset, id, false))) {
                probe.ok = false
            }
        }
        count += 1
    }
    if !probe.ok || count > 64 {
        return false
    }
    if account != TextUntilNul(node_installed_account[:]) {
        NodeInstalledClear()
        unused CopyCString(account, node_installed_account[:])
    }
    unused CopyCString(hash, node_installed_releases[slot][:])
    while cursor.at < text.count {
        entry: NodeInstalledLeaf
        unused CopyCString(NodeSnapshotNext(text, *cursor), entry.identity.authority[:])
        unused CopyCString(NodeSnapshotNext(text, *cursor), entry.identity.id[:])
        unused CopyCString(NodeSnapshotNext(text, *cursor), entry.owner[:])
        entry.nested = NodeSnapshotNext(text, *cursor) == "1"
        unused CopyCString(root, entry.root[:])
        for index: cast(s32)0..12 {
            asset := NodeSnapshotNext(text, *cursor)
            if asset.count == 0 { continue }
            bytes: Vec(u8)
            BuilderPrint(*bytes, "%", asset)
            entry.assets[index] = BuilderFinish(bytes)
        }
        replaced := false
        for at: cast(s64)0..node_installed_leaves.count - 1 {
            saved := *node_installed_leaves[at]
            if AppIdentityEqual(*saved.identity, *entry.identity) &&
            TextUntilNul(saved.root[:]) == TextUntilNul(entry.root[:]) {
                for owned: saved.assets { PackageFree(owned) }
                saved.* = entry
                replaced = true
                break
            }
        }
        if !replaced && (node_installed_leaves.count >= 64 || !VecPush(node_installed_leaves, entry)) {
            for owned: entry.assets { PackageFree(owned) }
        }
    }
    node_installed_revision += 1
    return true
}

NodeInstalledVisible :: (entry: *NodeInstalledLeaf) -> bool {
    if NodeTreeAccount() != TextUntilNul(node_installed_account[:]) ||
    !NodeAppMarked(TextUntilNul(entry.root[:])) { return false }
    if !entry.nested { return true }
    state: AppState
    return NodeTreeState(null, NodeTreeAccount(), *entry.identity, *state) && state.installed
}

// A retained game score does not prove its app is still installed.
NodeAppInstalledIdentity :: (root: string, id: string) -> bool {
    for entry: node_installed_leaves {
        if TextUntilNul(entry.root[:]) == root && TextUntilNul(entry.identity.id[:]) == id &&
        NodeInstalledVisible(*entry) {
            return true
        }
    }
    return false
}

// Keep independent verified copies for each installed root, and project one
// visible definition per identity. Removing one root never hides another.
NodeInstalledRepresentative :: (at: s64) -> bool {
    entry := *node_installed_leaves[at]
    if !NodeInstalledVisible(entry) { return false }
    for previous: cast(s64)0..at - 1 {
        other := *node_installed_leaves[previous]
        if AppIdentityEqual(*entry.identity, *other.identity) && NodeInstalledVisible(other) {
            return false
        }
    }
    return true
}

NodeAppInstalledLeafCount :: () -> s32 {
    count: s32 = 0
    for at: cast(s64)0..node_installed_leaves.count - 1 {
        if NodeInstalledRepresentative(at) { count += 1 }
    }
    return count
}

NodeAppInstalledLeafName :: (index: s32) -> string {
    for at: cast(s64)0..node_installed_leaves.count - 1 {
        entry := *node_installed_leaves[at]
        if !NodeInstalledRepresentative(at) { continue }
        if index == 0 { return TextUntilNul(entry.owner[:]) }
        index -= 1
    }
    return ""
}

NodeAppInstalledLeafAsset :: (index: s32, owner: string, path: string) -> AssetView {
    for at: cast(s64)0..node_installed_leaves.count - 1 {
        entry := *node_installed_leaves[at]
        if !NodeInstalledRepresentative(at) { continue }
        if index > 0 { index -= 1; continue }
        if TextUntilNul(entry.owner[:]) != owner { return AssetView.{} }
        for asset: cast(s32)0..12 {
            candidate := NodeInstalledPath(owner, asset)
            matches := candidate == path
            PackageFree(candidate)
            if matches && entry.assets[asset] != "" {
                return AssetView.{.found = true, .data = entry.assets[asset], .mime = "application/json"}
            }
        }
        return AssetView.{}
    }
    return AssetView.{}
}

// Scan only visibility booleans (at most64), never catalog/translation bytes.
// This catches account sync install changes as well as native menu actions.
NodeAppInstalledLeafRevision :: () -> u64 {
    account := NodeTreeAccount()
    if account != TextUntilNul(node_installed_observed_account[:]) {
        unused CopyCString(account, node_installed_observed_account[:])
        node_installed_revision += 1
    }
    mask: u64 = 0
    for at: cast(s64)0..node_installed_leaves.count - 1 {
        if NodeInstalledVisible(*node_installed_leaves[at]) { mask |= cast(u64)1 << cast(u64)at }
    }
    if mask != node_installed_visibility {
        node_installed_visibility = mask
        node_installed_revision += 1
    }
    return node_installed_revision
}
