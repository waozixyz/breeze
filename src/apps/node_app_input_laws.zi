#import, file "node_app_input.zi";

// Laws for the keyboard and display of hosted apps. Each states the expected
// behavior independently of the implementation; `ziran check` proves it over
// every listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A fresh press always reaches the app; while nothing new is pressed, a held
// key keeps repeating, and with neither the app gets no key.
#law FreshPressWins forall pressed: 1..348, repeated: 0..348 => NodeAppKeyFor(pressed, repeated) == pressed;
#law HeldKeyRepeats forall repeated: 0..348 => NodeAppKeyFor(0, repeated) == repeated;

// The display is kept awake exactly while a full-screen game is on screen.
#law AwakeOnlyInGames forall screen: 0..1, launcher: 0..1, immersive: 0..1 => NodeAppDisplayAwakeFor(B(screen), B(launcher), B(immersive)) == (B(screen) && !B(launcher) && B(immersive));
#law GamesKeepAwake custom NodeAppDisplayAwakeFor(true, false, true);
#law LauncherLetsSleep forall immersive: 0..1 => !NodeAppDisplayAwakeFor(true, true, B(immersive));
