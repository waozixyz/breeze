#import "session"

// Device observations and retained scroll, never native pointers.
LeaderboardUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    scroll: s32
    app_count: s32
    app_index: s32
}

LeaderboardUiApp :: struct {
    name: string
    title: string
}

// Rows arrive ranked for the chosen metric, with display text prepared once.
LeaderboardUiRow :: struct {
    rank: s32
    name: string
    streak: string
    average: string
    own: bool
}
