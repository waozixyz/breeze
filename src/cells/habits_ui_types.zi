#import "session"
#import "drawing_props"

// What a counting habit's day shows in its count dialog, from the host, and
// what the dialog asks the host to do once the frame is drawn.
HabitsUiFrame :: struct {
    session: Session
    scale: float32
    // The app's small text size, already scaled.
    small_font: s32
    // The theme's text colour, for the minus and plus bars.
    text_color: Color
    name: string
    // The day as YYYYMMDD, and whether it is today.
    day: s32
    today: bool
    count: s32
    target: s32
    // Practice sessions linked to the day; the count never goes below them.
    linked_count: s32
    // Whether the habit asks questions, kept as the day's entries.
    asks: bool
    action: s32
}
