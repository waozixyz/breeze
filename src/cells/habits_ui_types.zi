#import "session"
#import "drawing_props"
#import "geometry"
#import "text_input_props"

// What a counting habit's day shows in its count dialog, from the host, and
// what the dialog asks the host to do once the frame is drawn.
HabitsUiFrame :: struct {
    session: Session
    scale: float32
    // The app's small text size, already scaled.
    small_font: s32
    // The theme's text colour, for the minus and plus bars.
    text_color: Color
    name: string
    // The day as YYYYMMDD, and whether it is today.
    day: s32
    today: bool
    count: s32
    target: s32
    // Practice sessions linked to the day; the count never goes below them.
    linked_count: s32
    // Whether the habit asks questions, kept as the day's entries.
    asks: bool
    action: s32
}

// A reward in the habit shop as Habits draws and changes it: its id, empty
// for a new one, its name, its price in coins and its symbol, one of the
// habit icons.
HabitsShopReward :: struct {
    id: string
    name: string
    price: s32
    icon: s32
}

// A line of the shop's Activity: a done day's coins or a reward bought.
HabitsShopActivity :: struct {
    name: string
    icon: s32
    // Half coins: earned above 0, spent below.
    halves: s64
    // Today, or a short weekday and the day of the month.
    day: string
}

// The habit shop's page, which Habits draws: the coins and rewards the host
// keeps, the form's state and the person's typing, and what the page asks
// the host to do once it is drawn. The form's state comes back changed.
HabitsShopFrame :: struct {
    session: Session
    scale: float32
    // The page's bounds, and the window's width for its dialog.
    bounds: Rectangle
    view_width: s32
    // The app's text sizes, already scaled.
    font: s32
    small_font: s32
    // The theme's text colour, its muted text class and its cards.
    text_color: Color
    muted_class: s32
    card_fill: Color
    card_border: Color
    card_radius: s32
    // Another dialog is open, so the page takes no input.
    modal_active: bool
    // What was typed for the focused field.
    input: TextFieldInput
    // The coins to spend, in half coins.
    halves: s64
    // The whole coins the shop lends once the balance is spent, or 0 when
    // buying stays within the balance.
    borrow_limit: s32
    reward_count: s32
    activity_count: s32
    scroll: s32
    // The reward the form changes, or empty while it adds one.
    editing: string
    name: string
    name_cursor: s32
    name_anchor: s32
    name_scroll_x: s32
    name_focused: bool
    price: s32
    // The price as typed; it follows price while unfocused.
    price_text: string
    price_cursor: s32
    price_anchor: s32
    price_scroll_x: s32
    price_focused: bool
    // The borrow limit as typed; it follows borrow_limit while unfocused.
    borrow_text: string
    borrow_cursor: s32
    borrow_anchor: s32
    borrow_scroll_x: s32
    borrow_focused: bool
    // The form's symbol, and whether the grid of symbols is open.
    icon: s32
    icon_open: bool
    clipboard_write: bool
    clipboard_text: string
    action: s32
    // The reward Buy asks about.
    buying: HabitsShopReward
}
