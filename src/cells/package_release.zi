// Daochi release v2. All delivery variants and dependencies are signed.
#import "json_scan"
#import "byte_text_linux"
#import "text"
#import "vec"
#import "bundle_host"
#import, file "asset_paths.zi";
#import, file "module_types.zi";
#import, file "catalog.zi";
#import, file "inbe_types.zi";
#import, file "package_files.zi";
#import, file "../app/text_buffers.zi";
#import, file "../storage/sync_crypto.zi";

c :: #system_library "c";
PackageCheckSignature :: (signature: *u8, public_key: *u8,
    message: *u8, length: usize) -> s32 #foreign c "crypto_ed25519_check";

PackageRelease :: struct {
    sequence: s32
    version: [32]u8
    hash: [65]u8
    key_id: [64]u8
    size: s64
    valid: bool
    dependency_hashes: [6][65]u8
    dependency_sizes: [6]s64
    dependency_versions: [6][32]u8
}

PackageField :: (json: string, at: s32, key: string, output: []u8) -> string {
    count := ReadStringText(json, FieldAt(json, at, key), output)
    if count <= 0 || count >= output.count {
        return ""
    }
    output[count] = cast(u8)0
    return TextFromBytes(output[0:count])
}

PackageNumber :: (json: string, at: s32, key: string) -> s64 {
    number := ReadNumber(json, FieldAt(json, at, key))
    if !number.valid || number.value < 0.0 || number.value > 2147483647.0 {
        return -1
    }
    integer := cast(s64)number.value
    if cast(float64)integer != number.value {
        return -1
    }
    return integer
}

PackageVersionValid :: (version: string) -> bool {
    parts: s32 = 0
    digits: s32 = 0
    first: u8 = 0
    for byte: version {
        if byte == cast(u8)46 {
            if digits == 0 {
                return false
            }
            parts += 1
            digits = 0
        } else {
            if byte < cast(u8)48 || byte > cast(u8)57 || digits >= 9 ||
            (digits > 0 && first == cast(u8)48) {
                return false
            }
            if digits == 0 {
                first = byte
            }
            digits += 1
        }
    }
    return parts == 2 && digits > 0
}

PackageIdentifierValid :: (value: string) -> bool {
    if value.count == 0 || value.count > 63 || value == "." || value == ".." {
        return false
    }
    for index: 0..value.count - 1 {
        byte := value[index]
        alphanumeric := (byte >= cast(u8)97 && byte <= cast(u8)122) ||
        (byte >= cast(u8)48 && byte <= cast(u8)57)
        if !alphanumeric && (index == 0 ||
            (byte != cast(u8)46 && byte != cast(u8)95 && byte != cast(u8)45)) {
            return false
        }
    }
    return true
}

PackageHashValid :: (hash: string) -> bool {
    if hash.count != 64 {
        return false
    }
    for byte: hash {
        if !((byte >= cast(u8)48 && byte <= cast(u8)57) ||
            (byte >= cast(u8)97 && byte <= cast(u8)102)) {
            return false
        }
    }
    return true
}

PackageParseRelease :: (json: string, index: s32, public_hex: string) -> PackageRelease {
    release: PackageRelease
    if json.count > 65536 || json.count < 2 || json[0] != cast(u8)123 ||
    Space(json, ValueEnd(json, 0, 0)) != json.count {
        return release
    }
    app: [64]u8
    runtime: [32]u8
    signature: [129]u8
    app_id := PackageField(json, 0, "app_id", app[:])
    runtime_id := PackageField(json, 0, "runtime", runtime[:])
    version := PackageField(json, 0, "version", release.version[:])
    key_id := PackageField(json, 0, "key_id", release.key_id[:])
    signed := PackageField(json, 0, "signature", signature[:])
    sequence := PackageNumber(json, 0, "sequence")
    host := PackageNumber(json, 0, "host_api")
    module := PackageNumber(json, 0, "module_api")
    schema := PackageNumber(json, 0, "data_schema")
    if app_id != PackageID(index) || runtime_id != "kryon-app-v1" ||
    !PackageVersionValid(version) || !PackageIdentifierValid(key_id) ||
    sequence <= 0 || host != PackageHostAPI || module != PackageModuleAPI ||
    schema != 0 || public_hex.count != 64 || signed.count != 128 {
        return release
    }
    artifacts := FieldAt(json, 0, "artifacts")
    count := ArrayCount(json, artifacts)
    dependencies := FieldAt(json, 0, "dependencies")
    dependency_count := ArrayCount(json, dependencies)
    if count < 1 || count > 2 || (index == 0 && dependency_count != 3 && dependency_count != 5) ||
    (index != 0 && dependency_count != 0) {
        return release
    }
    message: Vec(u8)
    BuilderPrint(*message, "daochi-zib-release-v2\n%\n%\n%\n%\n%\n%\n%\n%\n%\n",
        app_id, sequence, version, runtime_id, host, module, schema, key_id, count)
    artifact: s32 = 0
    while artifact < count {
        at := ElementAt(json, artifacts, artifact)
        variant_bytes: [32]u8
        hash_bytes: [65]u8
        variant := PackageField(json, at, "variant", variant_bytes[:])
        hash := PackageField(json, at, "sha256", hash_bytes[:])
        size := PackageNumber(json, at, "size")
        expected := ifx artifact == 0 then "module" else "standalone"
        if variant != expected || !PackageHashValid(hash) || size < 8 ||
        size > PackageMaximumBytes {
            VecFree(message);
            return release
        }
        if artifact == 0 {
            unused AppCopyText(hash, release.hash[:])
            release.size = size
        }
        BuilderPrint(*message, "%\n%\n%\n", variant, hash, size)
        artifact += 1
    }
    BuilderPrint(*message, "%\n", dependency_count)
    previous: [64]u8
    dependency: s32 = 0
    while dependency < dependency_count {
        at := ElementAt(json, dependencies, dependency)
        id_bytes: [64]u8
        version_bytes: [32]u8
        hash_bytes: [65]u8
        id := PackageField(json, at, "app_id", id_bytes[:])
        dependency_version := PackageField(json, at, "version", version_bytes[:])
        hash := PackageField(json, at, "sha256", hash_bytes[:])
        size := PackageNumber(json, at, "size")
        if !PackageIdentifierValid(id) || id == app_id ||
        !PackageVersionValid(dependency_version) || !PackageHashValid(hash) ||
        size < 8 || size > PackageMaximumBytes ||
        (dependency > 0 && PackageCompare(TextFromCString(*previous[0]), id) >= 0) {
            VecFree(message)
            return release
        }
        dependency_index: s32 = -1
        for candidate: cast(s32)1..cast(s32)(PackageCount - 1) {
            if dependency_count == 3 && (PackageBit(candidate) & APP_RECOMMENDED) == 0 { continue }
            if id == PackageID(candidate) {
                dependency_index = candidate
            }
        }
        if dependency_index < 0 || release.dependency_sizes[dependency_index] != 0 {
            VecFree(message)
            return release
        }
        unused AppCopyText(hash, release.dependency_hashes[dependency_index][:])
        release.dependency_sizes[dependency_index] = size
        unused AppCopyText(dependency_version, release.dependency_versions[dependency_index][:])
        unused AppCopyText(id, previous[:])
        BuilderPrint(*message, "%\n%\n%\n%\n", id, dependency_version, hash, size)
        dependency += 1
    }
    text := BuilderFinish(message)
    defer {
        PackageFree(text)
    }
    public_key: [32]u8
    signature_bytes: [64]u8
    text_bytes := cast(*TextDescriptor)(*text)
    if SyncCryptoHexToBytes(public_hex, *public_key[0], 32) == 0 ||
    SyncCryptoHexToBytes(signed, *signature_bytes[0], 64) == 0 ||
    PackageCheckSignature(*signature_bytes[0], *public_key[0],
        text_bytes.data, cast(usize)text.count) != 0 {
        return release
    }
    release.sequence = cast(s32)sequence
    release.valid = true
    return release
}

PackageCompare :: (left: string, right: string) -> s32 {
    at: s64 = 0
    while at < left.count && at < right.count {
        if left[at] < right[at] {
            return -1
        }
        if left[at] > right[at] {
            return 1
        }
        at += 1
    }
    return ifx left.count < right.count then -1 else ifx left.count > right.count then 1 else 0
}

PackageVerifyBytes :: (bytes: string, release: PackageRelease) -> bool {
    if !release.valid || bytes.count != release.size || bytes.count < 8 ||
    bytes[0] != cast(u8)90 || bytes[1] != cast(u8)73 ||
    bytes[2] != cast(u8)66 || bytes[3] != cast(u8)0 {
        return false
    }
    actual: [65]u8
    payload := cast(*TextDescriptor)(*bytes)
    SyncCryptoSha256Hex(payload.data,
        bytes.count, *actual[0])
    if TextFromCString(*actual[0]) != TextFromBytes(release.hash[0:64]) {
        return false
    }
    if release.dependency_sizes[1] == 0 && release.dependency_sizes[2] == 0 &&
    release.dependency_sizes[3] == 0 && release.dependency_sizes[4] == 0 &&
    release.dependency_sizes[5] == 0 {
        return true
    }
    root := OpenBundleBytes(payload.data, cast(u64)bytes.count)
    if root == null {
        return false
    }
    defer {
        CloseBundle(root)
    }
    if BundleAssets(root) < cast(u64)2 || BundleAssets(root) > cast(u64)2048 {
        return false
    }
    matched: [6]bool
    asset: u64 = 0
    while asset < BundleAssets(root) {
        name := CellBundlePath(TextFromCString(BundleAssetPath(root, asset)))
        index: s32 = -1
        if name == "cells/lists.zib" {
            index = 1
        }
        if name == "cells/habits.zib" {
            index = 2
        }
        if name == "cells/practices.zib" {
            index = 3
        }
        if name == "cells/lumi.zib" {
            index = 5
        }
        if name == "cells/diary.zib" {
            index = 4
        }
        if index < 0 {
            if !PackageResourceValid(name, MODULE_INBE) { return false }
            asset += 1
            continue
        }
        if matched[index] || cast(s64)BundleAssetLength(root, asset) != release.dependency_sizes[index] {
            return false
        }
        SyncCryptoSha256Hex(BundleAssetBytes(root, asset),
            cast(s64)BundleAssetLength(root, asset), *actual[0])
        if TextFromCString(*actual[0]) != TextFromBytes(release.dependency_hashes[index][0:64]) {
            return false
        }
        matched[index] = true
        asset += 1
    }
    for index: cast(s32)1..cast(s32)(PackageCount - 1) {
        if release.dependency_sizes[index] > 0 && !matched[index] {
            return false
        }
    }
    return true
}
