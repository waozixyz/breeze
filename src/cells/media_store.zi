#import, file "../../apps/photos/photos_achievements.zi";
// The account's media library: each photo kept once per account by the
// SHA-256 of its bytes, with a small upright preview for galleries. Photos
// is its interface; the library belongs to the account, so its photos stay
// when an app that added them is removed.
//
// Each photo is a record of the account's entity data, entity.photos.<sha256>
// (entity_photos.zi), which every app of the account shares: Diary embeds
// the same photo, and other apps such as Photos read and write the same
// record. Its bytes travel as the entity data's sealed chunks
// (diary_blobs.zi), so the same picture is stored once on each node. Files
// live per account under media/<account>/<sha256> and <sha256>.preview,
// beside the Diary's folder. Previews download on every device; an original
// only where it is wanted, such as when Photos opens it.
//
// Released versions kept the library in private.inbe.v1.media
// (storage/media_records.zi), which they still read through 2027-10-24:
//
//   cell.media.<sha256>          {"hash","size","type","name","day","taken",
//                                 "added","trashed"[,"blob","key"][,"photo"]}
//   cell.media.preview.<sha256>  {"hash","size","type"[,"blob","key"][,"photo"]}
//
// A photo there without an entity record is listed from it until it moves
// (media_diary_photos.zi): its entity record takes its fields, and its old
// copy goes once the node has the new one.
#import "file_linux"
#import "byte_text_linux"
#import "vec"
#import "text"
#import "json_scan"
#import "image_preview"
#import "text_buffer"
#import, file "diary_records.zi";
#import, file "diary_store.zi";
#import, file "media_metadata.zi";
#import, file "entity_photos.zi";
#import, file "../storage/entity_records.zi";
#import, file "package_files.zi";
#import, file "../storage/media_records.zi";
#import, file "../storage/cell_records.zi";
#import, file "../storage/storage_core.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../storage/sync_apply.zi";
#import, file "../storage/sqlite.zi";
#import, file "../storage/db.zi";
#import, file "../storage/state.zi";
#import, file "../storage/paths.zi";
#import, file "../storage/temporary_data.zi";
#import, file "../platform/web_storage.zi";
#import, file "../app/assets.zi";
#import, file "../app/text_buffers.zi";

// Galleries draw previews at most this many pixels on their longest side,
// upright, as JPEG of this quality.
MEDIA_PREVIEW_EDGE :: 512
MEDIA_PREVIEW_QUALITY :: 80
// New photos use a smaller upright copy when it saves space. Small files,
// transparency and animation keep their existing bytes.
MEDIA_UPLOAD_EDGE :: 2048
MEDIA_UPLOAD_QUALITY :: 88
MEDIA_COMPRESS_BYTES :: 262144
MEDIA_NAME_MAX :: 200
// Originals asked for on this device, downloaded by the next media pass.
MEDIA_WANTED_MAX :: 32
MEDIA_WANTED_KEY :: "media_wanted"
// Asset paths answered without reading files again, until a copy arrives.
MEDIA_ASSET_CACHE :: 96
// The most items one query lists.
MEDIA_QUERY_LIMIT :: 20000

MediaItem :: struct {
    valid: bool
    hash: [65]u8
    size: s64
    format: [8]u8
    name: [MEDIA_NAME_MAX + 1]u8
    day: [11]u8
    taken: [26]u8
    added: s64
    trashed: bool
    // An entity record; otherwise a released version's library record.
    entity: bool
}

MediaImport :: struct {
    succeeded: bool
    // The library already had this photo; nothing new was stored.
    existed: bool
    hash: [65]u8
}

MediaAssetEntry :: struct {
    hash: [65]u8
    original: bool
    generation: s64
    path: [96]u8
}

// One item of a query: enough to lay out a gallery.
MediaRow :: struct {
    hash: [65]u8
    day: [11]u8
}

media_assets: [MEDIA_ASSET_CACHE]MediaAssetEntry;
media_assets_next: s32;
media_asset_bytes: string;
media_owner: [72]u8;
// Bumped by every change this device makes to the library.
media_revision: s32;
media_rows: [MEDIA_QUERY_LIMIT]MediaRow;
media_row_count: s32;
media_query_day: [11]u8;
media_query_trashed: bool;
media_query_revision: s32 = -1;
media_query_changes: s32 = -1;
media_query_owner: [72]u8;
// Changes whenever a query's answer differs from the one before.
media_query_checksum: u64;
media_library_revision: s32;

MediaRecordKey :: (hash: string) -> string {
    return PackageText(MEDIA_RECORD_PREFIX, hash)
}

MediaPreviewKey :: (hash: string) -> string {
    return PackageText(MEDIA_PREVIEW_PREFIX, hash)
}

// A record of the library: an entity record, or a released version's, or
// empty.
MediaRecordRead :: (key: string) -> string {
    if (!MediaRecordKeyAccepted(key) && !EntityPhotoKeyAccepted(key)) || storage_db_handle() == null {
        return ""
    }
    statement: *void
    if SqlitePrepareText(storage_db_handle(),
        "SELECT value FROM settings WHERE user_id=?1 AND key=?2", -1,
        *statement, null) != SQLITE_OK {
        return ""
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    unused bind_text(statement, 2, key)
    if SqliteStep(statement) != SQLITE_ROW {
        return ""
    }
    return PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 65536), "")
}

// Saves a record of the library; it syncs in its record's collection.
MediaRecordWrite :: (key: string, value: string) -> bool {
    if (!MediaRecordKeyAccepted(key) && !EntityPhotoKeyAccepted(key)) || value.count == 0 ||
    value.count >= 65536 {
        return false
    }
    storage_set_setting_text(key, value)
    written := storage_setting_text_equals(key, value) != 0
    if written {
        media_revision += 1
    }
    return written
}

// The library's folder for the signed-in account, beside the Diary's.
MediaDirectory :: () -> string {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if owner.count == 0 {
        return ""
    }
    for byte: owner {
        digit := byte >= cast(u8)48 && byte <= cast(u8)57
        letter := byte >= cast(u8)97 && byte <= cast(u8)122
        if !digit && !letter && byte != cast(u8)45 {
            return ""
        }
    }
    database := storage_db_path()
    at := database.count - 1
    while at >= 0 && database[at] != cast(u8)47 && database[at] != cast(u8)92 {
        at -= 1
    }
    if at < 0 {
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "%media/%", database[:at + 1], owner)
    return BuilderFinish(out)
}

MediaPath :: (hash: string, preview: bool) -> string {
    if !MediaHashValid(hash) {
        return ""
    }
    directory := MediaDirectory()
    defer { PackageFree(directory) }
    if directory.count == 0 {
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "%/%", directory, hash)
    if preview {
        BuilderPrint(*out, ".preview")
    }
    return BuilderFinish(out)
}

// A JSON string; control characters become spaces.
MediaJson :: (out: *Vec(u8), value: string) {
    BuilderPrint(out, "\"")
    for byte: value {
        if byte == cast(u8)34 {
            BuilderPrint(out, "\\\"")
        } else if byte == cast(u8)92 {
            BuilderPrint(out, "\\\\")
        } else if byte < cast(u8)32 {
            BuilderPrint(out, " ")
        } else {
            unused VecPush(out.*, byte)
        }
    }
    BuilderPrint(out, "\"")
}

// A day as YYYY-MM-DD from seconds since 1970 in UTC.
MediaDayOfSeconds :: (seconds: s64, output: []u8) -> bool {
    days := seconds / 86400
    if seconds < 0 && seconds % 86400 != 0 {
        days -= 1
    }
    // Days to a civil date (proleptic Gregorian).
    shifted := days + 719468
    era := ifx shifted >= 0 then shifted / 146097 else (shifted - 146096) / 146097
    day_of_era := shifted - era * 146097
    year_of_era := (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
    day_of_year := day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    month_index := (5 * day_of_year + 2) / 153
    day := day_of_year - (153 * month_index + 2) / 5 + 1
    month := ifx month_index < 10 then month_index + 3 else month_index - 9
    year := year_of_era + era * 400 + ifx month <= 2 then cast(s64)1 else cast(s64)0
    if year < 1000 || year > 9999 {
        return false
    }
    out: Vec(u8)
    BuilderPrint(*out, "%-", year)
    BuilderPrint(*out, "%-", MediaTwo(cast(s32)month))
    BuilderPrint(*out, "%", MediaTwo(cast(s32)day))
    value := BuilderFinish(out)
    defer { PackageFree(value) }
    return AppCopyText(value, output)
}

// A photo's entity record as the library lists it. A record another app
// wrote may lack the capture day; its capture time's UTC day stands in.
MediaParseEntity :: (record: string) -> MediaItem {
    item: MediaItem
    content := EntityPhotoContent(record)
    format := TextUntilNul(content.format[:])
    if !content.valid || format.count == 0 {
        return item
    }
    item.hash = content.hash
    item.size = content.size
    unused AppCopyText(format, item.format[:])
    if ReadStringText(record, FieldAt(record, 0, "day"), item.day[:]) != 10 ||
    !MediaDayValid(TextFromBytes(item.day[:10])) {
        taken_at := ReadNumber(record, FieldAt(record, 0, "taken_at"))
        if !taken_at.valid || !MediaDayOfSeconds(cast(s64)taken_at.value, item.day[:]) {
            return MediaItem.{}
        }
    }
    unused ReadStringText(record, FieldAt(record, 0, "name"), item.name[:])
    unused ReadStringText(record, FieldAt(record, 0, "taken"), item.taken[:])
    added := ReadNumber(record, FieldAt(record, 0, "added_at"))
    if added.valid {
        item.added = cast(s64)added.value
    }
    trashed := FieldAt(record, 0, "trashed")
    item.trashed = MatchLiteral(record, trashed, "true")
    item.entity = true
    item.valid = true
    return item
}

// A library record of either kind.
MediaParse :: (record: string) -> MediaItem {
    if FieldAt(record, 0, "added_at") >= 0 || FieldAt(record, 0, "blobs") >= 0 ||
    FieldAt(record, 0, "taken_at") >= 0 {
        return MediaParseEntity(record)
    }
    return MediaParseLegacy(record)
}

// A released version's library record.
MediaParseLegacy :: (record: string) -> MediaItem {
    item: MediaItem
    media := DiaryMediaParse(record)
    if !media.valid {
        return item
    }
    item.hash = media.hash
    item.size = media.size
    if ReadStringText(record, FieldAt(record, 0, "type"), item.format[:]) <= 0 ||
    ReadStringText(record, FieldAt(record, 0, "day"), item.day[:]) != 10 {
        return MediaItem.{}
    }
    unused ReadStringText(record, FieldAt(record, 0, "name"), item.name[:])
    unused ReadStringText(record, FieldAt(record, 0, "taken"), item.taken[:])
    added := ReadNumber(record, FieldAt(record, 0, "added"))
    if added.valid {
        item.added = cast(s64)added.value
    }
    trashed := ReadNumber(record, FieldAt(record, 0, "trashed"))
    item.trashed = trashed.valid && trashed.value != 0.0
    item.valid = true
    return item
}

// The library's photo: its entity record, or a released version's record
// while the photo has none.
MediaRead :: (hash: string) -> MediaItem {
    if !MediaHashValid(hash) {
        return MediaItem.{}
    }
    entity_key := EntityPhotoKey(hash)
    entity_record := MediaRecordRead(entity_key)
    PackageFree(entity_key)
    if entity_record.count > 0 {
        item := MediaParseEntity(entity_record)
        PackageFree(entity_record)
        if item.valid && TextFromBytes(item.hash[:64]) != hash {
            return MediaItem.{}
        }
        return item
    }
    key := MediaRecordKey(hash)
    record := MediaRecordRead(key)
    defer {
        PackageFree(key)
        PackageFree(record)
    }
    item := MediaParseLegacy(record)
    if item.valid && TextFromBytes(item.hash[:64]) != hash {
        return MediaItem.{}
    }
    return item
}

// The photo's entity record, or empty.
MediaEntityRecord :: (hash: string) -> string {
    if !MediaHashValid(hash) {
        return ""
    }
    key := EntityPhotoKey(hash)
    defer { PackageFree(key) }
    return MediaRecordRead(key)
}

media_two: [3]u8;

MediaTwo :: (value: s32) -> string {
    media_two[0] = cast(u8)(48 + (value / 10) % 10)
    media_two[1] = cast(u8)(48 + value % 10)
    return TextFromBytes(media_two[:2])
}

// A day as YYYY-MM-DD.
MediaDayValid :: (day: string) -> bool {
    if day.count != 10 {
        return false
    }
    for index: cast(s64)0..9 {
        dash := index == 4 || index == 7
        digit := day[index] >= cast(u8)48 && day[index] <= cast(u8)57
        if dash && day[index] != cast(u8)45 {
            return false
        }
        if !dash && !digit {
            return false
        }
    }
    return true
}

// The capture day and time for a new photo: the camera's own when the file
// has them, otherwise `fallback_day` without a time when it names a day,
// otherwise this device's clock.
MediaWhen :: (data: string, format: string, fallback_day: string, day: []u8, taken: []u8) -> bool {
    capture := MediaCaptureOf(data, format)
    out: Vec(u8)
    // A four-digit camera year; anything earlier is a camera's unset clock.
    if capture.valid && capture.year >= 1000 {
        BuilderPrint(*out, "%-", capture.year)
        BuilderPrint(*out, "%-", MediaTwo(capture.month))
        BuilderPrint(*out, "%T", MediaTwo(capture.day))
        BuilderPrint(*out, "%:", MediaTwo(capture.hour))
        BuilderPrint(*out, "%:", MediaTwo(capture.minute))
        BuilderPrint(*out, "%", MediaTwo(capture.second))
        if capture.has_offset {
            minutes := capture.offset
            if minutes < 0 {
                BuilderPrint(*out, "-")
                minutes = -minutes
            } else {
                BuilderPrint(*out, "+")
            }
            BuilderPrint(*out, "%:", MediaTwo(minutes / 60))
            BuilderPrint(*out, "%", MediaTwo(minutes % 60))
        }
    } else if MediaDayValid(fallback_day) {
        BuilderPrint(*out, "%", fallback_day)
    } else {
        clock := DiaryStoreClock()
        if clock.count < 19 {
            VecFree(out)
            return false
        }
        BuilderPrint(*out, "%T", clock[:10])
        BuilderPrint(*out, "%", clock[11:19])
    }
    value := BuilderFinish(out)
    defer { PackageFree(value) }
    if value.count < 10 {
        return false
    }
    return AppCopyText(value[:10], day) && AppCopyText(value, taken)
}

// The file name a photo came with, without its folders.
MediaName :: (path: string) -> string {
    at := path.count - 1
    while at >= 0 && path[at] != cast(u8)47 && path[at] != cast(u8)92 {
        at -= 1
    }
    name := path[at + 1:]
    return MediaNameCut(name)
}

// At most MEDIA_NAME_MAX bytes, never ending inside a character.
MediaNameCut :: (name: string) -> string {
    if name.count <= MEDIA_NAME_MAX {
        return name
    }
    end: s64 = MEDIA_NAME_MAX
    while end > 0 && (name[end] & cast(u8)192) == cast(u8)128 {
        end -= 1
    }
    return name[:end]
}

MediaWriteFile :: (path: string, data: string) -> bool {
    existing := PackageFileSize(path)
    if existing == data.count {
        current := PackageRead(path, DIARY_FILE_LIMIT)
        same := current == data
        PackageFree(current)
        if same {
            return true
        }
    }
    return PackageWrite(path, data)
}

// Puts the photo's bytes in its library file. A file on this device that
// holds the same bytes is linked where the platform allows, so the photo
// takes its room once; a link that turns out to hold other bytes is
// replaced by a copy. Files are only ever replaced whole, never written in
// place, so a link never changes the other file.
MediaPlaceFile :: (path: string, data: string, source: string) -> bool {
    #if !#defined(PLATFORM_WEB) {
        if source.count > 0 && !PathExists(path) && LinkFile(source, path) {
            linked := PackageRead(path, DIARY_FILE_LIMIT)
            same := linked == data
            PackageFree(linked)
            if same {
                return true
            }
        }
    }
    return MediaWriteFile(path, data)
}

// A record with one field set to a JSON value, keeping every other field,
// including ones a newer version added.
MediaRecordWith :: (record: string, field: string, value: string) -> string {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT json_set(?1, '$.' || ?2, json(?3))", -1,
        *statement, null) != SQLITE_OK {
        return ""
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, record)
    unused bind_text(statement, 2, field)
    unused bind_text(statement, 3, value)
    if SqliteStep(statement) != SQLITE_ROW {
        return ""
    }
    return PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 65536), "")
}

// How a photo joins the library.
MediaAddition :: struct {
    // The name the photo came with; folders are dropped.
    name: string
    // The day for a photo without a camera date (YYYY-MM-DD), or "" for the
    // day it is added.
    day: string
    // A file on this device with the same bytes, linked rather than copied
    // where the platform allows, or "".
    source: string
    // Original bytes whose camera date survives an optimized library copy.
    capture_source: string
    // Whether a photo the library has in Trash comes back, as when the
    // person picks it again.
    restore: bool
}

// Adds the photo's bytes to the library once: a photo it already has keeps
// its record, and one in Trash comes back. The bytes always land in this
// device's file, so a photo known from another device needs no download.
MediaImportBytes :: (data: string, name: string) -> MediaImport {
    if !DataTemporary() && data.count > MEDIA_COMPRESS_BYTES && data.count <= DIARY_FILE_LIMIT {
        // A photo already in this account keeps its existing identity and
        // record, including photos added before upload compression.
        original_hash: [65]u8
        descriptor := cast(*TextDescriptor)(*data)
        storage_sha256_hex(descriptor.data, data.count, *original_hash[0])
        if !MediaRead(TextUntilNul(original_hash[:])).valid {
            format := DiaryImageFormat(data)
            file_type := PackageText(".", format)
            copy := ImageCompress(data, file_type, MEDIA_UPLOAD_EDGE,
                MediaOrientationOf(data, format), MEDIA_UPLOAD_QUALITY)
            defer {
                PackageFree(file_type)
                PackageFree(copy)
            }
            // Keep a copy only when the saving is meaningful.
            if copy.count > 0 && copy.count * 10 < data.count * 9 {
                return MediaAddBytes(copy, MediaAddition.{.name = name,
                        .capture_source = data, .restore = true})
            }
        }
    }
    return MediaAddBytes(data, MediaAddition.{.name = name, .restore = true})
}

// A preview this device made for a photo: its file is written, and the
// photo's record names it.
MediaPreviewMade :: struct {
    valid: bool
    hash: [65]u8
    size: s64
    format: [8]u8
}

// The capture time as seconds since 1970, read as UTC when the camera wrote
// no offset; -1 when it is no time.
MediaTakenAt :: (taken: string) -> s64 {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT COALESCE(CAST(strftime('%s',?1) AS INTEGER),-1)", -1,
        *statement, null) != SQLITE_OK {
        return -1
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, taken)
    if SqliteStep(statement) != SQLITE_ROW {
        return -1
    }
    return SqliteColumnInt64(statement, 0)
}

// What a photo's entity record says about it besides its bytes.
MediaEntityFields :: struct {
    name: string
    day: string
    taken: string
    added: s64
    trashed: bool
    capture: bool
    preview: MediaPreviewMade
}

// A new entity record for the photo's bytes.
MediaEntityEntry :: (hash: string, data: string, format: string, fields: MediaEntityFields) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "{\"hash\":\"%\",\"size\":%,\"type\":\"%\"", hash, data.count, EntityTypeOfFormat(format))
    taken_at := MediaTakenAt(fields.taken)
    if taken_at >= 0 {
        BuilderPrint(*out, ",\"taken_at\":%", taken_at)
    }
    size := MediaSizeOf(data, format)
    if size.valid {
        BuilderPrint(*out, ",\"width\":%,\"height\":%", size.width, size.height)
    }
    if fields.preview.valid {
        BuilderPrint(*out, ",\"preview\":{\"hash\":\"%\",\"size\":%,\"type\":\"%\"}",
            TextUntilNul(fields.preview.hash[:]), fields.preview.size,
            EntityTypeOfFormat(TextUntilNul(fields.preview.format[:])))
    }
    BuilderPrint(*out, ",\"added_at\":%,\"name\":", fields.added)
    MediaJson(*out, MediaName(fields.name))
    BuilderPrint(*out, ",\"trashed\":%,\"day\":\"%\",\"taken\":", ifx fields.trashed then "true" else "false",
        fields.day)
    MediaJson(*out, fields.taken)
    BuilderPrint(*out, ",\"capture\":%}", ifx fields.capture then "true" else "false")
    return BuilderFinish(out)
}

// A released version's preview of the photo, when its file is here, as the
// photo's preview: the same bytes, so it is not made again.
MediaLegacyPreview :: (hash: string) -> MediaPreviewMade {
    made: MediaPreviewMade
    key := MediaPreviewKey(hash)
    record := MediaRecordRead(key)
    path := MediaPath(hash, true)
    data := PackageRead(path, DIARY_FILE_LIMIT)
    defer {
        PackageFree(key)
        PackageFree(record)
        PackageFree(path)
        PackageFree(data)
    }
    media := DiaryMediaParse(record)
    format := DiaryImageFormat(data)
    if format.count == 0 || !DiaryMediaMatches(media, data) {
        return made
    }
    made.hash = media.hash
    made.size = media.size
    unused AppCopyText(format, made.format[:])
    made.valid = true
    return made
}

// Adds the photo's bytes to the library once. A photo it already has keeps
// its record, and leaves Trash only when the addition says so. A photo a
// released version's library keeps gets its entity record now, with that
// record's name, day, Trash and the time it was added.
MediaAddBytes :: (data: string, addition: MediaAddition) -> MediaImport {
    result: MediaImport
    if DataTemporary() || data.count <= 0 || data.count > DIARY_FILE_LIMIT {
        return result
    }
    format := DiaryImageFormat(data)
    if format.count == 0 {
        return result
    }
    descriptor := cast(*TextDescriptor)(*data)
    storage_sha256_hex(descriptor.data, data.count, *result.hash[0])
    hash := TextFromBytes(result.hash[:64])
    directory := MediaDirectory()
    path := MediaPath(hash, false)
    defer {
        PackageFree(directory)
        PackageFree(path)
    }
    if directory.count == 0 || storage_ensure_dir(directory) == 0 ||
    !MediaPlaceFile(path, data, addition.source) {
        return result
    }
    key := EntityPhotoKey(hash)
    record := MediaRecordRead(key)
    defer {
        PackageFree(key)
        PackageFree(record)
    }
    existing := MediaParseEntity(record)
    if existing.valid {
        result.existed = true
        if existing.trashed && addition.restore {
            restored := MediaRecordWith(record, "trashed", "false")
            written := restored.count > 0 && MediaRecordWrite(key, restored)
            PackageFree(restored)
            if !written {
                return result
            }
        }
        MediaAssetsChanged()
        sync_web_storage()
        result.succeeded = true
        return result
    }
    legacy_key := MediaRecordKey(hash)
    legacy_record := MediaRecordRead(legacy_key)
    legacy := MediaParseLegacy(legacy_record)
    legacy_capture := ReadNumber(legacy_record, FieldAt(legacy_record, 0, "capture"))
    PackageFree(legacy_key)
    PackageFree(legacy_record)
    day: [11]u8
    taken: [26]u8
    fields: MediaEntityFields
    capture_data := ifx addition.capture_source.count > 0 then addition.capture_source else data
    capture_format := ifx addition.capture_source.count > 0 then DiaryImageFormat(capture_data) else format
    capture := MediaCaptureOf(capture_data, capture_format)
    if legacy.valid && TextFromBytes(legacy.hash[:64]) == hash {
        result.existed = true
        fields.name = TextUntilNul(legacy.name[:])
        fields.day = TextUntilNul(legacy.day[:])
        fields.taken = TextUntilNul(legacy.taken[:])
        fields.added = legacy.added
        fields.trashed = legacy.trashed && !addition.restore
        fields.capture = ifx legacy_capture.valid then legacy_capture.value != 0.0 else capture.valid && capture.year >= 1000
        fields.preview = MediaLegacyPreview(hash)
    } else {
        if !MediaWhen(capture_data, capture_format, addition.day, day[:], taken[:]) {
            return result
        }
        fields.name = addition.name
        fields.day = TextUntilNul(day[:])
        fields.taken = TextUntilNul(taken[:])
        fields.added = CellRecordClock() / 1000000
        fields.capture = capture.valid && capture.year >= 1000
    }
    if !fields.preview.valid {
        fields.preview = MediaWritePreview(hash, data, format)
    }
    entry := MediaEntityEntry(hash, data, format, fields)
    defer { PackageFree(entry) }
    if !MediaRecordWrite(key, entry) {
        return result
    }
    if !legacy.valid {
        AchievementPhotoImported(hash)
    }
    MediaAssetsChanged()
    sync_web_storage()
    result.succeeded = true
    return result
}

// A preview turns the photo upright and makes it small. A small upright
// photo is its own preview and gets none.
MediaWritePreview :: (hash: string, data: string, source_format: string) -> MediaPreviewMade {
    made: MediaPreviewMade
    orientation := MediaOrientationOf(data, source_format)
    file_type := PackageText(".", source_format)
    preview := ImagePreview(data, file_type, MEDIA_PREVIEW_EDGE, orientation, MEDIA_PREVIEW_QUALITY)
    defer {
        PackageFree(file_type)
        PackageFree(preview)
    }
    format := DiaryImageFormat(preview)
    if format.count == 0 || (orientation == 1 && preview.count >= data.count) {
        return made
    }
    path := MediaPath(hash, true)
    defer { PackageFree(path) }
    if !MediaWriteFile(path, preview) {
        return made
    }
    descriptor := cast(*TextDescriptor)(*preview)
    storage_sha256_hex(descriptor.data, preview.count, *made.hash[0])
    made.size = preview.count
    unused AppCopyText(format, made.format[:])
    made.valid = true
    return made
}

// Adds a file the person picked. Only its bytes and its name are kept.
MediaImportFile :: (path: string) -> MediaImport {
    data := PackageRead(path, DIARY_FILE_LIMIT + 1)
    defer { PackageFree(data) }
    return MediaImportBytes(data, path)
}

// A photo's place in the library, as a Diary entry links to it:
// photos/YYYY/MM/DD/<sha256>.<type>, under the day the gallery groups it.
MediaPlace :: (item: MediaItem) -> string {
    day := TextUntilNul(item.day[:])
    format := TextUntilNul(item.format[:])
    if !item.valid || day.count != 10 || format.count == 0 {
        return ""
    }
    out: Vec(u8)
    BuilderPrint(*out, "photos/%/%/%/", day[:4], day[5:7], day[8:10])
    BuilderPrint(*out, "%.%", TextFromBytes(item.hash[:64]), format)
    return BuilderFinish(out)
}

// The SHA-256 a place in the library names, or "" for anything else. The
// day and type it names are not checked against the photo's record: the
// hash alone finds the photo.
MediaPlaceHash :: (place: string) -> string {
    if place.count < 86 || place.count > 87 || place[:7] != "photos/" ||
    place[11] != cast(u8)47 || place[14] != cast(u8)47 || place[17] != cast(u8)47 ||
    place[82] != cast(u8)46 {
        return ""
    }
    for index: 7..16 {
        digit := place[index] >= cast(u8)48 && place[index] <= cast(u8)57
        if !digit && index != 11 && index != 14 {
            return ""
        }
    }
    hash := place[18:82]
    if !MediaHashValid(hash) {
        return ""
    }
    return hash
}

// Queries.

// Entity records, and a released version's records of photos that have
// none yet. A record another app wrote may lack the capture day and time;
// its capture time's UTC day and time stand in.
MediaQuerySQL :: #string SQL_END
SELECT hash,day FROM (
  SELECT substr(key,15) AS hash,
    COALESCE(json_extract(value,'$.day'),date(json_extract(value,'$.taken_at'),'unixepoch')) AS day,
    COALESCE(json_extract(value,'$.taken'),
      strftime('%Y-%m-%dT%H:%M:%S',json_extract(value,'$.taken_at'),'unixepoch')) AS taken,
    COALESCE(json_extract(value,'$.trashed'),0) AS trashed
  FROM settings WHERE user_id=?1 AND key GLOB 'entity.photos.*' AND length(key)=78
    AND substr(key,15) NOT GLOB '*[^0-9a-f]*' AND json_valid(value)
    AND json_extract(value,'$.type') IN ('image/png','image/jpeg','image/gif','image/webp')
  UNION ALL
  SELECT substr(l.key,12),json_extract(l.value,'$.day'),json_extract(l.value,'$.taken'),
    COALESCE(json_extract(l.value,'$.trashed'),0)
  FROM settings l WHERE l.user_id=?1 AND l.key GLOB 'cell.media.*' AND length(l.key)=75
    AND substr(l.key,12) NOT GLOB '*[^0-9a-f]*' AND json_valid(l.value)
    AND NOT EXISTS (SELECT 1 FROM settings e WHERE e.user_id=?1 AND e.key='entity.photos.'||substr(l.key,12))
)
WHERE (?2='' OR day=?2) AND (CASE WHEN trashed=0 THEN 0 ELSE 1 END)=?3
ORDER BY taken DESC,hash DESC
LIMIT ?4
SQL_END;

// A new account, or a signed-out one, starts without another's answers.
MediaOwnerCheck :: () {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if TextUntilNul(media_owner[:]) == owner {
        return
    }
    MediaStoreClose()
    unused AppCopyText(owner, media_owner[:])
}

// Lists the library's items of one capture day (YYYY-MM-DD), or of every
// day when `day` is empty, newest first: those in Trash or the others. The
// answer stays until the library changes here or a sync brings changes.
MediaQuery :: (day: string, trashed: bool) -> s32 {
    MediaOwnerCheck()
    if (day.count != 0 && day.count != 10) || storage_db_handle() == null {
        media_row_count = 0
        return 0
    }
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if media_query_revision == media_revision && media_query_changes == storage_media_changes &&
    TextUntilNul(media_query_day[:]) == day && media_query_trashed == trashed &&
    TextUntilNul(media_query_owner[:]) == owner {
        return media_row_count
    }
    media_query_revision = media_revision
    media_query_changes = storage_media_changes
    unused AppCopyText(day, media_query_day[:])
    unused AppCopyText(owner, media_query_owner[:])
    media_query_trashed = trashed
    media_row_count = 0
    statement: *void
    if SqlitePrepareText(storage_db_handle(), MediaQuerySQL, -1, *statement, null) != SQLITE_OK {
        return 0
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, owner)
    unused bind_text(statement, 2, day)
    unused SqliteBindInt(statement, 3, ifx trashed then 1 else 0)
    unused SqliteBindInt(statement, 4, MEDIA_QUERY_LIMIT)
    // An FNV-1a style checksum of the answer, its day and Trash choice.
    checksum: u64 = 1469598103934665603
    for byte: day {
        checksum = (checksum ^ cast(u64)byte) * 1099511628211
    }
    checksum = (checksum ^ cast(u64)(ifx trashed then 1 else 2)) * 1099511628211
    while media_row_count < MEDIA_QUERY_LIMIT && SqliteStep(statement) == SQLITE_ROW {
        hash := AppTextFromCString(SqliteColumnText(statement, 0), 65)
        row_day := AppTextFromCString(SqliteColumnText(statement, 1), 11)
        if MediaHashValid(hash) && row_day.count == 10 {
            row := *media_rows[media_row_count]
            unused AppCopyText(hash, row.hash[:])
            unused AppCopyText(row_day, row.day[:])
            media_row_count += 1
            for byte: hash {
                checksum = (checksum ^ cast(u64)byte) * 1099511628211
            }
            for byte: row_day {
                checksum = (checksum ^ cast(u64)byte) * 1099511628211
            }
        }
    }
    if checksum != media_query_checksum {
        media_query_checksum = checksum
        media_library_revision += 1
    }
    return media_row_count
}

// Changes whenever a query's answer changes: photos added, moved to Trash
// or arriving from another device.
MediaLibraryRevision :: () -> s32 {
    return media_library_revision
}

MediaQueryRow :: (index: s32) -> MediaRow {
    if index < 0 || index >= media_row_count {
        return MediaRow.{}
    }
    return media_rows[index]
}

// Originals wanted on this device. The list is a device setting, so the
// desktop's sync worker reads it on its own statement.

MediaWantedRead :: (output: []u8) {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if storage_db_handle() == null {
        return
    }
    statement: *void
    if SqlitePrepareText(storage_db_handle(),
        "SELECT value FROM settings WHERE user_id=(SELECT id FROM users LIMIT 1) AND key=?1", -1,
        *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, MEDIA_WANTED_KEY)
    if SqliteStep(statement) == SQLITE_ROW {
        unused AppCopyText(AppTextFromCString(SqliteColumnText(statement, 0),
            cast(s32)output.count), output)
    }
}

// Whether `wanted`, a list read by MediaWantedRead, names the photo.
MediaWantedIn :: (wanted: string, hash: string) -> bool {
    at: s64 = 0
    while at + 64 <= wanted.count {
        if wanted[at:at + 64] == hash {
            return true
        }
        at += 65
    }
    return false
}

MediaOriginalWanted :: (hash: string) -> bool {
    wanted: [MEDIA_WANTED_MAX * 65 + 1]u8
    MediaWantedRead(wanted[:])
    return MediaWantedIn(TextUntilNul(wanted[:]), hash)
}

// Asks for a photo's original on this device; the newest MEDIA_WANTED_MAX
// requests are kept.
MediaWant :: (hash: string) {
    if !MediaHashValid(hash) {
        return
    }
    wanted: [MEDIA_WANTED_MAX * 65 + 1]u8
    MediaWantedRead(wanted[:])
    current := TextUntilNul(wanted[:])
    if MediaWantedIn(current, hash) {
        return
    }
    out: Vec(u8)
    BuilderPrint(*out, "%", hash)
    kept: s32 = 1
    at: s64 = 0
    while at + 64 <= current.count && kept < MEDIA_WANTED_MAX {
        BuilderPrint(*out, "\n%", current[at:at + 64])
        kept += 1
        at += 65
    }
    list := BuilderFinish(out)
    storage_set_setting_text(MEDIA_WANTED_KEY, list)
    PackageFree(list)
}

// Assets.

// Forgets answered asset paths, for example when a copy arrives.
MediaAssetsChanged :: () {
    diary_blob_generation += 1
}

// A format word as a constant, or empty.
MediaFormatLiteral :: (value: string) -> string {
    if value == "png" {
        return "png"
    }
    if value == "jpg" {
        return "jpg"
    }
    if value == "gif" {
        return "gif"
    }
    if value == "webp" {
        return "webp"
    }
    return ""
}

// What the photo's record says of its original or its preview: the hash,
// size and format the file must have.
MediaContentOf :: (hash: string, preview: bool) -> EntityContent {
    entity := MediaEntityRecord(hash)
    defer { PackageFree(entity) }
    if entity.count > 0 {
        return ifx preview then EntityPreviewContent(entity) else EntityPhotoContent(entity)
    }
    key := ifx preview then MediaPreviewKey(hash) else MediaRecordKey(hash)
    record := MediaRecordRead(key)
    defer {
        PackageFree(key)
        PackageFree(record)
    }
    media := DiaryMediaParse(record)
    content: EntityContent
    if !media.valid || ReadStringText(record, FieldAt(record, 0, "type"), content.format[:]) <= 0 {
        return content
    }
    content.hash = media.hash
    content.size = media.size
    content.valid = true
    return content
}

// The local file's format when it holds as many bytes as its record names.
MediaLocalFormat :: (hash: string, preview: bool) -> string {
    content := MediaContentOf(hash, preview)
    if !content.valid {
        return ""
    }
    path := MediaPath(hash, preview)
    defer { PackageFree(path) }
    if PackageFileSize(path) != content.size {
        return ""
    }
    return MediaFormatLiteral(TextUntilNul(content.format[:]))
}

MediaAssetLookup :: (hash: string, original: bool) -> string {
    out: Vec(u8)
    if original {
        format := MediaLocalFormat(hash, false)
        if format.count > 0 {
            BuilderPrint(*out, "media/%.%", hash, format)
            return BuilderFinish(out)
        }
        MediaWant(hash)
    }
    preview := MediaLocalFormat(hash, true)
    if preview.count > 0 {
        BuilderPrint(*out, "media/preview/%.%", hash, preview)
        return BuilderFinish(out)
    }
    // A small photo is its own preview, and an original stands in for a
    // preview that has not arrived yet.
    format := MediaLocalFormat(hash, false)
    if format.count > 0 {
        BuilderPrint(*out, "media/%.%", hash, format)
        return BuilderFinish(out)
    }
    VecFree(out)
    return ""
}

// The asset path that draws a library photo: its preview, or its original
// when asked and on this device, or "" while neither is. Asking for the
// original also asks for its download; until it arrives the preview shows.
MediaAsset :: (hash: string, original: bool) -> string {
    MediaOwnerCheck()
    if !MediaHashValid(hash) {
        return ""
    }
    for index: cast(s32)0..MEDIA_ASSET_CACHE - 1 {
        entry := *media_assets[index]
        if entry.original == original && entry.generation == diary_blob_generation &&
        TextUntilNul(entry.hash[:]) == hash {
            return TextUntilNul(entry.path[:])
        }
    }
    if !MediaRead(hash).valid {
        return ""
    }
    path := MediaAssetLookup(hash, original)
    defer { PackageFree(path) }
    slot := *media_assets[media_assets_next]
    media_assets_next = (media_assets_next + 1) % MEDIA_ASSET_CACHE
    slot.* = MediaAssetEntry.{}
    unused AppCopyText(hash, slot.hash[:])
    slot.original = original
    slot.generation = diary_blob_generation
    if !AppCopyText(path, slot.path[:]) {
        slot.path[0] = cast(u8)0
    }
    return TextUntilNul(slot.path[:])
}

// The hash in "media/<hash>.<fmt>" or "media/preview/<hash>.<fmt>", or "".
MediaAssetHash :: (path: string) -> string {
    start: s64 = 6
    if path.count < 6 || path[:6] != "media/" {
        return ""
    }
    if path.count > 14 && path[6:14] == "preview/" {
        start = 14
    }
    if path.count < start + 66 || path[start + 64] != cast(u8)46 {
        return ""
    }
    extension := path[start + 65:]
    if extension != "png" && extension != "jpg" && extension != "gif" && extension != "webp" {
        return ""
    }
    hash := path[start:start + 64]
    if !MediaHashValid(hash) {
        return ""
    }
    return hash
}

// Whether a hosted app may draw this path: a photo of this account's
// library, as MediaAsset answered it.
MediaAssetAllowed :: (path: string) -> bool {
    hash := MediaAssetHash(path)
    if hash.count != 64 {
        return false
    }
    for index: cast(s32)0..MEDIA_ASSET_CACHE - 1 {
        entry := *media_assets[index]
        if TextUntilNul(entry.path[:]) == path && TextUntilNul(entry.hash[:]) == hash {
            return true
        }
    }
    return MediaRead(hash).valid
}

MediaAssetMime :: (format: string) -> string {
    if format == "jpg" {
        return "image/jpeg"
    }
    if format == "gif" {
        return "image/gif"
    }
    if format == "webp" {
        return "image/webp"
    }
    return "image/png"
}

// The bytes behind a media asset path, checked against their record.
MediaAssetView :: (path: string) -> AssetView {
    hash := MediaAssetHash(path)
    if hash.count != 64 {
        return AssetView.{}
    }
    preview := path[6:14] == "preview/"
    content := MediaContentOf(hash, preview)
    file := MediaPath(hash, preview)
    defer {
        PackageFree(file)
    }
    PackageFree(media_asset_bytes)
    media_asset_bytes = PackageRead(file, DIARY_FILE_LIMIT)
    format := DiaryImageFormat(media_asset_bytes)
    at := path.count - 1
    while at > 0 && path[at] != cast(u8)46 {
        at -= 1
    }
    if !EntityContentMatches(content, media_asset_bytes) || format != path[at + 1:] {
        PackageFree(media_asset_bytes)
        media_asset_bytes = ""
        return AssetView.{}
    }
    return AssetView.{.data = media_asset_bytes, .mime = MediaAssetMime(format), .found = true}
}

// Changes.

// Sets one field of the photo's record, keeping all others: its entity
// record, or a released version's while it has none.
MediaSetField :: (hash: string, field: string, entity_value: string, legacy_value: string) -> bool {
    if !MediaRead(hash).valid {
        return false
    }
    entity_key := EntityPhotoKey(hash)
    entity_record := MediaRecordRead(entity_key)
    legacy_key := MediaRecordKey(hash)
    defer {
        PackageFree(entity_key)
        PackageFree(entity_record)
        PackageFree(legacy_key)
    }
    if entity_record.count > 0 {
        changed := MediaRecordWith(entity_record, field, entity_value)
        written := changed.count > 0 && MediaRecordWrite(entity_key, changed)
        PackageFree(changed)
        return written
    }
    record := MediaRecordRead(legacy_key)
    changed := MediaRecordWith(record, field, legacy_value)
    written := changed.count > 0 && MediaRecordWrite(legacy_key, changed)
    PackageFree(record)
    PackageFree(changed)
    return written
}

// Moves a photo to Trash or back. Trash keeps the photo and its copies.
MediaSetTrashed :: (hash: string, trashed: bool) -> bool {
    return MediaSetField(hash, "trashed", ifx trashed then "true" else "false", ifx trashed then "1" else "0")
}

// Renames a photo: one line of at most MEDIA_NAME_MAX bytes.
MediaSetName :: (hash: string, name: string) -> bool {
    trimmed := MediaNameCut(name)
    out: Vec(u8)
    MediaJson(*out, trimmed)
    quoted := BuilderFinish(out)
    defer { PackageFree(quoted) }
    return MediaSetField(hash, "name", quoted, quoted)
}

MediaStoreClose :: () {
    PackageFree(media_asset_bytes)
    media_asset_bytes = ""
    for index: cast(s32)0..MEDIA_ASSET_CACHE - 1 {
        media_assets[index] = MediaAssetEntry.{}
    }
    media_assets_next = 0
    media_row_count = 0
    media_query_revision = -1
    media_owner[0] = cast(u8)0
}
