#import "json_scan"
#import "byte_text_linux"

LumiResponseMessageAt :: (document: string) -> s32 {
    end := ValueEnd(document, 0, 0)
    if end < 0 || Space(document, end) != document.count {
        return -1
    }
    return FieldAt(document, 0, "message")
}

// HTTP success alone is not a feedback receipt. Daochi acknowledges the exact
// report ID as a JSON string, optionally followed by JSON whitespace.
LumiFeedbackReceiptMatches :: (document: string, id: string) -> bool {
    if id.count != 64 {
        return false
    }
    end := ValueEnd(document, 0, 0)
    if end < 0 || Space(document, end) != document.count {
        return false
    }
    bytes: [65]u8
    count := ReadStringText(document, Space(document, 0), bytes[:])
    return count == 64 && TextFromBytes(bytes[:count]) == id
}
