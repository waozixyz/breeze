// Serial downloads keep the platform transfer service and disk publication
// bounded. Account app choices never contain local versions or cache paths.
#import "keys"
#import "json_scan"
#import "byte_text_linux"
#import "std/text_buffer"
#import "std/c_string"
#import "file_linux"
#import, file "catalog.zi";
#import, file "inbe_types.zi";
#import, file "package_release.zi";
#import, file "package_files.zi";
#import, file "package_history.zi";
#import, file "../storage/app_records.zi";
#import, file "versions.zi";
#import, file "host_api.zi";
#import, file "../app/assets.zi";
#import, file "../app/settings_store.zi";
#import, file "../app/text_buffers.zi";
#import "file_download"
#import, file "../platform/web_storage.zi";
#import, file "../storage/temporary_data.zi";
#import, file "../storage/paths.zi";

using FileDownloadStatus;

package_download: FileDownload;
package_index: s32 = -1;
package_phase: s32;
package_requested: [PackageSlots]bool;
package_requested_check_only: [PackageSlots]bool;
package_check_only: bool;
package_available_releases: [PackageSlots]PackageRelease;
package_available_ids: [PackageSlots][128]u8;
package_requested_target: [PackageSlots]bool;
package_requested_version: [PackageSlots][32]u8;
package_requested_digest: [PackageSlots][65]u8;
package_requested_account: [PackageSlots][65]u8;
package_requested_identity: [PackageSlots][128]u8;
package_requested_current: [PackageSlots][32]u8;
package_requested_retained: [PackageSlots]string;
package_target: bool;
package_target_version: [32]u8;
package_target_digest: [65]u8;
package_target_account: [65]u8;
package_target_identity: [128]u8;
package_target_current: [32]u8;
package_rollback: bool;
package_automatic: bool;
package_requested_automatic: [PackageSlots]bool;
package_initialized: bool;
package_release: PackageRelease;
package_metadata: string;
package_origin: [512]u8;
package_versions: [PackageSlots][32]u8;
package_fallback_versions: [PackageSlots][32]u8;
package_cached_releases: [PackageSlots]PackageRelease;
package_status: [PackageSlots]s32;
package_revision: s32;
// Update checks run daily, once after each start, and soon after a sync
// reports a newer root package. The schedule stays in memory: the pump runs
// every frame and settings reads are database queries.
package_last_check: s32 = -1;
package_launch_checked: bool;
package_sequence_hint: s32;
package_hint_read_at: s32;
// Downloaded packages prove themselves by running for a while after a start.
package_started_at: s32;
package_trial_counted: [PackageSlots]bool;
package_trials_open: bool;
PACKAGE_TRIAL_STARTS :: 3
PACKAGE_TRIAL_SECONDS :: 10
c :: #system_library "c";
PackageSettingText :: (key: string) -> string #foreign c "storage_get_setting_text";
PackageAccountBytes :: () -> *u8 #foreign c "storage_user_id_buffer";

PackageAccount :: () -> string {
    return AppTextFromCString(PackageAccountBytes(), 64)
}

// 0 idle, 1 downloading, 2 installed, 3 failure, 4 publisher not configured.
PackageStatus :: (index: s32) -> s32 {
    if index < 0 || index >= PackageSlots {
        return 3
    }
    return package_status[index]
}

PackageRevision :: () -> s32 {
    return package_revision
}

PackageAvailable :: (index: s32) -> bool {
    if index < 0 || index >= PackageSlots {
        return false
    }
    return PackageBundledSequence(index) > 0 || package_versions[index][0] != cast(u8)0
}

PackageTrustedKey :: (metadata: string, index: s32, output: []u8) -> bool {
    return PackageTrustedKeyFor(metadata, PackageID(index), output)
}

PackageTrustedKeyFor :: (metadata: string, app_id: string, output: []u8) -> bool {
    if app_id.count == 0 {
        return false
    }
    key_bytes: [64]u8
    key := PackageField(metadata, 0, "key_id", key_bytes[:])
    publishers := AssetRead("apps/publishers.json").data
    count := ArrayCount(publishers, 0)
    if count < 0 || count > 32 {
        return false
    }
    row: s32 = 0
    while row < count {
        at := ElementAt(publishers, 0, row)
        id_bytes: [64]u8
        if PackageField(publishers, at, "key_id", id_bytes[:]) == key {
            apps := FieldAt(publishers, at, "app_ids")
            app_count := ArrayCount(publishers, apps)
            for app: 0..app_count - 1 {
                id: [64]u8
                n := ReadStringText(publishers, ElementAt(publishers, apps, app), id[:])
                if n > 0 && TextFromBytes(id[0:n]) == app_id {
                    return PackageField(publishers, at, "public_key", output).count == 64
                }
            }
            prefixes := FieldAt(publishers, at, "app_prefixes")
            prefix_count := ArrayCount(publishers, prefixes)
            for prefix_index: 0..prefix_count - 1 {
                prefix: [64]u8
                n := ReadStringText(publishers, ElementAt(publishers, prefixes, prefix_index), prefix[:])
                if n > 1 && n < app_id.count && app_id[:n] == TextFromBytes(prefix[0:n]) &&
                NodeAppNameValid(app_id[n:]) {
                    return PackageField(publishers, at, "public_key", output).count == 64
                }
            }
        }
        row += 1
    }
    return false
}

PackageTrustedRelease :: (metadata: string, index: s32) -> PackageRelease {
    key: [65]u8
    if !PackageTrustedKey(metadata, index, key[:]) {
        return PackageRelease.{}
    }
    return PackageParseRelease(metadata, index, TextFromCString(*key[0]))
}

PackagePayloadPath :: (index: s32, hash: string) -> string {
    suffix := PackageText(".", hash)
    full_suffix := PackageText(suffix, ".zib")
    defer {
        PackageFree(suffix);
        PackageFree(full_suffix)
    }
    return PackagePath(index, full_suffix)
}

PackageInstalledBytes :: (index: s32) -> string {
    if index < 0 || index >= PackageSlots {
        return ""
    }
    package_versions[index][0] = cast(u8)0
    if DataTemporary() {
        return ""
    }
    pointer := PackagePath(index, ".current.json")
    defer {
        PackageFree(pointer)
    }
    metadata := PackageRead(pointer, 65536)
    defer {
        PackageFree(metadata)
    }
    release := PackageTrustedRelease(metadata, index)
    if !release.valid {
        return ""
    }
    high_water := PackageSequence(index)
    approved := PackageRollbackAllows(index, release)
    if release.sequence < high_water && !approved {
        return ""
    }
    if PackageBundledSequence(index) > 0 &&
    PackageVersionCompare(TextFromCString(*release.version[0]), PackageFallbackVersion(index)) < 0 && !approved {
        return ""
    }
    path := PackagePayloadPath(index, TextFromCString(*release.hash[0]))
    defer {
        PackageFree(path)
    }
    bytes := PackageRead(path, PackageMaximumBytes)
    if !PackageVerifyBytes(bytes, release) {
        PackageFree(bytes)
        return ""
    }
    unused AppCopyText(TextFromCString(*release.version[0]), package_versions[index][:])
    package_cached_releases[index] = release
    return bytes
}

// Whether the current release pointer names this hash and its payload is
// present at its signed size. The payload was verified when it was written
// and is verified again whenever it loads, so it is not read and hashed
// here: hashing every installed package on the frame thread at each update
// check froze phones for seconds after launch.
PackageInstalledMatches :: (index: s32, hash: string) -> bool {
    if index < 0 || index >= PackageSlots || DataTemporary() {
        return false
    }
    pointer := PackagePath(index, ".current.json")
    defer {
        PackageFree(pointer)
    }
    metadata := PackageRead(pointer, 65536)
    defer {
        PackageFree(metadata)
    }
    release := PackageTrustedRelease(metadata, index)
    if !release.valid || TextFromCString(*release.hash[0]) != hash {
        return false
    }
    path := PackagePayloadPath(index, hash)
    defer {
        PackageFree(path)
    }
    return PackageFileSize(path) == release.size
}

PackageVersionCompare :: (left: string, right: string) -> s32 {
    left_at: s64 = 0
    right_at: s64 = 0
    for part: cast(s32)0..cast(s32)2 {
        left_number: s64 = 0
        right_number: s64 = 0
        while left_at < left.count && left[left_at] != cast(u8)46 {
            left_number = left_number * 10 + cast(s64)left[left_at] - 48
            left_at += 1
        }
        while right_at < right.count && right[right_at] != cast(u8)46 {
            right_number = right_number * 10 + cast(s64)right[right_at] - 48
            right_at += 1
        }
        if left_number < right_number {
            return -1
        }
        if left_number > right_number {
            return 1
        }
        left_at += 1
        right_at += 1
    }
    return 0
}

PackageFallbackVersion :: (index: s32) -> string {
    if index >= PackageCount {
        return ""
    }
    if package_fallback_versions[index][0] != cast(u8)0 {
        return TextFromCString(*package_fallback_versions[index][0])
    }
    return PackageBundledVersion(index)
}

PackageMarkRootActive :: (downloaded: bool) {
    for index: cast(s32)0..cast(s32)(PackageCount - 1) {
        package_fallback_versions[index][0] = cast(u8)0
    }
    if downloaded {
        release := package_cached_releases[0]
        unused AppCopyText(TextFromCString(*release.version[0]), package_fallback_versions[0][:])
        for index: cast(s32)1..cast(s32)(PackageCount - 1) {
            if release.dependency_sizes[index] == 0 { continue }
            unused AppCopyText(TextFromCString(*release.dependency_versions[index][0]),
                package_fallback_versions[index][:])
        }
    }
}

PackageRootPending :: () -> bool {
    return package_versions[0][0] != cast(u8)0 && PackageVersion(0) != PackageFallbackVersion(0)
}

PackageSequenceKey :: (index: s32) -> string {
    return PackageText("package_sequence_", PackageName(index))
}

PackageSequence :: (index: s32) -> s32 {
    key := PackageSequenceKey(index)
    defer {
        PackageFree(key)
    }
    stored := SettingsReadInt(key, 0)
    bundled := PackageBundledSequence(index)
    return ifx stored > bundled then stored else bundled
}

PackageVersion :: (index: s32) -> string {
    if index < 0 || index >= PackageSlots {
        return ""
    }
    if package_versions[index][0] != cast(u8)0 {
        return TextFromCString(*package_versions[index][0])
    }
    return PackageFallbackVersion(index)
}

PackagePublisherConfigured :: () -> bool {
    count := ArrayCount(AssetRead("apps/publishers.json").data, 0)
    return count > 0 && count <= 32
}

PackageRequest :: (index: s32) {
    if index < 0 || index >= PackageSlots || DataTemporary() {
        return
    }
    package_requested_automatic[index] = false
    package_requested_check_only[index] = false
    package_requested_target[index] = false
    PackageFree(package_requested_retained[index])
    package_requested_retained[index] = ""
    package_requested[index] = true
    package_status[index] = 0
}

// A manual modal authorizes only this signed version/hash for this account.
// A later node response cannot silently substitute a different release.
PackageRequestVersion :: (index: s32, version: string, digest: string, account: string) -> bool {
    if !PackageUpdateAvailable(index) || account != PackageAccount() ||
    version != PackageAvailableVersion(index) ||
    digest != TextUntilNul(package_available_releases[index].hash[:]) {
        return false
    }
    PackageRequest(index)
    if !package_requested[index] { return false }
    unused CopyCString(version, package_requested_version[index][:])
    unused CopyCString(digest, package_requested_digest[index][:])
    unused CopyCString(account, package_requested_account[index][:])
    unused CopyCString(PackageID(index), package_requested_identity[index][:])
    unused CopyCString(PackageVersion(index), package_requested_current[index][:])
    package_requested_target[index] = true
    return true
}

PackageRequestRetained :: (index: s32, metadata: string, account: string) -> bool {
    if index < 0 || index >= PackageSlots || account != PackageAccount() { return false }
    release := PackageTrustedRelease(metadata, index)
    if !release.valid || release.sequence > PackageSequence(index) ||
    PackageVersionCompare(TextUntilNul(release.version[:]), PackageVersion(index)) >= 0 { return false }
    PackageRequest(index)
    if !package_requested[index] { return false }
    package_requested_retained[index] = PackageText(metadata, "")
    unused CopyCString(TextUntilNul(release.version[:]), package_requested_version[index][:])
    unused CopyCString(TextUntilNul(release.hash[:]), package_requested_digest[index][:])
    unused CopyCString(account, package_requested_account[index][:])
    unused CopyCString(PackageID(index), package_requested_identity[index][:])
    unused CopyCString(PackageVersion(index), package_requested_current[index][:])
    package_requested_target[index] = true
    return true
}

PackageCheckForUpdate :: (index: s32) {
    if index < 0 || index >= PackageSlots || DataTemporary() || package_requested[index] {
        return
    }
    package_requested[index] = true
    package_requested_automatic[index] = false
    package_requested_check_only[index] = true
}

PackageRequestAll :: (desired: s32) {
    PackageRequest(0)
    for index: cast(s32)1..cast(s32)(PackageSlots - 1) {
        if PackageWanted(index, desired) {
            PackageRequest(index)
        }
    }
}

PackageCancel :: () {
    FileDownloadRelease(*package_download)
    PackageFree(package_metadata)
    package_metadata = ""
    package_index = -1
    package_phase = 0
    package_automatic = false
    for index: cast(s32)0..cast(s32)(PackageSlots - 1) {
        package_requested[index] = false
        package_requested_check_only[index] = false
        package_requested_target[index] = false
        PackageFree(package_requested_retained[index])
        package_requested_retained[index] = ""
        package_history_pending[index] = false
    }
    package_check_only = false
    package_target = false
    package_rollback = false
}

// Packages come from Waozi's node, not from the store that installed the
// app, so automatic updates wait for the person to allow them. The answer
// has its own key: "cells_auto_update" was saved as on without being asked.
// The answer stays in memory because the pump asks every frame.
PACKAGE_UPDATES_KEY :: "package_updates_allowed"
PACKAGE_UPDATES_UNASKED :: -1
PACKAGE_UPDATES_UNREAD :: -2
package_updates_answer: s32 = PACKAGE_UPDATES_UNREAD;
package_updates_possible: s32 = -1;

PackageUpdatesAnswer :: () -> s32 {
    if package_updates_answer == PACKAGE_UPDATES_UNREAD {
        package_updates_answer = SettingsReadInt(PACKAGE_UPDATES_KEY, PACKAGE_UPDATES_UNASKED)
    }
    return package_updates_answer
}

PackageAutomaticEnabled :: () -> bool {
    return PackageUpdatesAnswer() == 1
}

PackageUpdatesPossible :: () -> bool {
    if package_updates_possible < 0 {
        possible := !DataTemporary() && PackagePublisherConfigured()
        package_updates_possible = ifx possible then 1 else 0
    }
    return package_updates_possible == 1
}

// The question is asked once, where packages can be downloaded at all.
PackageAutomaticUnasked :: () -> bool {
    if PackageUpdatesAnswer() != PACKAGE_UPDATES_UNASKED {
        return false
    }
    return PackageUpdatesPossible()
}

PackageSetAutomatic :: (enabled: bool) {
    package_updates_answer = ifx enabled then 1 else 0
    unused SettingsStoreInt(PACKAGE_UPDATES_KEY, package_updates_answer)
    if !enabled {
        if package_automatic && package_index >= 0 {
            FileDownloadRelease(*package_download)
            package_status[package_index] = 0
            PackageFree(package_metadata)
            package_metadata = ""
            package_index = -1
            package_phase = 0
            package_automatic = false
        }
        for index: cast(s32)0..cast(s32)(PackageSlots - 1) {
            if package_requested_automatic[index] {
                package_requested[index] = false
            }
            package_requested_automatic[index] = false
        }
    }
}

PackageInitialize :: () {
    package_initialized = true
    directory := PackageDirectory()
    defer {
        PackageFree(directory)
    }
    if directory.count > 0 {
        unused storage_ensure_dir(directory)
    }
    // The catalog shares Waozi's node, while sync can use a different node.
    unused AppCopyText("https://api.waozi.xyz", package_origin[:])
    for index: cast(s32)1..cast(s32)(PackageCount - 1) {
        cached := PackageInstalledBytes(index)
        PackageFree(cached)
    }
}

// Devices keep one random bucket from 0 to 99, so a staged package release
// reaches the same share of devices on every check.
PackageBucket :: () -> s32 {
    stored := SettingsReadInt("package_bucket", -1)
    if stored >= 0 && stored < 100 {
        return stored
    }
    random: [4]u8
    if SecureRandom(*random[0], 4) == 0 {
        return 99
    }
    value := cast(u32)random[0] | (cast(u32)random[1] << 8) |
    (cast(u32)random[2] << 16) | (cast(u32)random[3] << 24)
    bucket := cast(s32)(value % cast(u32)100)
    unused SettingsStoreInt("package_bucket", bucket)
    return bucket
}

// The node answers with the newest release this host can run.
PackageLatestQuery :: () -> string {
    return PackageReleaseQuery("/latest")
}

PackageReleaseQuery :: (route: string) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "%?host_api=%&module_api=%&bucket=%", route, cast(s32)PackageHostAPI,
        cast(s32)PackageModuleAPI, PackageBucket())
    return BuilderFinish(out)
}

PackageStartTransfer :: (suffix: string, destination: string) -> bool {
    latest := suffix == "/latest"
    path := PackageText("/api/v2/packages/", PackageID(package_index))
    history := suffix == "/history"
    query := ifx latest || history then PackageReleaseQuery(suffix) else PackageText(suffix, "")
    route := PackageText(path, query)
    url := PackageText(TextFromCString(*package_origin[0]), route)
    defer {
        PackageFree(path);
        PackageFree(query);
        PackageFree(route);
        PackageFree(url)
    }
    FileDownloadRelease(*package_download)
    package_download = FileDownload.{}
    maximum := ifx history then 262144 else (ifx latest then 65536 else package_release.size)
    package_download.maximum_bytes = cast(u64)maximum
    return FileDownloadStart(*package_download, url, destination)
}

PackageFinish :: (ok: bool) {
    FileDownloadRelease(*package_download)
    if package_phase != 3 { package_status[package_index] = ifx ok then 2 else 3 }
    PackageFree(package_metadata)
    package_metadata = ""
    package_index = -1
    package_phase = 0
    package_target = false
    package_rollback = false
}

// Validating includes the module capability allowlist and identity handshake.
CellsValidatePackage :: (index: s32, bytes: string) -> bool #foreign c;

PackageTrialKey :: (prefix: string, index: s32) -> string {
    return PackageText(prefix, PackageName(index))
}

PackageStoreTrialText :: (key: string, value: string) {
    bytes: [65]u8
    unused AppCopyText(value, bytes[:])
    unused SettingsStoreText(key, bytes[:])
}

// A downloaded package that three starts in a row never proved is set aside
// for the bundled one until a different release arrives, so a release that
// crashes at startup cannot keep the app from opening. Call this after
// PackageInstalledBytes returned the package for use.
PackageTrialAllows :: (index: s32) -> bool {
    if index < 0 || index >= PackageSlots {
        return false
    }
    hash := TextFromCString(*package_cached_releases[index].hash[0])
    good_key := PackageTrialKey("package_good_", index)
    bad_key := PackageTrialKey("package_bad_", index)
    trial_key := PackageTrialKey("package_trial_", index)
    starts_key := PackageTrialKey("package_trial_starts_", index)
    defer {
        PackageFree(good_key);
        PackageFree(bad_key);
        PackageFree(trial_key);
        PackageFree(starts_key)
    }
    // Without a release identity there is nothing to track.
    if hash.count == 0 {
        return true
    }
    if PackageSettingText(bad_key) == hash {
        package_versions[index][0] = cast(u8)0
        return false
    }
    if PackageSettingText(good_key) == hash || package_trial_counted[index] {
        return true
    }
    package_trial_counted[index] = true
    starts: s32 = 1
    if PackageSettingText(trial_key) == hash {
        starts = SettingsReadInt(starts_key, 0) + 1
    }
    if starts > PACKAGE_TRIAL_STARTS {
        PackageStoreTrialText(bad_key, hash)
        PackageStoreTrialText(trial_key, "")
        unused SettingsStoreInt(starts_key, 0)
        package_versions[index][0] = cast(u8)0
        return false
    }
    PackageStoreTrialText(trial_key, hash)
    unused SettingsStoreInt(starts_key, starts)
    package_trials_open = true
    return true
}

// Packages on trial become good once the app has run with them for a while.
PackageTrialsProve :: (now: s32) {
    if !package_trials_open || now - package_started_at < PACKAGE_TRIAL_SECONDS {
        return
    }
    package_trials_open = false
    for index: cast(s32)0..cast(s32)(PackageSlots - 1) {
        trial_key := PackageTrialKey("package_trial_", index)
        good_key := PackageTrialKey("package_good_", index)
        defer {
            PackageFree(trial_key);
            PackageFree(good_key)
        }
        trial := PackageSettingText(trial_key)
        if trial.count > 0 {
            PackageStoreTrialText(good_key, trial)
            PackageStoreTrialText(trial_key, "")
        }
    }
}

PackageCheckDue :: (now: s32) -> bool {
    if package_last_check < 0 {
        package_last_check = SettingsReadInt("apps_last_update_check", 0)
    }
    if now - package_hint_read_at >= 60 {
        package_hint_read_at = now
        package_sequence_hint = SettingsReadInt("package_sequence_hint", 0)
    }
    launch := !package_launch_checked
    package_launch_checked = true
    elapsed := now - package_last_check
    return elapsed >= 86400 || (launch && elapsed >= 3600) ||
    (package_sequence_hint > 0 && elapsed >= 600 && package_sequence_hint > PackageSequence(0))
}

PackagePump :: (desired: s32, now: s32) {
    if DataTemporary() {
        return
    }
    if !package_initialized {
        PackageInitialize()
    }
    if package_started_at == 0 && now > 0 {
        package_started_at = now
    }
    PackageTrialsProve(now)
    if package_index < 0 {
        if PackagePublisherConfigured() && now > 0 &&
        PackageCheckDue(now) {
            for index: cast(s32)0..cast(s32)(PackageSlots - 1) {
                if PackageWanted(index, desired) && !package_requested[index] {
                    package_requested[index] = true
                    package_requested_automatic[index] = PackageAutomaticEnabled()
                    package_requested_check_only[index] = !PackageAutomaticEnabled() || PackageRollbackPinned(index)
                }
            }
            unused SettingsStoreInt("apps_last_update_check", now)
            package_last_check = now
        }
        for index: cast(s32)0..cast(s32)(PackageSlots - 1) {
            if package_requested[index] {
                package_requested[index] = false
                package_automatic = package_requested_automatic[index]
                package_check_only = package_requested_check_only[index]
                package_target = package_requested_target[index]
                package_target_version = package_requested_version[index]
                package_target_digest = package_requested_digest[index]
                package_target_account = package_requested_account[index]
                package_target_identity = package_requested_identity[index]
                package_target_current = package_requested_current[index]
                package_requested_target[index] = false
                package_requested_check_only[index] = false
                package_requested_automatic[index] = false
                package_index = index
                package_status[index] = 1
                if package_target && (TextUntilNul(package_target_account[:]) != PackageAccount() ||
                    TextUntilNul(package_target_identity[:]) != PackageID(index) ||
                    TextUntilNul(package_target_current[:]) != PackageVersion(index)) {
                    PackageFree(package_requested_retained[index])
                    package_requested_retained[index] = ""
                    PackageFinish(false)
                    return
                }
                package_rollback = package_requested_retained[index].count > 0
                if package_rollback {
                    package_metadata = package_requested_retained[index]
                    package_requested_retained[index] = ""
                    package_release = PackageTrustedRelease(package_metadata, index)
                    if !package_release.valid || package_release.sequence > PackageSequence(index) ||
                    TextUntilNul(package_release.version[:]) != TextUntilNul(package_target_version[:]) ||
                    TextUntilNul(package_release.hash[:]) != TextUntilNul(package_target_digest[:]) ||
                    PackageVersionCompare(TextUntilNul(package_release.version[:]), PackageVersion(index)) >= 0 {
                        PackageFinish(false)
                        return
                    }
                    PackageBeginPayload()
                    return
                }
                destination := PackagePath(index, ".download.json")
                defer {
                    PackageFree(destination)
                }
                if !PackageStartTransfer("/latest", destination) {
                    PackageFinish(false)
                    return
                }
                package_phase = 1
                return
            }
        }
        package_automatic = false
        unused PackageHistoryBegin()
        return
    }
    if package_target && (TextUntilNul(package_target_account[:]) != PackageAccount() ||
        TextUntilNul(package_target_identity[:]) != PackageID(package_index) ||
        TextUntilNul(package_target_current[:]) != PackageVersion(package_index)) {
        PackageFinish(false)
        return
    }
    downloading := package_download.status == FileDownloadStatus.Downloading
    status := FileDownloadPoll(*package_download)
    #if #defined(PLATFORM_WEB) {
        if downloading && status != FileDownloadStatus.Downloading {
            schedule_web_storage_sync(120, 0)
        }
    }
    if status == cast(FileDownloadStatus)Error {
        if package_phase == 3 { PackageHistoryComplete(package_index) }
        PackageFinish(false);
        return
    }
    if status != cast(FileDownloadStatus)Ready {
        return
    }
    if package_phase == 3 {
        path := PackagePath(package_index, ".history.download.json")
        text := PackageRead(path, 262144)
        if TextUntilNul(package_history_requested_id[package_index][:]) == PackageID(package_index) {
            unused PackageHistoryAccept(package_index, text)
        }
        PackageFree(text)
        unused RemoveFile(path)
        PackageFree(path)
        PackageHistoryComplete(package_index)
        PackageFinish(true)
        return
    }
    if package_phase == 1 {
        metadata_path := PackagePath(package_index, ".download.json")
        defer {
            PackageFree(metadata_path);
            unused RemoveFile(metadata_path)
        }
        package_metadata = PackageRead(metadata_path, 65536)
        public_key: [65]u8
        public_key[0] = cast(u8)0
        if !PackageTrustedKey(package_metadata, package_index, public_key[:]) {
            index := package_index
            PackageFinish(false)
            package_status[index] = 4
            return
        }
        package_release = PackageParseRelease(package_metadata, package_index,
            TextFromCString(*public_key[0]))
        if !package_release.valid {
            PackageFinish(false);
            return
        }
        if package_target && (TextUntilNul(package_release.version[:]) != TextUntilNul(package_target_version[:]) ||
            TextUntilNul(package_release.hash[:]) != TextUntilNul(package_target_digest[:])) {
            PackageFinish(false)
            return
        }
        bad_key := PackageTrialKey("package_bad_", package_index)
        set_aside := PackageSettingText(bad_key) == TextFromCString(*package_release.hash[0])
        PackageFree(bad_key)
        if set_aside {
            PackageFinish(true)
            return
        }
        if PackageBundledSequence(package_index) > 0 &&
        PackageVersionCompare(TextFromCString(*package_release.version[0]),
            PackageFallbackVersion(package_index)) < 0 {
            PackageFinish(false)
            return
        }
        sequence := PackageSequence(package_index)
        if package_release.sequence < sequence {
            PackageFinish(false);
            return
        }
        if package_release.sequence == sequence {
            hash_key := PackageText("package_hash_", PackageName(package_index))
            defer {
                PackageFree(hash_key)
            }
            expected := PackageSettingText(hash_key)
            if expected.count == 0 {
                PackageFinish(true)
                return
            }
            if expected != TextFromCString(*package_release.hash[0]) {
                PackageFinish(false);
                return
            }
            usable := PackageInstalledMatches(package_index, TextFromCString(*package_release.hash[0])) &&
                PackageVersion(package_index) == TextUntilNul(package_release.version[:])
            if usable {
                PackageFinish(true);
                return
            }
            // Repair a missing/corrupt cache only with the same signed hash.
        }
        // Availability checks fetch and verify metadata only. Disabled
        // automatic updates never download or replace an app payload.
        package_available_releases[package_index] = package_release
        unused CopyCString(PackageID(package_index), package_available_ids[package_index][:])
        if package_check_only {
            PackageFinish(true)
            return
        }
        PackageBeginPayload()
        return
    }
    path := PackagePath(package_index, ".download.zib")
    defer {
        PackageFree(path);
        unused RemoveFile(path)
    }
    bytes := PackageRead(path, PackageMaximumBytes)
    defer {
        PackageFree(bytes)
    }
    if !PackageVerifyBytes(bytes, package_release) ||
    !CellsValidatePackage(package_index, bytes) {
        PackageFinish(false);
        return
    }
    immutable := PackagePayloadPath(package_index,
        TextFromCString(*package_release.hash[0]))
    pointer := PackagePath(package_index, ".current.json")
    defer {
        PackageFree(immutable);
        PackageFree(pointer)
    }
    if !PackageWrite(immutable, bytes) ||
    (package_rollback && !PackageRollbackStore(package_index, package_release)) ||
    !PackageWrite(pointer, package_metadata) {
        PackageFinish(false)
        return
    }
    key := PackageSequenceKey(package_index)
    defer {
        PackageFree(key)
    }
    high_water := PackageSequence(package_index)
    if package_release.sequence >= high_water {
        unused SettingsStoreInt(key, package_release.sequence)
    }
    hash_key := PackageText("package_hash_", PackageName(package_index))
    defer {
        PackageFree(hash_key)
    }
    if package_release.sequence >= high_water {
        unused SettingsStoreText(hash_key, package_release.hash[:])
    }
    unused AppCopyText(TextFromCString(*package_release.version[0]), package_versions[package_index][:])
    package_revision += 1
    PackageFinish(true)
}

// Only verified, compatible node metadata may make an update badge appear.
PackageUpdateAvailable :: (index: s32) -> bool {
    if index < 0 || index >= PackageSlots {
        return false
    }
    release := package_available_releases[index]
    return release.valid && TextUntilNul(package_available_ids[index][:]) == PackageID(index) &&
    (release.sequence > PackageSequence(index) || PackageHighWaterMatches(index, release)) &&
    PackageVersionCompare(TextUntilNul(release.version[:]), PackageVersion(index)) > 0
}

PackageHighWaterMatches :: (index: s32, release: PackageRelease) -> bool {
    if release.sequence != PackageSequence(index) { return false }
    key := PackageText("package_hash_", PackageName(index))
    defer { PackageFree(key) }
    return PackageSettingText(key) == TextUntilNul(release.hash[:])
}

PackageBeginPayload :: () {
    suffix := PackageText("/", TextUntilNul(package_release.hash[:]))
    full_suffix := PackageText(suffix, ".zib")
    destination := PackagePath(package_index, ".download.zib")
    defer {
        PackageFree(suffix)
        PackageFree(full_suffix)
        PackageFree(destination)
    }
    if !PackageStartTransfer(full_suffix, destination) {
        PackageFinish(false)
        return
    }
    package_phase = 2
}

PackageAvailableVersion :: (index: s32) -> string {
    if !PackageUpdateAvailable(index) {
        return ""
    }
    return TextUntilNul(package_available_releases[index].version[:])
}

PackageAvailableDigest :: (index: s32) -> string {
    if !PackageUpdateAvailable(index) { return "" }
    return TextUntilNul(package_available_releases[index].hash[:])
}
