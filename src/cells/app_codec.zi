        if field_at >= 0 {
            data.name = TextFromBytes(BytesFromPointer(value.fields[field_at].value.data, cast(u64)value.fields[field_at].value.length))
        }
    }
    {
        field_at := HostFieldAt(value, 1, "icon")
        if field_at >= 0 {
            data.icon = cast(s32)value.fields[field_at].value.integer
        }
    }
    {
        field_at := HostFieldAt(value, 2, "halves")
        if field_at >= 0 {
            data.halves = cast(s64)value.fields[field_at].value.integer
        }
    }
    {
        field_at := HostFieldAt(value, 3, "day")
        if field_at >= 0 {
            data.day = TextFromBytes(BytesFromPointer(value.fields[field_at].value.data, cast(u64)value.fields[field_at].value.length))
        }
    }
    return data
}

WidgetValidHabitsShopActivity :: (value: HostValue) -> bool {
    if value.kind != cast(s32)HostRecord || TextFromCString(value.type_name) != "HabitsShopActivity" ||
    value.field_count > cast(usize)HOST_FIELD_LIMIT ||
    (value.field_count > cast(usize)0 && value.fields == null) { return false }
    {
        field_at := HostFieldAt(value, 0, "name")
        if field_at >= 0 {
            if !HostScalarValid(value.fields[field_at].value, "string", cast(s32)HostString) { return false }
        }
    }
    {
        field_at := HostFieldAt(value, 1, "icon")
        if field_at >= 0 {
            if !HostScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) { return false }
        }
    }
    {
        field_at := HostFieldAt(value, 2, "halves")
        if field_at >= 0 {
            if !HostScalarValid(value.fields[field_at].value, "s64", cast(s32)HostInteger) { return false }
        }
    }
    {
        field_at := HostFieldAt(value, 3, "day")
        if field_at >= 0 {
            if !HostScalarValid(value.fields[field_at].value, "string", cast(s32)HostString) { return false }
        }
    }
    return true
}
