// The account's media pass, after each good sync: the photos of the
// account's entity data (entity_photos.zi) travel between this device and
// the account's nodes as sealed chunks, one request per chunk, and the old
// copies of photos that moved there go.
//
// - Chunks go to every node in the account's node list whose photo upload
//   is on (sync_node_<sha>.media_upload, Profile › Data), not only the sync
//   node. A chunk this device has goes to each such node it is not known on
//   yet (diary_blobs), so the same picture uploads once per node. Once all
//   of a photo's chunks, or of its preview, are on a node, its record names
//   them. Each pass starts with the node where the previous one stopped, so
//   every node makes progress within the pass's limit.
// - A photo whose record names its chunks and whose file is not on this
//   device is downloaded: from the sync node first, then the other nodes in
//   list order, chunk by chunk. A 404 moves on to the next node; a chunk
//   found anywhere is remembered on that node. Previews always download;
//   originals when wanted on this device (media_store.zi), such as when
//   Photos opens one, and when a photo has no preview.
// - Released versions sealed each Diary photo and library photo as one old
//   copy at /api/v1/blobs/inbe/ (diary_records.zi). A photo that has not
//   moved to the entity data yet and whose bytes are not on this device
//   gets its old copy downloaded, so it can move (media_diary_photos.zi).
//   Once it moved and the sync node confirmed its record and chunks, the
//   pass downloads every chunk of the photo and its preview back from the
//   sync node and checks them against their hashes. Only then do its old
//   records name it ("photo"), and its old copies are deleted from every
//   node of the account. Any failure keeps the old copy for a later pass,
//   and so does a node that cannot delete yet (405).
//
// Nothing here stops a photo from saving: a node without photo upload, or
// one that is full (413), only keeps its chunks off that node. The host
// sends each request on the node's own media session and passes the answer
// back, and ends the pass with DiaryBlobPassEnd.
#import "byte_text_linux"
#import "vec"
#import "text"
#import "json_scan"
#import "text_buffer"
#import "keys"
#import "crypto"
DaochiEntity :: #import "daochi_client/entity";
#import, file "diary_records.zi";
#import, file "diary_store.zi";
#import, file "entity_photos.zi";
#import, file "media_store.zi";
#import, file "package_files.zi";
#import, file "../storage/cell_records.zi";
#import, file "../storage/entity_records.zi";
#import, file "../storage/media_records.zi";
#import, file "../storage/storage_core.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../storage/sync_record_crypto.zi";
#import, file "../storage/sqlite.zi";
#import, file "../storage/db.zi";
#import, file "../storage/state.zi";
#import, file "../storage/paths.zi";
#import, file "../storage/sync_nodes.zi";
#import, file "../storage/sync_node_storage.zi";
#import, file "../app/text_buffers.zi";

// One pass after a sync moves at most this many files and bytes, so a sync
// is never held up for long; the next sync continues. Deletes carry no
// bytes and have their own limit.
DIARY_BLOB_PASS_FILES :: 8
DIARY_BLOB_PASS_BYTES :: 33554432
DIARY_BLOB_PASS_DELETES :: 32
DIARY_BLOB_PASS_JOBS :: DIARY_BLOB_PASS_FILES + DIARY_BLOB_PASS_DELETES
DIARY_BLOB_RECORD_KEY :: 181
DIARY_BLOB_NODE_ADDRESS :: 256
DIARY_BLOB_PRIVATE_KEY :: (ACCOUNT_PRIVATE_KEY_HEX_SIZE - 1) / 2

// A photo's chunks, or its preview's, to a node.
DIARY_BLOB_UPLOAD :: 1
// A photo's chunks, or its preview's, from the account's nodes.
DIARY_BLOB_DOWNLOAD :: 2
// A released version's old copy, from the account's nodes.
DIARY_BLOB_OLD_DOWNLOAD :: 3
// A released version's old copy, deleted from a node.
DIARY_BLOB_OLD_DELETE :: 4
// A moved photo's chunks, or its preview's, downloaded back from the sync
// node and checked, before its old copy goes.
DIARY_BLOB_VERIFY :: 5

diary_blobs_c :: #system_library "c";
DiaryAllocate :: (size: usize) -> *void #foreign diary_blobs_c "malloc";
DiaryRelease :: (pointer: *void) #foreign diary_blobs_c "free";

// Where the next pass starts uploading, on this device only.
DIARY_BLOB_NEXT_NODE_KEY :: "media_pass_next_node"

DiaryBlobJob :: struct {
    kind: s32
    // entity.photos.<sha256> for a photo's chunks. For an old copy, the
    // record that names it: cell.diary.file.<name>, cell.media.<sha256> or
    // cell.media.preview.<sha256>.
    key: [DIARY_BLOB_RECORD_KEY]u8
    // The photo's preview rather than the photo.
    preview: bool
    // The node an upload or delete goes to; for a download, the node to
    // ask next.
    node: s32
    // The next chunk to move.
    chunk: s32
    // The old copy a delete removes.
    blob: [65]u8
}

DiaryBlobPass :: struct {
    // The sync node first, then the account's other nodes in list order,
    // each by its normalized address.
    nodes: [SYNC_NODE_LIMIT][DIARY_BLOB_NODE_ADDRESS]u8
    node_count: s32
    // The node refused an upload for room, or failed; it gets no more
    // uploads in this pass.
    stopped: [SYNC_NODE_LIMIT]bool
    // The node cannot delete old copies now.
    deletes_stopped: [SYNC_NODE_LIMIT]bool
    jobs: [DIARY_BLOB_PASS_JOBS]DiaryBlobJob
    count: s32
    files: s32
    next: s32
    // The chunks the current upload sealed so far.
    sealed: [ENTITY_PHOTO_LOCAL_CHUNKS]EntityChunk
    // The plain bytes the current download opened so far.
    received: *u8
    received_size: s64
}

// One request: PUT stores body at path on the node, GET answers with what
// is stored there, which needs answer_bytes of room, and DELETE removes it.
DiaryBlobRequest :: struct {
    kind: s32
    key: [DIARY_BLOB_RECORD_KEY]u8
    node: [DIARY_BLOB_NODE_ADDRESS]u8
    node_index: s32
    method: string
    path: [128]u8
    body: string
    answer_bytes: s64
    // The chunk's or old copy's address.
    blob: [65]u8
    // The content a chunk belongs to, or the old copy's plain bytes.
    preview: bool
    chunk: s32
    hash: [65]u8
    size: s64
    sealed_size: s64
    // An old copy's own key.
    key_hex: [65]u8
}

DiaryBlobEntriesSQL :: #string SQL_END
SELECT key,value FROM settings
WHERE user_id=(SELECT id FROM users LIMIT 1)
  AND ((key GLOB 'cell.diary.file.*' AND key NOT GLOB '*.json')
    OR (key GLOB 'cell.media.*' AND (length(key)=75 OR length(key)=83)))
  AND json_valid(value)
ORDER BY updated_at DESC
SQL_END;

DiaryBlobEntitySQL :: #string SQL_END
SELECT key,value FROM settings
WHERE user_id=(SELECT id FROM users LIMIT 1)
  AND key GLOB 'entity.photos.*' AND length(key)=78 AND json_valid(value)
ORDER BY updated_at DESC
SQL_END;

// Old copies of photos that moved: their records name the entity record.
DiaryBlobMovedSQL :: #string SQL_END
SELECT json_extract(value,'$.blob') FROM settings
WHERE user_id=(SELECT id FROM users LIMIT 1)
  AND ((key GLOB 'cell.diary.file.*' AND key NOT GLOB '*.json')
    OR (key GLOB 'cell.media.*' AND (length(key)=75 OR length(key)=83)))
  AND json_valid(value) AND length(json_extract(value,'$.photo'))=64
  AND length(json_extract(value,'$.blob'))=64
ORDER BY updated_at DESC
SQL_END;

DiaryBlobKnown :: (table_sql: string, node: string, blob: string) -> bool {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), table_sql, -1, *statement, null) != SQLITE_OK {
        return false
    }
    defer { SqliteFinalize(statement) }
    unused bind_text(statement, 1, node)
    unused bind_text(statement, 2, blob)
    return SqliteStep(statement) == SQLITE_ROW
}

DiaryBlobOnNode :: (node: string, blob: string) -> bool {
    return DiaryBlobKnown("SELECT 1 FROM diary_blobs WHERE node=?1 AND blob=?2", node, blob)
}

DiaryBlobDeletedOn :: (node: string, blob: string) -> bool {
    return DiaryBlobKnown("SELECT 1 FROM old_copies_deleted WHERE node=?1 AND blob=?2", node, blob)
}

DiaryBlobRun :: (sql: string, node: string, blob: string) {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), sql, -1, *statement, null) != SQLITE_OK {
        return
    }
    unused bind_text(statement, 1, node)
    unused bind_text(statement, 2, blob)
    unused SqliteStep(statement)
    SqliteFinalize(statement)
}

DiaryBlobRemember :: (node: string, blob: string) {
    DiaryBlobRun("INSERT OR IGNORE INTO diary_blobs(node,blob) VALUES(?1,?2)", node, blob)
}

// The node deleted an old copy, or never had it.
DiaryBlobDeleted :: (node: string, blob: string) {
    DiaryBlobRun("INSERT OR IGNORE INTO old_copies_deleted(node,blob) VALUES(?1,?2)", node, blob)
    DiaryBlobRun("DELETE FROM diary_blobs WHERE node=?1 AND blob=?2", node, blob)
}

// The Diary file a cell.diary.file.<name> key names, or empty.
DiaryBlobDiaryName :: (key: string) -> string {
    prefix := "cell.diary.file."
    if key.count <= prefix.count || key[:prefix.count] != prefix ||
    !DiaryStoreNameValid(key[prefix.count:]) {
        return ""
    }
    return key[prefix.count:]
}

// The local file that holds an old copy's plain bytes, to free with
// PackageFree, or empty for a key that names no copy.
DiaryBlobLocalPath :: (key: string) -> string {
    name := DiaryBlobDiaryName(key)
    if name.count > 0 {
        return DiaryStorePath(name)
    }
    hash := MediaItemKeyHash(key)
    if hash.count > 0 {
        return MediaPath(hash, false)
    }
    hash = MediaPreviewKeyHash(key)
    if hash.count > 0 {
        return MediaPath(hash, true)
    }
    return ""
}

DiaryBlobDirectory :: (key: string) -> string {
    if DiaryBlobDiaryName(key).count > 0 {
        return DiaryStoreDirectory()
    }
    return MediaDirectory()
}

DiaryBlobEntryRead :: (key: string) -> string {
    if DiaryBlobDiaryName(key).count > 0 {
        return CellRecordRead(key)
    }
    return MediaRecordRead(key)
}

// Whether a photo of this hash is in the account's entity data.
DiaryBlobMoved :: (hash: string) -> bool {
    record := MediaEntityRecord(hash)
    defer { PackageFree(record) }
    return EntityPhotoContent(record).valid
}

DiaryBlobAdd :: (pass: *DiaryBlobPass, kind: s32, key: string, preview: bool, node: s32) {
    if pass.count >= DIARY_BLOB_PASS_JOBS {
        return
    }
    job := *pass.jobs[pass.count]
    job.* = DiaryBlobJob.{}
    job.kind = kind
    job.preview = preview
    job.node = node
    unused AppCopyText(key, job.key[:])
    pass.count += 1
    if kind != DIARY_BLOB_OLD_DELETE {
        pass.files += 1
    }
}

DiaryBlobFull :: (pass: *DiaryBlobPass, bytes: s64) -> bool {
    return pass.files >= DIARY_BLOB_PASS_FILES || bytes >= DIARY_BLOB_PASS_BYTES ||
    pass.count >= DIARY_BLOB_PASS_JOBS
}

// Copies the address of the pass's node `index` into output.
DiaryBlobNode :: (pass: *DiaryBlobPass, index: s32, output: []u8) -> bool {
    output[0] = cast(u8)0
    if index < 0 || index >= pass.node_count {
        return false
    }
    return AppCopyText(TextUntilNul(pass.nodes[index][:]), output)
}

// The sync node first, then the account's other nodes in list order.
DiaryBlobNodes :: (pass: *DiaryBlobPass, active: string) {
    if SyncNodeAddress(active, pass.nodes[0][:]) {
        pass.node_count = 1
    }
    count := SyncNodeCount()
    index: s32 = 0
    while index < count && pass.node_count < SYNC_NODE_LIMIT {
        address := SyncNodeAt(index)
        normalized: [DIARY_BLOB_NODE_ADDRESS]u8
        known := false
        if SyncNodeAddress(address, normalized[:]) {
            seen: s32 = 0
            while seen < pass.node_count {
                if TextUntilNul(pass.nodes[seen][:]) == TextUntilNul(normalized[:]) {
                    known = true
                }
                seen += 1
            }
            if !known {
                pass.nodes[pass.node_count] = normalized
                pass.node_count += 1
            }
        }
        PackageFree(address)
        index += 1
    }
}

// Old copies of moved photos, deleted from every node that has not
// deleted them yet.
DiaryBlobPlanDeletes :: (pass: *DiaryBlobPass) {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), DiaryBlobMovedSQL, -1, *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    deletes: s32 = 0
    while deletes < DIARY_BLOB_PASS_DELETES && SqliteStep(statement) == SQLITE_ROW {
        blob := AppTextFromCString(SqliteColumnText(statement, 0), 65)
        if !MediaHashValid(blob) {
            continue
        }
        for node: cast(s32)0..pass.node_count - 1 {
            if deletes >= DIARY_BLOB_PASS_DELETES {
                break
            }
            if DiaryBlobDeletedOn(TextUntilNul(pass.nodes[node][:]), blob) {
                continue
            }
            DiaryBlobAdd(pass, DIARY_BLOB_OLD_DELETE, "", false, node)
            unused AppCopyText(blob, pass.jobs[pass.count - 1].blob[:])
            deletes += 1
        }
    }
}

// Moved photos whose record the sync node has, while their old records
// still lack their pointer: each content not checked yet comes back once
// from the sync node, so the old copy only goes once the new one is known
// whole there.
DiaryBlobPlanVerifies :: (pass: *DiaryBlobPass, bytes: *s64) {
    statement: *void
    if SqlitePrepareText(storage_db_handle(), DiaryBlobEntriesSQL, -1, *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    sync_node := TextUntilNul(pass.nodes[0][:])
    while !DiaryBlobFull(pass, bytes.*) && SqliteStep(statement) == SQLITE_ROW {
        record_key := AppTextFromCString(SqliteColumnText(statement, 0), DIARY_BLOB_RECORD_KEY)
        entry := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
        photo_hash := MediaPreviewKeyHash(record_key)
        if photo_hash.count == 0 {
            photo_hash = MediaItemKeyHash(record_key)
        }
        if photo_hash.count == 0 {
            photo_hash = DiaryEntryHash(entry)
        }
        if FieldAt(entry, 0, "photo") >= 0 || photo_hash.count != 64 {
            continue
        }
        record := MediaEntityRecord(photo_hash)
        if record.count == 0 || !EntityPhotoAcknowledged(photo_hash, record) {
            PackageFree(record)
            continue
        }
        parts: [2]EntityContent = .[EntityPhotoContent(record), EntityPreviewContent(record)]
        PackageFree(record)
        entity_key := EntityPhotoKey(photo_hash)
        for part: cast(s32)0..1 {
            content := parts[part]
            if !content.valid || content.chunk_count == 0 || content.chunk_count > ENTITY_PHOTO_LOCAL_CHUNKS ||
            EntityContentVerified(content, sync_node) || DiaryBlobFull(pass, bytes.*) ||
            DiaryBlobPlanned(pass, DIARY_BLOB_VERIFY, entity_key, part == 1) {
                continue
            }
            DiaryBlobAdd(pass, DIARY_BLOB_VERIFY, entity_key, part == 1, 0)
            bytes.* += content.size
        }
        PackageFree(entity_key)
    }
}

// Whether the pass already has this job.
DiaryBlobPlanned :: (pass: *DiaryBlobPass, kind: s32, key: string, preview: bool) -> bool {
    for index: cast(s32)0..pass.count - 1 {
        job := *pass.jobs[index]
        if job.kind == kind && job.preview == preview && TextUntilNul(job.key[:]) == key {
            return true
        }
    }
    return false
}

// Whether this device should fetch the content: a preview always, an
// original when wanted here or when its photo has no preview. Content this
// version could not keep stays on the node.
DiaryBlobWanted :: (content: EntityContent, preview: bool, has_preview: bool, wanted: string) -> bool {
    if content.chunk_count == 0 || content.chunk_count > ENTITY_PHOTO_LOCAL_CHUNKS ||
    content.size > DIARY_FILE_LIMIT || TextUntilNul(content.format[:]).count == 0 {
        return false
    }
    return preview || !has_preview || MediaWantedIn(wanted, TextUntilNul(content.hash[:]))
}

// Downloads, from the sync node first: the entity data's photos, then old
// copies of photos that have not moved yet and are not on this device.
DiaryBlobPlanDownloads :: (pass: *DiaryBlobPass, wanted: string, opening: bool, bytes: *s64) {
    statement: *void
    if opening && SqlitePrepareText(storage_db_handle(), DiaryBlobEntitySQL, -1, *statement, null) == SQLITE_OK {
        while !DiaryBlobFull(pass, bytes.*) && SqliteStep(statement) == SQLITE_ROW {
            record_key := AppTextFromCString(SqliteColumnText(statement, 0), DIARY_BLOB_RECORD_KEY)
            record := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
            hash := EntityPhotoKeyHash(record_key)
            photo := EntityPhotoContent(record)
            preview := EntityPreviewContent(record)
            if !photo.valid || TextFromBytes(photo.hash[:64]) != hash {
                continue
            }
            parts: [2]EntityContent = .[photo, preview]
            for part: cast(s32)0..1 {
                content := parts[part]
                if !content.valid || DiaryBlobFull(pass, bytes.*) ||
                !DiaryBlobWanted(content, part == 1, preview.valid, wanted) {
                    continue
                }
                path := MediaPath(hash, part == 1)
                local := PackageFileSize(path)
                PackageFree(path)
                if local != content.size {
                    DiaryBlobAdd(pass, DIARY_BLOB_DOWNLOAD, record_key, part == 1, 0)
                    bytes.* += content.size
                }
            }
        }
        SqliteFinalize(statement)
    }
    if SqlitePrepareText(storage_db_handle(), DiaryBlobEntriesSQL, -1, *statement, null) != SQLITE_OK {
        return
    }
    defer { SqliteFinalize(statement) }
    while !DiaryBlobFull(pass, bytes.*) && SqliteStep(statement) == SQLITE_ROW {
        record_key := AppTextFromCString(SqliteColumnText(statement, 0), DIARY_BLOB_RECORD_KEY)
        entry := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
        media := DiaryMediaParse(entry)
        photo_hash := MediaPreviewKeyHash(record_key)
        if photo_hash.count == 0 {
            photo_hash = TextFromBytes(media.hash[:64])
        }
        if !DiaryMediaUploaded(media) || media.pointed || DiaryBlobMoved(photo_hash) {
            continue
        }
        path := DiaryBlobLocalPath(record_key)
        local := PackageFileSize(path)
        PackageFree(path)
        if local != media.size {
            DiaryBlobAdd(pass, DIARY_BLOB_OLD_DOWNLOAD, record_key, false, 0)
            bytes.* += media.size
        }
    }
}

// Uploads, one node after another, starting where the last pass stopped:
// each photo and preview this device has whose chunks the node lacks.
DiaryBlobPlanUploads :: (pass: *DiaryBlobPass, bytes: *s64) {
    first := storage_get_setting_int(DIARY_BLOB_NEXT_NODE_KEY, 0)
    if first < 0 || first >= pass.node_count {
        first = 0
    }
    round: s32 = 0
    while round < pass.node_count {
        node := (first + round) % pass.node_count
        address := TextUntilNul(pass.nodes[node][:])
        round += 1
        if !SyncNodeMediaUpload(address) {
            continue
        }
        if DiaryBlobFull(pass, bytes.*) {
            // The next pass starts with this node.
            storage_set_setting_int(DIARY_BLOB_NEXT_NODE_KEY, node)
            return
        }
        statement: *void
        if SqlitePrepareText(storage_db_handle(), DiaryBlobEntitySQL, -1, *statement, null) != SQLITE_OK {
            return
        }
        while !DiaryBlobFull(pass, bytes.*) && SqliteStep(statement) == SQLITE_ROW {
            record_key := AppTextFromCString(SqliteColumnText(statement, 0), DIARY_BLOB_RECORD_KEY)
            record := AppTextFromCString(SqliteColumnText(statement, 1), 65536)
            hash := EntityPhotoKeyHash(record_key)
            parts: [2]EntityContent = .[EntityPhotoContent(record), EntityPreviewContent(record)]
            for part: cast(s32)0..1 {
                content := parts[part]
                if !content.valid || content.size > DIARY_FILE_LIMIT || DiaryBlobFull(pass, bytes.*) ||
                (content.chunk_count > 0 && EntityContentOnNode(content, address)) {
                    continue
                }
                path := MediaPath(hash, part == 1)
                local := PackageFileSize(path)
                PackageFree(path)
                if local == content.size {
                    DiaryBlobAdd(pass, DIARY_BLOB_UPLOAD, record_key, part == 1, node)
                    bytes.* += content.size
                }
            }
        }
        SqliteFinalize(statement)
    }
}

// Chooses this pass's requests: deletes of old copies first, so a node has
// room for what moves, then downloads, so a photo shows on this device
// soon, then uploads to each node that takes photos and lacks them.
DiaryBlobPlan :: (pass: *DiaryBlobPass, active: string) -> bool {
    pass.* = DiaryBlobPass.{}
    // A delegate (Telegram) account plans too, but its requests are never
    // sent: the host sends copies for the account's owner only.
    if storage_db_handle() == null {
        return false
    }
    DiaryBlobNodes(pass, active)
    if pass.node_count == 0 {
        return false
    }
    private_key: [DIARY_BLOB_PRIVATE_KEY]u8
    sealing := storage_account_private_key(private_key[:]) > 0
    SecureWipe(*private_key[0], DIARY_BLOB_PRIVATE_KEY)
    wanted: [MEDIA_WANTED_MAX * 65 + 1]u8
    MediaWantedRead(wanted[:])
    bytes: s64 = 0
    DiaryBlobPlanDeletes(pass)
    if sealing {
        DiaryBlobPlanVerifies(pass, *bytes)
    }
    DiaryBlobPlanDownloads(pass, TextUntilNul(wanted[:]), sealing, *bytes)
    if sealing {
        DiaryBlobPlanUploads(pass, *bytes)
    }
    return pass.count > 0
}

DiaryBlobPath :: (request: *DiaryBlobRequest, app: string) {
    out: Vec(u8)
    BuilderPrint(*out, "/api/v1/blobs/%/%", app, TextFromBytes(request.blob[:64]))
    path := BuilderFinish(out)
    unused AppCopyText(path, request.path[:])
    PackageFree(path)
}

// The content an upload or download job moves, from its photo's record.
DiaryBlobContent :: (job: *DiaryBlobJob) -> EntityContent {
    record := MediaRecordRead(TextUntilNul(job.key[:]))
    defer { PackageFree(record) }
    content := ifx job.preview then EntityPreviewContent(record) else EntityPhotoContent(record)
    if !content.valid || content.size > DIARY_FILE_LIMIT {
        return EntityContent.{}
    }
    return content
}

// The record names the content's chunks once they are all on a node, so
// the account's other devices and apps can fetch them. A record that
// names chunks keeps them.
DiaryBlobChunksNamed :: (pass: *DiaryBlobPass, job: *DiaryBlobJob, content: EntityContent) {
    if content.chunk_count > 0 {
        return
    }
    key := TextUntilNul(job.key[:])
    record := MediaRecordRead(key)
    defer { PackageFree(record) }
    current := ifx job.preview then EntityPreviewContent(record) else EntityPhotoContent(record)
    if !current.valid || current.chunk_count > 0 || TextFromBytes(current.hash[:64]) != TextFromBytes(content.hash[:64]) {
        return
    }
    blobs := EntityBlobsJson(pass.sealed[:EntityChunkCount(content.size)])
    named := MediaRecordWith(record, ifx job.preview then "preview.blobs" else "blobs", blobs)
    if named.count > 0 {
        unused MediaRecordWrite(key, named)
    }
    PackageFree(blobs)
    PackageFree(named)
}

// Seals the job's next chunk the node lacks into a PUT, or names the
// content once every chunk is there; false when the job is done.
DiaryBlobUploadNext :: (pass: *DiaryBlobPass, job: *DiaryBlobJob, request: *DiaryBlobRequest) -> bool {
    content := DiaryBlobContent(job)
    if !content.valid || job.node < 0 || job.node >= pass.node_count || pass.stopped[job.node] {
        return false
    }
    hash := TextFromBytes(content.hash[:64])
    photo_hash := EntityPhotoKeyHash(TextUntilNul(job.key[:]))
    path := MediaPath(photo_hash, job.preview)
    data := PackageRead(path, DIARY_FILE_LIMIT)
    PackageFree(path)
    defer { PackageFree(data) }
    if !EntityContentMatches(content, data) {
        return false
    }
    node := TextUntilNul(pass.nodes[job.node][:])
    count := EntityChunkCount(content.size)
    if job.chunk == 0 {
        for index: cast(s32)0..ENTITY_PHOTO_LOCAL_CHUNKS - 1 {
            pass.sealed[index] = EntityChunk.{}
        }
    }
    descriptor := cast(*TextDescriptor)(*data)
    plain_bytes := BytesFromPointer(descriptor.data, cast(u64)data.count)
    while job.chunk < count {
        start := cast(s64)job.chunk * DaochiEntity.ENTITY_CHUNK_BYTES
        plain := EntityChunkPlain(content.size, job.chunk)
        sealed_size := plain + 16
        sealed := cast(*u8)DiaryAllocate(cast(usize)sealed_size)
        if sealed == null {
            return false
        }
        private_key: [DIARY_BLOB_PRIVATE_KEY]u8
        length := storage_account_private_key(private_key[:])
        made := length > 0 && DaochiEntity.SealEntityChunk(private_key[:length], ENTITY_PHOTOS_KIND, hash, cast(s64)job.chunk,
            plain_bytes[start:start + plain], BytesFromPointer(sealed, cast(u64)sealed_size)) == sealed_size
        SecureWipe(*private_key[0], DIARY_BLOB_PRIVATE_KEY)
        if !made {
            DiaryRelease(cast(*void)sealed)
            return false
        }
        chunk := *pass.sealed[job.chunk]
        storage_sha256_hex(sealed, sealed_size, *chunk.address[0])
        chunk.size = sealed_size
        // A chunk the record names must be the same chunk.
        if content.chunk_count > 0 && TextUntilNul(chunk.address[:]) != TextUntilNul(content.chunks[job.chunk].address[:]) {
            DiaryRelease(cast(*void)sealed)
            return false
        }
        if DiaryBlobOnNode(node, TextUntilNul(chunk.address[:])) {
            DiaryRelease(cast(*void)sealed)
            job.chunk += 1
            continue
        }
        request.method = "PUT"
        request.body = TextFromBytes(BytesFromPointer(sealed, cast(u64)sealed_size))
        request.blob = chunk.address
        request.chunk = job.chunk
        request.hash = content.hash
        request.size = content.size
        request.sealed_size = sealed_size
        unused AppCopyText(node, request.node[:])
        DiaryBlobPath(request, "entity")
        return true
    }
    DiaryBlobChunksNamed(pass, job, content)
    return false
}

// Prepares the next request of the job's next chunk to fetch; false when
// the job is done.
DiaryBlobDownloadNext :: (pass: *DiaryBlobPass, job: *DiaryBlobJob, request: *DiaryBlobRequest) -> bool {
    content := DiaryBlobContent(job)
    if !content.valid || content.chunk_count == 0 || content.chunk_count > ENTITY_PHOTO_LOCAL_CHUNKS ||
    job.node >= pass.node_count || job.chunk >= content.chunk_count {
        return false
    }
    if job.chunk == 0 && pass.received == null {
        pass.received = cast(*u8)DiaryAllocate(cast(usize)content.size)
        pass.received_size = 0
    }
    if pass.received == null {
        return false
    }
    unused DiaryBlobNode(pass, job.node, request.node[:])
    request.method = "GET"
    request.blob = content.chunks[job.chunk].address
    request.chunk = job.chunk
    request.hash = content.hash
    request.size = content.size
    request.sealed_size = content.chunks[job.chunk].size
    request.answer_bytes = request.sealed_size + 1
    DiaryBlobPath(request, "entity")
    return true
}

// Prepares an old copy's download from the job's node; false when there is
// nothing to fetch.
DiaryBlobOldDownloadNext :: (pass: *DiaryBlobPass, job: *DiaryBlobJob, request: *DiaryBlobRequest) -> bool {
    entry := DiaryBlobEntryRead(TextUntilNul(job.key[:]))
    media := DiaryMediaParse(entry)
    PackageFree(entry)
    if !DiaryMediaUploaded(media) || media.pointed || job.node >= pass.node_count {
        return false
    }
    unused DiaryBlobNode(pass, job.node, request.node[:])
    request.method = "GET"
    request.blob = media.blob
    request.key_hex = media.key
    request.hash = media.hash
    request.size = media.size
    request.answer_bytes = media.size + DIARY_BLOB_TAG + 1
    DiaryBlobPath(request, "inbe")
    return true
}

// The pass's job is done; it frees what a download held.
DiaryBlobJobDone :: (pass: *DiaryBlobPass) {
    if pass.received != null {
        SecureWipe(pass.received, pass.received_size)
        DiaryRelease(cast(*void)pass.received)
    }
    pass.received = null
    pass.received_size = 0
    pass.next += 1
}

// Prepares the pass's next request, or false when the pass is done.
DiaryBlobNext :: (pass: *DiaryBlobPass, request: *DiaryBlobRequest) -> bool {
    while pass.next < pass.count {
        job := *pass.jobs[pass.next]
        request.* = DiaryBlobRequest.{}
        request.kind = job.kind
        request.key = job.key
        request.preview = job.preview
        request.node_index = job.node
        ready := false
        if job.kind == DIARY_BLOB_OLD_DELETE {
            node := TextUntilNul(pass.nodes[job.node][:])
            blob := TextUntilNul(job.blob[:])
            if !pass.deletes_stopped[job.node] && !DiaryBlobDeletedOn(node, blob) {
                unused AppCopyText(node, request.node[:])
                request.method = "DELETE"
                request.blob = job.blob
                DiaryBlobPath(request, "inbe")
                ready = true
            }
        } else if job.kind == DIARY_BLOB_OLD_DOWNLOAD {
            ready = DiaryBlobOldDownloadNext(pass, job, request)
        } else if job.kind == DIARY_BLOB_DOWNLOAD || job.kind == DIARY_BLOB_VERIFY {
            ready = DiaryBlobDownloadNext(pass, job, request)
        } else {
            ready = DiaryBlobUploadNext(pass, job, request)
        }
        if ready {
            return true
        }
        DiaryBlobJobDone(pass)
    }
    return false
}

// A download that found nothing on this node asks the next one for the
// same chunk, or ends when every node was asked.
DiaryBlobAskNext :: (pass: *DiaryBlobPass) {
    if pass.next >= pass.count {
        return
    }
    pass.jobs[pass.next].node += 1
    if pass.jobs[pass.next].node >= pass.node_count {
        DiaryBlobJobDone(pass)
    }
}

// Writes fetched plain bytes to their file once they are the content.
DiaryBlobStore :: (key: string, path: string, data: string, check: EntityContent) -> bool {
    if !EntityContentMatches(check, data) {
        return false
    }
    directory := DiaryBlobDirectory(key)
    defer { PackageFree(directory) }
    if directory.count == 0 || storage_ensure_dir(directory) == 0 || !PackageWrite(path, data) {
        return false
    }
    diary_blob_generation += 1
    return true
}

// A chunk arrived: it joins what the job opened so far, and once every
// chunk is here the content is checked and saved.
DiaryBlobChunkArrived :: (pass: *DiaryBlobPass, request: *DiaryBlobRequest, answer: []u8) {
    job := *pass.jobs[pass.next]
    hash := TextFromBytes(request.hash[:64])
    plain := EntityChunkPlain(request.size, request.chunk)
    if pass.received == null || cast(s64)answer.count != request.sealed_size ||
    pass.received_size != cast(s64)request.chunk * DaochiEntity.ENTITY_CHUNK_BYTES {
        DiaryBlobJobDone(pass)
        return
    }
    private_key: [DIARY_BLOB_PRIVATE_KEY]u8
    length := storage_account_private_key(private_key[:])
    opened := length > 0 && DaochiEntity.OpenEntityChunk(private_key[:length], ENTITY_PHOTOS_KIND, hash, cast(s64)request.chunk,
        answer, BytesFromPointer(*pass.received[pass.received_size], cast(u64)plain)) == plain
    SecureWipe(*private_key[0], DIARY_BLOB_PRIVATE_KEY)
    if !opened {
        DiaryBlobJobDone(pass)
        return
    }
    node := TextUntilNul(request.node[:])
    DiaryBlobRemember(node, TextUntilNul(request.blob[:]))
    pass.received_size += plain
    job.chunk += 1
    if pass.received_size < request.size {
        return
    }
    check := EntityContent.{.valid = true, .hash = request.hash, .size = request.size}
    received := TextFromBytes(BytesFromPointer(pass.received, cast(u64)pass.received_size))
    if request.kind == DIARY_BLOB_VERIFY {
        if EntityContentMatches(check, received) {
            DiaryBlobRun("INSERT OR IGNORE INTO verified_contents(node,hash) VALUES(?1,?2)", node,
                TextFromBytes(request.hash[:64]))
            // The photo's old records may name it now (media_diary_photos.zi).
            diary_blob_generation += 1
        }
        DiaryBlobJobDone(pass)
        return
    }
    photo_hash := EntityPhotoKeyHash(TextUntilNul(request.key[:]))
    path := MediaPath(photo_hash, request.preview)
    unused DiaryBlobStore(TextUntilNul(request.key[:]), path, received, check)
    PackageFree(path)
    DiaryBlobJobDone(pass)
}

// An old copy arrived: the photo's bytes, checked against its record, land
// in its file so the photo can move.
DiaryBlobOldArrived :: (pass: *DiaryBlobPass, request: *DiaryBlobRequest, answer: []u8) {
    record_key := TextUntilNul(request.key[:])
    entry := DiaryBlobEntryRead(record_key)
    media := DiaryMediaParse(entry)
    PackageFree(entry)
    DiaryBlobJobDone(pass)
    if !DiaryMediaUploaded(media) || TextFromBytes(media.blob[:64]) != TextFromBytes(request.blob[:64]) {
        return
    }
    plain := DiaryBlobOpen(media, answer)
    if plain.count == 0 {
        return
    }
    path := DiaryBlobLocalPath(record_key)
    check := EntityContent.{.valid = true, .hash = media.hash, .size = media.size}
    if DiaryBlobStore(record_key, path, plain, check) {
        DiaryBlobRemember(TextUntilNul(request.node[:]), TextFromBytes(request.blob[:64]))
    }
    PackageFree(path)
    PackageFree(plain)
}

// Applies one answer. False stops the pass: the account cannot move copies
// now. A node that fails only stops its own uploads or deletes.
DiaryBlobFinish :: (pass: *DiaryBlobPass, request: *DiaryBlobRequest, status: s32,
    answer: []u8) -> bool {
    node := TextUntilNul(request.node[:])
    index := request.node_index
    known_node := index >= 0 && index < pass.node_count
    if request.kind == DIARY_BLOB_UPLOAD {
        PackageFree(request.body)
        request.body = ""
        if status == 413 {
            unused SyncNodeStorageRecordFull(node, TextFromBytes(answer))
        }
        if status != 204 && status != 200 {
            if known_node {
                pass.stopped[index] = true
            }
            return true
        }
        DiaryBlobRemember(node, TextFromBytes(request.blob[:64]))
        if pass.next >= pass.count {
            return true
        }
        // Once its last chunk is there, the record names them all.
        job := *pass.jobs[pass.next]
        job.chunk += 1
        content := DiaryBlobContent(job)
        if content.valid && job.chunk >= EntityChunkCount(content.size) {
            DiaryBlobChunksNamed(pass, job, content)
            DiaryBlobJobDone(pass)
        }
        return true
    }
    if request.kind == DIARY_BLOB_OLD_DELETE {
        // A node that deleted the copy, or never had it, says so the same.
        if status == 204 || status == 200 || status == 404 {
            DiaryBlobDeleted(node, TextFromBytes(request.blob[:64]))
        } else if known_node {
            pass.deletes_stopped[index] = true
        }
        DiaryBlobJobDone(pass)
        return true
    }
    // A check asks the sync node alone; one that fails waits for a later
    // pass, keeping the old copy.
    if request.kind == DIARY_BLOB_VERIFY && status != 200 {
        DiaryBlobJobDone(pass)
        return true
    }
    // A download that found nothing on this node asks the next one.
    if status != 200 {
        DiaryBlobAskNext(pass)
        return true
    }
    if request.kind == DIARY_BLOB_DOWNLOAD || request.kind == DIARY_BLOB_VERIFY {
        DiaryBlobChunkArrived(pass, request, answer)
    } else {
        DiaryBlobOldArrived(pass, request, answer)
    }
    return true
}

// Frees what a request still holds, after its answer or without one.
DiaryBlobAbandon :: (request: *DiaryBlobRequest) {
    PackageFree(request.body)
    request.body = ""
}

// A request that got no answer: an upload stops that node's uploads for
// this pass, a delete its deletes, and a download asks the next node.
DiaryBlobFailed :: (pass: *DiaryBlobPass, request: *DiaryBlobRequest) {
    if request.kind == DIARY_BLOB_VERIFY {
        DiaryBlobJobDone(pass)
        return
    }
    if request.kind == DIARY_BLOB_DOWNLOAD || request.kind == DIARY_BLOB_OLD_DOWNLOAD {
        DiaryBlobAskNext(pass)
        return
    }
    index := request.node_index
    if index < 0 || index >= pass.node_count {
        return
    }
    if request.kind == DIARY_BLOB_OLD_DELETE {
        pass.deletes_stopped[index] = true
        DiaryBlobJobDone(pass)
        return
    }
    pass.stopped[index] = true
}

// Ends the pass, freeing what a download held.
DiaryBlobPassEnd :: (pass: *DiaryBlobPass) {
    if pass.received != null {
        SecureWipe(pass.received, pass.received_size)
        DiaryRelease(cast(*void)pass.received)
    }
    pass.received = null
    pass.received_size = 0
    pass.next = pass.count
}
