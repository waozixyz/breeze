// The same harness runs in standalone Inbe and its Harmony-hosted window.
// Only completed authenticated requests reach app tools, on the main thread.
// Nothing here reaches the network unless lumi_connection.zi allows it:
// offline, or without the agreement, Lumi sends no request of any kind.
#import "json_scan"
#import "text"
#import "vec"
#import "text_buffer"
#import "byte_text_linux"
#import "auth"
#import "keys"
#import "net_http"
#import, file "lumi_connection.zi";
#import, file "lumi_types.zi";
#import, file "lumi_ui_types.zi";
#import, file "lumi_response.zi";
#import, file "lumi_tool_budget.zi";
#import, file "lumi_telegram.zi";
#import, file "module_host.zi";
#import, file "package_files.zi";
#import, file "../screens/lumi_screen.zi";
#import, file "../app/app_nav_state.zi";
#import, file "../app/assets.zi";
#import, file "../practices/practice_actions.zi";
#import, file "../storage/sync_state.zi";
#import, file "../storage/storage_settings.zi";
#import, file "../storage/cell_records.zi";
#import, file "../storage/state.zi";
#import, file "../storage/delegate_store.zi";
#import, file "app_tools.zi";
#import, file "feedback_store.zi";
#import, file "lumi_store.zi";
#import, file "../storage/sync_async.zi";
#import, file "../platform/network_transport.zi";
#import, file "../app/locale.zi";
#import, file "../app/app_types.zi";
#import, file "../app/text_buffers.zi";

lumi_online_operation: StoredOperation;
lumi_online_session: Session;
lumi_online_transfer: NetworkTransfer;
lumi_online_response: [65536]u8;
lumi_online_owner: [64]u8;
lumi_online_messages: string;
lumi_online_queued: bool;
// A message sent this frame is drawn, with Lumi's typing dots, before its
// request is prepared, so Enter shows it at once.
lumi_online_fresh: bool;
lumi_online_stage: s32;
lumi_online_round: s32;
lumi_feedback_retry: s64;
lumi_reply_retry: s64;
lumi_reply_offset: s32;
lumi_feedback_id: [65]u8;
lumi_tool_ids: [12][129]u8;
lumi_tool_results: [12]string;
lumi_tool_count: s32;
// A turn answered by the person's own OpenAI-compatible provider, directly
// from this device (stage 4), rather than by Inner Breeze's server.
lumi_online_provider_turn: bool;
lumi_provider_transfer: NetworkTransfer;
lumi_provider_status: s32;
LUMI_STAGE_PROVIDER :: 4
c :: #system_library "c";
#if #defined(_WIN32) {
    OnlineNow :: (out: *s64) -> s64 #foreign c "_time64";
} else {
    OnlineNow :: (out: *s64) -> s64 #foreign c "time";
}

OnlineField :: (document: string, at: s32, name: string) -> string {
    start := FieldAt(document, at, name)
    end := ValueEnd(document, start, 0)
    if start < 0 || end < 0 {
        return ""
    }
    return document[start:end]
}

LumiOnlineWaiting :: () -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        return false
    }
    return lumi_online_queued || lumi_online_stage == 1 || lumi_online_stage == LUMI_STAGE_PROVIDER
}

LumiOnlineClearTurn :: () {
    PackageFree(lumi_online_messages)
    lumi_online_messages = ""
    for index: cast(s32)0..lumi_tool_count - 1 {
        PackageFree(lumi_tool_results[index])
        lumi_tool_results[index] = ""
    }
    lumi_tool_count = 0
    lumi_tool_ids = .{}
}

LumiProviderCancel :: () {
    if lumi_online_stage == LUMI_STAGE_PROVIDER {
        CancelNetworkTransfer(cast(*void)*lumi_provider_transfer)
        lumi_online_stage = 0
    }
    lumi_online_provider_turn = false
}

LumiOnlineCancel :: () {
    CancelStoredOperation(*lumi_online_operation)
    LumiProviderCancel()
    LumiOnlineClearTurn()
    lumi_online_queued = false
    lumi_online_fresh = false
    lumi_online_stage = 0
    lumi_online_round = 0
    lumi_online_session = Session.{}
    lumi_online_owner = .{}
    lumi_feedback_retry = 0
    lumi_reply_retry = 0
    lumi_reply_offset = 0
}

LumiOnlineStart :: (input: string) -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        LumiOnlineCancel()
        return false
    }
    unused input
    if LumiOnlineWaiting() {
        return false
    }
    route := LumiAiRoute()
    if route != LUMI_AI_NODE && route != LUMI_AI_OWN {
        // Offline nothing is sent: say how Lumi could answer instead.
        LumiOnlineAppend(LocaleText(ifx route == LUMI_AI_OFFLINE then
            "lumi_offline_unknown" else "lumi_online_setup"))
        return true
    }
    lumi_online_provider_turn = route == LUMI_AI_OWN
    if lumi_online_stage == 2 || lumi_online_stage == 3 {
        // A conversation takes priority over retriable inbox background work.
        CancelStoredOperation(*lumi_online_operation)
        lumi_online_stage = 0
    }
    LumiOnlineClearTurn()
    out: Vec(u8)
    BuilderPrint(*out, "[")
    count := LumiStoreCount()
    first := count - LUMI_REQUEST_MESSAGE_LIMIT
    if first < 0 { first = 0 }
    for index: first..count - 1 {
        row := LumiStoreRow(index)
        BuilderPrint(*out, "%{\"role\":\"%\",\"content\":",
            ifx index == first then "" else ",", ifx row.user then "user" else "assistant")
        if row.developer {
            // Lumi learns that the developer, not Lumi, wrote this reply, so
            // the user can answer it.
            attributed: Vec(u8)
            BuilderPrint(*attributed, "%\n%", LocaleText("lumi_developer_reply"), row.text)
            content := BuilderFinish(attributed)
            LumiJsonString(*out, content)
            PackageFree(content)
        } else {
            LumiJsonString(*out, row.text)
        }
        BuilderPrint(*out, "}")
    }
    BuilderPrint(*out, "]")
    lumi_online_messages = BuilderFinish(out)
    lumi_online_queued = true
    lumi_online_fresh = true
    lumi_online_round = 0
    unused AppCopyText(AppTextFromCString(storage_user_id_buffer(), 64), lumi_online_owner[:])
    return true
}

OnlineToolSchemas :: (out: *Vec(u8)) {
    definitions := AssetRead("assets/mcp/tools.json")
    BuilderPrint(out, "[")
    if definitions.found {
        count := ArrayCount(definitions.data, 0)
        for index: cast(s32)0..count - 1 {
            at := ElementAt(definitions.data, 0, index)
            BuilderPrint(out, "%{\"type\":\"function\",\"function\":{\"name\":%,\"description\":%,\"parameters\":%}}",
                ifx index == 0 then "" else ",", OnlineField(definitions.data, at, "name"),
                OnlineField(definitions.data, at, "description"), OnlineField(definitions.data, at, "inputSchema"))
        }
    }
    BuilderPrint(out, "]")
}

// The node's instructions for Lumi (assets/mcp/lumi_instructions.json, the
// same words as Daochi's chat.zi), sent as the system message when the
// person's own provider answers, followed by the app context.
LumiProviderMessages :: (out: *Vec(u8), context: string) {
    asset := AssetRead("assets/mcp/lumi_instructions.json")
    instructions: [4096]u8
    count: s32 = 0
    if asset.found {
        count = ReadStringText(asset.data, FieldAt(asset.data, 0, "instructions"), instructions[:])
    }
    system: Vec(u8)
    BuilderPrint(*system, "%\nCurrent app context:\n%",
        ifx count > 0 && count < 4096 then TextFromBytes(instructions[:count]) else "", context)
    system_text := BuilderFinish(system)
    defer { PackageFree(system_text) }
    BuilderPrint(out, "[{\"role\":\"system\",\"content\":")
    LumiJsonString(out, system_text)
    BuilderPrint(out, "}")
    inner := lumi_online_messages
    if inner.count > 2 && inner[0] == cast(u8)91 {
        BuilderPrint(out, ",%", inner[1:])
    } else {
        BuilderPrint(out, "]")
    }
}

// Sends the turn to the person's own provider. Its key goes only into this
// request's Authorization header; it is never printed or kept elsewhere.
LumiProviderRequest :: (context: string) -> bool {
    url: [LUMI_PROVIDER_URL_MAX]u8
    model: [LUMI_PROVIDER_MODEL_MAX]u8
    key: [LUMI_PROVIDER_KEY_MAX]u8
    endpoint: [LUMI_PROVIDER_URL_MAX + 32]u8
    defer { SecureWipe(*key[0], LUMI_PROVIDER_KEY_MAX) }
    if !AppCopyText(storage_get_setting_text(LumiProviderUrlSetting), url[:]) ||
    !AppCopyText(storage_get_setting_text(LumiProviderModelSetting), model[:]) ||
    !AppCopyText(storage_get_setting_text(LumiProviderKeySetting), key[:]) ||
    !LumiProviderUrlValid(TextUntilNul(url[:])) ||
    !LumiProviderModelValid(TextUntilNul(model[:])) ||
    !LumiProviderKeyValid(TextUntilNul(key[:])) {
        return false
    }
    target := LumiProviderEndpoint(TextUntilNul(url[:]), endpoint[:])
    out: Vec(u8)
    BuilderPrint(*out, "{\"model\":")
    LumiJsonString(*out, TextUntilNul(model[:]))
    BuilderPrint(*out, ",\"messages\":")
    LumiProviderMessages(*out, context)
    BuilderPrint(*out, ",\"tools\":")
    OnlineToolSchemas(*out)
    BuilderPrint(*out, "}")
    body := BuilderFinish(out)
    defer { PackageFree(body) }
    #if #defined(PLATFORM_WEB) == false && #defined(ANDROID_BUILD) == false {
        if NetworkTracing() {
            print("LUMI: provider_request body_bytes=%\n", body.count)
        }
    }
    lumi_online_response[0] = cast(u8)0
    transport := NetworkTransport(*lumi_provider_transfer)
    request := HttpRequest.{.method = "POST", .url = target, .token = TextUntilNul(key[:]),
        .accept = "application/json", .content_type = "application/json", .body = body}
    if target.count == 0 || !transport.start(transport.context, request, lumi_online_response[:]) {
        return false
    }
    lumi_online_stage = LUMI_STAGE_PROVIDER
    lumi_online_queued = false
    return true
}

LumiOnlineRequest :: (app: *InnerBreeze) -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        return false
    }
    route := LumiAiRoute()
    if (route != LUMI_AI_NODE && route != LUMI_AI_OWN) ||
    (route == LUMI_AI_OWN) != lumi_online_provider_turn {
        return false
    }
    first := LumiRequestHistoryStart(lumi_online_messages)
    if first < 0 {
        return false
    }
    if first != ElementAt(lumi_online_messages, 0, 0) {
        // Retire only older chat history as tool results need more room.
        // Executed calls and their results remain in this turn; none replay.
        messages := PackageText("[", lumi_online_messages[first:])
        PackageFree(lumi_online_messages)
        lumi_online_messages = messages
    }
    context := AppToolContext(app)
    defer { PackageFree(context) }
    #if #defined(PLATFORM_WEB) == false && #defined(ANDROID_BUILD) == false {
        if NetworkTracing() {
            print("LUMI: context_bytes=% messages_bytes=%\n", context.count, lumi_online_messages.count)
        }
    }
    if context.count > 8192 {
        return false
    }
    if lumi_online_provider_turn {
        return LumiProviderRequest(context)
    }
    out: Vec(u8)
    BuilderPrint(*out, "{\"messages\":%,\"context\":%,\"tools\":", lumi_online_messages, context)
    OnlineToolSchemas(*out)
    BuilderPrint(*out, "}")
    body := BuilderFinish(out)
    defer { PackageFree(body) }
    if !BeginStoredRequest(*lumi_online_operation, "https://api.waozi.xyz",
        NetworkTransport(*lumi_online_transfer), "POST", "/api/v1/chat/completions",
        body, lumi_online_response[:], false, *lumi_online_session) {
        #if #defined(PLATFORM_WEB) == false && #defined(ANDROID_BUILD) == false {
            if NetworkTracing() {
                print("LUMI: request_start_failed result=% body_bytes=%\n", lumi_online_operation.result, body.count)
            }
        }
        return false
    }
    lumi_online_stage = 1
    lumi_online_queued = false
    return true
}

LumiOnlineAppend :: (reply: string) {
    LumiOnlineAppendFrom(reply, false, "")
}

// The developer's reply quotes the feedback it answers in its first part.
// With an id, each part is saved under a record named after it, so every
// device that fetches the reply writes the same messages and sync keeps one.
LumiOnlineAppendFrom :: (reply: string, developer: bool, quote: string, id: string = "") {
    start: s64 = 0
    part: s32 = 0
    while start < reply.count {
        end := start + LUMI_INPUT_MAX - 1
        if end > reply.count { end = reply.count }
        // Split long translated replies only at UTF-8 character boundaries.
        while end < reply.count && end > start && (reply[end] & cast(u8)192) == cast(u8)128 {
            end -= 1
        }
        if end <= start { return }
        stable_id := ""
        if id.count > 0 && lumi_next_message_id.count == 0 {
            name: Vec(u8)
            if part == 0 {
                BuilderPrint(*name, "reply-%", id)
            } else {
                BuilderPrint(*name, "reply-%-%", id, part)
            }
            stable_id = BuilderFinish(name)
            lumi_next_message_id = stable_id
        }
        unused LumiStoreAppendRow(LumiChatRow.{.text = reply[start:end], .developer = developer,
            .quote = ifx start == 0 then quote else ""})
        if stable_id.count > 0 {
            lumi_next_message_id = ""
            PackageFree(stable_id)
        }
        start = end
        part += 1
    }
    if lumi_ui.follow_end {
        lumi_ui.scroll = 1000000
    }
}

LumiOnlineAnswer :: (app: *InnerBreeze) -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        return false
    }
    document := TextUntilNul(lumi_online_response[:])
    at := ifx lumi_online_provider_turn then LumiProviderMessageAt(document) else LumiResponseMessageAt(document)
    if at < 0 {
        return false
    }
    calls_at := FieldAt(document, at, "tool_calls")
    calls := ArrayCount(document, calls_at)
    if calls <= 0 {
        // Own providers may return more than the node's 4 KiB answer cap.
        // Bound decoding by the transfer buffer, then use the archive's
        // existing UTF-8 splitting instead of rejecting a successful reply.
        decoded := ReadStringValue(document, FieldAt(document, at, "content"),
            ifx lumi_online_provider_turn then cast(s32)lumi_online_response.count - 1 else 4096)
        text := BuilderFinish(decoded.value)
        defer { PackageFree(text) }
        if !decoded.valid || text.count == 0 {
            return false
        }
        LumiOnlineAppend(text)
        return true
    }
    if !LumiToolRoundAllowed(lumi_online_round, calls, lumi_tool_count) {
        return false
    }
    feedback_card := false
    out: Vec(u8)
    if lumi_online_provider_turn {
        // Only the fields every OpenAI-compatible provider accepts back.
        content_at := FieldAt(document, at, "content")
        BuilderPrint(*out, "%,{\"role\":\"assistant\",\"content\":%,\"tool_calls\":%}",
            lumi_online_messages[:lumi_online_messages.count - 1],
            ifx content_at >= 0 then document[content_at:ValueEnd(document, content_at, 0)] else "null",
            document[calls_at:ValueEnd(document, calls_at, 0)])
    } else {
        BuilderPrint(*out, "%,%", lumi_online_messages[:lumi_online_messages.count - 1],
            document[at:ValueEnd(document, at, 0)])
    }
    for index: cast(s32)0..calls - 1 {
        call_at := ElementAt(document, calls_at, index)
        function_at := FieldAt(document, call_at, "function")
        if call_at < 0 || function_at < 0 || ValueEnd(document, function_at, 0) < 0 {
            PackageFree(BuilderFinish(out))
            return false
        }
        name_bytes: [65]u8
        id_bytes: [129]u8
        arguments_bytes: [65536]u8
        name := ToolString(document[function_at:ValueEnd(document, function_at, 0)], "name", name_bytes[:])
        arguments := ToolString(document[function_at:ValueEnd(document, function_at, 0)], "arguments", arguments_bytes[:])
        id := ToolString(document[call_at:ValueEnd(document, call_at, 0)], "id", id_bytes[:])
        if name.count == 0 || id.count == 0 || arguments.count == 0 || lumi_tool_count >= 12 {
            PackageFree(BuilderFinish(out))
            return false
        }
        result: string
        for seen: cast(s32)0..lumi_tool_count - 1 {
            if id == TextUntilNul(lumi_tool_ids[seen][:]) {
                result = lumi_tool_results[seen]
            }
        }
        if result.count == 0 {
            result = AppToolExecute(app, name, arguments)
            unused AppCopyText(id, lumi_tool_ids[lumi_tool_count][:])
            lumi_tool_results[lumi_tool_count] = result
            lumi_tool_count += 1
        }
        BuilderPrint(*out, ",{\"role\":\"tool\",\"tool_call_id\":")
        LumiJsonString(*out, id)
        BuilderPrint(*out, ",\"content\":")
        LumiJsonString(*out, result)
        BuilderPrint(*out, "}")
        if (name == "report_feedback" || name == "delete_habit") &&
        ContainsFoldASCII(result, "\"ok\":true") {
            feedback_card = true
        }
    }
    if feedback_card {
        // The feedback card with Yes and No, or the question whether to
        // delete a habit, is Lumi's whole answer; the model's follow-up
        // would only repeat it.
        PackageFree(BuilderFinish(out))
        LumiOnlineClearTurn()
        return true
    }
    BuilderPrint(*out, "]")
    PackageFree(lumi_online_messages)
    lumi_online_messages = BuilderFinish(out)
    lumi_online_round += 1
    // The response's text views must end before the next transfer reuses it.
    lumi_online_queued = true
    return true
}

// A stable history key makes failure and receipt notices account-scoped and
// idempotent across retries and restarts, using the existing Lumi archive.
LumiFeedbackNotice :: (id: string, delivered: bool) -> bool {
    if id.count != 64 {
        return false
    }
    notice_id := PackageText("feedback-", id)
    defer { PackageFree(notice_id) }
    message_id := PackageText(notice_id, ifx delivered then "-delivered" else "-failed")
    defer { PackageFree(message_id) }
    message_key := PackageText("cell.lumi.message.", message_id)
    defer { PackageFree(message_key) }
    existing := CellRecordRead(message_key)
    defer { PackageFree(existing) }
    if existing.count != 0 {
        return true
    }
    report_key := PackageText("cell.feedback.pending.", id)
    defer { PackageFree(report_key) }
    report := CellRecordRead(report_key)
    defer { PackageFree(report) }
    bytes: [161]u8
    title := ToolString(report, "title", bytes[:])
    if title.count == 0 {
        return false
    }
    out: Vec(u8)
    BuilderPrint(*out, "%\n%", LocaleText(ifx delivered then
        "lumi_feedback_delivered" else "lumi_feedback_unavailable"), title)
    message := BuilderFinish(out)
    defer { PackageFree(message) }
    if lumi_next_message_id.count != 0 {
        return false
    }
    lumi_next_message_id = message_id
    saved := LumiStoreAppendCard(message, false, LUMI_CHAT_TEXT, "")
    lumi_next_message_id = ""
    if saved && lumi_ui.follow_end {
        lumi_ui.scroll = 1000000
    }
    return saved
}

LumiFeedbackStart :: () -> bool {
    if StoredAccountMode() == AccountModeDelegate || !LumiNodeTrafficAllowed() {
        return false
    }
    body := FeedbackFirst()
    defer { PackageFree(body) }
    if body.count == 0 {
        return false
    }
    id := ToolString(body, "id", lumi_feedback_id[:])
    if id.count != 64 {
        return false
    }
    if !BeginStoredRequest(*lumi_online_operation, "https://api.waozi.xyz",
        NetworkTransport(*lumi_online_transfer), "POST", "/api/v1/feedback",
        body, lumi_online_response[:], false, *lumi_online_session) {
        unused LumiFeedbackNotice(id, false)
        return false
    }
    lumi_online_stage = 2
    return true
}

LumiFeedbackReplies :: () {
    if StoredAccountMode() == AccountModeDelegate {
        return
    }
    document := TextUntilNul(lumi_online_response[:])
    at := FieldAt(document, 0, "feedback")
    count := ArrayCount(document, at)
    seen := storage_get_setting_text("lumi_feedback_replies_seen")
    out: Vec(u8)
    BuilderPrint(*out, "%", seen)
    for index: cast(s32)0..count - 1 {
        item := ElementAt(document, at, index)
        id_bytes: [65]u8
        reply_bytes: [4097]u8
        title_bytes: [161]u8
        id := ToolString(document[item:ValueEnd(document, item, 0)], "id", id_bytes[:])
        reply := ToolString(document[item:ValueEnd(document, item, 0)], "reply", reply_bytes[:])
        title := ToolString(document[item:ValueEnd(document, item, 0)], "title", title_bytes[:])
        if id.count != 64 || reply.count == 0 || ContainsFoldASCII(seen, id) {
            continue
        }
        // A reply another device already saved arrives through sync; this
        // device only marks it as seen.
        lowercase: [65]u8
        for byte, at: id {
            lowercase[at] = ifx byte >= cast(u8)65 && byte <= cast(u8)90 then byte + cast(u8)32 else byte
        }
        stable := TextFromBytes(lowercase[:id.count])
        record_key := PackageText("cell.lumi.message.reply-", stable)
        existing := CellRecordRead(record_key)
        PackageFree(record_key)
        if existing.count == 0 {
            // A developer's reply remains verbatim and is attributed to the
            // developer, quoting the title of the feedback it answers.
            LumiOnlineAppendFrom(reply, true, title, stable)
        }
        PackageFree(existing)
        BuilderPrint(*out, "%\n", id)
    }
    updated := BuilderFinish(out)
    defer { PackageFree(updated) }
    if updated.count < 32768 {
        storage_set_setting_text("lumi_feedback_replies_seen", updated)
    }
}

// Ends a conversation turn: the answer or a notice, then the actions the
// tools asked for. Another round may already be queued.
LumiOnlineFinishTurn :: (app: *InnerBreeze, success: bool, status: s32) {
    lumi_pending_route = -1
    lumi_pending_practice = -1
    if !success || !LumiOnlineAnswer(app) {
        notice := "lumi_online_unavailable"
        if status == 429 && !lumi_online_provider_turn {
            notice = "lumi_online_limit"
        } else if (status == 401 || status == 403) && lumi_online_provider_turn {
            notice = "lumi_provider_rejected"
        }
        LumiOnlineAppend(LocaleText(notice))
    }
    if lumi_pending_practice >= 0 {
        unused app_start_practice(app, lumi_pending_practice)
    }
    if lumi_pending_route >= 0 {
        app_apply_nav_route(app, lumi_pending_route)
    }
    if !LumiOnlineWaiting() {
        LumiOnlineClearTurn()
        lumi_online_provider_turn = false
    }
    unused LumiStoreSave()
}

// Going offline, withdrawing or changing where requests go stops what is
// in flight at once; nothing more is sent.
LumiOnlineEnforce :: () {
    route := LumiAiRoute()
    turn_allowed := (lumi_online_provider_turn && route == LUMI_AI_OWN) ||
    (!lumi_online_provider_turn && route == LUMI_AI_NODE)
    if lumi_online_operation.active {
        stage := lumi_online_stage
        if (stage == 1 && !turn_allowed) ||
        ((stage == 2 || stage == 3) && !LumiNodeTrafficAllowed()) {
            CancelStoredOperation(*lumi_online_operation)
            lumi_online_stage = 0
        }
    }
    if lumi_online_stage == LUMI_STAGE_PROVIDER && !turn_allowed {
        LumiProviderCancel()
    }
    if (lumi_online_queued || lumi_online_stage == 0) && !turn_allowed &&
    lumi_online_messages.count > 0 && !lumi_online_operation.active {
        lumi_online_queued = false
        lumi_online_fresh = false
        lumi_online_provider_turn = false
        LumiOnlineClearTurn()
    }
}

app_lumi_pump :: (app: *InnerBreeze) {
    // Lumi may still be opening after the first frames; its work waits.
    if !CellsLumiOpen() {
        return
    }
    if StoredAccountMode() == AccountModeDelegate {
        LumiOnlineCancel()
        return
    }
    if app == null {
        return
    }
    LumiTelegramPump(app)
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    if lumi_online_owner[0] != cast(u8)0 && owner != TextUntilNul(lumi_online_owner[:]) {
        LumiOnlineCancel()
        app_lumi_reset()
        return
    }
    LumiOnlineEnforce()
    if lumi_online_stage == LUMI_STAGE_PROVIDER {
        transport := NetworkTransport(*lumi_provider_transfer)
        status: s32
        polled := transport.poll(transport.context, *status)
        if polled < 0 {
            return
        }
        lumi_online_stage = 0
        lumi_provider_status = status
        LumiOnlineFinishTurn(app, polled == 1 && status >= 200 && status < 300, status)
        return
    }
    if lumi_online_operation.active {
        if !PollStoredOperation(*lumi_online_operation) {
            return
        }
        // A transport callback can switch accounts while polling. Never write
        // the old account's receipt or notice into the new account's archive.
        if owner != AppTextFromCString(storage_user_id_buffer(), 64) {
            LumiOnlineCancel()
            app_lumi_reset()
            return
        }
        stage := lumi_online_stage
        lumi_online_stage = 0
        success := lumi_online_operation.result == cast(s32)AuthResult.AUTH_OK
        lumi_online_session = lumi_online_operation.session
        if stage == 1 {
            LumiOnlineFinishTurn(app, success, lumi_online_operation.request.status)
        } else if stage == 2 {
            id := TextUntilNul(lumi_feedback_id[:])
            confirmed := success && LumiFeedbackReceiptMatches(
                TextUntilNul(lumi_online_response[:]), id)
            if confirmed {
                // Delivery adds no message: the confirmation card is the whole
                // exchange. Only a failure is told, once.
                if FeedbackDelivered(id) {
                    lumi_feedback_retry = 0
                }
            } else {
                unused LumiFeedbackNotice(id, false)
            }
        } else if stage == 3 && success {
            LumiFeedbackReplies()
            unused LumiStoreSave()
            count := ArrayCount(TextUntilNul(lumi_online_response[:]),
                FieldAt(TextUntilNul(lumi_online_response[:]), 0, "feedback"))
            if count == 2 {
                lumi_reply_offset += 2
                lumi_reply_retry = 0
            } else {
                lumi_reply_offset = 0
            }
        }
    }
    if lumi_online_stage != 0 {
        return
    }
    if lumi_online_queued {
        if lumi_online_fresh {
            lumi_online_fresh = false
            return
        }
        if !LumiOnlineRequest(app) {
            lumi_online_queued = false
            LumiOnlineAppend(LocaleText("lumi_online_unavailable"))
            LumiOnlineClearTurn()
            unused LumiStoreSave()
        }
        return
    }
    if storage_has_sync_account() == 0 || !LumiNodeTrafficAllowed() {
        return
    }
    unused AppCopyText(owner, lumi_online_owner[:])
    now := OnlineNow(null)
    if now >= lumi_feedback_retry {
        lumi_feedback_retry = now + 60
        if LumiFeedbackStart() { return }
    }
    if now >= lumi_reply_retry {
        lumi_reply_retry = now + 300
        path_buffer: Vec(u8)
        BuilderPrint(*path_buffer, "/api/v1/feedback?replies=1&offset=%", lumi_reply_offset)
        path := BuilderFinish(path_buffer)
        defer { PackageFree(path) }
        if BeginStoredRequest(*lumi_online_operation, "https://api.waozi.xyz",
            NetworkTransport(*lumi_online_transfer), "GET", path,
            "", lumi_online_response[:], false, *lumi_online_session) {
            lumi_online_stage = 3
        }
    }
}
