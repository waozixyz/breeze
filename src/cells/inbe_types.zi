#import, file "module_types.zi";

INBE_CONFIGURE :: 1
INBE_ROUTE :: 2
INBE_TOGGLE_APP :: 3
INBE_INITIAL_SCREEN :: 4
INBE_MINI_CONFIGURE :: 5
INBE_FRAME :: 6
APP_LISTS :: 1
APP_HABITS :: 2
APP_PRACTICE :: 4
APP_DIARY :: 8
APP_LUMI :: 16
APP_RECOMMENDED :: 22
