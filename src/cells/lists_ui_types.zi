#import "session"
#import "text_input_props"

ListsUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    input: TextFieldInput
    value: string
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    scroll: s32
    clipboard_write: bool
    clipboard_text: string
}

ListsUiRow :: struct {
    id: string
    parent_id: string
    title: string
    comment: string
    done: s32
    sort_order: s32
}
