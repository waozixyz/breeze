#import, file "module_types.zi";
#import "drawing_props"
HABITS_EXPAND :: 1
HABITS_FOCUS :: 2
HABITS_HISTORY :: 3
HABITS_STATISTICS :: 4
HABITS_OVERVIEW :: 5
HABITS_COLLAPSE :: 6
HABITS_DAY_ACTION :: 7
HABITS_COMMIT :: 8
HABITS_ROUTE :: 9
// Draws a counting habit's count dialog (habits_view.zi); its HabitsUiFrame
// says what the host does next.
HABITS_COUNT_DIALOG :: 10
HABITS_UNSAVED_DIALOG :: 11
HABITS_DELETE_DIALOG :: 12
// Draws the habit shop's page (shop_view.zi), and the dialog Buy opens; the
// HabitsShopFrame says what the host does next.
HABITS_SHOP_VIEW :: 13
HABITS_SHOP_BUY_DIALOG :: 14
// Draws the habit list or a habit's own page (habit_list_view.zi); the
// HabitsListFrame says what the host does next.
HABITS_LIST_VIEW :: 15
// Draws a habit's day screen and the entry dialog (habit_day_view.zi); the
// HabitsDayFrame and HabitsEntryFrame say what the host does next.
HABITS_DAY_VIEW :: 16
HABITS_ENTRY_VIEW :: 17
// Draws the habit editor and its practice picker (habit_edit_view.zi); the
// HabitsEditFrame says what the host does next.
HABITS_EDIT_VIEW :: 18
// Draws a habit's statistics (habit_stats_view.zi); the HabitsStatsFrame
// says what the host does next.
HABITS_STATS_VIEW :: 19
HABITS_DAY_NONE :: 0
HABITS_DAY_DECREMENT :: 1
HABITS_DAY_COUNT :: 2
HABITS_DAY_LINKED :: 3
HABITS_DAY_TOGGLE :: 4
HABITS_DAY_QUESTIONS :: 5
HABITS_DAY_SPAN :: 6
HABITS_COUNT_NONE :: 0
HABITS_COUNT_DECREMENT :: 1
HABITS_COUNT_INCREMENT :: 2
// Opens the day's entries and linked sessions.
HABITS_COUNT_OPEN_DAY :: 3
HABITS_COUNT_CLOSE :: 4
HABITS_SHOP_NONE :: 0
// Back to the habit list.
HABITS_SHOP_BACK :: 1
// Opens the dialog that asks before buying the frame's buying reward.
HABITS_SHOP_BUY :: 2
// Closes that dialog, bought or not.
HABITS_SHOP_CLOSE :: 3
// What the habit list and a habit's page ask for: a new habit, the shop,
// a habit's details opened or closed, a day tapped, its history,
// statistics or editor, a habit moved to the place action_target, made
// inactive or active again there, and Back from a habit's page.
HABITS_LIST_NONE :: 0
HABITS_LIST_ADD :: 1
HABITS_LIST_SHOP :: 2
HABITS_LIST_OPEN :: 3
HABITS_LIST_CLOSE :: 4
HABITS_LIST_DAY :: 5
HABITS_LIST_HISTORY :: 6
HABITS_LIST_STATISTICS :: 7
HABITS_LIST_EDIT :: 8
HABITS_LIST_MOVE :: 9
HABITS_LIST_DEACTIVATE :: 10
HABITS_LIST_REACTIVATE :: 11
HABITS_LIST_BACK :: 12
// What a day's screen asks for: closing it, a new entry, an entry changed,
// deleted or its span ended, a session or one of its rounds deleted, a
// round's seconds saved, and a count stepped.
HABITS_DAY_SCREEN_NONE :: 0
HABITS_DAY_SCREEN_CLOSE :: 1
HABITS_DAY_SCREEN_ADD_ENTRY :: 2
HABITS_DAY_SCREEN_EDIT_ENTRY :: 3
HABITS_DAY_SCREEN_DELETE_ENTRY :: 4
HABITS_DAY_SCREEN_END_SPAN :: 5
HABITS_DAY_SCREEN_DELETE_SESSION :: 6
HABITS_DAY_SCREEN_DELETE_ROUND :: 7
HABITS_DAY_SCREEN_SAVE_ROUND :: 8
HABITS_DAY_SCREEN_STEP_COUNT :: 9
// What the entry dialog asks for: save it (Done), record it without
// answers (Skip), delete it, or close without saving.
HABITS_ENTRY_NONE :: 0
HABITS_ENTRY_SAVE :: 1
HABITS_ENTRY_SKIP :: 2
HABITS_ENTRY_DELETE :: 3
HABITS_ENTRY_CANCEL :: 4
// What the editor asks for: Back, Save (or Create), Delete, the practice
// picker opened or closed, and a question added or removed.
HABITS_EDIT_NONE :: 0
HABITS_EDIT_BACK :: 1
HABITS_EDIT_SAVE :: 2
HABITS_EDIT_DELETE :: 3
HABITS_EDIT_PRACTICES :: 4
HABITS_EDIT_PRACTICES_DONE :: 5
HABITS_EDIT_ADD_QUESTION :: 6
HABITS_EDIT_REMOVE_QUESTION :: 7
// What the statistics ask for: Back to the habit list.
HABITS_STATS_NONE :: 0
HABITS_STATS_BACK :: 1

HabitsMessage :: struct {
    abi: s32
    action: s32
    index: s32
    count: s32
    selected: s32
    screen_mode: s32
    view_mode: s32
    tab: s32
    day_index: s32
    weekdays: s32
    counter_enabled: s32
    counter_target: s32
    linked_count: s32
    sync_activity: s32
    sync_mode: s32
    reminder_hour: s32
    modal_active: bool
    scheduled: bool
    completed: bool
    decrement: bool
    is_new: bool
    active: bool
    name: string
    description: string
    color: Color
    succeeded: bool
    reset_scroll: bool
    cancel_edit: bool
    name_error: s32
    day_action: s32
    block_click: bool
    screen: s32
    // The questions the habit asks when a day is done; a host from before
    // them leaves this 0.
    question_count: s32
    // Whether the habit measures a span from a tap to the next.
    span: bool
}
