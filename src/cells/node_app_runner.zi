// Stable native runtime storage shared by the loader and Apps provider.
#import "hosted_app"
#import "kryon/app_context_host"
Nested :: #import "apps/host";

NodeAppRunner :: struct {
    app: HostedApp
    nested: *Nested.AppHost
    portable: AppContext
    generic: bool
    release_hash: [65]u8
    bundle_bytes: s64
    received: bool
    has_read: bool
    has_write: bool
}
