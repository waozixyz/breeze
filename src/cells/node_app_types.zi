// Apps the node offers run through one generic host interface, so an app
// added to the node needs no host code of its own. The host supplies values
// only: frames, translated text, the account's private records, friends and
// records shared with a friend. No native pointers cross the boundary.
#import, file "module_types.zi";
#import "session"

// The answer a node app gives when the host asks who it is.
MODULE_NODE_APP :: 8

APP_ROUTE :: 1
APP_FRAME :: 2
// An app consumes Back only when it can return to an earlier page.
APP_BACK :: 3

// What a shared command is doing.
APP_SHARED_IDLE :: 0
APP_SHARED_SENDING :: 1
APP_SHARED_DONE :: 2
APP_SHARED_FAILED :: 3
APP_SHARED_CONFLICT :: 4
APP_SHARED_UNAVAILABLE :: 5

// Commands on records shared with friends.
APP_SHARED_SAVE :: 1
APP_SHARED_INVITE :: 2
APP_SHARED_ACCEPT :: 3
APP_SHARED_DECLINE :: 4
APP_SHARED_DELETE :: 5

// Limits the host enforces; an app keeps within them.
APP_RECORD_NAME_MAX :: 64
APP_RECORD_TEXT_MAX :: 65536
APP_SHARED_ID_MAX :: 36
APP_SHARED_TITLE_MAX :: 127
APP_SHARED_COMMENT_MAX :: 511
APP_SHARED_ITEMS_MAX :: 32

AppMessage :: struct {
    abi: s32
    action: s32
    screen: s32
    // The app's own name, such as "chess"; its records and shared ids use it.
    name: string
    // The language the person chose, such as "en".
    locale: string
    // The account's public ID, or empty without an account.
    account: string
    signed_in: bool
    friend_count: s32
    shared_count: s32
    invitation_count: s32
    // Changes whenever the shared records or invitations change.
    shared_revision: s32
    // The last shared command, APP_SHARED_IDLE to APP_SHARED_UNAVAILABLE.
    shared_status: s32
    // Seconds since 1970 by the device clock.
    time: s64
    succeeded: bool
}

// Device observations for one frame of the app's screen.
AppUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    // Optional reserved space above the game. Older hosts omit it (zero).
    top: s32
    scale: float32
    font: s32
    // The app clock in seconds, for animation and press timing.
    now: float64
    dark: bool
}

AppPerson :: struct {
    id: string
    name: string
}

// A record shared with friends. Its id starts with the app's name and a dash.
AppShared :: struct {
    id: string
    owner: string
    owner_name: string
    title: string
    revision: s32
    item_count: s32
}

AppSharedItem :: struct {
    id: string
    title: string
    comment: string
    done: bool
}

// An invitation to a shared record, sent or received.
AppInvitation :: struct {
    id: string
    shared_id: string
    title: string
    owner: string
    owner_name: string
    target: string
    target_name: string
    // "pending", "accepted" or "declined".
    status: string
}

AppSharedCommand :: struct {
    action: s32
    id: string
    title: string
    // The revision the change was made from; a newer one on the node
    // answers APP_SHARED_CONFLICT.
    revision: s32
    // The friend invited, by account ID.
    target: string
    invitation: string
}

// The account's media library, for an app the host grants it (Photos). Its
// photos are kept once by the SHA-256 of their bytes, encrypted on the
// account's nodes, and drawn through MediaAssetHost's asset paths.
MediaEntry :: struct {
    hash: string
    name: string
    // The capture day, YYYY-MM-DD, and time, with its offset when known.
    day: string
    taken: string
    // "jpg", "png", "gif" or "webp".
    format: string
    size: s64
    trashed: bool
}

// The platform picker MediaPickHost opens, and what its last pick did.
MediaStatus :: struct {
    picking: bool
    // Counts the finished picks; the fields below describe the last one.
    picks: s32
    added: bool
    // The photo was in the library already, maybe in Trash; it is back.
    existed: bool
    // Nothing could be added: not a photo, too large or unreadable.
    failed: bool
    hash: string
    // Changes whenever the items MediaQueryHost lists change, on this
    // device or from another.
    revision: s32
    // This device's date, YYYY-MM-DD, for day headings.
    today: string
}
