// Stable IDs and mask bits are shared by account preferences and packages.
#import "byte_text_linux"
#import, file "inbe_types.zi";

PackageCount :: 7
PackageMaximumBytes :: 67108864

// Apps the node offers run in these device-local slots; their package
// indexes follow the bundled packages' (PackageCount + slot).
NodeAppSlots :: 8
PackageSlots :: PackageCount + NodeAppSlots

#scope_file
node_app_names: [NodeAppSlots][25]u8;
node_app_ids: [NodeAppSlots][32]u8;
node_app_wanted: [NodeAppSlots]bool;

CatalogCopy :: (prefix: string, value: string, output: []u8) {
    count: s64 = 0
    for byte: prefix {
        if count < output.count - 1 {
            output[count] = byte
            count += 1
        }
    }
    for byte: value {
        if count < output.count - 1 {
            output[count] = byte
            count += 1
        }
    }
    output[count] = cast(u8)0
}

CatalogText :: (bytes: []u8) -> string {
    count: s64 = 0
    while count < bytes.count && bytes[count] != cast(u8)0 {
        count += 1
    }
    return TextFromBytes(bytes[0:count])
}

#scope_export
// Names the app in a slot, such as "chess" (package ID inbe.chess), or
// frees it with an empty name.
PackageSetNodeApp :: (slot: s32, name: string) {
    if slot < 0 || slot >= NodeAppSlots {
        return
    }
    CatalogCopy("", name, node_app_names[slot][:])
    if name.count == 0 {
        node_app_ids[slot][0] = cast(u8)0
        node_app_wanted[slot] = false
        return
    }
    CatalogCopy("inbe.", name, node_app_ids[slot][:])
}

PackageNodeAppName :: (slot: s32) -> string {
    if slot < 0 || slot >= NodeAppSlots {
        return ""
    }
    return CatalogText(node_app_names[slot][:])
}

// An installed node app is kept up to date like a selected bundled one.
PackageSetNodeAppWanted :: (slot: s32, wanted: bool) {
    if slot >= 0 && slot < NodeAppSlots {
        node_app_wanted[slot] = wanted
    }
}

PackageWanted :: (index: s32, desired: s32) -> bool {
    if index == 0 {
        return true
    }
    if index > 0 && index < PackageCount {
        return (desired & PackageBit(index)) != 0
    }
    slot := index - PackageCount
    return slot >= 0 && slot < NodeAppSlots && node_app_wanted[slot] &&
    node_app_names[slot][0] != cast(u8)0
}

PackageName :: (index: s32) -> string {
    if index >= PackageCount && index < PackageSlots {
        return PackageNodeAppName(index - PackageCount)
    }
    names: [PackageCount]string = .["inbe", "lists", "habits", "practices", "diary", "lumi", "leaderboard"]
    if index < 0 || index >= PackageCount {
        return ""
    }
    return names[index]
}

PackageID :: (index: s32) -> string {
    if index >= PackageCount && index < PackageSlots {
        return CatalogText(node_app_ids[index - PackageCount][:])
    }
    ids: [PackageCount]string = .["inbe", "inbe.lists", "inbe.habits", "inbe.practices", "inbe.diary", "inbe.lumi", "inbe.leaderboard"]
    if index < 0 || index >= PackageCount {
        return ""
    }
    return ids[index]
}

PackageBit :: (index: s32) -> s32 {
    if index < 1 || index >= PackageCount {
        return 0
    }
    return cast(s32)1 << (index - 1)
}

PackagePreferenceKey :: (index: s32) -> string {
    keys: [PackageCount]string = .["", "app_used_lists", "app_used_habits", "app_used_practices", "app_used_diary", "app_used_lumi", "app_used_leaderboard"]
    if index < 1 || index >= PackageCount {
        return ""
    }
    return keys[index]
}

// The pinned apps' order syncs as one record of package names, in its own
// collection: a version that doesn't know it skips it.
AppOrderKey :: "app_order"
AppOrderCollection :: "private.inbe.v1.app-order"
// Set when another device's order arrives, until the pins take it.
AppOrderReceivedKey :: "app_order_received"
// A default is stored at this time, older than any choice, so a choice from
// the account replaces it. Defaults are never uploaded.
AppDefaultTime :: 1

AppPreferenceValid :: (key: string) -> bool {
    return key == "app_used_lists" || key == "app_used_habits" ||
    key == "app_used_practices" || key == "app_used_diary" || key == "app_used_lumi" ||
    key == "app_used_leaderboard"
}
