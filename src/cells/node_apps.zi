// Apps the node offers beyond those bundled with Inner Breeze. More apps
// lists every app the node's registry names "inbe.<name>" that has a release
// this build can run. Installing one downloads it through the package
// manager into one of a few device-local slots; it then runs in its own VM
// through the generic app interface (apps/node_types), so a new app needs
// no host code. Whether an app is installed syncs with the account.
#import "bundle_host"
#import, file "../app/background_audio.zi";
#import "byte_text_linux"
#import "json_scan"
#import "text"
#import "vec"
#import "hosted_values"
#import "widget_host"
#import "hosted_app"
#import "kryon/app_context_host"
Portable :: #import "kryon/app_protocol";
Time :: #import "date_time_linux";
#import "date_parse"
