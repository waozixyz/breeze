#import, file "module_types.zi";

LUMI_FRAME :: 1
LUMI_SEND :: 2
LUMI_ROUTE :: 3
LUMI_OPEN :: 1
LUMI_ADD_TODO :: 2
LUMI_COMPLETE_TODO :: 3
LUMI_REOPEN_TODO :: 4
LUMI_COMPLETE_HABIT :: 5
LUMI_START_PRACTICE :: 6
LUMI_SET_THEME :: 7
LUMI_SET_MODE :: 8
LUMI_WRITE_DIARY :: 9
LUMI_REPORT_FEEDBACK :: 10
LUMI_SHOW_PROGRESS :: 11
LUMI_SHOW_DONATIONS :: 12
LUMI_CHAT_TEXT :: 0
LUMI_CHAT_PROGRESS :: 1
LUMI_CHAT_DONATIONS :: 2
LUMI_CHAT_FEEDBACK :: 3
LUMI_PROGRESS_SESSIONS :: 0
LUMI_PROGRESS_MEDITATION :: 1
LUMI_PROGRESS_RETENTION :: 2
LUMI_PROGRESS_HABITS :: 3
LUMI_PROGRESS_MAX_DAYS :: 31
LUMI_PAYLOAD_MAX :: 4096
LUMI_LISTS :: 1
LUMI_HABITS :: 2
LUMI_PRACTICES :: 4
LUMI_DIARY :: 8
LUMI_INPUT_MAX :: 1024
LUMI_CHAT_MAX :: 64

LumiMessage :: struct {
    abi: s32
    action: s32
    screen: s32
    input: string
    succeeded: bool
}

// The engine proposes a bounded domain action, never executable code.
LumiAction :: struct {
    kind: s32
    route: s32
    practice: s32
    title: string
    id: string
}

LumiTools :: struct {
    available_apps: s32
    task_count: s32
    habit_count: s32
    choosing_habit: bool
    choosing_diary: bool
}

LumiCommands :: struct {
    add: string
    complete: string
    reopen: string
    complete_habit: string
    start_whm: string
    start_meditation: string
    start_sun: string
    start_patterns: string
    lists: string
    habits: string
    practices: string
    diary: string
    write_diary: string
    settings: string
    appearance: string
    theme: string
    dark: string
    light: string
    system: string
    progress: string
    donations: string
}
