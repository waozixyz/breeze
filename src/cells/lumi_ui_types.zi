#import "session"
#import "text_input_props"

LumiUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    draft_height: s32
    input: TextAreaInput
    value: string
    cursor: s32
    anchor: s32
    input_scroll: s32
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    focused: bool
    scroll: s32
    follow_end: bool
    chat_count: s32
    task_count: s32
    habit_count: s32
    available_apps: s32
    choosing_habit: bool
    choosing_diary: bool
    clipboard_write: bool
    clipboard_text: string
}

LumiChatRow :: struct {
    text: string
    user: bool
    height: s32
}

LumiTask :: struct {
    id: string
    title: string
    done: bool
}
