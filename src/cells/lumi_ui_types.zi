#import "session"
#import "drawing_props"
#import "text_input_props"

LumiUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    draft_height: s32
    input: TextAreaInput
    value: string
    cursor: s32
    anchor: s32
    input_scroll: s32
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    focused: bool
    scroll: s32
    follow_end: bool
    chat_count: s32
    history_height: s32
    has_older: bool
    task_count: s32
    habit_count: s32
    available_apps: s32
    choosing_habit: bool
    choosing_diary: bool
    waiting: bool
    clipboard_write: bool
    clipboard_text: string
    // Seconds on the host clock, for the typing dots while Lumi answers.
    now: float64
    // The page's colour, behind the selection bar over the chat.
    background: Color
    // Lumi's typing dots wait a moment after a message is sent, as a person
    // reads before typing. Hosts without this field show them at once.
    typing_pause: bool
}

LumiChatRow :: struct {
    text: string
    user: bool
    height: s32
    kind: s32
    payload: string
}

LumiDonation :: struct {
    name: string
    address: string
}

LumiTask :: struct {
    id: string
    title: string
    done: bool
}
