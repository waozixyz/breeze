#import "session"
#import "drawing_props"
#import "text_input_props"

LumiUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    draft_height: s32
    input: TextAreaInput
    value: string
    cursor: s32
    anchor: s32
    input_scroll: s32
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    focused: bool
    scroll: s32
    follow_end: bool
    chat_count: s32
    history_height: s32
    has_older: bool
    task_count: s32
    habit_count: s32
    available_apps: s32
    choosing_habit: bool
    choosing_diary: bool
    waiting: bool
    clipboard_write: bool
    clipboard_text: string
    // Seconds on the host clock, for the typing dots while Lumi answers.
    now: float64
    // The page's colour, behind the selection bar over the chat.
    background: Color
    // Lumi's typing dots wait a moment after a message is sent, as a person
    // reads before typing. Hosts without this field show them at once.
    typing_pause: bool
    // The title bar's switch: whether Lumi is online now, and whether this
    // installation can go online at all (a Telegram Mini App cannot).
    online: bool
    connection: bool
    // The terms panel: 0 closed, 1 asking before going online, 2 showing
    // terms already agreed, from Settings.
    agreement: s32
    // Where AI requests go: an own provider's host, or empty for Inner
    // Breeze's server.
    provider_host: string
    // The terms in the app's language, composed by the host because they
    // describe what the host sends, and their height at the chat's width.
    agreement_text: string
    agreement_height: s32
}

LumiChatRow :: struct {
    text: string
    user: bool
    height: s32
    kind: s32
    payload: string
}

LumiDonation :: struct {
    name: string
    address: string
}

LumiTask :: struct {
    id: string
    title: string
    done: bool
}
