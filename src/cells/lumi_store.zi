// Durable account conversation. Older messages load as the chat scrolls up;
// every message remains archived and travels through encrypted account sync.
#import "json_scan"
#import "byte_text_linux"
#import "text"
#import "vec"
#import, file "lumi_types.zi";
#import, file "lumi_ui_types.zi";
#import, file "lumi_chart.zi";
#import, file "package_files.zi";
#import, file "../storage/sqlite.zi";
#import, file "../storage/state.zi";
#import, file "../storage/storage_core.zi";
#import, file "../storage/cell_records.zi";
#import, file "../storage/daochi_account.zi";
#import, file "../storage/db.zi";
#import, file "../app/text_buffers.zi";

lumi_rows: Vec(LumiChatRow);
lumi_count: s32;
lumi_owner: [64]u8;
lumi_store_loaded: bool;
lumi_store_error: bool;
lumi_store_revision: u64;

LumiStoreReset :: () {
    lumi_store_revision += 1
    for index: cast(s32)0..lumi_count - 1 {
        PackageFree(lumi_rows[index].text)
        PackageFree(lumi_rows[index].payload)
        lumi_rows[index] = LumiChatRow.{}
    }
    VecFree(lumi_rows)
    lumi_count = 0
    lumi_owner[0] = cast(u8)0
    lumi_store_loaded = false
    lumi_store_error = false
}

lumi_storage_revision: s64 = -1;
lumi_history_limit: s32 = LUMI_CHAT_MAX;
lumi_has_older: bool;
lumi_next_message_id: string;

LumiStoreLoad :: () {
    owner := AppTextFromCString(storage_user_id_buffer(), 64)
    revision := storage_data_revision()
    if lumi_store_loaded && owner == AppTextFromCString(*lumi_owner[0], 64) && revision == lumi_storage_revision {
        return
    }
    if owner != AppTextFromCString(*lumi_owner[0], 64) {
        lumi_history_limit = LUMI_CHAT_MAX
    }
    LumiStoreReset()
    unused AppCopyText(owner, lumi_owner[:])
    lumi_store_loaded = true
    // Migrate the original bounded history once, without dropping any rows.
    if storage_get_setting_int("lumi_archive_migrated", 0) == 0 {
        statement: *void
        if SqlitePrepareText(storage_db_handle(), "SELECT value FROM settings WHERE user_id=?1 AND key='lumi_chat'", -1, *statement, null) == SQLITE_OK {
            bind_text(statement, 1, owner)
            if SqliteStep(statement) == SQLITE_ROW {
                document := PackageText(AppTextFromCString(SqliteColumnText(statement, 0), 524288), "")
                defer { PackageFree(document) }
                count := ArrayCount(document, 0)
                if count < 0 || count > LUMI_CHAT_MAX {
                    lumi_store_error = true
                } else {
                    for index: cast(s32)0..count - 1 {
                        at := ElementAt(document, 0, index)
                        end := ValueEnd(document, at, 0)
                        if at < 0 || end < 0 { lumi_store_error = true; break }
                        hash: [65]u8
                        row := document[at:end]
                        descriptor := cast(*TextDescriptor)(*row)
                        storage_sha256_hex(descriptor.data, row.count, *hash[0])
                        key_out: Vec(u8)
                        BuilderPrint(*key_out, "cell.lumi.message.legacy-%-%", TextFromCString(*hash[0]), index)
                        key := BuilderFinish(key_out)
                        value_out: Vec(u8)
                        BuilderPrint(*value_out, "{\"time\":%,%", index, row[1:])
                        value := BuilderFinish(value_out)
                        if !CellRecordWrite(key, value) { lumi_store_error = true }
                        PackageFree(key)
                        PackageFree(value)
                    }
                }
            }
            SqliteFinalize(statement)
        } else {
            lumi_store_error = true
        }
        if !lumi_store_error { storage_set_setting_int("lumi_archive_migrated", 1) }
    }
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT value,key FROM (SELECT value,key FROM settings WHERE user_id=?1 AND key LIKE 'cell.lumi.message.%' ORDER BY CAST(json_extract(value,'$.time') AS INTEGER) DESC,key DESC LIMIT ?2) ORDER BY CAST(json_extract(value,'$.time') AS INTEGER),key", -1, *statement, null) != SQLITE_OK {
        lumi_store_error = true
        return
    }
    defer { SqliteFinalize(statement) }
    bind_text(statement, 1, owner)
    SqliteBindInt(statement, 2, lumi_history_limit)
    while SqliteStep(statement) == SQLITE_ROW {
        document := AppTextFromCString(SqliteColumnText(statement, 0), 65536)
        element: s32 = 0
        bytes: [1024]u8
        length := ReadStringText(document, FieldAt(document, element, "text"), bytes[:])
        user := ReadNumber(document, FieldAt(document, element, "user"))
        kind: s32 = LUMI_CHAT_TEXT
        kind_at := FieldAt(document, element, "kind")
        payload_bytes: [4096]u8
        payload: string
        rich_valid := true
        if kind_at >= 0 {
            number := ReadNumber(document, kind_at)
            rich_valid = number.valid && number.value >= 0 && number.value <= 3 &&
            number.value == cast(float64)cast(s32)number.value
            if rich_valid {
                kind = cast(s32)number.value
            }
            if kind == LUMI_CHAT_PROGRESS || kind == LUMI_CHAT_FEEDBACK {
                payload_length := ReadStringText(document, FieldAt(document, element, "payload"), payload_bytes[:])
                rich_valid = rich_valid && payload_length > 0 && payload_length < LUMI_PAYLOAD_MAX
                if rich_valid {
                    payload = TextFromBytes(payload_bytes[:payload_length])
                    rich_valid = ifx kind == LUMI_CHAT_PROGRESS then LumiChartRead(payload).valid else payload.count == 32
                }
            }
            rich_valid = rich_valid && (kind == LUMI_CHAT_TEXT || user.value == 0.0)
        }
        if length <= 0 || length >= LUMI_INPUT_MAX || !user.valid ||
        (user.value != 0.0 && user.value != 1.0) || !rich_valid {
            LumiStoreReset()
            unused AppCopyText(owner, lumi_owner[:])
            lumi_store_loaded = true
            lumi_store_error = true
            return
        }
        row := LumiChatRow.{.text = PackageText(TextFromBytes(bytes[0:length]), ""),
            .user = user.value == 1.0, .kind = kind, .payload = PackageText(payload, "")}
        if !VecPush(lumi_rows, row) {
            PackageFree(row.text)
            PackageFree(row.payload)
            lumi_store_error = true
            return
        }
        lumi_count += 1
    }
    total: *void
    lumi_has_older = false
    if SqlitePrepareText(storage_db_handle(), "SELECT COUNT(*) FROM settings WHERE user_id=?1 AND key LIKE 'cell.lumi.message.%'", -1, *total, null) == SQLITE_OK {
        bind_text(total, 1, owner)
        lumi_has_older = SqliteStep(total) == SQLITE_ROW && SqliteColumnInt64(total, 0) > lumi_count
        SqliteFinalize(total)
    }
    lumi_storage_revision = storage_data_revision()
}

LumiStoreLoadOlder :: () -> bool {
    LumiStoreLoad()
    if !lumi_has_older || lumi_store_error {
        return false
    }
    previous := lumi_count
    lumi_history_limit += LUMI_CHAT_MAX
    lumi_storage_revision = -1
    LumiStoreLoad()
    return !lumi_store_error && lumi_count > previous
}

LumiJsonString :: (out: *Vec(u8), value: string) {
    BuilderPrint(out, "\"")
    for byte: value {
        if byte == cast(u8)34 {
            BuilderPrint(out, "\\\"")
        } else if byte == cast(u8)92 {
            BuilderPrint(out, "\\\\")
        } else if byte == cast(u8)10 {
            BuilderPrint(out, "\\n")
        } else if byte == cast(u8)13 {
            BuilderPrint(out, "\\r")
        } else if byte == cast(u8)9 {
            BuilderPrint(out, "\\t")
        } else if byte >= cast(u8)32 {
            unused VecPush(out.*, byte)
        }
    }
    BuilderPrint(out, "\"")
}

LumiStoreSave :: () -> bool {
    return !lumi_store_error
}

LumiStoreAppend :: (text: string, user: bool) {
    unused LumiStoreAppendCard(text, user, LUMI_CHAT_TEXT, "")
}

LumiStoreAppendCard :: (text: string, user: bool, kind: s32, payload: string) -> bool {
    if text.count == 0 || text.count >= LUMI_INPUT_MAX {
        return false
    }
    if kind < LUMI_CHAT_TEXT || kind > LUMI_CHAT_FEEDBACK ||
    (kind != LUMI_CHAT_TEXT && user) ||
    (kind == LUMI_CHAT_PROGRESS && !LumiChartRead(payload).valid) ||
    (kind == LUMI_CHAT_FEEDBACK && payload.count != 32) ||
    (kind != LUMI_CHAT_PROGRESS && kind != LUMI_CHAT_FEEDBACK && payload.count != 0) {
        return false
    }
    LumiStoreLoad()
    if lumi_store_error { return false }
    nonce: [65]u8
    if !NativeNonce(null, nonce[:]) { return false }
    key: string
    if lumi_next_message_id.count > 0 {
        key = PackageText("cell.lumi.message.", lumi_next_message_id)
    } else {
        key = PackageText("cell.lumi.message.", TextFromCString(*nonce[0]))
    }
    defer { PackageFree(key) }
    out: Vec(u8)
    BuilderPrint(*out, "{\"time\":%,\"user\":%,\"kind\":%,\"text\":", CellRecordClock(), ifx user then 1 else 0, kind)
    LumiJsonString(*out, text)
    BuilderPrint(*out, ",\"payload\":")
    LumiJsonString(*out, payload)
    BuilderPrint(*out, "}")
    value := BuilderFinish(out)
    defer { PackageFree(value) }
    if !CellRecordWrite(key, value) { return false }
    lumi_next_message_id = ""
    lumi_storage_revision = storage_data_revision()
    // Keep the messages already loaded while new replies arrive. Once older
    // history is expanded, appending never discards the reading position.
    if lumi_count == lumi_history_limit {
        lumi_history_limit += 1
    }
    row := LumiChatRow.{.text = PackageText(text, ""), .user = user,
        .kind = kind, .payload = PackageText(payload, "")}
    if !VecPush(lumi_rows, row) {
        PackageFree(row.text)
        PackageFree(row.payload)
        lumi_storage_revision = -1
        return false
    }
    lumi_count += 1
    lumi_store_revision += 1
    return true
}

LumiStoreRevision :: () -> u64 {
    return lumi_store_revision
}

LumiStoreCount :: () -> s32 {
    LumiStoreLoad()
    return lumi_count
}

LumiStoreRow :: (index: s32) -> LumiChatRow {
    if index < 0 || index >= lumi_count {
        return LumiChatRow.{}
    }
    return lumi_rows[index]
}
