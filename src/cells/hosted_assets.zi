// The assets a hosted app may draw through Kryon's widget host: Inner
// Breeze's own package resources, photos saved in the Diary and photos of
// the account's media library.
#import, file "asset_paths.zi";
#import, file "module_types.zi";
#import, file "diary_store.zi";
#import, file "node_apps.zi";
#import, file "media_store.zi";

HostedAssetAllowed :: (path: string) -> bool {
    if path.count == 0 || PackageResourceValid(path, MODULE_INBE) || NodeAppAssetAllowed(path) {
        return true
    }
    if path.count > 6 && path[:6] == "media/" {
        return MediaAssetAllowed(path)
    }
    if path.count <= 17 || path[:13] != "diary/photos/" {
        return false
    }
    at := path.count - 1
    while at > 13 && path[at] != cast(u8)46 {
        at -= 1
    }
    extension := path[at + 1:]
    return DiaryStoreNameValid(path[13:at]) &&
    (extension == "png" || extension == "jpg" || extension == "gif" || extension == "webp")
}
