    codec.fields[7].name = ModuleTextData("speed_level")
    codec.fields[7].value = ModuleScalar("s32", cast(s64)data.speed_level)
    codec.fields[8].name = ModuleTextData("breath_frame")
    codec.fields[8].value = ModuleScalar("s32", cast(s64)data.breath_frame)
    codec.fields[9].name = ModuleTextData("breath_half_ticks")
    codec.fields[9].value = ModuleScalar("s32", cast(s64)data.breath_half_ticks)
    codec.fields[10].name = ModuleTextData("frame")
    codec.fields[10].value = ModuleScalar("s32", cast(s64)data.frame)
    codec.fields[11].name = ModuleTextData("breathtick")
    codec.fields[11].value = ModuleScalar("s32", cast(s64)data.breathtick)
    codec.fields[12].name = ModuleTextData("sectick")
    codec.fields[12].value = ModuleScalar("s32", cast(s64)data.sectick)
    codec.fields[13].name = ModuleTextData("halftick")
    codec.fields[13].value = ModuleScalar("s32", cast(s64)data.halftick)
    codec.fields[14].name = ModuleTextData("max_rounds")
    codec.fields[14].value = ModuleScalar("s32", cast(s64)data.max_rounds)
    codec.fields[15].name = ModuleTextData("pause_seconds")
    codec.fields[15].value = ModuleScalar("s32", cast(s64)data.pause_seconds)
    codec.fields[16].name = ModuleTextData("play_in_background")
    codec.fields[16].value = ModuleScalar("s32", cast(s64)data.play_in_background)
    codec.fields[17].name = ModuleTextData("progressive_speed")
    codec.fields[17].value = ModuleScalar("s32", cast(s64)data.progressive_speed)
    codec.fields[18].name = ModuleTextData("progressive_start_speed")
    codec.fields[18].value = ModuleScalar("s32", cast(s64)data.progressive_start_speed)
    codec.fields[19].name = ModuleTextData("breath_animation")
    codec.fields[19].value = ModuleScalar("s32", cast(s64)data.breath_animation)
    codec.fields[20].name = ModuleTextData("count")
    codec.fields[20].value.kind = cast(s32)HostArray
    codec.fields[20].value.type_name = ModuleTextData("[4]u8")
    codec.fields[20].value.length = 4
    codec.fields[20].value.elements = *codec.count_elements[0]
    {
        i: s32 = 0
        while i < 4 {
            codec.count_elements[i] = ModuleScalar("u8", cast(s64)data.count[i])
            i += 1
        }
    }
    codec.fields[21].name = ModuleTextData("maxbreaths")
    codec.fields[21].value.kind = cast(s32)HostArray
    codec.fields[21].value.type_name = ModuleTextData("[4]u8")
    codec.fields[21].value.length = 4
    codec.fields[21].value.elements = *codec.maxbreaths_elements[0]
    {
        i: s32 = 0
        while i < 4 {
            codec.maxbreaths_elements[i] = ModuleScalar("u8", cast(s64)data.maxbreaths[i])
            i += 1
        }
    }
    codec.fields[22].name = ModuleTextData("results")
    codec.fields[22].value.kind = cast(s32)HostArray
    codec.fields[22].value.type_name = ModuleTextData("[12][4]u8")
    codec.fields[22].value.length = 12
    codec.fields[22].value.elements = *codec.results_rows[0]
    {
        i: s32 = 0
        while i < 12 {
            codec.results_rows[i].kind = cast(s32)HostArray
            codec.results_rows[i].type_name = ModuleTextData("[4]u8")
            codec.results_rows[i].length = 4
            codec.results_rows[i].elements = *codec.results_elements[i][0]
            j: s32 = 0
            while j < 4 {
                codec.results_elements[i][j] = ModuleScalar("u8", cast(s64)data.results[i][j])
                j += 1
            }
            i += 1
        }
    }
    codec.fields[23].name = ModuleTextData("completed")
    codec.fields[23].value = ModuleScalar("s32", cast(s64)data.completed)
    return value
}

DecodeBreathSession :: (value: HostValue) -> BreathSession {
    data: BreathSession
    data.screen = cast(s32)value.fields[0].value.integer
    data.phase = cast(s32)value.fields[1].value.integer
    data.round = cast(s32)value.fields[2].value.integer
    data.r = cast(s32)value.fields[3].value.integer
    data.rmin = cast(s32)value.fields[4].value.integer
    data.rmax = cast(s32)value.fields[5].value.integer
    data.dir = cast(s32)value.fields[6].value.integer
    data.speed_level = cast(s32)value.fields[7].value.integer
    data.breath_frame = cast(s32)value.fields[8].value.integer
    data.breath_half_ticks = cast(s32)value.fields[9].value.integer
    data.frame = cast(s32)value.fields[10].value.integer
    data.breathtick = cast(s32)value.fields[11].value.integer
    data.sectick = cast(s32)value.fields[12].value.integer
    data.halftick = cast(s32)value.fields[13].value.integer
    data.max_rounds = cast(s32)value.fields[14].value.integer
    data.pause_seconds = cast(s32)value.fields[15].value.integer
    data.play_in_background = cast(s32)value.fields[16].value.integer
    data.progressive_speed = cast(s32)value.fields[17].value.integer
    data.progressive_start_speed = cast(s32)value.fields[18].value.integer
    data.breath_animation = cast(s32)value.fields[19].value.integer
    {
        i: s32 = 0
        while i < 4 {
            data.count[i] = cast(u8)value.fields[20].value.elements[i].bits
            i += 1
        }
    }
    {
        i: s32 = 0
        while i < 4 {
            data.maxbreaths[i] = cast(u8)value.fields[21].value.elements[i].bits
            i += 1
        }
    }
    {
        i: s32 = 0
        while i < 12 {
            j: s32 = 0
            while j < 4 {
                data.results[i][j] = cast(u8)value.fields[22].value.elements[i].elements[j].bits
                j += 1
            }
            i += 1
        }
    }
    data.completed = cast(s32)value.fields[23].value.integer
    return data
}

