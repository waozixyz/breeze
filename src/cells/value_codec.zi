    if TextFromCString(value.fields[10].name) != "paused" {
        return false
    }
    if !ModuleScalarValid(value.fields[10].value, "bool", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[11].name) != "completed" {
        return false
