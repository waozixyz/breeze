    if TextFromCString(value.fields[8].name) != "elapsed_seconds" {
        return false
    }
    if !ModuleScalarValid(value.fields[8].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[9].name) != "elapsed" {
        return false
    }
    if !ModuleScalarValid(value.fields[9].value, "float64", cast(s32)HostReal) {
        return false
