        return false
    }
    if TextFromCString(value.fields[28].name) != "marks" {
        return false
    }
    if !ModuleArrayValid(value.fields[28].value, "[32]u8", 32) {
        return false
    }
    {
        i: s32 = 0
        while i < 32 {
            if !ModuleScalarValid(value.fields[28].value.elements[i], "u8", cast(s32)HostUnsigned) {
                return false
            }
            i += 1
        }
    }
    return true
}

