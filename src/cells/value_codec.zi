ValidBreathSession :: (value: HostValue) -> bool {
    if value.kind != cast(s32)HostRecord || TextFromCString(value.type_name) != "BreathSession" ||
    value.field_count != 24 || value.fields == null {
        return false
    }
    if TextFromCString(value.fields[0].name) != "screen" {
        return false
    }
    if !ModuleScalarValid(value.fields[0].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[1].name) != "phase" {
        return false
    }
    if !ModuleScalarValid(value.fields[1].value, "s32", cast(s32)HostInteger) {
