    data.parent_id = TextFromBytes(BytesFromPointer(value.fields[2].value.data, cast(u64)value.fields[2].value.length))
    data.title = TextFromBytes(BytesFromPointer(value.fields[3].value.data, cast(u64)value.fields[3].value.length))
    data.comment = TextFromBytes(BytesFromPointer(value.fields[4].value.data, cast(u64)value.fields[4].value.length))
    data.done = cast(s32)value.fields[5].value.integer
    data.sort_order = cast(s32)value.fields[6].value.integer
    return data
}

