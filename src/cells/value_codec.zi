                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 20, "count")
        if field_at >= 0 {
            if !ModuleArrayValid(value.fields[field_at].value, "[4]u8", 4) {
                return false
            }
            {
                i: s32 = 0
                while i < 4 {
                    if !ModuleScalarValid(value.fields[field_at].value.elements[i], "u8", cast(s32)HostUnsigned) {
                        return false
                    }
                    i += 1
                }
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 21, "maxbreaths")
        if field_at >= 0 {
            if !ModuleArrayValid(value.fields[field_at].value, "[4]u8", 4) {
                return false
            }
            {
                i: s32 = 0
                while i < 4 {
                    if !ModuleScalarValid(value.fields[field_at].value.elements[i], "u8", cast(s32)HostUnsigned) {
                        return false
                    }
                    i += 1
                }
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 22, "results")
        if field_at >= 0 {
            if !ModuleArrayValid(value.fields[field_at].value, "[12][4]u8", 12) {
                return false
            }
            {
                i: s32 = 0
                while i < 12 {
                    if !ModuleArrayValid(value.fields[field_at].value.elements[i], "[4]u8", 4) {
                        return false
                    }
                    j: s32 = 0
                    while j < 4 {
                        if !ModuleScalarValid(value.fields[field_at].value.elements[i].elements[j], "u8", cast(s32)HostUnsigned) {
                            return false
                        }
                        j += 1
                    }
                    i += 1
                }
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 23, "completed")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    return true
}

