        return false
    }
    if TextFromCString(value.fields[3].name) != "r" {
        return false
    }
    if !ModuleScalarValid(value.fields[3].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[4].name) != "rmin" {
        return false
    }
    if !ModuleScalarValid(value.fields[4].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[5].name) != "rmax" {
        return false
    }
    if !ModuleScalarValid(value.fields[5].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[6].name) != "dir" {
        return false
    }
    if !ModuleScalarValid(value.fields[6].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[7].name) != "speed_level" {
        return false
    }
    if !ModuleScalarValid(value.fields[7].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[8].name) != "breath_frame" {
        return false
    }
    if !ModuleScalarValid(value.fields[8].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[9].name) != "breath_half_ticks" {
        return false
    }
    if !ModuleScalarValid(value.fields[9].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[10].name) != "frame" {
        return false
    }
    if !ModuleScalarValid(value.fields[10].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[11].name) != "breathtick" {
        return false
    }
    if !ModuleScalarValid(value.fields[11].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[12].name) != "sectick" {
        return false
    }
    if !ModuleScalarValid(value.fields[12].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[13].name) != "halftick" {
        return false
    }
    if !ModuleScalarValid(value.fields[13].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[14].name) != "max_rounds" {
        return false
    }
    if !ModuleScalarValid(value.fields[14].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[15].name) != "pause_seconds" {
        return false
    }
    if !ModuleScalarValid(value.fields[15].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[16].name) != "play_in_background" {
        return false
    }
    if !ModuleScalarValid(value.fields[16].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[17].name) != "progressive_speed" {
        return false
    }
    if !ModuleScalarValid(value.fields[17].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[18].name) != "progressive_start_speed" {
        return false
    }
    if !ModuleScalarValid(value.fields[18].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[19].name) != "breath_animation" {
        return false
    }
    if !ModuleScalarValid(value.fields[19].value, "s32", cast(s32)HostInteger) {
        return false
    }
    if TextFromCString(value.fields[20].name) != "count" {
        return false
    }
    if !ModuleArrayValid(value.fields[20].value, "[4]u8", 4) {
        return false
    }
    {
        i: s32 = 0
        while i < 4 {
            if !ModuleScalarValid(value.fields[20].value.elements[i], "u8", cast(s32)HostUnsigned) {
                return false
            }
            i += 1
        }
    }
    if TextFromCString(value.fields[21].name) != "maxbreaths" {
        return false
    }
    if !ModuleArrayValid(value.fields[21].value, "[4]u8", 4) {
        return false
    }
    {
        i: s32 = 0
        while i < 4 {
            if !ModuleScalarValid(value.fields[21].value.elements[i], "u8", cast(s32)HostUnsigned) {
                return false
            }
            i += 1
        }
    }
    if TextFromCString(value.fields[22].name) != "results" {
        return false
    }
    if !ModuleArrayValid(value.fields[22].value, "[12][4]u8", 12) {
        return false
    }
    {
        i: s32 = 0
        while i < 12 {
            if !ModuleArrayValid(value.fields[22].value.elements[i], "[4]u8", 4) {
                return false
            }
            j: s32 = 0
            while j < 4 {
                if !ModuleScalarValid(value.fields[22].value.elements[i].elements[j], "u8", cast(s32)HostUnsigned) {
                    return false
                }
                j += 1
            }
            i += 1
        }
    }
    if TextFromCString(value.fields[23].name) != "completed" {
        return false
    }
    if !ModuleScalarValid(value.fields[23].value, "s32", cast(s32)HostInteger) {
        return false
    }
    return true
}

