PracticeMessageCodec :: struct {
    fields: [15]HostField
    breathing: BreathSessionCodec
    salutation: SunSalutationPracticeStateCodec
    patterns: PatternsCodec
}

EncodePracticeMessage :: (data: PracticeMessage, codec: *PracticeMessageCodec) -> HostValue {
    value: HostValue
    value.kind = cast(s32)HostRecord
    value.type_name = ModuleTextData("PracticeMessage")
    value.fields = *codec.fields[0]
    value.field_count = 15
    codec.fields[0].name = ModuleTextData("abi")
    codec.fields[0].value = ModuleScalar("s32", cast(s64)data.abi)
    codec.fields[1].name = ModuleTextData("action")
    codec.fields[1].value = ModuleScalar("s32", cast(s64)data.action)
    codec.fields[2].name = ModuleTextData("breathing")
    codec.fields[2].value = EncodeBreathSession(data.breathing, *codec.breathing)
    codec.fields[3].name = ModuleTextData("salutation")
    codec.fields[3].value = EncodeSunSalutationPracticeState(data.salutation, *codec.salutation)
    codec.fields[4].name = ModuleTextData("patterns")
    codec.fields[4].value = EncodePatterns(data.patterns, *codec.patterns)
    codec.fields[5].name = ModuleTextData("remaining_seconds")
    codec.fields[5].value = ModuleScalar("s32", cast(s64)data.remaining_seconds)
    codec.fields[6].name = ModuleTextData("remainder_ms")
    codec.fields[6].value = ModuleScalar("s32", cast(s64)data.remainder_ms)
    codec.fields[7].name = ModuleTextData("elapsed_ms")
    codec.fields[7].value = ModuleScalar("s32", cast(s64)data.elapsed_ms)
    codec.fields[8].name = ModuleTextData("elapsed_seconds")
    codec.fields[8].value = ModuleScalar("s32", cast(s64)data.elapsed_seconds)
    codec.fields[9].name = ModuleTextData("elapsed")
    codec.fields[9].value.kind = cast(s32)HostReal
    codec.fields[9].value.type_name = ModuleTextData("float64")
    codec.fields[9].value.real = cast(float64)data.elapsed
    codec.fields[10].name = ModuleTextData("paused")
    codec.fields[10].value = ModuleScalar("bool", ifx data.paused then 1 else 0)
    codec.fields[11].name = ModuleTextData("completed")
    codec.fields[11].value = ModuleScalar("bool", ifx data.completed then 1 else 0)
    codec.fields[12].name = ModuleTextData("cue")
    codec.fields[12].value = ModuleScalar("s32", cast(s64)data.cue)
    codec.fields[13].name = ModuleTextData("succeeded")
    codec.fields[13].value = ModuleScalar("bool", ifx data.succeeded then 1 else 0)
    codec.fields[14].name = ModuleTextData("screen")
    codec.fields[14].value = ModuleScalar("s32", cast(s64)data.screen)
    return value
}

