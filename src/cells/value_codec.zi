    data.index = cast(s32)value.fields[2].value.integer
    data.count = cast(s32)value.fields[3].value.integer
    data.selected = cast(s32)value.fields[4].value.integer
    data.screen_mode = cast(s32)value.fields[5].value.integer
    data.view_mode = cast(s32)value.fields[6].value.integer
    data.tab = cast(s32)value.fields[7].value.integer
    data.day_index = cast(s32)value.fields[8].value.integer
    data.weekdays = cast(s32)value.fields[9].value.integer
    data.counter_enabled = cast(s32)value.fields[10].value.integer
    data.counter_target = cast(s32)value.fields[11].value.integer
    data.linked_count = cast(s32)value.fields[12].value.integer
    data.sync_activity = cast(s32)value.fields[13].value.integer
    data.sync_mode = cast(s32)value.fields[14].value.integer
    data.reminder_hour = cast(s32)value.fields[15].value.integer
    data.modal_active = value.fields[16].value.integer != 0
    data.scheduled = value.fields[17].value.integer != 0
    data.completed = value.fields[18].value.integer != 0
    data.decrement = value.fields[19].value.integer != 0
    data.is_new = value.fields[20].value.integer != 0
    data.active = value.fields[21].value.integer != 0
    data.name = TextFromBytes(BytesFromPointer(value.fields[22].value.data, cast(u64)value.fields[22].value.length))
    data.description = TextFromBytes(BytesFromPointer(value.fields[23].value.data, cast(u64)value.fields[23].value.length))
    data.color = DecodeColor(value.fields[24].value)
    data.succeeded = value.fields[25].value.integer != 0
    data.reset_scroll = value.fields[26].value.integer != 0
    data.cancel_edit = value.fields[27].value.integer != 0
    data.name_error = cast(s32)value.fields[28].value.integer
    data.day_action = cast(s32)value.fields[29].value.integer
    data.block_click = value.fields[30].value.integer != 0
    data.screen = cast(s32)value.fields[31].value.integer
    return data
}

