                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 4, "paused")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 5, "phase")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 6, "phase_second")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 7, "frame_ticks")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 8, "second_accumulator")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "float64", cast(s32)HostReal) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 9, "cycle")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    {
        field_at := ModuleFieldAt(value, 10, "elapsed_seconds")
        if field_at >= 0 {
            if !ModuleScalarValid(value.fields[field_at].value, "s32", cast(s32)HostInteger) {
                return false
            }
        }
    }
    return true
}

ValidPracticeMessage :: (value: HostValue) -> bool {
    if value.kind != cast(s32)HostRecord || TextFromCString(value.type_name) != "PracticeMessage" ||
    value.field_count > cast(usize)MODULE_FIELD_LIMIT ||
    (value.field_count > cast(usize)0 && value.fields == null) {
        return false
    }
    {
        field_at := ModuleFieldAt(value, 0, "abi")
