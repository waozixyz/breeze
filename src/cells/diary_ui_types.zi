#import "session"
#import "text_input_props"

// Device observations and retained editor values, never native pointers.
DiaryUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    now: float64
    input: TextAreaInput
    focused: bool
    selecting: bool
    scroll: s32
    calendar_scroll: s32
    page_scroll: s32
    save_at: float64
    photo_error: bool
    photo_requested: bool
    photo_format: string
    clipboard_write: bool
    clipboard_text: string
}
