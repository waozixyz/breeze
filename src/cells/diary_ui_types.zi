#import "session"
#import "text_input_props"

// Device observations and retained editor values, never native pointers.
DiaryUiFrame :: struct {
    session: Session
    width: s32
    height: s32
    bottom: s32
    scale: float32
    font: s32
    now: float64
    input: TextAreaInput
    focused: bool
    selecting: bool
    scroll: s32
    calendar_scroll: s32
    page_scroll: s32
    // How far the day's photos under the entry are scrolled sideways.
    photos_scroll: s32
    save_at: float64
    photo_error: bool
    photo_requested: bool
    // The theme's colors for links and for list and quote marks in the
    // entry's Markdown.
    link_color: u32
    muted_color: u32
    clipboard_write: bool
    clipboard_text: string
    // Undo, redo and spelling run in the host, which keeps the entry's
    // earlier versions and reaches the node.
    can_undo: bool
    can_redo: bool
    undo_requested: bool
    redo_requested: bool
    spelling_requested: bool
    spelling_busy: bool
    // A locale key while a spelling check has something to say.
    spelling_notice: string
}
