// Bundles can supply app resources, never publisher pins or private data.
#import, file "module_types.zi";

// Read already installed bundles while publishing only the Cells spelling.
CellBundlePath :: (path: string) -> string {
    if path == "subapps/habits.zib" {
        return "cells/habits.zib"
    }
    if path == "subapps/practices.zib" {
        return "cells/practices.zib"
    }
    if path == "subapps/lists.zib" {
        return "cells/lists.zib"
    }
    if path == "subapps/diary.zib" {
        return "cells/diary.zib"
    }
    return path
}

PackageResourceValid :: (name: string, kind: s32) -> bool {
    if name.count < 1 || name.count > 512 || name[0] == cast(u8)47 ||
    name[name.count - 1] == cast(u8)47 {
        return false
    }
    component: s64 = 0
    for index: cast(s64)0..name.count - 1 {
        byte := name[index]
        if byte < cast(u8)32 || byte == cast(u8)92 || byte == cast(u8)58 {
            return false
        }
        if byte == cast(u8)47 || index == name.count - 1 {
            end := ifx byte == cast(u8)47 then index else index + 1
            part := name[component:end]
            if part.count == 0 || part == "." || part == ".." {
                return false
            }
            component = index + 1
        }
    }
    if kind == MODULE_PRACTICE {
        return (name.count > 17 && name[:17] == "assets/practices/") ||
        (name.count > 14 && name[:14] == "assets/sounds/")
    }
    if kind == MODULE_HABITS {
        return name.count > 14 && name[:14] == "assets/habits/"
    }
    if kind == MODULE_LISTS {
        return name.count > 13 && name[:13] == "assets/lists/"
    }
    if kind == MODULE_LUMI {
        return name.count > 12 && name[:12] == "assets/lumi/"
    }
    if kind == MODULE_DIARY {
        return name.count > 13 && name[:13] == "assets/diary/"
    }
    if kind != MODULE_INBE {
        return false
    }
    return (name.count > 7 && name[:7] == "assets/") ||
    (name.count > 8 && name[:8] == "locales/") ||
    (name.count > 7 && name[:7] == "styles/") ||
    (name.count > 7 && name[:7] == "themes/") ||
    (name.count > 6 && name[:6] == "icons/")
}
