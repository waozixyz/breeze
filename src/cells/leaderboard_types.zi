#import, file "module_types.zi";
LEADERBOARD_ROUTE :: 1
LEADERBOARD_FRAME :: 2
LEADERBOARD_STREAK :: 0
LEADERBOARD_AVERAGE :: 1

// The host owns friends, server results and local stats. The board chooses
// what to show and asks the host to fetch or reorder.
LeaderboardMessage :: struct {
    abi: s32
    action: s32
    screen: s32
    practice: s32
    metric: s32
    row_count: s32
    signed_in: bool
    loading: bool
    has_average: bool
    refresh: bool
    succeeded: bool
    // The installed practices in Practice's order. Hosts that do not list
    // them leave practices_listed false.
    practices_listed: bool
    practice_count: s32
    practices: [16]s32
}
