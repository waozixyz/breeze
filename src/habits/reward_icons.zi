// Reward-only choices append to saved habit IDs without changing them.
#import, file "habit_icons.zi";

REWARD_ICON_COFFEE :: 85
REWARD_ICON_BUBBLE_TEA :: 86
REWARD_ICON_CHOCOLATE :: 87
REWARD_ICON_CANDLE :: 88
REWARD_ICON_ENERGY_DRINK :: 89
REWARD_ICON_COUNT :: 89

RewardIconAsset :: (icon: s32) -> string {
    if icon == HABIT_ICON_SODA {
        return "assets/habits/rewards/soda.webp"
    }
    if icon == REWARD_ICON_COFFEE {
        return "assets/habits/rewards/coffee.webp"
    }
    if icon == REWARD_ICON_BUBBLE_TEA {
        return "assets/habits/rewards/bubble-tea.webp"
    }
    if icon == REWARD_ICON_CHOCOLATE {
        return "assets/habits/rewards/chocolate.webp"
    }
    if icon == REWARD_ICON_CANDLE {
        return "assets/habits/rewards/candle.webp"
    }
    return ""
}

RewardIconLabelKey :: (icon: s32) -> string {
    if icon == REWARD_ICON_ENERGY_DRINK {
        return "reward_icon_energy_drink"
    }
    if icon == HABIT_ICON_SODA {
        return "reward_icon_soda"
    }
    if icon == REWARD_ICON_COFFEE {
        return "reward_icon_coffee"
    }
    if icon == REWARD_ICON_BUBBLE_TEA {
        return "reward_icon_bubble_tea"
    }
    if icon == REWARD_ICON_CHOCOLATE {
        return "reward_icon_chocolate"
    }
    if icon == REWARD_ICON_CANDLE {
        return "reward_icon_candle"
    }
    return "habit_icon_label"
}

// Reward-only vectors retain stable saved IDs.
RewardIconShape :: (icon: s32) -> string {
    if icon == REWARD_ICON_ENERGY_DRINK {
        // A slim can with a lightning bolt.
        return "S1.6rr:M8 3H16M8 5H16L17 7V20L16 21H8L7 20V7L8 5ZM7 8H17M7 18H17M13 9L10 13H13L11 17"
    }
    return HabitIconShape(icon)
}
