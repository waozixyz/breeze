// Reward-only choices append to saved habit IDs without changing them.
#import, file "habit_icons.zi";

REWARD_ICON_COFFEE :: 85
REWARD_ICON_BUBBLE_TEA :: 86
REWARD_ICON_CHOCOLATE :: 87
REWARD_ICON_CANDLE :: 88
REWARD_ICON_COUNT :: 88

RewardIconAsset :: (icon: s32) -> string {
    if icon == HABIT_ICON_SODA {
        return "assets/habits/rewards/soda.png"
    }
    if icon == REWARD_ICON_COFFEE {
        return "assets/habits/rewards/coffee.png"
    }
    if icon == REWARD_ICON_BUBBLE_TEA {
        return "assets/habits/rewards/bubble-tea.png"
    }
    if icon == REWARD_ICON_CHOCOLATE {
        return "assets/habits/rewards/chocolate.png"
    }
    if icon == REWARD_ICON_CANDLE {
        return "assets/habits/rewards/candle.png"
    }
    return ""
}

RewardIconLabelKey :: (icon: s32) -> string {
    if icon == HABIT_ICON_SODA {
        return "reward_icon_soda"
    }
    if icon == REWARD_ICON_COFFEE {
        return "reward_icon_coffee"
    }
    if icon == REWARD_ICON_BUBBLE_TEA {
        return "reward_icon_bubble_tea"
    }
    if icon == REWARD_ICON_CHOCOLATE {
        return "reward_icon_chocolate"
    }
    if icon == REWARD_ICON_CANDLE {
        return "reward_icon_candle"
    }
    return "habit_icon_label"
}
