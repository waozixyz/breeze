// What changed in a habit's settings, as the habit's activity log keeps it,
// and the good range a question had at any time since.
#import "drawing_props"
#import, file "habit_types.zi";
#import, file "habit_questions.zi";
#import, file "habit_schedule.zi";
#import, file "../app/text_buffers.zi";

HABIT_CHANGE_CREATED :: 1
HABIT_CHANGE_NAME :: 2
HABIT_CHANGE_COLOR :: 3
HABIT_CHANGE_ICON :: 4
HABIT_CHANGE_DESCRIPTION :: 5
HABIT_CHANGE_SCHEDULE :: 6
HABIT_CHANGE_REMINDER :: 7
HABIT_CHANGE_TRACKING :: 8
HABIT_CHANGE_PRACTICES :: 9
HABIT_CHANGE_PAUSED :: 10
HABIT_CHANGE_RESUMED :: 11
HABIT_CHANGE_QUESTION_ADDED :: 12
HABIT_CHANGE_QUESTION_REMOVED :: 13
HABIT_CHANGE_QUESTION_WORDS :: 14
HABIT_CHANGE_QUESTION_ANSWER :: 15
HABIT_CHANGE_QUESTION_GOAL :: 16
HABIT_CHANGE_DELETED :: 17
HABIT_CHANGE_SPAN_GOAL :: 18
HABIT_CHANGE_DIFFICULTY :: 19

HABIT_CHANGE_VALUE_SIZE :: 256
// A save can change every setting and every question.
HABIT_CHANGE_MAX :: 14 + HABIT_QUESTION_MAX * 4

// One change of a habit's settings: what changed, the question it concerns
// with its words then, and the value before and after as stored text.
HabitChange :: struct {
    kind: s32
    question: s64
    question_text: [HABIT_QUESTION_TEXT_SIZE]u8
    before: [HABIT_CHANGE_VALUE_SIZE]u8
    after: [HABIT_CHANGE_VALUE_SIZE]u8
}

// A change and when it was made.
HabitChangeRecord :: struct {
    at: s64
    change: HabitChange
}

// A goal as a change keeps it: "kind:low:high", and for a question's goal
// its answer type after, "kind:low:high:type", so its bounds read as
// numbers or times.
HabitGoalText :: (goal: HabitGoal, output: []u8) -> string {
    return HabitQuestionGoalText(goal, 0, output)
}

HabitQuestionGoalText :: (goal: HabitGoal, answer_type: s32,
    output: []u8) -> string {
    cursor: s32 = 0
    output[0] = cast(u8)0
    unused TextBufferAppendNumber(output, *cursor, goal.kind)
    unused TextBufferAppendByte(output, *cursor, cast(u8)58)
    unused TextBufferAppendNumber(output, *cursor, goal.low)
    unused TextBufferAppendByte(output, *cursor, cast(u8)58)
    unused TextBufferAppendNumber(output, *cursor, goal.high)
    if answer_type > 0 {
        unused TextBufferAppendByte(output, *cursor, cast(u8)58)
        unused TextBufferAppendNumber(output, *cursor, answer_type)
    }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// The answer type a question's goal change keeps, or HABIT_ANSWER_NUMBER.
HabitChangeAnswerType :: (change: *HabitChange) -> s32 {
    text := AppTextFromCString(*change.after[0], HABIT_CHANGE_VALUE_SIZE)
    part: s32 = 0
    answer_type: s32 = 0
    index: s64 = 0
    while index < text.count {
        byte := text[index]
        if byte == cast(u8)58 {
            part += 1
        } else if part == 3 && byte >= cast(u8)48 && byte <= cast(u8)57 {
            answer_type = answer_type * 10 + cast(s32)byte - 48
        }
        index += 1
    }
    return ifx answer_type > 0 then answer_type else HABIT_ANSWER_NUMBER
}

HabitGoalFromText :: (text: string) -> HabitGoal {
    goal: HabitGoal
    parts: [3]s32
    part: s32 = 0
    negative := false
    index: s64 = 0
    while index < text.count && part < 3 {
        byte := text[index]
        if byte == cast(u8)58 {
            if negative { parts[part] = -parts[part] }
            part += 1
            negative = false
        } else if byte == cast(u8)45 {
            negative = true
        } else if byte >= cast(u8)48 && byte <= cast(u8)57 {
            parts[part] = parts[part] * 10 + cast(s32)byte - 48
        }
        index += 1
    }
    if part < 3 && negative { parts[part] = -parts[part] }
    goal.kind = parts[0]
    goal.low = parts[1]
    goal.high = parts[2]
    return goal
}

HabitGoalSame :: (first: HabitGoal, second: HabitGoal) -> bool {
    if first.kind != second.kind { return false }
    if first.kind == HABIT_GOAL_AT_LEAST { return first.low == second.low }
    if first.kind == HABIT_GOAL_AT_MOST { return first.high == second.high }
    if first.kind == HABIT_GOAL_BETWEEN {
        return first.low == second.low && first.high == second.high
    }
    return true
}

HabitTrackingText :: (habit: *Habit, output: []u8) -> string {
    output[0] = cast(u8)0
    if habit.span != 0 {
        unused AppCopyText("span", output)
    } else if habit.counter_enabled != 0 {
        cursor: s32 = 0
        unused AppCopyText("count:", output)
        cursor = 6
        unused TextBufferAppendNumber(output, *cursor, habit.counter_target)
    } else {
        unused AppCopyText("check", output)
    }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

HabitColorText :: (color: Color, output: []u8) -> string {
    digits := "0123456789abcdef"
    values: [3]u8 = .[color.r, color.g, color.b]
    output[0] = cast(u8)35
    index: s32 = 0
    while index < 3 {
        output[1 + index * 2] = digits[cast(s64)(values[index] / 16)]
        output[2 + index * 2] = digits[cast(s64)(values[index] % 16)]
        index += 1
    }
    output[7] = cast(u8)0
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

HabitChangeAdd :: (output: []HabitChange, count: *s32, kind: s32,
    before: string, after: string) -> *HabitChange {
    if count.* >= cast(s32)output.count {
        return null
    }
    change := *output[count.*]
    change.* = HabitChange.{}
    change.kind = kind
    unused AppCopyText(before, change.before[:])
    unused AppCopyText(after, change.after[:])
    count.* += 1
    return change
}

HabitChangeNumberText :: (value: s32, output: []u8) -> string {
    unused AppFormatS32(value, output)
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

HabitChangeAddNumber :: (output: []HabitChange, count: *s32, kind: s32,
    before: s32, after: s32) {
    first: [24]u8
    second: [24]u8
    unused HabitChangeAdd(output, count, kind, HabitChangeNumberText(before,
        first[:]), HabitChangeNumberText(after, second[:]))
}

HabitChangeQuestion :: (change: *HabitChange, question: *HabitQuestion) {
    if change == null { return }
    change.question = question.id
    unused AppCopyText(HabitQuestionText(question), change.question_text[:])
}

// The changes from a habit as it was to the habit as it is saved. A habit
// without before is new. The order is the editor's: details, schedule,
// tracking, then each question.
HabitChangesBetween :: (before: *Habit, after: *Habit,
    output: []HabitChange) -> s32 {
    count: s32 = 0
    // A change keeps HABIT_CHANGE_VALUE_SIZE bytes of each value.
    first: [HABIT_CHANGE_VALUE_SIZE]u8
    second: [HABIT_CHANGE_VALUE_SIZE]u8
    if before == null {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_CREATED, "",
            AppTextFromCString(*after.name[0], HABIT_NAME_SIZE))
        return count
    }
    if AppTextFromCString(*before.name[0], HABIT_NAME_SIZE) !=
    AppTextFromCString(*after.name[0], HABIT_NAME_SIZE) {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_NAME,
            AppTextFromCString(*before.name[0], HABIT_NAME_SIZE),
            AppTextFromCString(*after.name[0], HABIT_NAME_SIZE))
    }
    if before.color.r != after.color.r || before.color.g != after.color.g ||
    before.color.b != after.color.b {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_COLOR,
            HabitColorText(before.color, first[:]),
            HabitColorText(after.color, second[:]))
    }
    if before.icon != after.icon {
        HabitChangeAddNumber(output, *count, HABIT_CHANGE_ICON, before.icon,
            after.icon)
    }
    if AppTextFromCString(*before.description[0], HABIT_DESCRIPTION_SIZE) !=
    AppTextFromCString(*after.description[0], HABIT_DESCRIPTION_SIZE) {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_DESCRIPTION,
            AppTextFromCString(*before.description[0], HABIT_DESCRIPTION_SIZE),
            AppTextFromCString(*after.description[0], HABIT_DESCRIPTION_SIZE))
    }
    before_rule := HabitScheduleCurrent(before)
    after_rule := HabitScheduleCurrent(after)
    if HabitScheduleDescribe(*before_rule, first[:]) !=
    HabitScheduleDescribe(*after_rule, second[:]) {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_SCHEDULE,
            HabitScheduleDescribe(*before_rule, first[:]),
            HabitScheduleDescribe(*after_rule, second[:]))
    }
    if before.reminder_hour != after.reminder_hour {
        HabitChangeAddNumber(output, *count, HABIT_CHANGE_REMINDER,
            before.reminder_hour, after.reminder_hour)
    }
    if before.difficulty != after.difficulty {
        HabitChangeAddNumber(output, *count, HABIT_CHANGE_DIFFICULTY,
            before.difficulty, after.difficulty)
    }
    if HabitTrackingText(before, first[:]) != HabitTrackingText(after, second[:]) {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_TRACKING,
            HabitTrackingText(before, first[:]), HabitTrackingText(after, second[:]))
    }
    before_span: HabitGoal
    after_span: HabitGoal
    if before.span != 0 {
        before_span = before.span_goal
    }
    if after.span != 0 {
        after_span = after.span_goal
    }
    if after.span != 0 && !HabitGoalSame(before_span, after_span) {
        unused HabitChangeAdd(output, *count, HABIT_CHANGE_SPAN_GOAL,
            HabitGoalText(before_span, first[:]), HabitGoalText(after_span, second[:]))
    }
    if before.sync_activity != after.sync_activity ||
    before.sync_mode != after.sync_mode {
        HabitChangeAddNumber(output, *count, HABIT_CHANGE_PRACTICES,
            before.sync_activity, after.sync_activity)
    }
    if before.deactivated != after.deactivated {
        unused HabitChangeAdd(output, *count, ifx after.deactivated != 0 then
            HABIT_CHANGE_PAUSED else HABIT_CHANGE_RESUMED, "", "")
    }
    // Questions are matched by id: removed ones, then changed and added
    // ones in the order the habit asks them.
    index: s32 = 0
    while index < before.question_count {
        old := *before.questions[index]
        kept := false
        other: s32 = 0
        while other < after.question_count {
            if after.questions[other].id == old.id { kept = true }
            other += 1
        }
        if !kept {
            HabitChangeQuestion(HabitChangeAdd(output, *count,
                HABIT_CHANGE_QUESTION_REMOVED, "", ""), old)
        }
        index += 1
    }
    index = 0
    while index < after.question_count {
        current := *after.questions[index]
        old: *HabitQuestion = null
        other: s32 = 0
        while other < before.question_count {
            if before.questions[other].id == current.id { old = *before.questions[other] }
            other += 1
        }
        if old == null {
            HabitChangeQuestion(HabitChangeAdd(output, *count,
                HABIT_CHANGE_QUESTION_ADDED, "", HabitAnswerTypeName(current.answer_type)), current)
            if current.goal.kind != HABIT_GOAL_NONE {
                none: HabitGoal
                HabitChangeQuestion(HabitChangeAdd(output, *count,
                    HABIT_CHANGE_QUESTION_GOAL, HabitQuestionGoalText(none,
                    current.answer_type, first[:]), HabitQuestionGoalText(
                    current.goal, current.answer_type, second[:])), current)
            }
        } else {
            if HabitQuestionText(old) != HabitQuestionText(current) {
                HabitChangeQuestion(HabitChangeAdd(output, *count,
                    HABIT_CHANGE_QUESTION_WORDS, HabitQuestionText(old),
                    HabitQuestionText(current)), current)
            }
            if old.answer_type != current.answer_type {
                HabitChangeQuestion(HabitChangeAdd(output, *count,
                    HABIT_CHANGE_QUESTION_ANSWER, HabitAnswerTypeName(old.answer_type),
                    HabitAnswerTypeName(current.answer_type)), current)
            }
            if !HabitGoalSame(old.goal, current.goal) {
                HabitChangeQuestion(HabitChangeAdd(output, *count,
                    HABIT_CHANGE_QUESTION_GOAL, HabitQuestionGoalText(old.goal,
                    old.answer_type, first[:]), HabitQuestionGoalText(
                    current.goal, current.answer_type, second[:])), current)
            }
        }
        index += 1
    }
    return count
}

// One goal change of a question: when it happened, and the goal before
// and after.
HabitGoalVersion :: struct {
    at: s64
    before: HabitGoal
    after: HabitGoal
}

// The goal a question had at a time: the one its last change before then
// set, or before its first change the one that change replaced. Without
// changes the question's goal now held all along.
HabitGoalAt :: (versions: []HabitGoalVersion, count: s32, current: HabitGoal,
    at: s64) -> HabitGoal {
    if count <= 0 {
        return current
    }
    goal := versions[0].before
    index: s32 = 0
    while index < count && index < cast(s32)versions.count {
        if versions[index].at <= at {
            goal = versions[index].after
        }
        index += 1
    }
    return goal
}
