// What a habit can be linked to, so that what is done elsewhere checks its
// days: each practice, by a saved session, and Diary, by a day's entry.
// Each link is one bit of a habit's sync_activity. Practices keep the bits
// of their ids; apps take bits from 24 up (Diary is 1 << 24), leaving room
// for more practices.
// Another app links by adding its bit and label here and reporting the days
// it was used through habits_mark_link_day.
#import, file "../app/exercise_types.zi";

HABIT_LINK_DIARY :: 16777216

// Practices first, in the order the person keeps them, then the apps.
HABIT_LINK_COUNT :: EXERCISE_COUNT + 1

HabitLinkPracticeMask :: () -> s32 {
    return (cast(s32)1 << EXERCISE_COUNT) - 1
}

HabitLinkMaskAll :: () -> s32 {
    return HabitLinkPracticeMask() | HABIT_LINK_DIARY
}

HabitLinkMaskAt :: (index: s32) -> s32 {
    if index >= 0 && index < EXERCISE_COUNT {
        return habit_activity_mask_for(practice_ordered_id(index))
    }
    if index == EXERCISE_COUNT {
        return HABIT_LINK_DIARY
    }
    return 0
}
