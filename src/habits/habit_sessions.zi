c :: #system_library "c";
free :: (ptr: *void) #foreign c;
calloc :: (count: usize, size: usize) -> *void #foreign c;
app_auto_sync :: (app: *InnerBreeze) -> s32 #foreign c;
#import, file "../core/types.zi";
#import, file "../app/app_types.zi";
