#import, file "habit_types.zi";
#import, file "../app/app_types.zi";
#import, file "../app/settings_store.zi";

ClampHabitViewSetting :: (value: s32, minimum: s32, maximum: s32) -> s32 {
    if value < minimum {
        return minimum
    }
    if value > maximum {
        return maximum
    }
    return value
}

#program_export
app_restore_habits_view_settings :: (app: *InnerBreeze) {
    if app == null {
        return
    }
    screen_mode := SettingsReadInt("habits_screen_mode", HABITS_SCREEN_OVERVIEW)
    habit_tab := SettingsReadInt("habits_tab", HABIT_TAB_WEEKLY)
    view_mode := SettingsReadInt("habits_view_mode", HABIT_VIEW_WEEKLY)
    app.habits.screen_mode = ClampHabitViewSetting(screen_mode,
        HABITS_SCREEN_OVERVIEW, HABITS_SCREEN_STATISTICS)
    app.habits.tab = ClampHabitViewSetting(habit_tab,
        HABIT_TAB_WEEKLY, HABIT_TAB_COUNT - 1)
    app.habits.view_mode = ClampHabitViewSetting(view_mode,
        HABIT_VIEW_CALENDAR, HABIT_VIEW_WEEKLY)
    // Restoring preferences must not reopen a habit card.
    app.habits.selected = -1
}
