#import "date_parse"

// Civil day arithmetic avoids daylight-saving changes in Unix timestamps.
#program_export
HabitDayIndexAgo :: (year: s32, month: s32, day: s32,
    days_ago: s32) -> s32 {
    if !DateValid(year, month, day) || days_ago < 0 || days_ago > 36500 {
        return 0
    }
    ordinal := DaysFromCivil(year, month, day)
    if ordinal < cast(s64)days_ago { return 0 }
    prior := CivilFromUnix((ordinal - cast(s64)days_ago) * 86400)
    return prior.year * 10000 + prior.month * 100 + prior.day
}
