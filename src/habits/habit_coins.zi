// Coins: each done day of a habit earns coins by how hard the habit is,
// and the shop's rewards cost them. The balance is what the done days
// earned since each habit's coins_from day, plus coins kept from deleted
// habits, less what the rewards bought cost (storage_habit_wallet.zi).
#import, file "habit_types.zi";
#import, file "habit_icons.zi";

HabitDifficultyClamp :: (difficulty: s32) -> s32 {
    if difficulty == HABIT_DIFFICULTY_EASY {
        return HABIT_DIFFICULTY_EASY
    }
    if difficulty < HABIT_DIFFICULTY_MEDIUM {
        return HABIT_DIFFICULTY_MEDIUM
    }
    if difficulty > HABIT_DIFFICULTY_VERY_HARD {
        return HABIT_DIFFICULTY_VERY_HARD
    }
    return difficulty
}

// The half coins a done day of a habit this hard earns: easy one, medium
// two, hard four, very hard six. The wallet counts half coins, so easy
// days add up without rounding.
HabitDifficultyHalfCoins :: (difficulty: s32) -> s32 {
    level := HabitDifficultyClamp(difficulty)
    if level == HABIT_DIFFICULTY_EASY {
        return 1
    }
    return (level + 1) * 2
}

// The levels as the editor offers them, easiest first.
HabitDifficultyAt :: (index: s32) -> s32 {
    if index <= 0 {
        return HABIT_DIFFICULTY_EASY
    }
    if index >= HABIT_DIFFICULTY_COUNT - 1 {
        return HABIT_DIFFICULTY_VERY_HARD
    }
    return index - 1
}

HabitDifficultyIndex :: (difficulty: s32) -> s32 {
    level := HabitDifficultyClamp(difficulty)
    if level == HABIT_DIFFICULTY_EASY {
        return 0
    }
    return level + 1
}

// A reward's symbol: one of the habit icons, the gift when it has none.
HabitRewardIconClamp :: (icon: s32) -> s32 {
    if icon < 1 || icon > HABIT_ICON_COUNT {
        return HABIT_ICON_GIFT
    }
    return icon
}

HabitRewardPriceClamp :: (price: s32) -> s32 {
    if price < 1 {
        return 1
    }
    if price > HABIT_REWARD_PRICE_MAX {
        return HABIT_REWARD_PRICE_MAX
    }
    return price
}
