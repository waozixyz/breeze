// Coins come from completed days at the difficulty rate, or from each
// occurrence at a custom signed rate. The shop spends their shared balance
// (storage_habit_wallet.zi).
#import, file "habit_types.zi";
#import, file "habit_icons.zi";
#import, file "../app/text_buffers.zi";

HABIT_COIN_HALVES_MAX :: 19998

HabitCoinHalvesClamp :: (halves: s32) -> s32 {
    if halves < -HABIT_COIN_HALVES_MAX { return -HABIT_COIN_HALVES_MAX }
    if halves > HABIT_COIN_HALVES_MAX { return HABIT_COIN_HALVES_MAX }
    return halves
}

// Signed coins in half-coin steps, as typed in the editor.
HabitCoinParse :: (text: string, halves: *s32) -> bool {
    if text.count == 0 { return false }
    index: s64 = 0
    negative := text[0] == #char "-"
    if negative { index += 1 }
    start := index
    whole: s32 = 0
    while index < text.count && text[index] >= #char "0" && text[index] <= #char "9" {
        whole = whole * 10 + cast(s32)text[index] - 48
        if whole > 9999 { return false }
        index += 1
    }
    if index == start { return false }
    odd: s32 = 0
    if index < text.count {
        if text[index] != #char "." || index + 2 != text.count { return false }
        if text[index + 1] == #char "5" { odd = 1 }
        else if text[index + 1] != #char "0" { return false }
        index += 2
    }
    value := whole * 2 + odd
    if index != text.count || value > HABIT_COIN_HALVES_MAX { return false }
    halves.* = ifx negative then -value else value
    return true
}

HabitCoinText :: (halves: s32, output: []u8) -> string {
    absolute := ifx halves < 0 then -halves else halves
    unused AppCopyText(ifx halves < 0 then "-" else "", output)
    digits: [16]u8
    unused AppFormatS32(absolute / 2, digits[:])
    unused AppAppendText(AppTextFromCString(*digits[0], 16), output)
    if absolute % 2 != 0 { unused AppAppendText(".5", output) }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

HabitDifficultyClamp :: (difficulty: s32) -> s32 {
    if difficulty == HABIT_DIFFICULTY_EASY {
        return HABIT_DIFFICULTY_EASY
    }
    if difficulty < HABIT_DIFFICULTY_MEDIUM {
        return HABIT_DIFFICULTY_MEDIUM
    }
    if difficulty > HABIT_DIFFICULTY_VERY_HARD {
        return HABIT_DIFFICULTY_VERY_HARD
    }
    return difficulty
}

// The half coins a done day of a habit this hard earns: easy one, medium
// two, hard four, very hard six. The wallet counts half coins, so easy
// days add up without rounding.
HabitDifficultyHalfCoins :: (difficulty: s32) -> s32 {
    level := HabitDifficultyClamp(difficulty)
    if level == HABIT_DIFFICULTY_EASY {
        return 1
    }
    return (level + 1) * 2
}

// The levels as the editor offers them, easiest first.
HabitDifficultyAt :: (index: s32) -> s32 {
    if index <= 0 {
        return HABIT_DIFFICULTY_EASY
    }
    if index >= HABIT_DIFFICULTY_COUNT - 1 {
        return HABIT_DIFFICULTY_VERY_HARD
    }
    return index - 1
}

HabitDifficultyIndex :: (difficulty: s32) -> s32 {
    level := HabitDifficultyClamp(difficulty)
    if level == HABIT_DIFFICULTY_EASY {
        return 0
    }
    return level + 1
}

// A reward's symbol: one of the habit icons, the gift when it has none.
HabitRewardIconClamp :: (icon: s32) -> s32 {
    if icon < 1 || icon > HABIT_ICON_COUNT {
        return HABIT_ICON_GIFT
    }
    return icon
}

HabitRewardPriceClamp :: (price: s32) -> s32 {
    if price < 1 {
        return 1
    }
    if price > HABIT_REWARD_PRICE_MAX {
        return HABIT_REWARD_PRICE_MAX
    }
    return price
}
