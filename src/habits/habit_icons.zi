// The number of the icon with this name, or 0 when there is none.
HabitIconNumber :: (name: string) -> s32 {
    icon: s32 = 1
    while icon <= HABIT_ICON_COUNT {
        if name.count > 0 && HabitIconName(icon) == name {
            return icon
        }
        icon += 1
    }
    return 0
}
