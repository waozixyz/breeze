// The icons a habit can show in the habit list, and a reward in the habit
// shop. They follow MingCute's regular icon style; most are copied from
// kryonlabs/mingcute's generated shapes. Habits and rewards save an icon's
// number, so an icon keeps its number and new icons go at the end.

HABIT_ICON_COUNT :: 84
// A habit that shows the first letter of its name, chosen in its editor or
// because no icon fits it; 0 means no icon has been chosen yet.
HABIT_ICON_LETTER :: -1
// The icons a habit linked to a practice shows until it has its own.
HABIT_ICON_LOTUS :: 1
HABIT_ICON_YOGA :: 3
HABIT_ICON_LUNGS :: 4
HABIT_ICON_YIN_YANG :: 37
// The symbol a new reward in the habit shop shows.
HABIT_ICON_GIFT :: 38
HABIT_ICON_SODA :: 76
HABIT_ICON_DIARY :: 77
HABIT_ICON_NOTEBOOK :: 78
HABIT_ICON_PEN :: 79
HABIT_ICON_PENCIL :: 80
HABIT_ICON_WRITING :: 81
HABIT_ICON_NOTES :: 82
HABIT_ICON_KEYBOARD :: 83
HABIT_ICON_IDEA :: 84
HABIT_ICON_ICE_CREAM :: 57
// The symbol the default Exercise habit shows.
HABIT_ICON_RUN :: 10
// The symbol a habit linked to Diary shows until it has its own.
HABIT_ICON_QUILL_PEN :: 26

HabitPenShape :: #string HABIT_PEN_END
