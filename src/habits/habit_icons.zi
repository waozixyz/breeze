// The name of icon 1 to HABIT_ICON_COUNT, as MingCute calls it; "" for any
// other number. The node's GLM service chooses icons by these names.
HabitIconName :: (icon: s32) -> string {
    if icon == 1 {
        return "lotus"
    }
    if icon == 2 {
        return "zazen"
    }
    if icon == 3 {
        return "yoga"
    }
    if icon == 4 {
        return "lungs"
    }
    if icon == 5 {
        return "flexibility"
    }
    if icon == 6 {
        return "fitness"
    }
    if icon == 7 {
        return "squats"
    }
    if icon == 8 {
        return "lie_down"
    }
    if icon == 9 {
        return "jump"
    }
    if icon == 10 {
        return "run"
    }
    if icon == 11 {
        return "walk"
    }
    if icon == 12 {
        return "hiking"
    }
    if icon == 13 {
        return "bike"
    }
    if icon == 14 {
        return "swimming_pool"
    }
    if icon == 15 {
        return "weightlifting"
    }
    if icon == 16 {
        return "barbell"
    }
    if icon == 17 {
        return "snowflake"
    }
    if icon == 18 {
        return "shower"
    }
    if icon == 19 {
        return "drop"
    }
    if icon == 20 {
        return "teacup"
    }
    if icon == 21 {
        return "fork_knife"
    }
    if icon == 22 {
        return "sleep"
    }
    if icon == 23 {
        return "sun"
    }
    if icon == 24 {
        return "moon"
    }
    if icon == 25 {
        return "book"
    }
    if icon == 26 {
        return "quill_pen"
    }
    if icon == 27 {
        return "music"
    }
    if icon == 28 {
        return "brain"
    }
    if icon == 29 {
        return "translate"
    }
    if icon == 30 {
        return "code"
    }
    if icon == 31 {
        return "leaf"
    }
    if icon == 32 {
        return "heart"
    }
    if icon == 33 {
        return "pray"
    }
    if icon == 34 {
        return "broom"
    }
    if icon == 35 {
        return "wallet"
    }
    if icon == 36 {
        return "target"
    }
    if icon == 37 {
        return "yinyang"
    }
    return ""
}

// The number of the icon with this name, or 0 when there is none.
HabitIconNumber :: (name: string) -> s32 {
    icon: s32 = 1
    while icon <= HABIT_ICON_COUNT {
        if name.count > 0 && HabitIconName(icon) == name {
            return icon
        }
        icon += 1
    }
    return 0
}
