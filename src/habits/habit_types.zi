#import "drawing_props"
#import "geometry"
#import, file "../core/types.zi";

HABIT_SESSION_EDIT_NONE :: 0
HABIT_SESSION_EDIT_ROUND :: 1

HABIT_MAX :: 32
HABIT_ID_SIZE :: 40
HABIT_PENDING_DAY_SAVE_MAX :: 128
HABIT_NAME_SIZE :: 40
HABIT_DESCRIPTION_SIZE :: 256
HABIT_LINKED_ENTRY_MAX :: 128
HABIT_LINKED_PATH_SIZE :: 80

HABIT_VIEW_CALENDAR :: 0
HABIT_VIEW_WEEKLY :: 1

HABITS_SCREEN_OVERVIEW :: 0
HABITS_SCREEN_HISTORY :: 1
HABITS_SCREEN_STATISTICS :: 2

HABIT_TAB_WEEKLY :: 0
HABIT_TAB_MONTHLY :: 1
HABIT_TAB_STATISTICS :: 2
HABIT_TAB_EDIT :: 3
HABIT_TAB_COUNT :: 4

HabitSyncMode :: enum {
    HABIT_SYNC_NONE :: 0
    HABIT_SYNC_ACTIVITIES :: 1
}

HABIT_SCHEDULE_OFF :: 128

// How a schedule repeats (HabitSchedule.repeat).
HABIT_REPEAT_DAILY :: 1
HABIT_REPEAT_WEEKLY :: 2
HABIT_REPEAT_MONTHLY :: 3
HABIT_REPEAT_YEARLY :: 4
HABIT_REPEAT_FORMULA :: 5
HABIT_REPEAT_NONE :: 6

// A habit keeps this many schedules; the oldest gives way to a new one.
HABIT_SCHEDULE_MAX :: 16
HABIT_SCHEDULE_EVERY_MAX :: 999
HABIT_FORMULA_SIZE :: 120
// Room for every schedule of a habit as text (habit_schedule.zi).
HABIT_SCHEDULE_TEXT_SIZE :: 4096

HABIT_WEEKLY_MONTH_DAYS :: 31
HABIT_WEEKLY_INITIAL_DAYS :: HABIT_WEEKLY_MONTH_DAYS
HABIT_WEEKLY_LOAD_DAYS :: HABIT_WEEKLY_MONTH_DAYS
HABIT_WEEKLY_MAX_DAYS :: 36500
HABIT_COUNTER_LONG_PRESS_FRAMES :: 30
// The highest daily target: four digits fit the editor and the day rows.
HABIT_COUNTER_TARGET_MAX :: 9999

// The days a habit is planned. Days are YYYYMMDD; weekdays are bits with
// Monday as bit 0 and Sunday as bit 6.
HabitSchedule :: struct {
    // The first day this schedule plans. A habit's first schedule also
    // plans every day before it.
    from: s32
    repeat: s32
    // Every this many days, weeks, months or years.
    every: s32
    // The day the repetition counts from; no earlier day is planned. A
    // yearly schedule repeats on its month and day. 0 when it has none.
    start: s32
    // A weekly schedule's days, or the weekday of a monthly schedule's
    // week_of_month.
    weekdays: s32
    // A monthly schedule's days of the month, the 1st as bit 0; a day
    // past a shorter month's end falls on its last day.
    month_days: s32
    last_day: s32
    // 1 to 5 plans the first to fifth such weekday of the month and -1
    // the last; 0 plans month_days instead.
    week_of_month: s32
    // A formula schedule's formula; the day is planned when it is not 0.
    formula: [HABIT_FORMULA_SIZE]u8
}

// Questions a habit asks when a day is done, and how each is answered.
HABIT_QUESTION_MAX :: 8
HABIT_QUESTION_TEXT_SIZE :: 96
HABIT_ANSWER_SIZE :: 256
HABIT_ANSWER_TEXT :: 1
HABIT_ANSWER_NUMBER :: 2
HABIT_ANSWER_TIME :: 3
HABIT_ANSWER_YES_NO :: 4
HABIT_ANSWER_TYPE_COUNT :: 4
// A day's answers also keep those to questions since removed.
HABIT_DAY_ANSWER_MAX :: 16

HabitQuestion :: struct {
    // Stays with the question while its words or answer change, so each
    // day's answer still finds it; never given to another question.
    id: s64
    answer_type: s32
    text: [HABIT_QUESTION_TEXT_SIZE]u8
}

// One answer of a day. It keeps the question's words and answer type as
// they were, so it reads the same after the question changes or goes.
HabitAnswer :: struct {
    id: s64
    answer_type: s32
    question: [HABIT_QUESTION_TEXT_SIZE]u8
    value: [HABIT_ANSWER_SIZE]u8
}

HabitDay :: struct {
    day_index: s32
    completed: s32
    count: s32
    session_count: s32
}

Habit :: struct {
    id: [HABIT_ID_SIZE]u8
    name: [HABIT_NAME_SIZE]u8
    description: [HABIT_DESCRIPTION_SIZE]u8
    color: Color
    sync_mode: s32
    sync_activity: s32
    counter_enabled: s32
    counter_target: s32
    weekdays: s32
    reminder_hour: s32
    // A deactivated habit keeps its days but leaves the habit list, its
    // schedule and its reminders until it is dragged back.
    deactivated: s32
    // The habit's icon in the habit list: one of habit_icons.zi's icons,
    // HABIT_ICON_LETTER for its name's first letter, or 0 while none is
    // chosen and its practice's icon or a suggested one is shown.
    icon: s32
    // Every schedule the habit has had, oldest first. A changed schedule
    // starts on the day it changed, so earlier days keep the plan they
    // had. Without schedules, weekdays plans the habit.
    schedules: [HABIT_SCHEDULE_MAX]HabitSchedule
    schedule_count: s32
    // Asked when a day is done; without them a tap marks the day.
    questions: [HABIT_QUESTION_MAX]HabitQuestion
    question_count: s32
    days: *HabitDay
    day_count: s32
    day_capacity: s32
}

HabitDaySave :: struct {
    habit_id: [HABIT_ID_SIZE]u8
    day_index: s32
    completed: s32
    count: s32
}

// The day dialog that asks a habit's questions, or shows the answers of a
// day that is done.
HabitAnswerDialog :: struct {
    habit: s32
    day: s32
    answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    count: s32
    // A time answer's hours and minutes as typed.
    hours: [HABIT_DAY_ANSWER_MAX][4]u8
    minutes: [HABIT_DAY_ANSWER_MAX][4]u8
    // The field typed in: twice the answer's index, plus one for a time's
    // minutes; -1 while none is.
    focus: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    scroll: s32
}

HabitLinkedEntry :: struct {
    path: [HABIT_LINKED_PATH_SIZE]u8
    year: s32
    month: s32
    day: s32
    hour: s32
    minute: s32
    second: s32
    activity: s32
    rounds: [MaxRounds]s32
    round_count: s32
    total_seconds: s32
    best_seconds: s32
}

HabitLinkedContext :: struct {
    entries: [HABIT_LINKED_ENTRY_MAX]HabitLinkedEntry
    count: s32
    day_filter: s32
    sync_mode: s32
    sync_activity: s32
    total_seconds: s32
    best_seconds: s32
}

Habits :: struct {
    items: [HABIT_MAX]Habit
    loaded_ids: [HABIT_MAX][HABIT_ID_SIZE]u8
    pending_day_saves: [HABIT_PENDING_DAY_SAVE_MAX]HabitDaySave
    linked_cache: *HabitLinkedContext
    linked_cache_habit_id: [HABIT_ID_SIZE]u8
    linked_cache_session_clock: s64
    linked_cache_index: s32
    linked_cache_day_filter: s32
    linked_cache_sync_mode: s32
    linked_cache_sync_activity: s32
    linked_cache_valid: s32
    count: s32
    loaded_count: s32
    pending_day_save_count: s32
    selected: s32
    scroll: s32
    tab_scroll: s32
    focus_selected_tab: s32
    month_offset: s32
    selector_open: s32
    screen_mode: s32
    view_mode: s32
    tab: s32
    weekly_days: s32
    hold_stats_range_days: s32
    // The habit and day the count dialog edits while it is open.
    count_dialog_habit: s32
    count_dialog_day: s32
    // The answers the questions or count dialog edits while it is open.
    answer_dialog: HabitAnswerDialog
    // Set when a habit's card opens: the list scrolls it into view once.
    reveal_selected: s32
    // Whether the inactive habits' rows are shown in the table, and the habit
    // being dragged: a row to another place or a deactivated habit back
    // into the rows. A row on a touch screen is lifted only once held.
    show_deactivated: s32
    dragging: s32
    drag_habit: s32
    drag_lifted: s32
    drag_pressed_at: float64
    drag_moving: s32
    drag_released: s32
    // Since when the dragged habit has been at the list's edge, when the
    // list last scrolled for it, and the part of a pixel still to scroll.
    drag_at_edge: s32
    drag_edge_since: float64
    drag_scroll_at: float64
    drag_scroll_carry: float32
    drag_origin: Vector2
    drag_pointer: Vector2
    drag_grab: Vector2
    drag_bounds: Rectangle
    loaded: s32
    dirty: s32
}
