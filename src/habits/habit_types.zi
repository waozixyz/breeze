#import "drawing_props"
#import "geometry"
#import, file "../core/types.zi";
#import, file "../app/session_details.zi";

HABIT_SESSION_EDIT_NONE :: 0
HABIT_SESSION_EDIT_ROUND :: 1

HABIT_MAX :: 32
HABIT_ID_SIZE :: 40
// An entry's id: its own, or a day's from before entries, "HABIT:YYYYMMDD".
HABIT_ENTRY_ID_SIZE :: 64
HABIT_PENDING_DAY_SAVE_MAX :: 128
HABIT_NAME_SIZE :: 40
HABIT_DESCRIPTION_SIZE :: 256
HABIT_LINKED_ENTRY_MAX :: 128
HABIT_LINKED_PATH_SIZE :: 80

HABIT_VIEW_CALENDAR :: 0
HABIT_VIEW_WEEKLY :: 1

HABITS_SCREEN_OVERVIEW :: 0
HABITS_SCREEN_HISTORY :: 1
HABITS_SCREEN_STATISTICS :: 2
// The shop: the coins to spend and the rewards they buy.
HABITS_SCREEN_SHOP :: 3

HABIT_TAB_WEEKLY :: 0
HABIT_TAB_MONTHLY :: 1
HABIT_TAB_STATISTICS :: 2
HABIT_TAB_EDIT :: 3
HABIT_TAB_COUNT :: 4

HabitSyncMode :: enum {
    HABIT_SYNC_NONE :: 0
    HABIT_SYNC_ACTIVITIES :: 1
}

HABIT_SCHEDULE_OFF :: 128

// How a schedule repeats (HabitSchedule.repeat).
HABIT_REPEAT_DAILY :: 1
HABIT_REPEAT_WEEKLY :: 2
HABIT_REPEAT_MONTHLY :: 3
HABIT_REPEAT_YEARLY :: 4
HABIT_REPEAT_FORMULA :: 5
HABIT_REPEAT_NONE :: 6

// A habit keeps this many schedules; the oldest gives way to a new one.
HABIT_SCHEDULE_MAX :: 16
HABIT_SCHEDULE_EVERY_MAX :: 999
HABIT_FORMULA_SIZE :: 120
// Room for every schedule of a habit as text (habit_schedule.zi).
HABIT_SCHEDULE_TEXT_SIZE :: 4096

HABIT_WEEKLY_MONTH_DAYS :: 31
HABIT_WEEKLY_INITIAL_DAYS :: HABIT_WEEKLY_MONTH_DAYS
HABIT_WEEKLY_LOAD_DAYS :: HABIT_WEEKLY_MONTH_DAYS
HABIT_WEEKLY_MAX_DAYS :: 36500
HABIT_COUNTER_LONG_PRESS_FRAMES :: 30
// The highest daily target: four digits fit the editor and the day rows.
HABIT_COUNTER_TARGET_MAX :: 9999

// The days a habit is planned. Days are YYYYMMDD; weekdays are bits with
// Monday as bit 0 and Sunday as bit 6.
HabitSchedule :: struct {
    // The first day this schedule plans. A habit's first schedule also
    // plans every day before it.
    from: s32
    repeat: s32
    // Every this many days, weeks, months or years.
    every: s32
    // The day the repetition counts from; no earlier day is planned. A
    // yearly schedule repeats on its month and day. 0 when it has none.
    start: s32
    // A weekly schedule's days, or the weekday of a monthly schedule's
    // week_of_month.
    weekdays: s32
    // A monthly schedule's days of the month, the 1st as bit 0; a day
    // past a shorter month's end falls on its last day.
    month_days: s32
    last_day: s32
    // 1 to 5 plans the first to fifth such weekday of the month and -1
    // the last; 0 plans month_days instead.
    week_of_month: s32
    // A formula schedule's formula; the day is planned when it is not 0.
    formula: [HABIT_FORMULA_SIZE]u8
}

// Questions a habit asks when a day is done, and how each is answered.
HABIT_QUESTION_MAX :: 8
HABIT_QUESTION_TEXT_SIZE :: 96
HABIT_ANSWER_SIZE :: 256
HABIT_ANSWER_TEXT :: 1
HABIT_ANSWER_NUMBER :: 2
HABIT_ANSWER_TIME :: 3
HABIT_ANSWER_YES_NO :: 4
HABIT_ANSWER_TYPE_COUNT :: 4
// Statistics of a span's length in minutes, beside the answer types.
HABIT_ANSWER_SPAN :: 5
// An entry's answers also keep those to questions since removed.
HABIT_DAY_ANSWER_MAX :: 16

// What counts as good: a number, time or span from low, up to high, or
// between them, or a yes or a no. Times are minutes after midnight, where
// "at least" reads "after" and "at most" "before"; spans are minutes.
// Above or below average judge each value against the average of the
// values recorded before it (HabitBenchmark), so only which way is better
// is set: a time above average is later, a span above average longer.
HABIT_GOAL_NONE :: 0
HABIT_GOAL_AT_LEAST :: 1
HABIT_GOAL_AT_MOST :: 2
HABIT_GOAL_BETWEEN :: 3
HABIT_GOAL_YES :: 4
HABIT_GOAL_NO :: 5
HABIT_GOAL_ABOVE_AVERAGE :: 6
HABIT_GOAL_BELOW_AVERAGE :: 7

HabitGoal :: struct {
    kind: s32
    low: s32
    high: s32
}

HabitQuestion :: struct {
    // Stays with the question while its words or answer change, so each
    // entry's answer still finds it; never given to another question.
    id: s64
    answer_type: s32
    text: [HABIT_QUESTION_TEXT_SIZE]u8
    goal: HabitGoal
}

// One answer of an entry. It keeps the question's words and answer type as
// they were, so it reads the same after the question changes or goes.
HabitAnswer :: struct {
    id: s64
    answer_type: s32
    question: [HABIT_QUESTION_TEXT_SIZE]u8
    value: [HABIT_ANSWER_SIZE]u8
}

// How hard a habit is. A done day earns half a coin when easy, then one
// coin for each level: medium one, hard two, very hard three
// (habit_coins.zi). Easy was added last, so stored levels keep their value.
HABIT_DIFFICULTY_MEDIUM :: 0
HABIT_DIFFICULTY_HARD :: 1
HABIT_DIFFICULTY_VERY_HARD :: 2
HABIT_DIFFICULTY_EASY :: 3
HABIT_DIFFICULTY_COUNT :: 4

// The shop's rewards: what the person enjoys and how many coins it costs.
HABIT_REWARD_MAX :: 64
HABIT_REWARD_ID_SIZE :: 64
HABIT_REWARD_NAME_SIZE :: 64
HABIT_REWARD_PRICE_MAX :: 9999

// What a coin record of the wallet is: coins a reward cost, or coins kept
// from a habit that was deleted with the days that earned them.
HABIT_COINS_SPENT :: 1
HABIT_COINS_KEPT :: 2

HabitReward :: struct {
    id: [HABIT_REWARD_ID_SIZE]u8
    name: [HABIT_REWARD_NAME_SIZE]u8
    price: s32
    // Its symbol, one of the habit icons (habit_icons.zi).
    icon: s32
}

// The shop's Activity: the latest coin movements, newest first.
HABIT_ACTIVITY_MAX :: 10

// A done day's coins or a reward bought: its habit's or reward's name and
// symbol, the half coins (earned above 0, spent below) and its local date.
HabitCoinActivity :: struct {
    name: [HABIT_REWARD_NAME_SIZE]u8
    icon: s32
    halves: s64
    local_date: s32
    at: s64
}

HabitDay :: struct {
    day_index: s32
    completed: s32
    count: s32
    session_count: s32
}

Habit :: struct {
    id: [HABIT_ID_SIZE]u8
    name: [HABIT_NAME_SIZE]u8
    description: [HABIT_DESCRIPTION_SIZE]u8
    color: Color
    sync_mode: s32
    sync_activity: s32
    counter_enabled: s32
    counter_target: s32
    weekdays: s32
    reminder_hour: s32
    // A deactivated habit keeps its days but leaves the habit list, its
    // schedule and its reminders until it is dragged back.
    deactivated: s32
    // The habit's icon in the habit list: one of habit_icons.zi's icons,
    // HABIT_ICON_LETTER for its name's first letter, or 0 while none is
    // chosen and its practice's icon or a suggested one is shown.
    icon: s32
    // How hard the habit is, a HABIT_DIFFICULTY_ level; each done day
    // earns its coins.
    difficulty: s32
    // Custom coins apply to each occurrence, independently of the goal.
    custom_coins: bool
    coin_halves: s32
    // The first day whose completion earns coins, YYYYMMDD.
    coins_from: s32
    // Every schedule the habit has had, oldest first. A changed schedule
    // starts on the day it changed, so earlier days keep the plan they
    // had. Without schedules, weekdays plans the habit.
    schedules: [HABIT_SCHEDULE_MAX]HabitSchedule
    schedule_count: s32
    // Asked when a day is done; without them a tap marks the day.
    questions: [HABIT_QUESTION_MAX]HabitQuestion
    question_count: s32
    // A habit that measures a span: a tap starts it and the next ends it.
    // It does not count.
    span: s32
    // Which spans are good, by their length in minutes: at least, at most
    // or between low and high, longer or shorter than the average, or any.
    span_goal: HabitGoal
    // The span that has started and not ended, if any: its entry and day.
    running_entry: [HABIT_ENTRY_ID_SIZE]u8
    running_day: s32
    running_since: s64
    days: *HabitDay
    day_count: s32
    day_capacity: s32
}

HabitDaySave :: struct {
    habit_id: [HABIT_ID_SIZE]u8
    day_index: s32
    completed: s32
    count: s32
}

// One entry of a habit's day as its day screen lists it: when it started
// and ended (0 while a span runs) and its answers in one line.
HABIT_DAY_ENTRY_MAX :: 32
HABIT_ENTRY_SUMMARY_SIZE :: 256

HabitEntrySummary :: struct {
    id: [HABIT_ENTRY_ID_SIZE]u8
    started_at: s64
    ended_at: s64
    // Its time, or its span's start, end and length, as shown.
    when: [64]u8
    summary: [HABIT_ENTRY_SUMMARY_SIZE]u8
}

// The entry dialog: a new entry of a day, or one being changed. A span has
// a start and an end, any other entry its time; then the questions.
HabitAnswerDialog :: struct {
    habit: s32
    day: s32
    // The entry changed, or empty for a new one.
    entry: [HABIT_ENTRY_ID_SIZE]u8
    // The start, or the time, and the end in minutes after midnight, or -1
    // while none is picked; an end left empty keeps a span running.
    start: s32
    end: s32
    answers: [HABIT_DAY_ANSWER_MAX]HabitAnswer
    count: s32
    // A time answer's minutes after midnight, or -1 while it has none.
    times: [HABIT_DAY_ANSWER_MAX]s32
    // The index of the answer typed in, or -1 while none is.
    focus: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    scroll: s32
}

// A habit day's entries as its day screen shows them, read again when the
// stored data changes.
HabitDayEntries :: struct {
    habit: s32
    day: s32
    revision: s64
    entries: [HABIT_DAY_ENTRY_MAX]HabitEntrySummary
    count: s32
}

HabitLinkedEntry :: struct {
    details: SessionDetails
    path: [HABIT_LINKED_PATH_SIZE]u8
    year: s32
    month: s32
    day: s32
    hour: s32
    minute: s32
    second: s32
    activity: s32
    rounds: [MaxRounds]s32
    round_count: s32
    total_seconds: s32
    best_seconds: s32
}

HabitLinkedContext :: struct {
    entries: [HABIT_LINKED_ENTRY_MAX]HabitLinkedEntry
    count: s32
    day_filter: s32
    sync_mode: s32
    sync_activity: s32
    total_seconds: s32
    best_seconds: s32
}

Habits :: struct {
    items: [HABIT_MAX]Habit
    loaded_ids: [HABIT_MAX][HABIT_ID_SIZE]u8
    pending_day_saves: [HABIT_PENDING_DAY_SAVE_MAX]HabitDaySave
    linked_cache: *HabitLinkedContext
    linked_cache_habit_id: [HABIT_ID_SIZE]u8
    linked_cache_session_clock: s64
    linked_cache_index: s32
    linked_cache_day_filter: s32
    linked_cache_sync_mode: s32
    linked_cache_sync_activity: s32
    linked_cache_valid: s32
    count: s32
    loaded_count: s32
    pending_day_save_count: s32
    selected: s32
    scroll: s32
    tab_scroll: s32
    focus_selected_tab: s32
    month_offset: s32
    selector_open: s32
    screen_mode: s32
    view_mode: s32
    tab: s32
    // The saved name-column width in design units.
    name_width: s32
    name_resize_origin: float32
    name_resize_start: float32
    name_resizing: s32
    weekly_days: s32
    hold_stats_range_days: s32
    // The habit and day the count dialog edits while it is open.
    count_dialog_habit: s32
    count_dialog_day: s32
    // The entry the entry dialog edits while it is open.
    answer_dialog: HabitAnswerDialog
    // The entries of the day the day screen shows.
    day_entries: HabitDayEntries
    // Set when a habit's card opens: the list scrolls it into view once.
    reveal_selected: s32
    // Whether the inactive habits' rows are shown in the table, and the habit
    // being dragged: a row to another place or a deactivated habit back
    // into the rows. A row on a touch screen is lifted only once held.
    show_deactivated: s32
    dragging: s32
    drag_habit: s32
    drag_lifted: s32
    drag_moving: s32
    // Since when the dragged habit has been at the list's edge, when the
    // list last scrolled for it, and the part of a pixel still to scroll.
    drag_at_edge: s32
    drag_edge_since: float64
    drag_scroll_at: float64
    drag_scroll_carry: float32
    drag_origin: Vector2
    drag_pointer: Vector2
    drag_grab: Vector2
    drag_bounds: Rectangle
    loaded: s32
    dirty: s32
}
