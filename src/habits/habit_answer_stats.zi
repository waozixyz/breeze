// What a habit's entries add up to over its last days: one question's
// answers, or a span habit's lengths, starts and ends.
#import, file "habit_types.zi";
#import, file "habit_questions.zi";
#import, file "../app/text_buffers.zi";

HABIT_ANSWER_STATS_DAYS :: 30
HABIT_ANSWER_RECENT :: 3
HABIT_ANSWER_POINT_MAX :: 128
HABIT_MINUTES_PER_DAY :: 1440
// Statistics of a span's length in minutes, beside the answer types.
HABIT_ANSWER_SPAN :: 5

// One entry's number, time or length on its day, 0 the oldest day, and
// whether it meets the goal: 1 good, 0 not, -1 without a goal.
HabitAnswerPoint :: struct {
    slot: s32
    value: s32
    good: s32
}

HabitAnswerStats :: struct {
    id: s64
    answer_type: s32
    goal: HabitGoal
    // Entries with an answer, and days with at least one.
    answered: s32
    days: s32
    // For numbers, times and lengths: their sum, lowest and highest. Times
    // are minutes after midnight; see HabitAnswerStatsFinish.
    sum: s64
    lowest: s32
    highest: s32
    yes: s32
    no: s32
    // Entries a goal judged, and those it found good.
    judged: s32
    good: s32
    points: [HABIT_ANSWER_POINT_MAX]HabitAnswerPoint
    point_count: s32
    // The latest text answers, newest first, and their days.
    recent: [HABIT_ANSWER_RECENT][HABIT_ANSWER_SIZE]u8
    recent_days: [HABIT_ANSWER_RECENT]s32
    recent_count: s32
    last_slot: s32
}

HabitAnswerStatsBegin :: (stats: *HabitAnswerStats, answer_type: s32,
    goal: HabitGoal) {
    stats.* = HabitAnswerStats.{}
    stats.answer_type = answer_type
    stats.goal = goal
    stats.lowest = -1
    stats.highest = -1
    stats.last_slot = -1
}

// A whole number of up to nine digits, or -1.
HabitAnswerNumber :: (value: string) -> s32 {
    if value.count == 0 || value.count > 9 {
        return -1
    }
    number: s32 = 0
    index: s64 = 0
    while index < value.count {
        if !HabitTimeDigit(value[index]) {
            return -1
        }
        number = number * 10 + cast(s32)value[index] - 48
        index += 1
    }
    return number
}

// Whether a number, time or length meets a goal: 1 good, 0 not, -1 when
// the goal says nothing about it. A time goal between a later and an
// earlier time spans midnight.
HabitGoalMet :: (goal: HabitGoal, value: s32) -> s32 {
    if goal.kind == HABIT_GOAL_AT_LEAST {
        return ifx value >= goal.low then 1 else 0
    }
    if goal.kind == HABIT_GOAL_AT_MOST {
        return ifx value <= goal.high then 1 else 0
    }
    if goal.kind == HABIT_GOAL_BETWEEN {
        if goal.low <= goal.high {
            return ifx value >= goal.low && value <= goal.high then 1 else 0
        }
        return ifx value >= goal.low || value <= goal.high then 1 else 0
    }
    return -1
}

HabitAnswerStatsDay :: (stats: *HabitAnswerStats, slot: s32) {
    if slot != stats.last_slot {
        stats.days += 1
        stats.last_slot = slot
    }
}

// Counts a number, time or length of the day at slot. Entries come in the
// order of their days.
HabitAnswerStatsAddValue :: (stats: *HabitAnswerStats, slot: s32, value: s32) {
    if slot < 0 || slot >= HABIT_ANSWER_STATS_DAYS || value < 0 ||
    stats.point_count >= HABIT_ANSWER_POINT_MAX {
        return
    }
    point := *stats.points[stats.point_count]
    point.slot = slot
    point.value = value
    point.good = HabitGoalMet(stats.goal, value)
    if point.good >= 0 {
        stats.judged += 1
        if point.good == 1 {
            stats.good += 1
        }
    }
    stats.point_count += 1
    stats.answered += 1
    HabitAnswerStatsDay(stats, slot)
}

// Counts an answer of the day at slot.
HabitAnswerStatsAdd :: (stats: *HabitAnswerStats, slot: s32, local_date: s32,
    value: string) {
    if slot < 0 || slot >= HABIT_ANSWER_STATS_DAYS || value.count == 0 {
        return
    }
    if stats.answer_type == HABIT_ANSWER_YES_NO {
        yes := value == "yes"
        if !yes && value != "no" {
            return
        }
        if yes {
            stats.yes += 1
        } else {
            stats.no += 1
        }
        if stats.goal.kind == HABIT_GOAL_YES || stats.goal.kind == HABIT_GOAL_NO {
            stats.judged += 1
            if yes == (stats.goal.kind == HABIT_GOAL_YES) {
                stats.good += 1
            }
        }
        stats.answered += 1
        HabitAnswerStatsDay(stats, slot)
        return
    }
    if stats.answer_type == HABIT_ANSWER_TEXT {
        stats.answered += 1
        HabitAnswerStatsDay(stats, slot)
        // Entries come oldest first: each newer answer goes in front.
        last := stats.recent_count
        if last >= HABIT_ANSWER_RECENT {
            last = HABIT_ANSWER_RECENT - 1
        }
        while last > 0 {
            stats.recent[last] = stats.recent[last - 1]
            stats.recent_days[last] = stats.recent_days[last - 1]
            last -= 1
        }
        unused AppCopyText(value, stats.recent[0][:])
        stats.recent_days[0] = local_date
        if stats.recent_count < HABIT_ANSWER_RECENT {
            stats.recent_count += 1
        }
        return
    }
    if stats.answer_type == HABIT_ANSWER_TIME {
        hours: s32 = 0
        minutes: s32 = 0
        if HabitTimeParts(value, *hours, *minutes) {
            HabitAnswerStatsAddValue(stats, slot, hours * 60 + minutes)
        }
        return
    }
    HabitAnswerStatsAddValue(stats, slot, HabitAnswerNumber(value))
}

// Where the day's clock is cut for times: at the end of the longest
// stretch of the day without an answer. Times before the cut count as the
// next day's, so bedtimes such as 23:30 and 00:30 average to midnight,
// while times through the day, such as 07:00 to 09:00, keep midnight as
// the cut (-1).
HabitAnswerTimeCut :: (stats: *HabitAnswerStats) -> s32 {
    sorted: [HABIT_ANSWER_POINT_MAX]s32
    count: s32 = 0
    index: s32 = 0
    while index < stats.point_count {
        value := stats.points[index].value
        place := count
        while place > 0 && sorted[place - 1] > value {
            sorted[place] = sorted[place - 1]
            place -= 1
        }
        sorted[place] = value
        count += 1
        index += 1
    }
    if count < 2 {
        return -1
    }
    // The stretch over midnight, from the latest time to the earliest.
    longest := sorted[0] + HABIT_MINUTES_PER_DAY - sorted[count - 1]
    cut: s32 = -1
    index = 1
    while index < count {
        gap := sorted[index] - sorted[index - 1]
        if gap > longest {
            longest = gap
            cut = sorted[index]
        }
        index += 1
    }
    return cut
}

// Sums the numbers, times and lengths, with their lowest and highest. Times
// before the cut (HabitAnswerTimeCut) count a day later; they are shown
// modulo a day.
HabitAnswerStatsFinish :: (stats: *HabitAnswerStats) {
    if stats.answer_type == HABIT_ANSWER_TIME {
        cut := HabitAnswerTimeCut(stats)
        if cut >= 0 {
            index: s32 = 0
            while index < stats.point_count {
                if stats.points[index].value < cut {
                    stats.points[index].value += HABIT_MINUTES_PER_DAY
                }
                index += 1
            }
        }
    }
    stats.sum = 0
    stats.lowest = -1
    stats.highest = -1
    index: s32 = 0
    while index < stats.point_count {
        value := stats.points[index].value
        stats.sum += cast(s64)value
        if stats.lowest < 0 || value < stats.lowest {
            stats.lowest = value
        }
        if value > stats.highest {
            stats.highest = value
        }
        index += 1
    }
}

// The average in hundredths, or -1 without answers.
HabitAnswerStatsAverage100 :: (stats: *HabitAnswerStats) -> s64 {
    if stats.point_count <= 0 {
        return -1
    }
    return (stats.sum * 100 + cast(s64)stats.point_count / 2) /
    cast(s64)stats.point_count
}

// Minutes after midnight, of this or the next day, as "HH:MM".
HabitAnswerTimeText :: (minutes: s32, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if minutes < 0 {
        return ""
    }
    minutes = minutes % HABIT_MINUTES_PER_DAY
    cursor: s32 = 0
    unused TextBufferAppendPaddedNumber(output, *cursor, minutes / 60, 2)
    unused TextBufferAppendByte(output, *cursor, cast(u8)58)
    unused TextBufferAppendPaddedNumber(output, *cursor, minutes % 60, 2)
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// A length in minutes as hours and minutes: "16h 05m", or "45m".
HabitSpanText :: (minutes: s32, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if minutes < 0 {
        return ""
    }
    cursor: s32 = 0
    if minutes >= 60 {
        unused TextBufferAppendNumber(output, *cursor, minutes / 60)
        unused TextBufferAppendByte(output, *cursor, cast(u8)104)
        unused TextBufferAppendByte(output, *cursor, cast(u8)32)
        unused TextBufferAppendPaddedNumber(output, *cursor, minutes % 60, 2)
    } else {
        unused TextBufferAppendNumber(output, *cursor, minutes)
    }
    unused TextBufferAppendByte(output, *cursor, cast(u8)109)
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// A number in hundredths with up to one decimal: 1250 is "12.5".
HabitAnswerDecimalText :: (value_x100: s64, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    tenths := (value_x100 + 5) / 10
    unused AppFormatS64(tenths / 10, output)
    if tenths % 10 != 0 {
        cursor := cast(s32)AppTextFromCString(*output[0],
            cast(s32)output.count).count
        unused TextBufferAppendByte(output, *cursor, cast(u8)46)
        unused TextBufferAppendByte(output, *cursor,
            cast(u8)(48 + tenths % 10))
    }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}
