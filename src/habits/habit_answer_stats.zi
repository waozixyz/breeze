// What a habit's entries add up to over its last days: one question's
// answers, or a span habit's lengths, starts and ends.
#import, file "habit_types.zi";
#import, file "habit_questions.zi";
#import, file "habit_changes.zi";
#import, file "../app/text_buffers.zi";

HABIT_ANSWER_STATS_DAYS :: 30
HABIT_ANSWER_RECENT :: 3
HABIT_ANSWER_POINT_MAX :: 128
HABIT_MINUTES_PER_DAY :: 1440
// Statistics of a span's length in minutes, beside the answer types.
HABIT_ANSWER_SPAN :: 5
// An average goal's benchmark: the average of the values recorded last
// before the one it judges, up to this many.
HABIT_BENCHMARK_COUNT :: 30
HABIT_GOAL_VERSION_MAX :: 16

// One entry's number, time or length on its day, 0 the oldest day, when
// the entry started, and whether it met the goal it had then: 1 good, 0
// not, -1 when that goal said nothing about it or an average goal had no
// earlier values yet.
HabitAnswerPoint :: struct {
    slot: s32
    value: s32
    good: s32
    at: s64
    goal: HabitGoal
    // The average an average goal judged it against, in hundredths, or -1.
    benchmark: s64
}

HabitAnswerStats :: struct {
    id: s64
    answer_type: s32
    // The goal now, and its changes, oldest first: each value is judged by
    // the goal it had when it was recorded.
    goal: HabitGoal
    versions: [HABIT_GOAL_VERSION_MAX]HabitGoalVersion
    version_count: s32
    // The values recorded before the days counted, oldest first, up to
    // HABIT_BENCHMARK_COUNT: the first averages start from them.
    earlier: [HABIT_BENCHMARK_COUNT]s32
    earlier_count: s32
    // The average the next value would be judged against, in hundredths,
    // or -1 without values.
    benchmark: s64
    // Entries with an answer, and days with at least one.
    answered: s32
    days: s32
    // For numbers, times and lengths: their sum, lowest and highest. Times
    // are minutes after midnight; see HabitAnswerStatsFinish.
    sum: s64
    lowest: s32
    highest: s32
    yes: s32
    no: s32
    // Entries a goal judged, and those it found good.
    judged: s32
    good: s32
    points: [HABIT_ANSWER_POINT_MAX]HabitAnswerPoint
    point_count: s32
    // The latest text answers, newest first, and their days.
    recent: [HABIT_ANSWER_RECENT][HABIT_ANSWER_SIZE]u8
    recent_days: [HABIT_ANSWER_RECENT]s32
    recent_count: s32
    last_slot: s32
}

HabitAnswerStatsBegin :: (stats: *HabitAnswerStats, answer_type: s32,
    goal: HabitGoal) {
    stats.* = HabitAnswerStats.{}
    stats.answer_type = answer_type
    stats.goal = goal
    stats.lowest = -1
    stats.highest = -1
    stats.last_slot = -1
    stats.benchmark = -1
}

// A goal change of the question, in the order they happened.
HabitAnswerStatsAddVersion :: (stats: *HabitAnswerStats, at: s64,
    before: HabitGoal, after: HabitGoal) {
    if stats.version_count >= HABIT_GOAL_VERSION_MAX {
        // The oldest changes give way to the newest.
        index: s32 = 1
        while index < HABIT_GOAL_VERSION_MAX {
            stats.versions[index - 1] = stats.versions[index]
            index += 1
        }
        stats.version_count = HABIT_GOAL_VERSION_MAX - 1
    }
    version := *stats.versions[stats.version_count]
    version.at = at
    version.before = before
    version.after = after
    stats.version_count += 1
}

// The goal the question had at a time.
HabitAnswerStatsGoalAt :: (stats: *HabitAnswerStats, at: s64) -> HabitGoal {
    return HabitGoalAt(stats.versions[:], stats.version_count, stats.goal, at)
}

HabitGoalIsAverage :: (kind: s32) -> bool {
    return kind == HABIT_GOAL_ABOVE_AVERAGE || kind == HABIT_GOAL_BELOW_AVERAGE
}

// A number, time or length recorded before the days counted, oldest first;
// only the latest HABIT_BENCHMARK_COUNT are kept.
HabitAnswerStatsAddEarlierValue :: (stats: *HabitAnswerStats, value: s32) {
    if value < 0 {
        return
    }
    if stats.earlier_count >= HABIT_BENCHMARK_COUNT {
        index: s32 = 1
        while index < HABIT_BENCHMARK_COUNT {
            stats.earlier[index - 1] = stats.earlier[index]
            index += 1
        }
        stats.earlier_count = HABIT_BENCHMARK_COUNT - 1
    }
    stats.earlier[stats.earlier_count] = value
    stats.earlier_count += 1
}

// An answer recorded before the days counted.
HabitAnswerStatsAddEarlier :: (stats: *HabitAnswerStats, value: string) {
    if stats.answer_type == HABIT_ANSWER_TIME {
        hours: s32 = 0
        minutes: s32 = 0
        if HabitTimeParts(value, *hours, *minutes) {
            HabitAnswerStatsAddEarlierValue(stats, hours * 60 + minutes)
        }
    } else if stats.answer_type == HABIT_ANSWER_NUMBER {
        HabitAnswerStatsAddEarlierValue(stats, HabitAnswerNumber(value))
    }
}

// A whole number of up to nine digits, or -1.
HabitAnswerNumber :: (value: string) -> s32 {
    if value.count == 0 || value.count > 9 {
        return -1
    }
    number: s32 = 0
    index: s64 = 0
    while index < value.count {
        if !HabitTimeDigit(value[index]) {
            return -1
        }
        number = number * 10 + cast(s32)value[index] - 48
        index += 1
    }
    return number
}

// Whether a number, time or length meets a goal: 1 good, 0 not, -1 when
// the goal says nothing about it. A time goal between a later and an
// earlier time spans midnight. Average goals are judged by
// HabitBenchmarkMet.
HabitGoalMet :: (goal: HabitGoal, value: s32) -> s32 {
    if goal.kind == HABIT_GOAL_AT_LEAST {
        return ifx value >= goal.low then 1 else 0
    }
    if goal.kind == HABIT_GOAL_AT_MOST {
        return ifx value <= goal.high then 1 else 0
    }
    if goal.kind == HABIT_GOAL_BETWEEN {
        if goal.low <= goal.high {
            return ifx value >= goal.low && value <= goal.high then 1 else 0
        }
        return ifx value >= goal.low || value <= goal.high then 1 else 0
    }
    return -1
}

HabitAnswerStatsDay :: (stats: *HabitAnswerStats, slot: s32) {
    if slot != stats.last_slot {
        stats.days += 1
        stats.last_slot = slot
    }
}

// Whether a value meets an average goal against an average in
// hundredths: as good as the average or better counts. -1 without an
// average.
HabitBenchmarkMet :: (kind: s32, value: s32, average_x100: s64) -> s32 {
    if average_x100 < 0 {
        return -1
    }
    scaled := cast(s64)value * 100
    if kind == HABIT_GOAL_ABOVE_AVERAGE {
        return ifx scaled >= average_x100 then 1 else 0
    }
    if kind == HABIT_GOAL_BELOW_AVERAGE {
        return ifx scaled <= average_x100 then 1 else 0
    }
    return -1
}

// Counts a number, time or length of the day at slot, of an entry that
// started at. Entries come in the order they started; they are judged
// when the statistics finish.
HabitAnswerStatsAddValue :: (stats: *HabitAnswerStats, slot: s32, value: s32,
    at: s64) {
    if slot < 0 || slot >= HABIT_ANSWER_STATS_DAYS || value < 0 ||
    stats.point_count >= HABIT_ANSWER_POINT_MAX {
        return
    }
    point := *stats.points[stats.point_count]
    point.* = HabitAnswerPoint.{}
    point.slot = slot
    point.value = value
    point.good = -1
    point.at = at
    point.benchmark = -1
    stats.point_count += 1
    stats.answered += 1
    HabitAnswerStatsDay(stats, slot)
}

// Counts an answer of the day at slot, of an entry that started at.
HabitAnswerStatsAdd :: (stats: *HabitAnswerStats, slot: s32, local_date: s32,
    at: s64, value: string) {
    if slot < 0 || slot >= HABIT_ANSWER_STATS_DAYS || value.count == 0 {
        return
    }
    if stats.answer_type == HABIT_ANSWER_YES_NO {
        yes := value == "yes"
        if !yes && value != "no" {
            return
        }
        if yes {
            stats.yes += 1
        } else {
            stats.no += 1
        }
        goal := HabitAnswerStatsGoalAt(stats, at)
        if goal.kind == HABIT_GOAL_YES || goal.kind == HABIT_GOAL_NO {
            stats.judged += 1
            if yes == (goal.kind == HABIT_GOAL_YES) {
                stats.good += 1
            }
        }
        stats.answered += 1
        HabitAnswerStatsDay(stats, slot)
        return
    }
    if stats.answer_type == HABIT_ANSWER_TEXT {
        stats.answered += 1
        HabitAnswerStatsDay(stats, slot)
        // Entries come oldest first: each newer answer goes in front.
        last := stats.recent_count
        if last >= HABIT_ANSWER_RECENT {
            last = HABIT_ANSWER_RECENT - 1
        }
        while last > 0 {
            stats.recent[last] = stats.recent[last - 1]
            stats.recent_days[last] = stats.recent_days[last - 1]
            last -= 1
        }
        unused AppCopyText(value, stats.recent[0][:])
        stats.recent_days[0] = local_date
        if stats.recent_count < HABIT_ANSWER_RECENT {
            stats.recent_count += 1
        }
        return
    }
    if stats.answer_type == HABIT_ANSWER_TIME {
        hours: s32 = 0
        minutes: s32 = 0
        if HabitTimeParts(value, *hours, *minutes) {
            HabitAnswerStatsAddValue(stats, slot, hours * 60 + minutes, at)
        }
        return
    }
    HabitAnswerStatsAddValue(stats, slot, HabitAnswerNumber(value), at)
}

// Where the day's clock is cut for times: at the end of the longest
// stretch of the day without an answer, among the days counted and the
// values before them. Times before the cut count as the
// next day's, so bedtimes such as 23:30 and 00:30 average to midnight,
// while times through the day, such as 07:00 to 09:00, keep midnight as
// the cut (-1).
HabitAnswerTimeCut :: (stats: *HabitAnswerStats) -> s32 {
    sorted: [HABIT_ANSWER_POINT_MAX + HABIT_BENCHMARK_COUNT]s32
    count: s32 = 0
    index: s32 = 0
    // The earlier values an average starts from count too.
    while index < stats.point_count + stats.earlier_count {
        value: s32 = 0
        if index < stats.point_count {
            value = stats.points[index].value
        } else {
            value = stats.earlier[index - stats.point_count]
        }
        place := count
        while place > 0 && sorted[place - 1] > value {
            sorted[place] = sorted[place - 1]
            place -= 1
        }
        sorted[place] = value
        count += 1
        index += 1
    }
    if count < 2 {
        return -1
    }
    // The stretch over midnight, from the latest time to the earliest.
    longest := sorted[0] + HABIT_MINUTES_PER_DAY - sorted[count - 1]
    cut: s32 = -1
    index = 1
    while index < count {
        gap := sorted[index] - sorted[index - 1]
        if gap > longest {
            longest = gap
            cut = sorted[index]
        }
        index += 1
    }
    return cut
}

// The average of the latest values, in hundredths, or -1 without any.
HabitBenchmarkAverage :: (values: []s32, count: s32) -> s64 {
    if count <= 0 {
        return -1
    }
    sum: s64 = 0
    index: s32 = 0
    while index < count {
        sum += cast(s64)values[index]
        index += 1
    }
    return (sum * 100 + cast(s64)count / 2) / cast(s64)count
}

// Judges each value by the goal it had when it was recorded: a fixed goal
// by its bounds, an average goal against the average of the up to
// HABIT_BENCHMARK_COUNT values before it, from the days counted and
// before them.
HabitAnswerStatsJudge :: (stats: *HabitAnswerStats) {
    latest: [HABIT_BENCHMARK_COUNT]s32
    count: s32 = 0
    while count < stats.earlier_count {
        latest[count] = stats.earlier[count]
        count += 1
    }
    index: s32 = 0
    while index < stats.point_count {
        point := *stats.points[index]
        point.goal = HabitAnswerStatsGoalAt(stats, point.at)
        point.benchmark = -1
        if HabitGoalIsAverage(point.goal.kind) {
            point.benchmark = HabitBenchmarkAverage(latest[:], count)
            point.good = HabitBenchmarkMet(point.goal.kind, point.value,
                point.benchmark)
        } else {
            // Fixed time goals compare times of day.
            value := point.value
            if stats.answer_type == HABIT_ANSWER_TIME {
                value = value % HABIT_MINUTES_PER_DAY
            }
            point.good = HabitGoalMet(point.goal, value)
        }
        if point.good >= 0 {
            stats.judged += 1
            if point.good == 1 {
                stats.good += 1
            }
        }
        if count >= HABIT_BENCHMARK_COUNT {
            shift: s32 = 1
            while shift < HABIT_BENCHMARK_COUNT {
                latest[shift - 1] = latest[shift]
                shift += 1
            }
            count = HABIT_BENCHMARK_COUNT - 1
        }
        latest[count] = point.value
        count += 1
        index += 1
    }
    stats.benchmark = HabitBenchmarkAverage(latest[:], count)
}

// Sums the numbers, times and lengths, with their lowest and highest, and
// judges them. Times before the cut (HabitAnswerTimeCut) count a day
// later, earlier ones too; they are shown modulo a day.
HabitAnswerStatsFinish :: (stats: *HabitAnswerStats) {
    if stats.answer_type == HABIT_ANSWER_TIME {
        cut := HabitAnswerTimeCut(stats)
        if cut >= 0 {
            index: s32 = 0
            while index < stats.point_count {
                if stats.points[index].value < cut {
                    stats.points[index].value += HABIT_MINUTES_PER_DAY
                }
                index += 1
            }
            index = 0
            while index < stats.earlier_count {
                if stats.earlier[index] < cut {
                    stats.earlier[index] += HABIT_MINUTES_PER_DAY
                }
                index += 1
            }
        }
    }
    HabitAnswerStatsJudge(stats)
    stats.sum = 0
    stats.lowest = -1
    stats.highest = -1
    index: s32 = 0
    while index < stats.point_count {
        value := stats.points[index].value
        stats.sum += cast(s64)value
        if stats.lowest < 0 || value < stats.lowest {
            stats.lowest = value
        }
        if value > stats.highest {
            stats.highest = value
        }
        index += 1
    }
}

// The average in hundredths, or -1 without answers.
HabitAnswerStatsAverage100 :: (stats: *HabitAnswerStats) -> s64 {
    if stats.point_count <= 0 {
        return -1
    }
    return (stats.sum * 100 + cast(s64)stats.point_count / 2) /
    cast(s64)stats.point_count
}

// Minutes after midnight, of this or the next day, as "HH:MM".
HabitAnswerTimeText :: (minutes: s32, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if minutes < 0 {
        return ""
    }
    minutes = minutes % HABIT_MINUTES_PER_DAY
    cursor: s32 = 0
    unused TextBufferAppendPaddedNumber(output, *cursor, minutes / 60, 2)
    unused TextBufferAppendByte(output, *cursor, cast(u8)58)
    unused TextBufferAppendPaddedNumber(output, *cursor, minutes % 60, 2)
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// A length in minutes as hours and minutes: "16h 05m", or "45m".
HabitSpanText :: (minutes: s32, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    if minutes < 0 {
        return ""
    }
    cursor: s32 = 0
    if minutes >= 60 {
        unused TextBufferAppendNumber(output, *cursor, minutes / 60)
        unused TextBufferAppendByte(output, *cursor, cast(u8)104)
        unused TextBufferAppendByte(output, *cursor, cast(u8)32)
        unused TextBufferAppendPaddedNumber(output, *cursor, minutes % 60, 2)
    } else {
        unused TextBufferAppendNumber(output, *cursor, minutes)
    }
    unused TextBufferAppendByte(output, *cursor, cast(u8)109)
    return AppTextFromCString(*output[0], cast(s32)output.count)
}

// A number in hundredths with up to one decimal: 1250 is "12.5".
HabitAnswerDecimalText :: (value_x100: s64, output: []u8) -> string {
    if output.count > 0 {
        output[0] = cast(u8)0
    }
    tenths := (value_x100 + 5) / 10
    unused AppFormatS64(tenths / 10, output)
    if tenths % 10 != 0 {
        cursor := cast(s32)AppTextFromCString(*output[0],
            cast(s32)output.count).count
        unused TextBufferAppendByte(output, *cursor, cast(u8)46)
        unused TextBufferAppendByte(output, *cursor,
            cast(u8)(48 + tenths % 10))
    }
    return AppTextFromCString(*output[0], cast(s32)output.count)
}
