// Ownership of habit day storage and the cached linked-session view.
#import, file "habit_types.zi";

c :: #system_library "c";
free :: (pointer: *void) #foreign c;
using HabitSyncMode;

habit_linked_cache_clear :: (habits: *Habits) {
    if habits == null {
        return
    }
    free(cast(*void)habits.linked_cache)
    habits.linked_cache = null
    habits.linked_cache_habit_id[0] = cast(u8)0
    habits.linked_cache_valid = 0
    habits.linked_cache_index = -1
    habits.linked_cache_day_filter = 0
    habits.linked_cache_session_clock = 0
    habits.linked_cache_sync_mode = HABIT_SYNC_NONE
    habits.linked_cache_sync_activity = 0
}

habit_free_days :: (habit: *Habit) {
    free(cast(*void)habit.days)
    habit.days = null
    habit.day_count = 0
    habit.day_capacity = 0
}

habits_free :: (habits: *Habits) {
    if habits == null {
        return
    }
    index: s32 = 0
    while index < HABIT_MAX {
        habit_free_days(*habits.items[index])
        index += 1
    }
    habit_linked_cache_clear(habits)
}
