#import, file "module_types.zi";

DIARY_ROUTE :: 1
DIARY_LOAD :: 2
DIARY_SAVE :: 3
DIARY_CONTROL :: 4
DIARY_EDIT :: 5

DiaryMessage :: struct {
    abi: s32
    action: s32
    control: s32
    year: s32
    month: s32
    day: s32
    month_year: s32
    month_number: s32
    month_days: s32
    month_weekday: s32
    screen: s32
    text: string
    document: string
    replacement: string
    edit_start: s32
    edit_end: s32
    cursor: s32
    anchor: s32
    calendar: bool
    saved: bool
    load_error: bool
    succeeded: bool
    marks: [32]u8
}

DiaryFileResult :: struct {
    data: string
    missing: bool
    succeeded: bool
}
