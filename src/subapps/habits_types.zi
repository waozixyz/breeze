#import, file "module_types.zi";
#import "drawing_props"
HABITS_EXPAND :: 1
HABITS_FOCUS :: 2
HABITS_HISTORY :: 3
HABITS_STATISTICS :: 4
HABITS_OVERVIEW :: 5
HABITS_COLLAPSE :: 6
HABITS_DAY_ACTION :: 7
HABITS_COMMIT :: 8
HABITS_ROUTE :: 9
HABITS_DAY_NONE :: 0
HABITS_DAY_DECREMENT :: 1
HABITS_DAY_COUNT :: 2
HABITS_DAY_LINKED :: 3
HABITS_DAY_TOGGLE :: 4

HabitsMessage :: struct {
    abi: s32
    action: s32
    index: s32
    count: s32
    selected: s32
    screen_mode: s32
    view_mode: s32
    tab: s32
    day_index: s32
    weekdays: s32
    counter_enabled: s32
    counter_target: s32
    linked_count: s32
    sync_activity: s32
    sync_mode: s32
    reminder_hour: s32
    modal_active: bool
    scheduled: bool
    completed: bool
    decrement: bool
    is_new: bool
    active: bool
    name: string
    description: string
    color: Color
    succeeded: bool
    reset_scroll: bool
    cancel_edit: bool
    name_error: s32
    day_action: s32
    block_click: bool
    screen: s32
}
