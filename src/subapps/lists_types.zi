#import, file "module_types.zi";
LISTS_SELECT :: 1
LISTS_COMMIT :: 2
LISTS_VISIBLE :: 3
LISTS_SET_DONE :: 4
LISTS_DELETE_LIST :: 5
LISTS_DELETE_ITEM :: 6
LISTS_ROUTE :: 7
LISTS_CREATE_LIST :: 1
LISTS_UPDATE_LIST :: 2
LISTS_CREATE_ITEM :: 3
LISTS_UPDATE_ITEM :: 4
LISTS_REMOVE_LIST :: 5
LISTS_REMOVE_ITEM :: 6

ListsMessage :: struct {
    abi: s32
    action: s32
    index: s32
    selected_list: s32
    list_count: s32
    item_count: s32
    editing_item: s32
    done: s32
    sort_order: s32
    show_completed: s32
    now: float64
    completing_until: float64
    visibility_deadline: float64
    id: string
    parent_id: string
    title: string
    comment: string
    selected_id: string
    completing_id: string
    succeeded: bool
    changed: bool
    visible: bool
    reset_input: bool
    reset_scroll: bool
    reload: bool
    sync: bool
    input_error: s32
    screen: s32
}

ListsMutation :: struct {
    kind: s32
    id: string
    parent_id: string
    title: string
    comment: string
    done: s32
    sort_order: s32
}

ListsMutationResult :: struct {
    saved: bool
    created_id: string
}
