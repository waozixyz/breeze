#import, file "sync_restore_model.zi";

// Laws for restoring a sync account, proved for every combination of flags. An
// implementation edit may not change this file.

// Restoring cannot discard a queued local change: every local entity is queued
// afterward, whether or not it was queued before.
#law RestoreKeepsEveryLocalChange forall present: 0..1, queued: 0..1 => present == 0 || RestoreQueuedAfter(present, queued) == 1;
#law RestoreQueuesUnqueuedData forall queued: 0..1 => RestoreQueuedAfter(1, 0) == 1;

// It invents nothing: an entity that is not local is not queued.
#law RestoreQueuesOnlyLocalData forall present: 0..1, queued: 0..1 => RestoreQueuedAfter(present, queued) <= present;

// Restoring twice changes nothing more.
#law RestoreIsIdempotent forall present: 0..1, queued: 0..1 => RestoreQueuedAfter(present, RestoreQueuedAfter(present, queued)) == RestoreQueuedAfter(present, queued);

#program_export
sync_restore_laws_entry :: () -> s32 {
    return 0
}
