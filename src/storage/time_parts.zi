// The first fields match the C localtime/mktime calendar layout. Native
// Linux also stores the UTC offset and timezone name after tm_isdst.
Tm :: struct {
    tm_sec: s32
    tm_min: s32
    tm_hour: s32
    tm_mday: s32
    tm_mon: s32
    tm_year: s32
    tm_wday: s32
    tm_yday: s32
    tm_isdst: s32
    tm_gmtoff: s64
    tm_zone: *u8
}
