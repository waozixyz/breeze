    has_sessions: s32
    has_habits: s32
    has_settings: s32
    session_count: s32
    habit_count: s32
    setting_count: s32
}
IMPORT_ID_SIZE :: 37;
sqlite3_bind_int :: (stmt: *void, index: s32, value: s32) -> s32 #foreign c;
sqlite3_changes :: (db: *void) -> s32 #foreign c;
sqlite3_clear_bindings :: (stmt: *void) -> s32 #foreign c;
sqlite3_reset :: (stmt: *void) -> s32 #foreign c;
