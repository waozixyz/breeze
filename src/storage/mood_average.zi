// Averages of 1-5 mood ratings. A group with no ratings averages to zero
// rather than dividing by zero, and the result keeps its fraction.
#program_export
SessionMoodAverage :: (total: s64, count: s32) -> float32 {
    if count <= 0 {
        return 0.0
    }
    return cast(float32)cast(float64)total / cast(float32)count
}
