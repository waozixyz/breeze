    storage_json_builder_key_value_text(json, "id",
        AppTextFromCString(SqliteColumnText(stmt, 0), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "habit_id",
        AppTextFromCString(SqliteColumnText(stmt, 1), 8192))
    storage_json_append_int_field(json, "local_date", cast(s64)sqlite3_column_int(stmt, 2))
    storage_json_append_int_field(json, "started_at", SqliteColumnInt64(stmt, 3))
    storage_json_append_int_field(json, "ended_at", SqliteColumnInt64(stmt, 4))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "answers",
        AppTextFromCString(SqliteColumnText(stmt, 5), 65536))
    storage_json_append_int_field(json, "deleted_at", SqliteColumnInt64(stmt, 6))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(stmt, 7))
    storage_json_builder_append_text(json, "}")
}

