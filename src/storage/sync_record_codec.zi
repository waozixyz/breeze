// Local rows as synced record payloads: each entity type's row as the
// JSON object that travels, encrypted, to the node.
#import, file "../app/text_buffers.zi";
#import, file "../cells/catalog.zi";
#import, file "state.zi";
#import, file "sqlite.zi";
#import, file "json.zi";
#import, file "cell_records.zi";
#import, file "app_records.zi";
#import, file "media_records.zi";
#import, file "db.zi";
#import, file "storage_core.zi";
c :: #system_library "c";
sqlite3_bind_int :: (statement: *void, index: s32, value: s32) -> s32 #foreign c "sqlite3_bind_int";
sqlite3_column_int :: (statement: *void, column: s32) -> s32 #foreign c "sqlite3_column_int";

// Appends `,"name":value` for a whole number.
storage_json_append_int_field :: (json: *StorageJsonBuilder, name: string, value: s64) {
    digits: [24] u8
    storage_json_builder_append_text(json, ",\"")
    storage_json_builder_append_text(json, name)
    storage_json_builder_append_text(json, "\":")
    AppFormatS64(value, digits[:])
    storage_json_builder_append_text(json, AppTextFromCString(*digits[0], 24))
}

// Appends `,"name":true` or `,"name":false`.
storage_json_append_bool_field :: (json: *StorageJsonBuilder, name: string, value: bool) {
    storage_json_builder_append_text(json, ",\"")
    storage_json_builder_append_text(json, name)
    if value {
        storage_json_builder_append_text(json, "\":true")
    } else {
        storage_json_builder_append_text(json, "\":false")
    }
}

storage_append_habit_row_json :: (json_handle: s64, stmt_handle: s64) {
    json: *StorageJsonBuilder = cast(*StorageJsonBuilder)json_handle
    stmt: *void = cast(*void)stmt_handle
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "id", AppTextFromCString(SqliteColumnText(stmt, 0), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "name", AppTextFromCString(SqliteColumnText(stmt, 1), 8192))
    storage_json_append_int_field(json, "color_r", cast(s64)sqlite3_column_int(stmt, 2))
    storage_json_append_int_field(json, "color_g", cast(s64)sqlite3_column_int(stmt, 3))
    storage_json_append_int_field(json, "color_b", cast(s64)sqlite3_column_int(stmt, 4))
    storage_json_append_int_field(json, "sync_mode", cast(s64)sqlite3_column_int(stmt, 5))
    storage_json_append_int_field(json, "sync_activity", cast(s64)sqlite3_column_int(stmt, 6))
    storage_json_append_int_field(json, "counter_enabled",
        ifx (sqlite3_column_int(stmt, 7) != 0) then (cast(s64)1) else (cast(s64)0))
    storage_json_append_int_field(json, "counter_target", cast(s64)sqlite3_column_int(stmt, 8))
    storage_json_append_int_field(json, "sort_order", cast(s64)sqlite3_column_int(stmt, 9))
    storage_json_append_int_field(json, "deleted_at", SqliteColumnInt64(stmt, 10))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(stmt, 11))
    storage_json_append_int_field(json, "weekdays", cast(s64)sqlite3_column_int(stmt, 12))
    storage_json_append_int_field(json, "reminder_hour", cast(s64)sqlite3_column_int(stmt, 13))
    storage_json_append_int_field(json, "deactivated",
        ifx (sqlite3_column_int(stmt, 14) != 0) then (cast(s64)1) else (cast(s64)0))
    storage_json_append_int_field(json, "icon", cast(s64)sqlite3_column_int(stmt, 15))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "schedule", AppTextFromCString(SqliteColumnText(stmt, 16), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "questions", AppTextFromCString(SqliteColumnText(stmt, 17), 65536))
    storage_json_append_int_field(json, "span", cast(s64)sqlite3_column_int(stmt, 18))
    storage_json_append_int_field(json, "span_goal", cast(s64)sqlite3_column_int(stmt, 19))
    storage_json_append_int_field(json, "span_low", cast(s64)sqlite3_column_int(stmt, 20))
    storage_json_append_int_field(json, "span_high", cast(s64)sqlite3_column_int(stmt, 21))
    storage_json_append_int_field(json, "difficulty", cast(s64)sqlite3_column_int(stmt, 22))
    storage_json_append_int_field(json, "coins_from", cast(s64)sqlite3_column_int(stmt, 23))
    storage_json_builder_append_text(json, "}")
}

