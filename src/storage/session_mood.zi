c :: #system_library "c";
StorageMoodStats :: struct {
    counts: [5] s32
    total: s32
    average: float32
    lift: float32
    energy: float32
    stress: float32
}


// Matches StorageSessionCheckin at the native storage ABI boundary.
SessionMoodCheckin :: struct {
    mood_before: s32
    mood_after: s32
    energy: s32
    stress: s32
    note: [256]u8
    tags: [160]u8
}

DataSaveSessionCheckin :: (path: *u8, checkin: *SessionMoodCheckin) -> s32 #foreign c "data_save_session_checkin";

#program_export
SaveSessionMood :: (path: *u8, mood: s32) -> s32 {
    if path == null || path[0] == cast(u8)0 || mood <= 0 { return 0 }
    checkin: SessionMoodCheckin
    checkin.mood_after = mood
    return DataSaveSessionCheckin(path, *checkin)
}

