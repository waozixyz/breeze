// Model of what account restore does to queued local changes
// (storage_reset_sync_state followed by storage_enqueue_all_sync_state):
// the outbox is cleared and every local entity is queued again for upload, so
// no local change waits only in the cleared queue. The SQL implements this;
// tests/sync_restore_sql_test.py runs it and checks the laws in
// sync_restore_laws.zi.

// Restore first clears the outbox, then queues every local entity again.
OutboxAfterClear :: (queued_before: s32) -> s32 {
    if queued_before != 0 {
        return 0
    }
    return 0
}

// present: the entity exists locally (including soft-deleted rows).
// queued_before: it was waiting in the outbox before the restore.
// Returns 1 when it is queued after the restore.
RestoreQueuedAfter :: (present: s32, queued_before: s32) -> s32 {
    if present != 0 {
        return 1
    }
    return OutboxAfterClear(queued_before)
}
