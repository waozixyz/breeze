// Dew is prepaid storage credit on the Waozi node. The node owns the balance,
// payment confirmations and expiry; a device never grants itself credit.
#import "auth"
#import "json_scan"
#import "text_buffer"
#import "byte_text_linux"
#import "net_http"
Clock :: #import "date_time_linux";
#import, file "storage_core.zi";
#import, file "delegate_store.zi";
#import, file "sync_async.zi";
#import, file "sync_nodes.zi";
#import, file "sync_node_storage.zi";
#import, file "../platform/network_transport.zi";
#import, file "../app/text_buffers.zi";

DewNow :: () -> s64 {
    return Clock.UnixNow()
}

DewNode :: "https://api.waozi.xyz"
DewUnits :: 1000000
DewRead :: 1
DewUpgrade :: 2
DewAddress :: 3
DewGift :: 4

// Where a gift to a friend stands, for the window that sends it.
DewGiftNone :: 0
DewGiftSending :: 1
DewGiftSent :: 2
DewGiftRefused :: 3

// The node's paid storage sizes, in the order the app offers them.
DewPlanCount :: 2
DewPlanSizes: [2]string = .["1gb", "5gb"];

DewStoragePlan :: struct {
    limit_bytes: s64
    monthly_units: s64
    yearly_units: s64
}

DewAccount :: struct {
    known: bool
    enabled: bool
    balance: s64
    used_bytes: s64
    limit_bytes: s64
    expires_at: s64
    free_bytes: s64
    // 1 + the index of the account's paid size, or 0 without a paid plan.
    plan_size: s32
    plans: [DewPlanCount]DewStoragePlan
}

// The node's Monero price in US cents and its Dew funding ratio. Shown
// for orientation only; the node charges Dew and credits Monero by itself.
DewRates :: struct {
    known: bool
    usd_cents_per_xmr: s64
    xmr_atomic_units: s64
    token_units: s64
}

dew_account: DewAccount;
dew_rates: DewRates;
dew_rates_transfer: NetworkTransfer;
dew_rates_response: [1024]u8;
dew_rates_active: bool;
dew_rates_next: s64;
dew_operation: StoredOperation;
dew_transfer: NetworkTransfer;
dew_response: [8192]u8;
dew_identity: [65]u8;
dew_attempt: [256]u8;
dew_address: [128]u8;
dew_rate_atomic: s64;
dew_rate_units: s64;
dew_confirmations: s64;
dew_minimum_atomic: s64;
dew_action: s32;
dew_next_refresh: float64;
dew_notice: string;
dew_sync_requested: bool;
// A gift waiting for the node's answer, as the request it sends, kept until
// the node confirms or refuses it so an uncertain send repeats the same ID.
dew_gift_attempt: [192]u8;
dew_gift_retry_at: float64;
dew_gift_state: s32;
dew_gift_notice: string;
dew_gift_recipient: [65]u8;
dew_gift_units: s64;

DewReady :: () -> bool {
    return StoredAccountMode() == AccountModeOwner && storage_sync_enabled() != 0 &&
    SyncNodeSameAddress(storage_get_setting_text("sync_server_url"), DewNode)
}

DewCancel :: () {
    CancelStoredOperation(*dew_operation)
    dew_account = DewAccount.{}
    dew_identity = .{}
    dew_attempt = .{}
    dew_address = .{}
    dew_rate_atomic = 0
    dew_rate_units = 0
    dew_confirmations = 0
    dew_minimum_atomic = 0
    dew_action = 0
    dew_next_refresh = 0.0
    dew_notice = ""
    dew_sync_requested = false
    dew_gift_attempt = .{}
    dew_gift_retry_at = 0.0
    dew_gift_state = DewGiftNone
    dew_gift_notice = ""
    dew_gift_recipient = .{}
    dew_gift_units = 0
}

DewTakeSyncRequest :: () -> bool {
    requested := dew_sync_requested
    dew_sync_requested = false
    return requested
}

DewContext :: () {
    if !DewReady() {
        DewCancel()
        return
    }
    identity: [65]u8
    unused AppCopyText(storage_get_setting_text("sync_public_id"), identity[:])
    if TextUntilNul(identity[:]) == TextUntilNul(dew_identity[:]) {
        return
    }
    DewCancel()
    dew_identity = identity
    unused storage_get_social_cache_json("dew.upgrade", *dew_attempt[0], 256)
    if FieldAt(TextUntilNul(dew_attempt[:]), 0, "request_id") < 0 {
        dew_attempt[0] = cast(u8)0
    }
    // A gift still unconfirmed when the app closed is sent again as it was.
    unused storage_get_social_cache_json("dew.gift", *dew_gift_attempt[0], 192)
    if DewGiftAttemptLoad() {
        dew_gift_state = DewGiftSending
    } else {
        dew_gift_attempt[0] = cast(u8)0
    }
}

// Read integer units without converting credit through floating point.
DewInteger :: (json: string, at: s32, value: *s64) -> bool {
    if at < 0 || at >= cast(s32)json.count {
        return false
    }
    cursor := at
    number: s64 = 0
    while cursor < cast(s32)json.count && json[cursor] >= cast(u8)48 && json[cursor] <= cast(u8)57 {
        digit := cast(s64)(json[cursor] - cast(u8)48)
        if number > (9223372036854775807 - digit) / 10 {
            return false
        }
        number = number * 10 + digit
        cursor += 1
    }
    if cursor == at || ValueEnd(json, at, 0) != cursor {
        return false
    }
    value.* = number
    return true
}

DewPlanSlot :: (size: string) -> s32 {
    for index: cast(s32)0..DewPlanCount - 1 {
        if size == DewPlanSizes[index] {
            return index
        }
    }
    return -1
}

DewParseAccount :: (json: string, identity: string, account: *DewAccount) -> bool {
    owner: [65]u8
    asset: [32]u8
    size: [16]u8
    plan := FieldAt(json, 0, "plan")
    plans := FieldAt(json, 0, "plans")
    units: s64
    if Space(json, ValueEnd(json, 0, 0)) != cast(s32)json.count || plan < 0 || plans < 0 ||
    ReadStringText(json, FieldAt(json, 0, "account_id"), owner[:]) != 64 ||
    TextUntilNul(owner[:]) != identity ||
    ReadStringText(json, FieldAt(json, 0, "asset_id"), asset[:]) != 11 ||
    TextUntilNul(asset[:]) != "waozi:token" ||
    !DewInteger(json, FieldAt(json, 0, "units_per_dew"), *units) || units != DewUnits ||
    !DewInteger(json, FieldAt(json, plan, "balance"), *account.balance) ||
    !DewInteger(json, FieldAt(json, plan, "limit_bytes"), *account.limit_bytes) ||
    !DewInteger(json, FieldAt(json, plan, "expires_at"), *account.expires_at) ||
    !DewInteger(json, FieldAt(json, 0, "free_bytes"), *account.free_bytes) ||
    !DewInteger(json, FieldAt(json, 0, "used_bytes"), *account.used_bytes) {
        return false
    }
    // Sizes this app does not know yet are skipped; each known size is priced by the node.
    for index: cast(s32)0..ArrayCount(json, plans) - 1 {
        at := ElementAt(json, plans, index)
        size = .{}
        unused ReadStringText(json, FieldAt(json, at, "size"), size[:])
        slot := DewPlanSlot(TextUntilNul(size[:]))
        if slot >= 0 {
            offer := *account.plans[slot]
            if !DewInteger(json, FieldAt(json, at, "limit_bytes"), *offer.limit_bytes) ||
            !DewInteger(json, FieldAt(json, at, "monthly_units"), *offer.monthly_units) ||
            !DewInteger(json, FieldAt(json, at, "yearly_units"), *offer.yearly_units) {
                return false
            }
        }
    }
    size = .{}
    unused ReadStringText(json, FieldAt(json, plan, "size"), size[:])
    account.plan_size = DewPlanSlot(TextUntilNul(size[:])) + 1
    enabled := FieldAt(json, 0, "enabled")
    if enabled < 0 {
        return false
    }
    end := ValueEnd(json, enabled, 0)
    if end <= enabled || (json[enabled:end] != "true" && json[enabled:end] != "false") {
        return false
    }
    account.enabled = json[enabled:end] == "true"
    if account.enabled {
        for offer: account.plans {
            if offer.limit_bytes <= account.free_bytes || offer.monthly_units <= 0 || offer.yearly_units <= 0 {
                return false
            }
        }
    }
    account.known = true
    return true
}

// Six decimal places match the existing signed ledger; trailing zeros vanish.
DewFormat :: (units: s64, divisor: s64, output: []u8) -> bool {
    if units < 0 || divisor <= 0 || !AppFormatS64(units / divisor, output) {
        return false
    }
    remainder := units % divisor
    if remainder == 0 {
        return true
    }
    if !AppAppendText(".", output) {
        return false
    }
    scale := divisor / 10
    while scale > 0 {
        digit: [2]u8
        digit[0] = cast(u8)(48 + remainder / scale)
        if !AppAppendText(TextUntilNul(digit[:]), output) {
            return false
        }
        remainder %= scale
        if remainder == 0 {
            return true
        }
        scale /= 10
    }
    return true
}

DewBegin :: (action: s32, path: string, body: string) -> bool {
    if !DewReady() || dew_operation.active {
        return false
    }
    dew_response = .{}
    dew_action = action
    method := "GET"
    if action == DewUpgrade || action == DewGift {
        method = "POST"
    }
    if !BeginStoredRequest(*dew_operation, DewNode, NetworkTransport(*dew_transfer),
        method, path, body, dew_response[:], true) {
        dew_notice = "profile_dew_error"
        return false
    }
    dew_notice = ""
    return true
}

// The size and period are chosen once per request; a retry resends that request.
DewBuyStorage :: (size: string, period: string) {
    DewContext()
    if !DewReady() || dew_operation.active || !dew_account.known || !dew_account.enabled {
        return
    }
    if dew_attempt[0] == cast(u8)0 {
        if (period != "monthly" && period != "yearly") || DewPlanSlot(size) < 0 {
            return
        }
        request_id: [37]u8
        storage_make_uuid(*request_id[0])
        unused AppCopyText("{\"period\":\"", dew_attempt[:])
        unused AppAppendText(period, dew_attempt[:])
        unused AppAppendText("\",\"size\":\"", dew_attempt[:])
        unused AppAppendText(size, dew_attempt[:])
        unused AppAppendText("\",\"request_id\":\"", dew_attempt[:])
        unused AppAppendText(TextUntilNul(request_id[:]), dew_attempt[:])
        unused AppAppendText("\"}", dew_attempt[:])
        if storage_set_social_cache_json("dew.upgrade", TextUntilNul(dew_attempt[:])) == 0 {
            dew_attempt[0] = cast(u8)0
            dew_notice = "profile_dew_error"
            return
        }
    }
    attempt := dew_attempt
    unused DewBegin(DewUpgrade, "/api/v1/storage/plan", TextUntilNul(attempt[:]))
}

// The size a waiting purchase asked for, as 1 + its index, or 0 without one.
DewAttemptSize :: () -> s32 {
    if dew_attempt[0] == cast(u8)0 {
        return 0
    }
    size: [16]u8
    attempt := TextUntilNul(dew_attempt[:])
    unused ReadStringText(attempt, FieldAt(attempt, 0, "size"), size[:])
    return DewPlanSlot(TextUntilNul(size[:])) + 1
}

// Reads the waiting gift's friend and amount; false without a whole request.
DewGiftAttemptLoad :: () -> bool {
    attempt := TextUntilNul(dew_gift_attempt[:])
    recipient: [65]u8
    request_id: [65]u8
    units: s64
    if attempt.count == 0 ||
    ReadStringText(attempt, FieldAt(attempt, 0, "recipient"), recipient[:]) != 64 ||
    ReadStringText(attempt, FieldAt(attempt, 0, "request_id"), request_id[:]) < 8 ||
    !DewInteger(attempt, FieldAt(attempt, 0, "units"), *units) || units <= 0 {
        return false
    }
    dew_gift_recipient = recipient
    dew_gift_units = units
    return true
}

// Sends `units` to the friend whose account ID is `recipient`. The request is
// saved first, so it is repeated with the same ID until the node answers.
DewSendGift :: (recipient: string, units: s64) -> bool {
    DewContext()
    if !DewReady() || dew_gift_attempt[0] != cast(u8)0 || recipient.count != 64 || units <= 0 ||
    TextUntilNul(dew_identity[:]) == recipient {
        return false
    }
    request_id: [37]u8
    storage_make_uuid(*request_id[0])
    amount: [24]u8
    unused AppFormatS64(units, amount[:])
    attempt: [192]u8
    unused AppCopyText("{\"recipient\":\"", attempt[:])
    unused AppAppendText(recipient, attempt[:])
    unused AppAppendText("\",\"units\":", attempt[:])
    unused AppAppendText(TextUntilNul(amount[:]), attempt[:])
    unused AppAppendText(",\"request_id\":\"", attempt[:])
    unused AppAppendText(TextUntilNul(request_id[:]), attempt[:])
    unused AppAppendText("\"}", attempt[:])
    if storage_set_social_cache_json("dew.gift", TextUntilNul(attempt[:])) == 0 {
        dew_gift_state = DewGiftRefused
        dew_gift_notice = "dew_gift_failed"
        return false
    }
    dew_gift_attempt = attempt
    unused DewGiftAttemptLoad()
    dew_gift_state = DewGiftSending
    dew_gift_notice = ""
    dew_gift_retry_at = 0.0
    return true
}

// Forgets the waiting gift once the node has answered it for certain.
DewGiftSettle :: (state: s32, notice: string) {
    unused storage_set_social_cache_json("dew.gift", "{}")
    dew_gift_attempt[0] = cast(u8)0
    dew_gift_state = state
    dew_gift_notice = notice
}

// The node's answer must name the request it was sent, with the sender's new balance.
DewParseGift :: (json: string, balance: *s64) -> bool {
    attempt := TextUntilNul(dew_gift_attempt[:])
    sent_id: [65]u8
    answer_id: [65]u8
    recipient: [65]u8
    units: s64
    unused ReadStringText(attempt, FieldAt(attempt, 0, "request_id"), sent_id[:])
    return Space(json, ValueEnd(json, 0, 0)) == cast(s32)json.count &&
    ReadStringText(json, FieldAt(json, 0, "request_id"), answer_id[:]) >= 8 &&
    TextUntilNul(answer_id[:]) == TextUntilNul(sent_id[:]) &&
    ReadStringText(json, FieldAt(json, 0, "recipient"), recipient[:]) == 64 &&
    TextUntilNul(recipient[:]) == TextUntilNul(dew_gift_recipient[:]) &&
    DewInteger(json, FieldAt(json, 0, "units"), *units) && units == dew_gift_units &&
    DewInteger(json, FieldAt(json, 0, "balance"), balance)
}

DewTopUp :: () {
    DewContext()
    if DewBegin(DewAddress, "/api/v1/tokens/purchases/monero/address", "") {
        dew_address = .{}
        dew_rate_atomic = 0
        dew_rate_units = 0
        dew_confirmations = 0
        dew_minimum_atomic = 0
    }
}

DewParseAddress :: (json: string) -> bool {
    owner: [65]u8
    address: [128]u8
    asset: [32]u8
    network: [16]u8
    atomic: s64
    units: s64
    confirmations: s64
    minimum: s64
    if Space(json, ValueEnd(json, 0, 0)) != cast(s32)json.count ||
    ReadStringText(json, FieldAt(json, 0, "account_id"), owner[:]) != 64 ||
    TextUntilNul(owner[:]) != TextUntilNul(dew_identity[:]) ||
    ReadStringText(json, FieldAt(json, 0, "asset_id"), asset[:]) != 11 ||
    TextUntilNul(asset[:]) != "waozi:token" ||
    ReadStringText(json, FieldAt(json, 0, "network"), network[:]) != 7 ||
    TextUntilNul(network[:]) != "mainnet" ||
    ReadStringText(json, FieldAt(json, 0, "address"), address[:]) != 95 ||
    (address[0] != cast(u8)52 && address[0] != cast(u8)56) {
        return false
    }
    alphabet := "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    for byte: TextUntilNul(address[:]) {
        found := false
        for allowed: alphabet {
            found = found || byte == allowed
        }
        if !found {
            return false
        }
    }
    rate := FieldAt(json, 0, "rate")
    if rate < 0 ||
    !DewInteger(json, FieldAt(json, rate, "xmr_atomic_units"), *atomic) || atomic <= 0 ||
    !DewInteger(json, FieldAt(json, rate, "token_units"), *units) || units <= 0 ||
    !DewInteger(json, FieldAt(json, 0, "confirmations_required"), *confirmations) ||
    confirmations <= 0 || confirmations > 2147483647 ||
    !DewInteger(json, FieldAt(json, 0, "minimum_atomic_amount"), *minimum) || minimum <= 0 {
        return false
    }
    dew_address = address
    dew_rate_atomic = atomic
    dew_rate_units = units
    dew_confirmations = confirmations
    dew_minimum_atomic = minimum
    return true
}

DewTick :: (visible: bool, now: float64) {
    DewContext()
    refresh_soon := false
    if dew_operation.active {
        if !PollStoredOperation(*dew_operation) {
            return
        }
        if dew_operation.result == cast(s32)AuthResult.AUTH_OK {
            json := TextUntilNul(dew_response[:])
            if dew_action == DewGift {
                balance: s64
                if DewParseGift(json, *balance) {
                    if dew_account.known {
                        dew_account.balance = balance
                    }
                    DewGiftSettle(DewGiftSent, "")
                    refresh_soon = true
                } else {
                    dew_gift_notice = "dew_gift_waiting"
                    dew_gift_retry_at = now + 15.0
                }
            } else if dew_action == DewAddress {
                if !DewParseAddress(json) {
                    dew_notice = "profile_dew_error"
                }
            } else {
                received: DewAccount
                if DewParseAccount(json, TextUntilNul(dew_identity[:]), *received) {
                    previous := SyncNodeStorageRead(DewNode)
                    dew_account = received
                    storage := SyncNodeStorage.{
                        .known = true,
                        .used_bytes = received.used_bytes,
                        .limit_bytes = received.limit_bytes,
                        .checked_at = DewNow(),
                        .full = received.limit_bytes > 0 && received.used_bytes >= received.limit_bytes}
                    SyncNodeStorageWrite(DewNode, storage)
                    if previous.known && previous.full && !storage.full {
                        dew_sync_requested = true
                    }
                    if dew_action == DewUpgrade {
                        unused storage_set_social_cache_json("dew.upgrade", "{}")
                        dew_attempt[0] = cast(u8)0
                        dew_sync_requested = true
                    }
                } else {
                    dew_account.known = false
                    dew_notice = "profile_dew_error"
                }
            }
        } else if dew_action == DewGift {
            status := dew_operation.request.status
            if status == 402 {
                DewGiftSettle(DewGiftRefused, "dew_gift_funds")
            } else if status == 403 {
                DewGiftSettle(DewGiftRefused, "dew_gift_not_friend")
            } else if status == 400 || status == 409 {
                DewGiftSettle(DewGiftRefused, "dew_gift_failed")
            } else {
                // Without a certain answer the same request goes again shortly.
                dew_gift_notice = "dew_gift_waiting"
                dew_gift_retry_at = now + 15.0
            }
        } else {
            dew_notice = "profile_dew_error"
            status := dew_operation.request.status
            if dew_action == DewUpgrade && (status == 400 || status == 402 || status == 409) {
                unused storage_set_social_cache_json("dew.upgrade", "{}")
                dew_attempt[0] = cast(u8)0
                if status == 402 {
                    dew_notice = "profile_dew_funds"
                }
            }
        }
        dew_next_refresh = now + 15.0
        if refresh_soon {
            dew_next_refresh = now
        }
    }
    // A waiting gift goes before anything else the node is asked.
    if dew_gift_attempt[0] != cast(u8)0 && DewReady() && !dew_operation.active &&
    now >= dew_gift_retry_at {
        attempt := dew_gift_attempt
        unused DewBegin(DewGift, "/api/v1/tokens/gifts", TextUntilNul(attempt[:]))
        dew_gift_retry_at = now + 15.0
        return
    }
    if visible && DewReady() && !dew_operation.active && now >= dew_next_refresh {
        unused DewBegin(DewRead, "/api/v1/storage/plan", "")
        dew_next_refresh = now + 15.0
    }
}

// {"xmr_usd_cents":N,"updated_at":unix,"sources":[...],"xmr_atomic_units":N,"token_units":N}
// A zero price means the node has no current rate.
DewParseRates :: (json: string, rates: *DewRates) -> bool {
    updated: s64
    if Space(json, ValueEnd(json, 0, 0)) != cast(s32)json.count ||
    !DewInteger(json, FieldAt(json, 0, "xmr_usd_cents"), *rates.usd_cents_per_xmr) ||
    !DewInteger(json, FieldAt(json, 0, "updated_at"), *updated) ||
    !DewInteger(json, FieldAt(json, 0, "xmr_atomic_units"), *rates.xmr_atomic_units) ||
    !DewInteger(json, FieldAt(json, 0, "token_units"), *rates.token_units) {
        return false
    }
    rates.known = rates.xmr_atomic_units > 0 && rates.token_units > 0
    return true
}

// Public, so it needs no account; refreshed at most every ten minutes.
DewRatesRefresh :: () {
    transport := NetworkTransport(*dew_rates_transfer)
    if dew_rates_active {
        status: s32
        state := transport.poll(transport.context, *status)
        if state < 0 {
            return
        }
        dew_rates_active = false
        received: DewRates
        if state == 1 && status == 200 && DewParseRates(TextUntilNul(dew_rates_response[:]), *received) {
            dew_rates = received
        }
        return
    }
    if DewNow() < dew_rates_next {
        return
    }
    dew_rates_next = DewNow() + 600
    dew_rates_response = .{}
    dew_rates_active = transport.start(transport.context, HttpRequest.{.method = "GET",
            .url = "https://api.waozi.xyz/api/v1/rates", .accept = "application/json"},
        dew_rates_response[:])
}

// Dew units in Monero atomic units at the node's funding ratio.
DewXmrAtomic :: (units: s64) -> s64 {
    if !dew_rates.known {
        return 0
    }
    return cast(s64)(cast(float64)units * cast(float64)dew_rates.xmr_atomic_units /
        cast(float64)dew_rates.token_units + 0.5)
}

// Every Dew price is shown by what 0.1 XMR buys: "0.1 XMR = 100 Dew".
DewExampleAtomic :: 100000000000

// The Dew units that a Monero amount buys at a rate of rate_atomic Monero
// atomic units for rate_units Dew units.
DewUnitsForXmr :: (atomic: s64, rate_atomic: s64, rate_units: s64) -> s64 {
    if rate_atomic <= 0 || rate_units <= 0 {
        return 0
    }
    return cast(s64)(cast(float64)atomic * cast(float64)rate_units / cast(float64)rate_atomic + 0.5)
}

// Monero atomic units in US cents, or 0 without a current rate.
DewUsdCents :: (atomic: s64) -> s64 {
    if !dew_rates.known || dew_rates.usd_cents_per_xmr <= 0 {
        return 0
    }
    return cast(s64)(cast(float64)atomic * cast(float64)dew_rates.usd_cents_per_xmr / 1000000000000.0 + 0.5)
}
