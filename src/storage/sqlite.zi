// Direct SQLite ABI shared by Inbe's Ziran storage modules. Handles and
// statements are opaque; the bundled SQLite implementation owns both.
SQLITE_OK :: 0;
SQLITE_ROW :: 100;
SQLITE_DONE :: 101;
SQLITE_BUSY :: 5;
SQLITE_TRANSIENT :: -1;
SQLITE_LOCKED :: 6;
SQLITE_NOMEM :: 7;
SQLITE_TOOBIG :: 18;
SQLITE_MISUSE :: 21;
SQLITE_OPEN_READWRITE :: 0x2;
SQLITE_OPEN_CREATE :: 0x4;
SQLITE_OPEN_FULLMUTEX :: 0x10000;

#scope_file
sqlite :: #system_library "sqlite3";
c :: #system_library "c";
malloc :: (size: usize) -> *void #foreign c;
free :: (pointer: *void) #foreign c;

PrepareRaw :: (db: *void, sql: *u8, length: s32,
    statement: **void, tail: **u8) -> s32 #foreign sqlite "sqlite3_prepare_v2";
StepRaw :: (statement: *void) -> s32 #foreign sqlite "sqlite3_step";
FinalizeRaw :: (statement: *void) -> s32 #foreign sqlite "sqlite3_finalize";
ColumnTextRaw :: (statement: *void, column: s32) -> *u8 #foreign sqlite "sqlite3_column_text";
ColumnInt64Raw :: (statement: *void, column: s32) -> s64 #foreign sqlite "sqlite3_column_int64";
BindTextRaw :: (statement: *void, index: s32, value: *u8,
    length: s32, destructor: *void) -> s32 #foreign sqlite "sqlite3_bind_text";
BindInt64Raw :: (statement: *void, index: s32, value: s64) -> s32 #foreign sqlite "sqlite3_bind_int64";
BindIntRaw :: (statement: *void, index: s32, value: s32) -> s32 #foreign sqlite "sqlite3_bind_int";
ColumnIntRaw :: (statement: *void, column: s32) -> s32 #foreign sqlite "sqlite3_column_int";
ResetRaw :: (statement: *void) -> s32 #foreign sqlite "sqlite3_reset";
ClearBindingsRaw :: (statement: *void) -> s32 #foreign sqlite "sqlite3_clear_bindings";
OpenRaw :: (path: *u8, database: **void, flags: s32,
    vfs: *u8) -> s32 #foreign sqlite "sqlite3_open_v2";
CloseRaw :: (database: *void) -> s32 #foreign sqlite "sqlite3_close";
BackupInitRaw :: (destination: *void, destination_name: *u8,
    source: *void, source_name: *u8) -> *void #foreign sqlite "sqlite3_backup_init";
BackupStepRaw :: (backup: *void, pages: s32) -> s32 #foreign sqlite "sqlite3_backup_step";
BackupFinishRaw :: (backup: *void) -> s32 #foreign sqlite "sqlite3_backup_finish";
ExecRaw :: (database: *void, sql: *u8, callback: *void,
    argument: *void, error: **u8) -> s32 #foreign sqlite "sqlite3_exec";
MutexAllocRaw :: (kind: s32) -> *void #foreign sqlite "sqlite3_mutex_alloc";
MutexEnterRaw :: (mutex: *void) #foreign sqlite "sqlite3_mutex_enter";
MutexLeaveRaw :: (mutex: *void) #foreign sqlite "sqlite3_mutex_leave";
CompareBytes :: (first: *void, second: *void, size: usize) -> s32 #foreign c "memcmp";
TextLength :: (text: *u8) -> usize #foreign c "strlen";

// Prepared statements kept for the next caller of the same SQL on the same
// connection. Preparing parses and plans a query every time, and the app's
// queries repeat with new bindings, so a finished statement is reset and
// kept instead of finalized. The cache's own lock is never held while
// SQLite works, because callers may already hold a connection's lock.
SQLITE_MUTEX_STATIC_APP1 :: 8
SQLITE_KEPT_STATEMENTS :: 48
SQLITE_KEPT_SQL_LIMIT :: 2048

SqliteKept :: struct {
    db: *void
    statement: *void
    sql: *u8
    length: usize
    hash: u64
    busy: bool
    used: u64
}

sqlite_kept: [SQLITE_KEPT_STATEMENTS]SqliteKept;
sqlite_kept_clock: u64;

SqliteKeptLock :: () -> *void {
    mutex := MutexAllocRaw(SQLITE_MUTEX_STATIC_APP1)
    MutexEnterRaw(mutex)
    return mutex
}

SqliteKeptHash :: (sql: *u8, length: usize) -> u64 {
    hash: u64 = 14695981039346656037
    index: usize = 0
    while index < length {
        hash = (hash ^ cast(u64)sql[index]) * 1099511628211
        index += 1
    }
    return hash
}

// A kept statement for this SQL that no one is using, now taken; null when
// there is none.
SqliteKeptTake :: (db: *void, sql: *u8, length: usize, hash: u64) -> *void {
    mutex := SqliteKeptLock()
    defer { MutexLeaveRaw(mutex) }
    for index: cast(s32)0..SQLITE_KEPT_STATEMENTS - 1 {
        kept := *sqlite_kept[index]
        if kept.statement != null && !kept.busy && kept.db == db && kept.length == length &&
        kept.hash == hash && CompareBytes(cast(*void)kept.sql, cast(*void)sql, length) == 0 {
            kept.busy = true
            sqlite_kept_clock += 1
            kept.used = sqlite_kept_clock
            return kept.statement
        }
    }
    return null
}

// Keeps a statement just prepared, in use by its caller. The statement the
// cache gives up for it, if any, is returned for finalizing.
SqliteKeptAdd :: (db: *void, statement: *void, sql: *u8, length: usize, hash: u64) -> *void {
    copy := cast(*u8)malloc(length + 1)
    if copy == null {
        return null
    }
    for index: cast(usize)0..length - 1 {
        copy[index] = sql[index]
    }
    copy[length] = cast(u8)0
    mutex := SqliteKeptLock()
    defer { MutexLeaveRaw(mutex) }
    slot: s32 = -1
    for index: cast(s32)0..SQLITE_KEPT_STATEMENTS - 1 {
        kept := sqlite_kept[index]
        if kept.statement == null {
            slot = index
            break
        }
        if !kept.busy && (slot < 0 || kept.used < sqlite_kept[slot].used) {
            slot = index
        }
    }
    if slot < 0 {
        free(cast(*void)copy)
        return null
    }
    evicted := sqlite_kept[slot].statement
    free(cast(*void)sqlite_kept[slot].sql)
    sqlite_kept_clock += 1
    sqlite_kept[slot] = SqliteKept.{.db = db, .statement = statement, .sql = copy, .length = length,
        .hash = hash, .busy = true, .used = sqlite_kept_clock}
    return evicted
}

SqliteKeptFind :: (statement: *void) -> s32 {
    mutex := SqliteKeptLock()
    defer { MutexLeaveRaw(mutex) }
    for index: cast(s32)0..SQLITE_KEPT_STATEMENTS - 1 {
        if sqlite_kept[index].statement == statement && sqlite_kept[index].busy {
            return index
        }
    }
    return -1
}

SqliteKeptRelease :: (index: s32, statement: *void) {
    mutex := SqliteKeptLock()
    defer { MutexLeaveRaw(mutex) }
    if sqlite_kept[index].statement == statement {
        sqlite_kept[index].busy = false
    }
}

CopyStringBytes :: (source: string, destination: *u8) {
    index: s32 = 0
    while index < cast(s32)source.count {
        destination[index] = source[index]
        index += 1
    }
    destination[index] = cast(u8)0
}

#scope_export
// Statements a caller walks through with `tail` are prepared afresh.
#program_export
SqlitePrepare :: (db: *void, sql: *u8, length: s32,
    statement: **void, tail: **u8) -> s32 {
    if tail != null || sql == null || statement == null {
        return PrepareRaw(db, sql, length, statement, tail)
    }
    size := ifx length < 0 then TextLength(sql) else cast(usize)length
    if size == cast(usize)0 || size > cast(usize)SQLITE_KEPT_SQL_LIMIT {
        return PrepareRaw(db, sql, length, statement, tail)
    }
    hash := SqliteKeptHash(sql, size)
    kept := SqliteKeptTake(db, sql, size, hash)
    if kept != null {
        statement.* = kept
        return SQLITE_OK
    }
    result := PrepareRaw(db, sql, length, statement, null)
    if result == SQLITE_OK && statement.* != null {
        evicted := SqliteKeptAdd(db, statement.*, sql, size, hash)
        if evicted != null {
            unused FinalizeRaw(evicted)
        }
    }
    return result
}

#scope_export
#program_export
SqlitePrepareText :: (db: *void, sql: string, length: s32,
    statement: **void, tail: **u8) -> s32 {
    if tail != null || sql.count > 2147483647 || length < -1 ||
    (length >= 0 && cast(s64)length > sql.count) {
        return SQLITE_MISUSE
    }
    if sql.count < 512 {
        short_sql: [512]u8
        CopyStringBytes(sql, *short_sql[0])
        return SqlitePrepare(db, *short_sql[0], length, statement, null)
    }
    buffer: *u8 = cast(*u8)malloc(cast(usize)sql.count + 1)
    if buffer == null {
        return SQLITE_NOMEM
    }
    CopyStringBytes(sql, buffer)
    result := SqlitePrepare(db, buffer, length, statement, null)
    free(cast(*void)buffer)
    return result
}

#scope_export
#program_export
SqliteBindTextString :: (statement: *void, index: s32, value: string, length: s32) -> s32 {
    if value.count > 2147483647 || length < -1 ||
    (length >= 0 && cast(s64)length > value.count) {
        return SQLITE_MISUSE
    }
    if value.count < 256 {
        short_value: [256]u8
        CopyStringBytes(value, *short_value[0])
        return BindTextRaw(statement, index, *short_value[0], length,
            cast(*void)cast(s64)SQLITE_TRANSIENT)
    }
    buffer: *u8 = cast(*u8)malloc(cast(usize)value.count + 1)
    if buffer == null {
        return SQLITE_NOMEM
    }
    CopyStringBytes(value, buffer)
    result := BindTextRaw(statement, index, buffer, length,
        cast(*void)cast(s64)SQLITE_TRANSIENT)
    free(cast(*void)buffer)
    return result
}

#program_export
SqliteStep :: (statement: *void) -> s32 {
    return StepRaw(statement)
}

// A kept statement is reset, with its bindings cleared, for the next caller
// of its SQL. Like finalizing, that reports the last step's error.
#program_export
SqliteFinalize :: (statement: *void) -> s32 {
    index := SqliteKeptFind(statement)
    if index < 0 {
        return FinalizeRaw(statement)
    }
    result := ResetRaw(statement)
    unused ClearBindingsRaw(statement)
    SqliteKeptRelease(index, statement)
    return result
}

#program_export
SqliteColumnText :: (statement: *void, column: s32) -> *u8 {
    return ColumnTextRaw(statement, column)
}

#program_export
SqliteColumnInt64 :: (statement: *void, column: s32) -> s64 {
    return ColumnInt64Raw(statement, column)
}

#program_export
SqliteBindText :: (statement: *void, index: s32, value: *u8,
    length: s32, destructor: *void) -> s32 {
    return BindTextRaw(statement, index, value, length, destructor)
}

#program_export
SqliteBindInt64 :: (statement: *void, index: s32, value: s64) -> s32 {
    return BindInt64Raw(statement, index, value)
}

#program_export
SqliteBindInt :: (statement: *void, index: s32, value: s32) -> s32 {
    return BindIntRaw(statement, index, value)
}

#program_export
SqliteColumnInt :: (statement: *void, column: s32) -> s32 {
    return ColumnIntRaw(statement, column)
}

#program_export
SqliteReset :: (statement: *void) -> s32 {
    return ResetRaw(statement)
}

#program_export
SqliteClearBindings :: (statement: *void) -> s32 {
    return ClearBindingsRaw(statement)
}

// Imports, archives and upgrades keep temporary data in memory like the main
// database: Android gives apps no writable temporary directory.
#program_export
SqliteOpen :: (path: *u8, database: **void, flags: s32) -> s32 {
    result := OpenRaw(path, database, flags, null)
    if result == SQLITE_OK && database != null && database.* != null {
        pragma: [32]u8
        CopyStringBytes("PRAGMA temp_store=MEMORY", *pragma[0])
        unused ExecRaw(database.*, *pragma[0], null, null, null)
    }
    return result
}

#program_export
SqliteClose :: (database: *void) -> s32 {
    SqliteReleaseKept(database)
    return CloseRaw(database)
}

// Finalizes the connection's kept statements that are not in use; one still
// in use is its caller's to finalize. SQLite will not close a connection
// with statements left, and the next prepare of their SQL starts afresh.
#program_export
SqliteReleaseKept :: (database: *void) {
    idle: [SQLITE_KEPT_STATEMENTS]*void
    idle_count: s32 = 0
    {
        mutex := SqliteKeptLock()
        defer { MutexLeaveRaw(mutex) }
        for index: cast(s32)0..SQLITE_KEPT_STATEMENTS - 1 {
            kept := *sqlite_kept[index]
            if kept.statement == null || kept.db != database {
                continue
            }
            if !kept.busy {
                idle[idle_count] = kept.statement
                idle_count += 1
            }
            free(cast(*void)kept.sql)
            kept.* = SqliteKept.{}
        }
    }
    for index: cast(s32)0..idle_count - 1 {
        unused FinalizeRaw(idle[index])
    }
}

#program_export
SqliteBackupInit :: (destination: *void, source: *void) -> *void {
    name: [5]u8
    name[0] = cast(u8)109
    name[1] = cast(u8)97
    name[2] = cast(u8)105
    name[3] = cast(u8)110
    name[4] = cast(u8)0
    return BackupInitRaw(destination, *name[0], source, *name[0])
}

#program_export
SqliteBackupStep :: (backup: *void, pages: s32) -> s32 {
    return BackupStepRaw(backup, pages)
}

#program_export
SqliteBackupFinish :: (backup: *void) -> s32 {
    return BackupFinishRaw(backup)
}

#program_export
SqliteExec :: (database: *void, sql: *u8) -> s32 {
    return ExecRaw(database, sql, null, null, null)
}

#program_export
SqliteExecText :: (database: *void, sql: string) -> s32 {
    if sql.count > 2147483647 {
        return SQLITE_TOOBIG
    }
    if sql.count < 256 {
        short_sql: [256]u8
        CopyStringBytes(sql, *short_sql[0])
        return ExecRaw(database, *short_sql[0], null, null, null)
    }
    buffer: *u8 = cast(*u8)malloc(cast(usize)sql.count + 1)
    if buffer == null {
        return SQLITE_NOMEM
    }
    CopyStringBytes(sql, buffer)
    result := ExecRaw(database, buffer, null, null, null)
    free(cast(*void)buffer)
    return result
}
