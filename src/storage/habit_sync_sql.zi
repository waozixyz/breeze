// Habit synchronization queries preserve newer local edits and pending outbox entries.

SyncRemoteHabitMapSQL :: #string SQL
INSERT OR IGNORE INTO sync_remote_habit_map(old_id,new_id) SELECT
h.id,COALESCE(json_extract(r.value,'$.id'),'') FROM (SELECT value FROM
json_each(?1,'$.changes.habits')       UNION ALL SELECT value FROM
json_each(?1,'$.data.habits')) AS r JOIN habits h ON
h.name=COALESCE(json_extract(r.value,'$.name'),'') WHERE h.deleted_at=0   AND
CAST(COALESCE(json_extract(r.value,'$.deleted_at'),0) AS INTEGER)=0   AND
COALESCE(json_extract(r.value,'$.id'),'')<>''   AND
h.id<>COALESCE(json_extract(r.value,'$.id'),'')
SQL

MergeRemoteHabitDaysSQL :: #string SQL
UPDATE habit_days
SET completed = MAX(completed, COALESCE((
        SELECT d.completed FROM habit_days d
        JOIN sync_remote_habit_map m ON m.old_id = d.habit_id
        WHERE m.new_id = habit_days.habit_id
          AND d.local_date = habit_days.local_date
    ), 0)),
    count = MAX(count, COALESCE((
        SELECT d.count FROM habit_days d
        JOIN sync_remote_habit_map m ON m.old_id = d.habit_id
        WHERE m.new_id = habit_days.habit_id
          AND d.local_date = habit_days.local_date
    ), 0)),
    session_count = MAX(session_count, COALESCE((
        SELECT d.session_count FROM habit_days d
        JOIN sync_remote_habit_map m ON m.old_id = d.habit_id
        WHERE m.new_id = habit_days.habit_id
          AND d.local_date = habit_days.local_date
    ), 0)),
    updated_at = MAX(updated_at, COALESCE((
        SELECT d.updated_at FROM habit_days d
        JOIN sync_remote_habit_map m ON m.old_id = d.habit_id
        WHERE m.new_id = habit_days.habit_id
          AND d.local_date = habit_days.local_date
    ), 0))
WHERE EXISTS (
    SELECT 1 FROM sync_remote_habit_map m
    WHERE m.new_id = habit_days.habit_id
)
SQL

InsertRemoteHabitDaysSQL :: #string SQL
INSERT INTO habit_days(
    habit_id, local_date, completed, count, session_count, updated_at
)
SELECT m.new_id, d.local_date, d.completed, d.count,
       d.session_count, d.updated_at
FROM habit_days d
JOIN sync_remote_habit_map m ON m.old_id = d.habit_id
WHERE NOT EXISTS (
    SELECT 1 FROM habit_days k
    WHERE k.habit_id = m.new_id AND k.local_date = d.local_date
)
SQL

FinishRemoteHabitIDsSQL :: #string SQL
UPDATE OR IGNORE sync_outbox
SET entity_id = (
    SELECT m.new_id FROM sync_remote_habit_map m
    WHERE m.old_id = sync_outbox.entity_id
)
WHERE entity_type IN ('habit', 'habit_day')
  AND EXISTS (
      SELECT 1 FROM sync_remote_habit_map m
      WHERE m.old_id = sync_outbox.entity_id
  );
DELETE FROM sync_outbox
WHERE entity_type IN ('habit', 'habit_day')
  AND EXISTS (
      SELECT 1 FROM sync_remote_habit_map m
      WHERE m.old_id = sync_outbox.entity_id
  );
INSERT INTO sync_outbox(entity_type, entity_id, local_date, queued_at)
SELECT 'habit_entry', e.id, 0, CAST(strftime('%s','now') AS INTEGER)
FROM habit_entries e
JOIN sync_remote_habit_map m ON m.old_id = e.habit_id
ON CONFLICT(entity_type, entity_id, local_date) DO UPDATE SET queued_at = excluded.queued_at;
INSERT INTO sync_outbox(entity_type, entity_id, local_date, queued_at)
SELECT 'habit_change', c.id, 0, CAST(strftime('%s','now') AS INTEGER)
FROM habit_changes c
JOIN sync_remote_habit_map m ON m.old_id = c.habit_id
ON CONFLICT(entity_type, entity_id, local_date) DO UPDATE SET queued_at = excluded.queued_at;
UPDATE habit_changes
SET habit_id = (
    SELECT m.new_id FROM sync_remote_habit_map m
    WHERE m.old_id = habit_changes.habit_id
),
    updated_at = MAX(updated_at + 1, CAST(strftime('%s','now') AS INTEGER))
WHERE EXISTS (
    SELECT 1 FROM sync_remote_habit_map m
    WHERE m.old_id = habit_changes.habit_id
);
UPDATE habit_entries
SET habit_id = (
    SELECT m.new_id FROM sync_remote_habit_map m
    WHERE m.old_id = habit_entries.habit_id
),
    updated_at = MAX(updated_at + 1, CAST(strftime('%s','now') AS INTEGER))
WHERE EXISTS (
    SELECT 1 FROM sync_remote_habit_map m
    WHERE m.old_id = habit_entries.habit_id
);
DELETE FROM habit_days
WHERE EXISTS (
    SELECT 1 FROM sync_remote_habit_map m
    WHERE m.old_id = habit_days.habit_id
);
DELETE FROM habits
WHERE EXISTS (
    SELECT 1 FROM sync_remote_habit_map m
    WHERE m.old_id = habits.id
);
SQL

SyncHabitsSQL :: #string SQL
INSERT INTO
habits(id,user_id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,sort_order,deleted_at,updated_at,weekdays,reminder_hour,deactivated,icon,schedule,questions,span,span_goal,span_low,span_high,difficulty,custom_coins,coin_halves)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
COALESCE(json_extract(value,'$.name'),''),
CAST(COALESCE(json_extract(value,'$.color_r'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.color_g'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.color_b'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.sync_mode'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.sync_activity'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.counter_enabled'), (SELECT
counter_enabled FROM habits WHERE id=json_extract(value,'$.id')),
0) AS INT), CAST(COALESCE(json_extract(value,'$.counter_target'),
(SELECT counter_target FROM habits WHERE id=json_extract(value,'$.id')),
1) AS INT), CAST(COALESCE(json_extract(value,'$.sort_order'),0) AS INT),
CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INT),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INT),
CAST(COALESCE(json_extract(value,'$.weekdays'), (SELECT weekdays FROM habits
WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.reminder_hour'), (SELECT reminder_hour
FROM habits WHERE id=json_extract(value,'$.id')),-1) AS INT),
CAST(COALESCE(json_extract(value,'$.deactivated'), (SELECT deactivated
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.icon'), (SELECT icon
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.schedule'), (SELECT schedule
FROM habits WHERE id=json_extract(value,'$.id')),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.questions'), (SELECT questions
FROM habits WHERE id=json_extract(value,'$.id')),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.span'), (SELECT span
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.span_goal'), (SELECT span_goal
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.span_low'), (SELECT span_low
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.span_high'), (SELECT span_high
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.difficulty'), (SELECT difficulty
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.custom_coins'), (SELECT custom_coins
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT),
CAST(COALESCE(json_extract(value,'$.coin_halves'), (SELECT coin_halves
FROM habits WHERE id=json_extract(value,'$.id')),0) AS INT) FROM (SELECT value
FROM json_each(?1,'$.changes.habits') UNION ALL SELECT value FROM
json_each(?1,'$.data.habits')) WHERE COALESCE(json_extract(value,'$.id'),'')<>'' ON CONFLICT(id)
DO UPDATE SET
user_id=excluded.user_id,name=excluded.name,color_r=excluded.color_r,color_g=excluded.color_g,
color_b=excluded.color_b,sync_mode=excluded.sync_mode,sync_activity=excluded.sync_activity,
counter_enabled=excluded.counter_enabled,counter_target=excluded.counter_target,sort_order=excluded.sort_order,deleted_at=excluded.deleted_at,
updated_at=excluded.updated_at, weekdays=excluded.weekdays,reminder_hour=excluded.reminder_hour,
deactivated=excluded.deactivated,icon=excluded.icon,schedule=excluded.schedule,
questions=excluded.questions,span=excluded.span,span_goal=excluded.span_goal,
span_low=excluded.span_low,span_high=excluded.span_high,difficulty=excluded.difficulty,
custom_coins=excluded.custom_coins,coin_halves=excluded.coin_halves
WHERE excluded.updated_at > habits.updated_at OR (excluded.updated_at = habits.updated_at AND
NOT EXISTS ( SELECT 1 FROM sync_outbox WHERE entity_type='habit' AND entity_id=habits.id AND
local_date=0))
SQL

// While a device downloads every record again after an update (see
// STORAGE_SYNC_RECORD_FIELDS in storage_core.zi), a habit it received in an
// older version may lack settings that version didn't keep. Those settings
// come from the account's record even where the device's habit looks newer;
// settings the device already has stay.
SyncHabitsFillMissingSQL :: #string SQL
WITH incoming AS (SELECT value FROM json_each(?1,'$.changes.habits') UNION ALL
SELECT value FROM json_each(?1,'$.data.habits'))
UPDATE habits SET
icon=CASE WHEN habits.icon=0 THEN COALESCE(r.icon,0) ELSE habits.icon END,
weekdays=CASE WHEN habits.weekdays=0 THEN COALESCE(r.weekdays,0) ELSE habits.weekdays END,
reminder_hour=CASE WHEN habits.reminder_hour<0 THEN COALESCE(r.reminder_hour,-1) ELSE habits.reminder_hour END,
schedule=CASE WHEN habits.schedule='' THEN COALESCE(r.schedule,'') ELSE habits.schedule END,
questions=CASE WHEN habits.questions='' THEN COALESCE(r.questions,'') ELSE habits.questions END,
span_goal=CASE WHEN habits.span=0 AND COALESCE(r.span,0)<>0 THEN COALESCE(r.span_goal,0) ELSE habits.span_goal END,
span_low=CASE WHEN habits.span=0 AND COALESCE(r.span,0)<>0 THEN COALESCE(r.span_low,0) ELSE habits.span_low END,
span_high=CASE WHEN habits.span=0 AND COALESCE(r.span,0)<>0 THEN COALESCE(r.span_high,0) ELSE habits.span_high END,
span=CASE WHEN habits.span=0 THEN COALESCE(r.span,0) ELSE habits.span END,
difficulty=CASE WHEN habits.difficulty=0 THEN COALESCE(r.difficulty,0) ELSE habits.difficulty END
FROM (SELECT CAST(json_extract(value,'$.id') AS TEXT) AS id,
CAST(json_extract(value,'$.icon') AS INTEGER) AS icon,
CAST(json_extract(value,'$.weekdays') AS INTEGER) AS weekdays,
CAST(json_extract(value,'$.reminder_hour') AS INTEGER) AS reminder_hour,
CAST(json_extract(value,'$.schedule') AS TEXT) AS schedule,
CAST(json_extract(value,'$.questions') AS TEXT) AS questions,
CAST(json_extract(value,'$.span') AS INTEGER) AS span,
CAST(json_extract(value,'$.span_goal') AS INTEGER) AS span_goal,
CAST(json_extract(value,'$.span_low') AS INTEGER) AS span_low,
CAST(json_extract(value,'$.span_high') AS INTEGER) AS span_high,
CAST(json_extract(value,'$.difficulty') AS INTEGER) AS difficulty
FROM incoming WHERE COALESCE(json_extract(value,'$.deleted_at'),0)=0) AS r
WHERE habits.id=r.id AND habits.deleted_at=0
SQL

// The first day a habit earns coins is the earliest any device gave it, so
// every device counts the same days whichever record is newer. A habit
// from a version before coins earns from the day it arrives.
SyncHabitCoinsFromSQL :: #string SQL
WITH incoming AS (SELECT value FROM json_each(?1,'$.changes.habits') UNION ALL
SELECT value FROM json_each(?1,'$.data.habits'))
UPDATE habits SET coins_from=r.coins_from
FROM (SELECT CAST(json_extract(value,'$.id') AS TEXT) AS id,
MIN(CAST(json_extract(value,'$.coins_from') AS INTEGER)) AS coins_from
FROM incoming WHERE CAST(COALESCE(json_extract(value,'$.coins_from'),0) AS INTEGER)>0
GROUP BY 1) AS r
WHERE habits.id=r.id AND (habits.coins_from=0 OR r.coins_from<habits.coins_from)
SQL

SyncHabitCoinsFromTodaySQL :: "UPDATE habits SET coins_from=CAST(strftime('%Y%m%d','now','localtime') AS INTEGER) WHERE coins_from=0"

SyncHabitDaysSQL :: #string SQL
INSERT INTO habit_days(habit_id,local_date,completed,count,updated_at) SELECT
COALESCE(json_extract(value,'$.habit_id'),''),
CAST(COALESCE(json_extract(value,'$.local_date'),0) AS INTEGER),       CASE WHEN
json_extract(value,'$.completed') THEN 1 ELSE 0 END,
CAST(COALESCE(json_extract(value,'$.count'),CASE WHEN json_extract(value,'$.completed') THEN 1
ELSE 0 END) AS INTEGER),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER) FROM (SELECT
value FROM json_each(?1,'$.changes.habit_days')       UNION ALL SELECT value FROM
json_each(?1,'$.data.habit_days')) WHERE COALESCE(json_extract(value,'$.habit_id'),'')<>''   AND
CAST(COALESCE(json_extract(value,'$.local_date'),0) AS INTEGER)>0 ON
CONFLICT(habit_id,local_date) DO UPDATE SET
completed=excluded.completed,count=excluded.count,updated_at=excluded.updated_at WHERE
excluded.updated_at > habit_days.updated_at OR (excluded.updated_at = habit_days.updated_at AND
NOT EXISTS (     SELECT 1 FROM sync_outbox      WHERE entity_type='habit_day' AND
entity_id=habit_days.habit_id        AND local_date=habit_days.local_date    ))
SQL

// A habit's entries from another device. A newer entry wins; at an equal
// time the device's own queued change does.
SyncHabitEntriesSQL :: #string SQL
INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
COALESCE(json_extract(value,'$.habit_id'),''),
CAST(COALESCE(json_extract(value,'$.local_date'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.started_at'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.ended_at'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.answers'),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INTEGER),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.habit_entries') UNION ALL SELECT value FROM
json_each(?1,'$.data.habit_entries')) WHERE COALESCE(json_extract(value,'$.id'),'')<>'' AND
COALESCE(json_extract(value,'$.habit_id'),'')<>'' ON CONFLICT(id) DO UPDATE SET
habit_id=excluded.habit_id,local_date=excluded.local_date,started_at=excluded.started_at,
ended_at=excluded.ended_at,answers=excluded.answers,deleted_at=excluded.deleted_at,
updated_at=excluded.updated_at WHERE excluded.updated_at > habit_entries.updated_at OR
(excluded.updated_at = habit_entries.updated_at AND NOT EXISTS ( SELECT 1 FROM sync_outbox
WHERE entity_type='habit_entry' AND entity_id=habit_entries.id))
SQL

// Changes of habits' settings made on another device. A change is made
// once; a newer copy of it wins, as when its habit was merged.
SyncHabitChangesSQL :: #string SQL
INSERT INTO habit_changes(id,user_id,habit_id,changed_at,kind,question,question_text,old_value,new_value,deleted_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
COALESCE(json_extract(value,'$.habit_id'),''),
CAST(COALESCE(json_extract(value,'$.changed_at'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.kind'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.question'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.question_text'),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.before'),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.after'),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INTEGER),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.habit_changes') UNION ALL SELECT value FROM
json_each(?1,'$.data.habit_changes')) WHERE COALESCE(json_extract(value,'$.id'),'')<>'' AND
COALESCE(json_extract(value,'$.habit_id'),'')<>'' ON CONFLICT(id) DO UPDATE SET
habit_id=excluded.habit_id,deleted_at=excluded.deleted_at,updated_at=excluded.updated_at
WHERE excluded.updated_at > habit_changes.updated_at
SQL

// The shop's rewards from another device. A newer copy wins; at an equal
// time the device's own queued change does. A copy from a version without
// symbols keeps the reward's symbol here.
SyncHabitRewardsSQL :: #string SQL
INSERT INTO habit_rewards(id,user_id,name,price,icon,deleted_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
CAST(COALESCE(json_extract(value,'$.name'),'') AS TEXT),
MIN(MAX(CAST(COALESCE(json_extract(value,'$.price'),1) AS INTEGER),1),9999),
MAX(CAST(COALESCE(json_extract(value,'$.icon'),(SELECT r.icon FROM habit_rewards r
WHERE r.id=json_extract(value,'$.id')),0) AS INTEGER),0),
CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INTEGER),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.habit_rewards') UNION ALL SELECT value FROM
json_each(?1,'$.data.habit_rewards')) WHERE COALESCE(json_extract(value,'$.id'),'')<>''
ON CONFLICT(id) DO UPDATE SET name=excluded.name,price=excluded.price,icon=excluded.icon,
deleted_at=excluded.deleted_at,updated_at=excluded.updated_at
WHERE excluded.updated_at > habit_rewards.updated_at OR
(excluded.updated_at = habit_rewards.updated_at AND NOT EXISTS ( SELECT 1 FROM sync_outbox
WHERE entity_type='habit_reward' AND entity_id=habit_rewards.id))
SQL

// Coins spent on rewards and kept from deleted habits on another device.
// A newer copy wins, as when the coins were deleted with all the data.
SyncHabitCoinsSQL :: #string SQL
INSERT INTO habit_coins(id,user_id,kind,reward_id,name,coins,at,deleted_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
CAST(COALESCE(json_extract(value,'$.kind'),1) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.reward_id'),'') AS TEXT),
CAST(COALESCE(json_extract(value,'$.name'),'') AS TEXT),
CASE WHEN CAST(COALESCE(json_extract(value,'$.kind'),1) AS INTEGER)=2 THEN
CAST(COALESCE(json_extract(value,'$.coins'),0) AS INTEGER)
ELSE MAX(CAST(COALESCE(json_extract(value,'$.coins'),0) AS INTEGER),0) END,
CAST(COALESCE(json_extract(value,'$.at'),0) AS INTEGER),
CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INTEGER),
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.habit_coins') UNION ALL SELECT value FROM
json_each(?1,'$.data.habit_coins')) WHERE COALESCE(json_extract(value,'$.id'),'')<>'' AND
CAST(COALESCE(json_extract(value,'$.kind'),1) AS INTEGER) IN (1,2)
ON CONFLICT(id) DO UPDATE SET name=excluded.name,coins=excluded.coins,
deleted_at=excluded.deleted_at,updated_at=excluded.updated_at
WHERE excluded.updated_at > habit_coins.updated_at OR
(excluded.updated_at = habit_coins.updated_at AND NOT EXISTS ( SELECT 1 FROM sync_outbox
WHERE entity_type='habit_coin' AND entity_id=habit_coins.id))
SQL
