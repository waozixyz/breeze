// Names for the apps the node offers and the account data they keep. Each
// such app has a short name ("chess"); its installed mark syncs as
// app_used_<name> in its own collection, and its private records as
// cell.<name>.<record> in private.inbe.v1.app.<name>. Released apps reject
// unknown keys in the older collections, so none of this goes there.

NODE_APP_NAME_MIN :: 2
NODE_APP_NAME_MAX :: 24
NODE_APP_RECORD_NAME_MAX :: 64
NodeAppInstallsCollection :: "private.inbe.v1.app-installs"
NodeAppRecordsCollectionPrefix :: "private.inbe.v1.app."
NestedAppRecordsCollection :: "private.inbe.v1.nested-apps"

// Nested apps use a digest of their verified publisher authority and stable
// app ID as storage owner. Route, revision and transient runtime slot are
// deliberately absent. Legacy records keep their original keys below.
NestedAppRecordKeyValid :: (key: string) -> bool {
    if key.count < 73 || key.count > 136 || key[:7] != "nested." || key[71] != #char "." {
        return false
    }
    for byte: key[7:71] {
        if !((byte >= #char "0" && byte <= #char "9") ||
            (byte >= #char "a" && byte <= #char "f")) {
            return false
        }
    }
    return NodeAppRecordNameValid(key[72:])
}

// Names the bundled apps and their records already use, and the account's
// media library (cell.media.*, synced in its own collection).
NodeAppNameReserved :: (name: string) -> bool {
    return name == "inbe" || name == "lists" || name == "habits" || name == "practices" ||
    name == "practice" || name == "diary" || name == "lumi" || name == "leaderboard" ||
    name == "feedback" || name == "app" || name == "apps" || name == "media" ||
    name == "achievement"
}

// A lowercase letter, then lowercase letters and digits.
NodeAppNameValid :: (name: string) -> bool {
    if name.count < NODE_APP_NAME_MIN || name.count > NODE_APP_NAME_MAX ||
    name[0] < #char "a" || name[0] > #char "z" || NodeAppNameReserved(name) {
        return false
    }
    for byte: name {
        letter := byte >= #char "a" && byte <= #char "z"
        digit := byte >= #char "0" && byte <= #char "9"
        if !letter && !digit {
            return false
        }
    }
    return true
}

// Apps the node used to offer that another app replaced. Arcade carries
// Chess among its games, with Chess's records and shared games.
NODE_APP_REPLACED_COUNT :: 1

NodeAppReplaced :: (index: s32) -> string {
    if index == 0 {
        return "chess"
    }
    return ""
}

// The app that replaced `name`, or empty.
NodeAppReplacement :: (name: string) -> string {
    if name == "chess" {
        return "arcade"
    }
    return ""
}

// What happens next for an account that installed a replaced app.
NODE_APP_REPLACE_WAIT :: 0
NODE_APP_REPLACE_RETIRE :: 2

// The replaced app goes only once its replacement runs on this device and
// verifiably carries it, so its saved and shared records open there. Until
// then it stays. The replacement is never installed for the account: it
// waits in More apps with the download symbol, like any app not yet here.
NodeAppReplacementStep :: (replaced_installed: bool, replacement_carries: bool) -> s32 {
    if replaced_installed && replacement_carries {
        return NODE_APP_REPLACE_RETIRE
    }
    return NODE_APP_REPLACE_WAIT
}

// A record name an app chooses: lowercase letters, digits, dots and dashes.
NodeAppRecordNameValid :: (name: string) -> bool {
    if name.count < 1 || name.count > NODE_APP_RECORD_NAME_MAX {
        return false
    }
    for byte: name {
        letter := byte >= #char "a" && byte <= #char "z"
        digit := byte >= #char "0" && byte <= #char "9"
        if !letter && !digit && byte != #char "." && byte != #char "-" {
            return false
        }
    }
    return true
}

// The app's name in app_used_<name>, or empty.
NodeAppInstallName :: (key: string) -> string {
    if key.count <= 9 || key[:9] != "app_used_" || !NodeAppNameValid(key[9:]) {
        return ""
    }
    return key[9:]
}

NodeAppInstallKeyValid :: (key: string) -> bool {
    return NodeAppInstallName(key).count > 0
}

// The app's name in cell.<name>.<record>, or empty.
NodeAppRecordOwner :: (key: string) -> string {
    if key.count < 8 || key.count > 180 || key[:5] != "cell." {
        return ""
    }
    end: s64 = 5
    while end < key.count && key[end] != #char "." {
        end += 1
    }
    if end >= key.count - 1 || !NodeAppNameValid(key[5:end]) ||
    !NodeAppRecordNameValid(key[end + 1:]) {
        return ""
    }
    return key[5:end]
}

NodeAppRecordKeyValid :: (key: string) -> bool {
    return NestedAppRecordKeyValid(key) || NodeAppRecordOwner(key).count > 0
}

// Whether a collection is one app's record collection.
NodeAppRecordsCollectionValid :: (collection: string) -> bool {
    prefix := NodeAppRecordsCollectionPrefix
    return collection.count > prefix.count && collection[:prefix.count] == prefix &&
    NodeAppNameValid(collection[prefix.count:])
}

// A shared record of an app: its name, a dash and at most 36 characters
// in all. It is never shaped like the UUIDs Lists gives its lists.
NodeAppSharedIdValid :: (name: string, id: string) -> bool {
    if id.count <= name.count + 1 || id.count > 36 || id[:name.count] != name ||
    id[name.count] != #char "-" {
        return false
    }
    for byte: id[name.count + 1:] {
        letter := byte >= #char "a" && byte <= #char "z"
        digit := byte >= #char "0" && byte <= #char "9"
        if !letter && !digit && byte != #char "-" {
            return false
        }
    }
    return !SharedIdLooksLikeList(id)
}

// Lists' own ids: 8-4-4-4-12 hexadecimal digits.
SharedIdLooksLikeList :: (id: string) -> bool {
    if id.count != 36 {
        return false
    }
    index: s64 = 0
    while index < 36 {
        byte := id[index]
        dash := index == 8 || index == 13 || index == 18 || index == 23
        if dash {
            if byte != #char "-" {
                return false
            }
        } else {
            hex := (byte >= #char "0" && byte <= #char "9") || (byte >= #char "a" && byte <= #char "f") ||
            (byte >= #char "A" && byte <= #char "F")
            if !hex {
                return false
            }
        }
        index += 1
    }
    return true
}

// The local prefix is outside every synchronized collection. The nested
// app identity still scopes the record to its publisher and account.
NodeAppLocalRecordKeyValid :: (key: string) -> bool {
    return key.count > 6 && key[:6] == "local." && NodeAppRecordKeyValid(key[6:])
}

NodeAppRecordIsLocal :: (record: string) -> bool {
    return record.count > 6 && record[:6] == "local." && NodeAppRecordNameValid(record[6:])
}

NodeAppRecordMaySync :: (device_only: bool, valid: bool) -> bool {
    return valid && !device_only
}
