        AppTextFromCString(SqliteColumnText(stmt, 1), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "title",
        AppTextFromCString(SqliteColumnText(stmt, 2), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "comment",
        AppTextFromCString(SqliteColumnText(stmt, 3), 8192))
