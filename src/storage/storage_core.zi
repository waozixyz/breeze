c :: #system_library "c";
StorageCacheFlush :: (database: *void) -> s32 #foreign c "sqlite3_db_cacheflush";
StorageDelegateMode :: #type () -> s32;
StorageDelegateAvailable :: #type () -> s32;
StorageDelegateKey :: #type (collection: string, key_id: string, out: *u8) -> s32;
StorageDelegateBinding :: #type (client: DelegateClient) -> s32;
storage_delegate_mode: StorageDelegateMode;
storage_delegate_available: StorageDelegateAvailable;
storage_delegate_key: StorageDelegateKey;
storage_delegate_binding: StorageDelegateBinding;

calloc :: (count: usize, size: usize) -> *void #foreign c;
SYNC_PROTOCOL_VERSION :: 6
LOG_INFO :: 3
LOG_ERROR :: 5
sqlite3_get_autocommit :: (database: *void) -> s32 #foreign c "sqlite3_get_autocommit";
storage_duplicate_cstring :: (source: *u8) -> *u8 {
    if source == null { return null }
    length: u64 = 0
    while source[length] != cast(u8)0 {
        if length == 9223372036854775806 { return null }
        length += 1
    }
    duplicate := cast(*u8)calloc(cast(usize)(length + 1), 1)
    if duplicate == null { return null }
    index: u64 = 0
    while index < length {
        duplicate[index] = source[index]
        index += 1
    }
    return duplicate
}
set_meta :: (key: *u8, value: *u8) #foreign c "set_meta";
storage_meta_int64 :: (key: string, fallback: s64) -> s64 {
    key_buf: [64] u8
    if !AppCopyText(key, key_buf[:]) { return fallback }
    return get_meta_int64(*key_buf[0], fallback)
}

storage_meta_text :: (key: string) -> string {
    key_buf: [64]u8
    if !AppCopyText(key, key_buf[:]) { return "" }
    return AppTextFromCString(get_meta_text(*key_buf[0]), 8192)
}

storage_set_meta_int64 :: (key: string, value: s64) {
    key_buf: [64]u8
    if !AppCopyText(key, key_buf[:]) { return }
    set_meta_int64(*key_buf[0], value)
}

set_meta_int64_buf :: (key: string, value: s64) {
    storage_set_meta_int64(key, value)
}

set_meta_buf :: (key: string, value: string) {
    key_buf: [64] u8
    value_buf: [256] u8
    AppCopyText(key, key_buf[:])
    AppCopyText(value, value_buf[:])
    set_meta(*key_buf[0], *value_buf[0])
}

storage_log_number :: (label: string, value: s64) {
    value_text: [24]u8
    if AppFormatS64(value, value_text[:]) {
        LogStorageText(LOG_INFO, label, AppTextFromCString(*value_text[0], 24))
    }
}

storage_compare_text :: (left: string, right: string) -> s32 {
    return ifx (left == right) then (0) else (1)
}

storage_parse_setting_int :: (text: string) -> s32 {
    index: s32 = 0
    while index < cast(s32)text.count &&
    (text[index] == cast(u8)32 || text[index] == cast(u8)9) {
        index += 1
    }
    negative := false
    if index < cast(s32)text.count &&
    (text[index] == cast(u8)45 || text[index] == cast(u8)43) {
        negative = text[index] == cast(u8)45
        index += 1
    }
    magnitude: s64 = 0
    limit: s64 = ifx (negative) then (2147483648) else (2147483647)
    while index < cast(s32)text.count {
        byte := text[index]
        if byte < cast(u8)48 || byte > cast(u8)57 { break }
        digit := cast(s64)(byte - cast(u8)48)
        if magnitude > (limit - digit) / 10 {
            return ifx (negative) then (-2147483647 - 1) else (2147483647)
        }
        magnitude = magnitude * 10 + digit
        index += 1
    }
    return ifx (negative) then (cast(s32)-magnitude) else (cast(s32)magnitude)
}

