storage_meta_int64 :: (key: string, fallback: s64) -> s64 {
    key_buf: [64] u8
    if !AppCopyText(key, key_buf[:]) { return fallback }
    return get_meta_int64(*key_buf[0], fallback)
}

storage_meta_text :: (key: string) -> string {
    key_buf: [64]u8
    if !AppCopyText(key, key_buf[:]) { return "" }
    return AppTextFromCString(get_meta_text(*key_buf[0]), 8192)
}

storage_set_meta_int64 :: (key: string, value: s64) {
    key_buf: [64]u8
    if !AppCopyText(key, key_buf[:]) { return }
    set_meta_int64(*key_buf[0], value)
}

set_meta_int64_buf :: (key: string, value: s64) {
    storage_set_meta_int64(key, value)
}

set_meta_buf :: (key: string, value: string) {
    key_buf: [64] u8
    value_buf: [256] u8
    AppCopyText(key, key_buf[:])
    AppCopyText(value, value_buf[:])
    set_meta(*key_buf[0], *value_buf[0])
}
