}

storage_append_session_rounds_json :: (json: *StorageJsonBuilder, session_id: string) {
    stmt: *void = null
    first: s32 = 1
    storage_json_builder_append_text(json, "\"rounds\":[")
    sql_cx12: [96] u8
    AppCopyText("SELECT round_index,seconds FROM session_rounds WHERE session_id=?1 ORDER BY round_index", sql_cx12[:])
    if storage_db_handle() != null && session_id.count > 0 && SqlitePrepare(storage_db_handle(), *sql_cx12[0], -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, session_id)
        while SqliteStep(stmt) == SQLITE_ROW {
            seconds: s32 = sqlite3_column_int(stmt, 1)
            if first == 0 {
                storage_json_builder_append_text(json, ",")
            }
            first = 0
            storage_json_builder_append_text(json, "{")
            storage_json_builder_append_text(json, "\"round_index\":")
            digits: [24] u8
            AppFormatS32(sqlite3_column_int(stmt, 0), digits[:])
            storage_json_builder_append_text(json, AppTextFromCString(*digits[0], 24))
            storage_json_builder_append_text(json, ",\"breaths\":0,\"hold_seconds\":")
            AppFormatS32(seconds, digits[:])
            storage_json_builder_append_text(json, AppTextFromCString(*digits[0], 24))
            storage_json_builder_append_text(json, "}")
        }
    }
    if stmt != null {
        SqliteFinalize(stmt)
    }
    storage_json_builder_append_text(json, "]")
}

storage_append_session_row_json :: (json_handle: s64, stmt_handle: s64) {
    json: *StorageJsonBuilder = cast(*StorageJsonBuilder)json_handle
    stmt: *void = cast(*void)stmt_handle
    id: string = AppTextFromCString(SqliteColumnText(stmt, 0), 8192)
    started_at: s64 = SqliteColumnInt64(stmt, 1)
    updated_at: s64 = SqliteColumnInt64(stmt, 14)
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "id", id)
    storage_json_builder_append_text(json, ",\"started_at\":")
    storage_json_builder_append_epoch(json, started_at)
    storage_json_append_int_field(json, "local_date", cast(s64)sqlite3_column_int(stmt, 2))
    // The topic travels as a string.
    digits: [24] u8
    AppFormatS32(sqlite3_column_int(stmt, 3), digits[:])
    storage_json_builder_append_text(json, ",\"topic\":\"")
    storage_json_builder_append_text(json, AppTextFromCString(*digits[0], 24))
    storage_json_builder_append_text(json, "\"")
    storage_json_append_int_field(json, "activity", cast(s64)sqlite3_column_int(stmt, 4))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "source", AppTextFromCString(SqliteColumnText(stmt, 5), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "rounds_hash", AppTextFromCString(SqliteColumnText(stmt, 6), 8192))
    storage_json_append_int_field(json, "mood_before", cast(s64)sqlite3_column_int(stmt, 7))
    storage_json_append_int_field(json, "mood_after", cast(s64)sqlite3_column_int(stmt, 8))
    storage_json_append_int_field(json, "energy", cast(s64)sqlite3_column_int(stmt, 9))
    storage_json_append_int_field(json, "stress", cast(s64)sqlite3_column_int(stmt, 10))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "note", AppTextFromCString(SqliteColumnText(stmt, 11), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "tags", AppTextFromCString(SqliteColumnText(stmt, 12), 8192))
    storage_json_append_int_field(json, "deleted_at", SqliteColumnInt64(stmt, 13))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, ifx (updated_at > 0) then (updated_at) else (started_at))
    storage_json_builder_append_text(json, ",")
    storage_append_session_rounds_json(json, id)
    storage_json_builder_append_text(json, "}")
}

StorageJsonRowFn :: #type (json_handle: s64, stmt_handle: s64) -> ();

storage_append_id_payload_json :: (json: *StorageJsonBuilder, sql: string, id: string, append_row: StorageJsonRowFn) -> s32 {
    stmt: *void = null
    found: s32 = 0
    if storage_db_handle() == null || id.count == 0 {
        return 0
    }
    sql_buf: [1024] u8
    AppCopyText(sql, sql_buf[:])
    if SqlitePrepare(storage_db_handle(), *sql_buf[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, id)
    if SqliteStep(stmt) == SQLITE_ROW {
        found = 1
        append_row(cast(s64)json, cast(s64)stmt)
    }
    SqliteFinalize(stmt)
    return found
}

storage_append_dated_payload_json :: (json: *StorageJsonBuilder, sql: string, id: string, local_date: s32, append_row: StorageJsonRowFn) -> s32 {
    stmt: *void = null
    found: s32 = 0
    if storage_db_handle() == null || id.count == 0 {
        return 0
    }
    sql_buf2: [1024] u8
    AppCopyText(sql, sql_buf2[:])
    if SqlitePrepare(storage_db_handle(), *sql_buf2[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, id)
    sqlite3_bind_int(stmt, 3, local_date)
    if SqliteStep(stmt) == SQLITE_ROW {
        found = 1
        append_row(cast(s64)json, cast(s64)stmt)
    }
    SqliteFinalize(stmt)
    return found
}

storage_append_habit_payload_json :: (json: *StorageJsonBuilder, habit_id: string) -> s32 {
    return storage_append_id_payload_json(
        json,
        "SELECT id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,sort_order,deleted_at,updated_at,weekdays,reminder_hour FROM habits WHERE user_id=?1 AND id=?2",
        habit_id, storage_append_habit_row_json)
}

storage_append_habit_day_payload_json :: (json: *StorageJsonBuilder, habit_id: string, local_date: s32) -> s32 {
    return storage_append_dated_payload_json(
        json,
        "SELECT hd.habit_id,hd.local_date,hd.completed,hd.count,hd.updated_at FROM habit_days hd JOIN habits h ON h.id=hd.habit_id WHERE h.user_id=?1 AND hd.habit_id=?2 AND hd.local_date=?3",
        habit_id, local_date, storage_append_habit_day_row_json)
}

storage_append_session_payload_json :: (json: *StorageJsonBuilder, session_id: string) -> s32 {
    return storage_append_id_payload_json(
        json,
        "SELECT id,started_at,local_date,topic,activity,source,rounds_hash,mood_before,mood_after,energy,stress,note,tags,deleted_at,updated_at FROM sessions WHERE user_id=?1 AND id=?2",
        session_id, storage_append_session_row_json)
}

storage_append_elist_list_payload_json :: (json: *StorageJsonBuilder, list_id: string) -> s32 {
    return storage_append_id_payload_json(
        json,
        "SELECT id,title,sort_order,deleted_at,updated_at FROM elist_lists WHERE user_id=?1 AND id=?2",
        list_id, storage_append_elist_list_row_json)
}

storage_append_elist_item_payload_json :: (json: *StorageJsonBuilder, item_id: string) -> s32 {
    return storage_append_id_payload_json(
        json,
        "SELECT id,list_id,title,comment,done,sort_order,deleted_at,updated_at FROM elist_items WHERE user_id=?1 AND id=?2",
        item_id, storage_append_elist_item_row_json)
}

storage_sync_op_is_delete :: (entity_type: string, entity_id: string, local_date: s32) -> s32 {
    stmt: *void = null
    deleted: s32 = 0
    if storage_db_handle() == null || entity_type.count == 0 || entity_id.count == 0 {
        return 1
    }
    if storage_compare_text(entity_type, "habit") == 0 {
        sql_cz1: [64] u8
        AppCopyText("SELECT deleted_at FROM habits WHERE user_id=?1 AND id=?2", sql_cz1[:])
        if SqlitePrepare(storage_db_handle(), *sql_cz1[0], -1, *stmt, null) != SQLITE_OK {
            return 0
        }
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 2, entity_id)
        if SqliteStep(stmt) == SQLITE_ROW {
            deleted = 0
            if SqliteColumnInt64(stmt, 0) > 0 {
                deleted = 1
            }
        } else {
            deleted = 1
        }
    } else if storage_compare_text(entity_type, "session") == 0 {
        sql_cz2: [96] u8
        AppCopyText("SELECT deleted_at FROM sessions WHERE user_id=?1 AND id=?2", sql_cz2[:])
        if SqlitePrepare(storage_db_handle(), *sql_cz2[0], -1, *stmt, null) != SQLITE_OK {
            return 0
        }
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 2, entity_id)
        if SqliteStep(stmt) == SQLITE_ROW {
            deleted = 0
            if SqliteColumnInt64(stmt, 0) > 0 {
                deleted = 1
            }
        } else {
            deleted = 1
        }
    } else if storage_compare_text(entity_type, "habit_day") == 0 {
        sql_cx8: [82] u8
        AppCopyText("SELECT completed,count FROM habit_days WHERE habit_id=?1 AND local_date=?2", sql_cx8[:])
        if SqlitePrepare(storage_db_handle(), *sql_cx8[0], -1, *stmt, null) != SQLITE_OK {
            return 0
        }
        bind_text(stmt, 1, entity_id)
        sqlite3_bind_int(stmt, 2, local_date)
        if SqliteStep(stmt) != SQLITE_ROW {
            deleted = 1
        }
    } else if storage_compare_text(entity_type, "elist_list") == 0  || storage_compare_text(entity_type, "elist_item") == 0 {
        table: string = ifx (storage_compare_text(entity_type, "elist_list") == 0) then ("elist_lists") else ("elist_items")
        sql: [160] u8
        if SqlitePrepare(storage_db_handle(), *sql[0], -1, *stmt, null) != SQLITE_OK {
            return 0
        }
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 2, entity_id)
        if SqliteStep(stmt) == SQLITE_ROW {
            deleted = 0
            if SqliteColumnInt64(stmt, 0) > 0 {
                deleted = 1
            }
        } else {
            deleted = 1
        }
    }
    SqliteFinalize(stmt)
    return deleted
}

storage_append_app_preference_payload_json :: (json: *StorageJsonBuilder, key: string) -> s32 {
    if !AppPreferenceValid(key) {
        return 0
    }
    statement: *void = null
    if SqlitePrepareText(storage_db_handle(),
        "SELECT value,updated_at FROM settings WHERE user_id=?1 AND key=?2", -1,
        *statement, null) != SQLITE_OK {
        return 0
    }
    defer {
        unused SqliteFinalize(statement)
    }
    bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(statement, 2, key)
    if SqliteStep(statement) != SQLITE_ROW {
        return 0
    }
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "key", key)
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "value", AppTextFromCString(SqliteColumnText(statement, 0), 16))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(statement, 1))
    storage_json_builder_append_text(json, "}")
    return json.ok
}

storage_append_cell_payload_json :: (json: *StorageJsonBuilder, key: string) -> s32 {
    if !CellRecordValid(key) { return 0 }
    statement: *void
    if SqlitePrepareText(storage_db_handle(), "SELECT value,updated_at FROM settings WHERE user_id=?1 AND key=?2", -1, *statement, null) != SQLITE_OK { return 0 }
    defer { SqliteFinalize(statement) }
    bind_text(statement, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(statement, 2, key)
    if SqliteStep(statement) != SQLITE_ROW { return 0 }
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "key", key)
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "value", AppTextFromCString(SqliteColumnText(statement, 0), 65536))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(statement, 1))
    storage_json_builder_append_text(json, "}")
    return json.ok
}

storage_append_sync_op_payload :: (json: *StorageJsonBuilder, entity_type: string, entity_id: string, local_date: s32) {
    found: s32 = 0
    if entity_type == "cell_record" {
        found = storage_append_cell_payload_json(json, entity_id)
    } else if entity_type == "app_preference" {
        found = storage_append_app_preference_payload_json(json, entity_id)
    } else if storage_compare_text(entity_type, "habit") == 0 {

        found = storage_append_habit_payload_json(json, entity_id)
    } else if storage_compare_text(entity_type, "habit_day") == 0 {
        found = storage_append_habit_day_payload_json(json, entity_id, local_date)
    } else if storage_compare_text(entity_type, "session") == 0 {
        found = storage_append_session_payload_json(json, entity_id)
    } else if storage_compare_text(entity_type, "elist_list") == 0 {
        found = storage_append_elist_list_payload_json(json, entity_id)
    } else if storage_compare_text(entity_type, "elist_item") == 0 {
        found = storage_append_elist_item_payload_json(json, entity_id)
    }
    if found == 0 {
        storage_json_builder_append_text(json, "{}")
    }
}

storage_encrypted_collection_for_entity :: (entity_type: string, entity_id: string) -> string {
    if entity_type == "cell_record" {
        if LumiCellRecordValid(entity_id) {
            return LumiPrivateCollection
        }
        if !CellRecordValid(entity_id) {
            return ""
        }
        return LegacyPrivateCellsCollection
    }
    if entity_type == "app_preference" {
        return "private.inbe.v1.app-preferences"
    }
    if entity_type.count == 0 {
        return ""
    }
    if storage_compare_text(entity_type, "habit") == 0 {
        return "private.inbe.v1.habits"
    }
    if storage_compare_text(entity_type, "habit_day") == 0 {
        return "private.inbe.v1.habit-days"
    }
    if storage_compare_text(entity_type, "session") == 0 {
        return "private.inbe.v1.sessions"
    }
    if storage_compare_text(entity_type, "elist_list") == 0 {
        return "private.inbe.v1.elist-lists"
    }
    if storage_compare_text(entity_type, "elist_item") == 0 {
        return "private.inbe.v1.elist-items"
    }
    return ""
}

storage_encrypted_record_id :: (entity_type: string, entity_id: string, local_date: s32, out: *u8, out_size: s64) -> s32 {
    written: s32
    if out_size == 0 || entity_type.count == 0  || entity_id.count == 0 {
        return 0
    }
    out[0] = cast(u8)0
    written = 0
    if storage_compare_text(entity_type, "habit_day") == 0 {
        AppCopyText(entity_id, BytesFromPointer(out, cast(u64)out_size))
        date_text: [16] u8
        AppFormatS32(local_date, date_text[:])
        AppAppendText(":", BytesFromPointer(out, cast(u64)out_size))
        AppAppendText(AppTextFromCString(*date_text[0], 16),
            BytesFromPointer(out, cast(u64)out_size))
    } else {
        AppCopyText(entity_id, BytesFromPointer(out, cast(u64)out_size))
    }
    written = 0
    while written < 512 && out[written] != cast(u8)0 {
        written += 1
    }
    if written > 0 && cast(s64)written < out_size {
        return 1
    }
    return 0
}

storage_private_record_key_for_context :: (context: string, out: *u8) -> s32 {
    if out == null {
        return 0
    }
    SyncCryptoWipe(out, 32)
    if storage_delegate_mode != null && storage_delegate_mode() == 2 {
        return 0
    }
    private_key_hex: string = storage_get_setting_text(STORAGE_SYNC_PRIVATE_KEY_KEY)
    // The whole account private key (an ML-DSA-44 secret key) feeds the HMAC.
    private_key: [(SYNC_PRIVATE_KEY_HEX_SIZE - 1) / 2] u8
    key_size: s64 = (SYNC_PRIVATE_KEY_HEX_SIZE - 1) / 2
    ok: s32
    if private_key_hex.count == 0 {
        return 0
    }
    ok = SyncCryptoHexToBytes(private_key_hex, *private_key[0], key_size)
    if ok != 0 {
        SyncCryptoHmacSha256Text(*private_key[0], key_size, context, out)
    }
    SyncCryptoWipe(*private_key[0], key_size)
    return ok
}

storage_private_record_key :: (out: *u8) -> s32 {
    return storage_private_record_key_for_context(STORAGE_SYNC_RECORD_KEY_CONTEXT,
        out)
}

// The collection and generation must agree. In particular, no legacy key can
// decrypt Lumi v2, and the Lumi key cannot decrypt Diary, feedback or sessions.
#program_export
storage_private_collection_key :: (collection: string, key_id: string, out: *u8) -> s32 {
    if out == null {
        return 0
    }
    SyncCryptoWipe(out, 32)
    if storage_delegate_mode != null && storage_delegate_mode() == 2 {
        if collection != LumiPrivateCollection || key_id != LumiPrivateKeyID ||
        storage_delegate_key == null {
            return 0
        }
        result := storage_delegate_key(collection, key_id, out)
        if result == 0 {
            SyncCryptoWipe(out, 32)
        }
        return result
    }
    if collection == LumiPrivateCollection {
        if key_id != LumiPrivateKeyID {
            return 0
        }
        return storage_private_record_key_for_context(LumiPrivateKeyContext, out)
    }
    if key_id != STORAGE_SYNC_RECORD_KEY_ID ||
    storage_decrypted_array_name(collection).count == 0 {
        return 0
    }
    return storage_private_record_key(out)
}

storage_encrypted_collection_key_id :: (collection: string) -> string {
    if collection == LumiPrivateCollection {
        return LumiPrivateKeyID
    }
    return STORAGE_SYNC_RECORD_KEY_ID
}

storage_encrypted_record_cleanup :: (plain: *StorageJsonBuilder, aad: *StorageJsonBuilder,
    sealed: *u8, sealed_hex: *u8, ok: s32) -> s32 {
    storage_json_builder_free(plain)
    storage_json_builder_free(aad)
    free(cast(*void)sealed)
    free(cast(*void)sealed_hex)
    return ok
}

storage_append_encrypted_record_json :: (json: *StorageJsonBuilder, key: *u8, collection: string, key_id: string, record_id: string, entity_type: string, entity_id: string, local_date: s32, queued_at: s64, deleted: s32) -> s32 {
    plain: StorageJsonBuilder
    aad: StorageJsonBuilder
    nonce: [12] u8
    sealed: *u8 = null
    sealed_hex: *u8 = null
    nonce_hex: [25] u8
    content_hash: [SYNC_PUBLIC_ID_HEX_SIZE] u8
    sealed_len: s64
    ok: s32 = 0
    if collection.count == 0 || key_id.count == 0 || record_id.count == 0 {
        return 0
    }
    plain.ok = 1
    storage_append_sync_op_payload(*plain, entity_type, entity_id, local_date)
    if plain.ok == 0 || plain.data == null {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    storage_sha256_hex(plain.data, plain.len, *content_hash[0])
    sealed_len = plain.len + 16
    sealed = cast(*u8)malloc(cast(usize)sealed_len)
    sealed_hex = cast(*u8)malloc(cast(usize)(sealed_len * 2 + 1))
    if sealed == null || sealed_hex == null {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    aad.ok = 1
    storage_json_builder_append_text(*aad, collection)
    storage_json_builder_append_text(*aad, "\n")
    storage_json_builder_append_text(*aad, record_id)
    storage_json_builder_append_text(*aad, "\n")
    storage_json_builder_append_text(*aad, key_id)
    if aad.ok == 0 || aad.data == null {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    if SyncCryptoRandom(*nonce[0], 12) == 0 {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    if SyncCryptoChaCha20Poly1305Seal(key, *nonce[0], plain.data,
        plain.len, aad.data,
        aad.len, sealed, sealed_len) == 0 {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    if SyncCryptoBytesToHex(*nonce[0], 12, *nonce_hex[0], 25) == 0  || SyncCryptoBytesToHex(sealed, sealed_len, sealed_hex, sealed_len * 2 + 1) == 0 {
        return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
    }
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "collection", collection)
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "id", record_id)
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "key_id", key_id)
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "nonce", AppTextFromCString(*nonce_hex[0], 25))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "ciphertext", AppTextFromCString(sealed_hex, cast(s32)(sealed_len * 2 + 1)))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, queued_at)
    if deleted != 0 {
        storage_json_append_int_field(json, "deleted_at",
            ifx (queued_at > 0) then (queued_at) else (now_seconds()))
    }
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "content_hash", AppTextFromCString(*content_hash[0], SYNC_PUBLIC_ID_HEX_SIZE))
    storage_json_builder_append_text(json, ",\"schema_version\":1")
    storage_json_builder_append_text(json, "}")
    ok = json.ok
    return storage_encrypted_record_cleanup(*plain, *aad, sealed, sealed_hex, ok)
}

storage_append_encrypted_records_json :: (json: *StorageJsonBuilder, through_seq: s64) {
    stmt: *void = null
    key: [32] u8
    first: s32 = 1
    step_result: s32 = SQLITE_DONE
    storage_json_builder_append_text(json, "\"encrypted_records\":[")
    if storage_db_handle() == null {
        json.ok = 0
    } else {
        sql_cx13: [98] u8
        AppCopyText("SELECT seq,entity_type,entity_id,local_date,queued_at FROM sync_outbox WHERE seq<=?1 ORDER BY seq", sql_cx13[:])
        if SqlitePrepare(storage_db_handle(), *sql_cx13[0], -1, *stmt, null) == SQLITE_OK {
            SqliteBindInt64(stmt, 1, through_seq)
            while true {
                step_result = SqliteStep(stmt)
                if step_result != SQLITE_ROW {
                    break
                }
                entity_type: string = AppTextFromCString(SqliteColumnText(stmt, 1), 8192)
                entity_id: string = AppTextFromCString(SqliteColumnText(stmt, 2), 8192)
                local_date: s32 = sqlite3_column_int(stmt, 3)
                queued_at: s64 = SqliteColumnInt64(stmt, 4)
                collection: string = storage_encrypted_collection_for_entity(entity_type, entity_id)
                key_id: string = storage_encrypted_collection_key_id(collection)
                is_delete: s32 = storage_sync_op_is_delete(entity_type, entity_id, local_date)
                record_id: [180] u8
                if collection.count == 0  || storage_encrypted_record_id(entity_type, entity_id, local_date,
                    *record_id[0], size_of(type_of(record_id))) == 0 {
                    json.ok = 0
                    break
                }
                if first == 0 {
                    storage_json_builder_append_text(json, ",")
                }
                first = 0
                if storage_private_collection_key(collection, key_id, *key[0]) == 0 {
                    json.ok = 0
                    break
                }
                if storage_append_encrypted_record_json(json, *key[0], collection, key_id, AppTextFromCString(*record_id[0], 180),
                    entity_type, entity_id, local_date,
                    queued_at, is_delete) == 0 {
                    SyncCryptoWipe(*key[0], 32)
                    json.ok = 0
                    break
                }
                SyncCryptoWipe(*key[0], 32)
            }
            if step_result != SQLITE_DONE {
                json.ok = 0
            }
        } else {
            json.ok = 0
        }
        if stmt != null {
            SqliteFinalize(stmt)
        }
        SyncCryptoWipe(*key[0], 32)
        storage_json_builder_append_text(json, "]")
    }
}

#program_export
storage_build_sync_payload_json :: (user_id_hash: string, public_key_hex: string) -> *u8 {
    json: StorageJsonBuilder
    since_server_version: s64
    through_seq: s64
    full_upload_done: s32
    force_zero_day_repair: s32
    shadow_key: [32] u8
    can_shadow_encrypt: s32
    if storage_db_handle() == null || user_id_hash.count == 0 {
        return null
    }
    if migrate_schema() == 0 || storage_migrate_lumi_collection() == 0 {
        return null
    }
    if storage_materialize_session_habit_days() == 0 {
        return null
    }
    if storage_meta_int64(STORAGE_SYNC_BACKFILL_KEY, 0) == 0 {
        storage_enqueue_all_sync_state()
    }
    can_shadow_encrypt = storage_private_record_key(*shadow_key[0])
    SyncCryptoWipe(*shadow_key[0], 32)
    if can_shadow_encrypt == 0 {
        return null
    }
    since_server_version = storage_meta_int64("sync_last_server_version", 0)
    full_upload_done = 0
    if storage_meta_int64("sync_full_upload_done", 0) != 0 {
        full_upload_done = 1
    }
    if storage_meta_int64(STORAGE_SYNC_HABIT_NAME_REPAIR_KEY, 0) == 0 || storage_has_orphan_habit_days() != 0 {
        since_server_version = 0
    }
    force_zero_day_repair = 0
    if storage_meta_int64(STORAGE_SYNC_ZERO_HABIT_DAY_REPAIR_KEY, 0) == 0 {
        force_zero_day_repair = 1
    }
    if force_zero_day_repair != 0 {
        since_server_version = 0
    }
    // Chunked diary photos must stay within the public node's 1 MiB request.
    batch_limit: s32 = cast(s32)STORAGE_SYNC_OP_BATCH_LIMIT
    if db_select_int64_text("SELECT EXISTS(SELECT 1 FROM sync_outbox WHERE entity_type='cell_record')", 0) != 0 {
        batch_limit = 64
    }
    through_seq = storage_sync_outbox_batch_seq(batch_limit)
    storage_state_handle().pending_sync_outbox_seq = through_seq
    json.ok = 1
    protocol_text: [32] u8
    storage_json_builder_append_text(*json, "{")
    AppFormatS32(SYNC_PROTOCOL_VERSION, protocol_text[:])
    storage_json_builder_append_text(*json, "\"protocol_version\":")
    storage_json_builder_append_text(*json, AppTextFromCString(*protocol_text[0], 32))
    storage_json_builder_append_text(*json, ",")
    storage_json_builder_append_text(*json, "\"app_id\":\"inbe\",")
    storage_json_builder_append_text(*json, "\"client_capabilities\":[\"v6-device-transactions\",\"encrypted-primary\"],")
    storage_json_builder_key_value_text(*json, "user_id_hash", user_id_hash)
    storage_json_builder_append_text(*json, ",")
    storage_json_builder_key_value_text(*json, "client_id", storage_sync_client_id())
    server_version_text: [24] u8
    AppFormatS32(cast(s32)since_server_version, server_version_text[:])
    storage_json_builder_append_text(*json, ",\"since_server_version\":")
    storage_json_builder_append_text(*json, AppTextFromCString(*server_version_text[0], 24))
    client_clock_text: [24] u8
    AppFormatS32(cast(s32)storage_meta_int64(STORAGE_SYNC_SERVER_CLOCK_KEY, 0), client_clock_text[:])
    storage_json_builder_append_text(*json, ",\"client_clock\":")
    storage_json_builder_append_text(*json, AppTextFromCString(*client_clock_text[0], 24))
    if storage_meta_int64(STORAGE_SYNC_FULL_REPLACE_KEY, 0) != 0 {
        storage_json_builder_append_text(*json, ",\"full_sync_requested\":true")
    }
    {
        last_server_hash: string = storage_meta_text(STORAGE_SYNC_LAST_SERVER_HASH_KEY)
        if force_zero_day_repair == 0 && last_server_hash.count > 0 {
            storage_json_builder_append_text(*json, ",")
            storage_json_builder_key_value_text(*json, "last_server_state_hash", last_server_hash)
        }
    }
    if since_server_version <= 0 || full_upload_done == 0 {
        storage_json_builder_append_text(*json, ",\"bootstrap\":true")
    }
    if public_key_hex.count > 0 {
        storage_json_builder_append_text(*json, ",")
        storage_json_builder_key_value_text(*json, "public_key", public_key_hex)
    }
    storage_json_builder_append_text(*json, ",")
    storage_append_encrypted_records_json(*json, through_seq)
    storage_json_builder_append_text(*json, "}")
    if json.ok == 0 || json.data == null {
        free(cast(*void)json.data)
        return null
    }
    LogStorage(LOG_INFO, "SYNC: payload built")
    return json.data
}

#program_export
storage_free_sync_payload_json :: (payload: *u8) {
    free(cast(*void)payload)
}

storage_json_valid :: (json: string) -> s32 {
    stmt: *void = null
    valid: s32 = 0
    if storage_db_handle() == null || json.count == 0 {
        return 0
    }
    sql_cx20: [64] u8
    AppCopyText("SELECT json_valid(?1)", sql_cx20[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx20[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, json)
    if SqliteStep(stmt) == SQLITE_ROW {
        valid = 0
        if sqlite3_column_int(stmt, 0) != 0 {
            valid = 1
        }
    }
    SqliteFinalize(stmt)
    return valid
}

storage_json_extract_int64 :: (json: string, path: string, fallback: s64) -> s64 {
    stmt: *void = null
    value: s64 = fallback
    if storage_db_handle() == null || json.count == 0 || path.count == 0 {
        return fallback
    }
    sql_cx21: [96] u8
    AppCopyText("SELECT CAST(COALESCE(json_extract(?1,?2),?3) AS INTEGER)", sql_cx21[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx21[0], -1, *stmt, null) != SQLITE_OK {
        return fallback
    }
    bind_text(stmt, 1, json)
    bind_text(stmt, 2, path)
    SqliteBindInt64(stmt, 3, fallback)
    if SqliteStep(stmt) == SQLITE_ROW {
        value = SqliteColumnInt64(stmt, 0)
    }
    SqliteFinalize(stmt)
    return value
}

storage_json_extract_text :: (json: string, path: string, out: *u8, out_size: s64) -> s32 {
    stmt: *void = null
    text: *u8
    ok: s32 = 0
    if out == null || out_size == 0 {
        return 0
    }
    out[0] = cast(u8)0
    if storage_db_handle() == null || json.count == 0 || path.count == 0 {
        return 0
    }
    sql_cw2: [64] u8
    AppCopyText("SELECT COALESCE(json_extract(?1,?2),'')", sql_cw2[:])
    if SqlitePrepare(storage_db_handle(), *sql_cw2[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, json)
    bind_text(stmt, 2, path)
    if SqliteStep(stmt) == SQLITE_ROW {
        text = SqliteColumnText(stmt, 0)
        if text != null {
            AppCopyText(AppTextFromCString(text, 8192),
                BytesFromPointer(out, cast(u64)out_size))
            ok = 0
            if out[0] != cast(u8)0 {
                ok = 1
            }
        }
    }
    SqliteFinalize(stmt)
    return ok
}

storage_max_sync_outbox_seq :: () -> s64 {
    return db_select_int64_text("SELECT COALESCE(MAX(seq),0) FROM sync_outbox", 0)
}

storage_sync_outbox_batch_seq :: (limit: s32) -> s64 {
    stmt: *void = null
    seq: s64 = 0
    if storage_db_handle() == null {
        return 0
    }
    if limit <= 0 {
        return storage_max_sync_outbox_seq()
    }
    sql_cx14: [64] u8
    AppCopyText("SELECT seq FROM sync_outbox ORDER BY seq LIMIT 1 OFFSET ?1", sql_cx14[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx14[0], -1, *stmt, null) == SQLITE_OK {
        sqlite3_bind_int(stmt, 1, limit - 1)
        if SqliteStep(stmt) == SQLITE_ROW {
            seq = SqliteColumnInt64(stmt, 0)
        }
    }
    if stmt != null {
        SqliteFinalize(stmt)
    }
    if seq > 0 {
        return seq
    }
    return storage_max_sync_outbox_seq()
}

storage_has_pending_sync_outbox :: () -> s32 {
    if db_select_int64_text("SELECT EXISTS(SELECT 1 FROM sync_outbox LIMIT 1)", 0) != 0 {
        return 1
    }
    return 0
}

storage_has_orphan_habit_days :: () -> s32 {
    if db_select_int64_text(
        "SELECT EXISTS(SELECT 1 FROM habit_days hd WHERE hd.habit_id<>'' AND NOT EXISTS (SELECT 1 FROM habits h WHERE h.id=hd.habit_id) LIMIT 1)",
        0) != 0 {
        return 1
    }
    return 0
}

#program_export
storage_has_sync_account :: () -> s32 {
    if storage_delegate_mode != null && storage_delegate_mode() == 2 {
        if storage_delegate_available == null {
            return 0
        }
        return storage_delegate_available()
    }
    public_id: string = storage_get_setting_text(STORAGE_SYNC_PUBLIC_ID_KEY)
    public_key: string = storage_get_setting_text(STORAGE_SYNC_PUBLIC_KEY_KEY)
    private_key: string = storage_get_setting_text(STORAGE_SYNC_PRIVATE_KEY_KEY)
    if public_id.count > 0 && public_key.count > 0  && private_key.count > 0 {
        return 1
    }
    return 0
}

storage_clear_uploaded_outbox :: (through_seq: s64) {
    stmt: *void = null
    if storage_db_handle() == null || through_seq <= 0 {
        return
    }
    sql_cx21: [64] u8
    AppCopyText("DELETE FROM sync_outbox WHERE seq<=?1", sql_cx21[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx21[0], -1, *stmt, null) !=
    SQLITE_OK {
        return
    }
    SqliteBindInt64(stmt, 1, through_seq)
    SqliteStep(stmt)
    SqliteFinalize(stmt)
}

storage_json_array_has_items :: (json: string, path: string) -> s32 {
    if storage_json_array_count(json, path) > 0 {
        return 1
    }
    return 0
}

storage_json_array_count :: (json: string, path: string) -> s32 {
    stmt: *void = null
    count: s32 = 0
    if storage_db_handle() == null || json.count == 0 || path.count == 0 {
        return 0
    }
    sql_cx22: [96] u8
    AppCopyText("SELECT COALESCE(json_array_length(json_extract(?1,?2)),0)", sql_cx22[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx22[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, json)
    bind_text(stmt, 2, path)
    if SqliteStep(stmt) == SQLITE_ROW {
        count = sqlite3_column_int(stmt, 0)
    }
    SqliteFinalize(stmt)
    return count
}

#program_export
storage_json_array_count_path :: (json: string, path: string) -> s32 {
    return storage_json_array_count(json, path)
}

#program_export
storage_json_array_object_text :: (json: string, array_path: string, index: s32, key: string, out: *u8, out_size: s64) -> s32 {
    path: [128] u8
    if out == null || out_size == 0 {
        return 0
    }
    out[0] = cast(u8)0
    if array_path.count == 0 || key.count == 0 || index < 0 {
        return 0
    }
    index_text: [16] u8
    AppFormatS32(index, index_text[:])
    AppCopyText(array_path, path[:])
    AppAppendText("[", path[:])
    AppAppendText(AppTextFromCString(*index_text[0], 16), path[:])
    AppAppendText("].", path[:])
    AppAppendText(key, path[:])
    return storage_json_extract_text(json, AppTextFromCString(*path[0], 128), out, out_size)
}

#program_export
storage_json_array_object_number :: (json: string, array_path: string, index: s32, key: string) -> float64 {
    path: [128] u8
    stmt: *void = null
    value: float64 = 0.0
    if storage_db_handle() == null || json.count == 0 || array_path.count == 0  || key.count == 0 || index < 0 {
        return 0.0
    }
    index_text: [16] u8
    AppFormatS32(index, index_text[:])
    AppCopyText(array_path, path[:])
    AppAppendText("[", path[:])
    AppAppendText(AppTextFromCString(*index_text[0], 16), path[:])
    AppAppendText("].", path[:])
    AppAppendText(key, path[:])
    sql_cx9: [64] u8
    AppCopyText("SELECT CAST(COALESCE(json_extract(?1,?2),0) AS REAL)", sql_cx9[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx9[0], -1, *stmt, null) != SQLITE_OK {
        return 0.0
    }
    bind_text(stmt, 1, json)
    bind_text(stmt, 2, AppTextFromCString(*path[0], 128))
    if SqliteStep(stmt) == SQLITE_ROW {
        value = sqlite3_column_double(stmt, 0)
    }
    SqliteFinalize(stmt)
    return value
}

storage_sync_response_has_changes :: (json: string) -> s32 {
    if storage_json_array_has_items(json, "$.changes.encrypted_records") != 0 {
        return 1
    }
    if storage_json_array_has_items(json, "$.data.encrypted_records") != 0 {
        return 1
    }
    if storage_json_array_has_items(json, "$.data.social") != 0 {
        return 1
    }
    if storage_json_array_has_items(json, "$.changes.social_cache") != 0 {
        return 1
    }
    return 0
}

#program_export
storage_exec_json_user_sql :: (sql: string, json: string) -> s32 {
    stmt: *void = null
    rc: s32
    attempt: s32
    if storage_db_handle() == null || sql.count == 0 || json.count == 0 {
        return 0
    }
    {
        attempt: s32 = 0
        while attempt < 2 {
            if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) == SQLITE_OK {
                break
            }
            if attempt == 0 && migrate_schema() != 0 {
                attempt += 1; continue
            }
            LogStorage(LOG_WARNING, "SYNC: changes SQL prepare failed")
            return 0
            attempt += 1
        }
    }
    bind_text(stmt, 1, json)
    if sqlite3_bind_parameter_count(stmt) >= 2 {
        bind_text(stmt, 2, AppTextFromCString(storage_user_id_buffer(), 64))
    }
    rc = SqliteStep(stmt)
    if rc != SQLITE_DONE {
        LogStorage(LOG_WARNING, "SYNC: changes SQL step failed")
        SqliteFinalize(stmt)
        return 0
    }
    SqliteFinalize(stmt)
    return 1
}


storage_apply_sync_sessions_json :: (response_json: string) -> s32 {
    return storage_exec_json_user_sql(SyncSessionsSQL, response_json)
}



storage_apply_sync_session_rounds_json :: (response_json: string) -> s32 {
    return ifx (storage_exec_json_user_sql(SyncSessionRoundDeleteSQL, response_json) != 0 &&
        storage_exec_json_user_sql(SyncSessionRoundsSQL, response_json) != 0) then (1) else (0)
}


storage_apply_sync_meditation_logs_json :: (response_json: string) -> s32 {
    return storage_exec_json_user_sql(SyncMeditationLogsSQL, response_json)
}



storage_apply_sync_social_json :: (response_json: string) -> s32 {
    return ifx (storage_exec_json_user_sql(SyncSocialSQL, response_json) != 0 &&
        storage_exec_json_user_sql(SyncSocialCacheSQL, response_json) != 0) then (1) else (0)
}

storage_decrypted_array_name :: (collection: string) -> string {
    if collection == LegacyPrivateCellsCollection || collection == LumiPrivateCollection {
        return "cell_records"
    }
    if collection == "private.inbe.v1.app-preferences" {
        return "app_preferences"
    }
    if storage_compare_text(collection, "private.inbe.v1.habits") == 0 {
        return "habits"
    }
    if storage_compare_text(collection, "private.inbe.v1.habit-days") == 0 {
        return "habit_days"
    }
    if storage_compare_text(collection, "private.inbe.v1.sessions") == 0 {
        return "sessions"
    }
    if storage_compare_text(collection, "private.inbe.v1.elist-lists") == 0 {
        return "elist_lists"
    }
    if storage_compare_text(collection, "private.inbe.v1.elist-items") == 0 {
        return "elist_items"
    }
    return ""
}

// Cell plaintext has one object with one occurrence of each known string
// field. Decode member names when checking uniqueness, including escapes.
storage_cell_plaintext_fields_valid :: (plaintext: string) -> bool {
    cursor := Scan.Space(plaintext, 0)
    if cursor < 0 || cursor >= cast(s32)plaintext.count ||
    plaintext[cursor] != cast(u8)123 {
        return false
    }
    cursor = Scan.Space(plaintext, cursor + 1)
    seen: s32 = 0
    while cursor < cast(s32)plaintext.count {
        field_bytes: [32]u8
        field_count := Scan.ReadStringText(plaintext, cursor, field_bytes[:])
        field_span := Scan.ReadString(plaintext, cursor)
        if field_count <= 0 || !field_span.valid {
            return false
        }
        field := TextFromBytes(field_bytes[:field_count])
        flag: s32 = 0
        if field == "key" {
            flag = 1
        } else if field == "value" {
            flag = 2
        } else if field == "updated_at" {
            flag = 4
        } else {
            return false
        }
        if (seen & flag) != 0 {
            return false
        }
        seen = seen | flag
        cursor = Scan.Space(plaintext, field_span.after)
        if cursor >= cast(s32)plaintext.count || plaintext[cursor] != cast(u8)58 {
            return false
        }
        cursor = Scan.Space(plaintext, cursor + 1)
        if cursor >= cast(s32)plaintext.count || plaintext[cursor] != cast(u8)34 {
            return false
        }
        value_span := Scan.ReadString(plaintext, cursor)
        if !value_span.valid {
            return false
        }
        cursor = Scan.Space(plaintext, value_span.after)
        if cursor >= cast(s32)plaintext.count {
            return false
        }
        if plaintext[cursor] == cast(u8)125 {
            return seen == 7 && Scan.Space(plaintext, cursor + 1) == cast(s32)plaintext.count
        }
        if plaintext[cursor] != cast(u8)44 {
            return false
        }
        cursor = Scan.Space(plaintext, cursor + 1)
    }
    return false
}

storage_apply_decrypted_record :: (collection: string, record_id: string, plaintext: string) -> s32 {
    array_name: string = storage_decrypted_array_name(collection)
    response: StorageJsonBuilder = StorageJsonBuilder.{}
    record_response: string
    ok: s32
    if array_name.count == 0 || plaintext.count == 0 {
        return 0
    }
    response.ok = 1
    storage_json_builder_append_text(*response, "{\"changes\":{\"")
    storage_json_builder_append_text(*response, array_name)
    storage_json_builder_append_text(*response, "\":[")
    storage_json_builder_append_text(*response, plaintext)
    storage_json_builder_append_text(*response, "]}}")
    if response.ok == 0 || response.data == null {
        storage_json_builder_free(*response)
        return 0
    }
    record_response = AppTextFromCString(response.data, cast(s32)(response.len + 1))
    // `plaintext` is one record, or several separated by commas.
    if storage_json_valid(record_response) == 0 {
        storage_json_builder_free(*response)
        return 0
    }
    if array_name == "cell_records" {
        if record_id.count == 0 || !storage_cell_plaintext_fields_valid(plaintext) {
            storage_json_builder_free(*response)
            return 0
        }
        records := Scan.FieldAt(record_response, Scan.FieldAt(record_response, 0, "changes"), "cell_records")
        if Scan.ArrayCount(record_response, records) != 1 {
            storage_json_builder_free(*response)
            return 0
        }
        at := Scan.ElementAt(record_response, records, 0)
        key_bytes: [181]u8
        value_bytes: [65536]u8
        key_count := Scan.ReadStringText(record_response, Scan.FieldAt(record_response, at, "key"), key_bytes[:])
        value_count := Scan.ReadStringText(record_response, Scan.FieldAt(record_response, at, "value"), value_bytes[:])
        if key_count <= 0 || key_count >= 181 || value_count <= 0 || value_count >= 65536 ||
        TextFromBytes(key_bytes[:key_count]) != record_id ||
        !CellRecordValid(TextFromBytes(key_bytes[:key_count])) ||
        (collection == LumiPrivateCollection && !LumiCellRecordValid(TextFromBytes(key_bytes[:key_count]))) {
            storage_json_builder_free(*response)
            return 0
        }
        ok = storage_exec_json_user_sql(SyncCellRecordsSQL, record_response)
        if ok != 0 && sqlite3_changes(storage_db_handle()) > 0 && collection == LegacyPrivateCellsCollection &&
        LumiCellRecordValid(TextFromBytes(key_bytes[:key_count])) {
            // An older device may upload legacy Lumi after the local migration.
            // Queue a copy only when the legacy record changes local history;
            // replaying an unchanged snapshot must not keep uploads pending.
            ok = storage_enqueue_sync_entity("cell_record", TextFromBytes(key_bytes[:key_count]), 0)
        }
    } else if array_name == "app_preferences" {
        records := Scan.FieldAt(record_response, Scan.FieldAt(record_response, 0, "changes"), "app_preferences")
        count := Scan.ArrayCount(record_response, records)
        if count <= 0 || count > 4 {
            storage_json_builder_free(*response);
            return 0
        }
        valid := true
        for index: cast(s32)0..count - 1 {
            record := Scan.ElementAt(record_response, records, index)
            key: [64]u8
            value: [8]u8
            key_count := Scan.ReadStringText(record_response, Scan.FieldAt(record_response, record, "key"), key[:])
            value_count := Scan.ReadStringText(record_response, Scan.FieldAt(record_response, record, "value"), value[:])
            if key_count <= 0 || key_count >= 64 || value_count != 1 {
                valid = false;
                break
            }
            if !AppPreferenceValid(TextFromBytes(key[:key_count])) ||
            (value[0] != cast(u8)48 && value[0] != cast(u8)49) {
                valid = false
                break
            }
        }
        if !valid {
            storage_json_builder_free(*response);
            return 0
        }
        ok = storage_exec_json_user_sql(SyncAppPreferencesSQL, record_response)
        if ok != 0 {
            storage_set_setting_int("apps_setup_done", 1)
        }
    } else if storage_compare_text(array_name, "habits") == 0 {

        ok = ifx (storage_reconcile_remote_habit_ids(record_response) != 0  && storage_apply_sync_habits_json(record_response) != 0) then (1) else (0)
    } else if storage_compare_text(array_name, "habit_days") == 0 {
        ok = storage_apply_sync_habit_days_json(record_response)
    } else if storage_compare_text(array_name, "elist_lists") == 0 {
        ok = storage_apply_sync_elist_lists_json(record_response)
    } else if storage_compare_text(array_name, "elist_items") == 0 {
        ok = storage_apply_sync_elist_items_json(record_response)
    } else {
        ok = ifx (storage_apply_sync_session_rounds_json(record_response) != 0  && storage_apply_sync_sessions_json(record_response) != 0) then (1) else (0)
    }
    storage_json_builder_free(*response)
    return ok
}

storage_decrypted_record_cleanup :: (aad: *StorageJsonBuilder, sealed: *u8,
    plaintext: *u8, key: *u8) {
    storage_json_builder_free(aad)
    free(cast(*void)sealed)
    free(cast(*void)plaintext)
    SyncCryptoWipe(key, 32)
}

storage_decrypt_record :: (collection: string, record_id: string, key_id: string, nonce_hex: string, ciphertext_hex: string, content_hash: string, plaintext_out: **u8) -> s32 {
    aad: StorageJsonBuilder = StorageJsonBuilder.{}
    key: [32] u8
    nonce: [12] u8
    sealed: *u8 = null
    plaintext: *u8 = null
    actual_hash: [SYNC_PUBLIC_ID_HEX_SIZE] u8
    sealed_len: s64
    plaintext_out.* = null
    if ciphertext_hex.count < 32 || ciphertext_hex.count % 2 != 0  || SyncCryptoHexToBytes(nonce_hex, *nonce[0], size_of(type_of(nonce))) == 0  || storage_private_collection_key(collection, key_id, *key[0]) == 0 {
        return 0
    }
    sealed_len = cast(s64)ciphertext_hex.count / 2
    sealed = cast(*u8)malloc(cast(usize)sealed_len)
    plaintext = cast(*u8)malloc(cast(usize)(sealed_len - 16 + 1))
    if sealed == null || plaintext == null {
        storage_decrypted_record_cleanup(*aad, sealed, plaintext, *key[0])
        return 0
    }
    if SyncCryptoHexToBytes(ciphertext_hex, sealed, sealed_len) == 0 {
        storage_decrypted_record_cleanup(*aad, sealed, plaintext, *key[0])
        return 0
    }
    aad.ok = 1
    storage_json_builder_append_text(*aad, collection)
    storage_json_builder_append_text(*aad, "\n")
    storage_json_builder_append_text(*aad, record_id)
    storage_json_builder_append_text(*aad, "\n")
    storage_json_builder_append_text(*aad, key_id)
    if aad.ok == 0 || aad.data == null {
        storage_decrypted_record_cleanup(*aad, sealed, plaintext, *key[0])
        return 0
    }
    if SyncCryptoChaCha20Poly1305Open(*key[0], *nonce[0], sealed, sealed_len,
        cast(*u8)aad.data, aad.len,
        plaintext, sealed_len - 16) == 0 {
        storage_decrypted_record_cleanup(*aad, sealed, plaintext, *key[0])
        return 0
    }
    plaintext[sealed_len - 16] = cast(u8)0
    if content_hash.count > 0 && content_hash[0] != #char "\0" {
        storage_sha256_hex(plaintext, sealed_len - 16, *actual_hash[0])
        if storage_compare_text(AppTextFromCString(*actual_hash[0], SYNC_PUBLIC_ID_HEX_SIZE), content_hash) != 0 {
            storage_decrypted_record_cleanup(*aad, sealed, plaintext, *key[0])
            return 0
        }
    }
    plaintext_out.* = plaintext
    plaintext = null
    storage_decrypted_record_cleanup(*aad, sealed, null, *key[0])
    return 1
}

storage_apply_encrypted_records_query: string = "SELECT json_extract(value,'$.collection'),json_extract(value,'$.id'),json_extract(value,'$.key_id'),json_extract(value,'$.nonce'),json_extract(value,'$.ciphertext'),COALESCE(json_extract(value,'$.content_hash'),'')FROM json_each(?1,?2)";

storage_apply_encrypted_records :: (response_json: string) -> s32 {
    habit_batch_storage: StorageJsonBuilder = StorageJsonBuilder.{}
    habit_batch: *StorageJsonBuilder = *habit_batch_storage
    habit_batch_count: s32 = 0
    habit_batch_collection: string = ""
    habit_batch_storage.ok = 1
    statement: *void = null
    ok: s32 = 1
    array_path: string = "$.data.encrypted_records"
    count: s32 = storage_json_array_count(response_json, array_path)
    fields: **u8 = null
    loaded: s32 = 0
    if count <= 0 {
        array_path = "$.changes.encrypted_records"
        count = storage_json_array_count(response_json, array_path)
    }
    if count <= 0 {
        return 1
    }
    fields = cast(**u8)calloc(cast(usize)count * 6,
        cast(usize)size_of(type_of(<<fields)))
    if fields == null {
        return 0
    }
    if SqlitePrepareText(storage_db_handle(), storage_apply_encrypted_records_query, -1, *statement, null) != SQLITE_OK {
        free(cast(*void)fields)
        return 0
    }
    bind_text(statement, 1, response_json)
    bind_text(statement, 2, array_path)
    while loaded < count && SqliteStep(statement) == SQLITE_ROW {
        {
            column: s32 = 0
            while column < 6 {
                value: *u8 = SqliteColumnText(statement, column)
                if value == null {
                    fields[loaded * 6 + column] = cast(*u8)calloc(1, 1)
                } else {
                    fields[loaded * 6 + column] = storage_duplicate_cstring(value)
                }
                if fields[loaded * 6 + column] == null {
                    ok = 0
                    break
                }
                column += 1
            }
        }
        if ok == 0 {
            break
        }
        loaded += 1
    }
    SqliteFinalize(statement)
    if loaded != count {
        ok = 0
    }
    {
        index: s32 = 0
        while ok != 0 && index < loaded {
            collection: string = AppTextFromCString(fields[index * 6], 2147483647)
            record_id: string = AppTextFromCString(fields[index * 6 + 1], 2147483647)
            key_id: string = AppTextFromCString(fields[index * 6 + 2], 2147483647)
            nonce: string = AppTextFromCString(fields[index * 6 + 3], 2147483647)
            ciphertext: string = AppTextFromCString(fields[index * 6 + 4], 2147483647)
            content_hash: string = AppTextFromCString(fields[index * 6 + 5], 2147483647)
            plaintext: *u8 = null
            if collection.count == 0 || storage_decrypted_array_name(collection).count == 0 {
                index += 1; continue
            }
            ok = ifx (record_id.count > 0 && key_id.count > 0 && nonce.count > 0  && ciphertext.count > 0  && storage_decrypt_record(collection, record_id, key_id, nonce,
                ciphertext, content_hash, *plaintext) != 0) then (1) else (0)
            if ok == 0 {
                LogStorageText(LOG_WARNING, "SYNC: encrypted record decrypt failed: ",
                    collection)
            } else if storage_compare_text(storage_decrypted_array_name(collection), "habits") == 0 {
                // Habits are applied together, once every record has arrived, so
                // habits that share a name are merged rather than replacing
                // each other before their days are in.
                if habit_batch_count > 0 {
                    storage_json_builder_append_text(habit_batch, ",")
                }
                storage_json_builder_append_text(habit_batch,
                    AppTextFromCString(plaintext, 2147483647))
                habit_batch_count += 1
                habit_batch_collection = collection
            } else {
                ok = storage_apply_decrypted_record(collection, record_id,
                    AppTextFromCString(plaintext, 2147483647))
                if ok == 0 {
                    LogStorageText(LOG_WARNING, "SYNC: encrypted record apply failed: ",
                        collection)
                }
            }
            free(cast(*void)plaintext)
            index += 1
        }
        if ok != 0 && habit_batch_count > 0 && habit_batch.ok != 0 && habit_batch.data != null {
            ok = storage_apply_decrypted_record(habit_batch_collection, "",
                AppTextFromCString(habit_batch.data, cast(s32)(habit_batch.len + 1)))
            if ok == 0 {
                LogStorage(LOG_WARNING, "SYNC: encrypted habit records apply failed")
            }
        }
        storage_json_builder_free(habit_batch)
    }
    {
        index: s32 = 0
        while index < count * 6 {
            free(cast(*void)fields[index])
            index += 1
        }
    }
    free(cast(*void)fields)
    return ok
}

// Shared by sync application and its rollback-only review preview.
storage_apply_sync_records :: (response_json: string) -> s32 {
    if storage_apply_encrypted_records(response_json) == 0 ||
    storage_merge_duplicate_habit_names() == 0 ||
    storage_apply_sync_social_json(response_json) == 0 ||
    storage_materialize_session_habit_days() == 0 {
        return 0
    }
    return 1
}

#program_export
storage_apply_sync_response_json :: (response_json: string) -> s32 {
    server_version: s64
    server_clock: s64
    old_server_version: s64
    protocol_version: s64
    server_hash: [80] u8
    account_alias: [40] u8
    if storage_db_handle() == null || response_json.count == 0 || response_json[0] == #char "\0" {
        return 0
    }
    if migrate_schema() == 0 {
        LogStorage(LOG_WARNING, "SYNC: response migration failed")
        return 0
    }
    storage_state_handle().last_sync_changed = 0
    if storage_json_valid(response_json) == 0 {
        LogStorage(LOG_WARNING, "SYNC: response JSON invalid")
        return 0
    }
    protocol_version = storage_json_extract_int64(response_json, "$.protocol_version", 0)
    if protocol_version != SYNC_PROTOCOL_VERSION {
        protocol_text: [24]u8
        if AppFormatS64(protocol_version, protocol_text[:]) {
            LogStorageText(LOG_WARNING, "SYNC: unsupported response protocol: ",
                AppTextFromCString(*protocol_text[0], 24))
        }
        return 0
    }
    if storage_json_extract_text(response_json, "$.account_alias", *account_alias[0],
        size_of(type_of(account_alias))) != 0 {
        storage_set_setting_text(STORAGE_SYNC_ACCOUNT_ALIAS_KEY, AppTextFromCString(*account_alias[0], 40))
    }
    // The newest server version this device has heard of, even when a full
    // snapshot waits for review and the applied version stays behind. Live
    // updates compare against it, so a waiting review is not news each time.
    seen_server_version := storage_json_extract_int64(response_json, "$.server_version", 0)
    if seen_server_version > storage_meta_int64(STORAGE_SYNC_SEEN_SERVER_VERSION_KEY, 0) {
        storage_set_meta_int64(STORAGE_SYNC_SEEN_SERVER_VERSION_KEY, seen_server_version)
    }
    if storage_json_extract_int64(response_json, "$.full_snapshot_required", 0) != 0  && storage_meta_int64(STORAGE_SYNC_APPLY_REVIEW_KEY, 0) == 0 {
        if storage_has_any() == 0 {
            return storage_apply_remote_full_snapshot(response_json)
        }
        if storage_has_pending_sync_outbox() != 0 {
            LogStorage(LOG_INFO, "SYNC: merging full snapshot with pending local edits")
        } else if storage_sync_review_json_should_auto_apply_remote(response_json) != 0 {
            return storage_apply_remote_full_snapshot(response_json)
        } else if storage_sync_review_json_has_visible_diff(response_json) == 0 {
            // The same merge preview shown to the user has no changes. Apply
            // its bookkeeping without replacing or removing local records.
            LogStorage(LOG_INFO, "SYNC: full snapshot has no visible merge changes")
        } else {
            if storage_sync_review_write_json(response_json) == 0 {
                LogStorage(LOG_WARNING, "SYNC: response review save failed")
                return 0
            }
            {
                meta_key_buffer: [64] u8
                meta_val_buffer: [4] u8
                AppCopyText(STORAGE_SYNC_PENDING_REVIEW_KEY, meta_key_buffer[:])
                AppCopyText("1", meta_val_buffer[:])
                set_meta(*meta_key_buffer[0], *meta_val_buffer[0])
            }
            storage_state_handle().pending_sync_outbox_seq = 0
            storage_schedule_persist()
            LogStorage(LOG_WARNING, "SYNC: full snapshot review required")
            return 1
        }
    }
    old_server_version = storage_meta_int64("sync_last_server_version", 0)
    if exec_sql("SAVEPOINT sync_apply") == 0 {
        return 0
    }
    storage_clear_uploaded_outbox(storage_state_handle().pending_sync_outbox_seq)
    if storage_apply_sync_records(response_json) == 0 {
        exec_sql("ROLLBACK TO sync_apply")
        exec_sql("RELEASE sync_apply")
        return 0
    }
    if exec_sql("RELEASE sync_apply") == 0 {
        // An unreleased savepoint keeps the transaction, and the connection,
        // held by this worker thread after it returns.
        exec_sql("ROLLBACK TO sync_apply")
        exec_sql("RELEASE sync_apply")
        return 0
    }
    server_version = storage_json_extract_int64(response_json, "$.server_version", 0)
    server_clock = storage_json_extract_int64(response_json, "$.server_clock", 0)
    storage_log_number("SYNC: response server_version=", server_version)
    storage_log_number("SYNC: previous server_version=", old_server_version)
    storage_log_number("SYNC: encrypted records=", cast(s64)(
        storage_json_array_count(response_json, "$.changes.encrypted_records") +
        storage_json_array_count(response_json, "$.data.encrypted_records")))
    storage_log_number("SYNC: social records=", cast(s64)(
        storage_json_array_count(response_json, "$.changes.social_cache") +
        storage_json_array_count(response_json, "$.data.social")))
    if server_version > old_server_version && storage_sync_response_has_changes(response_json) != 0 {
        storage_state_handle().last_sync_changed = 1
    }
    if server_version > 0 {
        storage_set_meta_int64("sync_last_server_version", server_version)
    }
    if server_clock > 0 {
        storage_set_meta_int64(STORAGE_SYNC_SERVER_CLOCK_KEY, server_clock)
    }
    if storage_json_extract_text(response_json, "$.server_state_hash", *server_hash[0],
        size_of(type_of(server_hash))) != 0 {
        {
            meta_key_buffer: [64] u8
            AppCopyText(STORAGE_SYNC_LAST_SERVER_HASH_KEY, meta_key_buffer[:])
            set_meta(*meta_key_buffer[0], *server_hash[0])
        }
    }
    set_meta_buf(STORAGE_SYNC_PENDING_REVIEW_KEY, "")
    if storage_meta_int64(STORAGE_SYNC_APPLY_REVIEW_KEY, 0) == 0 {
        storage_sync_review_delete_json()
    }
    storage_set_meta_int64(STORAGE_SYNC_APPLY_REVIEW_KEY, 0)
    set_meta_int64_buf(STORAGE_SYNC_FULL_REPLACE_KEY, 0)
    storage_state_handle().pending_sync_outbox_seq = 0
    storage_set_meta_int64("sync_full_upload_done", 1)
    storage_set_meta_int64(STORAGE_SYNC_BACKFILL_KEY, 1)
    storage_set_meta_int64(STORAGE_SYNC_HABIT_NAME_REPAIR_KEY, 1)
    storage_set_meta_int64(STORAGE_SYNC_ZERO_HABIT_DAY_REPAIR_KEY, 1)
    storage_mark_habits_initialized()
    storage_schedule_persist()
    return 1
}

storage_apply_remote_full_snapshot :: (response_json: string) -> s32 {
    copy: *u8
    ok: s32
    previous_pending_seq: s64 = storage_state_handle().pending_sync_outbox_seq
    previous_last_sync_changed: s32 = storage_state_handle().last_sync_changed

    if response_json.count == 0 || response_json.count >= 2147483647 {
        return 0
    }
    copy = cast(*u8)malloc(cast(usize)response_json.count + 1)
    if copy == null {
        return 0
    }
    index: s32 = 0
    while index < cast(s32)response_json.count {
        copy[index] = response_json[index]
        index += 1
    }
    copy[index] = 0
    if exec_sql("SAVEPOINT sync_replace") == 0 {
        free(cast(*void)copy)
        return 0
    }
    if storage_clear_local_sync_data() == 0 {
        LogStorage(LOG_WARNING, "SYNC: full snapshot local clear failed")
        exec_sql("ROLLBACK TO sync_replace")
        exec_sql("RELEASE sync_replace")
        free(cast(*void)copy)
        return 0
    }
    storage_set_meta_int64(STORAGE_SYNC_APPLY_REVIEW_KEY, 1)
    ok = storage_apply_sync_response_json(
        AppTextFromCString(copy, cast(s32)response_json.count + 1))
    if ok == 0 {
        exec_sql("ROLLBACK TO sync_replace")
        exec_sql("RELEASE sync_replace")
        storage_state_handle().pending_sync_outbox_seq = previous_pending_seq
        storage_state_handle().last_sync_changed = previous_last_sync_changed
    } else if exec_sql("RELEASE sync_replace") == 0 {
        exec_sql("ROLLBACK TO sync_replace")
        exec_sql("RELEASE sync_replace")
        storage_state_handle().pending_sync_outbox_seq = previous_pending_seq
        storage_state_handle().last_sync_changed = previous_last_sync_changed
        ok = 0
    }
    if ok != 0 {
        storage_sync_review_delete_json()
    }
    free(cast(*void)copy)
    return ok
}

storage_clear_local_sync_data_sqls: [9] string = .[
"DELETE FROM elist_items",
"DELETE FROM elist_lists",
"DELETE FROM meditation_logs",
"DELETE FROM session_rounds",
"DELETE FROM sessions",
"DELETE FROM habit_days",
"DELETE FROM habits",
"DELETE FROM social_snapshots",
"DELETE FROM sync_outbox"
];

#program_export
storage_clear_local_sync_data :: () -> s32 {
    if storage_db_handle() == null {
        return 0
    }
    if exec_sql("SAVEPOINT sync_clear_local") == 0 {
        return 0
    }
    {
        i: s64 = 0
        while i < size_of(type_of(storage_clear_local_sync_data_sqls)) / size_of(type_of(storage_clear_local_sync_data_sqls[0])) {
            if exec_sql(storage_clear_local_sync_data_sqls[i]) == 0 {
                exec_sql("ROLLBACK TO sync_clear_local")
                exec_sql("RELEASE sync_clear_local")
                return 0
            }
            i += 1
        }
    }
    if exec_sql("RELEASE sync_clear_local") == 0 {
        exec_sql("ROLLBACK TO sync_clear_local")
        exec_sql("RELEASE sync_clear_local")
        return 0
    }
    return 1
}

#program_export
storage_last_sync_changed :: () -> s32 {
    return storage_state_handle().last_sync_changed
}

#program_export
storage_sync_status :: (status: *StorageSyncStatus) -> s32 {
    if status == null {
        return 0
    }
    status.* = StorageSyncStatus.{}
    if storage_db_handle() == null {
        return 0
    }
    status.has_account = storage_has_sync_account()
    status.enabled = storage_sync_enabled()
    status.review_pending = ifx (storage_meta_int64(STORAGE_SYNC_PENDING_REVIEW_KEY, 0) != 0) then (1) else (0)
    status.repair_pending = ifx (storage_meta_int64(STORAGE_SYNC_ZERO_HABIT_DAY_REPAIR_KEY, 0) == 0) then (1) else (0)
    status.full_upload_done = ifx (storage_meta_int64("sync_full_upload_done", 0) != 0) then (1) else (0)
    status.server_version = storage_meta_int64("sync_last_server_version", 0)
    status.server_clock = storage_meta_int64(STORAGE_SYNC_SERVER_CLOCK_KEY, 0)
    status.queued_changes = db_select_int64_text("SELECT COUNT(*) FROM sync_outbox", cast(s64)0)
    return 1
}

storage_purge_synced_deleted_data_sqls: [4] string = .[
"DELETE FROM session_rounds WHERE session_id IN (SELECT id FROM sessions WHERE deleted_at>0 AND id NOT IN  (SELECT entity_id FROM sync_outbox WHERE entity_type='session'))",
"DELETE FROM sessions WHERE deleted_at>0 AND id NOT IN (SELECT entity_id FROM sync_outbox WHERE entity_type='session')",
"DELETE FROM habit_days WHERE completed=0 AND count=0 AND session_count=0 AND NOT EXISTS (SELECT 1 FROM sync_outbox o WHERE o.entity_type='habit_day' AND o.entity_id=habit_days.habit_id AND o.local_date=habit_days.local_date)",
"DELETE FROM habits WHERE deleted_at>0 AND id NOT IN (SELECT entity_id FROM sync_outbox WHERE entity_type='habit')"
];

#program_export
storage_purge_synced_deleted_data :: () {
    if storage_db_handle() == null || storage_meta_int64("sync_full_upload_done", 0) == 0 {
        return
    }
    if exec_sql("BEGIN IMMEDIATE") == 0 {
        return
    }
    {
        i: s64 = 0
        failed := 0
        while i < size_of(type_of(storage_purge_synced_deleted_data_sqls)) / size_of(type_of(storage_purge_synced_deleted_data_sqls[0])) {
            if exec_sql(storage_purge_synced_deleted_data_sqls[i]) == 0 {
                failed = 1
                break
            }
            i += 1
        }
        if failed != 0 {
            exec_sql("ROLLBACK")
            return
        }
    }
    exec_sql("COMMIT")
    storage_schedule_persist()
}

// Civil day arithmetic: C time_t is 32-bit on 32-bit Android, so mktime and
// difftime cannot be declared with one integer type for every target.
storage_profile_day_number :: (local_date: s32) -> s64 {
    year := local_date / 10000
    month := (local_date / 100) % 100
    day := local_date % 100
    if !DateValid(year, month, day) {
        return -1
    }
    return DaysFromCivil(year, month, day)
}

storage_profile_day_offset :: (local_date: s32, today_date: s32) -> s32 {
    if local_date <= 0 || today_date <= 0 {
        return -1
    }
    day := storage_profile_day_number(local_date)
    today := storage_profile_day_number(today_date)
    if day < 0 || today < 0 {
        return -1
    }
    offset := today - day
    if offset < 0 || offset > 370 {
        return -1
    }
    return cast(s32)offset
}

storage_profile_date_from_epoch :: (epoch: s64) -> s32 {
    value: s64 = cast(s64)epoch
    tm_value: *Tm
    if epoch <= 0 {
        return 0
    }
    tm_value = gmtime(*value)
    if tm_value == null {
        return 0
    }
    return (tm_value.tm_year + 1900) * 10000 +     (tm_value.tm_mon + 1) * 100 + tm_value.tm_mday
}

#program_export
storage_profile_activity_stats :: (activity: s32, today_date: s32, streak_out: *s32, avg_hold_out: *s64) -> s32 {
    stmt: *void = null
    seen: [371] s32
    streak: s32 = 0
    avg_value: s64 = 0
    if streak_out != null {
        streak_out.* = 0
    }
    if avg_hold_out != null {
        avg_hold_out.* = 0
    }
    if storage_db_handle() == null || activity < 0 || activity >= 30 {
        return 0
    }
    sql_cx10: [108] u8
    AppCopyText("SELECT local_date FROM sessions WHERE user_id=?1 AND deleted_at=0 AND activity=?2   AND local_date>0", sql_cx10[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx10[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    sqlite3_bind_int(stmt, 2, activity)
    while SqliteStep(stmt) == SQLITE_ROW {
        offset: s32 = storage_profile_day_offset(sqlite3_column_int(stmt, 0), today_date)
        if offset >= 0 && offset <= 370 {
            seen[offset] = 1
        }
    }
    SqliteFinalize(stmt)
    stmt = null
    sql_cx15: [88] u8
    AppCopyText("SELECT completed_at FROM meditation_logs WHERE user_id=?1 AND duration_seconds>0", sql_cx15[:])
    if activity == 1  && SqlitePrepare(storage_db_handle(), *sql_cx15[0], -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        while SqliteStep(stmt) == SQLITE_ROW {
            local_date: s32 = storage_profile_date_from_epoch(SqliteColumnInt64(stmt, 0))
            offset: s32 = storage_profile_day_offset(local_date, today_date)
            if offset >= 0 && offset <= 370 {
                seen[offset] = 1
            }
        }
        SqliteFinalize(stmt)
        stmt = null
    }
    while streak <= 370 && seen[streak] != 0 {
        streak += 1
    }
    if activity == 0 {
        sql_cx16: [171] u8
        AppCopyText("SELECT COALESCE(AVG(sr.seconds),0) FROM sessions s JOIN session_rounds sr ON sr.session_id=s.id WHERE s.user_id=?1 AND s.deleted_at=0 AND s.activity=?2   AND sr.seconds>0", sql_cx16[:])
        if SqlitePrepare(storage_db_handle(), *sql_cx16[0], -1, *stmt, null) == SQLITE_OK {
            bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
            sqlite3_bind_int(stmt, 2, activity)
            if SqliteStep(stmt) == SQLITE_ROW {
                avg_value = cast(s64)sqlite3_column_double(stmt, 0)
            }
            SqliteFinalize(stmt)
        }
    } else if activity == 1 {
        sql_cx17: [621] u8
        AppCopyText("WITH session_totals AS (  SELECT s.id, SUM(sr.seconds) AS seconds   FROM sessions s JOIN session_rounds sr ON sr.session_id=s.id   WHERE s.user_id=?1 AND s.deleted_at=0 AND s.activity=?2     AND sr.seconds>0   GROUP BY s.id),log_totals AS (  SELECT ml.session_id AS id, ml.duration_seconds AS seconds   FROM meditation_logs ml   WHERE ml.user_id=?1 AND ml.duration_seconds>0     AND NOT EXISTS (SELECT 1 FROM session_totals st                     WHERE st.id=ml.session_id)),all_totals AS (  SELECT seconds FROM session_totals   UNION ALL   SELECT seconds FROM log_totals) SELECT COALESCE(AVG(seconds),0) FROM all_totals", sql_cx17[:])
        if SqlitePrepare(storage_db_handle(), *sql_cx17[0], -1, *stmt, null) == SQLITE_OK {
            bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
            sqlite3_bind_int(stmt, 2, activity)
            if SqliteStep(stmt) == SQLITE_ROW {
                avg_value = cast(s64)sqlite3_column_double(stmt, 0)
            }
            SqliteFinalize(stmt)
        }
    }
    if streak_out != null {
        streak_out.* = streak
    }
    if avg_hold_out != null {
        avg_hold_out.* = avg_value
    }
    return 1
}

#program_export
storage_profile_week_stats :: (today_date: s32, active_days_out: *s32, practice_sessions_out: *s32) -> s32 {
    stmt: *void = null
    active_days: [7] s32
    practice_sessions: s32 = 0
    active_count: s32 = 0
    if active_days_out != null {
        active_days_out.* = 0
    }
    if practice_sessions_out != null {
        practice_sessions_out.* = 0
    }
    if storage_db_handle() == null || today_date <= 0 {
        return 0
    }
    sql_cx18: [83] u8
    AppCopyText("SELECT local_date FROM sessions WHERE user_id=?1 AND deleted_at=0 AND local_date>0", sql_cx18[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx18[0], -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        while SqliteStep(stmt) == SQLITE_ROW {
            offset: s32 = storage_profile_day_offset(sqlite3_column_int(stmt, 0),
                today_date)
            if offset >= 0 && offset < 7 {
                active_days[offset] = 1
                practice_sessions += 1
            }
        }
        SqliteFinalize(stmt)
        stmt = null
    }
    sql_cx19: [157] u8
    AppCopyText("SELECT DISTINCT hd.local_date FROM habit_days hd JOIN habits h ON h.id=hd.habit_id WHERE h.user_id=?1 AND h.deleted_at=0 AND (hd.completed!=0 OR hd.count>0)", sql_cx19[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx19[0], -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        while SqliteStep(stmt) == SQLITE_ROW {
            offset: s32 = storage_profile_day_offset(sqlite3_column_int(stmt, 0),
                today_date)
            if offset >= 0 && offset < 7 {
                active_days[offset] = 1
            }
        }
        SqliteFinalize(stmt)
    }
    {
        i: s32 = 0
        while i < 7 {
            active_count += active_days[i]
            i += 1
        }
    }
    if active_days_out != null {
        active_days_out.* = active_count
    }
    if practice_sessions_out != null {
        practice_sessions_out.* = practice_sessions
    }
    return 1
}

storage_export_sessions_csv_topic_names: [4] string = .[
"wim_hof", "meditation", "sun_salutation", "patterns"
];

storage_csv_write :: (file: FileHandle, offset: *s64, value: string) -> bool {
    if offset == null { return false }
    count := WriteTextAt(file, value, offset.*)
    if count != cast(s64)value.count { return false }
    offset.* += count
    return true
}

storage_csv_write_s32 :: (file: FileHandle, offset: *s64, value: s32) -> bool {
    buffer: [16]u8
    if !AppFormatS32(value, buffer[:]) { return false }
    return storage_csv_write(file, offset, AppTextFromCString(*buffer[0], 16))
}

storage_csv_write_s64 :: (file: FileHandle, offset: *s64, value: s64) -> bool {
    buffer: [24]u8
    if !AppFormatS64(value, buffer[:]) { return false }
    return storage_csv_write(file, offset, AppTextFromCString(*buffer[0], 24))
}

#program_export
storage_export_sessions_csv :: (path: string) -> s32 {
    stmt: *void = null
    if path.count == 0 || storage_db_handle() == null {
        return 0
    }
    if SqlitePrepareText(storage_db_handle(), ExportSessionsSQL, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    file := OpenReplace(path)
    if !file.valid {
        SqliteFinalize(stmt)
        return 0
    }
    offset: s64 = 0
    ok := storage_csv_write(file, *offset,
        "date,practice,source,rounds,total_hold_seconds,meditation_seconds\n")
    rc := SqliteStep(stmt)
    while ok && rc == SQLITE_ROW {
        date: *u8 = SqliteColumnText(stmt, 0)
        topic: s32 = sqlite3_column_int(stmt, 1)
        source: *u8 = SqliteColumnText(stmt, 2)
        topic_name: string = "other"
        if topic >= 0 && topic < 4 {
            topic_name = storage_export_sessions_csv_topic_names[topic]
        }
        if sqlite3_column_int(stmt, 5) > 0 {
            topic_name = "meditation"
        }
        ok = storage_csv_write(file, *offset,
            ifx (date != null) then (AppTextFromCString(date, 32)) else ("")) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write(file, *offset, topic_name) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write(file, *offset,
            ifx (source != null) then (AppTextFromCString(source, 64)) else ("")) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write_s32(file, *offset, sqlite3_column_int(stmt, 4)) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write_s32(file, *offset, sqlite3_column_int(stmt, 3)) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write_s32(file, *offset, sqlite3_column_int(stmt, 5)) &&
        storage_csv_write(file, *offset, "\n")
        if ok { rc = SqliteStep(stmt) }
    }
    closed := CloseFile(file)
    SqliteFinalize(stmt)
    return ifx (ok && rc == SQLITE_DONE && closed) then (1) else (0)
}

// Minimal session list for Health Connect: epoch start/end plus the
// activity id. Duration prefers meditation_logs (activity 1) and falls
// back to the sum of session_rounds (breathwork, sun salutation,
// patterns).

#program_export
storage_export_health_connect_csv :: (path: string) -> s32 {
    stmt: *void = null
    rows: s32 = 0
    if path.count == 0 || storage_db_handle() == null {
        return 0
    }
    if SqlitePrepareText(storage_db_handle(), ExportHealthConnectSQL, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    file := OpenReplace(path)
    if !file.valid {
        SqliteFinalize(stmt)
        return 0
    }
    offset: s64 = 0
    ok := storage_csv_write(file, *offset, "start,end,practice\n")
    rc := SqliteStep(stmt)
    while ok && rc == SQLITE_ROW {
        start: s64 = SqliteColumnInt64(stmt, 0)
        activity: s32 = sqlite3_column_int(stmt, 1)
        duration: s64 = SqliteColumnInt64(stmt, 2)
        if start <= 0 || duration <= 0 {
            rc = SqliteStep(stmt)
            continue
        }
        ok = storage_csv_write_s64(file, *offset, start) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write_s64(file, *offset, start + duration) &&
        storage_csv_write(file, *offset, ",") &&
        storage_csv_write_s32(file, *offset, activity) &&
        storage_csv_write(file, *offset, "\n")
        if !ok { break }
        rows += 1
        rc = SqliteStep(stmt)
    }
    closed := CloseFile(file)
    SqliteFinalize(stmt)
    return ifx (ok && rc == SQLITE_DONE && closed && rows > 0) then (1) else (0)
}
