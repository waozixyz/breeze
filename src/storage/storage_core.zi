#program_export
storage_next_change_time :: () -> s64 {
    now: s64 = now_seconds()
    latest: s64
    latest = db_select_int64_text("SELECT MAX(updated_at) FROM ( SELECT COALESCE(MAX(updated_at),0) AS updated_at FROM habits UNION ALL SELECT COALESCE(MAX(updated_at),0) FROM habit_days UNION ALL SELECT COALESCE(MAX(updated_at),0) FROM sessions)",
        0)
    return ifx (latest >= now) then (latest + 1) else (now)
}

fill_random_bytes :: (data: *u8, len: s64) -> s32 {
    if data == null || len <= 0 {
        return 0
    }
    return SyncCryptoRandom(data, len)
}

storage_sha256_hex :: (data: *u8, len: s64, out_hex: *u8) {
    digest: [32] u8
    SyncCryptoSha256(data, len, *digest[0])
    if SyncCryptoBytesToHex(*digest[0], size_of(type_of(digest)), out_hex, 65) == 0 {
        out_hex[0] = cast(u8)0
    }
}

hex_digit :: (value: u8) -> u8 {
    if value < 10 {
        return cast(u8)(value + 48)
    }
    return cast(u8)(value + 87)
}

make_client_uuid :: (out: *u8) {
    if out == null { return }
    bytes: [16] u8
    if fill_random_bytes(*bytes[0], size_of(type_of(bytes))) == 0 {
        out[0] = cast(u8)0
        return
    }
    bytes[6] = cast(u8)((bytes[6] & 15) | 64)
    bytes[8] = cast(u8)((bytes[8] & 63) | 128)
    out_cursor: s32 = 0
    index: s32 = 0
    while index < 16 {
        out[out_cursor] = hex_digit(bytes[index] >> 4)
        out_cursor += 1
        out[out_cursor] = hex_digit(bytes[index] & 15)
        out_cursor += 1
        if index == 3 || index == 5 || index == 7 || index == 9 {
            out[out_cursor] = 45
            out_cursor += 1
        }
        index += 1
    }
    out[36] = cast(u8)0
}

#program_export
storage_make_uuid :: (out: *u8) {
    make_client_uuid(out)
}

#program_export
storage_schedule_persist :: () {
    #if #defined(PLATFORM_WEB) {
        if storage_db_handle() != null {
            StorageCacheFlush(storage_db_handle())
            if sqlite3_get_autocommit(storage_db_handle()) != 0 {
                checkpoint: [64]u8
                unused AppCopyText("PRAGMA wal_checkpoint(TRUNCATE)", checkpoint[:])
                unused SqliteExec(storage_db_handle(), *checkpoint[0])
                StorageCacheFlush(storage_db_handle())
            }
        }
        schedule_web_storage_sync(120, 0)
    }
}

storage_enqueue_sync_entity :: (entity_type: string, entity_id: string, local_date: s32) -> s32 {
    stmt: *void = null
    rc: s32
    if storage_db_handle() == null || entity_type.count == 0 || entity_id.count == 0 {
        return 0
    }
    query := "INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES(?1,?2,?3,?4) ON CONFLICT(entity_type,entity_id,local_date) DO UPDATE SET queued_at=excluded.queued_at"
    if entity_type == "cell_record" {
        // Cell receipts name the exact submitted sequence. Replacing a cell
        // allocates a fresh sequence even for edits within the same second.
        // Owner habit/session saves retain their existing queue behaviour.
        query = "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES(?1,?2,?3,?4)"
    }
    if SqlitePrepareText(storage_db_handle(), query,
        -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, entity_type)
    bind_text(stmt, 2, entity_id)
    sqlite3_bind_int(stmt, 3, local_date)
    SqliteBindInt64(stmt, 4, now_seconds())
    rc = SqliteStep(stmt)
    SqliteFinalize(stmt)
    if rc == SQLITE_DONE {
        return 1
    }
    return 0
}

#program_export
storage_enqueue_sync_habit :: (habit_id: string) -> s32 {
    return storage_enqueue_sync_entity("habit", habit_id, 0)
}

