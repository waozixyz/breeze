storage_duplicate_cstring :: (source: *u8) -> *u8 {
    if source == null { return null }
    length: u64 = 0
    while source[length] != cast(u8)0 {
        if length == 9223372036854775806 { return null }
        length += 1
    }
    duplicate := cast(*u8)calloc(cast(usize)(length + 1), 1)
    if duplicate == null { return null }
    index: u64 = 0
    while index < length {
        duplicate[index] = source[index]
        index += 1
    }
    return duplicate
}
