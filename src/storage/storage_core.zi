#program_export
storage_has_local_syncable_data :: () -> s32 {
    if storage_db_handle() == null {
        return 0
    }
    exists_sql: [512] u8
    AppCopyText("SELECT EXISTS(SELECT 1 FROM sessions WHERE user_id=(SELECT id FROM users LIMIT 1) AND deleted_at=0 LIMIT 1) OR EXISTS(SELECT 1 FROM habits WHERE user_id=(SELECT id FROM users LIMIT 1) AND deleted_at=0 LIMIT 1) OR EXISTS(SELECT 1 FROM habit_days hd JOIN habits h ON h.id=hd.habit_id WHERE h.user_id=(SELECT id FROM users LIMIT 1) AND (hd.completed!=0 OR hd.count>0) LIMIT 1)", exists_sql[:])
    if db_select_int64_text(AppTextFromCString(*exists_sql[0], 512), 0) != 0 {
        return 1
    }
    return 0
}

#program_export
storage_clear_local_syncable_data :: () -> s32 {
    ok: s32 = storage_clear_local_sync_data_impl()
    if ok != 0 {
        storage_schedule_persist()
    }
    return ok
}

storage_sync_client_id_buffer: [64] u8;

#program_export
storage_sync_client_id :: () -> string {
    stored: string = ""
    storage_sync_client_id_buffer[0] = cast(u8)0
    if storage_db_handle() != null {
        stmt: *void = null
        client_id_sql: [64] u8
        AppCopyText("SELECT value FROM meta WHERE key='sync_client_id'", client_id_sql[:])
        if SqlitePrepare(storage_db_handle(), *client_id_sql[0], -1,
            *stmt, null) == SQLITE_OK  && SqliteStep(stmt) == SQLITE_ROW {
            stored = AppTextFromCString(SqliteColumnText(stmt, 0), 64)
            if stored.count > 0 {
                AppCopyText(stored, storage_sync_client_id_buffer[:])
            }
        }
        SqliteFinalize(stmt)
    }
    if storage_sync_client_id_buffer[0] == cast(u8)0 {
        make_client_uuid(*storage_sync_client_id_buffer[0])
        if storage_sync_client_id_buffer[0] == cast(u8)0 { return "" }
        set_meta_buf("sync_client_id", AppTextFromCString(*storage_sync_client_id_buffer[0], 64))
        storage_schedule_persist()
    }
    return AppTextFromCString(*storage_sync_client_id_buffer[0], 64)
}

#program_export
storage_settings_empty :: () -> s32 {
    stmt: *void = null
    count: s32 = 0
    if storage_db_handle() == null {
        return 1
    }
    sql_cw1: [64] u8
    AppCopyText("SELECT COUNT(*) FROM settings WHERE user_id=?1", sql_cw1[:])
    if SqlitePrepare(storage_db_handle(), *sql_cw1[0], -1, *stmt, null) != SQLITE_OK {
        return 1
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    if SqliteStep(stmt) == SQLITE_ROW {
        count = sqlite3_column_int(stmt, 0)
    }
    SqliteFinalize(stmt)
    if count == 0 {
        return 1
    }
    return 0
}

#program_export
storage_get_social_cache_json :: (kind: string, out: *u8, out_size: s64) -> s32 {
    stmt: *void = null
    found: s32 = 0
    if out == null || out_size == 0 {
        return 0
    }
    out[0] = cast(u8)0
    if storage_db_handle() == null || kind.count == 0 {
        return 0
    }
    sql_cx2: [70] u8
    AppCopyText("SELECT json FROM social_snapshots WHERE user_id=?1 AND kind=?2", sql_cx2[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx2[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, kind)
    if SqliteStep(stmt) == SQLITE_ROW {
        json: string = AppTextFromCString(SqliteColumnText(stmt, 0), 8192)
        AppCopyText(ifx (json.count > 0) then (json) else (""),
            BytesFromPointer(out, cast(u64)out_size))
        found = 0
        if out[0] != cast(u8)0 {
            found = 1
        }
    }
    SqliteFinalize(stmt)
    return found
}

#program_export
storage_set_social_cache_json :: (kind: string, json: string) -> s32 {
    stmt: *void = null
    updated_at: s64
    rc: s32
    same: s32 = 0
    if storage_db_handle() == null || kind.count == 0  || json.count == 0 || storage_json_valid(json) == 0 {
        return 0
    }
    sql_cx11: [66] u8
    AppCopyText("SELECT json=?3 FROM social_snapshots WHERE user_id=?1 AND kind=?2", sql_cx11[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx11[0], -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 2, kind)
        bind_text(stmt, 3, json)
        if SqliteStep(stmt) == SQLITE_ROW {
            same = 0
            if sqlite3_column_int(stmt, 0) != 0 {
                same = 1
            }
        }
    }
    SqliteFinalize(stmt)
    stmt = null
    if same != 0 {
        return 1
    }
    updated_at = storage_next_change_time()
    sql_cx3: [176] u8
    AppCopyText("INSERT INTO social_snapshots(user_id,kind,json,updated_at) VALUES(?1,?2,?3,?4) ON CONFLICT(user_id,kind) DO UPDATE SET json=excluded.json,updated_at=excluded.updated_at", sql_cx3[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx3[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, kind)
    bind_text(stmt, 3, json)
    SqliteBindInt64(stmt, 4, updated_at)
    rc = SqliteStep(stmt)
    SqliteFinalize(stmt)
    if rc != SQLITE_DONE {
        return 0
    }
    storage_schedule_persist()
    return 2
}

#program_export
storage_get_setting_int :: (key: string, fallback: s32) -> s32 {
    text: string = storage_get_setting_text(key)
    if text.count > 0 {
        return storage_parse_setting_int(text)
    }
    return fallback
}

#program_export
storage_get_setting_text :: (key: string) -> string {
    stmt: *void = null
    text_value: *u8 = storage_setting_text_buffer()
    if text_value == null {
        return ""
    }
    text_value[0] = cast(u8)0
    if storage_db_handle() == null || key.count == 0 {
        return ""
    }
    settings_sql: [128] u8
    AppCopyText("SELECT value FROM settings WHERE user_id=?1 AND key=?2", settings_sql[:])
    if SqlitePrepare(storage_db_handle(), *settings_sql[0], -1, *stmt, null) != SQLITE_OK {
        return ""
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, key)
    if SqliteStep(stmt) == SQLITE_ROW {
        text: string = AppTextFromCString(SqliteColumnText(stmt, 0), 8192)
        AppCopyText(ifx (text.count > 0) then (text) else (""),
            BytesFromPointer(text_value, 8192))
    }
    SqliteFinalize(stmt)
    if text_value[0] != cast(u8)0 {
        return AppTextFromCString(text_value, 8192)
    }
    return ""
}

#program_export
storage_setting_text_equals :: (key: string, value: string) -> s32 {
    stmt: *void = null
    ok: s32 = 0
    if storage_db_handle() == null || key.count == 0 || value.count == 0 {
        return 0
    }
    sql_cx4: [71] u8
    AppCopyText("SELECT 1 FROM settings WHERE user_id=?1 AND key=?2 AND value=?3", sql_cx4[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx4[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, key)
    bind_text(stmt, 3, value)
    ok = 0
    if SqliteStep(stmt) == SQLITE_ROW {
        ok = 1
    }
    SqliteFinalize(stmt)
    return ok
}

#program_export
storage_list_settings :: (callback: SettingVisitor, user: *void) -> s32 {
    stmt: *void = null
    if storage_db_handle() == null {
        return 0
    }
    sql_cx5: [64] u8
    AppCopyText("SELECT key,value FROM settings WHERE user_id=?1", sql_cx5[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx5[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    while SqliteStep(stmt) == SQLITE_ROW {
        key: string = AppTextFromCString(SqliteColumnText(stmt, 0), 8192)
        value: string = AppTextFromCString(SqliteColumnText(stmt, 1), 8192)
        callback(ifx (key.count > 0) then (key) else (""), ifx (value.count > 0) then (value) else (""), cast(s64)user)
    }
    SqliteFinalize(stmt)
    return 1
}

#program_export
storage_set_setting_text :: (key: string, value: string) {
    stmt: *void = null
    rc: s32
    if storage_db_handle() == null || key.count == 0 {
        return
    }
    sql_cx6: [206] u8
    AppCopyText("INSERT INTO settings(user_id,key,value,updated_at) VALUES(?1,?2,?3,?4) ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at WHERE settings.value<>excluded.value", sql_cx6[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx6[0], -1, *stmt, null) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, key)
    bind_text(stmt, 3, ifx (value.count > 0) then (value) else (""))
    SqliteBindInt64(stmt, 4, now_seconds())
    rc = SqliteStep(stmt)
    SqliteFinalize(stmt)
    if rc == SQLITE_DONE && sqlite3_changes(storage_db_handle()) > 0 {
        if CellRecordValid(key) {
            unused storage_enqueue_sync_entity("cell_record", key, 0)
        }
        if AppPreferenceValid(key) {
            unused storage_enqueue_sync_entity("app_preference", key, 0)
        }
        if storage_state_handle().settings_write_depth <= 0 {
            storage_schedule_persist()
        }
    }
}

#program_export
storage_settings_begin_write :: () {
    database := storage_db_handle()
    if database == null {
        return
    }
    // A batch belongs to the thread that begins it. The connection's
    // recursive mutex stays held until the batch ends, so another thread's
    // batch waits here instead of joining this one: a shared depth let a
    // second thread skip its BEGIN, and the first thread could then return
    // without COMMIT while its open transaction still held the connection.
    mutex := sqlite3_db_mutex(database)
    if mutex != null {
        sqlite3_mutex_enter(mutex)
    }
    storage_state_handle().settings_write_depth += 1
    if storage_state_handle().settings_write_depth == 1 {
        exec_sql("BEGIN IMMEDIATE")
    }
}

#program_export
storage_settings_end_write :: () {
    database := storage_db_handle()
    if database == null {
        return
    }
    mutex := sqlite3_db_mutex(database)
    if mutex != null {
        sqlite3_mutex_enter(mutex)
    }
    if storage_state_handle().settings_write_depth <= 0 {
        if mutex != null {
            sqlite3_mutex_leave(mutex)
        }
        return
    }
    storage_state_handle().settings_write_depth -= 1
    if storage_state_handle().settings_write_depth == 0 {
        // A failed COMMIT must not leave the transaction, and with it the
        // connection, held after this thread returns.
        if exec_sql("COMMIT") == 0 && sqlite3_get_autocommit(database) == 0 {
            exec_sql("ROLLBACK")
        }
        storage_schedule_persist()
    }
    if mutex != null {
        // Release this call's enter and the one its batch began with.
        sqlite3_mutex_leave(mutex)
        sqlite3_mutex_leave(mutex)
    }
}

#program_export
storage_set_setting_int :: (key: string, value: s32) {
    text: [32] u8
    AppFormatS32(value, text[:])
    storage_set_setting_text(key, AppTextFromCString(*text[0], 32))
}

storage_setting_exists :: (key: string) -> s32 {
    stmt: *void = null
    exists: s32 = 0
    if storage_db_handle() == null || key.count == 0 {
        return 0
    }
    sql_cx7: [73] u8
    AppCopyText("SELECT EXISTS(SELECT 1 FROM settings WHERE user_id=?1 AND key=?2)", sql_cx7[:])
    if SqlitePrepare(storage_db_handle(), *sql_cx7[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, AppTextFromCString(storage_user_id_buffer(), 64))
    bind_text(stmt, 2, key)
    if SqliteStep(stmt) == SQLITE_ROW {
        exists = 0
        if sqlite3_column_int(stmt, 0) != 0 {
            exists = 1
        }
    }
    SqliteFinalize(stmt)
    return exists
}

storage_sync_url_looks_valid :: (url: string) -> s32 {
    if url.count == 0 {
        return 0
    }
    if url.count >= 8 && Substring(url, 0, 8) == "https://" {
        if url.count > 8 {
            return 1
        }
        return 0
    }
    if url.count >= 7 && Substring(url, 0, 7) == "http://" {
        if url.count > 7 {
            return 1
        }
        return 0
    }
    return 0
}

#program_export
storage_migrate_sync_enabled_flag :: () -> s32 {
    url: string
    if storage_db_handle() == null {
        return 0
    }
    if storage_setting_exists(STORAGE_SYNC_ENABLED_KEY) != 0 {
        return 1
    }
    if storage_setting_exists("sync_server_connected") != 0 {
        storage_set_setting_int(STORAGE_SYNC_ENABLED_KEY,
            storage_get_setting_int("sync_server_connected", 0))
        return 1
    }
    if storage_has_sync_account() == 0 {
        return 1
    }
    url = storage_get_setting_text(STORAGE_SYNC_SERVER_URL_KEY)
    if storage_sync_url_looks_valid(url) == 0 {
        return 1
    }
    if storage_meta_int64("sync_last_server_version", 0) <= 0  && storage_meta_int64("sync_full_upload_done", 0) == cast(s64)0 {
        return 1
    }
    storage_set_setting_int(STORAGE_SYNC_ENABLED_KEY, 1)
    LogStorage(LOG_INFO, "SYNC: migrated existing synced account to connected server state")
    return 1
}

#program_export
storage_sync_enabled :: () -> s32 {
    if storage_has_sync_account() != 0 && storage_get_setting_int(STORAGE_SYNC_ENABLED_KEY, 0) != 0 {
        return 1
    }
    return 0
}

#program_export
storage_set_sync_enabled :: (enabled: s32) {
    storage_set_setting_int(STORAGE_SYNC_ENABLED_KEY, ifx (enabled != 0) then (1) else (0))
    storage_set_setting_int("sync_last_result", 0)
    storage_set_setting_int("sync_retry_attempt", 0)
}

// Appends `,"name":value` for a whole number.
storage_json_append_int_field :: (json: *StorageJsonBuilder, name: string, value: s64) {
    digits: [24] u8
    storage_json_builder_append_text(json, ",\"")
    storage_json_builder_append_text(json, name)
    storage_json_builder_append_text(json, "\":")
    AppFormatS64(value, digits[:])
    storage_json_builder_append_text(json, AppTextFromCString(*digits[0], 24))
}

// Appends `,"name":true` or `,"name":false`.
storage_json_append_bool_field :: (json: *StorageJsonBuilder, name: string, value: bool) {
    storage_json_builder_append_text(json, ",\"")
    storage_json_builder_append_text(json, name)
    if value {
        storage_json_builder_append_text(json, "\":true")
    } else {
        storage_json_builder_append_text(json, "\":false")
    }
}

storage_append_habit_row_json :: (json_handle: s64, stmt_handle: s64) {
    json: *StorageJsonBuilder = cast(*StorageJsonBuilder)json_handle
    stmt: *void = cast(*void)stmt_handle
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "id", AppTextFromCString(SqliteColumnText(stmt, 0), 8192))
    storage_json_builder_append_text(json, ",")
    storage_json_builder_key_value_text(json, "name", AppTextFromCString(SqliteColumnText(stmt, 1), 8192))
    storage_json_append_int_field(json, "color_r", cast(s64)sqlite3_column_int(stmt, 2))
    storage_json_append_int_field(json, "color_g", cast(s64)sqlite3_column_int(stmt, 3))
    storage_json_append_int_field(json, "color_b", cast(s64)sqlite3_column_int(stmt, 4))
    storage_json_append_int_field(json, "sync_mode", cast(s64)sqlite3_column_int(stmt, 5))
    storage_json_append_int_field(json, "sync_activity", cast(s64)sqlite3_column_int(stmt, 6))
    storage_json_append_int_field(json, "counter_enabled",
        ifx (sqlite3_column_int(stmt, 7) != 0) then (cast(s64)1) else (cast(s64)0))
    storage_json_append_int_field(json, "counter_target", cast(s64)sqlite3_column_int(stmt, 8))
    storage_json_append_int_field(json, "sort_order", cast(s64)sqlite3_column_int(stmt, 9))
    storage_json_append_int_field(json, "deleted_at", SqliteColumnInt64(stmt, 10))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(stmt, 11))
    storage_json_append_int_field(json, "weekdays", cast(s64)sqlite3_column_int(stmt, 12))
    storage_json_append_int_field(json, "reminder_hour", cast(s64)sqlite3_column_int(stmt, 13))
    storage_json_builder_append_text(json, "}")
}

storage_append_habit_day_row_json :: (json_handle: s64, stmt_handle: s64) {
    json: *StorageJsonBuilder = cast(*StorageJsonBuilder)json_handle
    stmt: *void = cast(*void)stmt_handle
    storage_json_builder_append_text(json, "{")
    storage_json_builder_key_value_text(json, "habit_id", AppTextFromCString(SqliteColumnText(stmt, 0), 8192))
    storage_json_append_int_field(json, "local_date", cast(s64)sqlite3_column_int(stmt, 1))
    storage_json_append_bool_field(json, "completed", sqlite3_column_int(stmt, 2) != 0)
    storage_json_append_int_field(json, "count", cast(s64)sqlite3_column_int(stmt, 3))
    storage_json_builder_append_text(json, ",\"updated_at\":")
    storage_json_builder_append_epoch(json, SqliteColumnInt64(stmt, 4))
    storage_json_builder_append_text(json, "}")
}

storage_append_elist_list_row_json :: (json_handle: s64, stmt_handle: s64) {
    json: *StorageJsonBuilder = cast(*StorageJsonBuilder)json_handle
