    storage_json_append_int_field(json, "sort_order", cast(s64)sqlite3_column_int(stmt, 5))
    storage_json_append_int_field(json, "deleted_at", SqliteColumnInt64(stmt, 6))
    storage_json_builder_append_text(json, ",\"updated_at\":")
