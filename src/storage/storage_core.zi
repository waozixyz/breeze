STORAGE_SYNC_ENABLED_KEY :: "sync_enabled"

STORAGE_SYNC_LAST_SERVER_HASH_KEY :: "sync_last_server_state_hash"

STORAGE_SYNC_SERVER_CLOCK_KEY :: "sync_server_clock"

STORAGE_SYNC_PENDING_REVIEW_KEY :: "sync_pending_review_pending"

STORAGE_SYNC_APPLY_REVIEW_KEY :: "sync_apply_pending_review"

STORAGE_SYNC_FULL_REPLACE_KEY :: "sync_full_replace_requested"

STORAGE_SYNC_ACCOUNT_ALIAS_KEY :: "sync_account_alias"

STORAGE_SYNC_DATA_OWNER_PUBLIC_ID_KEY :: "sync_data_owner_public_id"

STORAGE_SYNC_ZERO_HABIT_DAY_REPAIR_KEY :: "sync_zero_habit_day_repair_v1_done"
// Synced records gain fields over time, such as a habit's questions and span.
// An older app version keeps only the fields it knows when a record arrives,
// and its sync position then moves past that record. Raise this whenever
// synced records gain fields: a device whose records were received by an
// older version downloads them all again once, so it gets every field.
STORAGE_SYNC_RECORD_FIELDS :: 3
STORAGE_SYNC_RECORD_FIELDS_KEY :: "sync_record_fields"

// Whether this device's records may still lack fields an older version
// didn't keep: true until its one download of every record is applied.
storage_sync_records_outdated :: () -> bool {
    return storage_meta_int64(STORAGE_SYNC_RECORD_FIELDS_KEY, 0) < STORAGE_SYNC_RECORD_FIELDS
}

// A device that synced in an older version downloads every record before it
// sends any, so a record it got without some fields never goes out without
// them. A device's first sync still sends its own data at once.
#program_export
storage_sync_records_download_first :: () -> bool {
    return storage_sync_records_outdated() &&
    storage_meta_int64("sync_last_server_version", 0) > 0
}
STORAGE_SYNC_SEEN_SERVER_VERSION_KEY :: "sync_seen_server_version"

STORAGE_SYNC_OP_BATCH_LIMIT :: 400

STORAGE_SYNC_RECORD_KEY_CONTEXT :: "breathing-private-record-key-v1"

STORAGE_SYNC_RECORD_KEY_ID :: "breathing-main-1"

#program_export
storage_next_change_time :: () -> s64 {
    now: s64 = now_seconds()
    latest: s64
    latest = db_select_int64_text("SELECT MAX(updated_at) FROM ( SELECT COALESCE(MAX(updated_at),0) AS updated_at FROM habits UNION ALL SELECT COALESCE(MAX(updated_at),0) FROM habit_days UNION ALL SELECT COALESCE(MAX(updated_at),0) FROM sessions)",
        0)
    return ifx (latest >= now) then (latest + 1) else (now)
}

fill_random_bytes :: (data: *u8, len: s64) -> s32 {
    if data == null || len <= 0 {
        return 0
    }
    return SecureRandom(data, len)
}

storage_sha256_hex :: (data: *u8, len: s64, out_hex: *u8) {
    digest: [32] u8
    Sha256(data, len, *digest[0])
    if BytesToHex(*digest[0], size_of(type_of(digest)), out_hex, 65) == 0 {
        out_hex[0] = cast(u8)0
    }
}

hex_digit :: (value: u8) -> u8 {
    if value < 10 {
        return cast(u8)(value + 48)
    }
    return cast(u8)(value + 87)
}

make_client_uuid :: (out: *u8) {
    if out == null { return }
    bytes: [16] u8
    if fill_random_bytes(*bytes[0], size_of(type_of(bytes))) == 0 {
        out[0] = cast(u8)0
        return
    }
    bytes[6] = cast(u8)((bytes[6] & 15) | 64)
    bytes[8] = cast(u8)((bytes[8] & 63) | 128)
    out_cursor: s32 = 0
    index: s32 = 0
    while index < 16 {
        out[out_cursor] = hex_digit(bytes[index] >> 4)
        out_cursor += 1
        out[out_cursor] = hex_digit(bytes[index] & 15)
        out_cursor += 1
        if index == 3 || index == 5 || index == 7 || index == 9 {
            out[out_cursor] = 45
            out_cursor += 1
        }
        index += 1
    }
    out[36] = cast(u8)0
}

#program_export
storage_make_uuid :: (out: *u8) {
    make_client_uuid(out)
}

#program_export
storage_schedule_persist :: () {
    #if #defined(PLATFORM_WEB) {
        if storage_db_handle() != null {
            StorageCacheFlush(storage_db_handle())
            if sqlite3_get_autocommit(storage_db_handle()) != 0 {
                checkpoint: [64]u8
                unused AppCopyText("PRAGMA wal_checkpoint(TRUNCATE)", checkpoint[:])
                unused SqliteExec(storage_db_handle(), *checkpoint[0])
                StorageCacheFlush(storage_db_handle())
            }
        }
        schedule_web_storage_sync(120, 0)
    }
}
