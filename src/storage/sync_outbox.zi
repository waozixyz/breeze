// The sync outbox: which local records wait to go to the node, queued
// with each change and cleared once the node has them.
#import, file "../app/text_buffers.zi";
#import, file "state.zi";
#import, file "sqlite.zi";
#import, file "db.zi";
#import, file "sql_query.zi";
#import, file "storage_core.zi";
#import, file "sync_state.zi";
c :: #system_library "c";
sqlite3_bind_int :: (statement: *void, index: s32, value: s32) -> s32 #foreign c "sqlite3_bind_int";
sqlite3_get_autocommit :: (database: *void) -> s32 #foreign c "sqlite3_get_autocommit";
storage_sync_review_delete_json :: () #foreign c "storage_sync_review_delete_json";

storage_enqueue_sync_entity :: (entity_type: string, entity_id: string, local_date: s32) -> s32 {
    stmt: *void = null
    rc: s32
    if storage_db_handle() == null || entity_type.count == 0 || entity_id.count == 0 {
        return 0
    }
    query := "INSERT INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES(?1,?2,?3,?4) ON CONFLICT(entity_type,entity_id,local_date) DO UPDATE SET queued_at=excluded.queued_at"
    if entity_type == "cell_record" || entity_type == "habit_setting" {
        // These receipts name the exact submitted sequence. Replacing a
        // setting allocates a fresh sequence even within the same second.
        // Owner habit/session saves retain their existing queue behaviour.
        query = "INSERT OR REPLACE INTO sync_outbox(entity_type,entity_id,local_date,queued_at) VALUES(?1,?2,?3,?4)"
    }
    if SqlitePrepareText(storage_db_handle(), query,
        -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, entity_type)
    bind_text(stmt, 2, entity_id)
    sqlite3_bind_int(stmt, 3, local_date)
    SqliteBindInt64(stmt, 4, now_seconds())
    rc = SqliteStep(stmt)
    SqliteFinalize(stmt)
    if rc == SQLITE_DONE {
        return 1
    }
    return 0
}

#program_export
storage_enqueue_sync_habit :: (habit_id: string) -> s32 {
    return storage_enqueue_sync_entity("habit", habit_id, 0)
}

#program_export
storage_enqueue_sync_habit_day :: (habit_id: string, local_date: s32) -> s32 {
    return storage_enqueue_sync_entity("habit_day", habit_id, local_date)
}

