// mktime reads the nine standard tm integers. The aligned trailing storage
// covers tm_gmtoff and tm_zone on Unix; Windows uses only the first fields.
// Keep this native ABI isolated from the portable session parser.
c :: #system_library "c";

LocalTm :: struct {
    second: s32
    minute: s32
    hour: s32
    day: s32
    month_from_zero: s32
    year_from_1900: s32
    weekday: s32
    year_day: s32
    daylight: s32
    spare0: s64
    spare1: s64
    spare2: s64
    spare3: s64
}

NativeMktime :: (value: *LocalTm) -> s64 #foreign c "mktime";

#program_export
storage_local_timestamp :: (year: s32, month: s32, day: s32,
    hour: s32, minute: s32, second: s32) -> s64 {
    value: LocalTm
    value.second = second
    value.minute = minute
    value.hour = hour
    value.day = day
    value.month_from_zero = month - 1
    value.year_from_1900 = year - 1900
    value.weekday = 0
    value.year_day = 0
    value.daylight = -1
    value.spare0 = 0
    value.spare1 = 0
    value.spare2 = 0
    value.spare3 = 0
    return NativeMktime(*value)
}
