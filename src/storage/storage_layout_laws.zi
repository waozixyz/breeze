#import, file "storage_layout.zi";

// Laws for the private-data layout. They restate the names independently of
// storage_layout.zi; `ziran check` proves the constants match. Changing a
// name here is a data-migration decision, not an implementation detail.

#law CurrentDirectoryIsInbe custom CurrentDirectoryName == "inbe";
#law CurrentDatabaseIsInbe custom CurrentDatabaseName == "inbe.db";
#law PreviousDatabaseIsBreathing custom PreviousDatabaseName == "breathing.db";

// The older directory never equals the current one on any target, so an
// upgrade cannot mistake the current directory for the old one.
#law PreviousDirectoriesDiffer custom PreviousDirectoryPosix != CurrentDirectoryName && PreviousDirectoryWindows != CurrentDirectoryName && PreviousDirectoryAndroid != CurrentDirectoryName && PreviousDirectoryWeb != CurrentDirectoryName;
#law PreviousDirectoryNames custom PreviousDirectoryPosix == "breathing" && PreviousDirectoryAndroid == "breathing" && PreviousDirectoryWeb == "breathing" && PreviousDirectoryWindows == "BreathSession";
#law DatabaseNamesDiffer custom CurrentDatabaseName != PreviousDatabaseName;

// Exports use the current entry; both current and historical entries import.
#law ExportEntryIsCurrent custom CurrentDatabaseEntry == "inbe-data/inbe.db" && ExportMetadataEntry == "inbe-data/metadata.json" && ExportMetadataFormat == "inbe-data-sqlite";
#law HistoricalEntryStaysImportable custom PreviousDatabaseEntry == "breathing-data/breathing.db" && PreviousDatabaseEntry != CurrentDatabaseEntry;

#law WebHomes custom CurrentWebHome == "/home/inbe" && PreviousWebHome == "/home/breathing";
#law ExportFilenames custom ExportFilenameFormat == "inbe-%lld.zip" && ExportFilenameFallback == "inbe.zip" && ExportFilenamePrefix == "inbe-" && ExportFilenameSuffix == ".zip" && ExportSessionsCsv == "inbe-sessions.csv";
#law TemporaryNames custom ImportDatabaseTemporaryName == "import-inbe.db" && InspectDatabaseTemporaryName == "import-inspect-inbe.db" && ExportDatabaseTemporaryName == "export-inbe.db" && WebExportTemporaryPath == "/tmp/inbe-web-export.zip" && ArchiveDirectorySuffix == ".before-breathing-migration-";

// Product intent: delegate access is limited to Lumi, with a separate key.
// These obligations add the migration boundary without changing old layouts.
#law LumiCollectionIsIsolated custom LumiPrivateCollection == "private.inbe.v2.lumi" && LegacyPrivateCellsCollection == "private.inbe.v1.cells" && LumiPrivateCollection != LegacyPrivateCellsCollection;
#law LumiKeyIsSeparate custom LumiPrivateKeyContext == "inbe-private-lumi-record-key-v2" && LumiPrivateKeyID == "inbe-lumi-1" && LumiPrivateKeyContext != "breathing-private-record-key-v1" && LumiPrivateKeyID != "breathing-main-1";
#law LumiMigrationMarker custom LumiCollectionMigrationKey == "sync_lumi_collection_v2_done";

#program_export
storage_layout_laws_entry :: () -> s32 {
    return 0
}
