// Model of the habit-day merge used when two copies of a habit are combined
// (storage_merge_habit_into and MergeRemoteHabitDaysSQL). A habit is a
// sequence of per-day values; a day missing on one side counts as 0. The
// merge takes the larger value for every day, so it can only add progress.
// The SQL implements this rule; tests/habit_merge_sql_test.py runs the real
// SQL and checks it against the laws in habit_merge_laws.zi.

HabitDayValue :: (mine: s32, theirs: s32) -> s32 {
    if mine > theirs {
        return mine
    }
    return theirs
}

// Merged value of day `day` for two 3-day windows (kept small so the laws can
// enumerate every case).
HabitMergedDay :: (mine: [3]s32, theirs: [3]s32, day: s32) -> s32 {
    return HabitDayValue(mine[day], theirs[day])
}

// Three-way merge, for associativity: merging in any grouping gives one result.
HabitMergedDay3 :: (a: [3]s32, b: [3]s32, c: [3]s32, day: s32) -> s32 {
    return HabitDayValue(HabitDayValue(a[day], b[day]), c[day])
}
