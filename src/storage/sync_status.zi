#scope_export
SyncStatus :: struct {
    has_account: s32
    enabled: s32
    review_pending: s32
    repair_pending: s32
    full_upload_done: s32
    server_version: s64
    server_clock: s64
    queued_changes: s64
}

#scope_file
c :: #system_library "c";
storage_sync_status :: (status: *SyncStatus) -> s32 #foreign c;

#scope_export
#program_export
SyncStatusRead :: (status: *SyncStatus) -> bool {
    if status == null { return false }
    status.* = SyncStatus.{}
    return storage_sync_status(status) != 0
}
