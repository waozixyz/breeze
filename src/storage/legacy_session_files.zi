// Imports historical text sessions found under the active Inbe data root.
// Directory enumeration and byte loading are native filesystem operations;
// path recognition and session insertion are checked Ziran rules.
#import "c_string"
#import "byte_text_linux"
#import "file"
#import "file_linux"
#import "vec"
#import, file "legacy_session.zi";

c :: #system_library "c";
LegacyMetaEquals :: (key: *u8, value: *u8) -> s32 #foreign c "meta_equals";
LegacyDbExecText :: (sql: *u8, value: *u8) -> s32 #foreign c "db_exec_text";
LegacyStoragePersist :: () #foreign c "storage_schedule_persist";

// Imports every session file below DIRECTORY, in its subfolders too. False
// when a session file could not be read or imported; a folder that cannot
// be listed holds nothing to import.
LegacyImportTree :: (directory: string, imported: *u32) -> bool {
    cursor := OpenDirectory(directory)
    if !cursor.valid {
        return true
    }
    defer { unused CloseDirectory(*cursor) }
    ok := true
    while true {
        entry := NextDirectoryEntry(*cursor)
        if !entry.valid {
            break
        }
        name := TextFromCString(*entry.name[0])
        if name == "." || name == ".." {
            continue
        }
        joined: Vec(u8)
        BuilderPrint(*joined, "%/%", directory, name)
        path := BuilderFinish(joined)
        // A link or an unknown entry is followed, as stat would.
        folder := entry.kind == .Directory
        if entry.kind == .Link || entry.kind == .Unknown {
            folder = DirectoryExists(path)
        }
        if folder {
            if !LegacyImportTree(path, imported) {
                ok = false
            }
            continue
        }
        c_path: [4096]u8
        if entry.kind == .Other || !CopyCString(path, c_path[:]) || LegacyIsSessionPath(*c_path[0]) == 0 {
            continue
        }
        bytes: Vec(u8)
        if !ReadFileInto(path, *bytes) || bytes.count == 0 {
            ok = false
        } else if LegacyImportBytes(*c_path[0], *bytes[0], cast(u64)bytes.count) == 0 {
            ok = false
        } else {
            imported.* += 1
        }
    }
    return ok
}

#program_export
migrate_legacy_file_sessions_once :: (root: *u8) -> s32 {
    if root == null || root[0] == cast(u8)0 {
        return 0
    }
    marker: [40]u8
    completed: [2]u8
    if !CopyCString("legacy_file_sessions_migrated", marker[:])  || !CopyCString("1", completed[:]) {
        return 0
    }
    if LegacyMetaEquals(*marker[0], *completed[0]) != 0 {
        return 1
    }
    imported: u32 = 0
    ok := LegacyImportTree(TextFromCString(root), *imported)
    if !ok {
        return 0
    }
    // An empty or unreadable scan gets retried at the next startup. Source
    // files remain on disk even after a successful import.
    if imported == 0 {
        return 1
    }
    sql: [128]u8
    if !CopyCString("INSERT INTO meta(key,value) VALUES('legacy_file_sessions_migrated',?1) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
        sql[:]) {
        return 0
    }
    if LegacyDbExecText(*sql[0], *completed[0]) == 0 {
        return 0
    }
    LegacyStoragePersist()
    return 1
}
