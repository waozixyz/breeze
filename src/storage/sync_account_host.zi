// Platform export effects for account files.
c :: #system_library "c";

#if #defined(ANDROID_BUILD) {
    NativeAccountShare :: (data: *u8, length: usize, filename: *u8,
        mime: *u8, title: *u8) -> s32 #foreign c "android_share_bytes";
}

#if #defined(PLATFORM_WEB) {
    NativeAccountDownload :: (path: *u8, filename: *u8,
        mime: *u8) -> s32 #foreign c "web_download_file";
}

#program_export
inbe_account_export_platform :: () -> s32 {
    #if #defined(ANDROID_BUILD) {
        return 1
    }
    #if #defined(PLATFORM_WEB) {
        return 2
    }
    return 0
}

#program_export
inbe_account_share_bytes :: (data: *u8, length: u64, filename: *u8,
    mime: *u8, title: *u8) -> s32 {
    unused data
    unused length
    unused filename
    unused mime
    unused title
    #if #defined(ANDROID_BUILD) {
        if size_of(usize) < 8 && length > 4294967295 {
            return 0
        }
        return NativeAccountShare(data, cast(usize)length,
            filename, mime, title)
    }
    return 0
}

#program_export
inbe_account_download_file :: (path: *u8, filename: *u8,
    mime: *u8) -> s32 {
    unused path
    unused filename
    unused mime
    #if #defined(PLATFORM_WEB) {
        return NativeAccountDownload(path, filename, mime)
    }
    return 0
}

