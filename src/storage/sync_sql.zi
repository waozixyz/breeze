// Sync response queries. Keep conflict and timestamp conditions intact so
// applying a server response preserves newer local edits.

SyncSessionsSQL :: #string SQL
INSERT INTO
sessions(id,user_id,started_at,local_date,topic,activity,source,
imported_at,rounds_hash,mood_before,mood_after,energy,stress,note,tags,details,
deleted_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,

CAST(COALESCE(strftime('%s',json_extract(value,'$.started_at')),'0') AS
INTEGER),
       CAST(COALESCE(json_extract(value,'$.local_date'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.topic'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.activity'),0) AS INTEGER),
       COALESCE(json_extract(value,'$.source'),''),

CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),
strftime('%s',json_extract(value,'$.started_at')),'0') AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.rounds_hash'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.mood_before'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.mood_after'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.energy'),0) AS INTEGER),
       CAST(COALESCE(json_extract(value,'$.stress'),0) AS INTEGER),
       COALESCE(json_extract(value,'$.note'),''),
       COALESCE(json_extract(value,'$.tags'),''),
       CASE WHEN json_type(value,'$.details')='object'
            THEN json_extract(value,'$.details') ELSE '{}' END,
       CAST(COALESCE(json_extract(value,'$.deleted_at'),0) AS INTEGER),

CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),
strftime('%s',json_extract(value,'$.started_at')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.sessions')
      UNION ALL SELECT value FROM json_each(?1,'$.data.sessions'))
WHERE COALESCE(json_extract(value,'$.id'),'')<>''
ON CONFLICT(id) DO UPDATE SET
 user_id=excluded.user_id,started_at=excluded.started_at,local_date=
excluded.local_date,
 topic=excluded.topic,activity=excluded.activity,source=excluded.source,
 imported_at=excluded.imported_at,rounds_hash=excluded.rounds_hash,
 mood_before=excluded.mood_before,mood_after=excluded.mood_after,
 energy=excluded.energy,stress=excluded.stress,note=excluded.note,
 tags=excluded.tags,
 details=CASE WHEN excluded.details<>'{}' THEN excluded.details ELSE sessions.details END,
deleted_at=excluded.deleted_at,
 updated_at=excluded.updated_at
WHERE excluded.updated_at > sessions.updated_at
OR (excluded.updated_at = sessions.updated_at AND NOT EXISTS (
 SELECT 1 FROM sync_outbox
 WHERE entity_type='session' AND entity_id=sessions.id AND local_date=0
))
SQL

SyncSessionRoundDeleteSQL :: #string SQL
DELETE FROM session_rounds WHERE session_id IN (
 SELECT COALESCE(json_extract(value,'$.id'),'')
 FROM (SELECT value FROM json_each(?1,'$.changes.sessions')
       UNION ALL SELECT value FROM json_each(?1,'$.data.sessions'))
 WHERE COALESCE(json_extract(value,'$.id'),'')<>''
 AND (
       NOT EXISTS (SELECT 1 FROM sessions WHERE
id=COALESCE(json_extract(value,'$.id'),''))
       OR
CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),
strftime('%s',json_extract(value,'$.started_at')),'0') AS INTEGER)
          > COALESCE((SELECT updated_at FROM sessions WHERE
id=COALESCE(json_extract(value,'$.id'),'')),0)
       OR
(CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),
strftime('%s',json_extract(value,'$.started_at')),'0') AS INTEGER)
           = COALESCE((SELECT updated_at FROM sessions WHERE
id=COALESCE(json_extract(value,'$.id'),'')),0)
           AND NOT EXISTS (SELECT 1 FROM sync_outbox
               WHERE entity_type='session' AND
entity_id=COALESCE(json_extract(value,'$.id'),'') AND local_date=0))
 )
)
SQL

SyncSessionRoundsSQL :: #string SQL
INSERT OR REPLACE INTO session_rounds(session_id,round_index,seconds)
SELECT COALESCE(json_extract(s.value,'$.id'),''),
       CAST(COALESCE(json_extract(r.value,'$.round_index'),0) AS
INTEGER),
       CAST(COALESCE(json_extract(r.value,'$.hold_seconds'),0) AS
INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.sessions')
      UNION ALL SELECT value FROM json_each(?1,'$.data.sessions')) AS s,
json_each(s.value,'$.rounds') AS r
WHERE COALESCE(json_extract(s.value,'$.id'),'')<>''
AND
(CAST(COALESCE(strftime('%s',json_extract(s.value,'$.updated_at')),
strftime('%s',json_extract(s.value,'$.started_at')),'0') AS INTEGER)
       > COALESCE((SELECT updated_at FROM sessions WHERE
id=COALESCE(json_extract(s.value,'$.id'),'')),0)
OR
(CAST(COALESCE(strftime('%s',json_extract(s.value,'$.updated_at')),
strftime('%s',json_extract(s.value,'$.started_at')),'0') AS INTEGER)
       = COALESCE((SELECT updated_at FROM sessions WHERE
id=COALESCE(json_extract(s.value,'$.id'),'')),0)
    AND NOT EXISTS (SELECT 1 FROM sync_outbox
        WHERE entity_type='session' AND
entity_id=COALESCE(json_extract(s.value,'$.id'),'') AND local_date=0)))
SQL

SyncMeditationLogsSQL :: #string SQL
INSERT INTO
meditation_logs(id,user_id,session_id,duration_seconds,completed_at,updated_at)
SELECT COALESCE(json_extract(value,'$.id'),''),?2,
       COALESCE(json_extract(value,'$.session_id'),''),
       CAST(COALESCE(json_extract(value,'$.duration_seconds'),
                     json_extract(value,'$.duration'),0) AS INTEGER),
       CAST(COALESCE(strftime('%s',json_extract(value,'$.completed_at')),
                     strftime('%s',json_extract(value,'$.timestamp')),'0') AS INTEGER),
       CAST(COALESCE(strftime('%s',json_extract(value,'$.completed_at')),
                     strftime('%s',json_extract(value,'$.timestamp')),'0') AS INTEGER)
FROM (SELECT value FROM json_each(?1,'$.changes.meditation_logs')
      UNION ALL SELECT value FROM json_each(?1,'$.data.meditation_logs'))
WHERE COALESCE(json_extract(value,'$.id'),'')<>''
ON CONFLICT(id) DO UPDATE SET
 user_id=excluded.user_id,session_id=excluded.session_id,
 duration_seconds=excluded.duration_seconds,
 completed_at=excluded.completed_at,updated_at=excluded.updated_at
WHERE excluded.updated_at > meditation_logs.updated_at
SQL

SyncSocialCacheSQL :: #string SQL
INSERT INTO social_snapshots(user_id,kind,json,updated_at)
SELECT ?2,
       COALESCE(json_extract(value,'$.kind'),''),
       json(COALESCE(json_extract(value,'$.json'),'{}')),
       CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM json_each(?1,'$.changes.social_cache')
WHERE COALESCE(json_extract(value,'$.kind'),'')<>''
ON CONFLICT(user_id,kind) DO UPDATE SET
 json=excluded.json,updated_at=excluded.updated_at
SQL

SyncSocialSQL :: #string SQL
INSERT INTO social_snapshots(user_id,kind,json,updated_at)
SELECT ?2,
       COALESCE(json_extract(value,'$.kind'),''),
       json(COALESCE(json_extract(value,'$.json'),'{}')),
       CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM json_each(?1,'$.data.social')
WHERE COALESCE(json_extract(value,'$.kind'),'')<>''
ON CONFLICT(user_id,kind) DO UPDATE SET
 json=excluded.json,updated_at=excluded.updated_at
SQL

// Only app choices sync. Downloaded versions, paths and update policy belong
// to this device; a removal remains a value of zero so it reaches other devices.
SyncAppPreferencesSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(COALESCE(strftime('%s',json_extract(value,'$.updated_at')),'0') AS INTEGER)
FROM json_each(?1,'$.changes.app_preferences')
WHERE json_extract(value,'$.key') IN
 ('app_used_lists','app_used_habits','app_used_practices','app_used_diary','app_used_lumi',
  'app_used_leaderboard')
AND json_extract(value,'$.value') IN ('0','1')
AND strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='app_preference'
 AND entity_id=settings.key AND local_date=0
))
SQL

// A borrowed-coin allowance belongs to the account. Keep pending local edits
// on a timestamp tie, and never let a remote setting write another key.
SyncHabitSettingsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.habit_settings')
WHERE json_extract(value,'$.key')='habit_shop_borrow_limit'
AND json_type(value,'$.value')='text'
AND length(json_extract(value,'$.value')) BETWEEN 1 AND 4
AND json_extract(value,'$.value') NOT GLOB '*[^0-9]*'
AND strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='habit_setting'
 AND entity_id=settings.key AND local_date=0
))
SQL

// The pinned apps' order from another device: the newest order wins, and a
// pending local order wins a tie. The value is a list of package names.
SyncAppOrderSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,'app_order',json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.app_order')
WHERE json_extract(value,'$.key')='app_order'
AND json_type(value,'$.value')='text'
AND length(CAST(json_extract(value,'$.value') AS BLOB))<=255
AND strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='app_order'
 AND entity_id=settings.key AND local_date=0
))
SQL

// Local unacknowledged edits win ties; a remote record never queues itself.
// Installed marks of apps the node offers; the keys were checked first.
SyncAppInstallsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.app_installs')
WHERE json_extract(value,'$.value') IN ('0','1')
AND strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='app_install'
 AND entity_id=settings.key AND local_date=0
))
SQL

// Private records of apps the node offers; the keys were checked first.
SyncAppRecordsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.app_records')
WHERE strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='app_record'
 AND entity_id=settings.key AND local_date=0
))
SQL

// The account's media library; the key was checked first.
SyncMediaRecordsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.media_records')
WHERE strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
AND json_valid(json_extract(value,'$.value'))
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='media_record'
 AND entity_id=settings.key AND local_date=0
))
SQL

// One entity record of the account (storage/entity_records.zi), checked
// first. Fields only this device has stay; a change not sent yet keeps
// this device's record until it goes out.
SyncEntityRecordSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
VALUES(?1,?2,json(?3),COALESCE(CAST(strftime('%s',NULLIF(?4,'')) AS INTEGER),CAST(strftime('%s','now') AS INTEGER)))
ON CONFLICT(user_id,key) DO UPDATE SET
 value=CASE WHEN json_valid(settings.value) THEN json_patch(settings.value,excluded.value) ELSE excluded.value END,
 updated_at=excluded.updated_at
WHERE NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='entity_record'
 AND entity_id=settings.key AND local_date=0
) AND (NOT json_valid(settings.value) OR json_patch(settings.value,excluded.value) != settings.value)
SQL

// A photo of the account's entity data deleted for good from Trash: its
// record stays empty, unless a change here has not gone out yet.
SyncEntityPhotoDeletedSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
VALUES(?1,?2,'',COALESCE(CAST(strftime('%s',NULLIF(?3,'')) AS INTEGER),CAST(strftime('%s','now') AS INTEGER)))
ON CONFLICT(user_id,key) DO UPDATE SET value='',updated_at=excluded.updated_at
WHERE settings.value<>'' AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='entity_record'
 AND entity_id=settings.key AND local_date=0
)
SQL

SyncBundledAppRecordsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.cell_records')
WHERE strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at
WHERE excluded.updated_at > settings.updated_at
OR (excluded.updated_at = settings.updated_at AND excluded.value != settings.value AND NOT EXISTS (
 SELECT 1 FROM sync_outbox WHERE entity_type='cell_record'
 AND entity_id=settings.key AND local_date=0
))
SQL

// Award identity is a grow-only set. A known earlier earning date wins even
// when an offline device uploads later; unknown backfill time never erases it.
SyncAchievementAwardsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.cell_records')
WHERE strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=CASE
 WHEN NOT json_valid(settings.value) THEN excluded.value
 WHEN CAST(json_extract(excluded.value,'$.earned') AS INTEGER)>0 AND
  (CAST(json_extract(settings.value,'$.earned') AS INTEGER)=0 OR
   CAST(json_extract(excluded.value,'$.earned') AS INTEGER)<CAST(json_extract(settings.value,'$.earned') AS INTEGER))
 THEN excluded.value ELSE settings.value END,
 updated_at=MAX(settings.updated_at,excluded.updated_at)
WHERE excluded.updated_at>settings.updated_at OR NOT json_valid(settings.value) OR
 (CAST(json_extract(excluded.value,'$.earned') AS INTEGER)>0 AND
  (CAST(json_extract(settings.value,'$.earned') AS INTEGER)=0 OR
   CAST(json_extract(excluded.value,'$.earned') AS INTEGER)<CAST(json_extract(settings.value,'$.earned') AS INTEGER)))
SQL

// A newer source state may delete or restore a fact, while still retaining
// first-completion dates and native preset provenance learned on another device.
SyncAchievementFactsSQL :: #string SQL
INSERT INTO settings(user_id,key,value,updated_at)
SELECT ?2,json_extract(value,'$.key'),json_extract(value,'$.value'),
 CAST(strftime('%s',json_extract(value,'$.updated_at')) AS INTEGER)
FROM json_each(?1,'$.changes.cell_records')
WHERE strftime('%s',json_extract(value,'$.updated_at')) IS NOT NULL
ON CONFLICT(user_id,key) DO UPDATE SET value=CASE
 WHEN NOT json_valid(settings.value) THEN excluded.value
 WHEN json_extract(settings.value,'$.metric') IN ('list.completed','list.comment')
  AND CAST(json_extract(settings.value,'$.day') AS INTEGER)>0
  AND (CAST(json_extract(excluded.value,'$.day') AS INTEGER)=0 OR
   CAST(json_extract(settings.value,'$.day') AS INTEGER)<CAST(json_extract(excluded.value,'$.day') AS INTEGER))
 THEN json_set(excluded.value,'$.day',json_extract(settings.value,'$.day'),
  '$.civil',json_extract(settings.value,'$.civil'),'$.active',json_extract(settings.value,'$.active'))
 WHEN json_extract(settings.value,'$.metric')='practice.patterns'
  AND length(json_extract(settings.value,'$.variant'))>0 AND json_extract(excluded.value,'$.variant')=''
 THEN json_set(excluded.value,'$.variant',json_extract(settings.value,'$.variant'))
 ELSE excluded.value END,updated_at=excluded.updated_at
WHERE excluded.updated_at>settings.updated_at OR
 (excluded.updated_at=settings.updated_at AND excluded.value!=settings.value AND NOT EXISTS(
  SELECT 1 FROM sync_outbox WHERE entity_type='cell_record' AND entity_id=settings.key AND local_date=0))
SQL
