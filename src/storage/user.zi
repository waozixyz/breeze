#import "c_string"
#import, file "sqlite.zi";

c :: #system_library "c";

UserIdCapacity :: 64
user_db_handle :: () -> *void #foreign c "storage_db_handle";
user_id_buffer :: () -> *u8 #foreign c "storage_user_id_buffer";
user_now_seconds :: () -> s64 #foreign c "now_seconds";
user_rand :: () -> s32 #foreign c "rand";

UserCopyCString :: (source: *u8, output: *u8) -> bool {
    if source == null || output == null {
        return false
    }
    index: s32 = 0
    while index < UserIdCapacity - 1 && source[index] != cast(u8)0 {
        output[index] = source[index]
        index += 1
    }
    output[index] = cast(u8)0
    return index > 0 && source[index] == cast(u8)0
}

UserAppendByte :: (output: *u8, cursor: *s32, byte: u8) -> bool {
    if cursor.* < 0 || cursor.* >= UserIdCapacity - 1 {
        return false
    }
    output[cursor.*] = byte
    cursor.* += 1
    output[cursor.*] = cast(u8)0
    return true
}

UserAppendUnsigned :: (output: *u8, cursor: *s32,
    value: u64) -> bool {
    digits: [20]u8
    count: s32 = 0
    if value == 0 {
        digits[0] = cast(u8)48
        count = 1
    }
    while value > 0 {
        digits[count] = cast(u8)(48 + value % 10)
        count += 1
        value /= 10
    }
    while count > 0 {
        count -= 1
        if !UserAppendByte(output, cursor, digits[count]) {
            return false
        }
    }
    return true
}

UserNewId :: (output: *u8, epoch: s64, random: u32) -> bool {
    if output == null || epoch < 0 {
        return false
    }
    output[0] = cast(u8)0
    cursor: s32 = 0
    prefix := "local-"
    index: s32 = 0
    while index < cast(s32)prefix.count {
        if !UserAppendByte(output, *cursor, prefix[index]) {
            return false
        }
        index += 1
    }
    return UserAppendUnsigned(output, *cursor, cast(u64)epoch)  && UserAppendByte(output, *cursor, cast(u8)45)  && UserAppendUnsigned(output, *cursor, random)
}

#program_export
load_or_create_user :: () -> s32 {
    db := user_db_handle()
    output := user_id_buffer()
    if db == null || output == null {
        return 0
    }
    query: [128]u8
    if !CopyCString("SELECT id FROM users WHERE kind='local' ORDER BY created_at LIMIT 1",
        query[:]) {
        return 0
    }
    statement: *void = null
    if SqlitePrepare(db, *query[0], -1, *statement, null) != 0 {
        return 0
    }
    result := SqliteStep(statement)
    if result == 100 {
        copied := UserCopyCString(SqliteColumnText(statement, 0), output)
        unused SqliteFinalize(statement)
        if copied {
            return 1
        }
        return 0
    }
    unused SqliteFinalize(statement)
    if result != 101 {
        return 0
    }

    epoch := user_now_seconds()
    if !UserNewId(output, epoch, cast(u32)user_rand())  || !CopyCString("INSERT INTO users(id,created_at,kind) VALUES(?1,?2,'local')",
           query[:]) {
        return 0
    }
    statement = null
    if SqlitePrepare(db, *query[0], -1, *statement, null) != 0 {
        return 0
    }
    inserted := false
    if SqliteBindText(statement, 1, output, -1, null) == 0  && SqliteBindInt64(statement, 2, epoch) == 0 {
        inserted = SqliteStep(statement) == 101
    }
    unused SqliteFinalize(statement)
    if inserted {
        return 1
    }
    return 0
}
