c :: #system_library "c";
AsyncAllocate :: (size: usize) -> *void #foreign c "malloc";
AsyncFree :: (pointer: *void) #foreign c "free";
AsyncResponseCapacity :: 16777216;

StoredOperation :: struct {
    account_mode: s32
    delegate_renewal_only: bool
    delegate: DelegateMaterial
    delegate_client: DelegateClient
    delegate_request: PendingDelegate
    delegate_batch: DelegateBatch
    account: AccountKeys
    session: Session
    client: Client
    server: [512]u8
    client_id: [128]u8
    method: [16]u8
    path: [1024]u8
    body: [262144]u8
    request: PendingRequest
    sync: PendingSync
    deletion: PendingDeletion
    material: DeviceKeyMaterial
    payload: *u8
    response: *u8
    active: bool
    is_sync: bool
    is_deletion: bool
    connected_only: bool
    isolated_session: bool
    result: s32
    changed: s32
}

StoredIdentityCurrent :: (operation: *StoredOperation) -> bool {
    if operation == null {
        return false
    }
    if operation.account_mode == AccountModeDelegate {
        if StoredAccountMode() != AccountModeDelegate ||
        operation.delegate.generation != StoredDelegateGeneration() ||
        (operation.delegate_renewal_only && StoredDelegateRenewalMatches(operation.delegate_client) == 0) ||
        (!operation.delegate_renewal_only && StoredDelegateClientMatches(operation.delegate_client) == 0) {
            return false
        }
        if operation.connected_only {
            normalized: [512]u8
            if storage_get_setting_int("sync_enabled", 0) == 0 ||
            !NormalizeUrl(storage_get_setting_text("sync_server_url"), normalized[:]) ||
            TextUntilNul(normalized[:]) != TextUntilNul(operation.server[:]) {
                return false
            }
        }
        return true
    }
    if operation.account_mode != AccountModeOwner || StoredAccountMode() != AccountModeOwner ||
    storage_get_setting_text("sync_public_id") !=
    AccountFieldText(*operation.account.public_id[0], ACCOUNT_PUBLIC_ID_HEX_SIZE) {
        return false
    }
    if operation.connected_only {
        normalized: [512]u8
        if storage_sync_enabled() == 0 ||
        !NormalizeUrl(storage_get_setting_text("sync_server_url"), normalized[:]) ||
        TextUntilNul(normalized[:]) != TextUntilNul(operation.server[:]) {
            return false
        }
    }
    return true
}

ReleaseStoredOperation :: (operation: *StoredOperation) {
    if operation.payload != null {
        storage_free_sync_payload_json(operation.payload)
        operation.payload = null
    }
    if operation.response != null {
        AsyncFree(cast(*void)operation.response)
        operation.response = null
    }
    WipeDelegateMaterial(*operation.delegate)
    WipeDeviceKey(*operation.material)
    SecureWipe(*operation.account.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE)
    operation.active = false
}

CancelStoredOperation :: (operation: *StoredOperation) {
    if operation == null || !operation.active {
        return
    }
    if operation.account_mode == AccountModeDelegate {
        CancelDelegate(*operation.delegate_request)
    } else if operation.is_sync {
        CancelSync(*operation.sync)
    } else if operation.is_deletion {
        CancelDeletion(*operation.deletion)
    } else {
        CancelRequest(*operation.request)
    }
    operation.result = cast(s32)AuthResult.AUTH_REQUEST_FAILED
    ReleaseStoredOperation(operation)
}

PrepareStoredOperation :: (operation: *StoredOperation, server: string,
    connected_only: bool, renewal_only: bool = false) -> bool {
    if operation == null || operation.active {
        return false
    }
    operation.* = StoredOperation.{}
    operation.connected_only = connected_only
    operation.account_mode = StoredAccountMode()
    operation.delegate_renewal_only = renewal_only
    operation.result = cast(s32)AuthResult.AUTH_INVALID_URL
    if !NormalizeUrl(server, operation.server[:]) {
        return false
    }
    operation.result = cast(s32)AuthResult.AUTH_NO_ACCOUNT
    if operation.account_mode == AccountModeDelegate {
        if renewal_only {
            if !LoadDelegateForRenewal(*operation.delegate) ||
            !OpenDelegateRenewalClient(TextUntilNul(operation.server[:]), *operation.delegate,
                *operation.delegate_client) || !StoredIdentityCurrent(operation) {
                ReleaseStoredOperation(operation)
                return false
            }
            // Renewal-only always obtains a fresh server challenge/session;
            // it cannot reuse an old credential to extend identity expiry.
            ClearDelegateSession(*operation.delegate.session)
            operation.active = true
            return true
        }
        if !LoadStoredDelegate(*operation.delegate) ||
        !OpenDelegateClient(TextUntilNul(operation.server[:]), *operation.delegate,
            *operation.delegate_client) || !StoredIdentityCurrent(operation) {
            ReleaseStoredOperation(operation)
            return false
        }
        operation.active = true
        return true
    }
    if sync_account_load(*operation.account) == 0 ||
    !AppCopyText(storage_sync_client_id(), operation.client_id[:]) ||
    !OpenAccountClient(TextUntilNul(operation.server[:]), *operation.account,
        TextUntilNul(operation.client_id[:]), *operation.client) {
        ReleaseStoredOperation(operation)
        return false
    }
    if !StoredIdentityCurrent(operation) {
        ReleaseStoredOperation(operation)
        return false
    }
    LoadSavedSession(*operation.session, Clock.UnixNow())
    operation.active = true
    return true
}

LoadOperationSyncPage :: (context: *void, state: *SyncPageState) -> bool {
    operation := cast(*StoredOperation)context
    return StoredIdentityCurrent(operation) &&
    LoadStoredSyncPage(TextUntilNul(operation.server[:]), state)
}

SaveOperationSyncPage :: (context: *void, state: *SyncPageState) -> bool {
    operation := cast(*StoredOperation)context
    return StoredIdentityCurrent(operation) &&
    SaveStoredSyncPage(TextUntilNul(operation.server[:]), state)
}

PrepareOperationSyncBody :: (context: *void, maximum_records: s32) -> string {
    operation := cast(*StoredOperation)context
    if !StoredIdentityCurrent(operation) {
        return ""
    }
    if operation.payload != null {
        storage_free_sync_payload_json(operation.payload)
    }
    operation.payload = BuildStoredSyncPayload(
        operation.client.identity.account_id, operation.client.identity.public_key, maximum_records)
    return TextFromCString(operation.payload)
}

AcceptOperationSyncPage :: (context: *void, response: string, next: *SyncPageState) -> bool {
    operation := cast(*StoredOperation)context
    if !StoredIdentityCurrent(operation) || ApplyStoredSyncResponse(response, next) == 0 {
        return false
    }
    storage_purge_synced_deleted_data()
    if storage_last_sync_changed() != 0 {
        operation.changed = 1
    }
    SyncNodeStorageRecordResponse(TextUntilNul(operation.server[:]), response)
    return true
}

OperationSyncClock :: (context: *void) -> s64 {
    unused context
    return Clock.UnixNow()
}

BeginStoredSync :: (operation: *StoredOperation, server: string,
    transport: AsyncTransport) -> bool {
    if !PrepareStoredOperation(operation, server, true) {
        return false
    }
    operation.is_sync = true
    if operation.account_mode == AccountModeDelegate {
        operation.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
        operation.payload = BuildDelegateStoragePayload(operation.delegate_client, *operation.delegate_batch)
        operation.response = cast(*u8)AsyncAllocate(AsyncResponseCapacity)
        if operation.payload == null || operation.response == null ||
        !BeginDelegateRequest(*operation.delegate_request, operation.delegate_client,
            *operation.delegate.session, Clock.UnixNow(), transport,
            TextFromCString(operation.payload),
            BytesFromPointer(operation.response, AsyncResponseCapacity)) {
            ReleaseStoredOperation(operation)
            return false
        }
        return true
    }
    operation.result = cast(s32)AuthResult.AUTH_SIGN_FAILED
    if !LoadOrCreateDeviceKey(*operation.material) {
        ReleaseStoredOperation(operation)
        return false
    }
    operation.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    operation.response = cast(*u8)AsyncAllocate(AsyncResponseCapacity)
    if operation.response == null {
        ReleaseStoredOperation(operation)
        return false
    }
    operation.result = cast(s32)AuthResult.AUTH_REQUEST_FAILED
    if !BeginSync(*operation.sync, operation.client, *operation.session,
        DeviceFromKey(*operation.material), Clock.UnixNow(), null, NativeNonce,
        transport, "", BytesFromPointer(operation.response, AsyncResponseCapacity),
        SyncFlow.{.context = cast(*void)operation, .load = LoadOperationSyncPage,
            .prepare = PrepareOperationSyncBody, .save = SaveOperationSyncPage,
            .accept = AcceptOperationSyncPage, .clock = OperationSyncClock}) {
        ReleaseStoredOperation(operation)
        return false
    }
    return true
}

// Strings are copied before returning. Output and transport context must live
// until PollStoredOperation completes or CancelStoredOperation returns.
BeginStoredRequest :: (operation: *StoredOperation, server: string,
    transport: AsyncTransport, method: string, path: string, body: string,
    output: []u8, connected_only: bool, session_override: *Auth.Session = null) -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        if operation != null {
            operation.result = cast(s32)AuthResult.AUTH_NO_ACCOUNT
        }
        return false
    }
    if !PrepareStoredOperation(operation, server, connected_only) {
        return false
    }
    if session_override != null {
        if session_override.token[0] != cast(u8)0 {
            operation.session = session_override.*
        }
        operation.isolated_session = true
    }
    operation.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    if !AppCopyText(method, operation.method[:]) ||
    !AppCopyText(path, operation.path[:]) ||
    !AppCopyText(body, operation.body[:]) {
        ReleaseStoredOperation(operation)
        return false
    }
    headers: [1]HttpHeader
    if !BeginRequest(*operation.request, operation.client, *operation.session,
        Clock.UnixNow(), transport, TextUntilNul(operation.method[:]),
        TextUntilNul(operation.path[:]), TextUntilNul(operation.body[:]),
        output, headers[0:0]) {
        ReleaseStoredOperation(operation)
        return false
    }
    return true
}

BeginStoredDelete :: (operation: *StoredOperation, server: string,
    transport: AsyncTransport) -> bool {
    if StoredAccountMode() == AccountModeDelegate {
        if operation != null {
            operation.result = cast(s32)AuthResult.AUTH_NO_ACCOUNT
        }
        return false
    }
    if !PrepareStoredOperation(operation, server, true) {
        return false
    }
    operation.is_deletion = true
    if !BeginDeletion(*operation.deletion, operation.client, transport) {
        operation.result = cast(s32)operation.deletion.result
        ReleaseStoredOperation(operation)
        return false
    }
    return true
}

BeginStoredSession :: (operation: *StoredOperation, server: string,
    transport: AsyncTransport) -> bool {
    if !PrepareStoredOperation(operation, server, true, true) {
        return false
    }
    if operation.account_mode == AccountModeDelegate {
        operation.response = cast(*u8)AsyncAllocate(AsyncResponseCapacity)
        if operation.response == null ||
        !BeginDelegateSession(*operation.delegate_request, operation.delegate_client,
            *operation.delegate.session, Clock.UnixNow(), transport,
            BytesFromPointer(operation.response, AsyncResponseCapacity)) {
            ReleaseStoredOperation(operation)
            return false
        }
        return true
    }
    if !BeginSession(*operation.request, operation.client, *operation.session,
        Clock.UnixNow(), transport) {
        ReleaseStoredOperation(operation)
        return false
    }
    return true
}

PollStoredOperation :: (operation: *StoredOperation) -> bool {
    if operation == null || !operation.active {
        return true
    }
    current: s32 = 0
    if StoredIdentityCurrent(operation) {
        current = 1
    }
    // A response for a switched account or server is discarded, not applied.
    if ResponseMayApply(current, 1) == 0 {
        CancelStoredOperation(operation)
        return true
    }
    if operation.account_mode == AccountModeDelegate {
        if !PollDelegate(*operation.delegate_request) {
            return false
        }
        operation.result = cast(s32)operation.delegate_request.result
        // A transport callback may switch context while PollDelegate runs.
        if !StoredIdentityCurrent(operation) {
            CancelStoredOperation(operation)
            return true
        }
        if operation.result == cast(s32)AuthResult.AUTH_OK {
            if !SaveStoredDelegateSession(*operation.delegate) {
                operation.result = cast(s32)AuthResult.AUTH_FAILED
            } else if operation.is_sync {
                if ApplyDelegateStorageResponse(operation.delegate_client,
                    *operation.delegate_batch, TextUntilNul(
                    BytesFromPointer(operation.response, AsyncResponseCapacity))) == 0 {
                    operation.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
                } else {
                    operation.changed = storage_last_sync_changed()
                }
            }
        } else if operation.result == cast(s32)AuthResult.AUTH_FAILED {
            ClearDelegate()
        }
        ReleaseStoredOperation(operation)
        return true
    }
    if operation.is_sync {
        if !PollSync(*operation.sync) {
            return false
        }
        operation.result = cast(s32)operation.sync.result
        if !StoredIdentityCurrent(operation) {
            CancelStoredOperation(operation)
            return true
        }
        response := TextUntilNul(BytesFromPointer(operation.response, AsyncResponseCapacity))
        server := TextUntilNul(operation.server[:])
        if operation.sync.status == 413 && SyncNodeStorageRecordFull(server, response) {
            operation.result = cast(s32)SyncResult.SYNC_STORAGE_FULL
        }
    } else if operation.is_deletion {
        if !PollDeletion(*operation.deletion) {
            return false
        }
        operation.result = cast(s32)operation.deletion.result
    } else {
        if !PollRequest(*operation.request) {
            return false
        }
        operation.result = cast(s32)operation.request.result
    }
    // Owner requests can also switch identity inside a transport callback.
    if !StoredIdentityCurrent(operation) {
        CancelStoredOperation(operation)
        return true
    }
    if !operation.is_deletion && !operation.isolated_session {
        SaveSession(*operation.session)
    }
    ReleaseStoredOperation(operation)
    return true
}

// One signed request for a sealed photo copy (cells/diary_blobs.zi) on one
// node, advanced each frame: PUT stores the body at path, GET answers with
// the copy in output. It uses that node's own media session: without one,
// it first signs in to the node and registers this device there; a 401
// opens a new session once.
STORED_BLOB_SIGN_IN :: 1
STORED_BLOB_REGISTER :: 2
STORED_BLOB_TRANSFER :: 3

StoredBlob :: struct {
    active: bool
    stage: s32
    retried: bool
    account: AccountKeys
    client: Client
    session: Session
    material: DeviceKeyMaterial
    pending: PendingRequest
    network: NetworkTransfer
    transfer: HttpTransfer
    registration: [6144]u8
    registration_answer: [2048]u8
    transaction: [8192]u8
    token: [4096]u8
    server: [512]u8
    client_id: [128]u8
    url: [1024]u8
    method: [8]u8
    path: [256]u8
    headers: [1]HttpHeader
    body: string
    output: []u8
    status: s32
    length: s64
    result: s32
}

StoredBlobRelease :: (blob: *StoredBlob) {
    WipeDeviceKey(*blob.material)
    SecureWipe(*blob.account.private_key_hex[0], ACCOUNT_PRIVATE_KEY_HEX_SIZE)
    SecureWipe(*blob.token[0], 4096)
    blob.session = Session.{}
    blob.active = false
}

StoredBlobFinish :: (blob: *StoredBlob, result: s32) {
    blob.result = result
    StoredBlobRelease(blob)
}

// The account may have changed while a request was on its way.
StoredBlobCurrent :: (blob: *StoredBlob) -> bool {
    return StoredAccountMode() == AccountModeOwner && storage_get_setting_text("sync_public_id") ==
    AccountFieldText(*blob.account.public_id[0], ACCOUNT_PUBLIC_ID_HEX_SIZE)
}

StoredBlobSignIn :: (blob: *StoredBlob) -> bool {
    blob.stage = STORED_BLOB_SIGN_IN
    blob.session = Session.{}
    return BeginSession(*blob.pending, blob.client, *blob.session, Clock.UnixNow(),
        NetworkTransport(*blob.network))
}

StoredBlobStartTransfer :: (blob: *StoredBlob) -> bool {
    blob.stage = STORED_BLOB_TRANSFER
    blob.result = cast(s32)AuthResult.AUTH_SIGN_FAILED
    if PrepareRequestHeader(blob.client, *blob.session, DeviceFromKey(*blob.material), Clock.UnixNow(),
        null, NativeNonce, TextUntilNul(blob.method[:]), TextUntilNul(blob.path[:]), blob.body,
        blob.transaction[:]) != cast(AuthResult)AuthResult.AUTH_OK ||
    !AppCopyText(TextUntilNul(blob.session.token[:]), blob.token[:]) {
        return false
    }
    blob.headers[0] = HttpHeader.{.name = "X-Daochi-Tx", .value = TextUntilNul(blob.transaction[:])}
    request := HttpRequest.{.method = TextUntilNul(blob.method[:]), .url = TextUntilNul(blob.url[:]),
        .token = TextUntilNul(blob.token[:]), .body = blob.body, .headers = blob.headers[:]}
    if blob.body.count > 0 {
        request.content_type = "application/octet-stream"
    }
    blob.result = cast(s32)AuthResult.AUTH_REQUEST_FAILED
    // A copy of up to 16 MB needs longer than a sync's request.
    return HttpTransferStart(*blob.transfer, request, blob.output, 180000)
}

// The body and output must stay valid until PollStoredBlob finishes or
// CancelStoredBlob returns.
BeginStoredBlob :: (blob: *StoredBlob, server: string, method: string, path: string,
    body: string, output: []u8) -> bool {
    if blob == null || blob.active {
        return false
    }
    blob.* = StoredBlob.{}
    blob.result = cast(s32)AuthResult.AUTH_NO_ACCOUNT
    if StoredAccountMode() != AccountModeOwner || sync_account_load(*blob.account) == 0 {
        return false
    }
    if !LoadOrCreateDeviceKey(*blob.material) ||
    !AppCopyText(storage_sync_client_id(), blob.client_id[:]) ||
    !NormalizeUrl(server, blob.server[:]) ||
    !OpenAccountClient(TextUntilNul(blob.server[:]), *blob.account, TextUntilNul(blob.client_id[:]),
        *blob.client) ||
    !JoinUrl(TextUntilNul(blob.server[:]), path, blob.url[:]) ||
    !AppCopyText(method, blob.method[:]) || !AppCopyText(path, blob.path[:]) {
        StoredBlobRelease(blob)
        return false
    }
    blob.body = body
    blob.output = output
    blob.active = true
    MediaSessionLoad(TextUntilNul(blob.server[:]), *blob.session, Clock.UnixNow())
    started := false
    if blob.session.token[0] != cast(u8)0 {
        started = StoredBlobStartTransfer(blob)
    } else {
        started = StoredBlobSignIn(blob)
    }
    if !started {
        StoredBlobFinish(blob, blob.result)
        return false
    }
    return true
}

// True once the request has finished; status and length then hold its
// answer, and result is AUTH_OK when one arrived.
PollStoredBlob :: (blob: *StoredBlob) -> bool {
    if blob == null || !blob.active {
        return true
    }
    if !StoredBlobCurrent(blob) {
        CancelStoredBlob(blob)
        return true
    }
    address := TextUntilNul(blob.server[:])
    if blob.stage == STORED_BLOB_SIGN_IN || blob.stage == STORED_BLOB_REGISTER {
        blob.pending.now = Clock.UnixNow()
        if !PollRequest(*blob.pending) {
            return false
        }
        if blob.pending.result != cast(AuthResult)AuthResult.AUTH_OK {
            StoredBlobFinish(blob, cast(s32)blob.pending.result)
            return true
        }
        if blob.stage == STORED_BLOB_SIGN_IN {
            blob.stage = STORED_BLOB_REGISTER
            prepared := PrepareDeviceRegistration(blob.client, *blob.session, DeviceFromKey(*blob.material),
                Clock.UnixNow(), null, NativeNonce, blob.registration[:])
            if prepared != cast(AuthResult)AuthResult.AUTH_OK {
                StoredBlobFinish(blob, cast(s32)prepared)
                return true
            }
            extra: [1]HttpHeader
            if !BeginRequest(*blob.pending, blob.client, *blob.session, Clock.UnixNow(),
                NetworkTransport(*blob.network), "POST", "/api/v1/account/devices",
                TextUntilNul(blob.registration[:]), blob.registration_answer[:], extra[0:0]) {
                StoredBlobFinish(blob, cast(s32)AuthResult.AUTH_REQUEST_FAILED)
            }
            return !blob.active
        }
        MediaSessionSave(address, *blob.session)
        if !StoredBlobStartTransfer(blob) {
            StoredBlobFinish(blob, blob.result)
            return true
        }
        return false
    }
    state := HttpTransferPollLength(*blob.transfer, *blob.status, *blob.length)
    if state < 0 {
        return false
    }
    if state == 1 && blob.status == 401 && !blob.retried {
        // The node no longer knows this session: sign in to it once more.
        blob.retried = true
        MediaSessionForget(address)
        if !StoredBlobSignIn(blob) {
            StoredBlobFinish(blob, cast(s32)AuthResult.AUTH_REQUEST_FAILED)
            return true
        }
        return false
    }
    StoredBlobFinish(blob, ifx (state == 1) then (cast(s32)AuthResult.AUTH_OK) else (cast(s32)AuthResult.AUTH_REQUEST_FAILED))
    return true
}

CancelStoredBlob :: (blob: *StoredBlob) {
    if blob == null || !blob.active {
        return
    }
    if blob.stage == STORED_BLOB_TRANSFER {
        HttpTransferCancel(*blob.transfer)
    } else {
        CancelRequest(*blob.pending)
    }
    StoredBlobFinish(blob, cast(s32)AuthResult.AUTH_REQUEST_FAILED)
}
