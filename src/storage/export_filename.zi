#import, file "storage_layout.zi";

ExportCopyFilename :: (text: string, output: *u8, capacity: s64) -> bool {
    if output == null || capacity <= 0 || text.count >= capacity { return false }
    index: s32 = 0
    while index < cast(s32)text.count {
        output[index] = text[index]
        index += 1
    }
    output[index] = cast(u8)0
    return true
}

// The clock is supplied by the caller so this naming policy is portable.
#program_export
ExportFilenameAt :: (seconds: s64, output: *u8, capacity: s64) {
    if output == null || capacity <= 0 { return }
    output[0] = cast(u8)0
    if seconds <= 0 {
        ExportCopyFilename(ExportFilenameFallback, output, capacity)
        return
    }
    digits: [20]u8
    count: s32 = 0
    value: u64 = cast(u64)seconds
    while value > 0 {
        digits[count] = cast(u8)(48 + value % 10)
        count += 1
        value /= 10
    }
    required: s64 = ExportFilenamePrefix.count + cast(s64)count +         ExportFilenameSuffix.count
    if required >= capacity { return }
    offset: s32 = 0
    while offset < cast(s32)ExportFilenamePrefix.count {
        output[offset] = ExportFilenamePrefix[offset]
        offset += 1
    }
    while count > 0 {
        count -= 1
        output[offset] = digits[count]
        offset += 1
    }
    index: s32 = 0
    while index < cast(s32)ExportFilenameSuffix.count {
        output[offset] = ExportFilenameSuffix[index]
        offset += 1
        index += 1
    }
    output[offset] = cast(u8)0
}
