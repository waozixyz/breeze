// Personal achievement records use their own encrypted owner-only collection.
// Device-local presentation receipts deliberately do not match this namespace.
#import "std/json_scan"
#import "std/text_buffer"
#import "std/byte_text_linux"
#import "std/date_parse"

AchievementCollection :: "private.inbe.v1.achievements"
AchievementAlertsKey :: "notification_achievements"

AchievementNameValid :: (name: string) -> bool {
    if name.count < 1 || name.count > 96 { return false }
    for byte: name {
        if !((byte >= #char "a" && byte <= #char "z") ||
            (byte >= #char "0" && byte <= #char "9") || byte == #char "." || byte == #char "-" || byte == #char "_") {
            return false
        }
    }
    return true
}

AchievementRecordValid :: (key: string) -> bool {
    if key == AchievementAlertsKey { return true }
    if key.count > 23 && key[:23] == "cell.achievement.award." {
        return AchievementNameValid(key[23:])
    }
    return key.count == 86 && key[:22] == "cell.achievement.fact." && AchievementHashValid(key[22:])
}

AchievementHashValid :: (value: string) -> bool {
    if value.count != 64 { return false }
    for byte: value {
        if !((byte >= #char "0" && byte <= #char "9") || (byte >= #char "a" && byte <= #char "f")) {
            return false
        }
    }
    return true
}

AchievementDateValid :: (day: s32) -> bool {
    return day == 0 || (day / 10000 >= 1 && day / 10000 <= 9999 &&
        DateValid(day / 10000, (day / 100) % 100, day % 100))
}

AchievementDayIndex :: (day: s32) -> s64 {
    year := day / 10000
    month := (day / 100) % 100
    date := day % 100
    if year < 1 || year > 9999 || !DateValid(year, month, date) { return -1 }
    return DaysFromCivil(year, month, date)
}

AchievementRecordPayloadValid :: (key: string, value: string) -> bool {
    if key == AchievementAlertsKey { return value == "0" || value == "1" }
    if !AchievementRecordValid(key) || value.count < 2 || value.count > 2048 { return false }
    end := ValueEnd(value, Space(value, 0), 0)
    if end < 0 || Space(value, end) != value.count { return false }
    version := ReadNumber(value, FieldAt(value, 0, "version"))
    if !version.valid || version.value != 1 { return false }
    if key.count > 23 && key[:23] == "cell.achievement.award." {
        earned := ReadNumber(value, FieldAt(value, 0, "earned"))
        day := ReadNumber(value, FieldAt(value, 0, "day"))
        rule := ReadNumber(value, FieldAt(value, 0, "rule"))
        return earned.valid && earned.value >= 0 && earned.value <= 253402300799 &&
        earned.value == cast(float64)cast(s64)earned.value && day.valid &&
        day.value == cast(float64)cast(s32)day.value && AchievementDateValid(cast(s32)day.value) &&
        rule.valid && rule.value == 1
    }
    if key.count <= 22 || key[:22] != "cell.achievement.fact." { return false }
    metric: [97]u8
    subject: [97]u8
    variant: [97]u8
    metric_size := ReadStringText(value, FieldAt(value, 0, "metric"), metric[:])
    subject_size := ReadStringText(value, FieldAt(value, 0, "subject"), subject[:])
    variant_size := ReadStringText(value, FieldAt(value, 0, "variant"), variant[:])
    if metric_size <= 0 || subject_size <= 0 || variant_size < 0 ||
    !AchievementNameValid(TextUntilNul(metric[:])) || !AchievementHashValid(TextUntilNul(subject[:])) ||
    (variant_size > 0 && !AchievementNameValid(TextUntilNul(variant[:]))) {
        return false
    }
    day := ReadNumber(value, FieldAt(value, 0, "day"))
    amount := ReadNumber(value, FieldAt(value, 0, "amount"))
    active := ReadNumber(value, FieldAt(value, 0, "active"))
    deleted := ReadNumber(value, FieldAt(value, 0, "deleted"))
    civil := ReadNumber(value, FieldAt(value, 0, "civil"))
    started := ReadNumber(value, FieldAt(value, 0, "start"))
    ended := ReadNumber(value, FieldAt(value, 0, "end"))
    if !day.valid || !amount.valid || !active.valid || !deleted.valid || !civil.valid ||
    !started.valid || !ended.valid || day.value < 0 || day.value > 99991231 ||
    day.value != cast(float64)cast(s32)day.value || !AchievementDateValid(cast(s32)day.value) ||
    amount.value < 0 || amount.value > 86400000 || amount.value != cast(float64)cast(s64)amount.value ||
    civil.value != cast(float64)(ifx day.value == 0 then cast(s64)0 else AchievementDayIndex(cast(s32)day.value)) ||
    started.value < 0 || ended.value < started.value || ended.value > 253402300799 ||
    started.value != cast(float64)cast(s64)started.value || ended.value != cast(float64)cast(s64)ended.value {
        return false
    }
    if TextUntilNul(metric[:]) == "radio.playback" &&
    (ended.value <= started.value || amount.value != ended.value - started.value) { return false }
    return (active.value == 0 || active.value == 1) && (deleted.value == 0 || deleted.value == 1)
}

AchievementParseDay :: (text: string) -> s32 {
    if text.count < 10 || text[4] != #char "-" || text[7] != #char "-" { return 0 }
    day: s32 = 0
    for index: cast(s32)0..9 {
        if index == 4 || index == 7 { continue }
        byte := text[index]
        if byte < #char "0" || byte > #char "9" { return 0 }
        day = day * 10 + cast(s32)(byte - #char "0")
    }
    if day / 10000 < 1 || !DateValid(day / 10000, (day / 100) % 100, day % 100) { return 0 }
    return day
}
