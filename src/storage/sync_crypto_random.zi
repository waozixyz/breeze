c :: #system_library "c";
OqsRandomBytesRaw :: (output: *u8, length: usize) #foreign c "OQS_randombytes";
OqsCleanseRaw :: (output: *void, length: u64) #foreign c "OQS_MEM_cleanse";

#program_export
SyncCryptoRandom :: (output: *u8, length: s64) -> s32 {
    if length < 0 || (output == null && length > 0) {
        return 0
    }
    if size_of(usize) < 8 && length > 4294967295 {
        return 0
    }
    if length > 0 {
        OqsRandomBytesRaw(output, cast(usize)length)
    }
    return 1
}

#program_export
SyncCryptoWipe :: (output: *u8, length: s64) {
    if output == null || length <= 0 { return }
    OqsCleanseRaw(cast(*void)output, cast(u64)length)
}
