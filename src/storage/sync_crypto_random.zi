#import "byte_text_linux"
#import "oqs/Oqs"

#program_export
SyncCryptoRandom :: (output: *u8, length: s64) -> s32 {
    if length < 0 || (output == null && length > 0) {
        return 0
    }
    if size_of(usize) < 8 && length > 4294967295 {
        return 0
    }
    if length > 0 {
        RandomBytes(BytesFromPointer(output, cast(u64)length))
    }
    return 1
}

#program_export
SyncCryptoWipe :: (output: *u8, length: s64) {
    if output == null || length <= 0 { return }
    Cleanse(BytesFromPointer(output, cast(u64)length))
}
