// Bounded path assembly for persistent Inbe files.
#program_export
storage_join_path :: (output: *u8, capacity: u64,
    root: *u8, name: *u8) -> s32 {
    if output == null || root == null || name == null || capacity < 3 {
        return 0
    }
    root_length: u64 = 0
    while root[root_length] != cast(u8)0 {
        if root_length >= capacity - 2 {
            return 0
        }
        root_length += 1
    }
    if root_length == 0 {
        return 0
    }
    name_length: u64 = 0
    while name[name_length] != cast(u8)0 {
        if name_length >= capacity - root_length - 2 {
            return 0
        }
        name_length += 1
    }
    index: u64 = 0
    while index < root_length {
        output[index] = root[index]
        index += 1
    }
    output[index] = cast(u8)47
    index += 1
    offset: u64 = 0
    while offset < name_length {
        output[index + offset] = name[offset]
        offset += 1
    }
    output[index + name_length] = cast(u8)0
    return 1
}
