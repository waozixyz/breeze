#import, file "habit_merge_model.zi";

// Laws for the habit-day merge, proved for every sequence of three days with
// values 0..2. An implementation edit may not change this file.

// Merging never loses progress from either side.
#law MergeKeepsMine forall a: [3]0..2, b: [3]0..2, day: 0..2 => HabitMergedDay(a, b, day) >= a[day];
#law MergeKeepsTheirs forall a: [3]0..2, b: [3]0..2, day: 0..2 => HabitMergedDay(a, b, day) >= b[day];

// It invents nothing: every merged day equals one side's day.
#law MergeInventsNothing forall a: [3]0..2, b: [3]0..2, day: 0..2 => HabitMergedDay(a, b, day) == a[day] || HabitMergedDay(a, b, day) == b[day];

// Order and repetition do not matter, so retries and either sync order agree.
#law MergeCommutes forall a: [3]0..2, b: [3]0..2, day: 0..2 => HabitMergedDay(a, b, day) == HabitMergedDay(b, a, day);
#law MergeIsIdempotent forall a: [3]0..3, day: 0..2 => HabitMergedDay(a, a, day) == a[day];
#law MergeAssociates forall a: [3]0..2, b: [3]0..2, c: [3]0..2, day: 0..2 => HabitMergedDay3(a, b, c, day) == HabitDayValue(a[day], HabitDayValue(b[day], c[day]));

// A day missing on one side (0) leaves the other side unchanged.
#law MissingDayIsIdentity forall a: [3]0..3, day: 0..2 => HabitDayValue(a[day], 0) == a[day] && HabitDayValue(0, a[day]) == a[day];

#program_export
habit_merge_laws_entry :: () -> s32 {
    return 0
}
