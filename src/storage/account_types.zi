// The sync account's persisted wire sizes. The private key remains owned by
// the account service; application state holds these fixed-length values.
SYNC_PUBLIC_ID_HEX_SIZE :: 65
SYNC_PUBLIC_KEY_HEX_SIZE :: 2625
SYNC_PRIVATE_KEY_HEX_SIZE :: 5121
SYNC_SIGNATURE_HEX_SIZE :: 4841
SYNC_ACCOUNT_EXPORT_TEXT_SIZE :: 8200
SYNC_ACCOUNT_EXPORT_ENCRYPTED_TEXT_SIZE :: 17664
SYNC_ACCOUNT_PASSPHRASE_ITERATIONS :: 600000

SyncAccountSaveResult :: enum {
    SYNC_ACCOUNT_SAVE_FAILED :: 0
    SYNC_ACCOUNT_SAVE_OK :: 1
    SYNC_ACCOUNT_SAVE_NEEDS_CLEAR :: 2
}

SyncAccountLocalDataChoice :: enum {
    SYNC_ACCOUNT_LOCAL_DATA_ASK :: 0
    SYNC_ACCOUNT_LOCAL_DATA_REPLACE :: 1
    SYNC_ACCOUNT_LOCAL_DATA_MERGE :: 2
}

SyncAccount :: struct {
    public_id: [SYNC_PUBLIC_ID_HEX_SIZE] u8
    public_key_hex: [SYNC_PUBLIC_KEY_HEX_SIZE] u8
    private_key_hex: [SYNC_PRIVATE_KEY_HEX_SIZE] u8
}
