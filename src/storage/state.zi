// Shared storage ABI while the remaining storage callers move to Ziran.
// The field order and widths match StorageState in db.h.
#scope_export
StorageState :: struct {
    db: *void
    root: [512]u8
    db_path: [512]u8
    user_id: [64]u8
    last_sync_changed: s32
    materialize_defer: s32
    materialize_needed: s32
    settings_write_depth: s32
    pending_sync_outbox_seq: s64
}

g_storage: StorageState;

#program_export
storage_root_buffer :: () -> *u8 {
    return *g_storage.root[0]
}

#program_export
storage_db_handle :: () -> *void {
    return g_storage.db
}

#program_export
storage_user_id_buffer :: () -> *u8 {
    return *g_storage.user_id[0]
}

#program_export
storage_state_handle :: () -> *StorageState {
    return *g_storage
}

#program_export
storage_state_size :: () -> u64 {
    return size_of(StorageState)
}
