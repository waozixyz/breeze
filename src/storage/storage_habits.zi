// A goal's kind as questions store it, and back; "" is no goal.
storage_goal_kind_name :: (kind: s32) -> string {
    if kind == HABIT_GOAL_AT_LEAST { return "at_least" }
    if kind == HABIT_GOAL_AT_MOST { return "at_most" }
    if kind == HABIT_GOAL_BETWEEN { return "between" }
    if kind == HABIT_GOAL_YES { return "yes" }
    if kind == HABIT_GOAL_NO { return "no" }
    if kind == HABIT_GOAL_ABOVE_AVERAGE { return "above_average" }
    if kind == HABIT_GOAL_BELOW_AVERAGE { return "below_average" }
    return ""
}

storage_goal_kind_from_name :: (name: string) -> s32 {
    if name == "at_least" { return HABIT_GOAL_AT_LEAST }
    if name == "at_most" { return HABIT_GOAL_AT_MOST }
    if name == "between" { return HABIT_GOAL_BETWEEN }
    if name == "yes" { return HABIT_GOAL_YES }
    if name == "no" { return HABIT_GOAL_NO }
    if name == "above_average" { return HABIT_GOAL_ABOVE_AVERAGE }
    if name == "below_average" { return HABIT_GOAL_BELOW_AVERAGE }
    return HABIT_GOAL_NONE
}

storage_json_append_number :: (json: *StorageJsonBuilder, key: string,
    value: s64) {
    number: [24]u8
    unused AppFormatS64(value, number[:])
    storage_json_builder_append_text(json, ",\"")
    storage_json_builder_append_text(json, key)
    storage_json_builder_append_text(json, "\":")
    storage_json_builder_append_text(json, AppTextFromCString(*number[0], 24))
}

// A habit's questions as the JSON array stored and synced with it.
storage_habit_questions_json :: (habit: *Habit, json: *StorageJsonBuilder) {
    storage_json_builder_append_text(json, "[")
    index: s32 = 0
    while index < habit.question_count && index < HABIT_QUESTION_MAX {
        question := *habit.questions[index]
        id_text: [24]u8
        unused AppFormatS64(question.id, id_text[:])
        if index > 0 {
            storage_json_builder_append_text(json, ",")
        }
        storage_json_builder_append_text(json, "{\"id\":")
        storage_json_builder_append_text(json, AppTextFromCString(*id_text[0], 24))
        storage_json_builder_append_text(json, ",")
        storage_json_builder_key_value_text(json, "type",
            HabitAnswerTypeName(question.answer_type))
        storage_json_builder_append_text(json, ",")
        storage_json_builder_key_value_text(json, "text", HabitQuestionText(question))
        if question.goal.kind != HABIT_GOAL_NONE {
            storage_json_builder_append_text(json, ",")
            storage_json_builder_key_value_text(json, "goal",
                storage_goal_kind_name(question.goal.kind))
            storage_json_append_number(json, "low", cast(s64)question.goal.low)
            storage_json_append_number(json, "high", cast(s64)question.goal.high)
        }
        storage_json_builder_append_text(json, "}")
        index += 1
    }
    storage_json_builder_append_text(json, "]")
}

// Reads a habit's questions from their JSON; text that is not a JSON array
// leaves the habit without questions.
storage_habit_questions_read :: (habit: *Habit, questions_json: string) {
    habit.question_count = 0
    if storage_db_handle() == null || questions_json.count == 0 {
        return
    }
    stmt: *void = null
    sql := "SELECT CAST(COALESCE(json_extract(value,'$.id'),0) AS INTEGER),COALESCE(json_extract(value,'$.type'),''),COALESCE(json_extract(value,'$.text'),''),COALESCE(json_extract(value,'$.goal'),''),CAST(COALESCE(json_extract(value,'$.low'),0) AS INTEGER),CAST(COALESCE(json_extract(value,'$.high'),0) AS INTEGER) FROM json_each(CASE WHEN json_valid(?1) AND json_type(?1)='array' THEN ?1 ELSE '[]' END) WHERE json_type(value)='object'"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, questions_json)
    while habit.question_count < HABIT_QUESTION_MAX && SqliteStep(stmt) == SQLITE_ROW {
        question := *habit.questions[habit.question_count]
        question.* = HabitQuestion.{}
        question.id = SqliteColumnInt64(stmt, 0)
        question.answer_type = HabitAnswerTypeFromName(
            AppTextFromCString(SqliteColumnText(stmt, 1), 32))
        copy_sqlite_text(*question.text[0], HABIT_QUESTION_TEXT_SIZE,
            SqliteColumnText(stmt, 2))
        question.goal.kind = storage_goal_kind_from_name(
            AppTextFromCString(SqliteColumnText(stmt, 3), 32))
        question.goal.low = sqlite3_column_int(stmt, 4)
        question.goal.high = sqlite3_column_int(stmt, 5)
        habit.question_count += 1
    }
    SqliteFinalize(stmt)
}

// Answers as the JSON array an entry keeps, leaving out those left empty.
storage_habit_answers_json :: (answers: []HabitAnswer, count: s32,
    json: *StorageJsonBuilder) -> s32 {
    storage_json_builder_append_text(json, "[")
    written: s32 = 0
    index: s32 = 0
    while index < count && index < cast(s32)answers.count {
        answer := *answers[index]
        if HabitAnswerValue(answer).count > 0 {
            id_text: [24]u8
            unused AppFormatS64(answer.id, id_text[:])
            if written > 0 {
                storage_json_builder_append_text(json, ",")
            }
            storage_json_builder_append_text(json, "{\"id\":")
            storage_json_builder_append_text(json, AppTextFromCString(*id_text[0], 24))
            storage_json_builder_append_text(json, ",")
            storage_json_builder_key_value_text(json, "type",
                HabitAnswerTypeName(answer.answer_type))
            storage_json_builder_append_text(json, ",")
            storage_json_builder_key_value_text(json, "question",
                HabitAnswerQuestion(answer))
            storage_json_builder_append_text(json, ",")
            storage_json_builder_key_value_text(json, "value",
                HabitAnswerValue(answer))
            storage_json_builder_append_text(json, "}")
            written += 1
        }
        index += 1
    }
    storage_json_builder_append_text(json, "]")
    return written
}

// Reads an entry's answers from their JSON.
storage_habit_answers_read :: (answers_json: string, output: []HabitAnswer) -> s32 {
    if storage_db_handle() == null || answers_json.count == 0 {
        return 0
    }
    stmt: *void = null
    sql := "SELECT CAST(COALESCE(json_extract(value,'$.id'),0) AS INTEGER),COALESCE(json_extract(value,'$.type'),''),COALESCE(json_extract(value,'$.question'),''),CAST(COALESCE(json_extract(value,'$.value'),'') AS TEXT) FROM json_each(CASE WHEN json_valid(?1) AND json_type(?1)='array' THEN ?1 ELSE '[]' END) WHERE json_type(value)='object'"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, answers_json)
    count: s32 = 0
    while count < cast(s32)output.count && SqliteStep(stmt) == SQLITE_ROW {
        answer := *output[count]
        answer.* = HabitAnswer.{}
        answer.id = SqliteColumnInt64(stmt, 0)
        answer.answer_type = HabitAnswerTypeFromName(
            AppTextFromCString(SqliteColumnText(stmt, 1), 32))
        copy_sqlite_text(*answer.question[0], HABIT_QUESTION_TEXT_SIZE,
            SqliteColumnText(stmt, 2))
        copy_sqlite_text(*answer.value[0], HABIT_ANSWER_SIZE,
            SqliteColumnText(stmt, 3))
        count += 1
    }
    SqliteFinalize(stmt)
    return count
}

// Records an entry of a habit's day, new when its id is empty, and syncs
// it. The id given or made is written to id_out.
storage_habit_entry_save :: (entry_id: string, habit_id: string,
    local_date: s32, started_at: s64, ended_at: s64,
    answers: []HabitAnswer, count: s32, id_out: []u8) -> s32 {
    if storage_db_handle() == null || habit_id.count == 0 || local_date <= 0 {
        return 0
    }
    id: [HABIT_ENTRY_ID_SIZE]u8
    if entry_id.count > 0 {
        if !AppCopyText(entry_id, id[:]) {
            return 0
        }
    } else {
        storage_make_uuid(*id[0])
    }
    json: StorageJsonBuilder
    json.ok = 1
    written := storage_habit_answers_json(answers, count, *json)
    if json.ok == 0 || json.data == null {
        storage_json_builder_free(*json)
        return 0
    }
    answers_text := ifx written > 0 then AppTextFromCString(json.data,
        cast(s32)json.len) else ""
    stmt: *void = null
    sql := "INSERT INTO habit_entries(id,user_id,habit_id,local_date,started_at,ended_at,answers,deleted_at,updated_at) VALUES(?1,?2,?3,?4,?5,?6,?7,0,?8) ON CONFLICT(id) DO UPDATE SET habit_id=excluded.habit_id,local_date=excluded.local_date,started_at=excluded.started_at,ended_at=excluded.ended_at,answers=excluded.answers,deleted_at=0,updated_at=excluded.updated_at"
    ok: s32 = 0
    stored_id := AppTextFromCString(*id[0], HABIT_ENTRY_ID_SIZE)
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, stored_id)
        bind_text(stmt, 2, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 3, habit_id)
        sqlite3_bind_int(stmt, 4, local_date)
        SqliteBindInt64(stmt, 5, started_at)
        SqliteBindInt64(stmt, 6, ended_at)
        bind_text(stmt, 7, answers_text)
        SqliteBindInt64(stmt, 8, storage_next_change_time())
        if SqliteStep(stmt) == SQLITE_DONE {
            ok = 1
        }
        SqliteFinalize(stmt)
    }
    storage_json_builder_free(*json)
    if ok == 0 {
        return 0
    }
    unused storage_enqueue_sync_habit_entry(stored_id)
    AchievementMarkLive("habit.answer")
    AchievementMarkLive("habit.span")
    AchievementMarkLive("habit.completed")
    unused AppCopyText(stored_id, id_out)
    storage_schedule_persist()
    return 1
}

// Marks an entry deleted, so the deletion reaches the other devices too.
storage_habit_entry_delete :: (entry_id: string) -> s32 {
    if storage_db_handle() == null || entry_id.count == 0 {
        return 0
    }
    stmt: *void = null
    sql := "UPDATE habit_entries SET deleted_at=?2,updated_at=?2 WHERE id=?1 AND deleted_at=0"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, entry_id)
    SqliteBindInt64(stmt, 2, storage_next_change_time())
    done := SqliteStep(stmt) == SQLITE_DONE
    SqliteFinalize(stmt)
    if !done {
        return 0
    }
    unused storage_enqueue_sync_habit_entry(entry_id)
    storage_schedule_persist()
    return 1
}

// One entry's start, end and answers; false when it is gone.
storage_habit_entry_load :: (entry_id: string, started_at: *s64,
    ended_at: *s64, answers: []HabitAnswer, count: *s32) -> bool {
    count.* = 0
    if storage_db_handle() == null || entry_id.count == 0 {
        return false
    }
    stmt: *void = null
    sql := "SELECT started_at,ended_at,answers FROM habit_entries WHERE id=?1 AND deleted_at=0"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return false
    }
    bind_text(stmt, 1, entry_id)
    found := false
    if SqliteStep(stmt) == SQLITE_ROW {
        found = true
        started_at.* = SqliteColumnInt64(stmt, 0)
        ended_at.* = SqliteColumnInt64(stmt, 1)
        count.* = storage_habit_answers_read(AppTextFromCString(
            SqliteColumnText(stmt, 2), 2147483647), answers)
    }
    SqliteFinalize(stmt)
    return found
}

// A day's entries in the order they started; the caller writes the lines
// they show.
storage_habit_day_entries :: (habit_id: string, local_date: s32,
    output: []HabitEntrySummary) -> s32 {
    if storage_db_handle() == null || habit_id.count == 0 {
        return 0
    }
    stmt: *void = null
    sql := "SELECT id,started_at,ended_at FROM habit_entries WHERE habit_id=?1 AND local_date=?2 AND deleted_at=0 ORDER BY started_at,id"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, local_date)
    count: s32 = 0
    while count < cast(s32)output.count && SqliteStep(stmt) == SQLITE_ROW {
        entry := *output[count]
        entry.* = HabitEntrySummary.{}
        copy_sqlite_text(*entry.id[0], HABIT_ENTRY_ID_SIZE, SqliteColumnText(stmt, 0))
        entry.started_at = SqliteColumnInt64(stmt, 1)
        entry.ended_at = SqliteColumnInt64(stmt, 2)
        count += 1
    }
    SqliteFinalize(stmt)
    return count
}

// Whether a day of a habit has entries; for a span, ended ones.
storage_habit_day_has_entries :: (habit_id: string, local_date: s32,
    ended_only: bool) -> bool {
    if storage_db_handle() == null || habit_id.count == 0 {
        return false
    }
    stmt: *void = null
    sql := "SELECT EXISTS(SELECT 1 FROM habit_entries WHERE habit_id=?1 AND local_date=?2 AND deleted_at=0 AND (?3=0 OR ended_at>0))"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return false
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, local_date)
    sqlite3_bind_int(stmt, 3, ifx ended_only then 1 else 0)
    found := SqliteStep(stmt) == SQLITE_ROW && sqlite3_column_int(stmt, 0) != 0
    SqliteFinalize(stmt)
    return found
}

// The span of a habit that has started and not ended: its entry, day and
// start, or an empty entry when there is none.
storage_habit_running_span :: (habit: *Habit) {
    habit.running_entry[0] = cast(u8)0
    habit.running_day = 0
    habit.running_since = 0
    if storage_db_handle() == null || habit.span == 0 {
        return
    }
    stmt: *void = null
    sql := "SELECT id,local_date,started_at FROM habit_entries WHERE habit_id=?1 AND ended_at=0 AND deleted_at=0 ORDER BY started_at DESC LIMIT 1"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, AppTextFromCString(*habit.id[0], HABIT_ID_SIZE))
    if SqliteStep(stmt) == SQLITE_ROW {
        copy_sqlite_text(*habit.running_entry[0], HABIT_ENTRY_ID_SIZE,
            SqliteColumnText(stmt, 0))
        habit.running_day = sqlite3_column_int(stmt, 1)
        habit.running_since = SqliteColumnInt64(stmt, 2)
    }
    SqliteFinalize(stmt)
}

// The slot of local_date in days, oldest first, or -1.
storage_day_slot :: (days: []s32, local_date: s32) -> s32 {
    slot: s32 = 0
    while slot < cast(s32)days.count {
        if days[slot] == local_date {
            return slot
        }
        slot += 1
    }
    return -1
}

// Adds up a question's answers in the entries of the given days, oldest
// first.
storage_habit_answer_stats :: (habit_id: string, question: *HabitQuestion,
    days: []s32, stats: *HabitAnswerStats) -> s32 {
    HabitAnswerStatsBegin(stats, question.answer_type, question.goal)
    stats.id = question.id
    if storage_db_handle() == null || habit_id.count == 0 || days.count == 0 {
        return 0
    }
    storage_habit_goal_versions(habit_id, question.id, stats)
    stmt: *void = null
    // The answers before the days, latest first, that the first averages
    // start from.
    earlier := "SELECT value FROM (SELECT CAST(COALESCE(json_extract(a.value,'$.value'),'') AS TEXT) AS value,e.local_date AS day,e.started_at AS at FROM habit_entries e,json_each(CASE WHEN json_valid(e.answers) AND json_type(e.answers)='array' THEN e.answers ELSE '[]' END) a WHERE e.habit_id=?1 AND e.deleted_at=0 AND e.local_date<?2 AND json_type(a.value)='object' AND CAST(COALESCE(json_extract(a.value,'$.id'),0) AS INTEGER)=?3 AND CAST(COALESCE(json_extract(a.value,'$.value'),'') AS TEXT)<>'' ORDER BY e.local_date DESC,e.started_at DESC LIMIT ?4) ORDER BY day,at"
    if HabitGoalIsAverage(question.goal.kind) || stats.version_count > 0 {
        if SqlitePrepareText(storage_db_handle(), earlier, -1, *stmt, null) == SQLITE_OK {
            bind_text(stmt, 1, habit_id)
            sqlite3_bind_int(stmt, 2, days[0])
            SqliteBindInt64(stmt, 3, question.id)
            sqlite3_bind_int(stmt, 4, HABIT_BENCHMARK_COUNT)
            while SqliteStep(stmt) == SQLITE_ROW {
                HabitAnswerStatsAddEarlier(stats, AppTextFromCString(
                    SqliteColumnText(stmt, 0), HABIT_ANSWER_SIZE))
            }
            SqliteFinalize(stmt)
            stmt = null
        }
    }
    sql := "SELECT e.local_date,CAST(COALESCE(json_extract(a.value,'$.value'),'') AS TEXT),e.started_at FROM habit_entries e,json_each(CASE WHEN json_valid(e.answers) AND json_type(e.answers)='array' THEN e.answers ELSE '[]' END) a WHERE e.habit_id=?1 AND e.deleted_at=0 AND e.local_date BETWEEN ?2 AND ?3 AND json_type(a.value)='object' AND CAST(COALESCE(json_extract(a.value,'$.id'),0) AS INTEGER)=?4 ORDER BY e.local_date,e.started_at"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, days[0])
    sqlite3_bind_int(stmt, 3, days[days.count - 1])
    SqliteBindInt64(stmt, 4, question.id)
    while SqliteStep(stmt) == SQLITE_ROW {
        local_date := sqlite3_column_int(stmt, 0)
        HabitAnswerStatsAdd(stats, storage_day_slot(days, local_date), local_date,
            SqliteColumnInt64(stmt, 2),
            AppTextFromCString(SqliteColumnText(stmt, 1), HABIT_ANSWER_SIZE))
    }
    SqliteFinalize(stmt)
    HabitAnswerStatsFinish(stats)
    return 1
}

// Adds up a span habit's ended spans of the given days: their lengths in
// minutes and the local times they started and ended.
storage_habit_span_stats :: (habit: *Habit, days: []s32,
    lengths: *HabitAnswerStats, starts: *HabitAnswerStats,
    ends: *HabitAnswerStats) -> s32 {
    none: HabitGoal
    HabitAnswerStatsBegin(lengths, HABIT_ANSWER_SPAN, habit.span_goal)
    HabitAnswerStatsBegin(starts, HABIT_ANSWER_TIME, none)
    HabitAnswerStatsBegin(ends, HABIT_ANSWER_TIME, none)
    if storage_db_handle() == null || days.count == 0 {
        return 0
    }
    habit_id := AppTextFromCString(*habit.id[0], HABIT_ID_SIZE)
    storage_habit_goal_versions(habit_id, 0, lengths)
    stmt: *void = null
    // The lengths before the days, that the first averages start from.
    if SqlitePrepareText(storage_db_handle(), "SELECT length FROM (SELECT (ended_at-started_at)/60 AS length,local_date AS day,started_at AS at FROM habit_entries WHERE habit_id=?1 AND deleted_at=0 AND ended_at>=started_at AND ended_at>0 AND local_date<?2 ORDER BY local_date DESC,started_at DESC LIMIT ?3) ORDER BY day,at",
        -1, *stmt, null) == SQLITE_OK {
        bind_text(stmt, 1, habit_id)
        sqlite3_bind_int(stmt, 2, days[0])
        sqlite3_bind_int(stmt, 3, HABIT_BENCHMARK_COUNT)
        while SqliteStep(stmt) == SQLITE_ROW {
            HabitAnswerStatsAddEarlierValue(lengths, sqlite3_column_int(stmt, 0))
        }
        SqliteFinalize(stmt)
        stmt = null
    }
    sql := "SELECT local_date,(ended_at-started_at)/60,CAST(strftime('%H',started_at,'unixepoch','localtime') AS INTEGER)*60+CAST(strftime('%M',started_at,'unixepoch','localtime') AS INTEGER),CAST(strftime('%H',ended_at,'unixepoch','localtime') AS INTEGER)*60+CAST(strftime('%M',ended_at,'unixepoch','localtime') AS INTEGER),started_at FROM habit_entries WHERE habit_id=?1 AND deleted_at=0 AND ended_at>=started_at AND ended_at>0 AND local_date BETWEEN ?2 AND ?3 ORDER BY local_date,started_at"
    if SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, days[0])
    sqlite3_bind_int(stmt, 3, days[days.count - 1])
    while SqliteStep(stmt) == SQLITE_ROW {
        slot := storage_day_slot(days, sqlite3_column_int(stmt, 0))
        at := SqliteColumnInt64(stmt, 4)
        HabitAnswerStatsAddValue(lengths, slot, sqlite3_column_int(stmt, 1), at)
        HabitAnswerStatsAddValue(starts, slot, sqlite3_column_int(stmt, 2), at)
        HabitAnswerStatsAddValue(ends, slot, sqlite3_column_int(stmt, 3), at)
    }
    SqliteFinalize(stmt)
    HabitAnswerStatsFinish(lengths)
    HabitAnswerStatsFinish(starts)
    HabitAnswerStatsFinish(ends)
    return 1
}

storage_select_int_with_int64 :: (sql: string, value: s64) -> s64 {
    stmt: *void = null
    result: s64 = -1
    if storage_db_handle() == null ||
    SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return result
    }
    SqliteBindInt64(stmt, 1, value)
    if SqliteStep(stmt) == SQLITE_ROW {
        result = SqliteColumnInt64(stmt, 0)
    }
    SqliteFinalize(stmt)
    return result
}

// A Unix time's local day as YYYYMMDD and its minutes after local midnight.
storage_local_date_of :: (unix_seconds: s64) -> s32 {
    return cast(s32)storage_select_int_with_int64(
        "SELECT CAST(strftime('%Y%m%d',?1,'unixepoch','localtime') AS INTEGER)",
        unix_seconds)
}

storage_local_minutes_of :: (unix_seconds: s64) -> s32 {
    return cast(s32)storage_select_int_with_int64(
        "SELECT CAST(strftime('%H',?1,'unixepoch','localtime') AS INTEGER)*60+CAST(strftime('%M',?1,'unixepoch','localtime') AS INTEGER)",
        unix_seconds)
}

// The Unix time of minutes after local midnight on a local day; minutes
// past a day's end fall on the next day.
storage_unix_at :: (local_date: s32, minutes: s32) -> s64 {
    stmt: *void = null
    result: s64 = 0
    sql := "SELECT CAST(strftime('%s',printf('%04d-%02d-%02d 00:00:00',?1/10000,?1/100%100,?1%100),'+'||?2||' minutes','utc') AS INTEGER)"
    if storage_db_handle() == null ||
    SqlitePrepareText(storage_db_handle(), sql, -1, *stmt, null) != SQLITE_OK {
        return result
    }
    sqlite3_bind_int(stmt, 1, local_date)
    sqlite3_bind_int(stmt, 2, minutes)
    if SqliteStep(stmt) == SQLITE_ROW {
        result = SqliteColumnInt64(stmt, 0)
    }
    SqliteFinalize(stmt)
    return result
}

#program_export
storage_habits_empty :: () -> s32 {
    if storage_habit_count() == 0 { return 1 }
    return 0
}

#program_export
storage_habit_count :: () -> s32 {
    habits_count_sql: [64] u8
    AppCopyText("SELECT COUNT(*) FROM habits WHERE deleted_at=0", habits_count_sql[:])
    return db_select_int(*habits_count_sql[0], 0)
}

#program_export
storage_habit_day_count :: () -> s32 {
    habit_days_sql: [96] u8
    AppCopyText("SELECT COUNT(*) FROM habit_days WHERE completed!=0 OR count>0 OR session_count>0", habit_days_sql[:])
    return db_select_int(*habit_days_sql[0], 0)
}

// Reads a habit's settings from a row selecting id, name, description,
// color_r, color_g, color_b, sync_mode, sync_activity, counter_enabled,
// counter_target, weekdays, reminder_hour, deactivated, icon, schedule,
// questions, span, span_goal, span_low, span_high, difficulty and
// coins_from, in that order.
storage_habit_settings_row :: (habit: *Habit, stmt: *void) {
    copy_sqlite_text(*habit.id[0], HABIT_ID_SIZE, SqliteColumnText(stmt, 0))
    copy_sqlite_text(*habit.name[0], HABIT_NAME_SIZE, SqliteColumnText(stmt, 1))
    copy_sqlite_text(*habit.description[0], HABIT_DESCRIPTION_SIZE,
        SqliteColumnText(stmt, 2))
    habit.color = Color.{cast(u8)sqlite3_column_int(stmt, 3), cast(u8)sqlite3_column_int(stmt, 4), cast(u8)sqlite3_column_int(stmt, 5), 255}
    habit.sync_mode = sqlite3_column_int(stmt, 6)
    habit.sync_activity = sqlite3_column_int(stmt, 7)
    if sqlite3_column_int(stmt, 8) != 0 {
        habit.counter_enabled = 1
    } else {
        habit.counter_enabled = 0
    }
    habit.counter_target = sqlite3_column_int(stmt, 9)
    if habit.counter_target < 0 {
        habit.counter_target = 1
    }
    habit.weekdays = sqlite3_column_int(stmt, 10)
    habit.reminder_hour = sqlite3_column_int(stmt, 11)
    if habit.reminder_hour > 23 {
        habit.reminder_hour = -1
    }
    if sqlite3_column_int(stmt, 12) != 0 {
        habit.deactivated = 1
    } else {
        habit.deactivated = 0
    }
    habit.icon = sqlite3_column_int(stmt, 13)
    HabitScheduleRead(habit, AppTextFromCString(SqliteColumnText(stmt, 14),
        HABIT_SCHEDULE_TEXT_SIZE))
    storage_habit_questions_read(habit,
        AppTextFromCString(SqliteColumnText(stmt, 15), 2147483647))
    habit.span = ifx sqlite3_column_int(stmt, 16) != 0 then 1 else 0
    habit.span_goal = HabitGoal.{}
    if habit.span != 0 && storage_span_goal_valid(sqlite3_column_int(stmt, 17)) {
        habit.span_goal.kind = sqlite3_column_int(stmt, 17)
        habit.span_goal.low = sqlite3_column_int(stmt, 18)
        habit.span_goal.high = sqlite3_column_int(stmt, 19)
    }
    habit.difficulty = HabitDifficultyClamp(sqlite3_column_int(stmt, 20))
    habit.coins_from = sqlite3_column_int(stmt, 21)
    habit.custom_coins = sqlite3_column_int(stmt, 22) != 0
    habit.coin_halves = HabitCoinHalvesClamp(sqlite3_column_int(stmt, 23))
}

// The goals a span habit's lengths take: any of a number's.
storage_span_goal_valid :: (kind: s32) -> bool {
    return kind == HABIT_GOAL_AT_LEAST || kind == HABIT_GOAL_AT_MOST ||
    kind == HABIT_GOAL_BETWEEN || HabitGoalIsAverage(kind)
}

// The settings a habit is stored with, if it is stored and not deleted.
storage_habit_settings_load :: (habit_id: string, habit: *Habit) -> bool {
    habit.* = Habit.{}
    stmt: *void = null
    if storage_db_handle() == null || SqlitePrepareText(storage_db_handle(),
        "SELECT id,name,description,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,weekdays,reminder_hour,deactivated,icon,schedule,questions,span,span_goal,span_low,span_high,difficulty,coins_from,custom_coins,coin_halves FROM habits WHERE id=?1 AND deleted_at=0",
        -1, *stmt, null) != SQLITE_OK {
        return false
    }
    bind_text(stmt, 1, habit_id)
    found := SqliteStep(stmt) == SQLITE_ROW
    if found {
        storage_habit_settings_row(habit, stmt)
    }
    SqliteFinalize(stmt)
    return found
}

#program_export
storage_habits_load :: (habits_ptr: *void) -> s32 {
    habits: *Habits = cast(*Habits)habits_ptr
    stmt: *void = null
    index: s32 = 0
    if habits == null || storage_db_handle() == null {
        return 0
    }
    habits_free(habits)
    habits.* = Habits.{}
    if SqlitePrepareText(storage_db_handle(), "SELECT id,name,description,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,counter_target,weekdays,reminder_hour,deactivated,icon,schedule,questions,span,span_goal,span_low,span_high,difficulty,coins_from,custom_coins,coin_halves FROM habits WHERE deleted_at=0 ORDER BY sort_order,id LIMIT 32",
        -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    while index < HABIT_MAX && SqliteStep(stmt) == SQLITE_ROW {
        habit: *Habit = *habits.items[index]
        storage_habit_settings_row(habit, stmt)
        copy_sqlite_text(*habits.loaded_ids[index][0], HABIT_ID_SIZE,
            *habit.id[0])
        index += 1
    }
    SqliteFinalize(stmt)
    stmt = null
    habits.count = index
    {
        running: s32 = 0
        while running < habits.count {
            storage_habit_running_span(*habits.items[running])
            running += 1
        }
    }
    habits.loaded_count = index
    sql_hb3: [128] u8
    AppCopyText("SELECT local_date,completed,count,session_count FROM habit_days WHERE habit_id=?1 ORDER BY local_date", sql_hb3[:])
    if SqlitePrepare(storage_db_handle(), *sql_hb3[0], -1, *stmt, null) == SQLITE_OK {
        {
            i: s32 = 0
            while i < habits.count {
                sqlite3_reset(stmt)
                sqlite3_clear_bindings(stmt)
                bind_text(stmt, 1, AppTextFromCString(*habits.items[i].id[0], 40))
                while SqliteStep(stmt) == SQLITE_ROW {
                    d: s32 = habits.items[i].day_count
                    if habit_reserve_days(*habits.items[i], habits.items[i].day_count + 1) == 0 {
                        break
                    }
                    habits.items[i].day_count += 1
                    habits.items[i].days[d].day_index = sqlite3_column_int(stmt, 0)
                    habits.items[i].days[d].completed = sqlite3_column_int(stmt, 1)
                    habits.items[i].days[d].count = sqlite3_column_int(stmt, 2)
                    habits.items[i].days[d].session_count = sqlite3_column_int(stmt, 3)
                    if habits.items[i].days[d].count <= 0 && habits.items[i].days[d].completed != 0 &&
                    !(habits.items[i].counter_enabled != 0 && habits.items[i].counter_target == 0) {
                        habits.items[i].days[d].count = 1
                    }
                }
                i += 1
            }
        }
        SqliteFinalize(stmt)
    }
    habits.loaded = 1
    storage_habit_bases_capture(habits)
    if habits.count > 0 {
        return 1
    }
    if meta_equals_buf("habits_initialized", "true") != 0 {
        return 1
    }
    return 0
}

#program_export
storage_habits_initialized :: () -> s32 {
    if storage_db_handle() == null {
        return 0
    }
    if meta_equals_buf("habits_initialized", "true") != 0 {
        return 1
    }
    return 0
}

#program_export
storage_mark_habits_initialized :: () {
    if storage_db_handle() != null {
        set_meta_buf("habits_initialized", "true")
    }
}

// What storage_habits_save compares and records, kept off the stack.
storage_habit_stored: Habit;
storage_habit_merged: Habit;
storage_habit_changes_buffer: [HABIT_CHANGE_MAX]HabitChange;

// Each habit with its days as the habit list was last loaded or saved. A
// save writes only what changed in memory since then: sync may have stored
// newer values underneath, and an unchanged older copy must not replace
// them on this device or, through sync, on the account's other devices.
storage_habit_bases: [HABIT_MAX]Habit;
storage_habit_base_count: s32;
storage_habit_base_owner: *Habits;

storage_habit_bases_capture :: (habits: *Habits) {
    i: s32 = 0
    while i < storage_habit_base_count {
        habit_free_days(*storage_habit_bases[i])
        i += 1
    }
    storage_habit_base_count = 0
    storage_habit_base_owner = habits
    if habits == null {
        return
    }
    i = 0
    while i < habits.count && i < HABIT_MAX {
        base: *Habit = *storage_habit_bases[i]
        source: *Habit = *habits.items[i]
        base.* = source.*
        base.days = null
        base.day_count = 0
        base.day_capacity = 0
        if source.day_count > 0 && habit_reserve_days(base, source.day_count) != 0 {
            d: s32 = 0
            while d < source.day_count {
                base.days[d] = source.days[d]
                d += 1
            }
            base.day_count = source.day_count
        }
        i += 1
    }
    storage_habit_base_count = i
}

storage_habit_deleted :: (habit_id: string) -> bool {
    stmt: *void = null
    if storage_db_handle() == null || SqlitePrepareText(storage_db_handle(),
        "SELECT 1 FROM habits WHERE id=?1 AND deleted_at<>0", -1, *stmt, null) != SQLITE_OK {
        return false
    }
    bind_text(stmt, 1, habit_id)
    deleted := SqliteStep(stmt) == SQLITE_ROW
    SqliteFinalize(stmt)
    return deleted
}

storage_habit_base_for :: (habits: *Habits, id: string) -> *Habit {
    if habits == null || habits != storage_habit_base_owner {
        return null
    }
    i: s32 = 0
    while i < storage_habit_base_count {
        if AppTextFromCString(*storage_habit_bases[i].id[0], HABIT_ID_SIZE) == id {
            return *storage_habit_bases[i]
        }
        i += 1
    }
    return null
}

// A day as habit_days stores it: done when counted or marked, with a count
// of at least one when done.
storage_habit_day_stored_count :: (day: *HabitDay) -> s32 {
    if day.count > 0 {
        return day.count
    }
    return ifx day.completed != 0 then 1 else 0
}

// Whether the base had this day as it is now, so saving it changes nothing
// the person did since the habits were loaded.
storage_habit_day_unchanged :: (base: *Habit, day: *HabitDay) -> bool {
    if base == null {
        return false
    }
    d: s32 = 0
    while d < base.day_count {
        if base.days[d].day_index == day.day_index {
            return storage_habit_day_stored_count(*base.days[d]) ==
            storage_habit_day_stored_count(day)
        }
        d += 1
    }
    return false
}

storage_habit_schedule_text :: (habit: *Habit, output: []u8) -> string {
    return HabitScheduleWrite(habit, output)
}

storage_habit_questions_equal :: (left: *Habit, right: *Habit) -> bool {
    a: StorageJsonBuilder
    b: StorageJsonBuilder
    a.ok = 1
    b.ok = 1
    if left.question_count > 0 {
        storage_habit_questions_json(left, *a)
    }
    if right.question_count > 0 {
        storage_habit_questions_json(right, *b)
    }
    same := a.len == b.len && (a.len == 0 || (a.data != null && b.data != null &&
        AppTextFromCString(a.data, cast(s32)(a.len + 1)) == AppTextFromCString(b.data, cast(s32)(b.len + 1))))
    storage_json_builder_free(*a)
    storage_json_builder_free(*b)
    return same
}

// The stored habit with every setting the person changed in memory since
// the base on top; settings they left alone keep the stored values, which
// sync may have made newer. The result goes back into memory too.
storage_habit_merge :: (local: *Habit, base: *Habit, stored: *Habit) {
    merged: *Habit = *storage_habit_merged
    merged.* = stored.*
    if AppTextFromCString(*local.name[0], HABIT_NAME_SIZE) != AppTextFromCString(*base.name[0], HABIT_NAME_SIZE) {
        merged.name = local.name
    }
    if AppTextFromCString(*local.description[0], HABIT_DESCRIPTION_SIZE) !=
    AppTextFromCString(*base.description[0], HABIT_DESCRIPTION_SIZE) {
        merged.description = local.description
    }
    if local.color.r != base.color.r || local.color.g != base.color.g ||
    local.color.b != base.color.b || local.color.a != base.color.a {
        merged.color = local.color
    }
    if local.sync_mode != base.sync_mode { merged.sync_mode = local.sync_mode }
    if local.sync_activity != base.sync_activity { merged.sync_activity = local.sync_activity }
    if local.counter_enabled != base.counter_enabled { merged.counter_enabled = local.counter_enabled }
    if local.counter_target != base.counter_target { merged.counter_target = local.counter_target }
    if local.weekdays != base.weekdays { merged.weekdays = local.weekdays }
    if local.reminder_hour != base.reminder_hour { merged.reminder_hour = local.reminder_hour }
    if local.deactivated != base.deactivated { merged.deactivated = local.deactivated }
    if local.icon != base.icon { merged.icon = local.icon }
    if local.difficulty != base.difficulty { merged.difficulty = local.difficulty }
    if local.custom_coins != base.custom_coins || local.coin_halves != base.coin_halves {
        merged.custom_coins = local.custom_coins
        merged.coin_halves = local.coin_halves
    }
    local_schedule: [HABIT_SCHEDULE_TEXT_SIZE]u8
    base_schedule: [HABIT_SCHEDULE_TEXT_SIZE]u8
    if storage_habit_schedule_text(local, local_schedule[:]) != storage_habit_schedule_text(base, base_schedule[:]) {
        merged.schedules = local.schedules
        merged.schedule_count = local.schedule_count
    }
    if !storage_habit_questions_equal(local, base) {
        merged.questions = local.questions
        merged.question_count = local.question_count
    }
    if local.span != base.span || local.span_goal.kind != base.span_goal.kind ||
    local.span_goal.low != base.span_goal.low || local.span_goal.high != base.span_goal.high {
        merged.span = local.span
        merged.span_goal = local.span_goal
    }
    // Days and the running span belong to the list in memory.
    merged.days = local.days
    merged.day_count = local.day_count
    merged.day_capacity = local.day_capacity
    merged.running_entry = local.running_entry
    merged.running_day = local.running_day
    merged.running_since = local.running_since
    local.* = merged.*
}

// Records changes of a habit's settings made at a time; each syncs.
storage_habit_changes_record :: (habit_id: string, at: s64,
    changes: []HabitChange, count: s32) {
    stmt: *void = null
    if count <= 0 || storage_db_handle() == null || SqlitePrepareText(
        storage_db_handle(), "INSERT OR IGNORE INTO habit_changes(id,user_id,habit_id,changed_at,kind,question,question_text,old_value,new_value,deleted_at,updated_at) VALUES(?1,?2,?3,?4,?5,?6,?7,?8,?9,0,?4)",
        -1, *stmt, null) != SQLITE_OK {
        return
    }
    index: s32 = 0
    while index < count && index < cast(s32)changes.count {
        change := *changes[index]
        id: [64]u8
        storage_make_uuid(*id[0])
        sqlite3_reset(stmt)
        sqlite3_clear_bindings(stmt)
        bind_text(stmt, 1, AppTextFromCString(*id[0], 64))
        bind_text(stmt, 2, AppTextFromCString(storage_user_id_buffer(), 64))
        bind_text(stmt, 3, habit_id)
        SqliteBindInt64(stmt, 4, at)
        sqlite3_bind_int(stmt, 5, change.kind)
        SqliteBindInt64(stmt, 6, change.question)
        bind_text(stmt, 7, AppTextFromCString(*change.question_text[0],
            HABIT_QUESTION_TEXT_SIZE))
        bind_text(stmt, 8, AppTextFromCString(*change.before[0],
            HABIT_CHANGE_VALUE_SIZE))
        bind_text(stmt, 9, AppTextFromCString(*change.after[0],
            HABIT_CHANGE_VALUE_SIZE))
        if SqliteStep(stmt) == SQLITE_DONE {
            unused storage_enqueue_sync_habit_change(AppTextFromCString(*id[0], 64))
        }
        index += 1
    }
    SqliteFinalize(stmt)
}

// Dates a habit's changes made after `after` to `at`, as when a screenshot
// scene seeds settings that held for weeks.
storage_habit_changes_backdate :: (habit_id: string, after: s64, at: s64) {
    stmt: *void = null
    if storage_db_handle() == null || SqlitePrepareText(storage_db_handle(),
        "UPDATE habit_changes SET changed_at=?3,updated_at=?3 WHERE habit_id=?1 AND changed_at>?2",
        -1, *stmt, null) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, habit_id)
    SqliteBindInt64(stmt, 2, after)
    SqliteBindInt64(stmt, 3, at)
    unused SqliteStep(stmt)
    SqliteFinalize(stmt)
}

// A habit's latest changes, newest first.
storage_habit_changes_load :: (habit_id: string,
    output: []HabitChangeRecord) -> s32 {
    stmt: *void = null
    count: s32 = 0
    if storage_db_handle() == null || habit_id.count == 0 || SqlitePrepareText(
        storage_db_handle(), "SELECT changed_at,kind,question,question_text,old_value,new_value FROM habit_changes WHERE habit_id=?1 AND deleted_at=0 ORDER BY changed_at DESC,rowid DESC LIMIT ?2",
        -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, cast(s32)output.count)
    while count < cast(s32)output.count && SqliteStep(stmt) == SQLITE_ROW {
        record := *output[count]
        record.* = HabitChangeRecord.{}
        record.at = SqliteColumnInt64(stmt, 0)
        record.change.kind = sqlite3_column_int(stmt, 1)
        record.change.question = SqliteColumnInt64(stmt, 2)
        copy_sqlite_text(*record.change.question_text[0], HABIT_QUESTION_TEXT_SIZE,
            SqliteColumnText(stmt, 3))
        copy_sqlite_text(*record.change.before[0], HABIT_CHANGE_VALUE_SIZE,
            SqliteColumnText(stmt, 4))
        copy_sqlite_text(*record.change.after[0], HABIT_CHANGE_VALUE_SIZE,
            SqliteColumnText(stmt, 5))
        count += 1
    }
    SqliteFinalize(stmt)
    return count
}

// The goal changes of a habit's question, or of its spans when question
// is 0, oldest first, for statistics to judge each value by its goal.
storage_habit_goal_versions :: (habit_id: string, question: s64,
    stats: *HabitAnswerStats) {
    stmt: *void = null
    if storage_db_handle() == null || SqlitePrepareText(storage_db_handle(),
        "SELECT changed_at,old_value,new_value FROM habit_changes WHERE habit_id=?1 AND deleted_at=0 AND kind=?2 AND question=?3 ORDER BY changed_at,rowid",
        -1, *stmt, null) != SQLITE_OK {
        return
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, ifx question == 0 then HABIT_CHANGE_SPAN_GOAL
        else HABIT_CHANGE_QUESTION_GOAL)
    SqliteBindInt64(stmt, 3, question)
    while SqliteStep(stmt) == SQLITE_ROW {
        HabitAnswerStatsAddVersion(stats, SqliteColumnInt64(stmt, 0),
            HabitGoalFromText(AppTextFromCString(SqliteColumnText(stmt, 1),
            HABIT_CHANGE_VALUE_SIZE)), HabitGoalFromText(AppTextFromCString(
            SqliteColumnText(stmt, 2), HABIT_CHANGE_VALUE_SIZE)))
    }
    SqliteFinalize(stmt)
}

#program_export
storage_habits_save :: (habits_ptr: *void) {
    habits: *Habits = cast(*Habits)habits_ptr
    stmt: *void = null
    loaded_stmt: *void = null
    habit_stmt: *void = null
    desc_stmt: *void = null
    seen_stmt: *void = null
    day_stmt: *void = null
    changed_at: s64 = storage_next_change_time()
    if habits == null || storage_db_handle() == null {
        return
    }
    storage_mark_habits_initialized()
    exec_sql("BEGIN IMMEDIATE")
    exec_sql("CREATE TEMP TABLE IF NOT EXISTS sync_seen_habits(id TEXT PRIMARY KEY);CREATE TEMP TABLE IF NOT EXISTS sync_loaded_habits(id TEXT PRIMARY KEY);DELETE FROM sync_seen_habits;DELETE FROM sync_loaded_habits;")
    sql_hbp1: [64] u8
    AppCopyText("INSERT OR IGNORE INTO sync_loaded_habits(id) VALUES(?1)", sql_hbp1[:])
    SqlitePrepare(storage_db_handle(), *sql_hbp1[0], -1, *loaded_stmt, null)
    sql_hbq1: [2400] u8
