STORAGE_ID_SIZE :: 64
storage_next_change_time :: () -> s64 #foreign c "storage_next_change_time";
sqlite3_column_int :: (statement: *void, column: s32) -> s32 #foreign c "sqlite3_column_int";
sqlite3_reset :: (statement: *void) -> s32 #foreign c "sqlite3_reset";
sqlite3_bind_int :: (statement: *void, index: s32, value: s32) -> s32 #foreign c "sqlite3_bind_int";
sqlite3_changes :: (database: *void) -> s32 #foreign c "sqlite3_changes";
sqlite3_clear_bindings :: (statement: *void) -> s32 #foreign c "sqlite3_clear_bindings";

copy_sqlite_text :: (destination: *u8, capacity: s32, value: *u8) {
    if destination == null || capacity <= 0 {
        return
    }
    index: s32 = 0
    if value != null {
        while index + 1 < capacity && value[index] != 0 {
            destination[index] = value[index]
            index += 1
        }
    }
    destination[index] = 0
}
set_meta_buf :: (key: string, value: string) {
    key_buf: [64] u8
    value_buf: [64] u8
    AppCopyText(key, key_buf[:])
    AppCopyText(value, value_buf[:])
    set_meta(*key_buf[0], *value_buf[0])
}

meta_equals_buf :: (key: string, value: string) -> s32 {
    key_buf: [64] u8
    value_buf: [64] u8
    AppCopyText(key, key_buf[:])
    AppCopyText(value, value_buf[:])
    return meta_equals(*key_buf[0], *value_buf[0])
}
