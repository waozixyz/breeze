#program_export
storage_habit_day_save :: (habit_id: string, local_date: s32, completed: s32, count: s32) -> s32 {
    stmt: *void = null
    changed_at: s64
    rc: s32
    changed: s32
    if storage_db_handle() == null || habit_id.count == 0 || local_date <= 0 {
        return 0
    }
    if count < 0 {
        count = 0
    }
    if count > 0 {
        completed = 1
    }
    changed_at = storage_next_change_time()
    storage_mark_habits_initialized()
    sql_hb2: [369] u8
    AppCopyText("INSERT INTO habit_days(habit_id,local_date,completed,count,session_count,updated_at) VALUES(?1,?2,?3,?4,0,?5) ON CONFLICT(habit_id,local_date) DO UPDATE SET completed=excluded.completed,count=excluded.count,updated_at=CASE WHEN habit_days.completed<>excluded.completed OR habit_days.count<>excluded.count THEN excluded.updated_at ELSE habit_days.updated_at END", sql_hb2[:])
    if SqlitePrepare(storage_db_handle(), *sql_hb2[0], -1, *stmt, null) != SQLITE_OK {
        return 0
    }
    bind_text(stmt, 1, habit_id)
    sqlite3_bind_int(stmt, 2, local_date)
    sqlite3_bind_int(stmt, 3, ifx (completed != 0) then (1) else (0))
    sqlite3_bind_int(stmt, 4, count)
    SqliteBindInt64(stmt, 5, changed_at)
    rc = SqliteStep(stmt)
    changed = 0
    if sqlite3_changes(storage_db_handle()) > 0 {
        changed = 1
    }
    SqliteFinalize(stmt)
    if rc != SQLITE_DONE {
        return 0
    }
    if changed != 0 {
        storage_enqueue_sync_habit_day(habit_id, local_date)
        AchievementMarkLive("habit.completed")
        AchievementMarkLive("habit.counter")
        AchievementMarkLive("habit.scheduled")
    }
    storage_schedule_persist()
    return 1
}
