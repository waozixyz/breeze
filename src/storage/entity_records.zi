// Names of the account's entity data (Daochi docs/entity-data.md): what the
// account owns, kept once for the account and shared by every app it uses,
// whichever app added it. This version keeps photos, game progress and level
// collections. Each photo is
// one record, entity.photos.<sha256> on this device, that syncs as record
// <sha256> of private.entity.v1.photos in the account's own signed sync,
// sealed with the account's entity key for photos (entity_record_crypto.zi).
// Its bytes travel as sealed chunks (apps/diary_blobs.zi). Everything is
// private: nothing here is shared without a separate, explicit step.
#import, file "media_records.zi";
Progress :: #import "entity/game_progress";
ProgressID :: #import "entity/game_progress_id";
#import "std/text_buffer"
#import "std/vec"

EntityPhotosCollection :: "private.entity.v1.photos"
ENTITY_PHOTOS_KIND :: "photos"
ENTITY_PHOTO_SCHEMA :: "entity.photo.v1"
ENTITY_PHOTO_PREFIX :: "entity.photos."
// The record of a photo on this device: the prefix and 64 hex digits.
ENTITY_PHOTO_KEY_BYTES :: 78
EntityGameProgressCollection :: "private.entity.v1.game-progress"
ENTITY_GAME_PROGRESS_PREFIX :: "entity.game-progress."
EntityLevelsCollection :: "private.entity.v1.levels"
ENTITY_LEVELS_PREFIX :: "entity.levels."
ENTITY_LEVELS_SCHEMA :: "entity.levels.v1"
ENTITY_LEVELS_DOCUMENT_MAX :: 143360

EntityLevelKeyAccepted :: (key: string) -> bool {
    return key.count == ENTITY_LEVELS_PREFIX.count + 32 &&
    key[:ENTITY_LEVELS_PREFIX.count] == ENTITY_LEVELS_PREFIX &&
    EntityProgressIDValid(key[ENTITY_LEVELS_PREFIX.count:])
}

EntityProgressIDValid :: (id: string) -> bool {
    if id.count != 32 { return false }
    for byte: id {
        if !((byte >= #char "0" && byte <= #char "9") || (byte >= #char "a" && byte <= #char "f")) { return false }
    }
    return true
}

EntityRecordID :: (key: string) -> string {
    if EntityPhotoKeyAccepted(key) { return EntityPhotoKeyHash(key) }
    if EntityLevelKeyAccepted(key) { return key[ENTITY_LEVELS_PREFIX.count:] }
    prefix := ENTITY_GAME_PROGRESS_PREFIX
    if key.count > prefix.count && key[:prefix.count] == prefix && EntityProgressIDValid(key[prefix.count:]) {
        return key[prefix.count:]
    }
    return ""
}

EntityRecordKeyAccepted :: (key: string) -> bool { return EntityRecordID(key) != "" }

EntityGameProgressValid :: (id: string, text: string) -> bool {
    value: Progress.GameProgressRecord
    canonical: [33]u8
    return Progress.GameProgressRead(text, *value) &&
    ProgressID.GameProgressID(TextUntilNul(value.game[:]), canonical[:]) && TextUntilNul(canonical[:]) == id
}

EntityGameProgressMerge :: (current: string, incoming: string) -> string {
    right: Progress.GameProgressRecord
    if !Progress.GameProgressRead(incoming, *right) { return "" }
    left: Progress.GameProgressRecord
    if Progress.GameProgressRead(current, *left) {
        if !Progress.GameProgressMerge(*left, *right) { return "" }
    } else { left = right }
    out: Vec(u8)
    Progress.GameProgressWrite(*left, *out)
    return BuilderFinish(out)
}

// entity.photos.<sha256>, the key of one photo's record on this device.
EntityPhotoKeyAccepted :: (key: string) -> bool {
    return EntityPhotoKeyHash(key).count == 64
}

// The photo's hash in entity.photos.<sha256>, or empty.
EntityPhotoKeyHash :: (key: string) -> string {
    prefix := ENTITY_PHOTO_PREFIX
    if key.count != ENTITY_PHOTO_KEY_BYTES || key[:prefix.count] != prefix ||
    !MediaHashValid(key[prefix.count:]) {
        return ""
    }
    return key[prefix.count:]
}

// The collection a local entity record syncs in, or empty.
EntityRecordCollection :: (key: string) -> string {
    if EntityPhotoKeyAccepted(key) {
        return EntityPhotosCollection
    }
    if EntityLevelKeyAccepted(key) { return EntityLevelsCollection }
    if EntityRecordID(key) != "" { return EntityGameProgressCollection }
    return ""
}

// Entity collections this version reads. Unknown kinds arrive in the same
// replies and are left alone.
EntityCollectionKnown :: (collection: string) -> bool {
    return collection == EntityPhotosCollection || collection == EntityGameProgressCollection ||
    collection == EntityLevelsCollection
}

EntityCollectionKind :: (collection: string) -> string {
    if collection == EntityPhotosCollection {
        return ENTITY_PHOTOS_KIND
    }
    if collection == EntityGameProgressCollection { return Progress.GAME_PROGRESS_KIND }
    if collection == EntityLevelsCollection { return "levels" }
    return ""
}

EntityCollectionSchema :: (collection: string) -> string {
    if collection == EntityPhotosCollection {
        return ENTITY_PHOTO_SCHEMA
    }
    if collection == EntityGameProgressCollection { return Progress.GAME_PROGRESS_SCHEMA }
    if collection == EntityLevelsCollection { return ENTITY_LEVELS_SCHEMA }
    return ""
}
