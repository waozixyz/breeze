c :: #system_library "c";
malloc :: (size: usize) -> *void #foreign c;
free :: (pointer: *void) #foreign c;
time :: (out: *s64) -> s64 #foreign c;

SyncResponseCapacity :: 16777216;
SocialSend :: 1;
SocialAccept :: 2;
SocialDecline :: 3;
SocialRemove :: 4;
SocialRequests :: 5;
SocialFriends :: 6;
SocialStats :: 7;
SocialAlias :: 8;

#scope_export
// The server greets every live-update connection with its current version.
// That greeting, or any event at or below the newest version this device has
// already received, is not news: treating it as a change made each sync
// reconnect and sync again every few seconds.
REMOTE_EVENT_CURRENT :: -1

#program_export
WaitStoredRemoteEvent :: (base_url: string) -> s32 {
    if StoredAccountMode() == AccountModeDelegate {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    account: SyncAccount
    if sync_account_load(*account) == 0 {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client: Client
    if !OpenAccountClient(base_url, *account,
        storage_sync_client_id(), *client) {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client.send = SendNative
    now := time(null)
    session: Session
    LoadSavedSession(*session, now)
    event: RemoteEvent
    result := WaitForEvent(client, *session, now, null,
        ReceiveWebSocketCurl, *event)
    SaveSession(*session)
    known := storage_meta_int64("sync_last_server_version", 0)
    seen := storage_meta_int64(STORAGE_SYNC_SEEN_SERVER_VERSION_KEY, 0)
    if seen > known { known = seen }
    if result == cast(AuthResult)AuthResult.AUTH_OK && event.server_version <= known {
        return REMOTE_EVENT_CURRENT
    }
    return cast(s32)result
}

#scope_export
#program_export
SyncStoredAccount :: (base_url: string) -> s32 {
    if base_url.count == 0 { return cast(s32)AuthResult.AUTH_INVALID_URL }
    if StoredAccountMode() == AccountModeDelegate {
        return SyncStoredDelegate(base_url)
    }
    account: SyncAccount
    if sync_account_load(*account) == 0 {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    material: DeviceKeyMaterial
    if !LoadOrCreateDeviceKey(*material) {
        return cast(s32)AuthResult.AUTH_SIGN_FAILED
    }
    client_id := storage_sync_client_id()
    account_id := AccountField(*account.public_id[0],
        SYNC_PUBLIC_ID_HEX_SIZE)
    public_key := AccountField(*account.public_key_hex[0],
        SYNC_PUBLIC_KEY_HEX_SIZE)
    payload := storage_build_sync_payload_json(account_id, public_key)
    if payload == null {
        WipeDeviceKey(*material)
        return cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    }
    response := cast(*u8)malloc(SyncResponseCapacity)
    if response == null {
        storage_free_sync_payload_json(payload)
        WipeDeviceKey(*material)
        return cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    }
    now := time(null)
    session: Session
    LoadSavedSession(*session, now)
    status: s32 = 0
    result := SyncAccountPayload(base_url, *account, client_id,
        *session, DeviceFromKey(*material), now,
        TextFromCString(payload),
        BytesFromPointer(response, SyncResponseCapacity), *status)
    SaveSession(*session)
    storage_free_sync_payload_json(payload)
    WipeDeviceKey(*material)
    if result == cast(AuthResult)AuthResult.AUTH_OK {
        if storage_apply_sync_response_json(TextUntilNul(
            BytesFromPointer(response, SyncResponseCapacity))) == 0 {
            result = cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
        } else {
            storage_purge_synced_deleted_data()
        }
    }
    free(cast(*void)response)
    return cast(s32)result
}

// Expired context can perform only this key-bound challenge/session exchange.
// Data payload construction remains unavailable until the answer is accepted.
RenewStoredDelegateNative :: (base_url: string) -> AuthResult {
    material: DelegateMaterial
    defer { WipeDelegateMaterial(*material) }
    client: DelegateClient
    if storage_get_setting_int("sync_enabled", 0) == 0 ||
        !LoadDelegateForRenewal(*material) ||
        !OpenDelegateRenewalClient(base_url, *material, *client) {
        return cast(AuthResult)AuthResult.AUTH_NO_ACCOUNT
    }
    client.send = SendNative
    response := cast(*u8)malloc(32768)
    if response == null {
        return cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    }
    defer { free(cast(*void)response) }
    result := RenewDelegateSession(client, *material.session, time(null), BytesFromPointer(response, 32768))
    if result == cast(AuthResult)AuthResult.AUTH_OK {
        if !SaveStoredDelegateSession(*material) {
            return cast(AuthResult)AuthResult.AUTH_FAILED
        }
    } else if result == cast(AuthResult)AuthResult.AUTH_FAILED &&
        material.generation == StoredDelegateGeneration() {
        ClearDelegate()
    }
    return result
}

SyncStoredDelegate :: (base_url: string) -> s32 {
    material: DelegateMaterial
    defer { WipeDelegateMaterial(*material) }
    client: DelegateClient
    if !LoadStoredDelegate(*material) {
        refreshed := RenewStoredDelegateNative(base_url)
        if refreshed != cast(AuthResult)AuthResult.AUTH_OK {
            return cast(s32)refreshed
        }
    }
    if !LoadStoredDelegate(*material) || !OpenDelegateClient(base_url, *material, *client) {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client.send = SendNative
    batch: DelegateBatch
    payload := BuildDelegateStoragePayload(client, *batch)
    if payload == null {
        return cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    }
    defer { storage_free_sync_payload_json(payload) }
    response := cast(*u8)malloc(SyncResponseCapacity)
    if response == null {
        return cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    }
    defer { free(cast(*void)response) }
    result: AuthResult = cast(AuthResult)AuthResult.AUTH_OK
    if !SessionValid(client, *material.session, time(null)) {
        result = RenewDelegateSession(client, *material.session, time(null),
            BytesFromPointer(response, SyncResponseCapacity))
    }
    if result == cast(AuthResult)AuthResult.AUTH_OK {
        status: s32
        result = DelegateRequest(client, *material.session, time(null),
            TextFromCString(payload), BytesFromPointer(response, SyncResponseCapacity), *status)
    }
    if material.generation != StoredDelegateGeneration() || StoredDelegateClientMatches(client) == 0 ||
        storage_sync_enabled() == 0 || storage_get_setting_text("sync_server_url") != base_url {
        return cast(s32)AuthResult.AUTH_REQUEST_FAILED
    }
    if result == cast(AuthResult)AuthResult.AUTH_OK {
        if !SaveStoredDelegateSession(*material) ||
            ApplyDelegateStorageResponse(client, *batch,
                TextUntilNul(BytesFromPointer(response, SyncResponseCapacity))) == 0 {
            result = cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
        }
    } else if result == cast(AuthResult)AuthResult.AUTH_FAILED {
        ClearDelegate()
    }
    return cast(s32)result
}

SocialOperation :: (base_url: string, operation: s32,
    value: string, metric: string, output: []u8) -> s32 {
    account: SyncAccount
    if sync_account_load(*account) == 0 {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client: Client
    if !OpenAccountClient(base_url, *account,
        storage_sync_client_id(), *client) {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client.send = SendNative
    now := time(null)
    session: Session
    LoadSavedSession(*session, now)
    scratch: [4096]u8
    response := output
    if response.count == 0 { response = scratch[:] }
    status: s32 = 0
    result: AuthResult = cast(AuthResult)AuthResult.AUTH_PAYLOAD_FAILED
    if operation == SocialSend {
        result = SendFriendRequest(client, *session, now,
            value, response, *status)
    } else if operation == SocialAccept {
        result = FriendAction(client, *session, now,
            value, "accept", response, *status)
    } else if operation == SocialDecline {
        result = FriendAction(client, *session, now,
            value, "decline", response, *status)
    } else if operation == SocialRemove {
        result = RemoveFriend(client, *session, now,
            value, response, *status)
    } else if operation == SocialRequests {
        result = FriendRequests(client, *session, now,
            response, *status)
    } else if operation == SocialFriends {
        result = Friends(client, *session, now,
            response, *status)
    } else if operation == SocialStats {
        result = FriendStats(client, *session, now,
            value, metric, response, *status)
    } else if operation == SocialAlias {
        result = RegisterAlias(client, *session, now,
            value, response, *status)
    }
    SaveSession(*session)
    return cast(s32)result
}

#scope_export
#program_export
SendFriendRequestStored :: (base_url: string, target: string) -> s32 {
    empty: [1]u8
    return SocialOperation(base_url, SocialSend, target, "", empty[0:0])
}

#scope_export
#program_export
AcceptFriendRequestStored :: (base_url: string,
    request_id: string) -> s32 {
    empty: [1]u8
    return SocialOperation(base_url, SocialAccept,
        request_id, "", empty[0:0])
}

#scope_export
#program_export
DeclineFriendRequestStored :: (base_url: string,
    request_id: string) -> s32 {
    empty: [1]u8
    return SocialOperation(base_url, SocialDecline,
        request_id, "", empty[0:0])
}

#scope_export
#program_export
RemoveFriendStored :: (base_url: string, friend_id: string) -> s32 {
    empty: [1]u8
    return SocialOperation(base_url, SocialRemove,
        friend_id, "", empty[0:0])
}

#scope_export
#program_export
FetchFriendRequests :: (base_url: string, output: []u8) -> s32 {
    return SocialOperation(base_url, SocialRequests, "", "", output)
}

#scope_export
#program_export
FetchFriends :: (base_url: string, output: []u8) -> s32 {
    return SocialOperation(base_url, SocialFriends, "", "", output)
}

#scope_export
#program_export
FetchFriendStats :: (base_url: string, practice: string,
    metric: string, output: []u8) -> s32 {
    return SocialOperation(base_url, SocialStats, practice, metric, output)
}

#scope_export
#program_export
RegisterAliasStored :: (base_url: string, alias: string) -> s32 {
    empty: [1]u8
    return SocialOperation(base_url, SocialAlias, alias, "", empty[0:0])
}

#scope_export
#program_export
DeleteStoredAccount :: (base_url: string) -> s32 {
    account: SyncAccount
    if sync_account_load(*account) == 0 {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client: Client
    if !OpenAccountClient(base_url, *account,
        storage_sync_client_id(), *client) {
        return cast(s32)AuthResult.AUTH_NO_ACCOUNT
    }
    client.send = SendNative
    return cast(s32)DeleteAccount(client)
}

}
