
// Wire result codes shared by the sync client and proved retry policy.
SyncResult :: enum {
    SYNC_OK :: 0
    SYNC_INVALID_URL :: 1
    SYNC_NO_ACCOUNT :: 2
    SYNC_PAYLOAD_FAILED :: 3
    SYNC_CHALLENGE_FAILED :: 4
    SYNC_SIGN_FAILED :: 5
    SYNC_REQUEST_FAILED :: 6
    SYNC_AUTH_FAILED :: 7
}
