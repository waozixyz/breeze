#import "social"
#import "auth"
#import "async_client"
#import "text_buffer"
#import, file "sync_async.zi";
#import, file "../app/text_buffers.zi";
#import, file "../app/sync_recovery_policy.zi";

SocialRefresh :: struct {
    operation: StoredOperation
    transport: AsyncTransport
    server: [512]u8
    practice: [32]u8
    action: [16]u8
    value: [96]u8
    requests: [8192]u8
    friends: [8192]u8
    streak: [8192]u8
    average: [8192]u8
    scratch: [1024]u8
    stage: s32
    active: bool
    action_done: bool
    result: s32
    metric: [32]u8
    statistics: [512]u8
    publishing: bool
    published: bool
}

StartSocialStage :: (refresh: *SocialRefresh) -> bool {
    method := "GET"
    path: [768]u8
    body: [256]u8
    output := refresh.scratch[:]
    valid := true
    if refresh.stage == {
        case 1;
        action := TextUntilNul(refresh.action[:])
        value := TextUntilNul(refresh.value[:])
        method = "POST"
        if action == "send" {
            valid = BuildFriendRequestBody(value, body[:]) &&
            AppCopyText("/api/v1/friends/requests", path[:])
        } else if action == "accept" || action == "decline" {
            valid = BuildFriendActionPath(value, action, path[:]) &&
            AppCopyText("{}", body[:])
        } else if action == "remove" {
            method = "DELETE"
            valid = BuildFriendPath(value, path[:])
        } else {
            valid = false
        }
        case 2;
        valid = AppCopyText("/api/v1/friends/requests", path[:])
        output = refresh.requests[:]
        case 3;
        valid = AppCopyText("/api/v1/friends", path[:])
        output = refresh.friends[:]
        case 4;
        if refresh.statistics[0] != cast(u8)0 && !refresh.published {
            method = "PUT"
            valid = AppCopyText("/api/v1/profile/stats", path[:])
            refresh.publishing = true
        } else {
            valid = BuildFriendStatsPath("inbe", TextUntilNul(refresh.practice[:]),
                TextUntilNul(refresh.metric[:]), path[:])
            output = refresh.streak[:]
        }
        case 5;
        practice := TextUntilNul(refresh.practice[:])
        valid = BuildFriendStatsPath("inbe", practice,
            ifx practice == "meditation" then "avg_time" else "avg_hold", path[:])
        output = refresh.average[:]
    }
    if !valid {
        refresh.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
        return false
    }
    if !BeginStoredRequest(*refresh.operation, TextUntilNul(refresh.server[:]),
        refresh.transport, method, TextUntilNul(path[:]),
        ifx refresh.publishing then TextUntilNul(refresh.statistics[:]) else TextUntilNul(body[:]),
        output, true) {
        refresh.result = refresh.operation.result
        return false
    }
    return true
}

BeginSocialRefresh :: (refresh: *SocialRefresh, server: string,
    transport: AsyncTransport, practice: string, action: string, value: string,
    metric: string = "streak", statistics: string = "") -> bool {
    if refresh == null || refresh.active {
        return false
    }
    refresh.* = SocialRefresh.{}
    refresh.result = cast(s32)AuthResult.AUTH_PAYLOAD_FAILED
    if !AppCopyText(server, refresh.server[:]) ||
    !AppCopyText(practice, refresh.practice[:]) ||
    !AppCopyText(metric, refresh.metric[:]) ||
    !AppCopyText(statistics, refresh.statistics[:]) ||
    !AppCopyText(action, refresh.action[:]) ||
    !AppCopyText(value, refresh.value[:]) {
        return false
    }
    refresh.transport = transport
    unused AppCopyText("{\"rows\":[]}", refresh.average[:])
    refresh.stage = 2
    if action.count > 0 {
        refresh.stage = 1
    }
    refresh.active = StartSocialStage(refresh)
    return refresh.active
}

PollSocialRefresh :: (refresh: *SocialRefresh) -> bool {
    if refresh == null || !refresh.active {
        return true
    }
    if !PollStoredOperation(*refresh.operation) {
        return false
    }
    result := refresh.operation.result
    succeeded: s32 = 0
    if result == cast(s32)AuthResult.AUTH_OK {
        succeeded = 1
    }
    current: s32 = 0
    if StoredIdentityCurrent(*refresh.operation) {
        current = 1
    }
    if refresh.publishing {
        refresh.publishing = false
        if succeeded == 0 || current == 0 {
            refresh.result = ifx current == 0 then cast(s32)AuthResult.AUTH_NO_ACCOUNT else result
            refresh.active = false
            return true
        }
        refresh.published = true
        refresh.active = StartSocialStage(refresh)
        return !refresh.active
    }
    // Wim Hof ranks average holds and meditation average time as well.
    has_average: s32 = 0
    if TextUntilNul(refresh.practice[:]) == "whm" ||
    TextUntilNul(refresh.practice[:]) == "meditation" {
        has_average = 1
    }
    step := social_step(refresh.stage, succeeded, current, has_average)
    if step.stop_with_error != 0 {
        refresh.result = result
        refresh.active = false
        return true
    }
    if step.clear_streak != 0 {
        refresh.streak[0] = cast(u8)0
    }
    if step.clear_average != 0 {
        refresh.average[0] = cast(u8)0
    }
    if step.action_done != 0 {
        refresh.action_done = true
    }
    refresh.stage = step.next_stage
    if step.finished != 0 {
        refresh.result = cast(s32)AuthResult.AUTH_OK
        refresh.active = false
        return true
    }
    if !StartSocialStage(refresh) {
        refresh.active = false
        return true
    }
    return false
}

CancelSocialRefresh :: (refresh: *SocialRefresh) {
    if refresh != null {
        CancelStoredOperation(*refresh.operation)
        refresh.active = false
        refresh.result = cast(s32)AuthResult.AUTH_REQUEST_FAILED
    }
}
