// Names of the media library records released versions keep. Each photo is
// one record, cell.media.<sha256>, and its gallery preview another,
// cell.media.preview.<sha256>, both keyed by the SHA-256 of the photo's
// bytes. They sync in their own collection, private.inbe.v1.media: released
// versions reject unknown keys in the older collections but skip unknown
// collections, so none of this goes there. This version keeps photos in the
// account's entity data (entity_records.zi) and only reads and points these
// records, which released versions read through 2027-10-24.

MediaCollection :: "private.inbe.v1.media"
MEDIA_RECORD_PREFIX :: "cell.media."
MEDIA_PREVIEW_PREFIX :: "cell.media.preview."
MEDIA_RECORD_KEY_MAX :: 180

// 64 lowercase hexadecimal digits.
MediaHashValid :: (hash: string) -> bool {
    if hash.count != 64 {
        return false
    }
    for byte: hash {
        digit := byte >= #char "0" && byte <= #char "9"
        letter := byte >= #char "a" && byte <= #char "f"
        if !digit && !letter {
            return false
        }
    }
    return true
}

// Any record of the library: this version's two kinds and kinds a later
// version adds, such as albums. The store reads only the kinds it knows.
MediaRecordKeyAccepted :: (key: string) -> bool {
    prefix := MEDIA_RECORD_PREFIX
    if key.count <= prefix.count || key.count > MEDIA_RECORD_KEY_MAX || key[:prefix.count] != prefix {
        return false
    }
    for byte: key {
        letter := byte >= #char "a" && byte <= #char "z"
        digit := byte >= #char "0" && byte <= #char "9"
        if !letter && !digit && byte != #char "." && byte != #char "-" {
            return false
        }
    }
    return true
}

// The photo's hash in cell.media.<sha256>, or empty.
MediaItemKeyHash :: (key: string) -> string {
    prefix := MEDIA_RECORD_PREFIX
    if key.count != prefix.count + 64 || key[:prefix.count] != prefix ||
    !MediaHashValid(key[prefix.count:]) {
        return ""
    }
    return key[prefix.count:]
}

// The photo's hash in cell.media.preview.<sha256>, or empty.
MediaPreviewKeyHash :: (key: string) -> string {
    prefix := MEDIA_PREVIEW_PREFIX
    if key.count != prefix.count + 64 || key[:prefix.count] != prefix ||
    !MediaHashValid(key[prefix.count:]) {
        return ""
    }
    return key[prefix.count:]
}
