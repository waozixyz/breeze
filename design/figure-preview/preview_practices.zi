// The four practices' own choreography, sampled at any second and turned
// into the shared figure's joints, ready for the figure model. The pose code is Breeze's own: the build
// adds src/practices/tai_chi, src/practices/sun_salutation and apps/practice
// as module folders, so the preview shows exactly what the app plays.
#import "figure_math"
#import "figure_joints"
#import "kryon/scene"
#import "tai_chi_math"
#import "tai_chi_course"
#import "tai_chi_timeline"
#import "tai_chi_solve"
#import "tai_chi_view"
#import "tai_chi_flat"
#import "tai_chi_rules"
#import "workout_rules"
#import "workout_moves"
#import "sun_salutation_rules"
#import "sun_salutation_pose"
#import "astral_projection_rules"
#import "astral_technique"
#import "sun_salutation_artwork"
#import "preview_flat"
#import "preview_ground"
#import "std/file"
#import "std/math"

PREVIEW_TAI_CHI :: 0
PREVIEW_SUN_SALUTATION :: 1
PREVIEW_WORKOUT :: 2
PREVIEW_ASTRAL :: 3

PREVIEW_ITEM_LIMIT :: 128

// What one moment of a practice shows: the figure, and for an astral exit
// the translucent twin beside the still physical body.
PreviewMoment :: struct {
    body: FigureJoints
    workout_item: s32
    ground: PreviewGround
    body_bounds: PreviewGroundBounds
    floor_bounds: PreviewGroundBounds
    // The practice's camera direction, which the flat figure shares.
    camera: TaiChiCamera
    solved: TaiChiSolved
    rig: TaiChiRig
    flat_look: TaiChiFlatLook
    twin_visible: bool
    twin: FigureJoints
    twin_effect: PreviewEffect
}

// Moves a whole body rigidly, for an astral double rising or rolling out of
// the physical one: ROLL about the lying body's longitudinal Z axis at
// PIVOT, followed by OFFSET. This also matches the native camera transform.
PreviewEffect :: struct {
    offset: Vector3
    pivot: Vector3
    roll: float64
}

PreviewEffectPoint :: (point: Vector3, effect: PreviewEffect) -> Vector3 {
    return FigureAdd(FigureAdd(effect.pivot, effect.offset),
        FigureRotate(FigureAxisAngle(.{0.0, 0.0, 1.0}, effect.roll), FigureSub(point, effect.pivot)))
}

PreviewLibrary :: struct {
    ready: bool
    ground: [4]PreviewGround
    tai_chi_items: [PREVIEW_ITEM_LIMIT]s32
    tai_chi_count: s32
    timeline_item: s32
    timeline: TaiChiTimeline
    astral: [6]AstralCourse
    astral_ready: [6]bool
    astral_even: bool
    // A steady frame for push-up rotation and each astral technique.
    steady_framed: [7]bool
    steady_body_bounds: [7]PreviewGroundBounds
    steady_floor_bounds: [7]PreviewGroundBounds
}

preview_astral_ids: [6]string = .["bruce_foundation_touch", "bruce_full_body_current",
    "bruce_elevator_trance", "bruce_spin_loosening", "bruce_rope_exit", "bruce_roll_out_exit"];
preview_astral_names: [6]string = .["Foundation touch", "Full-body current", "Elevator trance",
    "Spin loosening", "Rope exit", "Roll-out exit"];
preview_workout_names: [12]string = .["Jumping jacks", "Wall sit", "Push-ups", "Crunches",
    "Step-ups", "Squats", "Triceps dips", "Plank", "High knees", "Lunges", "Push-up rotation",
    "Side plank"];

// PRACTICES is the practices package checkout (its taichi/ and
// astral_projection/ folders).
PreviewLibraryLoad :: (library: *PreviewLibrary, practices: string) -> bool {
    for practice: cast(s32)0..3 {
        folder: [1100]u8
        named: [1200]u8
        full: [1300]u8
        prefix := PreviewJoin(folder[:], practices, "/shared/figure/backdrops/")
        name := PreviewJoin(named[:], prefix, PreviewBackdropName(practice))
        data, found := ReadEntireFile(PreviewJoin(full[:], name, ".json"))
        if !found || !PreviewGroundRead(data, *library.ground[practice]) {
            print("figure preview: missing or invalid ground registration for %\n", PreviewBackdropName(practice))
            return false
        }
    }
    path: [1024]u8
    course, found := ReadEntireFile(PreviewJoin(path[:], practices, "/taichi/course.tch"))
    if !found || !TaiChiCourseParse(*tai_chi_course, course) {
        return false
    }
    library.tai_chi_count = 0
    // Breakdown and follow-along items replay a demo's choreography slower.
    for index: cast(s32)0..tai_chi_course.item_count - 1 {
        id := TaiChiCourseString(tai_chi_course.items[index].id)
        if PreviewEndsWith(id, "/breakdown") || PreviewEndsWith(id, "/follow") {
            continue
        }
        if library.tai_chi_count >= PREVIEW_ITEM_LIMIT {
            print("figure preview: too many course items for complete review\n")
            return false
        }
        library.tai_chi_items[library.tai_chi_count] = index
        library.tai_chi_count += 1
    }
    // Preserve existing picker IDs, then include slower breakdown/follow
    // variants as complete reviewable sequences too.
    for index: cast(s32)0..tai_chi_course.item_count - 1 {
        id := TaiChiCourseString(tai_chi_course.items[index].id)
        if PreviewEndsWith(id, "/breakdown") || PreviewEndsWith(id, "/follow") {
            if library.tai_chi_count >= PREVIEW_ITEM_LIMIT {
                print("figure preview: too many course items for complete review\n")
                return false
            }
            library.tai_chi_items[library.tai_chi_count] = index
            library.tai_chi_count += 1
        }
    }
    library.timeline_item = -1
    for technique: 0..5 {
        name: [128]u8
        file := PreviewJoin(name[:], "/astral_projection/sessions/", preview_astral_ids[technique])
        full: [1024]u8
        relative := PreviewJoin(full[:], practices, file)
        tail: [1100]u8
        data, ok := ReadEntireFile(PreviewJoin(tail[:], relative, ".json"))
        library.astral_ready[technique] = ok && AstralCourseParse(data, *library.astral[technique])
        if !library.astral_ready[technique] {
            // A practices checkout without the session timings still plays
            // each technique, with its steps evenly twenty seconds apart.
            PreviewAstralEven(*library.astral[technique])
            library.astral_ready[technique] = true
            library.astral_even = true
        }
    }
    library.ready = library.tai_chi_count > 0
    return library.ready
}

PreviewItemCount :: (library: *PreviewLibrary, practice: s32) -> s32 {
    if practice == PREVIEW_TAI_CHI {
        return library.tai_chi_count
    }
    if practice == PREVIEW_SUN_SALUTATION {
        return 1
    }
    if practice == PREVIEW_WORKOUT {
        return WORKOUT_EXERCISE_COUNT
    }
    return 6
}

PreviewItemName :: (library: *PreviewLibrary, practice: s32, item: s32) -> string {
    if practice == PREVIEW_TAI_CHI && item >= 0 && item < library.tai_chi_count {
        return TaiChiCourseString(tai_chi_course.items[library.tai_chi_items[item]].id)
    }
    if practice == PREVIEW_SUN_SALUTATION {
        return "Two rounds, both legs"
    }
    if practice == PREVIEW_WORKOUT && item >= 0 && item < 12 {
        return preview_workout_names[item]
    }
    if practice == PREVIEW_ASTRAL && item >= 0 && item < 6 {
        return preview_astral_names[item]
    }
    return ""
}

// The item the practice opens on: Tai Chi's full form, the Workout's squat.
PreviewDefaultItem :: (library: *PreviewLibrary, practice: s32) -> s32 {
    if practice == PREVIEW_TAI_CHI {
        for index: cast(s32)0..library.tai_chi_count - 1 {
            if PreviewItemName(library, practice, index) == "full/normal" {
                return index
            }
        }
    }
    if practice == PREVIEW_WORKOUT {
        return WORKOUT_SQUATS
    }
    return 0
}

// Review moments from the same durations the preview plays. A contact
// sheet can cover every Workout item and both Sun Salutation rounds
// without maintaining another copy of their timing rules in its script.
PreviewReviewPoints :: (library: *PreviewLibrary) {
    for item: cast(s32)0..WORKOUT_EXERCISE_COUNT - 1 {
        duration := PreviewDuration(library, PREVIEW_WORKOUT, item)
        for part: 1..3 {
            print("review\t%\t%\t%\t%\n", PREVIEW_WORKOUT, item,
                duration * cast(float64)part / 4.0, PreviewItemName(library, PREVIEW_WORKOUT, item))
        }
    }
    seconds: float64
    for round: cast(s32)0..1 {
        for step: cast(s32)0..SUN_SALUTATION_STEP_COUNT - 1 {
            duration := cast(float64)SalutationStepSeconds(PreviewSunState(round, step))
            print("review\t%\t%\t%\tRound % / step %\n", PREVIEW_SUN_SALUTATION, 0,
                seconds + duration * 0.75, round + 1, step + 1)
            seconds += duration
        }
    }
}

// Seconds the item plays before it starts again.
PreviewDuration :: (library: *PreviewLibrary, practice: s32, item: s32) -> float64 {
    if practice == PREVIEW_TAI_CHI {
        if !PreviewTimeline(library, item) {
            return 1.0
        }
        return library.timeline.duration
    }
    if practice == PREVIEW_SUN_SALUTATION {
        total: float64
        for round: cast(s32)0..1 {
            for step: cast(s32)0..SUN_SALUTATION_STEP_COUNT - 1 {
                total += cast(float64)SalutationStepSeconds(PreviewSunState(round, step))
            }
        }
        return total
    }
    if practice == PREVIEW_WORKOUT {
        return cast(float64)WORKOUT_WORK_MS / 1000.0
    }
    if item >= 0 && item < 6 && library.astral_ready[item] {
        return cast(float64)library.astral[item].duration
    }
    return 60.0
}

// Fit the full pose and its near neighbours so the view leads a transition
// gently and leaves room for the pose it is moving into.
PreviewSample :: (library: *PreviewLibrary, practice: s32, item: s32, seconds: float64) -> PreviewMoment {
    moment := PreviewSampleRaw(library, practice, item, seconds)
    moment.ground = library.ground[practice]
    moment.body_bounds = PreviewEmptyBounds()
    moment.floor_bounds = PreviewEmptyBounds()
    steady: s32 = -1
    if practice == PREVIEW_ASTRAL && item >= 0 && item < 6 {
        steady = item + 1
    } else if practice == PREVIEW_WORKOUT && item == WORKOUT_PUSH_UP_ROTATION {
        // The whole-body roll would otherwise zoom in and out on every rep.
        steady = 0
    }
    if steady >= 0 {
        PreviewFrameSteady(library, practice, item, steady)
        moment.body_bounds = library.steady_body_bounds[steady]
        moment.floor_bounds = library.steady_floor_bounds[steady]
    } else {
        duration := PreviewDuration(library, practice, item)
        earlier := PreviewSampleRaw(library, practice, item, FigureMax(0.0, seconds - 0.35))
        later := PreviewSampleRaw(library, practice, item, FigureMin(duration, seconds + 0.35))
        PreviewIncludeMoment(*moment.body_bounds, *moment.floor_bounds, *earlier)
        PreviewIncludeMoment(*moment.body_bounds, *moment.floor_bounds, *moment)
        PreviewIncludeMoment(*moment.body_bounds, *moment.floor_bounds, *later)
        PreviewIncludeProp(*moment.body_bounds, *moment.floor_bounds, moment.workout_item)
    }
    span := moment.body_bounds.high.y - moment.body_bounds.low.y
    low_pose := 1.0 - FigureSmooth(span, 0.7, 1.65)
    moment.camera.tilt = moment.ground.pitch + 0.12 * low_pose
    return moment
}

PreviewSampleRaw :: (library: *PreviewLibrary, practice: s32, item: s32, seconds: float64) -> PreviewMoment {
    moment: PreviewMoment
    moment.workout_item = -1
    if practice == PREVIEW_TAI_CHI {
        moment.rig = TaiChiRigFor(0)
        moment.flat_look = TaiChiFlatLookFor(0)
        if PreviewTimeline(library, item) {
            pose := TaiChiTimelineSample(*library.timeline, seconds)
            moment.solved = TaiChiSolvePose(*pose, *moment.rig)
        }
        moment.camera.yaw = 0.42
        moment.camera.center = TaiChiV3(moment.solved.pelvis.x, 0.0, moment.solved.pelvis.z)
    } else if practice == PREVIEW_SUN_SALUTATION {
        moment.rig = WorkoutRig()
        state := PreviewSunAt(seconds)
        pose := SunSalutationPoseAt(state, *moment.rig)
        moment.solved = WorkoutSolve(*pose, *moment.rig)
        moment.flat_look = SunSalutationWomanLook()
        view := SunSalutationViewAt(state)
        moment.camera.yaw = view.yaw * TAI_CHI_DEGREE
        moment.camera.center = TaiChiV3(0.0, 0.0, view.center)
    } else if practice == PREVIEW_WORKOUT {
        moment.workout_item = item
        moment.rig = WorkoutRig()
        pose := WorkoutPoseAt(item, cast(s64)(seconds * 1000.0), *moment.rig)
        moment.solved = WorkoutSolve(*pose, *moment.rig)
        moment.flat_look = TaiChiFlatLookNamed("jadeWoman")
        framing := WorkoutFramingFor(item)
        moment.camera = framing.camera
    } else {
        moment.rig = WorkoutRig()
        moment.flat_look = TaiChiFlatLookNamed("jadeWoman")
        moment.flat_look.top = 0x597888
        moment.flat_look.pants = 0x384d65
        if item >= 0 && item <= 5 && library.astral_ready[item] {
            scene := AstralTechniqueAt(preview_astral_ids[item], *library.astral[item], cast(s64)(seconds * 1000.0))
            moment.solved = WorkoutSolve(*scene.physical, *moment.rig)
            moment.camera = scene.camera
            moment.twin_visible = scene.double_visible
            if scene.double_visible {
                awareness := WorkoutSolve(*scene.awareness, *moment.rig)
                moment.twin = PreviewJoints(*awareness, *moment.rig)
                moment.twin_effect.offset = FigureV3(scene.double_offset.x, scene.double_offset.y,
                    scene.double_offset.z)
                moment.twin_effect.pivot = FigureV3(moment.solved.pelvis.x, moment.solved.pelvis.y,
                    moment.solved.pelvis.z)
                moment.twin_effect.roll = scene.double_roll
            }
        } else {
            resting := AstralRestingPose()
            moment.solved = WorkoutSolve(*resting, *moment.rig)
        }
    }
    moment.body = PreviewJoints(*moment.solved, *moment.rig)
    return moment
}

// The view of MOMENT turned TURN and lifted LIFT radians from the practice's
// own camera and zoomed ZOOM times, and the flat figure's camera to match.
PreviewViewOf :: (moment: *PreviewMoment, turn: float64, lift: float64, zoom: float64,
    aspect: float64 = 0.75) -> PreviewView {
    view: PreviewView
    view.yaw = moment.camera.yaw + turn
    view.pitch = FigureClamp(moment.camera.tilt + lift, -1.4, 1.5)
    return PreviewGroundFit(moment.ground, moment.body_bounds, moment.floor_bounds, view, aspect, zoom)
}

PreviewFlatOf :: (moment: *PreviewMoment, view: PreviewView) -> TaiChiCamera {
    camera := moment.camera
    camera.yaw = view.yaw
    camera.tilt = view.pitch
    TaiChiFlatPaintLook(*preview_flat_frame, *moment.solved, *moment.rig, moment.flat_look, camera)
    return camera
}

// The practice's painted backdrop in the figure media's backdrops folder.
PreviewBackdropName :: (practice: s32) -> string {
    names: [4]string = .["tai-chi", "sun-salutation", "workout", "astral"]
    return names[practice]
}

PreviewJoints :: (solved: *TaiChiSolved, rig: *TaiChiRig) -> FigureJoints {
    joints: FigureJoints
    joints.height = rig.height
    joints.pelvis = PreviewVector(solved.pelvis)
    joints.spine = PreviewVector(solved.spine1)
    joints.chest = PreviewVector(solved.chest)
    joints.neck = PreviewVector(solved.neck_base)
    joints.pelvis_turn = PreviewQuat(solved.pelvis_quat)
    joints.chest_turn = PreviewQuat(solved.chest_quat)
    joints.head_turn = PreviewQuat(solved.head_quat)
    for side: 0..1 {
        joints.shoulders[side] = PreviewVector(solved.shoulders[side])
        joints.elbows[side] = PreviewVector(solved.elbows[side])
        joints.wrists[side] = PreviewVector(solved.wrists[side])
        joints.hands[side] = PreviewQuat(solved.hand_quats[side])
        joints.fist[side] = solved.hand_shapes[side][1]
        joints.hook[side] = solved.hand_shapes[side][2]
        joints.hips[side] = PreviewVector(solved.hips[side])
        joints.knees[side] = PreviewVector(solved.knees[side])
        joints.ankles[side] = PreviewVector(solved.ankles[side])
        joints.toes[side] = PreviewVector(solved.toes[side])
        joints.heels[side] = PreviewVector(solved.heels[side])
        joints.balls[side] = PreviewVector(solved.balls[side])
        joints.feet[side] = PreviewQuat(solved.foot_quats[side])
    }
    return joints
}

PreviewAstralEven :: (course: *AstralCourse) {
    course.count = 16
    course.duration = 330
    stem := "astral_text_preview_"
    for index: cast(s32)0..15 {
        cue := *course.cues[index]
        cue.second = index * 20
        for at: 0..stem.count - 1 {
            cue.key[at] = stem[at]
        }
        cue.key[stem.count] = cast(u8)(48 + index / 10)
        cue.key[stem.count + 1] = cast(u8)(48 + index % 10)
        cue.key[stem.count + 2] = 0
    }
}

PreviewEndsWith :: (text: string, suffix: string) -> bool {
    return text.count >= suffix.count && text[text.count - suffix.count:text.count] == suffix
}

PreviewJoin :: (buffer: []u8, a: string, b: string) -> string {
    if a.count + b.count > buffer.count {
        return ""
    }
    for index: 0..a.count - 1 {
        buffer[index] = a[index]
    }
    for index: 0..b.count - 1 {
        buffer[a.count + index] = b[index]
    }
    return TextView(buffer[0:a.count + b.count])
}

#scope_file
PreviewEmptyBounds :: () -> PreviewGroundBounds {
    return .{.{1000.0, 1000.0, 1000.0}, .{-1000.0, -1000.0, -1000.0}}
}

PreviewIncludePoint :: (bounds: *PreviewGroundBounds, point: Vector3, padding: Vector3) {
    bounds.low = .{FigureMin(bounds.low.x, point.x - padding.x), FigureMin(bounds.low.y, point.y - padding.y),
        FigureMin(bounds.low.z, point.z - padding.z)}
    bounds.high = .{FigureMax(bounds.high.x, point.x + padding.x), FigureMax(bounds.high.y, point.y + padding.y),
        FigureMax(bounds.high.z, point.z + padding.z)}
}

PreviewIncludeFigure :: (bounds: *PreviewGroundBounds, figure: *FigureJoints, effect: PreviewEffect = .{}) {
    head := FigureAdd(figure.neck, FigureRotate(figure.head_turn, .{0.0, 0.20, 0.0}))
    joints: [15]Vector3 = .[figure.pelvis, figure.neck, head, figure.wrists[0], figure.wrists[1],
        figure.elbows[0], figure.elbows[1], figure.toes[0], figure.toes[1], figure.heels[0], figure.heels[1],
        figure.ankles[0], figure.ankles[1], figure.knees[0], figure.knees[1]]
    for index: 0..joints.count - 1 {
        point := PreviewEffectPoint(joints[index], effect)
        // The silhouette extends past these joint centres (hair, clothing,
        // fingers and slippers). Allow more room at the head and skirt.
        padding := ifx index == 0 then 0.26 else ifx index == 2 then 0.19 else 0.12
        PreviewIncludePoint(bounds, point, .{padding, padding, padding})
    }
}

PreviewIncludeMoment :: (body: *PreviewGroundBounds, floor: *PreviewGroundBounds, moment: *PreviewMoment) {
    joints := *moment.body
    PreviewIncludeFigure(body, joints)
    if moment.twin_visible {
        PreviewIncludeFigure(body, *moment.twin, moment.twin_effect)
    }
    footprint := FigureScale(FigureAdd(joints.balls[0], joints.balls[1]), 0.5)
    supports: [7]Vector3 = .[joints.heels[0], joints.heels[1], joints.balls[0], joints.balls[1],
        joints.wrists[0], joints.wrists[1], joints.pelvis]
    for index: 0..supports.count - 1 {
        support := supports[index]
        if index >= 4 {
            // Weight hands and hips into the floor footprint as they lower.
            // A hard contact cutoff would jerk the camera as a hand lands.
            support = FigureLerp(support, footprint, FigureSmooth(support.y, 0.04, 0.38))
        }
        PreviewIncludePoint(floor, .{support.x, 0.0, support.z}, .{0.06, 0.0, 0.06})
    }
}

PreviewIncludeProp :: (body: *PreviewGroundBounds, floor: *PreviewGroundBounds, item: s32) {
    if item < 0 { return }
    prop := WorkoutPropFor(item)
    if !prop.wall && !prop.bench { return }
    low := FigureV3(-0.30, 0.0, FigureMin(prop.bench_near, prop.bench_far))
    high := FigureV3(0.30, WORKOUT_BENCH_TOP, FigureMax(prop.bench_near, prop.bench_far))
    if prop.wall {
        low = .{-0.55, 0.0, prop.wall_at - 0.08}
        high = .{0.55, 1.95, prop.wall_at}
    }
    PreviewIncludePoint(body, low, .{})
    PreviewIncludePoint(body, high, .{})
    PreviewIncludePoint(floor, low, .{})
    PreviewIncludePoint(floor, .{high.x, 0.0, high.z}, .{})
}

PreviewFrameSteady :: (library: *PreviewLibrary, practice: s32, item: s32, slot: s32) {
    if library.steady_framed[slot] { return }
    body := PreviewEmptyBounds()
    floor := PreviewEmptyBounds()
    duration := PreviewDuration(library, practice, item)
    step := ifx practice == PREVIEW_ASTRAL then 0.5 else 0.125
    seconds: float64
    while true {
        moment := PreviewSampleRaw(library, practice, item, seconds)
        PreviewIncludeMoment(*body, *floor, *moment)
        if seconds >= duration { break }
        seconds = FigureMin(duration, seconds + step)
    }
    library.steady_body_bounds[slot] = body
    library.steady_floor_bounds[slot] = floor
    library.steady_framed[slot] = true
}

PreviewVector :: (value: TaiChiVector3) -> Vector3 {
    return .{value.x, value.y, value.z}
}

PreviewQuat :: (value: TaiChiQuaternion) -> FigureQuat {
    return .{value.x, value.y, value.z, value.w}
}

PreviewTimeline :: (library: *PreviewLibrary, item: s32) -> bool {
    if item < 0 || item >= library.tai_chi_count {
        return false
    }
    if library.timeline_item == item {
        return true
    }
    if !TaiChiTimelineForItem(*library.timeline, tai_chi_course.items[library.tai_chi_items[item]]) {
        library.timeline_item = -1
        return false
    }
    library.timeline_item = item
    return true
}

PreviewSunState :: (round: s32, step: s32) -> SunSalutationPracticeState {
    state: SunSalutationPracticeState
    state.repetitions = 2
    state.repetition = round
    state.step = step
    state.start_seconds = SUN_SALUTATION_DEFAULT_START_SECONDS
    state.end_seconds = SUN_SALUTATION_DEFAULT_END_SECONDS
    return state
}

// Two full rounds, the second leading with the other leg.
PreviewSunAt :: (seconds: float64) -> SunSalutationPracticeState {
    left := seconds
    for round: cast(s32)0..1 {
        for step: cast(s32)0..SUN_SALUTATION_STEP_COUNT - 1 {
            state := PreviewSunState(round, step)
            length := cast(float64)SalutationStepSeconds(state)
            if left < length || (round == 1 && step == SUN_SALUTATION_STEP_COUNT - 1) {
                state.step_ticks = cast(s32)(FigureClamp(left, 0.0, length) * 60.0)
                return state
            }
            left -= length
        }
    }
    return PreviewSunState(0, 0)
}


// Movement spans for slow playback, from the actual timeline/key/cue data.
#scope_export
PreviewReviewSpans :: (library: *PreviewLibrary) {
    for item: cast(s32)0..library.tai_chi_count - 1 {
        if PreviewTimeline(library, item) {
            timeline := *library.timeline
            for key: cast(s32)0..timeline.count - 2 {
                if !timeline.keys[key + 1].held {
                    print("span\t0\t%\t%\t%\tkey-%\n", item,
                        timeline.keys[key].t - timeline.start, timeline.keys[key + 1].t - timeline.start, key)
                }
            }
        }
    }
    seconds: float64
    for round: cast(s32)0..1 {
        for step: cast(s32)0..SUN_SALUTATION_STEP_COUNT - 1 {
            duration := cast(float64)SalutationStepSeconds(PreviewSunState(round, step))
            print("span\t1\t0\t%\t%\tround-%-step-%\n", seconds,
                seconds + FigureMin(duration * 0.75, cast(float64)SUN_SALUTATION_TRANSITION_SECONDS), round + 1, step + 1)
            seconds += duration
        }
    }
    for item: cast(s32)0..WORKOUT_EXERCISE_COUNT - 1 {
        duration := PreviewDuration(library, PREVIEW_WORKOUT, item)
        if item == WORKOUT_SIDE_PLANK {
            half := cast(float64)WORKOUT_SIDE_SWITCH_MS / 1000.0
            roll := cast(float64)WORKOUT_SIDE_ROLL_MS / 1000.0
            print("span\t2\t%\t%\t%\tside-roll\n", item, half - 1.0, half + roll + 1.0)
        } else {
            seconds = 0.0
            count := WorkoutKeyCount(item)
            if count > 1 {
                while seconds < duration {
                    for key: cast(s32)0..count - 1 {
                        frame := WorkoutKeyframe(item, key)
                        seconds += cast(float64)frame.hold_ms / 1000.0
                        end := seconds + cast(float64)frame.move_ms / 1000.0
                        if seconds < duration && end > seconds {
                            print("span\t2\t%\t%\t%\tkey-%\n", item, seconds, FigureMin(end, duration), key)
                        }
                        seconds = end
                    }
                }
            }
        }
    }
    for item: cast(s32)0..5 {
        course := *library.astral[item]
        for cue: cast(s32)0..course.count - 1 {
            start := cast(float64)course.cues[cue].second
            end := cast(float64)course.duration
            if cue + 1 < course.count {
                end = cast(float64)course.cues[cue + 1].second
            }
            // Include the cued change and its breathing/climbing cycle;
            // complete playback retains the rest of every long quiet hold.
            print("span\t3\t%\t%\t%\tcue-%\n", item, FigureMax(0.0, start - 1.0), FigureMin(end, start + 8.0), cue)
        }
    }
}
