// When a photo was taken, from the Exif fields of JPEG (APP1), PNG (eXIf)
// and WebP (EXIF) files. Only bounded reads of the file's own bytes; the
// photo itself is never changed.
#import "byte_text_linux"

MEDIA_EXIF_IFD :: 34665
MEDIA_EXIF_DATE_ORIGINAL :: 36867
MEDIA_EXIF_DATE_DIGITIZED :: 36868
MEDIA_EXIF_OFFSET_ORIGINAL :: 36881
MEDIA_TIFF_DATE :: 306
MEDIA_TIFF_ORIENTATION :: 274
// An IFD with more entries than this is not a camera's.
MEDIA_IFD_ENTRIES :: 1024

// The camera's own clock: the day the photo was taken where it was taken.
MediaCapture :: struct {
    valid: bool
    year: s32
    month: s32
    day: s32
    hour: s32
    minute: s32
    second: s32
    // Minutes east of UTC, when the camera recorded its offset.
    has_offset: bool
    offset: s32
}

// A TIFF structure inside the file: bytes [start, end) with its byte order.
MediaTiff :: struct {
    valid: bool
    start: s64
    end: s64
    little: bool
}

MediaNumber :: (data: string, at: s64, size: s64, little: bool) -> s64 {
    value: s64 = 0
    for index: cast(s64)0..size - 1 {
        byte := cast(s64)data[at + index]
        if little {
            value = value | (byte << (index * 8))
        } else {
            value = (value << 8) | byte
        }
    }
    return value
}

MediaTiffAt :: (data: string, start: s64, end: s64) -> MediaTiff {
    tiff: MediaTiff
    if start < 0 || end > data.count || end - start < 8 {
        return tiff
    }
    if data[start] == cast(u8)73 && data[start + 1] == cast(u8)73 {
        tiff.little = true
    } else if data[start] != cast(u8)77 || data[start + 1] != cast(u8)77 {
        return tiff
    }
    if MediaNumber(data, start + 2, 2, tiff.little) != 42 {
        return tiff
    }
    tiff.valid = true
    tiff.start = start
    tiff.end = end
    return tiff
}

// The value offset (inside the TIFF) and count of one tag in the IFD at
// ifd, or -1. Only one entry of a tag counts; duplicates are no camera fact.
MediaTiffField :: (data: string, tiff: MediaTiff, ifd: s64, wanted: s64, count: *s64) -> s64 {
    if ifd < 8 || tiff.start + ifd + 2 > tiff.end {
        return -1
    }
    entries := MediaNumber(data, tiff.start + ifd, 2, tiff.little)
    if entries > MEDIA_IFD_ENTRIES || tiff.start + ifd + 2 + entries * 12 > tiff.end {
        return -1
    }
    found: s64 = -1
    for index: cast(s64)0..entries - 1 {
        entry := tiff.start + ifd + 2 + index * 12
        if MediaNumber(data, entry, 2, tiff.little) != wanted {
            continue
        }
        if found >= 0 {
            return -1
        }
        type := MediaNumber(data, entry + 2, 2, tiff.little)
        values := MediaNumber(data, entry + 4, 4, tiff.little)
        unit: s64 = 0
        if type == 2 || type == 1 || type == 7 {
            unit = 1
        } else if type == 3 {
            unit = 2
        } else if type == 4 {
            unit = 4
        } else {
            return -1
        }
        if values * unit <= 4 {
            found = entry + 8 - tiff.start
        } else {
            found = MediaNumber(data, entry + 8, 4, tiff.little)
        }
        if values < 0 || found < 0 || tiff.start + found + values * unit > tiff.end {
            return -1
        }
        count.* = values
    }
    return found
}

MediaDigits :: (data: string, at: s64, size: s64) -> s32 {
    value: s32 = 0
    for index: cast(s64)0..size - 1 {
        byte := data[at + index]
        if byte < cast(u8)48 || byte > cast(u8)57 {
            return -1
        }
        value = value * 10 + cast(s32)(byte - cast(u8)48)
    }
    return value
}

MediaLeap :: (year: s32) -> bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

MediaMonthDays :: (year: s32, month: s32) -> s32 {
    lengths: [12]s32 = .[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if month == 2 && MediaLeap(year) {
        return 29
    }
    return lengths[month - 1]
}

// "YYYY:MM:DD HH:MM:SS" at the field, as Exif writes dates.
MediaExifDate :: (data: string, tiff: MediaTiff, at: s64, count: s64) -> MediaCapture {
    capture: MediaCapture
    if count < 19 {
        return capture
    }
    start := tiff.start + at
    if data[start + 4] != cast(u8)58 || data[start + 7] != cast(u8)58 || data[start + 13] != cast(u8)58 ||
    data[start + 16] != cast(u8)58 {
        return capture
    }
    capture.year = MediaDigits(data, start, 4)
    capture.month = MediaDigits(data, start + 5, 2)
    capture.day = MediaDigits(data, start + 8, 2)
    capture.hour = MediaDigits(data, start + 11, 2)
    capture.minute = MediaDigits(data, start + 14, 2)
    capture.second = MediaDigits(data, start + 17, 2)
    if capture.year < 1 || capture.month < 1 || capture.month > 12 || capture.day < 1 ||
    capture.day > MediaMonthDays(capture.year, capture.month) || capture.hour < 0 ||
    capture.hour > 23 || capture.minute < 0 || capture.minute > 59 || capture.second < 0 ||
    capture.second > 60 {
        return MediaCapture.{}
    }
    capture.valid = true
    return capture
}

// "+HH:MM" or "-HH:MM" at the field.
MediaExifOffset :: (data: string, tiff: MediaTiff, at: s64, count: s64, capture: *MediaCapture) {
    if count < 6 {
        return
    }
    start := tiff.start + at
    sign := data[start]
    hours := MediaDigits(data, start + 1, 2)
    minutes := MediaDigits(data, start + 4, 2)
    if (sign != cast(u8)43 && sign != cast(u8)45) || data[start + 3] != cast(u8)58 || hours < 0 ||
    hours > 14 || minutes < 0 || minutes > 59 {
        return
    }
    capture.offset = hours * 60 + minutes
    if sign == cast(u8)45 {
        capture.offset = -capture.offset
    }
    capture.has_offset = true
}

MediaTiffCapture :: (data: string, tiff: MediaTiff) -> MediaCapture {
    capture: MediaCapture
    if !tiff.valid {
        return capture
    }
    root := MediaNumber(data, tiff.start + 4, 4, tiff.little)
    count: s64 = 0
    pointer := MediaTiffField(data, tiff, root, MEDIA_EXIF_IFD, *count)
    if pointer >= 0 && count == 1 {
        exif := MediaNumber(data, tiff.start + pointer, 4, tiff.little)
        at := MediaTiffField(data, tiff, exif, MEDIA_EXIF_DATE_ORIGINAL, *count)
        if at >= 0 {
            capture = MediaExifDate(data, tiff, at, count)
        }
        if !capture.valid {
            at = MediaTiffField(data, tiff, exif, MEDIA_EXIF_DATE_DIGITIZED, *count)
            if at >= 0 {
                capture = MediaExifDate(data, tiff, at, count)
            }
        }
        if capture.valid {
            at = MediaTiffField(data, tiff, exif, MEDIA_EXIF_OFFSET_ORIGINAL, *count)
            if at >= 0 {
                MediaExifOffset(data, tiff, at, count, *capture)
            }
        }
    }
    if !capture.valid {
        at := MediaTiffField(data, tiff, root, MEDIA_TIFF_DATE, *count)
        if at >= 0 {
            capture = MediaExifDate(data, tiff, at, count)
        }
    }
    return capture
}

// The Exif TIFF of a JPEG's APP1 segment.
MediaJpegTiff :: (data: string) -> MediaTiff {
    at: s64 = 2
    while at + 4 <= data.count {
        if data[at] != cast(u8)255 {
            return MediaTiff.{}
        }
        marker := data[at + 1]
        if marker == cast(u8)217 || marker == cast(u8)218 {
            return MediaTiff.{}
        }
        if marker == cast(u8)255 {
            at += 1
            continue
        }
        if marker == cast(u8)1 || (marker >= cast(u8)208 && marker <= cast(u8)215) {
            at += 2
            continue
        }
        length := MediaNumber(data, at + 2, 2, false)
        if length < 2 || at + 2 + length > data.count {
            return MediaTiff.{}
        }
        if marker == cast(u8)225 && length >= 16 && data[at + 4:at + 10] == "Exif\0\0" {
            return MediaTiffAt(data, at + 10, at + 2 + length)
        }
        at += 2 + length
    }
    return MediaTiff.{}
}

// A PNG's eXIf chunk.
MediaPngTiff :: (data: string) -> MediaTiff {
    at: s64 = 8
    while at + 12 <= data.count {
        length := MediaNumber(data, at, 4, false)
        if length < 0 || at + 12 + length > data.count {
            return MediaTiff.{}
        }
        kind := data[at + 4:at + 8]
        if kind == "eXIf" {
            return MediaTiffAt(data, at + 8, at + 8 + length)
        }
        if kind == "IDAT" || kind == "IEND" {
            return MediaTiff.{}
        }
        at += 12 + length
    }
    return MediaTiff.{}
}

// A WebP's EXIF chunk; some writers keep the JPEG "Exif\0\0" prefix.
MediaWebpTiff :: (data: string) -> MediaTiff {
    at: s64 = 12
    while at + 8 <= data.count {
        length := MediaNumber(data, at + 4, 4, true)
        if length < 0 || at + 8 + length > data.count {
            return MediaTiff.{}
        }
        if data[at:at + 4] == "EXIF" {
            start := at + 8
            if length >= 6 && data[start:start + 6] == "Exif\0\0" {
                start += 6
            }
            return MediaTiffAt(data, start, at + 8 + length)
        }
        at += 8 + length + (length % 2)
    }
    return MediaTiff.{}
}

MediaTiffOf :: (data: string, format: string) -> MediaTiff {
    if format == "jpg" {
        return MediaJpegTiff(data)
    }
    if format == "png" {
        return MediaPngTiff(data)
    }
    if format == "webp" {
        return MediaWebpTiff(data)
    }
    return MediaTiff.{}
}

MediaCaptureOf :: (data: string, format: string) -> MediaCapture {
    return MediaTiffCapture(data, MediaTiffOf(data, format))
}

// How the camera says to turn the pixels for display: Exif orientation 1
// (as stored) to 8; 1 when the file does not say.
MediaOrientationOf :: (data: string, format: string) -> s32 {
    tiff := MediaTiffOf(data, format)
    if !tiff.valid {
        return 1
    }
    count: s64 = 0
    root := MediaNumber(data, tiff.start + 4, 4, tiff.little)
    at := MediaTiffField(data, tiff, root, MEDIA_TIFF_ORIENTATION, *count)
    if at < 0 || count != 1 {
        return 1
    }
    value := MediaNumber(data, tiff.start + at, 2, tiff.little)
    if value < 1 || value > 8 {
        return 1
    }
    return cast(s32)value
}
