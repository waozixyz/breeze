#import, file "../src/cells/diary_spelling_mask.zi";
#import "vec"
#import "text"
#import "byte_text_linux"

#program_export
Answer :: () -> s32 {
    entry := "I wnet out.\n![IMG_1.jpg](diary:photo-1.bin)\n  ![](photos:9f2c4e1a7b3d5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcd)  \nIt was god."
    masked := DiarySpellingMasked(entry)
    if masked != "I wnet out.\n\n\nIt was god." { return 1 }
    restored := DiarySpellingRestored(entry, "I went out.\n\n\nIt was good.")
    if restored != "I went out.\n![IMG_1.jpg](diary:photo-1.bin)\n  ![](photos:9f2c4e1a7b3d5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcd)  \nIt was good." { return 2 }
    // Lines that moved, or text written where a photo was, are refused.
    if DiarySpellingRestored(entry, "I went out.\n\nIt was good.") != "" { return 3 }
    if DiarySpellingRestored(entry, "I went out.\nphoto\n\nIt was good.") != "" { return 4 }
    if DiarySpellingRestored(entry, "I went out.\n\n\nIt was good.\n") != "" { return 5 }
    // Images inside text and plain text pass unchanged.
    if DiarySpellingMasked("see ![a](b) here") != "see ![a](b) here" { return 6 }
    if DiarySpellingMasked("") != "" || DiarySpellingRestored("", "") != "" { return 7 }
    if DiarySpellingMasked("trailing\n") != "trailing\n" { return 8 }
    if DiarySpellingRestored("a\n![x](diary:x.bin)\n", "b\n\n") != "b\n![x](diary:x.bin)\n" { return 9 }
    return 42
}
