<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- connect-client needs API 26; on older devices the export button is a
         no-op (runtime SDK guard in HealthConnectExport). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Health Connect one-way session export (Data & export settings). -->
    <uses-permission android:name="android.permission.health.EXERCISE" />
    <uses-permission android:name="android.permission.health.MINDFULNESS" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
    <application
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${inbeAppLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="${inbeUsesCleartextTraffic}">
        <activity
            android:name="xyz.waozi.inbe.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/InbeTheme"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:windowLayoutInDisplayCutoutMode="never">
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Health Connect: app info can deep-link to the permissions page. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="xyz.waozi.inbe.SkyCradleLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="${inbeAppLabel}"
            android:targetActivity="xyz.waozi.inbe.MainActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="xyz.waozi.inbe.InkAndAirLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_air"
            android:roundIcon="@mipmap/ic_launcher_air_round"
            android:label="${inbeAppLabel}"
            android:targetActivity="xyz.waozi.inbe.MainActivity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Health Connect on API 34+ routes the rationale through this alias. -->
        <activity-alias
            android:name="ViewPermissionActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="xyz.waozi.inbe.MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="xyz.waozi.inbe.StartPracticeWidget"
            android:exported="false"
            android:label="@string/widget_breathe_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_breathe_info" />
        </receiver>

        <service
            android:name="xyz.waozi.inbe.StartPracticeTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_breathe_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="xyz.waozi.inbe.SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name="xyz.waozi.inbe.PushServiceImpl"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
