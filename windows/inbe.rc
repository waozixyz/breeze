#include <windows.h>
#define IDI_APP_ICON 101
#define IDI_NOTIFICATION_ICON 32512

IDI_APP_ICON ICON "inbe.ico"
IDI_NOTIFICATION_ICON ICON "inbe.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,8,0
 PRODUCTVERSION 2,0,8,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "waozi"
            VALUE "FileDescription", "Inner Breeze"
            VALUE "FileVersion", "2.0.8"
            VALUE "InternalName", "inbe"
            VALUE "OriginalFilename", "inbe-windows-x86_64.exe"
            VALUE "ProductName", "Inner Breeze"
            VALUE "ProductVersion", "2.0.8"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
// end of resource file
