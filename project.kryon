name "Inner Breeze"
generated "build/kryon/generated"

target "Native" "native" "sh build/packages/kryon/scripts/kryon-app.sh run native"
target "Web" "web" "sh build/packages/kryon/scripts/kryon-app.sh build web"
target "Android Debug" "android-debug" "sh build/packages/kryon/scripts/kryon-app.sh build android-debug"
target "Android Release" "android-release" "sh build/packages/kryon/scripts/kryon-app.sh build android-release"
target "Windows" "windows" "sh build/packages/kryon/scripts/kryon-app.sh build windows"
target "AppImage" "appimage" "sh build/packages/kryon/scripts/kryon-app.sh package appimage"
target "Click" "click" "sh build/packages/kryon/scripts/kryon-app.sh package click"
target "Snap" "snap" "sh build/packages/kryon/scripts/kryon-app.sh package snap"
target "Flatpak" "flatpak" "sh build/packages/kryon/scripts/kryon-app.sh package flatpak"
